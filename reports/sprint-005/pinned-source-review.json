  "findings": [
    {
      "topic": "Normal file-cookie lifetime",
      "conclusion": "Inspected ioctl/mmap paths retain fileproc I/O references through synchronous provider calls. Normal close drains them before final fileglob/device close; this excludes the ordinary queued-operation race raised in the first partial review.",
      "references": [
        "bsd/kern/sys_generic.c:917,1019",
        "bsd/kern/kern_descrip.c:1516,1684,1761",
        "bsd/kern/kern_mman.c:667,717,1078"
      ],
      "limits": "Does not prove pager finalization, forced shutdown, all aliases, or direct kernel callers."
    },
    {
      "topic": "Provider factory ownership",
      "conclusion": "Without IOKIT_ENABLE_SHARED_PTR, OSPtr<T> is T*. The candidate previously used .get() and smart-pointer cleanup assumptions without enabling that mode. It now explicitly owns the raw factory reference, releases it on validation/prepare failure, and transfers it once on success.",
      "references": [
        "libkern/libkern/c++/OSPtr.h:69,107",
        "iokit/IOKit/IOBufferMemoryDescriptor.h",
        "iokit/Kernel/IOBufferMemoryDescriptor.cpp:527"
      ],
      "limits": "Source-based correction; the candidate has not been compiled against the pinned SDK."
    },
    {
      "topic": "Private mapping rejection",
      "conclusion": "kern_mman routes VCHR+MAP_SHARED through the custom pager with requested protections; remaining character-device mappings return ENODEV. A private-mapping negative test must not require EINVAL.",
      "references": [
        "bsd/kern/kern_mman.c:711-744"
      ],
      "limits": "Static behavior at the selected pin, not a device observation."
    }
