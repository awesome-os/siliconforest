    {
      "id": "N1",
      "severity": "note",
      "source": "integrations/puredarwin/m1-apcie-bridge/bcm4378_transport.c:73",
      "detail": "BCM4378_TRANSPORT.md and transport receipt say every entry checks link. bct_init instead checks EMPTY/no-dirty/no-fault, genuine checked BCM accessor and plan bounds, then performs zero I/O and enters BOUND. bct_identify and all later protocol entries/endpoint operations do fresh link checks. This is a documentation boundary, not an I/O safety blocker; initialization alone is no link proof.",
      "blocks_current_host_only_scope": false
    },
    {
      "id": "N2",
      "severity": "scope_limit",
      "source": "integrations/puredarwin/m1-apcie-bridge/bcm4378_identity_fw.c:41",
      "detail": "Pure metadata planning trusts caller-owned bci_identity valid/version/result/PCI/bus/revision fields. It does not authenticate a chip identity or independently reconstruct raw_chipid/chip_id/profile provenance. Identity profile constants remain explicitly synthetic with numeric_profile_verified=0; no plan/name/request success may authorize a hardware firmware loader.",
      "blocks_current_host_only_scope": false
    }
  ],
