diff --git a/src/m1_boot_window.c b/src/m1_boot_window.c
new file mode 100644
index 0000000..c4a6f40
--- /dev/null
+++ b/src/m1_boot_window.c
@@ -0,0 +1,51 @@
+#include "m1_boot_window.h"
+
+bool m1_boot_window_allowed(uint32_t chip, const char *target, size_t length, bool debug)
+{
+    return !debug && chip == 0x8103 && target && length == 5 &&
+           (target[0] == 'J' || target[0] == 'j') && target[1] == '2' && target[2] == '9' &&
+           target[3] == '3' && target[4] == '\0';
+}
+
+void m1_boot_window_init(struct m1_boot_window *window, uint32_t timeout_ms)
+{
+    *window = (struct m1_boot_window){.timeout_ms = timeout_ms};
+}
+
+static bool valid_nop(const uint8_t *frame)
+{
+    if (frame[0] != 0xff || frame[1] != 0x55 || frame[2] != 0xaa || frame[3] != 0)
+        return false;
+    /* Same wire checksum as uartproxy.c; dispatcher checks it again before execution. */
+    uint32_t sum = 0xdeadbeef;
+    for (unsigned int i = 0; i < M1_BOOT_WINDOW_FRAME - 4; i++)
+        sum = sum * 31337u + (frame[i] ^ 0x5au);
+    sum ^= 0xaddedbad;
+    uint32_t expected = (uint32_t)frame[60] | ((uint32_t)frame[61] << 8) |
+                        ((uint32_t)frame[62] << 16) | ((uint32_t)frame[63] << 24);
+    return sum == expected;
+}
+
+enum m1_window_result m1_boot_window_feed(struct m1_boot_window *window, uint64_t elapsed_ms,
+                                         int port, uint8_t byte)
+{
+    if (window->result != M1_WINDOW_WAIT)
+        return window->result;
+    /* Expiry wins even when the last byte of an otherwise valid NOP arrives now. */
+    if (elapsed_ms >= window->timeout_ms)
+        return window->result = M1_WINDOW_TIMEOUT;
+    if (port < 0 || port >= M1_BOOT_WINDOW_PORTS)
+        return M1_WINDOW_WAIT;
+    uint8_t *frame = window->frame[port];
+    if (window->used[port] == M1_BOOT_WINDOW_FRAME) {
+        for (unsigned int i = 1; i < M1_BOOT_WINDOW_FRAME; i++)
+            frame[i - 1] = frame[i];
+        window->used[port]--;
+    }
+    frame[window->used[port]++] = byte;
+    if (window->used[port] == M1_BOOT_WINDOW_FRAME && valid_nop(frame)) {
+        window->selected = port;
+        window->result = M1_WINDOW_CLAIMED;
+    }
+    return window->result;
+}
diff --git a/src/m1_boot_window.h b/src/m1_boot_window.h
new file mode 100644
index 0000000..cffd5a7
--- /dev/null
+++ b/src/m1_boot_window.h
@@ -0,0 +1,29 @@
+/* Bounded J293 bootstrap acquisition policy. No hardware access. */
+#ifndef M1_BOOT_WINDOW_H
+#define M1_BOOT_WINDOW_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define M1_BOOT_WINDOW_MS 10000u
+#define M1_BOOT_WINDOW_PORTS 2
+#define M1_BOOT_WINDOW_FRAME 64
+
+enum m1_window_result { M1_WINDOW_WAIT, M1_WINDOW_TIMEOUT, M1_WINDOW_CLAIMED };
+
+struct m1_boot_window {
+    uint32_t timeout_ms;
+    enum m1_window_result result;
+    unsigned int selected;
+    unsigned int used[M1_BOOT_WINDOW_PORTS];
+    uint8_t frame[M1_BOOT_WINDOW_PORTS][M1_BOOT_WINDOW_FRAME];
+};
+
+bool m1_boot_window_allowed(uint32_t chip, const char *target, size_t length, bool debug);
+void m1_boot_window_init(struct m1_boot_window *window, uint32_t timeout_ms);
+/* port=-1 polls expiry without feeding data. elapsed is monotonic since init. */
+enum m1_window_result m1_boot_window_feed(struct m1_boot_window *window, uint64_t elapsed_ms,
+                                         int port, uint8_t byte);
+
+#endif
