+bool uartproxy_wait_m1_boot_window(unsigned int timeout_ms)
+{
+    struct m1_boot_window window;
+    m1_boot_window_init(&window, timeout_ms);
+    window_iodev = IODEV_MAX;
+    u64 start = get_ticks();
+    while (m1_boot_window_feed(&window, ticks_to_msecs(get_ticks() - start), -1, 0) ==
+           M1_WINDOW_WAIT) {
+        for (int port = 0; port < M1_BOOT_WINDOW_PORTS; port++) {
+            iodev_id_t id = IODEV_USB0 + port;
+            if (!(iodev_get_usage(id) & USAGE_UARTPROXY))
+                continue;
+            iodev_handle_events(id);
+            /* Single consumer; read only an available byte, never the unreceived frame tail. */
+            for (unsigned int budget = 0; budget < 256; budget++) {
+                if (m1_boot_window_feed(&window, ticks_to_msecs(get_ticks() - start), -1, 0) !=
+                    M1_WINDOW_WAIT)
+                    return false;
+                if (iodev_can_read(id) <= 0)
+                    break;
+                u8 byte;
+                if (iodev_read(id, &byte, 1) != 1)
+                    break;
+                enum m1_window_result result = m1_boot_window_feed(
+                    &window, ticks_to_msecs(get_ticks() - start), port, byte);
+                if (result == M1_WINDOW_TIMEOUT)
+                    return false;
+                if (result == M1_WINDOW_CLAIMED) {
+                    memset(&window_request, 0, sizeof(window_request));
+                    memcpy(&window_request.type, window.frame[port], REQ_SIZE);
+                    window_iodev = id;
+                    return true;
+                }
+            }
+        }
+        mdelay(1);
+    }
+    return false;
+}
