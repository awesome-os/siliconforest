linuxkpi: wake_up_bit() and wake_up_atomic_t() wake every waiter

Audit finding P9. They woke one thread; a second waiter on the same bit slept until its
timeout, or for ever.

--- a/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/src/linux_schedule.c
+++ b/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/src/linux_schedule.c
@@ -408,8 +410,12 @@
 static void
 wake_up_sleepers(void *wchan)
 {
+	/*
+	 * linux wakes every waiter of a bit or an atomic; with one of several
+	 * woken the others slept until their timeout, or for ever.
+	 */
 	sleepq_lock(wchan);
-	sleepq_signal(wchan, SLEEPQ_SLEEP, 0, 0);
+	sleepq_broadcast(wchan, SLEEPQ_SLEEP, 0, 0);
 	sleepq_release(wchan);
 }
 
