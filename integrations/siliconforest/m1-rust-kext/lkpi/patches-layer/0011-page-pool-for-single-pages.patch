+static void
+sf_pool_link(struct sf_page_run *run)
+{
+	run->pnext = sf_pool_partial;
+	run->pprevp = &sf_pool_partial;
+	if (sf_pool_partial != NULL)
+		sf_pool_partial->pprevp = &run->pnext;
+	sf_pool_partial = run;
+}
+
+static void
+sf_pool_unlink(struct sf_page_run *run)
+{
+	*run->pprevp = run->pnext;
+	if (run->pnext != NULL)
+		run->pnext->pprevp = run->pprevp;
+	run->pnext = NULL;
+	run->pprevp = NULL;
+}
+
+// one more chunk into the pool; false when xnu has no memory
+static bool
+sf_pool_grow(void)
+{
+	uint64_t phys[SF_CHUNK_PAGES];
+	struct sf_page_run *run;
+	void *cookie = NULL, *kva;
+	unsigned long i;
+
+	kva = sfos_pages_alloc(SF_CHUNK_PAGES, phys, &cookie);
+	if (kva == NULL) {
+		sf_page_fail_xnu++;
+		return false;
+	}
+	run = malloc(sizeof(*run) + SF_CHUNK_PAGES * sizeof(struct vm_page), M_DEVBUF, M_WAITOK | M_ZERO);
+	if (run == NULL) {
+		sf_page_fail_record++;
+		sfos_pages_free(cookie);
+		return false;
+	}
+	run->phys = phys[0];
+	run->kva = kva;
+	run->npages = SF_CHUNK_PAGES;
+	run->pooled = true;
+	run->cookie = cookie;
+	run->freemask = ~0ULL;
+
+	mtx_lock(&sf_page_lock);
+	for (i = 0; i < SF_CHUNK_PAGES; i++) {
+		vm_page_t m = &run->pages[i];
+		unsigned b;
+
+		m->phys_addr = phys[i];
+		m->sf_kva = (char *)kva + (i << PAGE_SHIFT);
+		m->sf_run = run;
+		b = sf_page_bucket(m->phys_addr);
+		m->sf_hnext = sf_page_hash[b];
+		sf_page_hash[b] = m;
+	}
+	sf_pool_link(run);
+	sf_pool_free += SF_CHUNK_PAGES;
+	sf_pool_chunks++;
+	sf_pool_chunk_allocs++;
+	mtx_unlock(&sf_page_lock);
+	return true;
+}
+
+static struct page *
+sf_pool_alloc(gfp_t flags)
+{
+	struct sf_page_run *run;
+	vm_page_t m;
+	int i;
+
+	for (;;) {
+		mtx_lock(&sf_page_lock);
+		run = sf_pool_partial;
+		if (run != NULL)
+			break;
+		mtx_unlock(&sf_page_lock);
+		if (!sf_pool_grow())
+			return NULL;
+	}
+	i = __builtin_ctzll(run->freemask);
+	run->freemask &= ~(1ULL << i);
+	if (run->freemask == 0)
+		sf_pool_unlink(run);
+	sf_pool_free--;
+	m = &run->pages[i];
+	m->ref_count = 1;
+	mtx_unlock(&sf_page_lock);
+	if ((flags & M_ZERO) != 0)
+		memset(m->sf_kva, 0, PAGE_SIZE);
+	return m;
+}
+
+static void
+sf_pool_free_page(struct page *page)
+{
+	struct sf_page_run *run = page->sf_run;
+	int i = (int)(page - run->pages);
+	bool release;
+
+	if (page->sf_kva_cached != NULL) {
+		sfos_unmap_pages(page->sf_kva);
+		page->sf_kva = page->sf_kva_cached;
+		page->sf_kva_cached = NULL;
+	}
+	mtx_lock(&sf_page_lock);
+	page->ref_count = 0;
+	page->flags = 0;
+	page->object = NULL;
+	if (run->freemask == 0)
+		sf_pool_link(run);
+	run->freemask |= 1ULL << i;
+	sf_pool_free++;
+	release = run->freemask == ~0ULL && run->vmaps == 0 &&
+	    sf_pool_free >= SF_POOL_KEEP + SF_CHUNK_PAGES;
+	if (release) {
+		sf_pool_unlink(run);
+		sf_page_run_unhash(run);
+		sf_pool_free -= SF_CHUNK_PAGES;
+		sf_pool_chunks--;
+		sf_pool_chunk_frees++;
+	}
+	mtx_unlock(&sf_page_lock);
+	if (release) {
+		sfos_pages_free(run->cookie);
+		free(run, M_DEVBUF);
+	}
+}
+
+// sf_pool under memory pressure: every fully free, unmapped chunk goes back to xnu, the
+// reserve included. Returns the number of chunks released.
+unsigned long
+sf_linux_page_trim(void)
+{
+	struct sf_page_run *run, *next, *victims = NULL;
+	unsigned long n = 0;
+
+	mtx_lock(&sf_page_lock);
+	for (run = sf_pool_partial; run != NULL; run = next) {
+		next = run->pnext;
+		if (run->freemask != ~0ULL || run->vmaps != 0)
+			continue;
+		sf_pool_unlink(run);
+		sf_page_run_unhash(run);
+		sf_pool_free -= SF_CHUNK_PAGES;
+		sf_pool_chunks--;
+		sf_pool_chunk_frees++;
+		run->pnext = victims;
+		victims = run;
+	}
+	mtx_unlock(&sf_page_lock);
+	for (run = victims; run != NULL; run = next) {
+		next = run->pnext;
+		sfos_pages_free(run->cookie);
+		free(run, M_DEVBUF);
+		n++;
+	}
+	return n;
+}
+
+// what the seam's pressure thread calls (and a kext's diagnostics may): Linux shrinkers
+// first, so that what they free can leave with the trim
+void sf_lkpi_lowmem(void);
+static unsigned long sf_pool_pressure_runs, sf_pool_pressure_trimmed;
+
+void
+sf_linux_page_pressure(void)
+{
+	linux_set_current(curthread);
+	sf_lkpi_lowmem();
+	sf_pool_pressure_trimmed += sf_linux_page_trim();
+	sf_pool_pressure_runs++;
+}
+
+void
+sf_linux_page_pressure_stats(unsigned long *runs, unsigned long *trimmed, long long *xnu_events)
+{
+	*runs = sf_pool_pressure_runs;
+	*trimmed = sf_pool_pressure_trimmed;
+	*xnu_events = sfos_pressure_events();
+}
+
+// for a kext's diagnostics: pool state and why allocations failed
+void
+sf_linux_page_stats(unsigned long *chunks, unsigned long *free_pages, unsigned long *chunk_allocs,
+    unsigned long *chunk_frees, unsigned long *fail_xnu, unsigned long *fail_record)
+{
+	mtx_lock(&sf_page_lock);
+	*chunks = sf_pool_chunks;
+	*free_pages = sf_pool_free;
+	*chunk_allocs = sf_pool_chunk_allocs;
+	*chunk_frees = sf_pool_chunk_frees;
+	*fail_xnu = sf_page_fail_xnu;
+	*fail_record = sf_page_fail_record;
+	mtx_unlock(&sf_page_lock);
+}
