+// sf_pool: single pages (alloc_page, every shmem/GEM page, page tables) come from chunks of
+// SF_CHUNK_PAGES wired pages, one xnu allocation each (sfos_pages_alloc). Before this every
+// page was its own physically-contiguous IOBufferMemoryDescriptor with its own records.
+// A chunk goes back to xnu when all its pages are free, nothing maps it and the pool still
+// holds SF_POOL_KEEP free pages elsewhere.
+#define SF_CHUNK_PAGES	64
+#define SF_POOL_KEEP	(4 * SF_CHUNK_PAGES)
+static struct sf_page_run *sf_pool_partial;	// chunks with a free page
+static unsigned long sf_pool_free, sf_pool_chunks, sf_pool_chunk_allocs, sf_pool_chunk_frees;
+static unsigned long sf_page_fail_xnu, sf_page_fail_record;
