-// heap, every block keeps its raw allocation just before it
+// heap, every block keeps its raw allocation and the size that was asked for just before it.
+// The size is exact on purpose: linux's ksize/krealloc/__GFP_ZERO rules are stated in terms
+// of it (bytes past it are not the caller's and are not zeroed).
+
+struct heap_header {
+	void	*raw;
+	size_t	size;
+};
 
 static void *
 heap_alloc(size_t size, size_t align, bool zero, bool canWait)
 {
-	if (align < sizeof(void *))
-		align = sizeof(void *);
-	void *raw = sfos_malloc(size + align + sizeof(void *), zero, canWait);
+	if (align < 16)
+		align = 16;
+	if (size + align + sizeof(heap_header) < size)
+		return NULL;
+	void *raw = sfos_malloc(size + align + sizeof(heap_header), zero, canWait);
 	if (raw == NULL)
 		return NULL;
-	uintptr_t p = ((uintptr_t)raw + sizeof(void *) + align - 1) & ~(uintptr_t)(align - 1);
-	((void **)p)[-1] = raw;
+	uintptr_t p = ((uintptr_t)raw + sizeof(heap_header) + align - 1) & ~(uintptr_t)(align - 1);
+	heap_header *header = (heap_header *)p - 1;
+	header->raw = raw;
+	header->size = size;
 	return (void *)p;
 }
 
