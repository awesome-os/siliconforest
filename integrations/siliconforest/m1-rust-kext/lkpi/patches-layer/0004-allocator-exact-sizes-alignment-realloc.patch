@@ -53,6 +53,19 @@
 }
 
 
+// an allocation aligned to more than its size would give it, FreeBSD's malloc_aligned
+void *
+_kernel_malloc_aligned(size_t size, size_t align, int flags)
+{
+	size_t natural = size >= PAGESIZE ? PAGESIZE : next_power_of_2(size);
+	void *ptr = memalign_etc(align > natural ? align : natural, size,
+		(flags & M_NOWAIT) ? HEAP_DONT_WAIT_FOR_MEMORY : 0);
+	if (ptr != NULL && (flags & M_ZERO) != 0)
+		memset(ptr, 0, size);
+	return ptr;
+}
+
+
 void *
 _kernel_realloc(void *ptr, size_t size, int flags)
 {
@@ -65,7 +78,12 @@
 
 	size_t old = _kernel_malloc_usable_size(ptr);
 	memcpy(fresh, ptr, old < size ? old : size);
-	free(ptr);
+	// with M_ZERO the bytes past the old contents are zero, as FreeBSD's and linux's
+	// realloc have it
+	if ((flags & M_ZERO) != 0 && size > old)
+		memset((char *)fresh + old, 0, size - old);
+	// the old block may be contigmalloc memory
+	_kernel_free(ptr);
 	return fresh;
 }
 
@@ -75,6 +93,13 @@
 size_t
 _kernel_malloc_usable_size(const void *ptr)
 {
+	// contigmalloc memory is an area and has no heap header in front of it
+	if (ptr != NULL && ((uintptr_t)ptr & (B_PAGE_SIZE - 1)) == 0) {
+		area_id area = area_for((void *)ptr);
+		area_info info;
+		if (area >= 0 && get_area_info(area, &info) == B_OK && info.address == ptr)
+			return info.size;
+	}
 	return malloc_usable_size((void *)ptr);
 }
 
@@ -86,6 +111,7 @@
 {
 	const bool zero = (flags & M_ZERO) != 0, dontWait = (flags & M_NOWAIT) != 0;
 
+	const size_t asked = size;
 	size = ROUNDUP(size, B_PAGE_SIZE);
 
 	uint32 creationFlags = (zero ? 0 : CREATE_AREA_DONT_CLEAR)
@@ -111,6 +137,11 @@
 	if (area < 0)
 		return NULL;
 
+	// the usable size is the rounded one (_kernel_malloc_usable_size): what lies past the
+	// request must not be stale memory when a later realloc hands it out as zeroed
+	if (!zero && size > asked)
+		memset((char *)address + asked, 0, size - asked);
