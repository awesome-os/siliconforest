+// mmap of a linux file. Only a dma-buf has one: dma_buf_mmap_internal() and, through the
+// exporter's dma_buf_ops.mmap, the GEM object's mmap op, asked for its pages (struct
+// sf_vma_pages in linux/mm.h). The vma is kept for the life of the mapping, with the file
+// reference linux's mmap holds through vma->vm_file, and vm_ops->close() ends it.
+int sf_dma_buf_mmap_internal(struct linux_file *file, struct vm_area_struct *vma);
+
+struct sf_lfile_mapping {
+	struct vm_area_struct vma;
+	struct work_struct work;
+};
+
+static void
+sf_lfile_mapping_end(struct sf_lfile_mapping *m)
+{
+	if (m->vma.vm_ops != NULL && m->vma.vm_ops->close != NULL)
+		m->vma.vm_ops->close(&m->vma);
+	kfree(m);
+}
+
+// close takes sleeping locks and may free the object: not on the pager's teardown path
+static void
+sf_lfile_mapping_release_work(struct work_struct *work)
+{
+	struct sf_lfile_mapping *m = container_of(work, struct sf_lfile_mapping, work);
+	struct linux_file *filp = m->vma.vm_file;
+
+	linux_set_current(curthread);
+	sf_lfile_mapping_end(m);
+	fput(filp);
+}
+
+static void
+sf_lfile_mapping_release(void *arg)
+{
+	struct sf_lfile_mapping *m = arg;
+
+	schedule_work(&m->work);
+}
+
+static int
+sf_lfile_mmap_pages(void *obj, off_t offset, size_t size, int prot, uint32_t *pages,
+    unsigned int *wimg, void (**release)(void *), void **release_arg)
+{
+	struct linux_file *filp = obj;
+	struct sf_lfile_mapping *m;
+	struct sf_vma_pages rq = { .pages = pages, .wimg = *wimg, .filled = false };
+	int ret;
+
+
+	if (size == 0 || (size & (PAGE_SIZE - 1)) != 0 || offset < 0 ||
+	    (offset & (PAGE_SIZE - 1)) != 0)
+		return EINVAL;
+	if (!is_dma_buf_file(filp))
+		return ENODEV;
+	m = kzalloc(sizeof(*m), GFP_KERNEL);
+	if (m == NULL)
+		return ENOMEM;
+	m->vma.vm_start = 0;
+	m->vma.vm_end = size;
+	m->vma.vm_pgoff = offset >> PAGE_SHIFT;
+	m->vma.vm_flags = VM_SHARED | VM_READ | ((prot & VM_PROT_WRITE) != 0 ? VM_WRITE : 0);
+	m->vma.vm_file = filp;
+	m->vma.sf_pages = &rq;
+	linux_set_current(curthread);
+	ret = sf_dma_buf_mmap_internal(filp, &m->vma);
+	m->vma.sf_pages = NULL;
+	if (ret != 0) {
+		kfree(m);
+		return ret < 0 ? -ret : ret;
+	}
+	if (!rq.filled) {
+		// an exporter whose mmap op does not answer the page question
+		sf_lfile_mapping_end(m);
+		return ENODEV;
+	}
+	get_file(filp);
+	INIT_WORK(&m->work, sf_lfile_mapping_release_work);
+	*wimg = rq.wimg;
+	*release = sf_lfile_mapping_release;
+	*release_arg = m;
+	return 0;
+}
+
 static const struct sf_lfile_ops sf_lfile_lkpi_ops = {
 	.hold = sf_lfile_hold,
 	.release = sf_lfile_release,
 	.poll = sf_lfile_poll,
 	.ioctl = sf_lfile_ioctl,
 	.seek = sf_lfile_seek,
+	.mmap_pages = sf_lfile_mmap_pages,
 };
 
 void sf_lfile_lkpi_init(void);
--- a/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/include/linux/mm.h
+++ b/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/include/linux/mm.h
@@ -126,6 +126,22 @@
 	vm_object_t vm_obj;
 	vm_map_t vm_cached_map;
 	TAILQ_ENTRY(vm_area_struct) vm_entry;
+
+	/* SiliconForest: set while an mmap op is asked for its pages, see below */
+	struct sf_vma_pages *sf_pages;
+};
+
+/*
+ * SiliconForest: xnu asks for the physical pages behind an mmap once, when the mapping is
+ * made, and no fault handler runs later. For a linux file (a dma-buf descriptor,
+ * drm/src/sf_lfile_lkpi.c) the question travels down the file's mmap op in the vma: an op
+ * that on linux would insert the pages or leave them to the fault handler writes the page
+ * numbers here and sets `filled`. vma->vm_ops->close() runs when the last mapping is gone.
+ */
+struct sf_vma_pages {
+	uint32_t *pages;	/* one per page of the vma, in PAGE_SHIFT units */
+	unsigned int wimg;	/* xnu cache mode of the mapping */
+	bool filled;
 };
 
