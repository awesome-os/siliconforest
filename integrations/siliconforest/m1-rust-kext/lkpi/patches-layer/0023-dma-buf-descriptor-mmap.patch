--- a/src/Kernel/fbsdkpi/drm/src/sf_dma_buf_mmap.c
+++ b/src/Kernel/fbsdkpi/drm/src/sf_dma_buf_mmap.c
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * mmap of a dma-buf descriptor: dma_buf_mmap_range_check() and dma_buf_mmap_internal()
+ * (lines 228-263 there).
+ *
+ * From drivers/dma-buf/dma-buf.c of linux-aurora (Omacom, integration/aurora) at 6a08a08e:
+ *
+ * Framework for buffer objects that can be shared across devices/subsystems.
+ *
+ * Copyright(C) 2011 Linaro Limited. All rights reserved.
+ * Author: Sumit Semwal <sumit.semwal@ti.com>
+ *
+ * Many thanks to linaro-mm-sig list, and specially
+ * Arnd Bergmann <arnd@arndb.de>, Rob Clark <rob@ti.com> and
+ * Daniel Vetter <daniel@ffwll.ch> for their support in creation and
+ * refining of this idea.
+ */
+#include <linux/uaccess.h>
+#include <linux/fs.h>
+#include <linux/file.h>
+#include <linux/dma-buf.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/overflow.h>
+
+int sf_dma_buf_mmap_internal(struct linux_file *file, struct vm_area_struct *vma);
+
+static int
+dma_buf_mmap_range_check(struct dma_buf *dmabuf, struct vm_area_struct *vma,
+    unsigned long pgoff, unsigned int suboffset)
+{
+	unsigned long offset;
+
+	if (check_mul_overflow(pgoff, PAGE_SIZE, &offset) ||
+	    check_add_overflow(offset, (unsigned long)suboffset, &offset))
+		return -EOVERFLOW;
+	if (offset > dmabuf->size || vma->vm_end - vma->vm_start > dmabuf->size - offset)
+		return -EINVAL;
+	return 0;
+}
+
+// file_operations.mmap of a dma-buf on linux; here called by sf_lfile_lkpi.c, which is not
+// necessarily the copy of this layer that made the file (is_dma_buf_file() knows both)
+int
+sf_dma_buf_mmap_internal(struct linux_file *file, struct vm_area_struct *vma)
+{
+	struct dma_buf *dmabuf;
+	int ret;
+
+	if (!is_dma_buf_file(file))
+		return -EINVAL;
+
+	dmabuf = file->private_data;
+
+	/* check if buffer supports mmap */
+	if (!dmabuf->ops->mmap)
+		return -EINVAL;
+
+	/* check for overflowing the buffer's size (this layer has no sub-page offset) */
+	ret = dma_buf_mmap_range_check(dmabuf, vma, vma->vm_pgoff, 0);
+	if (ret)
+		return ret;
+
+	return dmabuf->ops->mmap(dmabuf, vma);
+}
