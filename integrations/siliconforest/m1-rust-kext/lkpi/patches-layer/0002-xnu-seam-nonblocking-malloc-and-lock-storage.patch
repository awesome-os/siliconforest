+// Memory pressure: one kernel thread per kext waits in mach_vm_pressure_monitor() (exported
+// to kexts, com.apple.kpi.mach) and calls `fn` each time the pageout daemon is working, at
+// most once a second. The callback runs the Linux shrinkers and trims the page pool.
+extern "C" kern_return_t mach_vm_pressure_monitor(boolean_t wait_for_pressure,
+	unsigned int nsecs_monitored, unsigned int *pages_reclaimed_p, unsigned int *pages_wanted_p);
+static void (*sPressureFn)(void);
+static volatile int64_t sPressureEvents;
+
+static void
+pressure_thread(void *arg, wait_result_t wr)
+{
+	for (;;) {
+		unsigned int reclaimed = 0, wanted = 0;
+		kern_return_t kr = mach_vm_pressure_monitor(TRUE, 1, &reclaimed, &wanted);
+		if (kr == KERN_SUCCESS && wanted != 0) {
+			OSAddAtomic64(1, (SInt64 *)&sPressureEvents);
+			sPressureFn();
+		}
+		IOSleep(1000);
+	}
+}
+
+int
+sfos_pressure_start(void (*fn)(void))
+{
+	thread_t thread;
+
+	if (sPressureFn != NULL)
+		return 0;
+	sPressureFn = fn;
+	if (kernel_thread_start(pressure_thread, NULL, &thread) != KERN_SUCCESS) {
+		sPressureFn = NULL;
+		return -1;
+	}
+	thread_deallocate(thread);
+	return 0;
+}
+
+int64_t
+sfos_pressure_events(void)
+{
+	return sPressureEvents;
+}
