+// `count` wired pages in one xnu allocation, not physically contiguous: the bulk primitive
+// under linuxkpi's page allocator. phys[] gets each page's address; the kernel address of
+// the whole range is returned, *cookie frees it. No physical mask and no contiguity, so
+// this is an ordinary wired kernel allocation that scales to the gigabytes a gpu wants.
+void *
+sfos_pages_alloc(size_t count, uint64_t *phys, void **cookie)
+{
+	// kIOMemoryKernelUserShared: the pages get mapped a second time (vmap, sfos_map_owned_pages)
+	IOBufferMemoryDescriptor *buffer = IOBufferMemoryDescriptor::inTaskWithOptions(
+		kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared, count * PAGE_SIZE, PAGE_SIZE);
+	if (buffer == NULL)
+		return NULL;
+	if (buffer->prepare() != kIOReturnSuccess) {
+		buffer->release();
+		return NULL;
+	}
+	for (size_t i = 0; i < count; i++) {
+		phys[i] = buffer->getPhysicalSegment(i * PAGE_SIZE, NULL, kIOMemoryMapperNone);
+		if (phys[i] == 0) {
+			buffer->complete();
+			buffer->release();
+			return NULL;
+		}
+	}
+	*cookie = buffer;
+	return buffer->getBytesNoCopy();
+}
+
+// One contiguous kernel mapping of pages that came from sfos_pages_alloc(): page i is page
+// index[i] of the allocation cookies[i]. The mapping is made from sub-ranges of the buffer
+// descriptors that own the pages, not from physical addresses: a physical descriptor over
+// xnu-managed pages does not hold them (DEBUG kernels report "IOMemoryDescriptor physical
+// with managed page"). NULL when xnu refuses; the caller may fall back. sfos_unmap_pages()
+// takes the mapping down.
+static volatile int64_t sOwnedMaps, sOwnedMapFailures;
+void *
+sfos_map_owned_pages(void *const *cookies, const uint32_t *index, size_t count, int uncached)
+{
+	IOMemoryDescriptor **subs = (IOMemoryDescriptor **)IOMalloc(count * sizeof(IOMemoryDescriptor *));
+	IOMemoryDescriptor *desc = NULL;
+	IOMemoryMap *map = NULL;
+	sf_mapping *m = NULL;
+	UInt32 n = 0;
+	bool ok = subs != NULL;
+
+	// adjacent pages of one allocation become one sub-range
+	for (size_t i = 0; ok && i < count;) {
+		size_t run = 1;
+		while (i + run < count && cookies[i + run] == cookies[i] && index[i + run] == index[i] + run)
+			run++;
+		IOSubMemoryDescriptor *s = IOSubMemoryDescriptor::withSubRange(
+			(IOMemoryDescriptor *)cookies[i], (IOByteCount)index[i] * PAGE_SIZE,
+			(IOByteCount)run * PAGE_SIZE, kIODirectionInOut);
+		if (s == NULL)
+			ok = false;
+		else
+			subs[n++] = s;
+		i += run;
+	}
+	if (ok) {
+		if (n == 1) {
+			desc = subs[0];
+			desc->retain();
+		} else {
+			desc = IOMultiMemoryDescriptor::withDescriptors(subs, n, kIODirectionInOut, false);
+		}
+	}
+	for (UInt32 i = 0; i < n; i++)
+		subs[i]->release();
+	if (subs != NULL)
+		IOFree(subs, count * sizeof(IOMemoryDescriptor *));
+	if (desc != NULL)
+		map = desc->createMappingInTask(kernel_task, 0,
+			kIOMapAnywhere | kIOMapUnique | (uncached ? kIOMapWriteCombineCache : 0));
+	if (map != NULL && map->getVirtualAddress() != 0)
+		m = (sf_mapping *)IOMalloc(sizeof(sf_mapping));
+	if (m == NULL) {
+		if (map != NULL)
+			map->release();
+		if (desc != NULL)
+			desc->release();
+		if (OSAddAtomic64(1, (SInt64 *)&sOwnedMapFailures) == 0)
+			IOLog("sfos: mapping pool pages through their own descriptors failed (%zu pages, %u ranges)\n",
+			    count, (unsigned)n);
+		return NULL;
+	}
+	bzero(m, sizeof(*m));
+	m->va = (void *)map->getVirtualAddress();
+	m->desc = desc;
+	m->map = map;
+	mapping_add(m);
+	OSAddAtomic64(1, (SInt64 *)&sOwnedMaps);
+	return m->va;
+}
+
+void
+sfos_map_owned_stats(int64_t *maps, int64_t *failures)
+{
+	*maps = sOwnedMaps;
+	*failures = sOwnedMapFailures;
+}
