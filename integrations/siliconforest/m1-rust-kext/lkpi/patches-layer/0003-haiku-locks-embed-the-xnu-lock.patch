 void
 rw_lock_init(rw_lock *lock, const char *name)
 {
 	lock->name = name;
-	lock->impl = NULL;
+	lock->impl_state = SF_LOCK_UNSET;
 	lock->holder = -1;
 	lock->owner_count = 0;
