 	void *cookie = slot_cookie(dev);
 
+	int ready;
+
+	if (cookie == NULL)
+		return 0;
+	ready = owner_ops(dev)->poll(cookie, which, wql);
+	if (!ready) {
+		// record the waiter, then look again: an event queued in between has already
+		// called sf_dri_wakeup() with nobody recorded
+		selrecord(p, &sSel[SF_DRI_SLOT(dev)], wql);
+		ready = owner_ops(dev)->poll(cookie, which, wql);
+	}
+	return ready;
+}
+
+// a drm kext calls this when the file behind `cookie` has something to read (a drm event was
+// queued): wakes select(), poll() and kqueue waiters of that open file. any context that may
+// take a mutex.
+int
+sf_dri_wakeup(void *cookie)
+{
 	if (cookie == NULL)
 		return 0;
-	return owner_ops(dev)->poll(cookie, which, wql);
+	for (int slot = 1; slot < SF_DRI_SLOTS; slot++) {
+		if (sSlots[slot] == cookie) {
+			selwakeup(&sSel[slot]);
+			return 1;
+		}
+	}
+	return 0;
 }
 
