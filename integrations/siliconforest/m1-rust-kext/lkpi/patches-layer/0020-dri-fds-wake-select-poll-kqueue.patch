+// select/poll/kqueue: one waiter record per open file. a drm kext reports "this file became
+// readable" with sf_dri_wakeup(cookie); dri_select records the waiter when nothing is ready
+static struct selinfo sSel[SF_DRI_SLOTS];
 static lck_grp_t *sLockGroup;
 static lck_mtx_t *sLock;
 static const struct sf_dri_ops *sProviders[SF_DRI_PROVIDERS];
@@ -109,6 +112,9 @@
 	if (cookie != NULL) {
 		owner_ops(dev)->close(cookie);
 		sSlots[SF_DRI_SLOT(dev)] = NULL;
+		// nobody may stay recorded on a slot the next open reuses
+		selwakeup(&sSel[SF_DRI_SLOT(dev)]);
+		selthreadclear(&sSel[SF_DRI_SLOT(dev)]);
 	}
 	return 0;
 }
@@ -152,9 +158,35 @@
