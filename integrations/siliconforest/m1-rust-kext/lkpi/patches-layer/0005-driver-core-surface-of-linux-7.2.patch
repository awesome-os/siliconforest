--- a/src/Kernel/fbsdkpi/sf/lkpi/sf_linux_drvcore.c
+++ b/src/Kernel/fbsdkpi/sf/lkpi/sf_linux_drvcore.c
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: MIT
+// the parts of linux 7.2's driver core that drivers written for it (the Rust abstractions
+// first of all) call and linuxkpi lacks: managed-resource nodes, the platform bus entry points
+// with their 7.2 names, and ACPI lookups that find nothing
+
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/device.h>
+#include <linux/platform_device.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/sf_drvcore.h>
+
+// --- managed-resource nodes ---------------------------------------------------------------
+// linux keeps these on dev->devres_head itself. linuxkpi's list there holds its own struct
+// devres, so each node rides in one of those: the device's ordinary devres teardown then
+// releases nodes in order with everything else.
+
+struct sf_devres_node_ref {
+	struct devres_node *node;
+};
+
+static void
+sf_devres_node_release(struct device *dev, void *p)
+{
+	struct sf_devres_node_ref *ref = p;
+	struct devres_node *node = ref->node;
+
+	list_del_init(&node->entry);
+	if (node->release != NULL)
+		node->release(dev, node);
+	if (node->free_node != NULL)
+		node->free_node(node);
+}
+
+static int
+sf_devres_node_match(struct device *dev, void *p, void *data)
+{
+	return (((struct sf_devres_node_ref *)p)->node == data);
+}
+
+void
+devres_node_init(struct devres_node *node, dr_node_release_t release, dr_node_free_t free_node)
+{
+	INIT_LIST_HEAD(&node->entry);
+	node->release = release;
+	node->free_node = free_node;
+}
+
+void
+devres_set_node_dbginfo(struct devres_node *node, const char *name, size_t size)
+{
+	node->name = name;
+	node->size = size;
+}
+
+void
+devres_node_add(struct device *dev, struct devres_node *node)
+{
+	struct sf_devres_node_ref *ref;
+
+	// linux's devres_node_add cannot fail; neither may this
+	ref = lkpi_devres_alloc(sf_devres_node_release, sizeof(*ref), GFP_KERNEL | __GFP_NOFAIL);
+	BUG_ON(ref == NULL);
+	ref->node = node;
+	lkpi_devres_add(dev, ref);
+}
+
+bool
+devres_node_remove(struct device *dev, struct devres_node *node)
+{
+	struct sf_devres_node_ref *ref;
+
+	ref = lkpi_devres_find(dev, sf_devres_node_release, sf_devres_node_match, node);
+	if (ref == NULL)
+		return (false);
+	lkpi_devres_unlink(dev, ref);
+	lkpi_devres_free(ref);
+	INIT_LIST_HEAD(&node->entry);
+	return (true);
+}
+
+// --- platform bus -------------------------------------------------------------------------
+
+struct bus_type {
+	const char *name;
+};
+struct bus_type platform_bus_type = { .name = "platform" };
+
+int
+__platform_driver_register(struct platform_driver *pdrv, struct module *owner, const char *name)
+{
+	if (pdrv->driver.name == NULL)
+		pdrv->driver.name = name;
+	return (platform_driver_register(pdrv));
+}
+
+void
+platform_device_put(struct platform_device *pdev)
+{
+}
+
+int
+platform_get_irq_byname_optional(struct platform_device *pdev, const char *name)
+{
+	return (platform_get_irq_byname(pdev, name));
+}
+
+// --- acpi ---------------------------------------------------------------------------------
+
+bool
+acpi_of_match_device(const struct acpi_device *adev, const struct of_device_id *of_match_table,
+    const struct of_device_id **of_id)
+{
+	return (false);
+}
+
+const struct acpi_device_id *
+sf_acpi_match_device(const struct acpi_device_id *ids, const struct device *dev)
+{
+	return (NULL);
+}
+
+// --- of globals ---------------------------------------------------------------------------
+
+static void
+sf_drvcore_init(void *arg)
+{
+	sf_of_globals_init();
+}
+SYSINIT(sf_drvcore, SI_SUB_DRIVERS, SI_ORDER_FIRST, sf_drvcore_init, NULL);
