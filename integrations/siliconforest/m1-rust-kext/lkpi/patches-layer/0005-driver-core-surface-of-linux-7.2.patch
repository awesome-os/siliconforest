--- a/src/Kernel/fbsdkpi/sf/lkpi-override/linux/sf_drvcore.h
+++ b/src/Kernel/fbsdkpi/sf/lkpi-override/linux/sf_drvcore.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MIT
+// What Linux 7.2's driver core offers besides LinuxKPI's: managed-resource nodes
+// (drivers/base/base.h), and the ACPI names the generic driver code mentions. There is no
+// ACPI on these boards; the ACPI types exist so that code written for both compiles, and the
+// lookups find nothing. pd/lkpi/sf_linux_drvcore.c
+#ifndef _SF_LINUX_DRVCORE_H_
+#define	_SF_LINUX_DRVCORE_H_
+
+#include <linux/types.h>
+#include <linux/list.h>
+#include <linux/device.h>
+#include <linux/mod_devicetable.h>
+
+struct devres_node;
+typedef void (*dr_node_release_t)(struct device *dev, struct devres_node *node);
+typedef void (*dr_node_free_t)(struct devres_node *node);
+
+struct devres_node {
+	struct list_head	entry;
+	dr_node_release_t	release;
+	dr_node_free_t		free_node;
+	const char		*name;
+	size_t			size;
+};
+
+void devres_node_init(struct devres_node *node, dr_node_release_t release, dr_node_free_t free_node);
+void devres_set_node_dbginfo(struct devres_node *node, const char *name, size_t size);
+// released (release, then free_node) in reverse order when the device's managed resources
+// are, i.e. after a failed probe; a node that was removed again is neither
+void devres_node_add(struct device *dev, struct devres_node *node);
+bool devres_node_remove(struct device *dev, struct devres_node *node);
+
+#ifndef ACPI_ID_LEN
+#define	ACPI_ID_LEN	16
+#endif
+#ifndef SF_HAVE_ACPI_DEVICE_ID
+#define	SF_HAVE_ACPI_DEVICE_ID
+struct acpi_device_id {
+	__u8		id[ACPI_ID_LEN];
+	unsigned long	driver_data;
+	__u32		cls;
+	__u32		cls_msk;
+};
+#endif
+struct acpi_device;
+struct of_device_id;
+bool acpi_of_match_device(const struct acpi_device *adev, const struct of_device_id *of_match_table,
+    const struct of_device_id **of_id);
+const struct acpi_device_id *sf_acpi_match_device(const struct acpi_device_id *ids, const struct device *dev);
+
+#endif
