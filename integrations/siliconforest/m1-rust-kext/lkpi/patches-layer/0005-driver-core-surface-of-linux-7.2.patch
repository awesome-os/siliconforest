+	bool	driver_managed_dma;
 	// the probe that matched, kept for remove and shutdown at teardown
 	struct list_head	sf_link;
 };
@@ -52,6 +55,17 @@
 bool sf_dev_is_platform(const struct device *);
 #define	dev_is_platform(dev)	sf_dev_is_platform(dev)
 
+// Linux's platform_driver_register() is a macro over this; the name argument is the Omacom
+// tree's (the Rust adapter passes the module name). sf_linux_drvcore.c
+struct module;
+int __platform_driver_register(struct platform_driver *, struct module *, const char *);
+// devices are never freed (nothing unbinds), so dropping a reference does nothing
+void platform_device_put(struct platform_device *);
+int platform_get_irq_byname_optional(struct platform_device *, const char *);
+// only its address is taken (kernel::platform names it in a safety comment)
+struct bus_type;
+extern struct bus_type platform_bus_type;
+
 // devices come from the device tree only, registering one by hand does nothing
 static inline int
 platform_device_register(struct platform_device *pdev)
--- a/src/Kernel/fbsdkpi/sf/lkpi-override/linux/property.h
+++ b/src/Kernel/fbsdkpi/sf/lkpi-override/linux/property.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MIT
+// firmware-node property access (linux/property.h, linux/fwnode.h), over the device tree only:
+// every fwnode_handle is the member of a device_node. Implemented in pd/lkpi/sf_linux_fwnode.c.
+#ifndef _SF_LINUX_PROPERTY_H_
+#define	_SF_LINUX_PROPERTY_H_
+
+#include <linux/types.h>
+#include <linux/fwnode.h>
+#include <linux/device.h>
+
+#define	NR_FWNODE_REFERENCE_ARGS	16
+struct fwnode_reference_args {
+	struct fwnode_handle	*fwnode;
+	unsigned int		nargs;
+	u64			args[NR_FWNODE_REFERENCE_ARGS];
+};
+
+struct fwnode_handle *__dev_fwnode(struct device *dev);
+#define	dev_fwnode(dev)	__dev_fwnode(dev)
+
+struct fwnode_handle *fwnode_handle_get(struct fwnode_handle *fwnode);
+void fwnode_handle_put(struct fwnode_handle *fwnode);
+
+bool fwnode_property_present(const struct fwnode_handle *fwnode, const char *name);
+bool fwnode_property_read_bool(const struct fwnode_handle *fwnode, const char *name);
+int fwnode_property_read_u8_array(const struct fwnode_handle *fwnode, const char *name, u8 *val, size_t nval);
+int fwnode_property_read_u16_array(const struct fwnode_handle *fwnode, const char *name, u16 *val, size_t nval);
+int fwnode_property_read_u32_array(const struct fwnode_handle *fwnode, const char *name, u32 *val, size_t nval);
+int fwnode_property_read_u64_array(const struct fwnode_handle *fwnode, const char *name, u64 *val, size_t nval);
+int fwnode_property_read_string(const struct fwnode_handle *fwnode, const char *name, const char **val);
+int fwnode_property_match_string(const struct fwnode_handle *fwnode, const char *name, const char *string);
+int fwnode_property_get_reference_args(const struct fwnode_handle *fwnode, const char *prop,
+    const char *nargs_prop, unsigned int nargs, unsigned int index, struct fwnode_reference_args *args);
+
+const char *fwnode_get_name(const struct fwnode_handle *fwnode);
+const char *fwnode_get_name_prefix(const struct fwnode_handle *fwnode);
+unsigned int fwnode_count_parents(const struct fwnode_handle *fwnode);
+struct fwnode_handle *fwnode_get_nth_parent(struct fwnode_handle *fwnode, unsigned int depth);
+struct fwnode_handle *fwnode_get_named_child_node(const struct fwnode_handle *fwnode, const char *childname);
+struct fwnode_handle *fwnode_get_next_child_node(const struct fwnode_handle *fwnode, struct fwnode_handle *child);
+
+#endif
