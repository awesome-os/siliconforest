linuxkpi: backlight and platform_driver fields a Linux 7 display driver names

- linux/backlight.h: BACKLIGHT_PLATFORM/FIRMWARE, enum backlight_scale,
  backlight_properties.state/.scale, BL_CORE_SUSPENDED/FBBLANK, backlight_ops.controls_device
- platform_driver.driver_managed_dma
Declarations only: nothing in the layer acts on them yet.
UPSTREAM: yes.

--- a/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/include/linux/backlight.h
+++ b/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/include/linux/backlight.h
@@ -42,6 +51,11 @@
 	int max_brightness;
 	int brightness;
 	int power;
+	/* Linux: BL_CORE_* state bits and the brightness curve; nothing here sets or reads them */
+	unsigned int state;
+#define	BL_CORE_SUSPENDED	(1 << 0)
+#define	BL_CORE_FBBLANK		(1 << 1)
+	enum backlight_scale scale;
 };
 
 enum backlight_notification {
@@ -58,6 +72,8 @@
 #define	BL_CORE_SUSPENDRESUME   1
 	int (*update_status)(struct backlight_device *);
 	int (*get_brightness)(struct backlight_device *);
+	/* Linux 6.10+: whether this backlight belongs to the given display device */
+	bool (*controls_device)(struct backlight_device *, struct device *);
 };
 
 struct backlight_device {
@@ -128,7 +164,9 @@
 backlight_is_blank(struct backlight_device *bd)
 {
 
-	return (bd->props.power != 0/* FB_BLANK_UNBLANK */);
+	/* as linux: powered down, suspended or under an fb blank */
+	return (bd->props.power != 0/* FB_BLANK_UNBLANK */ ||
+	    (bd->props.state & (BL_CORE_SUSPENDED | BL_CORE_FBBLANK)) != 0);
 }
 
 #endif	/* _LINUXKPI_LINUX_BACKLIGHT_H_ */
