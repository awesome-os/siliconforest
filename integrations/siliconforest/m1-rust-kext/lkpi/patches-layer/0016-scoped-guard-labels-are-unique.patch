linuxkpi: two scoped_guard() in one function no longer define the same label

linux/cleanup.h built the label as `___label_ ## __COUNTER__`; the paste keeps __COUNTER__
from expanding, so every scoped_guard() used the label ___label___COUNTER__ and a function
with two of them did not compile (drivers/gpu/drm/apple has 16 such functions).
UPSTREAM: yes (FreeBSD LinuxKPI).

--- a/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/include/linux/cleanup.h
+++ b/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/include/linux/cleanup.h
@@ -184,7 +184,10 @@
 			break;						\
 		} else
 
+/* pasting directly would leave __COUNTER__ unexpanded: every label the same name */
+#define	___scoped_guard_cat2(_a, _b)	_a ## _b
+#define	___scoped_guard_cat(_a, _b)	___scoped_guard_cat2(_a, _b)
 #define	scoped_guard(_n, ...)						\
-    _scoped_guard(_n, ___label_ ## __COUNTER__, ##__VA_ARGS__)
+    _scoped_guard(_n, ___scoped_guard_cat(___label_, __COUNTER__), ##__VA_ARGS__)
 
 #endif	/* _LINUXKPI_LINUX_CLEANUP_H */
