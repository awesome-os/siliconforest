@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * poll on a sync_file descriptor: what sync_file_alloc(), fence_check_cb_func(),
+ * sync_file_release() and sync_file_poll() do for it.
+ *
+ * From drivers/dma-buf/sync_file.c of linux-aurora (Omacom, integration/aurora) at 6a08a08e:
+ *
+ * Copyright (C) 2012 Google, Inc.
+ */
+#include <linux/bitops.h>
+#include <linux/dma-fence.h>
+#include <linux/fs.h>
+#include <linux/file.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/poll.h>
+#include <linux/sync_file.h>
+#include <linux/wait.h>
+
+// sync_file_alloc()
+void
+sf_sync_file_poll_init(struct sync_file *sync_file)
+{
+	init_waitqueue_head(&sync_file->wq);
+
+	INIT_LIST_HEAD(&sync_file->cb.node);
+}
+
+static void
+fence_check_cb_func(struct dma_fence *f, struct dma_fence_cb *cb)
+{
+	struct sync_file *sync_file;
+
+	sync_file = container_of(cb, struct sync_file, cb);
+
+	wake_up_all(&sync_file->wq);
+}
+
+// sync_file_release(), before the fence reference is dropped
+void
+sf_sync_file_poll_fini(struct sync_file *sync_file)
+{
+	if (test_bit(POLL_ENABLED, &sync_file->flags))
+		dma_fence_remove_callback(sync_file->fence, &sync_file->cb);
+}
+
+unsigned int
+sf_sync_file_poll(struct linux_file *file, poll_table *wait)
+{
+	struct sync_file *sync_file = file->private_data;
+
+	poll_wait(file, &sync_file->wq, wait);
+
+	if (list_empty(&sync_file->cb.node) &&
+	    !test_and_set_bit(POLL_ENABLED, &sync_file->flags)) {
+		if (dma_fence_add_callback(sync_file->fence, &sync_file->cb,
+					   fence_check_cb_func) < 0)
+			wake_up_all(&sync_file->wq);
+	}
+
+	return dma_fence_is_signaled(sync_file->fence) ? POLLIN : 0;
+}
--- a/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/include/linux/poll.h
+++ b/src/Kernel/fbsdkpi/freebsd/linuxkpi/common/include/linux/poll.h
@@ -36,9 +36,21 @@
 #include <linux/wait.h>
 #include <linux/file.h>
 
+/*
+ * SiliconForest: _key is linux's, the events the caller waits for. A poll called with a table
+ * (the sf_lfile descriptors, drm/src/sf_lfile_lkpi.c) has poll_wait() queue the file on the
+ * wait queue for wakeups; with NULL, as before, poll_wait() does nothing.
+ */
 typedef struct poll_table_struct {
+	unsigned int _key;
 } poll_table;
 
+static inline unsigned int
+poll_requested_events(const poll_table *p)
+{
+	return (p ? p->_key : ~0u);
+}
+
 extern void linux_poll_wait(struct linux_file *, wait_queue_head_t *, poll_table *);
 #define	poll_wait(...) linux_poll_wait(__VA_ARGS__)
 
