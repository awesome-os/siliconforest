+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * poll on a dma-buf descriptor: dma_buf_poll_cb(), dma_buf_poll_add_cb() and dma_buf_poll()
+ * (lines 317-418 there).
+ *
+ * From drivers/dma-buf/dma-buf.c of linux-aurora (Omacom, integration/aurora) at 6a08a08e:
+ *
+ * Framework for buffer objects that can be shared across devices/subsystems.
+ *
+ * Copyright(C) 2011 Linaro Limited. All rights reserved.
+ * Author: Sumit Semwal <sumit.semwal@ti.com>
+ *
+ * Many thanks to linaro-mm-sig list, and specially
+ * Arnd Bergmann <arnd@arndb.de>, Rob Clark <rob@ti.com> and
+ * Daniel Vetter <daniel@ffwll.ch> for their support in creation and
+ * refining of this idea.
+ */
+#include <linux/uaccess.h>
+#include <linux/dma-fence.h>
+#include <linux/fs.h>
+#include <linux/file.h>
+#include <linux/dma-buf.h>
+#include <linux/dma-resv.h>
+#include <linux/kernel.h>
+#include <linux/poll.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+// POLLIN: no write fence pending on the buffer; POLLOUT: no fence at all.
+//
+// One difference from the original. The callback gives back the file reference dma_buf_poll() took, and it
+// runs where the fence is signalled, under the fence's lock. linux's fput() only queues
+// the final release there; this layer's fput() runs it at once, which would free the
+// buffer (and with it this callback's own storage) inside the signalling driver. So the
+// callback counts the reference and a work item drops it.
+static void
+sf_dma_buf_poll_fput_work(struct work_struct *work)
+{
+	struct dma_buf_poll_cb_t *dcb = container_of(work, struct dma_buf_poll_cb_t,
+	    sf_fput_work);
+	struct dma_buf *db = container_of(dcb->poll, struct dma_buf, poll);
+	struct linux_file *filp = db->file;
+	int n = atomic_xchg(&dcb->sf_fputs, 0);
+
+	// each counted reference keeps db alive; nothing of it is touched after the last fput
+	while (n-- > 0)
+		fput(filp);
+}
+
+static void
+sf_dma_buf_poll_cb(struct dma_fence *fence, struct dma_fence_cb *cb)
+{
+	struct dma_buf_poll_cb_t *dcb = (struct dma_buf_poll_cb_t *)cb;
+	unsigned long flags;
+
+	spin_lock_irqsave(&dcb->poll->lock, flags);
+	wake_up_all_locked(dcb->poll);
+	dcb->active = 0;
+	spin_unlock_irqrestore(&dcb->poll->lock, flags);
+	dma_fence_put(fence);
+	/* Paired with get_file in dma_buf_poll */
+	atomic_inc(&dcb->sf_fputs);
+	schedule_work(&dcb->sf_fput_work);
+}
+
+static bool
+sf_dma_buf_poll_add_cb(struct dma_resv *resv, bool write, struct dma_buf_poll_cb_t *dcb)
+{
+	struct dma_resv_iter cursor;
+	struct dma_fence *fence;
+	int r;
+
+	dma_resv_for_each_fence(&cursor, resv, dma_resv_usage_rw(write), fence) {
+		dma_fence_get(fence);
+		r = dma_fence_add_callback(fence, &dcb->cb, sf_dma_buf_poll_cb);
+		if (!r)
+			return true;
+		dma_fence_put(fence);
+	}
+
+	return false;
+}
+
+unsigned int
+sf_dma_buf_poll(struct linux_file *filp, poll_table *poll)
+{
+	struct dma_buf *dmabuf;
+	struct dma_resv *resv;
+	unsigned int events;
+
+	dmabuf = filp->private_data;
+	if (!dmabuf || !dmabuf->resv)
+		return POLLERR;
+
+	resv = dmabuf->resv;
+
+	poll_wait(filp, &dmabuf->poll, poll);
+
+	events = poll_requested_events(poll) & (POLLIN | POLLOUT);
+	if (!events)
+		return 0;
+
+	dma_resv_lock(resv, NULL);
+
+	if (events & POLLOUT) {
+		struct dma_buf_poll_cb_t *dcb = &dmabuf->cb_out;
+
+		/* Check that callback isn't busy */
+		spin_lock_irq(&dmabuf->poll.lock);
+		if (dcb->active)
+			events &= ~POLLOUT;
+		else
+			dcb->active = POLLOUT;
+		spin_unlock_irq(&dmabuf->poll.lock);
+
+		if (events & POLLOUT) {
+			/* Paired with fput in dma_buf_poll_cb */
+			get_file(dmabuf->file);
+
+			if (!sf_dma_buf_poll_add_cb(resv, true, dcb))
+				/* No callback queued, wake up any other waiters */
+				sf_dma_buf_poll_cb(NULL, &dcb->cb);
+			else
+				events &= ~POLLOUT;
+		}
+	}
+
+	if (events & POLLIN) {
+		struct dma_buf_poll_cb_t *dcb = &dmabuf->cb_in;
+
+		/* Check that callback isn't busy */
+		spin_lock_irq(&dmabuf->poll.lock);
+		if (dcb->active)
+			events &= ~POLLIN;
+		else
+			dcb->active = POLLIN;
+		spin_unlock_irq(&dmabuf->poll.lock);
+
+		if (events & POLLIN) {
+			/* Paired with fput in dma_buf_poll_cb */
+			get_file(dmabuf->file);
+
+			if (!sf_dma_buf_poll_add_cb(resv, false, dcb))
+				/* No callback queued, wake up any other waiters */
+				sf_dma_buf_poll_cb(NULL, &dcb->cb);
+			else
+				events &= ~POLLIN;
+		}
+	}
+
+	dma_resv_unlock(resv);
+	return events;
+}
+
+void
+sf_dma_buf_poll_init(struct dma_buf *db)
+{
+	init_waitqueue_head(&db->poll);
+	db->cb_in.poll = db->cb_out.poll = &db->poll;
+	db->cb_in.active = db->cb_out.active = 0;
+	atomic_set(&db->cb_in.sf_fputs, 0);
+	atomic_set(&db->cb_out.sf_fputs, 0);
+	INIT_WORK(&db->cb_in.sf_fput_work, sf_dma_buf_poll_fput_work);
+	INIT_WORK(&db->cb_out.sf_fput_work, sf_dma_buf_poll_fput_work);
+}
+
+// the pin's dma_buf_release() has BUG_ON here: a pending poll callback holds a file
+// reference, so the buffer cannot be released with one armed
+void
+sf_dma_buf_poll_fini(struct dma_buf *db)
+{
+	WARN_ON(db->cb_in.active || db->cb_out.active);
+}
