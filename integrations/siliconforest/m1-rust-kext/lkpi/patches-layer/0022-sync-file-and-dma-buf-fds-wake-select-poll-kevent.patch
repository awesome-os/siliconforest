+// a wake_up on the wait queue the file's poll named: xnu's sf_lfile wakes its select and
+// kevent waiters, which poll again
+static int
+sf_lfile_wake_fn(wait_queue_t *wq, unsigned int mode, int flags, void *key)
+{
+	sf_lfile_wakeup(wq->private);
+	return 0;
+}
+
+// poll_wait(). linux queues the polling task on wqh for the duration of the poll; here the
+// file is queued, the first time a poll with a table names the queue, and stays queued until
+// its last reference goes (sf_lkpi_fput). One wait queue per file, as in linux_compat.c.
+void
+linux_poll_wait(struct linux_file *filp, wait_queue_head_t *wqh, poll_table *p)
+{
+	struct linux_file_wait_queue *fwq;
+
+	if (p == NULL || filp == NULL || wqh == NULL)
+		return;
+	fwq = &filp->f_wait_queue;
+	if (atomic_read(&fwq->state) == LINUX_FWQ_STATE_QUEUED)
+		return;
+	if (atomic_cmpxchg(&fwq->state, LINUX_FWQ_STATE_INIT, LINUX_FWQ_STATE_NOT_READY) !=
+	    LINUX_FWQ_STATE_INIT) {
+		// another thread is queueing the file: not ready may only be reported once the
+		// file is on the queue
+		while (atomic_read(&fwq->state) != LINUX_FWQ_STATE_QUEUED)
+			cpu_relax();
+		return;
+	}
+	fwq->wqh = wqh;
+	fwq->wq.private = filp;
+	fwq->wq.func = sf_lfile_wake_fn;
+	INIT_LIST_HEAD(&fwq->wq.entry);
+	add_wait_queue(wqh, &fwq->wq);
+	atomic_set(&fwq->state, LINUX_FWQ_STATE_QUEUED);
+}
