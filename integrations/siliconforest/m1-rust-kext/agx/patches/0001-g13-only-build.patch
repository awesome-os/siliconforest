drm/asahi: a build with the common code and the G13/G14 (legacy) backend only

--cfg sf_g13 leaves out the G17 and M3 backends (61,000 of the driver's 111,000 lines) and
the hw tables that exist only for them. Without the cfg nothing changes. The common code
names a few G17 items unconditionally (Vm status, cumulative sync bundles, `is::<g17::Gpu>()`
tests, two t8140 constants); for those the build keeps the real g17/status.rs, hw/t8140.rs
minus its G17 configuration, and two types that cannot be constructed (`g17::Gpu`,
`g17::sync_output::SignalBundle`), so every G17 branch of the common code is dead but
type-checks. None of the driver's C (sysfs.c, g17/*.c) is needed by this build.
UPSTREAM: optional (a Kconfig symbol per backend would be the Linux form).

--- a/asahi_core.rs
+++ b/asahi_core.rs
@@ -14,7 +14,30 @@
 mod float;
 mod fw;
 mod gem;
+#[cfg(not(sf_g13))]
 mod g17;
+// SiliconForest G13-only build (--cfg sf_g13): the G17 and M3 backends are not compiled. The
+// common code names a few G17 items; this keeps exactly those. `status` is the real file.
+// `Gpu` cannot be constructed, so every `is::<g17::Gpu>()` in the common code is false and no
+// VM gets `with_status()`. A cumulative-signal bundle (g17/sync_output.rs, with
+// sync_output.c and sync_scope.c) cannot be constructed either: the common code only asks
+// for one when the GPU accepts cumulative syncs (file.rs, `allow_cumulative`), which no GPU
+// of this build does, and `new` refuses.
+#[cfg(sf_g13)]
+mod g17 {
+    pub(crate) mod status;
+    pub(crate) mod sync_output {
+        use kernel::prelude::*;
+        pub(crate) const SYNC_CUMULATIVE: u32 = 2;
+        pub(crate) enum SignalBundle {}
+        impl SignalBundle {
+            pub(crate) fn new(_syncs: &[crate::file::SyncItem], _anchor: usize) -> Result<Self> {
+                Err(EINVAL)
+            }
+        }
+    }
+    pub(crate) enum Gpu {}
+}
