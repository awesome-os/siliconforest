+get() { sysctl -n "$1" 2>/dev/null; }
+# until <tenths of a second> <command...>: poll every 0.1 s until the command succeeds
+until_ok() {
+    limit=$1; shift; tries=0
+    until "$@" >/dev/null 2>&1; do
+        tries=$((tries + 1)); [ "$tries" -le "$limit" ] || return 1; sleep 0.1
+    done
+}
+wifi_has() { wifiutil info 2>/dev/null | grep -q "$1"; }
 printf '\nGPUDESK_BEGIN_%s seconds=@SECONDS@\n' "$nonce"
+until_ok 50 test -c /dev/dri/card0
 ls -l /dev/dri 2>&1 | head -6
 (
