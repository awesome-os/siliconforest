--- a/src/Kernel/xnu/iokit/Kernel/IOStartIOKit.cpp
+++ b/src/Kernel/xnu/iokit/Kernel/IOStartIOKit.cpp
@@ -69,22 +69,72 @@
 #include <kern/clock.h>
 #include <sys/time.h>
 
+extern bool gSFIOKitDaemonBusyHold;
+extern bool gSFQuietIgnoresDaemonHold;
+
+// PD: the services still busy after the registry wait timed out, providers before clients:
+// the ones with no busy client are the drivers that have not finished starting
+static void
+SFLogBusyServices( uint32_t seconds )
+{
+	IORegistryIterator * iter;
+	IORegistryEntry *    entry;
+	IOService *          service;
+	uint32_t             count = 0;
+
+	IOLog("IOKitInitializeTime: registry not quiet after %u s (root busy %u, daemon hold %d)\n",
+	    seconds, (uint32_t) IOService::getServiceRoot()->getBusyState(), gSFIOKitDaemonBusyHold);
+	iter = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively);
+	if (!iter) {
+		return;
+	}
+	while ((entry = iter->getNextObject())) {
+		service = OSDynamicCast(IOService, entry);
+		if (service && service->getBusyState() && (count++ < 32)) {
+			IOLog("IOKitInitializeTime: busy %u: %s (%s) depth %d\n",
+			    (uint32_t) service->getBusyState(), service->getName(),
+			    service->getMetaClass()->getClassName(), (int) service->getDepth(gIOServicePlane));
+		}
+	}
+	iter->release();
+}
+
 void
 IOKitInitializeTime( void )
 {
 	mach_timespec_t         t;
+	uint32_t                quietWait = 30;
+	uint32_t                rtcWait = 30;
+	bool                    quiet = false;
+
+	// PD: first wait for the registry to settle (every matched driver started), then for the
+	// clock. Upstream waits 30 s for an IORTC resource and nothing else; this machine has no
+	// RTC driver, so that was 30 s of every boot, and the registry wait that followed could
+	// not succeed (see IOService::waitQuietWithOptions). A driver with a clock publishes
+	// IORTC while it starts, so once the registry is quiet the resource is there or will
+	// not come, and the clock is not waited for. If the registry does not settle, the busy
+	// services are named and the upstream RTC wait applies.
+	//   sf_quiet_wait=<seconds>  registry wait (default 30; 0: none)
+	//   sf_rtc_wait=<seconds>    RTC wait, also after a quiet registry (0: none)
+	PE_parse_boot_argn("sf_quiet_wait", &quietWait, sizeof(quietWait));
+	if (quietWait) {
+		mach_timespec_t q = { quietWait, 0 };
+
+		quiet = (kIOReturnSuccess == IOService::getServiceRoot()->waitQuiet(&q));
+		if (!quiet) {
+			SFLogBusyServices(quietWait);
+		}
+	}
+	if (quiet) {
+		rtcWait = 0;
+	}
+	PE_parse_boot_argn("sf_rtc_wait", &rtcWait, sizeof(rtcWait));
+	if (rtcWait) {
+		t.tv_sec = rtcWait;
+		t.tv_nsec = 0;
 
