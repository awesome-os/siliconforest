#!/bin/sh
# Guest side of an interactive GPU desktop session (tools/gpu_desktop.sh), without fixed
# sleeps: every wait is for the thing waited for (boot-speed stream, issue #27). The kernel no
# longer spends 60 s before the root mounts, so nothing here may assume the drivers had that
# long. Joins Wi-Fi in the
# background when the tools and firmware are staged, then runs the shared-shell desktop on the
# GL renderer with page flips, real keyboard and trackpad input, and two terminals, for
# @SECONDS@ seconds. No synthetic input. @SSID@/@PSK@ are filled from private/wifi.env at
# packet assembly; the filled script is never committed.
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
case "$nonce" in *[!0-9a-f]*|'') session=000000000000000000000000000000000000000000000001 ;; *) session=$nonce ;; esac
[ "${#session}" -eq 48 ] || session=000000000000000000000000000000000000000000000001
runtime=/private/var/run/gpu-desktop
mkdir -p "$runtime" && chmod 0700 "$runtime"
# The menu's Theme and Display choices are kept here for the rest of the boot (the RAM root).
state=/private/var/db/desktop-state
mkdir -p "$state"
export XDG_STATE_HOME="$state"
export XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY=wayland-0
export XKB_CONFIG_ROOT=/usr/share/X11/xkb TMPDIR=/private/tmp
export CHONKSTEP_DARWIN_FRAME_STATS=3600
[ -d /usr/share/backgrounds/siliconforest ] && export CHONKSTEP_BACKGROUND_DIR=/usr/share/backgrounds/siliconforest
get() { sysctl -n "$1" 2>/dev/null; }
# until <tenths of a second> <command...>: poll every 0.1 s until the command succeeds
until_ok() {
    limit=$1; shift; tries=0
    until "$@" >/dev/null 2>&1; do
        tries=$((tries + 1)); [ "$tries" -le "$limit" ] || return 1; sleep 0.1
    done
}
wifi_has() { wifiutil info 2>/dev/null | grep -q "$1"; }
printf '\nGPUDESK_BEGIN_%s seconds=@SECONDS@\n' "$nonce"
until_ok 50 test -c /dev/dri/card0
ls -l /dev/dri 2>&1 | head -6
(
    if command -v wifiutil >/dev/null 2>&1 && [ -d /Library/Firmware/brcm ]; then
        # en0 exists once the firmware is up (about 2.3 s after the root mounts)
        until_ok 200 wifi_has '^interface: *en0'; printf 'GPUDESK_WIFI_IF_RC=%s\n' "$?"
        until_ok 50 sf-dhcp --up en0
        wifiutil on >/dev/null 2>&1; until_ok 100 wifi_has '^power: *on'
        # the join scans by itself; a first attempt that finds nothing is repeated
        rc=1; attempt=0
        while [ "$attempt" -lt 4 ]; do
            attempt=$((attempt + 1))
            wifiutil join '@SSID@' '@PSK@' >/dev/null 2>&1; rc=$?
            [ "$rc" -eq 0 ] && break
            sleep 2
        done
        printf 'GPUDESK_WIFI_JOIN_RC=%s attempts=%s\n' "$rc" "$attempt"
        rc=1; attempt=0
        while [ "$attempt" -lt 4 ]; do
            attempt=$((attempt + 1))
            sf-net-up en0 >/dev/null 2>&1; rc=$?
            [ "$rc" -eq 0 ] && break
            sleep 1
        done
        printf 'GPUDESK_NET_UP_RC=%s attempts=%s\n' "$rc" "$attempt"
        ping -c 2 1.1.1.1 >/dev/null 2>&1; printf 'GPUDESK_PING_RC=%s\n' "$?"
    else
        printf 'GPUDESK_WIFI_SKIPPED\n'
    fi
) &
# Sound: the audio server, as the desktop session starts it. The speakers stay 20 dB under the
# protection model's limit when hold_probe is 1.
if [ -x /usr/sbin/coreaudiod ]; then
    # In the background: the sound driver starts 2 s into the boot and publishes its node
    # after that, and the desktop does not wait for sound.
    (
        until_ok 100 test -c /dev/sfaudio
        sysctl -w kern.sf_speaker.hold_probe=@HOLD@ kern.sf_sound.volume_db=@VOLUME@ > /dev/null 2>&1
        mkdir -p /var/log /var/run /Library/Preferences
        /usr/sbin/coreaudiod > /var/log/coreaudiod.log 2>&1 &
        printf 'GPUDESK_COREAUDIOD pid=%s hold_probe=%s sound=%s | speakers=%s\n' "$!" "$(get kern.sf_speaker.hold_probe)" "$(get kern.sf_sound.state)" "$(get kern.sf_speaker.state | cut -c1-60)"
    ) &
fi
# the digitizer's firmware loads after the root mounts (1.24 s); at most 30 s as before
n=0
while [ "$n" -lt 300 ]; do
    case "$(get kern.sf_touchbar.state)" in ready*|display-only*|display-failed*|off*|'') break;; esac
    sleep 0.1; n=$((n+1))
done
printf 'GPUDESK_TOUCHBAR state=%s\n' "$(get kern.sf_touchbar.state)"
[ -x /usr/bin/darwin-trackpad-enum ] && { /usr/bin/darwin-trackpad-enum --nonce "$session"; printf 'GPUDESK_ENUM rc=%s\n' "$?"; }
count=0
while [ ! -c /dev/usb_hid_kbd ] || [ ! -c /dev/usb_hid_mouse ]; do
    count=$((count + 1)); [ "$count" -le 100 ] || break; sleep 0.1
done
printf 'GPUDESK_INPUT kbd=%s mouse=%s\n' "$([ -c /dev/usb_hid_kbd ] && echo yes || echo no)" "$([ -c /dev/usb_hid_mouse ] && echo yes || echo no)"
records=$runtime/session-$session
mkdir -m 0700 "$records"
printf 'GPUDESK_DESKTOP_START renderer=auto seconds=@SECONDS@ start=%s\n' "$(date +%s)"
# The desktop's own exit status, not that of the filter it is piped through.
rm -f "$runtime/desktop.rc"
{
    /usr/bin/chonkstep-darwin-desktop --run --socket "$runtime/wayland-0" --records "$records" --session "$session" --terminal /usr/bin/chonk-terminal-darwin --seconds @SECONDS@ --font-regular /usr/share/darwin-desktop/DejaVuSans.ttf --font-bold /usr/share/darwin-desktop/DejaVuSans-Bold.ttf --input sfhid --startup-terminals 2 2>&1
    echo "$?" > "$runtime/desktop.rc"
} | grep -v 'chonkstep-gl: step:'
printf 'GPUDESK_DESKTOP_RC=%s end=%s\n' "$(cat "$runtime/desktop.rc" 2>/dev/null || echo unknown)" "$(date +%s)"
[ -r "$records/session-result.txt" ] && grep -v ' gate=\| kernel_messages=\| cs_at_spawn=\| exit_reason=' "$records/session-result.txt" | cut -c1-260 | sed 's/^/GPUDESK_RESULT /' | head -60
printf 'GPUDESK_SOUND_END speakers=%s trips=%s sessions=%s | touchbar=%s key_events=%s reports=%s spi_errors=%s dart_faults=%s\n' "$(get kern.sf_speaker.state | cut -c1-40)" "$(get kern.sf_speaker.trips)" "$(get kern.sf_speaker.sessions)" "$(get kern.sf_touchbar.state)" "$(get kern.sf_touchbar.key_events)" "$(get kern.sf_touchbar.reports)" "$(get kern.sf_touchbar.spi_errors)" "$(get kern.sf_touchbar.dart_faults)"
printf 'GPUDESK_END_%s\n' "$nonce"
# ends the capture a second later instead of running out the session's upper bound
printf '\nPD_BENCH_DONE\n'
