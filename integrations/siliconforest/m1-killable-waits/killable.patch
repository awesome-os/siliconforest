+// linux's signal_pending()/fatal_signal_pending() for the calling thread. exit1() sets
+// P_LEXIT before task_terminate_internal() aborts the other threads, so an exiting
+// process (exit, SIGKILL, a crash) answers yes without a lock; that is what lets a
+// client's waiting threads leave the kernel. A signal xnu has posted to this thread
+// (and not blocked or ignored) answers yes too, but thread_issignal() takes the proc
+// mutex, so only where blocking is allowed: under a real spin lock the answer is
+// "exiting" alone. Kernel threads take no signals.
+#define SFOS_SIGKILL_MASK	(1u << (9 - 1))
+
+extern "C" int
+sfos_signal_pending(int fatal)
+{
+	proc_t p = current_proc();
+
+	if (p == NULL || p == kernproc)
+		return 0;
+	if (proc_exiting(p))
+		return 1;
+	if (ml_at_interrupt_context() || !ml_get_interrupts_enabled() || !preemption_enabled())
+		return 0;
+	return thread_issignal(p, current_thread(), fatal ? SFOS_SIGKILL_MASK : ~0u) != 0;
+}
+
+extern "C" int
+sfos_task_exiting(void)
+{
+	proc_t p = current_proc();
+
+	return p != NULL && p != kernproc && proc_exiting(p);
+}
+
 // threads
 
