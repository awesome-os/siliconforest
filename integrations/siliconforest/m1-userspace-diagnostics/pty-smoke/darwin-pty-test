#!/bin/sh
# Finite RAM-root PTY qualification. No typing or persistent storage actions.
set -eu
nonce=${1-}
case "$nonce" in ''|*[!0-9a-f]*) exit 2 ;; esac
[ "${#nonce}" -eq 48 ] || exit 2
printf '\nDL11_PTY_BEGIN_%s\n' "$nonce"
pty_rc=0
if /usr/bin/darwin-pty-smoke --nonce "$nonce"; then :; else pty_rc=$?; fi
printf 'DL11_PTY_STATUS_%s rc=%s\n' "$nonce" "$pty_rc"
[ "$pty_rc" -eq 0 ] || exit "$pty_rc"
printf 'DL11_PTY_END_%s\n' "$nonce"
