                            uint32_t x, uint32_t y,
                            uint32_t width, uint32_t height);
+/* Queries derived from the fields above; the struct layout is unchanged. */
+SFGOPServiceKind SFGOPGetServiceKind(const SFGOPFramebuffer *fb);
+SFGOPPixelFormat SFGOPGetPixelFormat(const SFGOPFramebuffer *fb);
 const char *SFGOPLastErrorStage(void);
 
