+SFGOPPixelFormat
+SFGOPGetPixelFormat(const SFGOPFramebuffer *fb)
+{
+    if (fb == NULL || fb->bpp != 32)
+        return kSFGOPFormatUnknown;
+    if (fb->componentMasks[0] == 0x00ff0000 &&
+        fb->componentMasks[1] == 0x0000ff00 &&
+        fb->componentMasks[2] == 0x000000ff)
+        return kSFGOPFormatXRGB8888;
+    if (fb->componentMasks[0] == 0x3ff00000 &&
+        fb->componentMasks[1] == 0x000ffc00 &&
+        fb->componentMasks[2] == 0x000003ff)
+        return kSFGOPFormatXRGB2101010;
+    return kSFGOPFormatUnknown;
+}
+
+SFGOPServiceKind
+SFGOPGetServiceKind(const SFGOPFramebuffer *fb)
+{
+    uint32_t kind;
+
+    if (fb == NULL || fb->service == IO_OBJECT_NULL)
+        return kSFGOPServiceUnknown;
+    if (fb->service == gSFGOPKindService)
+        return (SFGOPServiceKind)gSFGOPKind;
+    kind = sfgop_service_kind(fb->service);
+    if (kind != kSFGOPServiceUnknown) {
+        gSFGOPKindService = fb->service;
+        gSFGOPKind = kind;
+    }
+    return (SFGOPServiceKind)kind;
