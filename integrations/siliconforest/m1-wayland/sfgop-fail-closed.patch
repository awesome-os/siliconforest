+/* How pixels written to the mapped VRAM reach the display. */
+typedef enum SFGOPServiceKind {
+    kSFGOPServiceUnknown = 0,
+    /* IOGOPFramebuffer / IOFramebuffer: the mapped VRAM is the scanout
+     * buffer. There is no transfer step; SFGOPPresent does not apply. */
+    kSFGOPServiceDirectMemory = 1,
+    /* IOVirtIOGPU: VRAM is guest memory; SFGOPPresent transfers a rect. */
+    kSFGOPServiceVirtioTransfer = 2,
+} SFGOPServiceKind;
+
+/* Layout of one 32-bit native pixel word, from bpp and componentMasks. */
+typedef enum SFGOPPixelFormat {
+    kSFGOPFormatUnknown = 0,
+    kSFGOPFormatXRGB8888 = 1,      /* x8 r8 g8 b8 */
+    kSFGOPFormatXRGB2101010 = 2,   /* x2 r10 g10 b10 */
+} SFGOPPixelFormat;
