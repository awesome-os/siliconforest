+static uint32_t
+sfgop_service_kind(mach_port_t service)
+{
+    boolean_t virtio = 0;
+#ifdef _SF_IOKITLIB_H
+    if (IOObjectConformsTo(service, "IOVirtIOGPU", &virtio) != KERN_SUCCESS)
+        return kSFGOPServiceUnknown;
+#else
+    virtio = IOObjectConformsTo(service, "IOVirtIOGPU");
+#endif
+    return virtio ? kSFGOPServiceVirtioTransfer : kSFGOPServiceDirectMemory;
+}
+
+static int
+sfgop_geometry_valid(const IOPixelInformation *pi)
+{
+    if (pi->activeWidth == 0 || pi->activeHeight == 0)
+        return 0;
+    if (pi->bitsPerPixel == 0 || pi->bitsPerPixel > 32 || (pi->bitsPerPixel % 8) != 0)
+        return 0;
+    if ((uint64_t)pi->bytesPerRow < (uint64_t)pi->activeWidth * (pi->bitsPerPixel / 8))
+        return 0;
+    return 1;
+}
