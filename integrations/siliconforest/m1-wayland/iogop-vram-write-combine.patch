+         * property) and /dev/fb0 the boot console's Normal non-cacheable
+         * attribute instead of the Device default. */
+        setProperty("sf-vram-write-combine", kOSBooleanTrue);
+        gFb0CacheMode = kIOMapWriteCombineCache;
+    }
