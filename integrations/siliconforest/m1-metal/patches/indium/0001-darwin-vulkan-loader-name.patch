Indium on Darwin: open the Vulkan loader by its Mach-O name

Ours (SiliconForest m1-metal), 0BSD like the file it changes.

--- a/src/indium/dynamic-vk.cpp	2026-11-14 15:54:37.542565802 -0800
+++ b/src/indium/dynamic-vk.cpp	2026-11-14 15:54:37.641668839 -0800
@@ -35,8 +35,13 @@
 #ifdef DARLING
 	libraryHandle = _elfcalls->dlopen("libvulkan.so.1");
 #else
+#ifdef __APPLE__
+	// Darwin without MoltenVK: the Khronos loader by its Mach-O name (dyld's fallback path has /usr/local/lib)
+	libraryHandle = dlopen("libvulkan.1.dylib", RTLD_LAZY);
+#else
 	libraryHandle = dlopen("libvulkan.so.1", RTLD_LAZY);
 #endif
+#endif
 
 	if (!libraryHandle) {
 		return false;
