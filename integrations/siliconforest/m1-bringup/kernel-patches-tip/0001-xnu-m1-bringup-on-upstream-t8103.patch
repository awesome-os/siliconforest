diff --git a/src/Kernel/xnu/osfmk/arm64/m1_cache_helpers.inc b/src/Kernel/xnu/osfmk/arm64/m1_cache_helpers.inc
new file mode 100644
index 00000000..e5dd88ba
--- /dev/null
+++ b/src/Kernel/xnu/osfmk/arm64/m1_cache_helpers.inc
@@ -0,0 +1,66 @@
+/*
+ * Public-source M1 cache-maintenance wrappers. Included after the upstream
+ * CLEANPOC_DCACHEREGION and ENABLE/DISABLE_DC_MVA_OPS macros in caches_asm.s.
+ * Preemption is caller-owned and must already be disabled. The batch API
+ * explicitly enables/disables maintenance; the single-range API restores the
+ * exact prior HID4/EHID4 value, including when called inside an enabled batch.
+ * No allocation, call, stack use, callee-saved GPR clobber or success stub.
+ * Ranges must be valid kernel VAs with non-wrapping end addresses.
+ */
+#if !defined(ARM64_BOARD_CONFIG_T8103) || !DARWIN_LAB_M1_BRINGUP || !DEBUG
+#error "M1 cache wrappers require the explicit native DEBUG bringup configuration"
+#endif
+
+	.text
+	.align 2
+	.globl EXT(enable_dc_mva_ops)
+LEXT(enable_dc_mva_ops)
+	ARM64_PROLOG
+	mrs x10, DAIF
+	msr DAIFSet, #0xf
+	ENABLE_DC_MVA_OPS x0, x1
+	msr DAIF, x10
+	ret
+
+	.globl EXT(disable_dc_mva_ops)
+LEXT(disable_dc_mva_ops)
+	ARM64_PROLOG
+	mrs x10, DAIF
+	msr DAIFSet, #0xf
+	dsb sy
+	DISABLE_DC_MVA_OPS x0, x1
+	msr DAIF, x10
+	ret
+
+	.globl EXT(CleanPoC_DcacheRegion_Force_nopreempt)
+LEXT(CleanPoC_DcacheRegion_Force_nopreempt)
+	ARM64_PROLOG
+	cbz x1, Ldl_m1_cache_empty
+	/* Mask asynchronous nesting while the saved per-core HID value is live.
+	 * The upstream clean macro clobbers only x0/x1/x2/x9 and condition flags. */
+	mrs x10, DAIF
+	msr DAIFSet, #0xf
+	isb sy
+	ARM64_IS_ECORE x11
+	ARM64_READ_CORE_SYSREG x11, x12, EHID4, HID4
+	bic x13, x12, #ARM64_REG_HID4_DisDcMVAOps
+	ARM64_WRITE_CORE_SYSREG x11, x13, EHID4, HID4
+	isb sy
+	dsb sy
+	CLEANPOC_DCACHEREGION
+	dsb sy
+	ARM64_WRITE_CORE_SYSREG x11, x12, EHID4, HID4
+	isb sy
+	msr DAIF, x10
+	ret
+
+	.globl EXT(CleanPoC_DcacheRegion_Force_nopreempt_nohid)
+LEXT(CleanPoC_DcacheRegion_Force_nopreempt_nohid)
+	ARM64_PROLOG
+	/* The pmap batch caller already enabled maintenance on this same CPU. */
+	cbz x1, Ldl_m1_cache_empty
+	b EXT(CleanPoC_DcacheRegion_internal)
+Ldl_m1_cache_empty:
+	/* Do not underflow the upstream length-1 loop on an empty range. */
+	dsb sy
+	ret
diff --git a/src/Kernel/xnu/osfmk/arm64/m1_progress_entry.inc b/src/Kernel/xnu/osfmk/arm64/m1_progress_entry.inc
new file mode 100644
index 00000000..43da3076
--- /dev/null
+++ b/src/Kernel/xnu/osfmk/arm64/m1_progress_entry.inc
@@ -0,0 +1,40 @@
+/* Inline cold-entry progress, after x20 saves BootArgs and VBAR is installed.
+ * No calls, stack, persistent state, changes to x20, or parking. The host must
+ * validate EL1/MMU-off, M1 identity and uart0=0x235200000 before entering XNU.
+ * Every poll is bounded. Unavailable UART loses this optional line and startup
+ * still continues through the original page-table/MMU/arm_init path.
+ * The physical UART is valid only here, before the stage-1 MMU is enabled.
+ */
+#if !defined(ARM64_BOARD_CONFIG_T8103) || !DARWIN_LAB_M1_BRINGUP || !DEBUG
+#error "M1 progress requires the explicit native DEBUG bringup configuration"
+#endif
+
+	movz x1, #0x3520, lsl #16
+	movk x1, #2, lsl #32
+	adr x2, Ldl_m1_progress_message
+Ldl_m1_progress_next:
+	ldrb w3, [x2], #1
+	cbz w3, Ldl_m1_progress_drain
+	mov x4, #0x100000
+Ldl_m1_progress_wait:
+	ldr w5, [x1, #0x10]
+	tbnz w5, #1, Ldl_m1_progress_tx
+	subs x4, x4, #1
+	b.ne Ldl_m1_progress_wait
+	b Ldl_m1_progress_done
+Ldl_m1_progress_tx:
+	str w3, [x1, #0x20]
+	dsb sy
+	b Ldl_m1_progress_next
+Ldl_m1_progress_drain:
+	mov x4, #0x100000
+Ldl_m1_progress_drain_wait:
+	ldr w5, [x1, #0x10]
+	tbnz w5, #2, Ldl_m1_progress_done
+	subs x4, x4, #1
+	b.ne Ldl_m1_progress_drain_wait
+	b Ldl_m1_progress_done
+Ldl_m1_progress_message:
+	.asciz "DARWIN_LAB_M1_BRINGUP checkpoint=start_first_cpu next=bootstrap_tables\r\n"
+	.align 2
+Ldl_m1_progress_done:
