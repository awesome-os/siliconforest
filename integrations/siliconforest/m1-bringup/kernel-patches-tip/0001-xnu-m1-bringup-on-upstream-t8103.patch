-	const size_t counts_len = MIN(recount_topo_count(RCT_TOPO_CPU_KIND),
-	    RECOUNT_CPU_KIND_COUNT);
-	counts.counts_len = (uint16_t)counts_len;
 	// The number of perflevels for this boot can be constrained by the `cpus=`
 	// boot-arg, so determine the runtime number to prevent unexpected calls
 	// into the machine-dependent layers from asserting.
 	unsigned int cpu_types = ml_get_cpu_types();
 	unsigned int level_count = __builtin_popcount(cpu_types);
+	// Recount storage includes holes in the CPU-kind indices. Report only
+	// actual performance levels, as _selfcounts_perf_level does above.
+	const size_t counts_len = MIN(MIN(recount_topo_count(RCT_TOPO_CPU_KIND),
+	    RECOUNT_CPU_KIND_COUNT), level_count);
+	counts.counts_len = (uint16_t)counts_len;
 
 	for (unsigned int i = 0; i < counts_len; i++) {
 		if (i < level_count) {
diff --git a/src/Kernel/xnu/cmake/MakeInc.def.in b/src/Kernel/xnu/cmake/MakeInc.def.in
index 588e67f8..34789efe 100644
--- a/src/Kernel/xnu/cmake/MakeInc.def.in
+++ b/src/Kernel/xnu/cmake/MakeInc.def.in
@@ -64,8 +64,13 @@ COMPONENT_IMPORT_LIST = $(filter-out $(COMPONENT),$(COMPONENT_LIST))
 MACHINE_FLAGS_ARM64_T7000 = -DARM64_BOARD_CONFIG_T7000
 MACHINE_FLAGS_ARM64_T7001 = -DARM64_BOARD_CONFIG_T7001
 MACHINE_FLAGS_ARM64_S8000 = -DARM64_BOARD_CONFIG_S8000 -DCURRENT_MACHINE_CONFIG_LC=$(CURRENT_MACHINE_CONFIG_LC) -mcpu=apple-a9
-# M1, for darwin-vm's qemu (-M darwin) with Apple's j274 device tree
-MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103 -D__ARM_ARCH_8_2__=1 -DCURRENT_MACHINE_CONFIG_LC=$(CURRENT_MACHINE_CONFIG_LC) -mcpu=apple-m1 -DSILICONFOREST_NO_KERNEL_INTEGRITY
+# M1. Upstream's flags (for darwin-vm's qemu, -M darwin, with Apple's j274 device tree) were
+#   -DARM64_BOARD_CONFIG_T8103 -D__ARM_ARCH_8_2__=1 -DCURRENT_MACHINE_CONFIG_LC=... -mcpu=apple-m1 -DSILICONFOREST_NO_KERNEL_INTEGRITY
+# SiliconForest runs the real J293 under the m1n1 hypervisor: the same but DARWIN_LAB_M1_BRINGUP in
+# place of SILICONFOREST_NO_KERNEL_INTEGRITY, which would also turn AppleARMSMP off (board_config.h);
+# the lab's cores are started through AppleARMSMP and SFAppleBootCPUPMGR.
+# __ARM_ARCH_8_2__ selects LSE, which upstream clang does not advertise here.
+MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103 -DCURRENT_MACHINE_CONFIG_LC=$(CURRENT_MACHINE_CONFIG_LC) -mcpu=apple-m1 -D__ARM_ARCH_8_2__=1 -DDARWIN_LAB_M1_BRINGUP=1
 MACHINE_FLAGS_ARM64_S8001 = -DARM64_BOARD_CONFIG_S8001
 MACHINE_FLAGS_ARM_T8002 = -DARM_BOARD_CONFIG_T8002
 MACHINE_FLAGS_ARM_T8004 = -DARM_BOARD_CONFIG_T8004
