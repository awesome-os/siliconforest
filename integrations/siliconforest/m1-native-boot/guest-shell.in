#!/bin/sh
# Guest side of the first native boots: what the kernel says about itself, then the end
# marker. @SSID@/@PSK@ are unused here (the packet assembler fills them in every template).
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
printf '\nPDNB_GUEST_BEGIN_%s\n' "$nonce"
uname -a
for name in kern.sf_pmu_writes kern.version hw.ncpu hw.activecpu hw.memsize kern.boottime kern.bootargs machdep.sfcpu.stats; do
    printf 'SFNB_SYSCTL %s = ' "$name"; sysctl -n "$name" 2>&1 | head -12
done
ps ax 2>&1 | head -20
# the timer: uptime before and after a three-second sleep
printf 'SFNB_UPTIME_A '; sysctl -n machdep.sfcpu.stats 2>&1 | head -1; uptime 2>&1
sleep 3
printf 'SFNB_SLEEP_RC=%s\n' "$?"
printf 'SFNB_UPTIME_B '; uptime 2>&1; date 2>&1
printf 'SFNB_GUEST_END\n'
printf '\nPD_BENCH_DONE\n'
