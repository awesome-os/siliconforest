+def native_return_requested(ops):
+    """Native boots (integrations/puredarwin/m1-native-boot): XNU runs without m1n1, so no proxy
+    USB device shows that the M1 is ours to reset. The launcher's own record that it vectored
+    into XNU takes that place, and only when this boot's native_mode.txt asks for it
+    (`vdm-return`). The reset itself is the same single `macvdmtool reboot serial`."""
+    try:
+        words = (LAB/'integrations/puredarwin/m1-bringup/native_mode.txt').read_text().split()
+        record = base.read_json(ops.cycle/'guest'/'native-start.json')
+        return 'native' in words and 'vdm-return' in words and record.get('hypervisor') is False
+    except (OSError, ValueError, AttributeError):
+        return False
+
