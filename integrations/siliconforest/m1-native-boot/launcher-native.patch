+def paint_boot_logo(backend, carveouts):
+    """Put boot-logo.gz (next to this file, with boot-logo.json; made by
+    integrations/puredarwin/m1-quiet-boot/boot_logo.py) on the panel: m1n1's own
+    framebuffer console is shut down without restoring its saved logo, then the picture is
+    decompressed on the target straight into the firmware framebuffer and read back.
+    After the shutdown the pinned HV.start()'s fb_improve_logo/fb_shutdown do nothing, so the
+    picture stays until a guest driver changes the display. Without the two files, or with
+    another framebuffer geometry, nothing is painted and the screen is left as it was."""
+    here = Path(__file__).resolve().parent
+    try:
+        meta = json.loads((here / 'boot-logo.json').read_text())
+        payload = (here / 'boot-logo.gz').read_bytes()
+    except OSError:
+        return dict(painted=False, reason='no boot-logo.gz/boot-logo.json in the launcher tree')
+    fields = framebuffer_geometry(backend.ba.video, backend, carveouts)
+    size = fields['stride'] * fields['height']
+    if (fields['width'], fields['height'], fields['stride'], fields['depth'] & 0xff, size) != (
+            meta['width'], meta['height'], meta['stride'], meta['depth'], meta['bytes']):
+        return dict(painted=False, reason='framebuffer geometry differs from the picture', geometry=fields)
+    image.require(0 < len(payload) <= 32 << 20, 'Boot picture payload size')
+    import gzip
+    raw = gzip.decompress(payload)
+    image.require(len(raw) == size and image.sha(raw) == meta['sha256'], 'Boot picture payload is not the recorded picture')
+    backend.p.fb_shutdown(False)
+    began = time.time()
+    # Decompressed into ordinary memory and copied: gzdec straight into the framebuffer took
+    # 2.8 s for a 0.4 MB payload (inflate reads its own output back, and the framebuffer is
+    # not cached memory). tinf checks the gzip CRC-32 of what it wrote.
+    with backend.u.heap.guarded_malloc(len(payload)) as address, backend.u.heap.guarded_malloc(size) as staging:
+        backend.iface.writemem(address, payload)
+        written = backend.p.gzdec(address, len(payload), staging, size)
+        image.require(written == size, 'Boot picture decompressed to an unexpected size')
+        backend.p.memcpy64(fields['base'], staging, size)
+    painted = time.time()
+    # Read back 16 rows spread over the panel instead of all 16 MB (1.9 s over USB).
+    stride, rows = fields['stride'], [fields['height'] * (2 * i + 1) // 32 for i in range(16)]
+    matches = all(backend.iface.readmem(fields['base'] + row * stride, stride) == raw[row * stride:(row + 1) * stride]
+                  for row in rows)
+    return dict(painted=True, sha256=meta['sha256'], readback='16 of %d rows' % fields['height'],
+                readback_matches=matches, painted_at=round(painted, 3),
+                paint_seconds=round(painted - began, 3), readback_seconds=round(time.time() - painted, 3))
+
