+def self_reboot_announced(ops):
+    """A guest that restarts the M1 itself (integrations/puredarwin/m1-native-boot/reboot; this
+    boot's launcher tree carries self_reboot_mode.txt): its script printed PD_BENCH_REBOOT on
+    the console just before it asked the kernel to restart."""
+    try:
+        asked = (LAB/'integrations/puredarwin/m1-bringup/self_reboot_mode.txt').exists()
+        raw = base.read_file(ops.cycle/'guest'/'console.bin', 32 << 20).replace(b'\r', b'')
+        return asked and b'\nPD_BENCH_REBOOT\n' in raw
+    except (OSError, ValueError, AttributeError):
+        return False
+
+
+def guest_proxy_still_there(ops, cdc):
+    """The USB device the guest worker used is still enumerated: the hypervisor is alive, so
+    the M1 did not restart."""
+    try:
+        port = base.read_json(ops.cycle/'guest-port.json')
+        return cdc is not None and (cdc['IORegistryEntryID'], cdc['sessionID']) == (
+            port['IORegistryEntryID'], port['sessionID'])
+    except (OSError, ValueError, KeyError, TypeError):
+        return cdc is not None
+
+
+def wait_for_own_linux(ops, old_boot, seconds):
+    """A new, checked Linux boot within `seconds`, or None. Never a reset. One neighbour
+    refresh after 25 s without an answer, as base.recover_linux does (in boots bs01..bs05
+    Linux answered 32 to 34 s after a reset, each time just after that refresh); its record
+    has a name of its own, because base.recover_linux may still write its own later."""
+    started, refreshed = ops.clock(), False
+    while ops.clock() - started < seconds:
+        try:
+            value = ops.observe()
+        except (ConnectionError, TimeoutError):
+            value = None
+        if value is not None:
+            base.check_linux(value)
+            if value['boot_id'] != old_boot:
+                return value
+        if value is None and not refreshed and ops.clock() - started >= 25:
+            refreshed = True
+            ops.save('self-reboot-neighbor-refresh-intent.json',
+                     {'target_only': base.HOST, 'attempt': 1, 'cause_unproven': True})
+            ops.refresh_neighbor()
+        ops.sleep(1)
+    return None
+
+
 def worker_timeout(runtime):
     return 240 if runtime <= 180 else runtime + 60
 
