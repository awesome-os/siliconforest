diff --git i/src/smp.c w/src/smp.c
index ed63e68..03c369e 100644
--- i/src/smp.c
+++ w/src/smp.c
@@ -984,3 +984,24 @@ u64 smp_get_release_addr(int cpu)
     target->args[3] = 0;
     return (u64)&target->target;
 }
+
+/* SiliconForest stage (pdsf_boot.c): the core's reset vector register, 0 if unknown */
+u64 smp_get_impl_reg(int cpu)
+{
+    if (cpu < 0 || cpu >= MAX_CPUS || !cpu_info[cpu].valid)
+        return 0;
+    return cpu_info[cpu].impl_reg;
+}
+
+/*
+ * SiliconForest stage: a core that was called into the resident EL2 page never returns to its
+ * dispatch loop. Drop the call, so that the next stage is not refused for a pending callback.
+ */
+void smp_forget_call(int cpu)
+{
+    if (cpu < 0 || cpu >= MAX_CPUS || cpu == boot_cpu_idx)
+        return;
+    sysop("dmb sy");
+    spin_table[cpu].target = 0;
+    sysop("dsb sy");
+}
