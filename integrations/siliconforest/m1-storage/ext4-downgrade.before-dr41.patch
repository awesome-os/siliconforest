+ * Afterwards the on-disk filesystem is clean (no RECOVER flag, empty journal) and this
+ * driver writes nothing more to it (em_frozen) until ext4_jnl_thaw().
+ */
+int
+ext4_jnl_freeze(struct ext4mount *emp)
+{
+	struct e4jnl *j = (struct e4jnl *)emp->em_jnl;
+	int error;
