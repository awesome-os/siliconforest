+	if (j == NULL || emp->em_frozen)
+		return 0;
+	error = ext4_jnl_commit(emp);
+	if (error == 0)
+		error = e4j_write_jsb(emp, j, 0, j->j_sequence);
+	if (error) {
+		E4LOG("downgrade to read-only: journal not emptied: %d", error);
+		return error;
+	}
+	emp->em_jnl = NULL;
+	emp->em_sb.s_feature_incompat =
+	    le32(le32(emp->em_sb.s_feature_incompat) & ~EXT4_FEATURE_INCOMPAT_RECOVER);
+	error = ext4_write_super(emp);
+	emp->em_jnl = j;
+	e4j_flush_device(emp);
