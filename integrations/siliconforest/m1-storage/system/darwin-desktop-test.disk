#!/bin/sh
# /usr/bin/darwin-desktop-test on a SiliconForest disk root: the command the bench types.
# First what every boot does (clock, leftovers of the last boot: /sbin/sf-boot), then this
# boot's guest script: from the RAM root image (/dev/md0, mounted here read-only on
# /private/ram) when the boot uploaded one, else the disk's own session (/usr/libexec/sf-session).
/sbin/sf-boot
if [ ! -r /private/ram/usr/bin/darwin-desktop-test ] && [ -b /dev/md0 ]; then
    /sbin/mount -t ext4 -o rdonly /dev/md0 /private/ram || echo "SF_DISKROOT the memory disk could not be mounted"
fi
if [ -r /private/ram/usr/bin/darwin-desktop-test ]; then exec /bin/sh /private/ram/usr/bin/darwin-desktop-test "$@"; fi
if [ -r /usr/libexec/sf-session ]; then exec /bin/sh /usr/libexec/sf-session "$@"; fi
echo "SF_DISKROOT no guest script in /private/ram and no /usr/libexec/sf-session"; exit 1
