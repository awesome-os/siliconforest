#!/bin/sh
# SPDX-License-Identifier: MIT
# /usr/bin/shasum for the installed system: the options of Perl's shasum that install scripts
# use, on the userland's own sha1sum/sha256sum/sha512sum (macOS has shasum, not sha256sum;
# Anthropic's installer, for one, calls `shasum -a 256`). Output format is the same.
a=1; check=
while [ $# -gt 0 ]; do
  case "$1" in
    -a|--algorithm) a=$2; shift;;
    -a*) a=${1#-a};;
    --algorithm=*) a=${1#*=};;
    -c|--check) check=-c;;
    -b|--binary|-t|--text|-p|--portable) ;;
    -h|--help) echo "usage: shasum [-a 1|256|512] [-c] [file ...]"; exit 0;;
    --) shift; break;;
    -?*) echo "shasum: unsupported option $1" >&2; exit 2;;
    *) break;;
  esac
  shift
done
case "$a" in
  1|256|512) ;;
  *) echo "shasum: unsupported algorithm $a (1, 256, 512)" >&2; exit 2;;
esac
exec sha${a}sum $check "$@"
