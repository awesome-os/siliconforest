# /etc/ssh/sshd_config of an installed SiliconForest (userland/sf-userland-base.sh puts it there).
# Public keys only. The only account a person uses on this system is root, so root may log in,
# with a key: there is no password to guess (the account has none) and none is ever asked for.
# The machine's only network interface besides the loopback is the Wi-Fi (en0); IPv4.
Port 22
AddressFamily inet
ListenAddress 0.0.0.0
HostKey /etc/ssh/ssh_host_ed25519_key
PidFile /var/run/sshd.pid
PermitRootLogin prohibit-password
AllowUsers root
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
HostbasedAuthentication no
AuthorizedKeysFile .ssh/authorized_keys
StrictModes yes
X11Forwarding no
UseDNS no
LoginGraceTime 30
MaxAuthTries 3
Subsystem sftp /libexec/sftp-server
# what a login gets: the terminal's own PATH (userland/sf-environment is for login shells)
SetEnv PATH=/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/bin:/usr/bin:/sbin:/usr/sbin LANG=en_US.UTF-8
