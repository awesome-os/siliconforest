#!/bin/sh
# SPDX-License-Identifier: MIT
# /usr/local/bin/brew on an installed SiliconForest. Homebrew refuses to run as root, and root
# is who sits at this system's terminal: the client is run as the account `sf` (uid 501, group
# staff, home /Users/sf), which owns /opt/homebrew. What brew installs is run by anyone.
# No automatic update: the client on the disk is a copy of a release without its history.
HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_INSTALL_CLEANUP=1
HOMEBREW_GIT_PATH=/opt/homebrew/bin/git
export HOMEBREW_NO_AUTO_UPDATE HOMEBREW_NO_ANALYTICS HOMEBREW_NO_ENV_HINTS HOMEBREW_NO_INSTALL_CLEANUP HOMEBREW_GIT_PATH
PATH=/opt/homebrew/bin:/opt/homebrew/sbin:/bin:/usr/bin:/sbin:/usr/sbin; export PATH
[ -n "${TERM:-}" ] || { TERM=xterm-256color; export TERM; }
[ -n "${LANG:-}${LC_ALL:-}" ] || { LANG=en_US.UTF-8; export LANG; }
if [ "$(id -u)" = 0 ]; then
    HOME=/Users/sf USER=sf LOGNAME=sf; export HOME USER LOGNAME
    # a directory the account cannot read is no place to start from
    [ -r . ] && [ -x . ] && [ "$(pwd)" != /var/root ] || cd /Users/sf
    exec /usr/bin/hb-runas 501 20 /opt/homebrew/bin/brew "$@"
fi
exec /opt/homebrew/bin/brew "$@"
