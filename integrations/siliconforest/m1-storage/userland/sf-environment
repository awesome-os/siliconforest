# /etc/sf-environment: read by /etc/profile and /etc/zshenv on an installed SiliconForest
# (userland/sf-userland-base.sh adds the line that reads it). Programs a person adds come first.
case ":$PATH:" in
    *:/opt/homebrew/bin:*) ;;
    *) PATH=/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:${PATH:-/bin:/usr/bin:/sbin:/usr/sbin}; export PATH;;
esac
[ -n "${LANG:-}${LC_ALL:-}" ] || { LANG=en_US.UTF-8; export LANG; }
