+/*
+ * The root on the fenced device (rd=uuid boot-uuid=<filesystem UUID>): the whole-disk view of
+ * our partition is guarded in write mode, so the tree's Ext4FileSystemDriver has no media to
+ * match. When the ext4 superblock in the fence's first block carries the boot-uuid, the fenced
+ * media is published as the boot-uuid-media resource the kernel's root search waits for.
+ */
+static void
+fenced_root_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	IOService *res = IOService::getResourceService();
+	OSString *want = res ? OSDynamicCast(OSString, res->getProperty("boot-uuid")) : NULL;
+	IOMedia *media = NULL;
+	uuid_t wanted;
+	uint8_t *blk;
+
+	if (want == NULL || uuid_parse(want->getCStringNoCopy(), wanted) != 0)
+		return;
+	for (unsigned i = 0; i < 300; i++) {
+		media = fenced_media();
+		if (media != NULL && media->getProperty("BSD Name") != NULL)
+			break;
+		media = NULL;
+		IOSleep(100);
+	}
+	blk = (uint8_t *)IOMalloc(BLOCK);
+	if (media == NULL || blk == NULL || part_read(NULL, gAns.fence.first, 1, blk) != 0) {
+		LOG("boot-uuid: the fenced media or its first block could not be had; not published as the root");
+	} else if (blk[1024 + 0x38] != 0x53 || blk[1024 + 0x39] != 0xef || memcmp(blk + 1024 + 0x68, wanted, 16) != 0) {
+		LOG("boot-uuid: the filesystem on the fenced device is not the one asked for; not published as the root");
+	} else {
+		LOG("boot-uuid: the ext4 filesystem on the fenced device matches; publishing %s as boot-uuid-media", media->getName());
+		IOService::publishResource("boot-uuid-media", media);
+		res->removeProperty("boot-uuid");
+	}
+	if (blk != NULL)
+		IOFree(blk, BLOCK);
+}
