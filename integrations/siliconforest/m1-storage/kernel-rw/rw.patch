+/*
+ * A write of the slot's own buffer. The range is looked at here, before a command exists
+ * (and then by the gate, twice, and by the second look, twice, in ring()).
+ */
+int
+SFAns::submitWrite(unsigned s, uint64_t lba, uint32_t blocks, void *cookie)
+{
+	uint8_t sqe[SQE_SIZE] = { 0 };
+
+	if (s >= SF_ANS_SLOTS || slot[s].busy || blocks == 0 || blocks > SF_NVMEW_MAX_WRITE_BLOCKS)
+		return EINVAL;
+	if (!sf_wabs_ok(&fence, lba, blocks))
+		return EPERM;
+	sqe[0] = SF_NVMEW_IO_WRITE;
+	p32(sqe + SQE_NSID, SF_NVME_NSID);
+	p64(sqe + SQE_PRP1, slot[s].data.phys);
+	if (blocks == 2)
+		p64(sqe + SQE_PRP2, slot[s].data.phys + 4096);
+	else if (blocks > 2)
+		p64(sqe + SQE_PRP2, slot[s].prp.phys);
+	p32(sqe + SQE_CDW10, (uint32_t)lba);
+	p32(sqe + SQE_CDW11, (uint32_t)(lba >> 32));
+	p32(sqe + SQE_CDW12, blocks - 1);
+	slot[s].busy = true;
+	slot[s].cookie = cookie;
+	slot[s].blocks = blocks;
+	slot[s].submitted = sf_ans_now_us();
+	if (!ring(SF_NVME_Q_IO, SF_ANS_AQ_DEPTH + s, sqe, true)) {
+		slot[s].busy = false;
+		return EPERM;
+	}
+	inflight++;
+	writeCommands++;
+	writeBlocks += blocks;
+	return 0;
+}
+
+int
+SFAns::submitFlush(unsigned s, void *cookie)
+{
+	uint8_t sqe[SQE_SIZE] = { 0 };
+
+	if (s >= SF_ANS_SLOTS || slot[s].busy)
+		return EINVAL;
+	sqe[0] = SF_NVMEW_IO_FLUSH;
+	p32(sqe + SQE_NSID, SF_NVME_NSID);
+	slot[s].busy = true;
+	slot[s].cookie = cookie;
+	slot[s].blocks = 0;
+	slot[s].submitted = sf_ans_now_us();
+	if (!ring(SF_NVME_Q_IO, SF_ANS_AQ_DEPTH + s, sqe, false)) {
+		slot[s].busy = false;
+		return EPERM;
+	}
+	inflight++;
+	flushCommands++;
+	return 0;
+}
+
+int
+SFAns::flushWait(uint32_t timeoutMs)
+{
+	uint64_t deadline = sf_ans_now_us() + (uint64_t)timeoutMs * 1000;
+	SFAnsCompletion c;
+	int err;
+
+	if (dead || !ioQueues || inflight != 0)
+		return EBUSY;
+	err = submitFlush(0, NULL);
+	if (err != 0)
+		return err;
+	for (;;) {
+		if (reap(&c, 1) == 1)
+			return c.status == 0 ? 0 : EIO;
+		if (sf_ans_now_us() > deadline || crashed) {
+			cmdTimeouts++;
+			dead = true;
+			LOG("flush: no completion in %u ms; the controller is not used any more", timeoutMs);
+			return ETIMEDOUT;
+		}
+		IOSleep(1);
+	}
+}
