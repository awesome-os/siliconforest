+		{ first - 1, 1, 0 }, { last + 1, 1, 0 }, { first - 1, 2, 0 }, { last, 2, 0 }, { first - 255, 256, 0 }, { last - 254, 256, 0 },
+		{ 0, 1, 0 }, { 1, 1, 0 }, { 6, 1, 0 }, { ns - 1, 1, 0 }, { ns, 1, 0 }, { first | (1ULL << 32), 1, 0 }, { ~0ULL, 2, 0 },
+	};
