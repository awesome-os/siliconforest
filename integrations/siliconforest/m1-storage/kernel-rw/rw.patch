+IOReturn
+SFAppleNVMeFenced::doAsyncReadWrite(IOMemoryDescriptor *buffer, UInt64 block, UInt64 nblks, __unused IOStorageAttributes *attributes,
+    IOStorageCompletion *completion)
+{
+	uint64_t lba = 0;
+	IOReturn ret;
+
+	if (buffer == NULL)
+		return kIOReturnBadArgument;
+	IODirection dir = buffer->getDirection();
+	if (dir != kIODirectionIn && dir != kIODirectionOut)
+		return kIOReturnBadArgument;
+	/* relative to the fence; anything not wholly inside goes no further */
+	if (sf_wdev_map(&gAns.fence, block, nblks, &lba) != 0 || buffer->getLength() < nblks * BLOCK) {
+		OSIncrementAtomic64((volatile SInt64 *)&gRangeRefused);
+		OSAddAtomic64((SInt64)nblks, (volatile SInt64 *)&gRangeRefusedBlocks);
+		return kIOReturnBadArgument;
+	}
+	ret = buffer->prepare(dir);
+	if (ret != kIOReturnSuccess)
+		return ret;
+	if (dir == kIODirectionIn) {
+		OSIncrementAtomic64((volatile SInt64 *)&gOursRequests);
+		OSAddAtomic64((SInt64)nblks, (volatile SInt64 *)&gOursBlocks);
+		ret = sf_read(lba, nblks, md_sink, buffer);
+	} else {
+		ret = sf_write(lba, nblks, buffer);
+	}
+	buffer->complete(dir);
+	IOStorage::complete(completion, ret, ret == kIOReturnSuccess ? nblks * BLOCK : 0);
+	return kIOReturnSuccess;
+}
+
+/* The filesystem's barrier: an NVMe Flush after the writes queued before it. Sealed: nothing was written since the seal's own. */
+IOReturn
+SFAppleNVMeFenced::doSynchronize(__unused UInt64 block, __unused UInt64 nblks, __unused IOStorageSynchronizeOptions options)
+{
+	if (gSealed)
+		return kIOReturnSuccess;
+	IOReturn ret = sf_flush();
+	return ret == kIOReturnSuccess ? kIOReturnSuccess : kIOReturnIOError;
+}
