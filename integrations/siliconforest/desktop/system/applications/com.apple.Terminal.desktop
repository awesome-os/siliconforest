[Desktop Entry]
Type=Application
Name=Terminal
Comment=Apple's Terminal (the bundle in /Applications/Utilities): brought forward when it runs, else opened
TryExec=/Applications/Utilities/Terminal.app/Contents/MacOS/Terminal
Exec=/usr/bin/chonkstep-darwin-desktop --desktop-request application com.apple.Terminal
Icon=/Applications/Utilities/Terminal.app
Categories=System;TerminalEmulator;
StartupWMClass=com.apple.Terminal
