[Desktop Entry]
Type=Application
Name=Activity Monitor
Comment=Apple's Activity Monitor (the bundle in /System/Applications/Utilities, where ACTMON installs it): brought forward when it runs, else opened
TryExec=/System/Applications/Utilities/Activity Monitor.app/Contents/MacOS/Activity Monitor
Exec=/usr/bin/chonkstep-darwin-desktop --desktop-request application com.apple.ActivityMonitor
Icon=/System/Applications/Utilities/Activity Monitor.app
Categories=System;Monitor;
StartupWMClass=com.apple.ActivityMonitor
