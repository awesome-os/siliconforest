#!/bin/sh
# Guest CPU benchmark: megabytes of zeros hashed with sha256 in 20 seconds, twice, plus a
# pure-shell loop count. Used to compare boots with and without the launcher's cpufreq step.
# (@SSID@/@PSK@ are unused; the placeholders exist because the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
printf '\nDL38_CPU_BEGIN_%s\n' "$nonce"
sysctl hw.ncpu hw.cpufrequency hw.tbfrequency 2>&1 | head -4
for run in 1 2; do
    i=0; end=$(( $(date +%s) + 20 ))
    while [ "$(date +%s)" -lt "$end" ]; do
        dd if=/dev/zero bs=1048576 count=8 2>/dev/null | sha256sum > /dev/null
        i=$((i+1))
    done
    printf 'DL38_SHA256_RUN%s megabytes_in_20s=%s\n' "$run" "$((i*8))"
done
n=0; end=$(( $(date +%s) + 10 ))
while [ "$(date +%s)" -lt "$end" ]; do n=$((n+1)); done
printf 'DL38_SHELL_LOOP iterations_in_10s=%s\n' "$n"
printf 'DL38_CPU_END_%s\n' "$nonce"
