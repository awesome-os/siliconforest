#!/bin/sh
# Guest side of the PCIe enumeration boot: the evidence is the kernel log on the
# serial console (SFApcieT8103 / SFBCM4378Probe lines). This only frames it.
nonce=${1:-none}
printf '\nDL32_PCIE_ENUM_BEGIN_%s\n' "$nonce"
/bin/sleep 8 2>/dev/null || sleep 8
printf 'DL32_PCIE_ENUM_SETTLED_%s\n' "$nonce"
/bin/uname -s
/bin/uname -m
/bin/uname -r
printf 'DL32_PCIE_ENUM_END_%s\n' "$nonce"
