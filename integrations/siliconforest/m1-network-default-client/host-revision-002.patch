+def frame(kind, seq, payload=b'', direction=1, nonce=NONCE):
+    raw = HEADER.pack(b'DLNET001', kind, direction, 0, len(payload), 56,
+                      seq, bytes.fromhex(nonce), 0, 0) + payload
