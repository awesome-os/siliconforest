+                    raise ValueError('frame length/open phase')
+                if self.opened and not ((kind == 2 and size >= 20) or (kind == 3 and size == 0)):
+                    raise ValueError('frame phase')
+                if self.next == (1 << 64) - 1 and kind != 3:
+                    raise ValueError('sequence exhaustion')
