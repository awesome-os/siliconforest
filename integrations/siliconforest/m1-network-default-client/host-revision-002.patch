+            if not isinstance(raw, bytes) or len(self.buffer) + len(raw) > 8192:
+                raise ValueError('frame buffer cap')
+            self.buffer.extend(raw)
+            frames = []
+            while self.buffer:
+                if self.closed:
+                    raise ValueError('data after CLOSE')
+                if len(self.buffer) < 56:
+                    break
