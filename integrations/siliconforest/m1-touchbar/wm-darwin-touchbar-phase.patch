+/// The Touch Bar driver's test entry (SFAppleTouchBar, `kern.sf_touchbar.*`); absent anywhere else.
+mod touchbar {
+    /// The current layer's keys: "usage:x ..." (usage in hex, x in the digitizer's units).
+    #[cfg(target_os = "macos")]
+    pub fn keys() -> Result<String, String> {
+        let mut text = [0u8; 1024];
+        let mut size = text.len() - 1;
+        // SAFETY: `text` and `size` describe the buffer; no new value is passed.
+        let result = unsafe { libc::sysctlbyname(c"kern.sf_touchbar.keys".as_ptr(), text.as_mut_ptr().cast(), &mut size, std::ptr::null_mut(), 0) };
+        if result != 0 {
+            return Err(format!("kern.sf_touchbar.keys: errno {}", std::io::Error::last_os_error().raw_os_error().unwrap_or(0)));
+        }
+        Ok(String::from_utf8_lossy(&text[..size]).trim_end_matches('\0').to_string())
+    }
+    #[cfg(not(target_os = "macos"))]
+    pub fn keys() -> Result<String, String> {
+        Err("no Touch Bar driver on this system".into())
+    }
+    /// Where the key that sends `usage` is, from the driver's list.
+    pub fn position(keys: &str, usage: u8) -> Option<u32> {
+        keys.split_whitespace().find_map(|key| {
+            let (u, x) = key.split_once(':')?;
+            (u8::from_str_radix(u, 16).ok()? == usage).then(|| x.parse().ok())?
+        })
+    }
+    /// One finger record: down on (state 3) or up from (state 7) the key that sends `usage`.
+    pub fn touch(usage: u8, down: bool) -> Result<(), String> {
+        let keys = keys()?;
+        let x = position(&keys, usage).ok_or_else(|| format!("no key sends usage {usage:#04x} in \"{keys}\""))?;
+        inject(&format!("1 {} {x} 320", if down { 3 } else { 7 }))
+    }
+    #[cfg(target_os = "macos")]
+    fn inject(record: &str) -> Result<(), String> {
+        let text = std::ffi::CString::new(record).map_err(|_| "record".to_string())?;
+        // SAFETY: the new value is the record's bytes with their terminator; nothing is read back.
+        let result = unsafe {
+            libc::sysctlbyname(c"kern.sf_touchbar.inject".as_ptr(), std::ptr::null_mut(), std::ptr::null_mut(), text.as_ptr().cast_mut().cast(), record.len() + 1)
+        };
+        if result == 0 { Ok(()) } else { Err(format!("kern.sf_touchbar.inject \"{record}\": errno {}", std::io::Error::last_os_error().raw_os_error().unwrap_or(0))) }
+    }
+    #[cfg(not(target_os = "macos"))]
+    fn inject(_: &str) -> Result<(), String> {
+        Err("no Touch Bar driver on this system".into())
+    }
+}
