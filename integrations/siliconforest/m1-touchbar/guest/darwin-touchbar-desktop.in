#!/bin/sh
# SPDX-License-Identifier: MIT
# The whole desktop with the Touch Bar, unattended: ../../m1-sound/guest/darwin-sound-desktop.in
# (Wi-Fi joins in the background, coreaudiod runs, the shared-shell desktop runs on the GL
# renderer with two terminals and drives itself, sound plays meanwhile) with SFAppleTouchBar
# in the collection. The compositor's autopilot has one more phase, `touchbar`: it writes
# finger records for F11 F11 F12 F12 F10 F10 (the media layer's quieter, louder and mute
# keys) to kern.sf_touchbar.inject; the
# driver parses them as it parses the digitizer's reports, the keys travel through
# IOHIDFamily and /dev/usb_hid_kbd like the built-in keyboard's, and the compositor's
# volume keys move coreaudiod's level. The strip's idle timeouts are switched off for the
# run: a touch on a dark strip only lights it, and nobody is there to touch it first.
# Speakers: kern.sf_speaker.hold_probe=1 as in the sound test; tones @SPKDB@ dB below full scale.
# @SSID@/@PSK@ are filled from private/wifi.env at packet assembly; the filled script is
# never committed.
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
case "$nonce" in *[!0-9a-f]*|'') session=000000000000000000000000000000000000000000000001 ;; *) session=$nonce ;; esac
[ "${#session}" -eq 48 ] || session=000000000000000000000000000000000000000000000001
runtime=/private/var/run/sound-desktop
mkdir -p "$runtime" && chmod 0700 "$runtime"
export XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY=wayland-0
export XKB_CONFIG_ROOT=/usr/share/X11/xkb TMPDIR=/private/tmp
export CHONKSTEP_DARWIN_FRAME_STATS=120
[ -d /usr/share/backgrounds/siliconforest ] && export CHONKSTEP_BACKGROUND_DIR=/usr/share/backgrounds/siliconforest
get() { sysctl -n "$1" 2>/dev/null; }
printf '\nTBDESK_BEGIN_%s\n' "$nonce"
sysctl hw.ncpu hw.activecpu 2>&1
printf 'TBDESK_SOUND %s | %s\n' "$(get kern.sf_sound.state)" "$(get kern.sf_speaker.state)"
n=0
while [ "$n" -lt 60 ]; do
    case "$(get kern.sf_touchbar.state)" in ready*|display-only*|display-failed*|off*|'') break;; esac
    sleep 1; n=$((n+1))
done
tb() {
    printf 'TBDESK_TOUCHBAR %s state=%s | fb_crc=%s layer=%s fn_known=%s kbd_notes=%s brightness=%s | reports=%s fingers=%s injected=%s key_events=%s hid_reports=%s hid_errors=%s direct=%s | dart_faults=%s dsi_errors=%s spi_errors=%s irqs=%s\n' \
        "$1" "$(get kern.sf_touchbar.state)" "$(get kern.sf_touchbar.fb_crc)" "$(get kern.sf_touchbar.layer)" "$(get kern.sf_touchbar.fn_known)" "$(get kern.sf_touchbar.kbd_notes)" \
        "$(get kern.sf_touchbar.actual_brightness)" "$(get kern.sf_touchbar.reports)" "$(get kern.sf_touchbar.fingers)" \
        "$(get kern.sf_touchbar.injected)" "$(get kern.sf_touchbar.key_events)" "$(get kern.sf_touchbar.hid_reports)" \
        "$(get kern.sf_touchbar.hid_errors)" "$(get kern.sf_touchbar.direct_events)" "$(get kern.sf_touchbar.dart_faults)" \
        "$(get kern.sf_touchbar.dsi_errors)" "$(get kern.sf_touchbar.spi_errors)" "$(get kern.sf_touchbar.irqs)"
}
sysctl -w kern.sf_touchbar.dim_ms=0 kern.sf_touchbar.off_ms=0 > /dev/null 2>&1
tb start
printf 'TBDESK_TOUCHBAR_DISPLAY %s\n' "$(get kern.sf_touchbar.display)"
printf 'TBDESK_TOUCHBAR_TOUCH %s\n' "$(get kern.sf_touchbar.touch)"
printf 'TBDESK_TOUCHBAR_CRC expected=@CRC_MEDIA@ got=%s\n' "$(get kern.sf_touchbar.fb_crc)"
(
    if command -v wifiutil >/dev/null 2>&1 && [ -d /Library/Firmware/brcm ]; then
        sleep 4; sf-dhcp --up en0 >/dev/null 2>&1; sleep 2
        wifiutil on >/dev/null 2>&1; sleep 8
        wifiutil join '@SSID@' '@PSK@' >/dev/null 2>&1; printf 'TBDESK_WIFI_JOIN_RC=%s\n' "$?"
        sleep 4; sf-net-up en0 >/dev/null 2>&1; printf 'TBDESK_NET_UP_RC=%s\n' "$?"
        ping -c 2 1.1.1.1 >/dev/null 2>&1; printf 'TBDESK_PING_RC=%s\n' "$?"
    else
        printf 'TBDESK_WIFI_SKIPPED\n'
    fi
) &
wifi_job=$!
# the audio server, as the desktop session starts it
sysctl -w kern.sf_speaker.hold_probe=1 kern.sf_sound.volume_db=@VOLUME@ > /dev/null 2>&1
mkdir -p /var/log /Library/Preferences
/usr/sbin/coreaudiod > /var/log/coreaudiod.log 2>&1 &
printf 'TBDESK_COREAUDIOD pid=%s hold_probe=%s\n' "$!" "$(get kern.sf_speaker.hold_probe)"
# sound while the desktop runs
(
    sleep 45
    printf 'TBDESK_VOLUME %s\n' "$(sfvolume get 2>&1 | tail -1)"
    if [ "$(get kern.sf_speaker.hold_probe)" = 1 ]; then
        sftone -f 440 -s 4 -d @SPKDB@ 2>&1 | tail -2
        printf 'TBDESK_SPEAKERS frames=%s sessions=%s trips=%s model=%s\n' "$(get kern.sf_speaker.frames)" \
            "$(get kern.sf_speaker.sessions)" "$(get kern.sf_speaker.trips)" "$(get kern.sf_speaker.model)"
    fi
    sftone -u SFAudio:headphones -f 1000 -s 4 -d @TONEDB@ 2>&1 | tail -2
    printf 'TBDESK_HEADPHONES frames=%s sessions=%s late=%s ring_errors=%s i2c_errors=%s jack=%s\n' "$(get kern.sf_sound.frames)" \
        "$(get kern.sf_sound.sessions)" "$(get kern.sf_sound.late)" "$(get kern.sf_sound.ring_errors)" \
        "$(get kern.sf_sound.i2c_errors)" "$(get kern.sf_sound.jack)"
    dd if=/dev/sfmic of=/dev/null bs=4096 count=47 2>/dev/null
    printf 'TBDESK_MIC %s\n' "$(get kern.sf_sound.mic)"
) &
sound_job=$!
[ -x /usr/bin/darwin-trackpad-enum ] && { /usr/bin/darwin-trackpad-enum --nonce "$session"; printf 'TBDESK_ENUM rc=%s\n' "$?"; }
count=0
while [ ! -c /dev/usb_hid_kbd ] || [ ! -c /dev/usb_hid_mouse ]; do
    count=$((count + 1)); [ "$count" -le 100 ] || break; sleep 0.1
done
printf 'TBDESK_INPUT kbd=%s mouse=%s\n' "$([ -c /dev/usb_hid_kbd ] && echo yes || echo no)" "$([ -c /dev/usb_hid_mouse ] && echo yes || echo no)"
records=$runtime/session-$session
mkdir -m 0700 "$records"
printf 'TBDESK_DESKTOP_START seconds=165 start=%s\n' "$(date +%s)"
CHONKSTEP_DARWIN_AUTOPILOT=1 CHONKSTEP_DARWIN_MAX_TERMINALS=3 /usr/bin/chonkstep-darwin-desktop --run --socket "$runtime/wayland-0" --records "$records" --session "$session" --terminal /usr/bin/chonk-terminal-darwin --seconds 165 --font-regular /usr/share/darwin-desktop/DejaVuSans.ttf --font-bold /usr/share/darwin-desktop/DejaVuSans-Bold.ttf --input sfhid --startup-terminals 2 --renderer gl 2>&1 | grep -v 'chonkstep-gl: step:'
printf 'TBDESK_DESKTOP_END end=%s\n' "$(date +%s)"
[ -r "$records/session-result.txt" ] && grep -v ' gate=\| kernel_messages=\| cs_at_spawn=\| exit_reason=' "$records/session-result.txt" | cut -c1-260 | sed 's/^/TBDESK_RESULT /' | head -40
# the two jobs of this script; a bare `wait` would also wait for coreaudiod, which does not end
wait "$wifi_job" "$sound_job"
tb end
printf 'TBDESK_TOUCHBAR_TOUCH %s\n' "$(get kern.sf_touchbar.touch)"
sysctl -w kern.sf_touchbar.dim_ms=30000 kern.sf_touchbar.off_ms=60000 > /dev/null 2>&1
tail -25 /var/log/coreaudiod.log | sed 's/^/TBDESK_COREAUDIOD_LOG /'
sysctl kern.sf_sound.state kern.sf_sound.sessions kern.sf_sound.frames kern.sf_sound.jack_irqs kern.sf_speaker.state kern.sf_speaker.model \
    kern.sf_speaker.sessions kern.sf_speaker.trips 2>&1
printf 'TBDESK_END_%s\n' "$nonce"
printf '\nPD_BENCH_DONE\n'
