+#ifdef __APPLE__
+/* Darwin has no ppoll(): poll() with the timeout rounded up to whole
+ * milliseconds.  The signal mask is left alone; the caller passes NULL. */
+#include <poll.h>
+#include <signal.h>
+#include <time.h>
+static inline int
+ppoll(struct pollfd *fds, nfds_t nfds, const struct timespec *timeout,
+      const sigset_t *sigmask)
+{
+   int ms = -1;
+
+   (void)sigmask;
+   if (timeout != NULL) {
+      long long t = (long long)timeout->tv_sec * 1000 +
+                    (timeout->tv_nsec + 999999) / 1000000;
+      ms = t > 0x7fffffff ? 0x7fffffff : (int)t;
+   }
+   return poll(fds, nfds, ms);
+}
+#endif
+
 #include <poll.h>
