+++ b/src/asahi/lib/agx_device.h	2026-11-10 01:29:57.080706914 -0800
@@ -10,6 +10,17 @@
 #include <xf86drm.h>
 #endif
 #include "drm-uapi/asahi_drm.h"
+
+/* BSD <sys/ioccom.h> (Darwin, via drm.h) has _IOC() with Linux's argument order but none of the
+ * Linux field accessors.  _IOC_DIR keeps the direction bits in place, which is what BSD's _IOC()
+ * takes back, so _IOC(_IOC_DIR(x), _IOC_TYPE(x), _IOC_NR(x), size) re-sizes a request on both.
+ */
+#if !defined(_IOC_SIZE) && defined(IOCPARM_LEN)
+#define _IOC_DIR(x)  ((x) & IOC_DIRMASK)
+#define _IOC_TYPE(x) (((x) >> 8) & 0xff)
+#define _IOC_NR(x)   ((x) & 0xff)
+#define _IOC_SIZE(x) IOCPARM_LEN(x)
+#endif
 #include "util/ralloc.h"
 #include "util/cnd_monotonic.h"
 #include "util/u_thread.h"
