#!/bin/sh
# Guest side of the off-screen GL test. Runs Mesa's software renderer first (needs no GPU
# driver: proves EGL, the Mesa libraries and libSystem work on this OS), then the GPU path
# if a render node exists. (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nDL40_AGX_BEGIN_%s\n' "$nonce"
ls -l /dev/dri 2>&1 | head -5
sysctl kern.sf_dri 2>&1 | head -5
LIBGL_ALWAYS_SOFTWARE=1 agx-offscreen-test --no-drm 2>&1 | grep -v '^agx-offscreen-test:   ' | cut -c1-200
printf 'DL40_SOFT_RC=%s\n' "$?"
if ls /dev/dri/renderD* >/dev/null 2>&1; then
    agx-offscreen-test --require-renderer "Apple M1" --expect-b 8fee6b41134a7b3eaa7e9b0f61aa6e907d21cafd4a2685a00a4699c3b32da274 2>&1 | grep -v '^agx-offscreen-test:   ' | cut -c1-200
    printf 'DL40_GPU_RC=%s\n' "$?"
else
    printf 'DL40_GPU_SKIPPED no render node\n'
fi
printf 'DL40_AGX_END_%s\n' "$nonce"
