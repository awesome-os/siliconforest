#!/bin/sh
# Guest side of a Wi-Fi bring-up boot. Kernel SFBwfm/SFDart lines on the serial
# console are the main evidence; this drives wifiutil and frames the output.
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
printf '\nDL33_WIFI_BEGIN_%s\n' "$nonce"
ls -l /Library/Firmware/brcm 2>&1
i=0
while [ $i -lt 12 ]; do
    sleep 5
    i=$((i+1))
    printf 'DL33_WIFI_TICK_%s %s\n' "$i" "$nonce"
    if [ $i -eq 2 ]; then wifiutil on 2>&1; fi
    if [ $i -eq 4 ] || [ $i -eq 7 ] || [ $i -eq 10 ]; then
        wifiutil info 2>&1
        printf 'DL33_WIFI_SCAN_%s\n' "$i"
        wifiutil scan 2>&1
    fi
done
printf 'DL33_WIFI_END_%s\n' "$nonce"
