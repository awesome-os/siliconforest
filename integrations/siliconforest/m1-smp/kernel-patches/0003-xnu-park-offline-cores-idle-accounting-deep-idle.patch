+/*
+ * SiliconForest: parked cores, deep idle and the accounting for both.
+ *
+ * Parking. xnu takes a core offline (processor_exit, cluster power-down) by setting
+ * CYC_OVRD "ok to power down" with WFI retention disabled and executing WFI: the core loses
+ * power and the PMGR start bit later resets it into the reset vector. Where that state is
+ * not available the core cannot be reset: the m1n1 hypervisor refuses a CYC_OVRD write that
+ * disables WFI retention or masks FIQs (src/hv/hv_exc.c), and its PMGR start hook can only
+ * start a core that is not yet in the guest (hv_start_secondary). There the core is parked
+ * instead (sfcpupark, the default): it stays in WFI with its timer off and interrupts
+ * masked, having done everything else cpu_sleep() does, and PE_cpu_start_internal() wakes it
+ * with an IPI rather than through the power manager. It then re-enters arm_init_cpu() on
+ * its start-up stacks exactly as start_cpu would have sent it there after a reset; nothing
+ * was lost, so the register set-up between the reset vector and that point is not repeated.
+ * sfcpupark=0 selects xnu's own power-down path (not implemented by SFAppleBootCPUPMGR).
+ *
+ * Deep idle (sfidledeep / machdep.sfcpu.deep_wfi, off by default): before an idle WFI that
+ * the next timer leaves at least 10 ms long, select CYC_OVRD WFI mode 3 as Linux's
+ * cpuidle-apple "CPU PD" state does on this SoC (10 ms target residency), and put the
+ * register back on the way out. HAS_RETENTION_STATE's arm64_retention_wfi() already copes
+ * with the general registers being lost across WFI.
+ */
+struct sf_cpu_stat {
+	uint64_t idle_count;            /* idle WFIs left */
+	uint64_t idle_abs;              /* time between entering WFI and leaving idle */
+	uint64_t idle_short;            /* of them, shorter than 20 us: WFI did not wait */
+	uint64_t idle_deep;             /* entered in WFI mode 3 */
+	uint64_t idle_start;
+	uint64_t cyc_ovrd;              /* CYC_OVRD as first seen on this core, + 1 */
+	uint64_t cyc_ovrd_saved;
+	uint64_t park_count;            /* times parked */
+	uint64_t park_wakeups;          /* WFI returns while parked */
+	uint64_t unpark_count;
+	uint32_t parked;                /* in (or on the way into) the park loop */
+	uint32_t unpark;                /* asked to leave it */
+	uint32_t deep_armed;
+} __attribute__((aligned(128)));
+struct sf_cpu_stat sf_cpu_stats[MAX_CPUS];
+
+TUNABLE(bool, sf_cpu_park, "sfcpupark", true);
+TUNABLE_WRITEABLE(unsigned int, sf_idle_deep, "sfidledeep", 0);
+
+#define SF_CYC_OVRD             "S3_5_C15_C5_0"
+#define SF_CYC_OVRD_WFI_DEEP    (3ULL << 24)            /* m1n1 CYC_OVRD_WFI_MODE(3) */
+/* the hypervisor refuses a write with either set: DISABLE_WFI_RET, FIQ_MODE */
+#define SF_CYC_OVRD_REFUSED     ((1ULL << 0) | (3ULL << 20))
+#define SF_IPI_SR               "S3_5_C15_C1_1"
+
+extern void arm64_park_wfi(void);
+extern void __attribute__((noreturn)) arm64_park_restart(cpu_data_t *cpu_data_ptr);
+extern void ml_sf_park_quiet_timer(void);
+bool sf_cpu_unpark(int cpu);
+int sf_cpu_stats_string(char *buf, int len);
+
+static inline void
+sf_cpu_idle_enter(cpu_data_t *cdp)
+{
+	struct sf_cpu_stat *st = &sf_cpu_stats[cdp->cpu_number];
+	uint64_t now = mach_absolute_time();
+
+	if (__improbable(st->cyc_ovrd == 0)) {
+		st->cyc_ovrd = __builtin_arm_rsr64(SF_CYC_OVRD) + 1;
+	}
+	if (__improbable(sf_idle_deep != 0)) {
+		static uint64_t min_abs;
+		uint64_t pop = cdp->rtcPop;
+
+		if (min_abs == 0) {
+			nanoseconds_to_absolutetime(10 * NSEC_PER_MSEC, &min_abs);
+		}
+		if (pop > now && pop - now >= min_abs) {
+			uint64_t ovrd = __builtin_arm_rsr64(SF_CYC_OVRD);
+
+			if ((ovrd & SF_CYC_OVRD_REFUSED) == 0) {
+				st->cyc_ovrd_saved = ovrd;
+				__builtin_arm_wsr64(SF_CYC_OVRD, ovrd | SF_CYC_OVRD_WFI_DEEP);
+				__builtin_arm_isb(ISB_SY);
+				st->deep_armed = 1;
+				st->idle_deep++;
+			}
+		}
+	}
+	st->idle_start = now;
+}
+
+static inline void
+sf_cpu_idle_exit(cpu_data_t *cdp)
+{
+	struct sf_cpu_stat *st = &sf_cpu_stats[cdp->cpu_number];
+
+	if (__improbable(st->deep_armed)) {
+		st->deep_armed = 0;
+		__builtin_arm_wsr64(SF_CYC_OVRD, st->cyc_ovrd_saved);
+		__builtin_arm_isb(ISB_SY);
+	}
+	if (st->idle_start != 0) {
+		static uint64_t short_abs;
+		uint64_t waited = mach_absolute_time() - st->idle_start;
+
+		if (short_abs == 0) {
+			nanoseconds_to_absolutetime(20 * NSEC_PER_USEC, &short_abs);
+		}
+		st->idle_start = 0;
+		st->idle_count++;
+		st->idle_abs += waited;
+		if (waited < short_abs) {
+			st->idle_short++;
+		}
+	}
+}
+
+/* The offline core's last stop. Interrupts are masked and stay masked. */
+static void __attribute__((noreturn))
+sf_cpu_park_loop(cpu_data_t *cdp)
+{
+	struct sf_cpu_stat *st = &sf_cpu_stats[cdp->cpu_number];
+
+	/* a timer that fires here could only make every WFI return at once */
+	ml_sf_park_quiet_timer();
+	st->park_count++;
+	while (os_atomic_load(&st->unpark, acquire) == 0) {
+		arm64_park_wfi();
+		st->park_wakeups++;
+		/* take the IPI that woke us (or any other) off the line, as sleh_fiq would */
+		__builtin_arm_wsr64(SF_IPI_SR, 1);
+		__builtin_arm_isb(ISB_SY);
+	}
+	os_atomic_store(&st->unpark, 0, release);
+	st->unpark_count++;
+	arm64_park_restart(cdp);
+}
+
+/*
+ * Called by PE_cpu_start_internal() on the starting CPU, after cpu_start() has prepared the
+ * target's cpu data. True: the target was parked and has been told to restart, the power
+ * manager must not be asked to release it from reset.
+ */
+bool
+sf_cpu_unpark(int cpu)
+{
+	struct sf_cpu_stat *st;
+
+	if (!sf_cpu_park || cpu < 0 || cpu >= MAX_CPUS) {
+		return false;
+	}
+	st = &sf_cpu_stats[cpu];
+	if (os_atomic_load(&st->parked, acquire) == 0) {
+		return false;
+	}
+	os_atomic_store(&st->parked, 0, release);
+	os_atomic_store(&st->unpark, 1, release);
+	__builtin_arm_dsb(DSB_ISH);
+	disable_preemption();
+	ml_cpu_signal(ml_get_topology_info()->cpus[cpu].phys_id);
+	enable_preemption();
+	return true;
+}
+
+/* machdep.sfcpu.stats: one line per core */
+int
+sf_cpu_stats_string(char *buf, int len)
+{
+	int used = 0;
+
+	for (int cpu = 0; cpu < MAX_CPUS && used < len - 1; cpu++) {
+		const struct sf_cpu_stat *st = &sf_cpu_stats[cpu];
+		uint64_t idle_ns = 0;
+
+		if (st->idle_count == 0 && st->park_count == 0 && st->cyc_ovrd == 0) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(st->idle_abs, &idle_ns);
+		used += scnprintf(buf + used, (size_t)(len - used),
+		    "cpu%d idle=%llu wfi_us=%llu short=%llu deep=%llu cyc_ovrd=0x%llx "
+		    "park=%llu parkwake=%llu unpark=%llu parked=%u\n",
+		    cpu, st->idle_count, idle_ns / NSEC_PER_USEC, st->idle_short, st->idle_deep,
+		    st->cyc_ovrd ? st->cyc_ovrd - 1 : 0,
+		    st->park_count, st->park_wakeups, st->unpark_count, st->parked);
+	}
+	return used;
+}
