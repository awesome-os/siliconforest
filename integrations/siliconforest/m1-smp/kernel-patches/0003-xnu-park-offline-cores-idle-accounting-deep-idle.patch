+/*
+ * SiliconForest: WFI for a core parked offline (osfmk/arm64/cpu.c, sf_cpu_park_loop).
+ * A core of this family can come back from WFI with its general registers cleared and
+ * only sp, pc and memory intact (see arm64_retention_wfi below), so the callee-saved
+ * registers go to the stack around it; the caller keeps the rest.
+ */
+	.text
+	.align 2
+	.globl EXT(arm64_park_wfi)
+LEXT(arm64_park_wfi)
+	ARM64_PROLOG
+	stp		x29, x30, [sp, #-96]!
+	stp		x19, x20, [sp, #16]
+	stp		x21, x22, [sp, #32]
+	stp		x23, x24, [sp, #48]
+	stp		x25, x26, [sp, #64]
+	stp		x27, x28, [sp, #80]
+	dsb		sy
+	isb		sy
+	wfi
+	isb		sy
+	ldp		x19, x20, [sp, #16]
+	ldp		x21, x22, [sp, #32]
+	ldp		x23, x24, [sp, #48]
+	ldp		x25, x26, [sp, #64]
+	ldp		x27, x28, [sp, #80]
+	ldp		x29, x30, [sp], #96
+	ret
+
+/*
+ * SiliconForest: restart a parked core. x0 = cpu data (KVA). Does what start_cpu and
+ * common_start (start.s) do for a core out of reset between loading its cpu data and
+ * entering arm_init_cpu(), less the translation and tunable set-up, which a parked core
+ * never lost: thread registers, exception stack on SP_EL1, interrupt stack on SP_EL0.
+ */
+	.text
+	.align 2
+	.globl EXT(arm64_park_restart)
+LEXT(arm64_park_restart)
+	ARM64_PROLOG
+	msr		DAIFSet, #(DAIFSC_ALL)
+	mov		x21, x0
+	ldr		x1, [x21, CPU_TPIDR_EL0]
+	msr		TPIDR_EL0, x1
+	msr		TPIDRRO_EL0, xzr
+	ldr		x1, [x21, CPU_EXCEPSTACK_TOP]
+	msr		SPSel, #1
+	mov		sp, x1
+	ldr		x1, [x21, CPU_INTSTACK_TOP]
+	msr		SPSel, #0
+	mov		sp, x1
+	msr		TPIDR_EL1, xzr
+	mov		x0, x21
+	mov		x1, #0
+	mov		fp, #0
+	mov		lr, #0
+	b		EXT(arm_init_cpu)
+
 #if HAS_RETENTION_STATE
 	.text
 	.align 2
