+ml_sf_park_quiet_timer(void)
+{
+	__builtin_arm_wsr64(KERNEL_CNTV_CTL_EL0, CNTV_CTL_EL0_IMASKED);
+	__builtin_arm_isb(ISB_SY);
+}
