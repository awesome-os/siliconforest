+ */
 #include "SFAppleBootCPUPMGR.h"
 #include <IOKit/IOLib.h>
 #include <IOKit/IOPMGR.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSData.h>
 #include <arm/cpu_topology.h>
 
 /*
  * Power manager for Apple SoCs running xnu's AppleARMSMP, where Apple's
- * ApplePMGR is not available. It manages the boot processor only and touches
- * no PMGR registers:
+ * ApplePMGR is not available.
  *
+ * - Secondary cores: enableCPUCore() releases a core from reset the way m1n1
+ *   does: the per-die CPU-start block in PMGR, after checking the core's reset
+ *   vector register. Only the SoCs in sf_apple_cpu_start_offsets are known;
+ *   on any other, or when the reset vector cannot be established, the request
+ *   panics with its reason instead of returning as if it had worked.
  * - Idle: the platform offers no idle states. xnu's cpu_idle() executes the
  *   WFI itself; each callback here disables xnu's idle timer (timeout 0).
- * - Secondary cores and cluster power are not implemented. Every such request
- *   panics with its reason instead of returning as if it had worked. Boot with
- *   a topology holding only the boot CPU (cpus=1, or a tree that lists only
- *   it) so that xnu never makes one.
+ * - Core and cluster power-down are not implemented and panic (xnu asks for
+ *   them on sleep and processor_exit).
+ */
+
+/* m1n1 src/smp.c: offset of the CPU-start block in the first PMGR register range */
+static const struct {
+	uint32_t chip_id;
+	uint32_t offset;
+} sf_apple_cpu_start_offsets[] = {
+	{ 0x8103, 0x54000 },    /* CPU_START_OFF_T8103; the only one that has been run */
+	{ 0x6000, 0x54000 },
+	{ 0x6001, 0x54000 },
+	{ 0x6002, 0x54000 },
+	{ 0x8112, 0x34000 },    /* CPU_START_OFF_T8112 */
+};
+#define SF_CPU_START_LEN        0x20
+
+/* m1n1 src/smp.c: the cpu node's "reg" */
+#define CPU_REG_CORE(reg)       ((reg) & 0xff)
+#define CPU_REG_CLUSTER(reg)    (((reg) >> 8) & 0x7)
+#define CPU_REG_DIE(reg)        (((reg) >> 11) & 0xf)
+
+/*
+ * m1n1 src/smp.c: the reset vector register, first in the core's "cpu-impl-reg".
+ * The address field is the one m1n1's hypervisor reads back (proxyclient/m1n1/hv,
+ * start_secondary: & 0xfffffffffff): on T8103 the register reads with further bits
+ * set from bit 44 up (0x0011100854946000 after 0x854946000 was written, boot sm02),
+ * which smp.c's GENMASK(47, 12) would take for address bits.
  */
+#define RVBAR_LOCK              (1ULL << 0)
+#define RVBAR_ADDR              0x00000ffffffff000ULL
+
+static volatile uint8_t *sCpuStart;     /* the mapped CPU-start block of die 0 */
+static uint64_t          sCpuStartPhys;
+static uint32_t          sChipID;
+
 class SFAppleBootCPUPMGR : public IOPMGR
 {
 	OSDeclareDefaultStructors(SFAppleBootCPUPMGR);
@@ -34,19 +78,109 @@
 #define super IOPMGR
 OSDefineMetaClassAndStructors(SFAppleBootCPUPMGR, IOPMGR);
 
+static const ml_topology_cpu_t *
+sf_apple_topology_cpu(unsigned int cpu_id)
+{
+	const ml_topology_info_t *topo = ml_get_topology_info();
+
+	for (unsigned int i = 0; topo != NULL && i < topo->num_cpus; i++) {
+		if (topo->cpus[i].cpu_id == cpu_id) {
+			return &topo->cpus[i];
+		}
+	}
+	return NULL;
+}
+
+/*
+ * m1n1 smp_prepare_rvbar() and the write in smp_start_cpu(): the core starts at the
+ * address in its RVBAR. Where the register is locked it must already name xnu's reset
+ * vector; where it is not, write it (which is also what m1n1's hypervisor reads when it
+ * starts the core for a guest). entry_pa is 0 on a kernel whose AppleARMSMP does not
+ * pass the reset vector: then the register can only be required to hold a vector.
+ */
+static void
+sf_apple_cpu_prepare_rvbar(const ml_topology_cpu_t *cpu, uint64_t entry_pa)
+{
+	volatile uint64_t *reg = (volatile uint64_t *)cpu->cpu_IMPL_regs;
+	uint64_t rvbar;
+
+	if (reg == NULL) {
+		panic("SFAppleBootCPUPMGR: cpu %u has no cpu-impl-reg; cannot check its reset vector",
+		    cpu->cpu_id);
+	}
+	rvbar = *reg;
+	if (entry_pa == 0) {
+		if ((rvbar & RVBAR_ADDR) == 0) {
+			panic("SFAppleBootCPUPMGR: cpu %u has no reset vector (RVBAR 0x%llx) "
+			    "and this kernel does not name one", cpu->cpu_id, rvbar);
+		}
+		return;
+	}
+	if ((entry_pa & ~RVBAR_ADDR) != 0) {
+		panic("SFAppleBootCPUPMGR: reset vector 0x%llx for cpu %u is not a page address",
+		    entry_pa, cpu->cpu_id);
+	}
+	if ((rvbar & RVBAR_ADDR) == entry_pa) {
+		return;
+	}
+	if (rvbar & RVBAR_LOCK) {
+		panic("SFAppleBootCPUPMGR: cpu %u reset vector is locked at 0x%llx, xnu's is 0x%llx",
+		    cpu->cpu_id, rvbar, entry_pa);
+	}
+	*reg = entry_pa;
+	__asm__ volatile ("dsb sy");
+	rvbar = *reg;
+	if ((rvbar & RVBAR_ADDR) != entry_pa) {
+		panic("SFAppleBootCPUPMGR: cpu %u reset vector reads 0x%llx after writing 0x%llx",
+		    cpu->cpu_id, rvbar, entry_pa);
+	}
+}
+
+/* m1n1 smp_start_cpu() */
+static void
+sf_apple_cpu_start(unsigned int cpu_id, uint64_t entry_pa)
+{
+	const ml_topology_cpu_t *cpu = sf_apple_topology_cpu(cpu_id);
+
+	if (cpu == NULL) {
+		panic("SFAppleBootCPUPMGR: start of cpu %u requested; not in the topology", cpu_id);
+	}
+
+	uint32_t core = CPU_REG_CORE(cpu->phys_id);
+	uint32_t cluster = CPU_REG_CLUSTER(cpu->phys_id);
+	uint32_t die = CPU_REG_DIE(cpu->phys_id);
+
+	if (sCpuStart == NULL) {
+		panic("SFAppleBootCPUPMGR: start of cpu %u requested; no known PMGR CPU-start "
+		    "block for chip 0x%x, boot with cpus=1", cpu_id, sChipID);
+	}
+	/* cpu_start_bit() is BIT(4 * cluster + core); the block has one word per cluster */
+	if (die != 0 || core >= 4 || 0x8 + 4 * cluster + 4 > SF_CPU_START_LEN) {
+		panic("SFAppleBootCPUPMGR: cpu %u is die %u cluster %u core %u; only die 0 with "
+		    "four-core clusters is implemented", cpu_id, die, cluster, core);
+	}
+
+	sf_apple_cpu_prepare_rvbar(cpu, entry_pa);
+
+	__asm__ volatile ("dsb sy");
+
+	/* Some kind of system level startup/status bit. Without this, IRQs don't work */
+	*(volatile uint32_t *)(sCpuStart + 0x4) = 1u << (4 * cluster + core);
+
+	/* Actually start the core */
+	*(volatile uint32_t *)(sCpuStart + 0x8 + 4 * cluster) = 1u << core;
+}
+
 void
 SFAppleBootCPUPMGR::enableCPUCore(unsigned int cpu_id, uint64_t entry_pa)
 {
-	panic("SFAppleBootCPUPMGR: start of cpu %u requested (entry 0x%llx); "
-	    "secondary CPU bring-up is not implemented, boot with cpus=1",
-	    cpu_id, (unsigned long long)entry_pa);
+	sf_apple_cpu_start(cpu_id, entry_pa);
 }
 
 void
 SFAppleBootCPUPMGR::enableCPUCore(unsigned int cpu_id)
 {
-	panic("SFAppleBootCPUPMGR: start of cpu %u requested; "
-	    "secondary CPU bring-up is not implemented, boot with cpus=1", cpu_id);
+	sf_apple_cpu_start(cpu_id, 0);
 }
 
