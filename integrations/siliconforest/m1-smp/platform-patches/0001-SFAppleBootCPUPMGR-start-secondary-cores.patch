+/*
+ * m1n1 smp_init(): the CPU-start block is at a per-SoC offset in the first register
+ * range of /arm-io/pmgr. Map it now; enableCPUCore() is not a place to map memory.
+ */
+static void
+sf_apple_cpu_start_map(void)
+{
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	IORegistryEntry *armio = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	IORegistryEntry *pmgr = IORegistryEntry::fromPath("/arm-io/pmgr", gIODTPlane);
+	OSData *chip = chosen ? OSDynamicCast(OSData, chosen->getProperty("chip-id")) : NULL;
+	OSData *ranges = armio ? OSDynamicCast(OSData, armio->getProperty("ranges")) : NULL;
+	OSData *reg = pmgr ? OSDynamicCast(OSData, pmgr->getProperty("reg")) : NULL;
+	uint64_t phys = 0;
+	uint32_t offset = 0;
+
+	if (chip != NULL && chip->getLength() >= sizeof(uint32_t)) {
+		sChipID = *(const uint32_t *)chip->getBytesNoCopy();
+	}
+	for (unsigned i = 0; i < sizeof(sf_apple_cpu_start_offsets) / sizeof(sf_apple_cpu_start_offsets[0]); i++) {
+		if (sf_apple_cpu_start_offsets[i].chip_id == sChipID) {
+			offset = sf_apple_cpu_start_offsets[i].offset;
+		}
+	}
+	if (offset != 0 && ranges != NULL && reg != NULL && reg->getLength() >= 2 * sizeof(uint64_t)) {
+		/* /arm-io ranges: child address, parent (physical) address, size */
+		const uint64_t *r = (const uint64_t *)ranges->getBytesNoCopy();
+		const uint64_t *pr = (const uint64_t *)reg->getBytesNoCopy();
+
+		for (unsigned i = 0; i + 3 <= ranges->getLength() / sizeof(uint64_t); i += 3) {
+			if (pr[0] >= r[i] && pr[0] - r[i] < r[i + 2] &&
+			    (uint64_t)offset + SF_CPU_START_LEN <= pr[1]) {
+				phys = r[i + 1] + (pr[0] - r[i]) + offset;
+				break;
+			}
+		}
+	}
+	if (phys != 0) {
+		IOMemoryDescriptor *desc = IOMemoryDescriptor::withPhysicalAddress(
+			(IOPhysicalAddress)phys, SF_CPU_START_LEN, kIODirectionOutIn);
+		IOMemoryMap *map = desc ? desc->map(kIOMapAnywhere | kIOMapInhibitCache) : NULL;
+
+		if (desc != NULL) {
+			desc->release();
+		}
+		if (map != NULL) {
+			/* never unmapped: the power manager lives as long as the system */
+			sCpuStart = (volatile uint8_t *)map->getVirtualAddress();
+			sCpuStartPhys = phys;
+		}
+	}
+	if (chosen != NULL) {
+		chosen->release();
+	}
+	if (armio != NULL) {
+		armio->release();
+	}
+	if (pmgr != NULL) {
+		pmgr->release();
+	}
+}
