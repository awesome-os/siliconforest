+def guest_cpus():
+    """Requested guest processor count: N from a `cpus=N` extra boot argument, else None."""
+    tokens = [t for t in extra_bootargs().split() if t.startswith('cpus=')]
+    image.require(len(tokens) <= 1 and all(re.fullmatch(r'cpus=[1-8]', t) for t in tokens),
+                  'Extra boot arguments may name cpus=1..8 once')
+    return int(tokens[0][5:]) if tokens else None
+
+
+def smp_enabled():
+    cpus = guest_cpus()
+    return SMP_DEFAULT if cpus is None else cpus > 1
+
+
+def base_bootargs():
+    # Never two cpus= arguments: an explicit one, or SMP by default, drops the built-in cpus=1.
+    image.require(BOOTARGS.count(' cpus=1 ') == 1, 'Built-in boot arguments lack cpus=1')
+    if guest_cpus() is None and not smp_enabled():
+        return BOOTARGS
+    return BOOTARGS.replace(' cpus=1 ', ' ')
+
+
+def enable_smp(hv):
+    # The frozen backend refuses secondary CPUs (hv.smp False, start_secondary raising).
+    # Restore the pinned hypervisor's own behaviour for both, before hv.init() reads the tree.
+    hv.smp = True
+    hv.start_secondary = type(hv).start_secondary.__get__(hv)
+
