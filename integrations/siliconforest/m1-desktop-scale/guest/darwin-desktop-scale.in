#!/bin/sh
# SPDX-License-Identifier: MIT
# The desktop with display scaling and the settings menu (issue #38), for
# tools/ds_desktop_boot.sh. One script for both uses:
#   unattended (@AUTOPILOT@ = 1): the compositor drives itself (its `scale` and `settings`
#     phases among the others), then a second, short session shows that the scale and theme
#     chosen from the menu are what the next session starts with;
#   by hand (@AUTOPILOT@ = 0): the same desktop for @SECONDS@ seconds, no synthetic input.
# Wi-Fi joins in the background and is kept joined: when the radio is on and no network is
# joined (the menu's "Turn Wi-Fi On" after an "Off"), the remembered network is joined again.
# coreaudiod runs, so the menu's Sound rows and the volume keys have a server to talk to.
# @SSID@/@PSK@ are filled from private/wifi.env at packet assembly; the filled script is
# never committed, and neither the network's name nor its key is printed here.
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
case "$nonce" in *[!0-9a-f]*|'') session=000000000000000000000000000000000000000000000001 ;; *) session=$nonce ;; esac
[ "${#session}" -eq 48 ] || session=000000000000000000000000000000000000000000000001
runtime=/private/var/run/desktop-scale
state=/private/var/db/desktop-state
mkdir -p "$runtime" "$state" && chmod 0700 "$runtime"
export XDG_RUNTIME_DIR="$runtime" XDG_STATE_HOME="$state" WAYLAND_DISPLAY=wayland-0
export XKB_CONFIG_ROOT=/usr/share/X11/xkb TMPDIR=/private/tmp
export CHONKSTEP_DARWIN_FRAME_STATS=@STATS@
[ -d /usr/share/backgrounds/siliconforest ] && export CHONKSTEP_BACKGROUND_DIR=/usr/share/backgrounds/siliconforest
get() { sysctl -n "$1" 2>/dev/null; }
# Free space of the RAM root, where session records (and file-backed buffers) live.
root_free() { df -k / 2>/dev/null | awk 'NR == 2 { printf "root_free_kib=%s root_used_kib=%s", $4, $3 }'; }
printf '\nDSDESK_BEGIN_%s seconds=@SECONDS@ autopilot=@AUTOPILOT@ scale=%s theme=%s only=%s\n' "$nonce" "@SCALE@" "@THEME@" "@ONLY@"
sysctl hw.ncpu hw.activecpu 2>&1
printf 'DSDESK_DISK start %s\n' "$(root_free)"
# What the radio says, without the network's name or the adapter's address.
wifi() {
    wifiutil info 2>/dev/null | awk '
        /^power:/ { power = $2 } /^state:/ { state = $2 } /^ssid:/ { joined = 1 } /^rssi:/ { rssi = $2 }
        END { printf "power=%s state=%s joined=%s rssi_dbm=%s", power ? power : "?", state ? state : "?", joined ? 1 : 0, rssi ? rssi : "none" }'
}
(
    if command -v wifiutil >/dev/null 2>&1 && [ -d /Library/Firmware/brcm ]; then
        sleep 4; sf-dhcp --up en0 >/dev/null 2>&1; sleep 2
        wifiutil on >/dev/null 2>&1; sleep 8
        wifiutil join '@SSID@' '@PSK@' >/dev/null 2>&1; printf 'DSDESK_WIFI_JOIN_RC=%s\n' "$?"
        sleep 4; sf-net-up en0 >/dev/null 2>&1; printf 'DSDESK_NET_UP_RC=%s\n' "$?"
        ping -c 2 1.1.1.1 >/dev/null 2>&1; printf 'DSDESK_PING_RC=%s %s\n' "$?" "$(wifi)"
        # Keep it joined: the radio on and nothing joined for four looks in a row (12 s)
        # means it did not come back by itself after the menu turned it on again (in the
        # boots so far the driver rejoined within a few seconds without help).
        idle=0; rejoins=0
        while [ -e "$runtime/keep-wifi" ]; do
            sleep 3
            case "$(wifi)" in
                *power=on*state=running*) idle=0 ;;
                *power=on*) idle=$((idle + 1)) ;;
                *) idle=0 ;;
            esac
            if [ "$idle" -ge 4 ]; then
                idle=0; rejoins=$((rejoins + 1))
                wifiutil autojoin >/dev/null 2>&1; rc=$?
                [ "$rc" -eq 0 ] && sf-net-up en0 >/dev/null 2>&1
                printf 'DSDESK_WIFI_REJOIN n=%s rc=%s %s\n' "$rejoins" "$rc" "$(wifi)"
            fi
        done
    else
        printf 'DSDESK_WIFI_SKIPPED\n'
    fi
) &
wifi_job=$!
: > "$runtime/keep-wifi"
# Sound: the audio server, as the desktop session starts it. hold_probe=1 keeps the
# speakers 20 dB under the protection model's limit.
if [ -x /usr/sbin/coreaudiod ]; then
    sysctl -w kern.sf_speaker.hold_probe=@HOLD@ kern.sf_sound.volume_db=@VOLUME@ > /dev/null 2>&1
    mkdir -p /var/log /var/run /Library/Preferences
    /usr/sbin/coreaudiod > /var/log/coreaudiod.log 2>&1 &
    printf 'DSDESK_COREAUDIOD pid=%s hold_probe=%s sound=%s\n' "$!" "$(get kern.sf_speaker.hold_probe)" "$(get kern.sf_sound.state)"
fi
n=0
while [ "$n" -lt 30 ]; do
    case "$(get kern.sf_touchbar.state)" in ready*|display-only*|display-failed*|off*|'') break;; esac
    sleep 1; n=$((n+1))
done
[ "@AUTOPILOT@" = 1 ] && sysctl -w kern.sf_touchbar.dim_ms=0 kern.sf_touchbar.off_ms=0 > /dev/null 2>&1
printf 'DSDESK_TOUCHBAR state=%s\n' "$(get kern.sf_touchbar.state)"
[ -x /usr/bin/darwin-trackpad-enum ] && { /usr/bin/darwin-trackpad-enum --nonce "$session"; printf 'DSDESK_ENUM rc=%s\n' "$?"; }
count=0
while [ ! -c /dev/usb_hid_kbd ] || [ ! -c /dev/usb_hid_mouse ]; do
    count=$((count + 1)); [ "$count" -le 100 ] || break; sleep 0.1
done
printf 'DSDESK_INPUT kbd=%s mouse=%s\n' "$([ -c /dev/usb_hid_kbd ] && echo yes || echo no)" "$([ -c /dev/usb_hid_mouse ] && echo yes || echo no)"
# One desktop session: name of the socket, seconds, records directory suffix.
desk() {
    records=$runtime/session-$3
    mkdir -m 0700 "$records"
    rm -f "$runtime/desktop.rc"
    printf 'DSDESK_DESKTOP_START n=%s seconds=%s start=%s\n' "$3" "$2" "$(date +%s)"
    {
        /usr/bin/chonkstep-darwin-desktop --run --socket "$runtime/$1" --records "$records" --session "$3" --terminal /usr/bin/chonk-terminal-darwin --seconds "$2" --font-regular /usr/share/darwin-desktop/DejaVuSans.ttf --font-bold /usr/share/darwin-desktop/DejaVuSans-Bold.ttf --input sfhid --startup-terminals 2 --renderer @RENDERER@ 2>&1
        echo "$?" > "$runtime/desktop.rc"
    } | grep -v 'chonkstep-gl: step:'
    printf 'DSDESK_DESKTOP_RC n=%s rc=%s end=%s\n' "$3" "$(cat "$runtime/desktop.rc" 2>/dev/null || echo unknown)" "$(date +%s)"
    [ -r "$records/session-result.txt" ] && grep -v ' gate=\| kernel_messages=\| cs_at_spawn=\| exit_reason=' "$records/session-result.txt" | cut -c1-260 | sed 's/^/DSDESK_RESULT /' | head -40
    for live in "$records"/*/term-live.txt; do
        [ -r "$live" ] || continue
        printf 'DSDESK_TERMINAL %s\n' "$(head -1 "$live" | cut -c1-400)"
        # How it ended, in its own words (no terminal content: errors and the stop cause only).
        end=$(dirname "$live")/result.json
        flat=$(tr -d '\n' < "$end" 2>/dev/null | tr -s ' ')
        printf 'DSDESK_TERMINAL_END %s %s\n' "$(printf '%s' "$flat" | grep -o '"stop_cause": *"[^"]*"' | head -1)" "$(printf '%s' "$flat" | grep -o '"errors": *\[[^]]*\]' | head -1 | cut -c1-400)"
    done
    printf 'DSDESK_DISK after n=%s %s\n' "$3" "$(root_free)"
}
[ -n "@SCALE@" ] && export CHONKSTEP_SCALE="@SCALE@"
[ -n "@THEME@" ] && export CHONKSTEP_THEME="@THEME@"
if [ "@AUTOPILOT@" = 1 ]; then
    export CHONKSTEP_DARWIN_AUTOPILOT=1 CHONKSTEP_DARWIN_MAX_TERMINALS=3 CHONKSTEP_DARWIN_AUTOPILOT_WIFI_TOGGLE=@WIFI_TOGGLE@
    [ -n "@ONLY@" ] && export CHONKSTEP_DARWIN_AUTOPILOT_ONLY="@ONLY@"
fi
desk wayland-0 @SECONDS@ "$session"
printf 'DSDESK_STATE after_first_session scale=%s theme=%s\n' "$(cat "$state/chonkstep/scale" 2>/dev/null || echo none)" "$(cat "$state/chonkstep/theme" 2>/dev/null || echo none)"
printf 'DSDESK_WIFI_AFTER %s\n' "$(wifi)"
if [ "@SECOND@" = 1 ]; then
    # The next session starts with what the menu last chose. Here that choice is put in the
    # state file by hand (150%, Graphite: neither is the default) and nothing is in the
    # environment; the first session's own writes are the DSDESK_STATE line above.
    unset CHONKSTEP_SCALE CHONKSTEP_THEME
    mkdir -p "$state/chonkstep"; printf 180 > "$state/chonkstep/scale"; printf graphite > "$state/chonkstep/theme"
    [ "@AUTOPILOT@" = 1 ] && export CHONKSTEP_DARWIN_AUTOPILOT_ONLY=settle,type
    second=$(printf '%s' "$session" | sed 's/.$/f/'); [ "$second" = "$session" ] && second=$(printf '%s' "$session" | sed 's/.$/e/')
    desk wayland-1 30 "$second"
    printf 'DSDESK_STATE after_second_session scale=%s theme=%s\n' "$(cat "$state/chonkstep/scale" 2>/dev/null || echo none)" "$(cat "$state/chonkstep/theme" 2>/dev/null || echo none)"
fi
rm -f "$runtime/keep-wifi"
wait "$wifi_job"
[ "@AUTOPILOT@" = 1 ] && sysctl -w kern.sf_touchbar.dim_ms=30000 kern.sf_touchbar.off_ms=60000 > /dev/null 2>&1
printf 'DSDESK_SOUND_END speakers=%s trips=%s sessions=%s | touchbar=%s\n' "$(get kern.sf_speaker.state | cut -c1-40)" "$(get kern.sf_speaker.trips)" "$(get kern.sf_speaker.sessions)" "$(get kern.sf_touchbar.state)"
printf 'DSDESK_END_%s\n' "$nonce"
printf '\nPD_BENCH_DONE\n'
