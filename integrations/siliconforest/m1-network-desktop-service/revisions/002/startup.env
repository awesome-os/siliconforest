# Fixed source-bound interactive SH startup. No eval, exec, command text,
# pipelines, substitutions, background jobs or synthetic PTY input.
case "$DNDS_SESSION$DNDS_INSTANCE" in ''|*[!0-9a-f]*) return 2 ;; esac
[ "${#DNDS_SESSION}" -eq 48 ] && [ "${#DNDS_INSTANCE}" -eq 48 ] || return 2
case "$DNDS_INSTANCE" in
    "0001${DNDS_SESSION%????}"|"0002${DNDS_SESSION%????}") ;;
    *) return 2 ;;
esac
[ "$DNDS_RECORDS" = "/private/var/run/darwin-desktop-network/session-$DNDS_SESSION/$DNDS_INSTANCE" ] || return 2
case "$DNDS_SECONDS" in 1[0-9]|2[0-9]|3[0-9]|4[0-9]|5[0-9]|60) ;; *) return 2 ;; esac
/usr/bin/darwin-desktop-net-client --instance "$DNDS_INSTANCE" --records "$DNDS_RECORDS" --seconds "$DNDS_SECONDS"
dnds_client_status=$?
dnds_client_pid=0
if IFS= read -r dnds_client_pid < "$DNDS_RECORDS/network-client.pid"; then
    case "$dnds_client_pid" in ''|*[!0-9]*|0*) dnds_client_pid=0 ;; esac
    if [ "${#dnds_client_pid}" -gt 10 ]; then dnds_client_pid=0; fi
    if [ "$dnds_client_pid" -le 1 ] || [ "$dnds_client_pid" -gt 2147483647 ]; then dnds_client_pid=0; fi
else
    dnds_client_pid=0
fi
printf 'DL30_SHELL_RETURN session=%s instance=%s shell_pid=%s client_pid=%s status=%s\n' "$DNDS_SESSION" "$DNDS_INSTANCE" "$$" "$dnds_client_pid" "$dnds_client_status" > "$DNDS_RECORDS/network-shell-return.txt"
printf 'DL30_SHELL_RETURN session=%s instance=%s shell_pid=%s client_pid=%s status=%s\n' "$DNDS_SESSION" "$DNDS_INSTANCE" "$$" "$dnds_client_pid" "$dnds_client_status"
unset dnds_client_pid dnds_client_status
