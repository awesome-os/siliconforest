#!/bin/sh
# Fixed RAM-only collector launcher. It performs no kernel or device operation.
set -u
[ "$#" -eq 1 ] || exit 2
nonce=$1
case "$nonce" in ''|*[!0-9a-f]*) exit 2 ;; esac
[ "${#nonce}" -eq 48 ] || exit 2
printf 'DL32_PRIVATE_PROCESS_BEGIN %s\n' "$nonce" || exit 1
rc=0
/usr/libexec/darwin-native-private-collector "$nonce" || rc=$?
printf 'DL32_PRIVATE_PROCESS_END %s collector_exit=%s self_report_only=true\n' "$nonce" "$rc" || exit 1
exit "$rc"
