#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Output { uint words[]; } output_data;
layout(push_constant) uniform Params { uint iterations; uint seed; } params;
void main() {
    uint v=params.seed;
    for(uint i=0u;i<params.iterations;i++) {
        v^=v<<13;v^=v>>17;v^=v<<5;
    }
    output_data.words[gl_GlobalInvocationID.x]=v;
}
