{
 "apps": [
  "mkdir -p /private/tmp/ffprofile; cp /usr/local/share/firefox-profile/user.js /private/tmp/ffprofile/user.js; MOZ_CRASHREPORTER_DISABLE=1 DYLD_INSERT_LIBRARIES=/usr/lib/libhbcrash.dylib SF_WS_TRACE=1 SF_SANDBOX_TRACE=1 /Applications/Firefox.app/Contents/MacOS/firefox --no-remote --profile /private/tmp/ffprofile file:///usr/local/share/firefox-page/index.html"
 ],
 "env": "SF_WS_TRACE=1",
 "seconds": 2400,
 "memory": 3072,
 "steps": [
  {
   "wait": "COCOA_APP_START 1",
   "timeout": 400
  },
  {
   "expect": "WindowServer: window \\d+ level 0",
   "timeout": 900,
   "name": "Firefox made its browser window"
  },
  {
   "expect": "is titled \"SF page: loaded image=160x100 typed= clicks=0",
   "timeout": 900,
   "name": "local page loaded, script ran, image decoded"
  },
  {
   "sleep": 30
  },
  {
   "shot": "01-page"
  },
  {
   "locate": "swatch",
   "rgb": [
    51,
    115,
    204
   ],
   "tolerance": 10,
   "tries": 300,
   "points_wide": 160,
   "scale": 1,
   "name": "page drawn at the scale"
  },
  {
   "click_in": "swatch",
   "points": [
    80,
    50
   ],
   "button": "right"
  },
  {
   "expect": "WindowServer: popup \\d+ at -?\\d+,-?\\d+ of window \\d+",
   "timeout": 240,
   "name": "the page's context menu is an xdg_popup"
  },
  {
   "expect": "WMPOPUP mapped at=(\\d+),(\\d+) size=(\\d+)x(\\d+)",
   "timeout": 240,
   "name": "the compositor shows the context menu",
   "save": "m"
  },
  {
   "sleep": 20
  },
  {
   "shot": "03-context-menu"
  },
  {
   "key": [
    "esc"
   ]
  },
  {
   "expect": "WMPOPUP gone remaining=0",
   "timeout": 240,
   "name": "Escape closes the context menu"
  },
  {
   "sleep": 10
  },
  {
   "absent": "COCOA_APP_EXIT 1|wrong configure serial|protocol error",
   "name": "Firefox still running, no protocol error"
  }
 ]
}
