{
 "apps": ["/Applications/CocoaHello.app/Contents/MacOS/CocoaHello"],
 "env": "SF_WS_TRACE=1 CHONKSTEP_DARWIN_AUTOPILOT=1 CHONKSTEP_DARWIN_AUTOPILOT_ONLY=settle,scale CHONKSTEP_DARWIN_MAX_TERMINALS=3 CHONKSTEP_DARWIN_AUTOPILOT_WIFI_TOGGLE=0 CHONKSTEP_DARWIN_AUTOPILOT_SCALE_STEP_MS=25000",
 "seconds": 800,
 "steps": [
  {"wait": "COCOA_APP_START 1", "timeout": 400},
  {"expect": "COCOAHELLO window-shown", "timeout": 600, "name": "window shown"},
  {"expect": "COCOAHELLO backing-scale 1.250", "timeout": 300, "name": "follows 100% -> 125%"},
  {"sleep": 8}, {"shot": "scale-125"},
  {"expect": "COCOAHELLO backing-scale 1.500", "timeout": 120, "name": "follows 125% -> 150%"},
  {"sleep": 8}, {"shot": "scale-150"},
  {"expect": "COCOAHELLO backing-scale 1.750", "timeout": 120, "name": "follows 150% -> 175%"},
  {"sleep": 8}, {"shot": "scale-175"},
  {"expect": "COCOAHELLO backing-scale 2.000", "timeout": 120, "name": "follows 175% -> 200%"},
  {"sleep": 8}, {"shot": "scale-200"},
  {"expect": "COCOAHELLO backing-scale 2.500", "timeout": 120, "name": "follows 200% -> 250%"},
  {"sleep": 8}, {"shot": "scale-250"},
  {"expect": "COCOAHELLO backing-scale 3.000", "timeout": 120, "name": "follows 250% -> 300%"},
  {"sleep": 8}, {"shot": "scale-300"},
  {"expect": "COCOAHELLO backing-scale 1.000", "timeout": 120, "name": "follows 300% -> 100%"},
  {"expect": "WMAUTO scale steps=", "timeout": 200, "name": "the desktop finished stepping"},
  {"sleep": 10},
  {"shot": "scale-100-after"},
  {"expect": "commits_resampled_during_phase=0 ", "timeout": 5, "name": "no commit at a stale scale during the changes", "optional": true},
  {"absent": "Segmentation|Bus error|Abort trap", "name": "no crash"}
 ]
}
