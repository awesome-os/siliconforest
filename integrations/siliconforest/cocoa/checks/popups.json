{
 "apps": [
  "/Applications/CocoaPopups.app/Contents/MacOS/CocoaPopups"
 ],
 "env": "SF_WS_TRACE=1 SF_POPUP_TRACE=1",
 "seconds": 560,
 "steps": [
  {
   "wait": "COCOA_APP_START 1",
   "timeout": 400
  },
  {
   "expect": "POPT window-shown",
   "timeout": 600,
   "name": "window shown"
  },
  {
   "sleep": 6
  },
  {
   "locate": "view",
   "rgb": [
    51,
    115,
    204
   ],
   "tolerance": 14,
   "points_wide": 280,
   "scale": @SCALE@,
   "name": "backing scale on screen"
  },
  {
   "drag_in": "view",
   "from": [
    55,
    -58
   ],
   "to": [
    55,
    -14
   ],
   "hold": 1.2,
   "settle": 1.5
  },
  {
   "expect": "WindowServer: popup \\d+ at -?\\d+,-?\\d+ of window \\d+, \\d+x\\d+ \\(grab\\)",
   "timeout": 60,
   "name": "the list is an xdg_popup with a grab"
  },
  {
   "expect": "POPT popup action=1 selected=Gamma index=2",
   "timeout": 60,
   "name": "press, drag, release: Gamma chosen"
  },
  {
   "sleep": 2.5
  },
  {
   "click_in": "view",
   "points": [
    55,
    -58
   ]
  },
  {
   "expect": "WMPOPUP mapped at=(\\d+),(\\d+) size=(\\d+)x(\\d+)",
   "timeout": 60,
   "name": "the compositor shows the list",
   "save": "p"
  },
  {
   "sleep": 1.5
  },
  {
   "shot": "01-popup"
  },
  {
   "click_px": [
    "p[0] + (16 + 40) * S",
    "p[1] + (16 + 5 + 33) * S"
   ]
  },
  {
   "expect": "POPT popup action=2 selected=Beta index=1",
   "timeout": 60,
   "name": "click, click: Beta chosen"
  },
  {
   "sleep": 2.5
  },
  {
   "click_in": "view",
   "points": [
    55,
    -58
   ]
  },
  {
   "expect": "WMPOPUP mapped at=(\\d+),(\\d+) size=(\\d+)x(\\d+)",
   "timeout": 60,
   "name": "the list opens again",
   "save": "p"
  },
  {
   "sleep": 1.5
  },
  {
   "click_px": [
    "p[0] + (16 + 40) * S",
    "p[1] + (16 + 5 + 11) * S"
   ]
  },
  {
   "expect": "POPT popup action=3 selected=Alpha index=0",
   "timeout": 60,
   "name": "second opening: Alpha chosen"
  },
  {
   "sleep": 2.5
  },
  {
   "click_in": "view",
   "points": [
    55,
    -58
   ]
  },
  {
   "expect": "WMPOPUP mapped at=(\\d+),(\\d+) size=(\\d+)x(\\d+)",
   "timeout": 60,
   "name": "the list opens (disabled item)",
   "save": "p"
  },
  {
   "sleep": 1.5
  },
  {
   "click_px": [
    "p[0] + (16 + 40) * S",
    "p[1] + (16 + 5 + 77) * S"
   ]
  },
  {
   "sleep": 2
  },
  {
   "count": "POPT \\w+ action=",
   "equals": 3,
   "name": "a click on a disabled item chooses nothing"
  },
  {
   "key": [
    "esc"
   ]
  },
  {
   "sleep": 0.4
  },
  {
   "expect": "POPT menu end",
   "timeout": 60,
   "name": "Escape dismisses"
  },
  {
   "sleep": 1.5
  },
  {
   "count": "POPT \\w+ action=",
   "equals": 3,
   "name": "Escape sends no action"
  },
  {
   "click_in": "view",
   "points": [
    55,
    -58
   ]
  },
  {
   "expect": "WMPOPUP mapped at=(\\d+),(\\d+) size=(\\d+)x(\\d+)",
   "timeout": 60,
   "name": "the list opens (press on own window)",
   "save": "p"
