{
 "apps": [
  "COCOAHELLO_REFUSE_CLOSE=1 /Applications/CocoaHello.app/Contents/MacOS/CocoaHello"
 ],
 "env": "SF_WS_TRACE=1",
 "seconds": 700,
 "steps": [
  {
   "wait": "COCOA_APP_START 1",
   "timeout": 400
  },
  {
   "expect": "COCOAHELLO window-shown",
   "timeout": 600,
   "name": "window shown"
  },
  {
   "sleep": 6
  },
  {
   "locate": "view",
   "rgb": [
    51,
    115,
    204
   ],
   "tolerance": 14,
   "points_wide": 380,
   "scale": @SCALE@,
   "name": "backing scale on screen"
  },
  {
   "shot": "01-window"
  },
  {
   "click_in": "view",
   "points": [
    389,
    -143
   ]
  },
  {
   "expect": "COCOAHELLO close-refused",
   "timeout": 90,
   "name": "our close button asks the application (refused)"
  },
  {
   "sleep": 4
  },
  {
   "shot": "02-close-refused"
  },
  {
   "locate": "view",
   "rgb": [
    51,
    115,
    204
   ],
   "tolerance": 14,
   "points_wide": 380,
   "name": "window still there after the refusal",
   "scale": @SCALE@
  },
  {
   "sleep": 6
  },
  {
   "sleep": 6
  },
  {
   "locate": "view",
   "rgb": [
    51,
    115,
    204
   ],
   "tolerance": 14,
   "points_wide": 380
  },
  {
   "shot": "04-before-close"
  },
  {
   "click_in": "view",
   "points": [
    389,
    -143
   ]
  },
  {
   "expect": "COCOAHELLO close-allowed",
   "timeout": 90,
   "name": "our close button asks again (allowed)"
  },
  {
   "expect": "COCOAHELLO window-closed",
   "timeout": 60,
   "name": "window closes"
  },
  {
   "expect": "COCOA_APP_EXIT 1 rc=0",
   "timeout": 60,
   "name": "application ends"
  },
  {
   "sleep": 3
  },
  {
   "shot": "05-closed"
  },
  {
   "absent": "Segmentation|Bus error|Abort trap",
   "name": "no crash"
  }
 ]
}
