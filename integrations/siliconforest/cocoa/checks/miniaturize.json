{
 "apps": ["/Applications/CocoaHello.app/Contents/MacOS/CocoaHello"],
 "env": "SF_WS_TRACE=1",
 "seconds": 500,
 "steps": [
  {"wait": "COCOA_APP_START 1", "timeout": 400},
  {"expect": "COCOAHELLO window-shown", "timeout": 600, "name": "window shown"},
  {"sleep": 6},
  {"locate": "view", "rgb": [51, 115, 204], "tolerance": 14, "points_wide": 380},
  {"click_in": "view", "points": [-9, -143]},
  {"expect": "COCOAHELLO window-miniaturized is=1", "timeout": 90, "name": "our miniaturize button: windowDidMiniaturize, isMiniaturized"},
  {"sleep": 5},
  {"shot": "01-miniaturized"}
 ]
}
