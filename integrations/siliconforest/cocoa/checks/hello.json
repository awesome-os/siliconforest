{
 "apps": ["/Applications/CocoaHello.app/Contents/MacOS/CocoaHello"],
 "env": "SF_WS_TRACE=1",
 "seconds": 500,
 "steps": [
  {"wait": "COCOA_APP_START 1", "timeout": 400},
  {"expect": "frame by the compositor \\(asked for the compositor\\)", "timeout": 600, "name": "compositor draws the frame"},
  {"expect": "COCOAHELLO window-shown", "timeout": 600, "name": "window shown"},
  {"sleep": 6},
  {"shot": "01-window"},
  {"locate": "view", "rgb": [51, 115, 204], "tolerance": 14, "points_wide": 380, "scale": @SCALE@, "name": "backing scale on screen"},
  {"click_in": "view", "points": [70, -31]},
  {"expect": "COCOAHELLO button presses=1", "timeout": 90, "name": "button hit at this scale"},
  {"click_in": "view", "points": [190, 85]},
  {"expect": "COCOAHELLO mouse view=1[89][0-9],8[0-9]", "timeout": 90, "name": "pointer location in points"},
  {"type": "hi"},
  {"expect": "COCOAHELLO key code=\\d+ chars=i", "timeout": 90, "name": "keyboard"},
  {"key": ["meta_l", "g"]},
  {"expect": "COCOAHELLO menu item=Greet", "timeout": 60, "name": "menu key equivalent"},
  {"sleep": 4},
  {"shot": "02-after-input"},
  {"absent": "WMSCALE resampled", "name": "no resampled commit"},
  {"absent": "Segmentation|Bus error|Abort trap", "name": "no crash"}
 ]
}
