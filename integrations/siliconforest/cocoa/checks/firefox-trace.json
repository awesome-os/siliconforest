{
 "apps": [
  "mkdir -p /private/tmp/ffprofile; MOZ_CRASHREPORTER_DISABLE=1 DYLD_INSERT_LIBRARIES=/usr/lib/libhbcrash.dylib /Applications/Firefox.app/Contents/MacOS/firefox --no-remote --profile /private/tmp/ffprofile about:blank"
 ],
 "env": "SF_WS_TRACE=1",
 "seconds": 2400,
 "memory": 3072,
 "steps": [
  {
   "wait": "COCOA_APP_START 1",
   "timeout": 400
  },
  {
   "expect": "WindowServer: window \\d+ level 0",
   "timeout": 900,
   "name": "Firefox creates a normal window",
   "optional": true
  },
  {
   "shot": "01"
  },
  {
   "sleep": 60
  },
  {
   "shot": "02"
  },
  {
   "expect": "hbcrash: |COCOA_APP_EXIT 1",
   "timeout": 240,
   "name": "(Firefox ended within four minutes of its window)",
   "optional": true
  },
  {
   "shot": "03"
  },
  {
   "sleep": 240
  },
  {
   "shot": "04"
  },
  {
   "sleep": 300
  },
  {
   "shot": "05"
  },
  {
   "absent": "COCOA_APP_EXIT 1",
   "name": "Firefox still running at the end"
  }
 ]
}