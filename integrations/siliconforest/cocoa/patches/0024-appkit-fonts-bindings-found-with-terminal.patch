 -(NSArray *)selectedObjects
 {
-	id idxs=[self selectionIndexes];
+	NSIndexSet *idxs=[self selectionIndexes];
 	if(idxs) {
-		return [[self arrangedObjects] objectsAtIndexes:idxs];
+		NSArray *arranged=[self arrangedObjects];
+		NSUInteger count=[arranged count];
+
+		// the selection may name rows the content does not have yet (a selection bound to a model
+		// arrives before the content does): those select nothing, they are not an error
+		if([idxs count]>0 && [idxs lastIndex]>=count){
+			NSMutableIndexSet *inside=[[idxs mutableCopy] autorelease];
+
+			[inside removeIndexesInRange:NSMakeRange(count,NSNotFound-count)];
+			idxs=inside;
+		}
+		return [arranged objectsAtIndexes:idxs];
 	}
 	return [NSArray array];
 }
