+/* SPDX-License-Identifier: MIT */
+#import <QuartzCore/CALayer.h>
+#import <QuartzCore/CoreVideo.h>
+#import <OpenGL/OpenGL.h>
+
+/* A layer an application draws with OpenGL (CGL). The layer's -display makes (once) a CGL context of the
+   layer's pixel format through the overridable methods below, renders into that context's offscreen surface at
+   the layer's pixel size, and reads the pixels back as the layer's contents: what draws the layer tree (AppKit
+   on the CPU, CALayerContext with OpenGL) shows them like any other contents. */
+@interface CAOpenGLLayer : CALayer {
+    BOOL _asynchronous;
+    CGLPixelFormatObj _sfPixelFormat;
+    CGLContextObj _sfContext;
+    GLint _sfSurfaceSize[2];
+    id _sfTimer;
+    BOOL _sfFailed;
+}
+
+@property(getter=isAsynchronous) BOOL asynchronous;
+
+- (BOOL)canDrawInCGLContext:(CGLContextObj)ctx pixelFormat:(CGLPixelFormatObj)pf forLayerTime:(CFTimeInterval)t displayTime:(const CVTimeStamp *)ts;
+- (void)drawInCGLContext:(CGLContextObj)ctx pixelFormat:(CGLPixelFormatObj)pf forLayerTime:(CFTimeInterval)t displayTime:(const CVTimeStamp *)ts;
+- (CGLPixelFormatObj)copyCGLPixelFormatForDisplayMask:(uint32_t)mask;
+- (void)releaseCGLPixelFormat:(CGLPixelFormatObj)pf;
+- (CGLContextObj)copyCGLContextForPixelFormat:(CGLPixelFormatObj)pf;
+- (void)releaseCGLContext:(CGLContextObj)ctx;
+
+@end
