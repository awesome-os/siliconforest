+// (TERM7) what CoreAnimation does before it draws a tree: each layer marked with -setNeedsDisplay fills its contents
+static void displayLayersIfNeeded(CALayer *layer,int depth) {
+   [layer displayIfNeeded];
+   if(depth<32)
+    for(CALayer *sub in [layer sublayers])
+     displayLayersIfNeeded(sub,depth+1);
+}
+
 -(void)render {
+   displayLayersIfNeeded(_layer,0);
