--- a/src/Frameworks/CoreGraphics/CGActivityMonitorAdditions.m
+++ b/src/Frameworks/CoreGraphics/CGActivityMonitorAdditions.m
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: MIT
+// Private CGS calls Apple's Activity Monitor imports (docs/roadmap/issues/SF-AA-activity-monitor.md
+// in the SiliconForest lab). The window server here is a Wayland compositor: it keeps no record of
+// which application stopped answering events (Activity Monitor's "Not Responding"), and it sends
+// no CGS notifications, so a registered procedure is never called.
+#include <stdbool.h>
+#include <stdint.h>
+typedef int32_t CGSError;
+struct CPSProcessSerialNumber { uint32_t high, low; };
+bool CGSEventIsAppUnresponsive(int connection, const struct CPSProcessSerialNumber *psn) { return false; }
+CGSError CGSRegisterNotifyProc(void *proc, uint32_t type, void *arg) { return 0; }
+CGSError CGSRemoveNotifyProc(void *proc, uint32_t type, void *arg) { return 0; }
