+// NSSymbolImages.m - stand-ins for the few system symbol images applications here ask for
+// Copyright (c) 2026 The SiliconForest contributors, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+//
+// macOS draws a symbol image (+imageWithSystemSymbolName:..., or a nib's image resource named
+// "info.circle") from its SF Symbols font. That font is Apple's and is not copied here; the few
+// names below are our own drawings with NSBezierPath, in the symbols' usual shapes, so that a
+// toolbar is not a row of empty buttons. Any other name still gives nil, as an unknown name does
+// on macOS. They are template images (the shape is what counts, the colour is the control's).
+// First users: Apple's Activity Monitor (its toolbar's Stop, Info and action buttons, the inspector's
+// link to a parent process).
+#import <AppKit/NSImage.h>
+#import <AppKit/NSBitmapImageRep.h>
+#import <AppKit/NSGraphicsContext.h>
+#import <AppKit/NSBezierPath.h>
+#import <AppKit/NSColor.h>
+#import <Foundation/NSAffineTransform.h>
+#import <Foundation/NSDictionary.h>
+#import <Foundation/NSString.h>
+#include <math.h>
+
+typedef void (*SFSymbolDrawer)(NSRect box, CGFloat line);
+
+static NSBezierPath *sfStroke(CGFloat line) {
+    NSBezierPath *path = [NSBezierPath bezierPath];
+
+    [path setLineWidth:line];
+    [path setLineCapStyle:NSRoundLineCapStyle];
+    [path setLineJoinStyle:NSRoundLineJoinStyle];
+    return path;
+}
+
+static void sfCircle(NSRect box, CGFloat line) {
+    NSBezierPath *path = sfStroke(line);
+
+    [path appendBezierPathWithOvalInRect:NSInsetRect(box, line / 2, line / 2)];
+    [path stroke];
+}
+
+static void sfDot(NSPoint centre, CGFloat radius) {
+    [[NSBezierPath bezierPathWithOvalInRect:NSMakeRect(centre.x - radius, centre.y - radius, 2 * radius, 2 * radius)] fill];
+}
+
+// a circle with a lower-case i: a dot over a stroke with a foot
+static void sfInfoCircle(NSRect box, CGFloat line) {
+    CGFloat cx = NSMidX(box), unit = NSWidth(box) / 16;
+    NSBezierPath *path = sfStroke(line);
+
+    sfCircle(box, line);
+    sfDot(NSMakePoint(cx, NSMinY(box) + 11.3 * unit), 1.15 * unit);
+    [path moveToPoint:NSMakePoint(cx - 1.4 * unit, NSMinY(box) + 8.6 * unit)];
+    [path lineToPoint:NSMakePoint(cx, NSMinY(box) + 8.6 * unit)];
+    [path lineToPoint:NSMakePoint(cx, NSMinY(box) + 4.2 * unit)];
+    [path moveToPoint:NSMakePoint(cx - 1.8 * unit, NSMinY(box) + 4.2 * unit)];
+    [path lineToPoint:NSMakePoint(cx + 1.8 * unit, NSMinY(box) + 4.2 * unit)];
+    [path stroke];
+}
+
+// a circle with three dots across its middle
+static void sfEllipsisCircle(NSRect box, CGFloat line) {
+    CGFloat cx = NSMidX(box), cy = NSMidY(box), unit = NSWidth(box) / 16;
+
+    sfCircle(box, line);
+    sfDot(NSMakePoint(cx - 4 * unit, cy), 1.1 * unit);
+    sfDot(NSMakePoint(cx, cy), 1.1 * unit);
+    sfDot(NSMakePoint(cx + 4 * unit, cy), 1.1 * unit);
+}
+
+// a regular octagon, flat at top and bottom, with a cross in it
+static void sfXmarkOctagon(NSRect box, CGFloat line) {
+    NSBezierPath *path = sfStroke(line);
+    CGFloat cx = NSMidX(box), cy = NSMidY(box), r = (NSWidth(box) - line) / 2 / cos(M_PI / 8), unit = NSWidth(box) / 16;
+
+    for (int i = 0; i < 8; i++) {
+        CGFloat a = M_PI / 8 + i * M_PI / 4;
+        NSPoint p = NSMakePoint(cx + r * cos(a), cy + r * sin(a));
+
+        if (i == 0)
+            [path moveToPoint:p];
+        else
+            [path lineToPoint:p];
+    }
+    [path closePath];
+    [path moveToPoint:NSMakePoint(cx - 3.2 * unit, cy - 3.2 * unit)];
+    [path lineToPoint:NSMakePoint(cx + 3.2 * unit, cy + 3.2 * unit)];
+    [path moveToPoint:NSMakePoint(cx - 3.2 * unit, cy + 3.2 * unit)];
+    [path lineToPoint:NSMakePoint(cx + 3.2 * unit, cy - 3.2 * unit)];
+    [path stroke];
+}
+
+// a magnifying glass: a ring and a handle to the lower right
+static void sfMagnifyingGlass(NSRect box, CGFloat line) {
+    NSBezierPath *path = sfStroke(line);
+    CGFloat unit = NSWidth(box) / 16, d = 10 * unit;
+    NSRect ring = NSMakeRect(NSMinX(box) + 1.2 * unit, NSMaxY(box) - 1.2 * unit - d, d, d);
+    CGFloat c = M_SQRT1_2 * d / 2;
+
+    [path appendBezierPathWithOvalInRect:ring];
+    [path moveToPoint:NSMakePoint(NSMidX(ring) + c, NSMidY(ring) - c)];
+    [path lineToPoint:NSMakePoint(NSMaxX(box) - 1.5 * unit, NSMinY(box) + 1.5 * unit)];
+    [path stroke];
+}
+
+// a filled circle with an arrow to the right cut out of it (the inspector's link to a parent process)
+static void sfArrowForwardCircleFill(NSRect box, CGFloat line) {
+    NSBezierPath *path = sfStroke(line * 1.2);
+    CGFloat cx = NSMidX(box), cy = NSMidY(box), unit = NSWidth(box) / 16;
+
+    [[NSBezierPath bezierPathWithOvalInRect:NSInsetRect(box, 0.5, 0.5)] fill];
+    [NSGraphicsContext saveGraphicsState];
+    [[NSGraphicsContext currentContext] setCompositingOperation:NSCompositeClear];
+    [path moveToPoint:NSMakePoint(cx - 4 * unit, cy)];
+    [path lineToPoint:NSMakePoint(cx + 4 * unit, cy)];
+    [path moveToPoint:NSMakePoint(cx + 0.8 * unit, cy + 3.2 * unit)];
+    [path lineToPoint:NSMakePoint(cx + 4 * unit, cy)];
+    [path lineToPoint:NSMakePoint(cx + 0.8 * unit, cy - 3.2 * unit)];
+    [path stroke];
+    [NSGraphicsContext restoreGraphicsState];
+}
+
+@implementation NSImage (SFSymbolImages)
+
++ (NSImage *)_sfSymbolImageNamed:(NSString *)name {
+    static NSMutableDictionary *made;
+    static const struct { const char *name; SFSymbolDrawer draw; } table[] = {
+        { "info.circle", sfInfoCircle },
+        { "ellipsis.circle", sfEllipsisCircle },
+        { "xmark.octagon", sfXmarkOctagon },
+        { "magnifyingglass", sfMagnifyingGlass },
+        { "arrow.forward.circle.fill", sfArrowForwardCircleFill },
+    };
+    SFSymbolDrawer draw = NULL;
+    NSImage *image;
+
+    if (![name isKindOfClass:[NSString class]])
+        return nil;
+    for (unsigned i = 0; i < sizeof(table) / sizeof(table[0]); i++)
+        if ([name isEqualToString:[NSString stringWithUTF8String:table[i].name]])
+            draw = table[i].draw;
+    if (draw == NULL)
+        return nil;
+    if ((image = [made objectForKey:name]) != nil)
+        return [[image copy] autorelease];
+
+    // a symbol of the regular toolbar size (about 17 points), drawn at three pixels a point so that it
+    // stays sharp at the desktop's scales (1.5, 2)
+    const CGFloat points = 17, scale = 3;
+    NSBitmapImageRep *rep = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:(NSInteger)(points * scale)
+                                                                    pixelsHigh:(NSInteger)(points * scale) bitsPerSample:8
+                                                               samplesPerPixel:4 hasAlpha:YES isPlanar:NO
+                                                                colorSpaceName:NSDeviceRGBColorSpace bytesPerRow:0 bitsPerPixel:0];
+    NSGraphicsContext *context = [NSGraphicsContext graphicsContextWithBitmapImageRep:rep];
+    NSAffineTransform *transform = [NSAffineTransform transform];
+
+    [NSGraphicsContext saveGraphicsState];
+    [NSGraphicsContext setCurrentContext:context];
+    [transform scaleBy:scale];
+    [transform concat];
+    [[NSColor colorWithCalibratedWhite:0.2 alpha:0.9] set];
+    draw(NSMakeRect(0.5, 0.5, points - 1, points - 1), 1.35);
+    [context flushGraphics];
+    [NSGraphicsContext restoreGraphicsState];
+    [rep setSize:NSMakeSize(points, points)];
+
+    image = [[NSImage alloc] initWithSize:NSMakeSize(points, points)];
+    [image addRepresentation:rep];
+    [rep release];
+    [image setTemplate:YES];
+    if (made == nil)
+        made = [[NSMutableDictionary alloc] init];
+    [made setObject:image forKey:name];
+    return [image autorelease];
+}
+
+@end
