+/* a reload of a row shown: each column's view asked for again, the cell's own view offered back
+ * first; a different view takes its place */
+- (void)_sfReloadRowView:(NSTableRowView *)rv row:(NSInteger)row {
+    SFViewBasedState *s = [self _sfViewState];
+    NSArray *cells = [[[rv subviews] copy] autorelease];
+    NSInteger ncols = [[self tableColumns] count];
+    for (NSInteger c = 0; c < ncols; c++) {
+        NSTableColumn *tc = [[self tableColumns] objectAtIndex:c];
+        NSView *old = c < (NSInteger)[cells count] ? [cells objectAtIndex:c] : nil;
+        NSView *v = nil;
+        if (![tc isHidden]) {
+            s->preferred = old;
+            v = [self _sfMakeViewForColumn:c row:row];
+            s->preferred = nil;
+        }
+        if (v == nil) {
+            BOOL plain = old != nil && [old class] == [NSView class];
+            v = plain ? old : [[[NSView alloc] initWithFrame:NSZeroRect] autorelease];   /* keeps column order */
+        }
+        if (v == old)
+            continue;
+        if (old != nil) {
+            [v retain];
+            [v removeFromSuperview];
+            [rv replaceSubview:old with:v];
+            [v release];
+            if ([old superview] == nil)
+                [self _sfRecycleView:old];
+        } else
+            [rv addSubview:v];
+    }
+}
