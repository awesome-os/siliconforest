 // a generation of laid out strings: a table window's worth of cells and more
 #define SF_TYPESET_LIMIT 800
 
+// SF_TYPESET_LIMIT=<n>: a smaller generation (to test the generations' turnover)
+static NSUInteger sfTypesetLimit(void) {
+    static NSUInteger limit;
+
+    if (limit == 0) {
+        const char *v = getenv("SF_TYPESET_LIMIT");
+        limit = (v != NULL && atoi(v) > 0) ? (NSUInteger)atoi(v) : SF_TYPESET_LIMIT;
+    }
+    return limit;
+}
