+// Private to macOS, imported by Apple's Terminal: glyphs laid out by their advances from the
+// context's text position, which moves on by their sum.
+void CTFontDrawGlyphsWithAdvances(CTFontRef font,const CGGlyph *glyphs,const CGSize *advances,size_t count,CGContextRef context) {
+   if(font==NULL || glyphs==NULL || advances==NULL || context==NULL || count==0)
+    return;
+
+   CGPoint stack[256],*positions=count<=256 ? stack : malloc(count*sizeof(CGPoint));
+
+   if(positions==NULL)
+    return;
+
+   CGPoint at=CGContextGetTextPosition(context);
+   CGFloat x=0,y=0;
+
+   for(size_t i=0;i<count;i++){
+    positions[i]=CGPointMake(at.x+x,at.y+y);
+    x+=advances[i].width;
+    y+=advances[i].height;
+   }
+   CTFontDrawGlyphs(font,glyphs,positions,count,context);
+   CGContextSetTextPosition(context,at.x+x,at.y+y);
+   if(positions!=stack)
+    free(positions);
+}
+
+// Private to macOS: every font is drawn anti-aliased by Onyx2D.
+bool CTFontShouldAntiAlias(CTFontRef font) {
+   return true;
+}
