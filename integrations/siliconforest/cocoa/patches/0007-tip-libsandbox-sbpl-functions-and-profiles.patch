+char *
+sbpl_read_file(const char *path)
+{
+	size_t limit = SB_PROFILE_MAX_SIZE;
+	char *buffer = NULL;
+	size_t length = 0, capacity = 0;
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+
+	if (fd < 0) {
+		return NULL;
+	}
+	for (;;) {
+		ssize_t n;
+
+		if (length + 1 >= capacity) {
+			size_t grown = capacity ? capacity * 2 : 4096;
+			char *p;
+
+			if (grown > limit + 1) {
+				grown = limit + 1;
+			}
+			if (grown <= length + 1) {
+				errno = EFBIG;
+				goto fail;
+			}
+			p = realloc(buffer, grown);
+			if (p == NULL) {
+				goto fail;
+			}
+			buffer = p;
+			capacity = grown;
+		}
+		n = read(fd, buffer + length, capacity - length - 1);
+		if (n < 0 && errno == EINTR) {
+			continue;
+		}
+		if (n < 0) {
+			goto fail;
+		}
+		if (n == 0) {
+			break;
+		}
+		length += (size_t)n;
+	}
+	close(fd);
+	buffer[length] = '\0';
+	return buffer;
+fail:
+	close(fd);
+	free(buffer);
+	return NULL;
+}
