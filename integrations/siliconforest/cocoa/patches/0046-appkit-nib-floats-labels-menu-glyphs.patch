-- (CGFloat)decodeFloatForKey:(NSString *)key {
+// NSCoder's -decodeFloatForKey: answers a float: declared CGFloat here, the result came back in d0
+// while every caller (typed NSCoder or NSKeyedUnarchiver) read s0, the low half of the double, so a
+// nib's float values (a table column's width, a table's row height ...) were read as 0
+- (float)decodeFloatForKey:(NSString *)key {
     return (float)doubleOf([self valueForKey:key]);
 }
 
