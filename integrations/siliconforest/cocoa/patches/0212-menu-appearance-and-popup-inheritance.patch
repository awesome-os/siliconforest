+@implementation NSMenu (NSAppearance)
+
+- (NSAppearance *)appearance { return objc_getAssociatedObject(self, &appearanceKey); }
+
+- (void)setAppearance:(NSAppearance *)appearance
+{
+    objc_setAssociatedObject(self, &appearanceKey, appearance, OBJC_ASSOCIATION_RETAIN);
+    for (NSWindow *window in [NSApp windows]) {
+        NSView *view = [window contentView];
+        if ([view isKindOfClass:NSClassFromString(@"NSMenuView")] && [view menu] == self)
+            [view setNeedsDisplay:YES];
+    }
+}
+
+- (NSAppearance *)effectiveAppearance
+{
+    return [self appearance] ?: [[self supermenu] effectiveAppearance] ?: [NSApp effectiveAppearance];
+}
+
+@end
