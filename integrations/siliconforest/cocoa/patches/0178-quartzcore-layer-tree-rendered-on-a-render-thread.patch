+-(BOOL)_sfrtEnabled {
+   return sfrtOn();
+}
+
+-(void)_sfrtBeginFrame {
+   if(sfrtOn())
+    sfrtLockFrame();
+}
+
+-(void)_sfrtEndFrame {
+   if(!sfrtOn())
+    return;
+   // an EGL context can be current on one thread only: the render thread makes it current for its frames
+   if(CGLGetCurrentContext()==_glContext)
+    CGLSetCurrentContext(NULL);
+   sfrtUnlockFrame();
+}
+
+-(void)_sfrtSetPresent:(int (*)(CALayerContext *,const void *))present info:(const void *)info length:(size_t)length {
+   if(!sfrtOn())
+    return;
+   void *copy=NULL;
+   if(present!=NULL && info!=NULL && length>0){
+    copy=malloc(length);
+    if(copy==NULL)
+     present=NULL;
+    else
+     memcpy(copy,info,length);
+   }
+   sfrtLockFrame();
+   free(_sfrtInfo);
+   _sfrtInfo=copy;
+   __atomic_store_n(&_sfrtPresent,present,__ATOMIC_RELEASE);
+   __atomic_store_n(&_sfrtStale,present==NULL,__ATOMIC_SEQ_CST);
+   sfrtUnlockFrame();
+}
