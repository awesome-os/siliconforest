+// (TERM12) whether a committed transaction may have changed this context's picture without a layer change of its own: an
+// IOSurface it shows redrawn in place (its seed moved since the last commit)
+-(BOOL)_sfrtCommitTouches {
+   struct SFFXLayerStamp stamps[SFFX_MAX_STAMPS];
+   unsigned count=0;
+   BOOL uncertain=NO;
+   uint64_t h=1469598103934665603ULL;
+
+   pthread_once(&sffxStampOnce,sffxLoadStampAPI);
+   sffxCollectStamps(_layer,stamps,&count,0,&uncertain);
+   for(unsigned i=0;i<count;i++){
+    uint64_t v[4]={(uintptr_t)stamps[i].layer,(uintptr_t)stamps[i].contents,stamps[i].localSeed,stamps[i].surfaceSeed};
+    for(int k=0;k<4;k++)
+     h=(h^v[k])*1099511628211ULL;
+   }
+   h^=count;
+   uint64_t old=__atomic_exchange_n(&_sfrtCommitStamp,h,__ATOMIC_ACQ_REL);
+   // contents that are not IOSurfaces (images) cannot change in place: their object and seed are in the stamp
+   (void)uncertain;
+   return old!=h;
+}
