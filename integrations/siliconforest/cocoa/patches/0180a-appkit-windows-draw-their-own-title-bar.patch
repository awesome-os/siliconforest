+/* (TERM12, FX-002) A window whose content runs under a transparent title bar with its title hidden draws its own title
+ * bar, as macOS does it: Firefox with its tabs in the title bar (it makes its view the whole frame and leaves the
+ * place of the window buttons free in its tab strip, -_closeButtonOrigin). The compositor then draws only the
+ * window's edges (client-side decorations), AppKit the three buttons over the content, and the in-window menu strip
+ * is not shown (Control-click on the buttons' row shows the application's menus). SF_NO_CLIENT_TITLEBAR=1: as before. */
+-(BOOL)_sfDrawsOwnTitlebar {
+   static int off=-1;
+   if(off<0)off=getenv("SF_NO_CLIENT_TITLEBAR")!=NULL;
+   return !off && (_styleMask & NSFullSizeContentViewWindowMask) && (_styleMask & NSTitledWindowMask) &&
+          !(_styleMask & NSFullScreenWindowMask) && _titlebarAppearsTransparent && _titleVisibility==NSWindowTitleHidden &&
+          NSWindowFrameIsDrawnByServer(_styleMask);
+}
+
+-(BOOL)_sfFrameIsDrawnByServer {
+   return NSWindowFrameIsDrawnByServer(_styleMask) && ![self _sfDrawsOwnTitlebar];
+}
+
+// who draws the title bar may have changed: the window server is told (the compositor's frame comes or goes), the
+// menu strip comes or goes, the frame lays itself out again
+-(void)_sfTitlebarModeChanged:(BOOL)was {
+   if([self _sfDrawsOwnTitlebar]==was)
+    return;
+   [self _updateWSState];
+   if([self respondsToSelector:@selector(_sfUpdateMenuStrip)])
+    [self performSelector:@selector(_sfUpdateMenuStrip)];
+   [_backgroundView resizeSubviewsWithOldSize:[_backgroundView frame].size];
+   [_backgroundView setNeedsDisplay:YES];
+}
+
 -(void)setTitleVisibility:(NSWindowTitleVisibility)value {
+   BOOL was=[self _sfDrawsOwnTitlebar];
    _titleVisibility=value;
    [_backgroundView setNeedsDisplay:YES];
+   [self _sfTitlebarModeChanged:was];
 }
 
 -(void)setTitlebarAppearsTransparent:(BOOL)value {
+   BOOL was=[self _sfDrawsOwnTitlebar];
    _titlebarAppearsTransparent=value;
    [_backgroundView setNeedsDisplay:YES];
+   [self _sfTitlebarModeChanged:was];
 }
 
