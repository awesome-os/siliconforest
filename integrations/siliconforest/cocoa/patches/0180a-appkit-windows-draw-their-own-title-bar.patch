+/* (TERM12, FX-002) In a window that draws its own title bar over GPU layers (Firefox's), the window server puts the
+ * part of the window's own picture where the buttons are over those layers (the buttons' view clears its rectangle
+ * first, so only the buttons cover the layers): AppKit draws the buttons into the window, the layers would hide them. */
+-(void)_sfUpdateControlsOverlay {
+    static int (*setOverlay)(int,int,int,int,int);
+    static int looked;
+    NSWindow *window = [self window];
+
+    if(!looked){setOverlay=(int (*)(int,int,int,int,int))dlsym(RTLD_DEFAULT,"_windowServerSFFXSetOverlay");looked=1;}
+    if(setOverlay==NULL || window==nil || [window windowNumber]<=0)
+        return;
+    if(![window _sfDrawsOwnTitlebar] || _controlsView==nil) {
+        setOverlay((int)[window windowNumber],0,0,0,0);
+        return;
+    }
+    NSRect r = [_controlsView frame];
+    CGFloat scale = [window backingScaleFactor];
+    int x = (int)floor(NSMinX(r) * scale), y = (int)floor((NSHeight([self bounds]) - NSMaxY(r)) * scale);
+    setOverlay((int)[window windowNumber], x, y, (int)ceil(NSWidth(r) * scale), (int)ceil(NSHeight(r) * scale));
+}
