+        return size;
+    }
+    for (NSCollectionLayoutItem *sub in subitems) {
+        if (*index >= count)
+            break;
+        NSPoint p = vertical ? NSMakePoint(origin.x, origin.y + at) : NSMakePoint(origin.x + at, origin.y);
+        NSSize used = sfPlace(sub, p, size, section, index, count, out);
+        at += vertical ? used.height : used.width;
+    }
+    return size;
