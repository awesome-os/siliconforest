+@interface SFCompositionalEnvironment : NSObject {
+@public
+    NSSize _size;
+}
+@end
+
+@implementation SFCompositionalEnvironment
+- (id)container { return self; }
+- (NSSize)contentSize { return _size; }
+- (NSSize)effectiveContentSize { return _size; }
+- (NSEdgeInsets)contentInsets { return NSEdgeInsetsMake(0, 0, 0, 0); }
