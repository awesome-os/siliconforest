+// (TERM7) the arranged-subviews API of macOS 10.11 (Activity Monitor's GPU History asks -arrangedSubviews). With
+// arrangesAllSubviews (the default) the arranged subviews are the subviews; without it a list of its own, kept in
+// subview order
+static char sfSplitArrangesSomeKey, sfSplitArrangedKey;
+
+-(BOOL)arrangesAllSubviews {
+   return objc_getAssociatedObject(self, &sfSplitArrangesSomeKey)==nil;
+}
+
+-(void)setArrangesAllSubviews:(BOOL)value {
+   if(value==[self arrangesAllSubviews])
+    return;
+   objc_setAssociatedObject(self, &sfSplitArrangesSomeKey, value ? nil : (id)kCFBooleanTrue, OBJC_ASSOCIATION_RETAIN);
+   objc_setAssociatedObject(self, &sfSplitArrangedKey, value ? nil : [NSMutableArray arrayWithArray:[self subviews]], OBJC_ASSOCIATION_RETAIN);
+   [self _sfSplitNeedsAdjust];
+}
+
+-(NSArray *)arrangedSubviews {
+   NSMutableArray *list=objc_getAssociatedObject(self, &sfSplitArrangedKey);
+
+   if([self arrangesAllSubviews] || list==nil)
+    return [self subviews];
+   return [[list copy] autorelease];
+}
+
+-(void)addArrangedSubview:(NSView *)view {
+   [self insertArrangedSubview:view atIndex:[[self arrangedSubviews] count]];
+}
+
+-(void)insertArrangedSubview:(NSView *)view atIndex:(NSInteger)index {
+   NSMutableArray *list=objc_getAssociatedObject(self, &sfSplitArrangedKey);
+
+   if([self arrangesAllSubviews] || list==nil){
+    NSArray *subviews=[self subviews];
+
+    if([view superview]==self)
+     [view removeFromSuperview];
+    if(index>=0 && (NSUInteger)index<[subviews count])
+     [self addSubview:view positioned:NSWindowBelow relativeTo:[subviews objectAtIndex:index]];
+    else
+     [self addSubview:view];
+    return;
+   }
+   if([view superview]!=self)
+    [self addSubview:view];
+   [list removeObjectIdenticalTo:view];
+   [list insertObject:view atIndex:MIN((NSUInteger)MAX(index,0),[list count])];
+   [self _sfSplitNeedsAdjust];
+}
+
+-(void)removeArrangedSubview:(NSView *)view {
+   NSMutableArray *list=objc_getAssociatedObject(self, &sfSplitArrangedKey);
+
+   // as on macOS the view stays a subview; with arrangesAllSubviews there is no separate list to leave
+   if(list!=nil && ![self arrangesAllSubviews]){
+    [list removeObjectIdenticalTo:view];
+    [self _sfSplitNeedsAdjust];
+   }
+}
