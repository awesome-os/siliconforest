+static CGFloat sfResolve(NSCollectionLayoutDimension *d, NSSize container, CGFloat fallback) {
+    if (d == nil)
+        return fallback;
+    if ([d isFractionalWidth]) return [d dimension] * container.width;
+    if ([d isFractionalHeight]) return [d dimension] * container.height;
+    return [d dimension];
+}
+
+/* places one item or group at origin within container; advances *index for each item placed; the size it took */
+static NSSize sfPlace(NSCollectionLayoutItem *item, NSPoint origin, NSSize container, NSInteger section, NSInteger *index,
+                      NSInteger count, NSMutableArray *out) {
+    NSSize size = NSMakeSize(sfResolve([[item layoutSize] widthDimension], container, container.width),
+                             sfResolve([[item layoutSize] heightDimension], container, container.height));
+    if (![item isKindOfClass:[NSCollectionLayoutGroup class]]) {
+        if (*index >= count)
+            return size;
+        NSCollectionViewLayoutAttributes *a = [NSCollectionViewLayoutAttributes
+            layoutAttributesForItemWithIndexPath:[NSIndexPath indexPathForItem:*index inSection:section]];
+        [a setFrame:NSMakeRect(origin.x, origin.y, size.width, size.height)];
+        [out addObject:a];
+        (*index)++;
+        return size;
+    }
+    NSArray *subitems = [item subitems];
+    BOOL vertical = item->_vertical;
+    CGFloat at = 0;
+    if (item->_count > 0 && [subitems count] > 0) {
+        NSInteger n = item->_count;
+        NSSize each = vertical ? NSMakeSize(size.width, size.height / n) : NSMakeSize(size.width / n, size.height);
+        for (NSInteger k = 0; k < n && *index < count; k++) {
+            NSPoint p = vertical ? NSMakePoint(origin.x, origin.y + k * each.height) : NSMakePoint(origin.x + k * each.width, origin.y);
