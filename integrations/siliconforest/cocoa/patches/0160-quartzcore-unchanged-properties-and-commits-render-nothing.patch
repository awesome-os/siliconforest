+ counts[what]++;
+ if(since==0)since=now;
+ if(now-since>=5){
+  fprintf(stderr,"PD-CA-DIAG renders/5s rendered=%lu reused=%lu rendered-unchanged=%lu%s\n",counts[1],counts[0],counts[2],sfcaSkipUnchanged()?" (skip unchanged)":"");
