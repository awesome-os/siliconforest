-// Onyx2D's spaces are device spaces without an ICC profile, Apple answers NULL for those too
+static char colorSpaceICCKey;
+
+static uint32_t iccWord(const uint8_t *p) {
+   return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+// a space of the profile's model that keeps the profile (an immutable copy of its bytes)
+static CGColorSpaceRef createWithProfileBytes(CFDataRef data) {
+   if(data == NULL || CFGetTypeID(data) != CFDataGetTypeID())
+      return NULL;
+   CFIndex length = CFDataGetLength(data);
+   const uint8_t *bytes = CFDataGetBytePtr(data);
+   if(length < 128 || bytes == NULL || iccWord(bytes + 36) != 0x61637370 /* 'acsp' */)
+      return NULL;
+   uint32_t declared = iccWord(bytes);
+   if(declared < 128 || declared > (uint32_t)length)
+      return NULL;
+   CGColorSpaceRef space = NULL;
+   switch(iccWord(bytes + 16)) {
+   case 0x47524159: /* 'GRAY' */ space = O2ColorSpaceCreateDeviceGray(); break;
+   case 0x52474220: /* 'RGB ' */ space = O2ColorSpaceCreateDeviceRGB(); break;
+   case 0x434D594B: /* 'CMYK' */ space = O2ColorSpaceCreateDeviceCMYK(); break;
+   default: return NULL; /* Lab, XYZ, n-colour: no such model in Onyx2D */
+   }
+   CFDataRef copy = CFDataCreate(NULL, bytes, (CFIndex)declared);
+   objc_setAssociatedObject((id)space, &colorSpaceICCKey, (id)copy, OBJC_ASSOCIATION_RETAIN);
+   CFRelease(copy);
+   return space;
+}
+
+CGColorSpaceRef CGColorSpaceCreateWithICCData(CFTypeRef data) {
+   if(data == NULL)
+      return NULL;
+   if(CFGetTypeID(data) == CFDataGetTypeID())
+      return createWithProfileBytes((CFDataRef)data);
+   // a CGDataProvider (the other type the call takes)
+   CFDataRef bytes = CGDataProviderCopyData((CGDataProviderRef)data);
+   CGColorSpaceRef space = createWithProfileBytes(bytes);
+   if(bytes)
+      CFRelease(bytes);
+   return space;
+}
+
+CGColorSpaceRef CGColorSpaceCreateWithICCProfile(CFDataRef data) {
+   return createWithProfileBytes(data);
+}
+
+CGColorSpaceRef CGColorSpaceCreateICCBased(size_t nComponents, const CGFloat *range, CGDataProviderRef profile, CGColorSpaceRef alternate) {
+   CGColorSpaceRef space = profile ? CGColorSpaceCreateWithICCData((CFTypeRef)profile) : NULL;
+   if(space && O2ColorSpaceGetNumberOfComponents(space) != nComponents) {
+      O2ColorSpaceRelease(space);
+      space = NULL;
+   }
+   if(space == NULL && alternate != NULL && O2ColorSpaceGetNumberOfComponents(alternate) == nComponents)
+      space = O2ColorSpaceRetain(alternate);
+   return space;
+}
+
+// the profile a space was made with; Onyx2D's device and named spaces have none (NULL, as Apple's device spaces)
 CFDataRef CGColorSpaceCopyICCData(CGColorSpaceRef space) {
-   return NULL;
+   CFDataRef data = space ? (CFDataRef)objc_getAssociatedObject((id)space, &colorSpaceICCKey) : NULL;
+   return data ? (CFDataRef)CFRetain(data) : NULL;
+}
+
+CGColorSpaceRef CGColorSpaceCreateIndexed(CGColorSpaceRef baseSpace, size_t lastIndex, const unsigned char *colorTable) {
+   if(baseSpace == NULL || colorTable == NULL || lastIndex > 255)
+      return NULL;
+   O2ColorSpaceModel model = O2ColorSpaceGetModel(baseSpace);
+   if(model == kO2ColorSpaceModelIndexed || model == kO2ColorSpaceModelPattern)
+      return NULL;
+   return [[O2ColorSpace_indexed alloc] initWithColorSpace:baseSpace hival:(unsigned)lastIndex bytes:colorTable];
+}
+
+// the indexed getters: Codex's bodies (runs/m1-coord/requests-for-CLAUDE.md, vImage); a pattern space keeps no base here
+CGColorSpaceRef CGColorSpaceGetBaseColorSpace(CGColorSpaceRef space) {
+   if(!space || O2ColorSpaceGetModel(space) != kO2ColorSpaceModelIndexed)
+      return NULL;
+   return [(O2ColorSpace_indexed *)space baseColorSpace];
+}
+
+size_t CGColorSpaceGetColorTableCount(CGColorSpaceRef space) {
+   if(!space || O2ColorSpaceGetModel(space) != kO2ColorSpaceModelIndexed)
+      return 0;
+   return (size_t)[(O2ColorSpace_indexed *)space hival] + 1;
+}
+
+void CGColorSpaceGetColorTable(CGColorSpaceRef space, uint8_t *table) {
+   if(!table || !space || O2ColorSpaceGetModel(space) != kO2ColorSpaceModelIndexed)
+      return;
+   O2ColorSpace_indexed *indexed = (O2ColorSpace_indexed *)space;
+   size_t bytes = ((size_t)[indexed hival] + 1) * O2ColorSpaceGetNumberOfComponents([indexed baseColorSpace]);
+   memcpy(table, [indexed paletteBytes], bytes);
 }
