+/* A string that is wider than its rect and whose paragraph style truncates (head, middle or tail) is drawn with
+ * an ellipsis in place of what does not fit, on one line, as macOS draws it; the typesetter lays out these modes
+ * as clipping, and a centred title too long for its tab was drawn with its ends over each other. */
+static NSString *sfTruncated(NSString *string,NSDictionary *attributes,CGFloat width,NSLineBreakMode mode){
+   NSUInteger length=[string length];
+   NSString *ellipsis=@"\u2026";
+   NSUInteger low=0,high=length;
+
+   if([string sizeWithAttributes:attributes].width<=width)
+    return string;
+   // the most characters that fit with the ellipsis
+   while(low<high){
+    NSUInteger keep=(low+high+1)/2;
+    NSString *candidate;
+
+    if(mode==NSLineBreakByTruncatingHead)
+     candidate=[ellipsis stringByAppendingString:[string substringFromIndex:length-keep]];
+    else if(mode==NSLineBreakByTruncatingTail)
+     candidate=[[string substringToIndex:keep] stringByAppendingString:ellipsis];
+    else
+     candidate=[NSString stringWithFormat:@"%@%@%@",[string substringToIndex:(keep+1)/2],ellipsis,[string substringFromIndex:length-keep/2]];
+    if([candidate sizeWithAttributes:attributes].width<=width)
+     low=keep;
+    else
+     high=keep-1;
+   }
+   if(low==0)
+    return ellipsis;
+   if(mode==NSLineBreakByTruncatingHead)
+    return [ellipsis stringByAppendingString:[string substringFromIndex:length-low]];
+   if(mode==NSLineBreakByTruncatingTail)
+    return [[string substringToIndex:low] stringByAppendingString:ellipsis];
+   return [NSString stringWithFormat:@"%@%@%@",[string substringToIndex:(low+1)/2],ellipsis,[string substringFromIndex:length-low/2]];
+}
