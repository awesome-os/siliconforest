+/* As on macOS a window taken off the screen is no longer key or main: the frontmost visible window that can
+ * be takes its place (the compositor's activation of the window it focuses then confirms it). It stayed key
+ * after its -close: Activity Monitor's process inspector, closed, kept being asked for menu actions through
+ * its freed delegate, and the application ended with SIGSEGV. */
+-(void)_sfGiveUpKeyAndMain {
+   BOOL wasKey=([NSApp keyWindow]==self), wasMain=([NSApp mainWindow]==self);
+
+   if(!wasKey && !wasMain)
+    return;
+   [[self retain] autorelease];
+   if(wasKey){
+    [NSApp _setKeyWindow:nil];
+    [self resignKeyWindow];
+   }
+   if(wasMain){
+    [NSApp _setMainWindow:nil];
+    [self resignMainWindow];
+   }
+   for(NSWindow *window in [NSApp orderedWindows]){
+    if(window==self || ![window isVisible] || [window isMiniaturized])
+     continue;
+    if(wasMain && [window canBecomeMainWindow]){
+     [window becomeMainWindow];
+     wasMain=NO;
+    }
+    if(wasKey && [window canBecomeKeyWindow]){
+     [window makeKeyWindow];
+     wasKey=NO;
+    }
+    if(!wasKey && !wasMain)
