+static void sfInstallCrashReport(void) {
+   const char *home = getenv("HOME");
+   const char *name = getprogname();
+   static const int sigs[] = { SIGSEGV, SIGBUS, SIGILL, SIGABRT, SIGFPE, SIGTRAP };
+   struct sigaction action;
+   stack_t stack;
+
+   if (home == NULL || name == NULL || getenv("SF_NO_CRASH_REPORT") != NULL)
+      return;
+   char dir[900];
+
+   snprintf(dir, sizeof(dir), "%s/Library/Logs/DiagnosticReports", home);
+   mkdir(dir, 0755);
+   snprintf(sfCrashPath, sizeof(sfCrashPath), "%s/%s-%d.crash", dir, name, (int)getpid());
+   // its own stack, so that a stack overflow can be reported
+   stack.ss_sp = malloc(64 * 1024);
+   stack.ss_size = 64 * 1024;
+   stack.ss_flags = 0;
+   if (stack.ss_sp != NULL)
+      sigaltstack(&stack, NULL);
+   memset(&action, 0, sizeof(action));
+   action.sa_sigaction = sfCrashHandler;
+   action.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESETHAND;
+   sigemptyset(&action.sa_mask);
+   for (unsigned i = 0; i < sizeof(sigs) / sizeof(sigs[0]); i++) {
+      struct sigaction old;
+
+      // a handler the program installed itself stays
+      if (sigaction(sigs[i], NULL, &old) == 0 && old.sa_handler == SIG_DFL)
+         sigaction(sigs[i], &action, NULL);
+   }
+}
