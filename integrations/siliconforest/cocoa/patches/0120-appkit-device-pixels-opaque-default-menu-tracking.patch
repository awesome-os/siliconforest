+/* As on macOS, a view taken out of the hierarchy takes with it the constraints held above it that tie it, or a
+ * view inside it, to the rest: they stayed, holding the view unretained, and a later layout messaged it after it
+ * was freed (Activity Monitor ended with SIGSEGV switching its tabs, in -_sfLayoutTreeFitting:apply:). */
+void _NSViewRemoveConstraintsReferringTo(NSView *above, NSView *removed) {
+    for (; above != nil; above = [above superview]) {
+        NSArray *held = objc_getAssociatedObject(above, &constraintsKey);
+        NSMutableArray *gone = nil;
+
+        for (NSLayoutConstraint *c in held) {
+            id a = [c firstItem], b = [c secondItem];
+
+            if ((a != nil && sfIsWithin(a, removed)) || (b != nil && sfIsWithin(b, removed))) {
+                if (gone == nil)
+                    gone = [NSMutableArray array];
+                [gone addObject:c];
+            }
+        }
+        if (gone != nil)
+            [above removeConstraints:gone];
+    }
