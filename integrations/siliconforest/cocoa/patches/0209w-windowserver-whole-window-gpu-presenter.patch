+ sfGPU.glTexCoord2f(sx+sw,sy+sh);sfGPU.glVertex2f(x+w,y+h);
+ sfGPU.glTexCoord2f(sx,sy+sh);sfGPU.glVertex2f(x,y+h);sfGPU.glEnd();
+}
