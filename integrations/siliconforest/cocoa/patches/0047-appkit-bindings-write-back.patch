+/* A click changes the cell, not the control: the key-value observation through which a value
+ * binding writes back (_NSBinder observes the control's key) heard nothing, and a checkbox in
+ * Terminal's preferences changed nothing in the profile. As on macOS, the bound value goes to the
+ * model when the control sends its action. */
+-(void)_sfPushBoundValues {
+   static NSString *const names[]={@"value",@"selectedTag",@"selectedValue",@"selectedObject",@"selectedIndex"};
+   unsigned i;
+
+   for(i=0;i<sizeof(names)/sizeof(names[0]);i++){
+    _NSBinder *binder=[self _binderForBinding:names[i] create:NO];
+    NSString  *path=[binder bindingPath];
+
+    if(binder==nil || ![path isKindOfClass:[NSString class]])
+     continue;
+    [self willChangeValueForKey:path];
+    [self didChangeValueForKey:path];
+   }
+}
+
 -(BOOL)sendAction:(SEL)action to:target {
+   [self _sfPushBoundValues];
    return [NSApp sendAction:action to:target from:self];
 }
 
