+/* A window keeps at most two frames once the others have gone unused for two seconds: a burst of flushes (a
+ * window settling, a resize, a flood of output) takes a third and a fourth while the compositor still holds
+ * the two before, and each is the whole window (8 MB for Activity Monitor's at 150 %); kept for good they were
+ * most of what an idle application's memory grew by. Asked at each flush, before a frame is picked. */
+static void windowTrimFrames(struct wsWindow *window) {
+    static int keepAll = -1;
+    double now = wsNowMs();
+    int have = 0;
+
+    if (keepAll < 0)
+        keepAll = getenv("SF_WS_KEEP_FRAMES") != NULL;
+    if (keepAll)
+        return;
+    pthread_mutex_lock(&ws.queueLock);
+    for (int i = 0; i < WS_FRAMES; i++)
+        if (window->frames[i].buffer != NULL)
+            have++;
+    for (int i = 0; i < WS_FRAMES && have > 2; i++) {
+        struct wsFrame *frame = &window->frames[i];
+
+        if (frame->buffer != NULL && !frame->busy && now - frame->usedAt > 2000) {
+            if (getenv("SF_WS_TRACE") != NULL)
+                fprintf(stderr, "WindowServer: surface %d: frame %d unused %.0f ms, let go (%zu bytes)\n", window->windowID, i, now - frame->usedAt, frame->size);
+            frameDestroy(frame);
+            have--;
+        }
+    }
+    pthread_mutex_unlock(&ws.queueLock);
+}
