+// (TERM9, FX-023) an event's time is seconds since the system started (mach_absolute_time), as on macOS: it was
+// seconds since 2001 (NSDate's reference), 26 years off for anything comparing it with the uptime clock
+// (Firefox's Event.timeStamp, input latency measurements)
++(NSTimeInterval)_sfTimestampNow {
+   static mach_timebase_info_data_t tb;
+   if(tb.denom==0)
+    mach_timebase_info(&tb);
+   return (double)mach_absolute_time()*tb.numer/tb.denom/1e9;
+}
