--- a/src/Frameworks/CoreGraphics/CGPrivateAdditions.m
+++ b/src/Frameworks/CoreGraphics/CGPrivateAdditions.m
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: MIT
+// CoreGraphics functions applications built against current macOS SDKs import that the rest of
+// this framework does not have (first user: Apple's Terminal.app,
+// docs/roadmap/issues/SF-Y-terminal-app.md in the SiliconForest lab).
+#include <CoreFoundation/CoreFoundation.h>
+#include <stdbool.h>
+#include <stdint.h>
+#import <CoreGraphics/CGContext.h>
+
+typedef int32_t CGSError;
+enum { kCGSErrorSuccess = 0, kCGSErrorNotImplemented = 1004 };
+
+// Text rendering state. Onyx2D rasterises glyphs with FreeType's grey anti-aliasing and has
+// no LCD ("font smoothing") path; these answer what the renderer does, not what was last set.
+bool CGContextGetAllowsAntialiasing(CGContextRef c) { return true; }
+bool CGContextGetAllowsFontSmoothing(CGContextRef c) { return false; }
+bool CGContextGetShouldSmoothFonts(CGContextRef c) { return false; }
+int CGContextGetFontSmoothingStyle(CGContextRef c) { return 0; }
+void CGContextSetFontSmoothingStyle(CGContextRef c, int style) { }
+
+// Window server connection calls (private CGS/CPS). The window server here is a Wayland
+// compositor: there is no connection number, a client cannot blur what is behind its window,
+// and no client can take or give away the keyboard focus. Keystrokes reach only the focused
+// client, so "secure event input" has nothing to switch on.
+int CGSMainConnectionID(void) { return 0; }
+CGSError CGSSetSecureEventInput(int connection, bool enable) { return kCGSErrorNotImplemented; }
+CGSError CGSSetWindowBackgroundBlurRadiusWithOpacityHint(int connection, int window, int radius, bool opaque) { return kCGSErrorNotImplemented; }
+struct CPSProcessSerialNumber { uint32_t high, low; };
+CGSError CPSGetCurrentProcess(struct CPSProcessSerialNumber *psn) { if (psn) { psn->high = 0; psn->low = 2; /* kCurrentProcess */ } return kCGSErrorSuccess; }
+CGSError CPSStealKeyFocus(struct CPSProcessSerialNumber *psn) { return kCGSErrorNotImplemented; }
+CGSError CPSReleaseKeyFocus(struct CPSProcessSerialNumber *psn) { return kCGSErrorNotImplemented; }
