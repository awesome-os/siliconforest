+// a view laid out by constraints is as wide as its value: a new value has its intrinsic size invalidated
+// so the layout runs again (Activity Monitor's summary figures were as wide as the first value they
+// were given, a digit). Not for the cells of a table's rows, whose frames the row gives them.
+static BOOL sfSizesToValue(NSControl *self) {
+    static Class rowView;
+
+    if ([self translatesAutoresizingMaskIntoConstraints] || [self superview] == nil)
+        return NO;
+    if (rowView == Nil)
+        rowView = NSClassFromString(@"NSTableRowView");
+    for (NSView *v = [self superview]; v != nil; v = [v superview])
+        if (rowView != Nil && [v isKindOfClass:rowView])
+            return NO;
+    return YES;
+}
+
+// the length of what the control shows, or NSNotFound when its size does not follow its value
+static NSUInteger sfValueLength(NSControl *self) {
+    return sfSizesToValue(self) ? [[[self selectedCell] stringValue] length] : NSNotFound;
+}
+
+// a new layout only when the shown string's length changed: a pass solves the window's constraints
+// (Activity Monitor's summary figures change every refresh, in digits of one width, and a pass for
+// each cost a sixth of a core)
+// Activity Monitor sets some values off the main thread (bindings fed from its sampling queue): the
+// layout pass is asked for on the main thread, else it ran on a dispatch worker and measured text
+// with the shared string drawer while the main thread drew (CoreFoundation halted in CFArrayCreateCopy
+// under -[NSTextStorage processEditing])
+static void sfValueMayResize(NSControl *self, NSUInteger before) {
+    if (before == NSNotFound || sfValueLength(self) == before)
+        return;
+    if ([NSThread isMainThread])
+        [self invalidateIntrinsicContentSize];
+    else {
+        [self retain];
+        dispatch_async(dispatch_get_main_queue(), ^{ [self invalidateIntrinsicContentSize]; [self release]; });
+    }
+}
