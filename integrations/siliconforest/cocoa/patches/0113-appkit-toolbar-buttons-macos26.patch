+   NSButtonCell *cell=[(NSButton *)view cell];
+   // an image without a title (a pull-down's title is its first item's)
+   return [cell image]!=nil && ([[cell title] length]==0 || [cell isKindOfClass:[NSPopUpButtonCell class]]);
+}
