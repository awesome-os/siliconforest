+// (cocoa 0113) a button that is an icon-only toolbar item's view (NSToolbarView marks it): macOS 26 draws
+// the glyph alone, centred, in the toolbar's shared capsule (NSToolbarView draws that); dimmed when disabled,
+// a soft rounded tint while pressed; a pull-down gets a small chevron after its glyph, the two centred together
+const char SFToolbarGlyphCellKey=0;
+
+-(void)_sfDrawToolbarGlyphWithFrame:(NSRect)frame inView:(NSView *)control {
+   NSImage *image=[self image];
+   BOOL     pullDown=[self isKindOfClass:[NSPopUpButtonCell class]] && [(NSPopUpButtonCell *)self pullsDown];
+   CGFloat  chevron=pullDown?7:0, gap=pullDown?4:0;
+   NSSize   size=image?[image size]:NSZeroSize;
+
+   if([self isHighlighted]){
+    NSRect pressed=NSInsetRect(frame,1,1);
+    CGFloat radius=MIN(NSWidth(pressed),NSHeight(pressed))/2;
+
+    [[NSColor colorWithCalibratedWhite:0 alpha:0.08] setFill];
+    [[NSBezierPath bezierPathWithRoundedRect:pressed xRadius:radius yRadius:radius] fill];
+   }
+   CGFloat groupWidth=size.width+gap+chevron;
+   NSRect  imageRect=NSMakeRect(floor(NSMidX(frame)-groupWidth/2),floor(NSMidY(frame)-size.height/2),size.width,size.height);
+   CGFloat alpha=[self isEnabled]?0.85:0.3;
+
+   if(image!=nil){
+    // (a template glyph is drawn as it is: the symbol drawings here are dark ink already)
+    [image drawInRect:imageRect fromRect:NSZeroRect operation:NSCompositeSourceOver fraction:alpha respectFlipped:YES hints:nil];
+   }
+   if(pullDown){
+    // a small down chevron, its stroke as heavy as the glyphs'
+    CGFloat x=NSMaxX(imageRect)+gap,y=NSMidY(frame),h=chevron/2;
+    BOOL    flipped=[control isFlipped];
+    NSBezierPath *path=[NSBezierPath bezierPath];
+
+    [path moveToPoint:NSMakePoint(x,y+(flipped?-h:h)/2)];
+    [path lineToPoint:NSMakePoint(x+chevron/2,y-(flipped?-h:h)/2)];
+    [path lineToPoint:NSMakePoint(x+chevron,y+(flipped?-h:h)/2)];
+    [path setLineWidth:1.4];
+    [path setLineCapStyle:NSRoundLineCapStyle];
+    [path setLineJoinStyle:NSRoundLineJoinStyle];
+    [[NSColor colorWithCalibratedWhite:0.12 alpha:alpha] setStroke];
+    [path stroke];
+   }
+}
+
 -(void)drawWithFrame:(NSRect)frame inView:(NSView *)control {
    _controlView=control;
 
