+/* The winding buffer: a count per sample of every column, 256 samples a column, so 2 MB for a window
+ * as wide as the screen. It was a fresh calloc each time a context was made, and a window gets a new
+ * context at every size it takes: while a window was resized each step faulted in and cleared 2 MB
+ * of new pages (a third of the time from the compositor's configure to the next frame). The buffer
+ * of a context that goes away is kept for the next one (a quarter larger than asked, so that a
+ * window that grows step by step keeps reusing it). The rasterizer
+ * leaves every count it used at zero (O2DContextFillEdgesOnSurface clears each as it reads it),
+ * so a kept buffer needs no clearing but for the spare count past the last column. */
+static pthread_mutex_t sfWindingLock=PTHREAD_MUTEX_INITIALIZER;
+static int *sfWindingKept;
+
+// two words before the counts: the capacity, and how many the context that has the buffer uses
+static int *sfWindingTake(size_t count){
+   int *base=NULL;
+
+   pthread_mutex_lock(&sfWindingLock);
+   if(sfWindingKept!=NULL && (size_t)sfWindingKept[-2]>=count){
+    base=sfWindingKept-2;
+    sfWindingKept=NULL;
+   }
+   pthread_mutex_unlock(&sfWindingLock);
+   if(base==NULL){
+    size_t capacity=count+count/4;
+    if((base=calloc(capacity+2,sizeof(int)))!=NULL)
+     base[0]=(int)capacity;
+   }
+   if(base==NULL)
+    return NULL;
+   base[1]=(int)count;
+   return base+2;
+}
+
+static void sfWindingGive(int *winding){
+   if(winding==NULL)
+    return;
+   // the spare count past the last column may hold what an edge left there
+   winding[winding[-1]-1]=0;
+   pthread_mutex_lock(&sfWindingLock);
+   if(sfWindingKept==NULL || sfWindingKept[-2]<winding[-2]){
+    int *old=sfWindingKept;
+    sfWindingKept=winding;
+    winding=old;
+   }
+   pthread_mutex_unlock(&sfWindingLock);
+   if(winding!=NULL)
+    free(winding-2);
+}
