+// (FXLEAD) an IOSurface shown as a layer's contents is in use, as the window server marks the surfaces it shows on
+// macOS: a producer that recycles surfaces it believes unused (Firefox's tile surface pool asks IOSurfaceIsInUse)
+// must not draw into one this process still shows. Taken when the surface becomes contents, given back when it
+// stops being contents or the layer goes. IOSurface is found at run time; QuartzCore keeps no link to it.
+static struct { CFTypeID (*typeID)(void); void (*increment)(CFTypeRef),(*decrement)(CFTypeRef); Class cf; } layerSurfaces;
+static void loadLayerSurfaces(void){
+   layerSurfaces.typeID=dlsym(RTLD_DEFAULT,"IOSurfaceGetTypeID");
+   layerSurfaces.increment=dlsym(RTLD_DEFAULT,"IOSurfaceIncrementUseCount");
+   layerSurfaces.decrement=dlsym(RTLD_DEFAULT,"IOSurfaceDecrementUseCount");
+   layerSurfaces.cf=objc_getClass("__NSCFType");
+}
+static BOOL contentsIsUsedSurface(id value){
+   static pthread_once_t once=PTHREAD_ONCE_INIT;
+   if(value==nil)
+    return NO;
+   pthread_once(&once,loadLayerSurfaces);
+   return layerSurfaces.typeID!=NULL && layerSurfaces.increment!=NULL && layerSurfaces.decrement!=NULL &&
+          layerSurfaces.cf!=Nil && [value isKindOfClass:layerSurfaces.cf] && CFGetTypeID((CFTypeRef)value)==layerSurfaces.typeID();
+}
+static void swapContents(id *slot,id value){
+   if(contentsIsUsedSurface(value))
+    layerSurfaces.increment((CFTypeRef)value);
+   id old=lockedSwap(slot,[value retain]);
+   if(contentsIsUsedSurface(old))
+    layerSurfaces.decrement((CFTypeRef)old);
+   [old release];
+}
