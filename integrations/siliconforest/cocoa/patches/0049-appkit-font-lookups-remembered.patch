 -(NSFont *)_bestFontForCharacter:(unichar)c userFont:(NSFont *)font {
+    // remembered per font and character: a menu draws its shortcut glyphs (Command, Shift), which
+    // the system face lacks, at every opening (a quarter of its time went to finding them again)
+    static NSMutableDictionary *found = nil;
+    NSString *key = [NSString stringWithFormat:@"%@/%g/%u", [font fontName], (double)[font pointSize], (unsigned)c];
+    id known;
+
+    if (found == nil)
+        found = [[NSMutableDictionary alloc] init];
+    known = [found objectForKey:key];
+    if (known != nil)
+        return known == [NSNull null] ? nil : known;
+    known = [self _sfSearchBestFontForCharacter:c userFont:font];
+    [found setObject:known != nil ? known : (id)[NSNull null] forKey:key];
+    return known;
+}
