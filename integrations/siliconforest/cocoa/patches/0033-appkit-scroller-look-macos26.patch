+ * buttons. Not measured against a Mac: a scroller is shown there only while scrolling. */
 -(NSRect)rectForPart:(NSScrollerPart)part {
+   NSScrollArrowPosition position=_arrowsPosition;
+   NSRect result;
+
+   if(SFControlLookIs26())
+    _arrowsPosition=NSScrollerArrowsNone;
+   result=[self _sfRectForPart:part];
+   _arrowsPosition=position;
+   return result;
+}
