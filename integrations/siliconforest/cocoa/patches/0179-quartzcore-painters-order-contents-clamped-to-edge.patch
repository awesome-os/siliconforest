+/* (TERM12) Core Animation draws a layer's sublayers in order, those with a greater zPosition later (painter's order).
+ * The renderer drew each sublayer "a step nearer than its parent" with the depth test on, so a later sibling was hidden
+ * wherever an earlier sibling's deeper-nested layers had drawn: Firefox's position:fixed layer under the page's tiles
+ * when those sat under clip layers (pages with rounded or rotated boxes) */
+static int sfcaOldOrder(void){
+   static int old=-1;
+   if(old<0)old=getenv("SF_CA_OLD_ORDER")!=NULL;
+   return old;
+}
+
+static NSArray *sublayersInPaintOrder(CALayer *layer) {
+   NSArray *sublayers=layer.sublayers;
+   BOOL ordered=YES;
+
+   if(sfcaOldOrder())
+    return sublayers;
+   for(CALayer *child in sublayers)
+    if(child.zPosition!=0){
+     ordered=NO;
+     break;
+    }
+   if(ordered)
+    return sublayers;
+   // a stable insertion sort: equal zPositions keep their order
+   NSUInteger count=[sublayers count];
+   CALayer *sorted[count];
+   CGFloat keys[count];
+
+   for(NSUInteger i=0;i<count;i++){
+    CALayer *child=[sublayers objectAtIndex:i];
+    CGFloat key=child.zPosition;
+    NSUInteger j=i;
+
+    while(j>0 && keys[j-1]>key){
+     sorted[j]=sorted[j-1];
+     keys[j]=keys[j-1];
+     j--;
+    }
+    sorted[j]=child;
+    keys[j]=key;
+   }
+   return [NSArray arrayWithObjects:sorted count:count];
+}
