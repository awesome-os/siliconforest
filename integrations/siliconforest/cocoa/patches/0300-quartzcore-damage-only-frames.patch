+    long area=sfdBoxIsEmpty(damage) ? 0 : (long)(damage[2]-damage[0])*(damage[3]-damage[1]);
+
+    if(frames++%30==0)
+     fprintf(stderr,"SFFXDAMAGE frame=%lu layers=%u box=%d,%d,%d,%d area=%ld of %ld\n",frames,now->count,damage[0],damage[1],
+             damage[2],damage[3],area,(long)w.viewport[2]*w.viewport[3]);
+   }
+   return !sfdBoxIsEmpty(damage);
+}
