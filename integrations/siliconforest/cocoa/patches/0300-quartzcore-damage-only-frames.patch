+      }
+     }
+    }
+    for(unsigned i=0;i<before->count;i++)
+     if(!before->r[i].matched){
+      sfdBoxUnion(damage,before->r[i].box);
+      removed++;
+     }
+    if(sfdTrace()){
+     static unsigned long diffs;
+
+     if(diffs++%30==0)
+      fprintf(stderr,"SFFXDAMAGE-WHY layers=%u added=%u removed=%u changed=%u order=%u depth=%u matrix=%u clip=%u contents=%u look=%u extra=%u biggest=%d,%d,%d,%d\n",
+              now->count,added,removed,changed,why[SFD_ORDER],why[SFD_DEPTH],why[SFD_MATRIX],why[SFD_CLIP],why[SFD_CONTENTS],why[SFD_LOOK],why[SFD_EXTRA],
