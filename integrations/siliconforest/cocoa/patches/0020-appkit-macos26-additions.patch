+@implementation NSFont (CoreTextTwin)
+// On macOS an NSFont is a CTFont (toll-free bridged) and applications hand one to CoreText. Here
+// they are two classes: an NSFont given to CoreText passes what it does not answer itself to a
+// CTFont of the same name and size.
+- (id)_sfCoreTextTwin
+{
+    id twin = objc_getAssociatedObject(self, &SFFontTwinKey);
+    if (twin == nil) {
+        twin = (id)CTFontCreateWithName((CFStringRef)[self fontName], [self pointSize], NULL);
+        if (twin != nil) { objc_setAssociatedObject(self, &SFFontTwinKey, twin, OBJC_ASSOCIATION_RETAIN); CFRelease((CFTypeRef)twin); }
+    }
+    return twin;
+}
+- (id)forwardingTargetForSelector:(SEL)selector
+{
+    id twin = [self _sfCoreTextTwin];
+    return (twin != nil && twin != self && [twin respondsToSelector:selector]) ? twin : nil;
+}
+@end
