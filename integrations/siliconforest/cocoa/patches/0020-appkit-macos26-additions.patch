+// ---- NSWindowTab: what a window shows of itself in a tab bar. There is no tab bar; the object
+// keeps what the application sets (title, tool tip, accessory view).
+@interface NSWindowTab : NSObject {
+    NSString *_title, *_toolTip; NSAttributedString *_attributedTitle; NSView *_accessoryView;
+}
+@property(copy) NSString *title;
+@property(copy) NSAttributedString *attributedTitle;
+@property(copy) NSString *toolTip;
+@property(retain) NSView *accessoryView;
+@end
+@implementation NSWindowTab
+@synthesize title = _title, attributedTitle = _attributedTitle, toolTip = _toolTip, accessoryView = _accessoryView;
+- (void)dealloc { [_title release]; [_attributedTitle release]; [_toolTip release]; [_accessoryView release]; [super dealloc]; }
+SF_TOLERANT
+@end
+
+static char SFWindowTabKey;
+@implementation NSWindow (WindowTab)
+- (NSWindowTab *)tab
+{
+    NSWindowTab *tab = objc_getAssociatedObject(self, &SFWindowTabKey);
+    if (tab == nil) {
+        tab = [[NSWindowTab new] autorelease];
+        objc_setAssociatedObject(self, &SFWindowTabKey, tab, OBJC_ASSOCIATION_RETAIN);
+    }
+    return tab;
+}
+@end
