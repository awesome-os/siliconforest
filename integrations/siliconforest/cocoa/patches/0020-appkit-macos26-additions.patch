+@synthesize delaysOtherMouseButtonEvents = _delaysOtherMouseButtonEvents;
+- (instancetype)initWithTarget:(id)target action:(SEL)action
+{
+    if ((self = [super init])) { _target = target; _action = action; _enabled = YES; }
+    return self;
+}
+- (instancetype)init { return [self initWithTarget:nil action:NULL]; }
+- (instancetype)initWithCoder:(NSCoder *)coder { return [self initWithTarget:nil action:NULL]; }
