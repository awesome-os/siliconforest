+@implementation NSView (NSGestureRecognizers)
+- (NSArray *)gestureRecognizers
+{
+    NSArray *list = objc_getAssociatedObject(self, &SFGestureRecognizersKey);
+    return list ? list : [NSArray array];
+}
+- (void)addGestureRecognizer:(NSGestureRecognizer *)recognizer
+{
+    if (recognizer == nil) return;
+    NSMutableArray *list = objc_getAssociatedObject(self, &SFGestureRecognizersKey);
+    if (list == nil) { list = [NSMutableArray array]; objc_setAssociatedObject(self, &SFGestureRecognizersKey, list, OBJC_ASSOCIATION_RETAIN); }
+    if (![list containsObject:recognizer]) { [list addObject:recognizer]; [recognizer _sfSetView:self]; }
+}
+- (void)removeGestureRecognizer:(NSGestureRecognizer *)recognizer
+{
+    NSMutableArray *list = objc_getAssociatedObject(self, &SFGestureRecognizersKey);
+    if ([list containsObject:recognizer]) { [recognizer _sfSetView:nil]; [list removeObject:recognizer]; }
+}
+@end
