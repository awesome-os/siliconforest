+void NSAccessibilityRaiseBadArgumentException(id element, NSString *attribute, id value)
+{
+    [NSException raise:@"NSAccessibilityException" format:@"bad argument %@ for attribute %@ of %@", value, attribute, element];
+}
+
+NSString *NSAccessibilityRoleDescriptionForUIElement(id element)
+{
+    NSString *role = nil, *subrole = nil;
+    @try {
+        if ([element respondsToSelector:@selector(accessibilityAttributeValue:)]) {
+            role = [element accessibilityAttributeValue:NSAccessibilityRoleAttribute];
+            subrole = [element accessibilityAttributeValue:NSAccessibilitySubroleAttribute];
+        }
+    } @catch (id e) { }
+    return role ? NSAccessibilityRoleDescription(role, subrole) : nil;
+}
+
+static BOOL SFAccessibilityIgnored(id element)
+{
+    return [element respondsToSelector:@selector(accessibilityIsIgnored)] && [element accessibilityIsIgnored];
+}
+
+id NSAccessibilityUnignoredDescendant(id element)
+{
+    for (int depth = 0; element != nil && depth < 64 && SFAccessibilityIgnored(element); depth++) {
+        NSArray *children = nil;
+        @try { children = [element accessibilityAttributeValue:NSAccessibilityChildrenAttribute]; } @catch (id e) { }
+        element = [children count] ? [children objectAtIndex:0] : nil;
+    }
+    return element;
+}
+
+NSArray *NSAccessibilityUnignoredChildrenForOnlyChild(id child)
+{
+    id found = NSAccessibilityUnignoredDescendant(child);
+    return found ? [NSArray arrayWithObject:found] : [NSArray array];
+}
