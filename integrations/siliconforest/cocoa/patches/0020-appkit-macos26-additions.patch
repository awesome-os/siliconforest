+// Gesture recognizers hold their target, action and configuration. Nothing feeds them events
+// yet (the trackpad's force and long presses do not reach AppKit), so they stay "possible".
+@interface NSGestureRecognizer : NSObject <NSCoding> {
+    id _target; SEL _action; id _delegate; NSView *_view; BOOL _enabled;
+    BOOL _delaysPrimaryMouseButtonEvents, _delaysSecondaryMouseButtonEvents, _delaysOtherMouseButtonEvents;
+}
+- (instancetype)initWithTarget:(id)target action:(SEL)action;
+@property(assign) id target;
+@property SEL action;
+@property(assign) id delegate;
+@property(getter=isEnabled) BOOL enabled;
+@property(readonly) NSGestureRecognizerState state;
+@property(readonly) NSView *view;
+@property BOOL delaysPrimaryMouseButtonEvents;
+@property BOOL delaysSecondaryMouseButtonEvents;
+@property BOOL delaysOtherMouseButtonEvents;
+- (NSPoint)locationInView:(NSView *)view;
+@end
