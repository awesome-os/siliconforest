+// ---- a private class that answers nothing to what it does not implement
+static void SFTolerantLog(id object, SEL selector)
+{
+    static NSMutableSet *seen;
+    @synchronized([NSApplication class]) {
+        if (seen == nil) seen = [NSMutableSet new];
+        NSString *key = [NSString stringWithFormat:@"%s %s", object_getClassName(object), sel_getName(selector)];
+        if ([seen containsObject:key]) return;
+        [seen addObject:key];
+        NSLog(@"AppKit: -[%@] is not implemented on this system (answers nothing)", key);
+    }
+}
+#define SF_TOLERANT \
+- (NSMethodSignature *)methodSignatureForSelector:(SEL)selector { \
+    NSMethodSignature *s = [super methodSignatureForSelector:selector]; \
+    if (s == nil) { SFTolerantLog(self, selector); s = [NSMethodSignature signatureWithObjCTypes:"@@:"]; } \
+    return s; } \
+- (void)forwardInvocation:(NSInvocation *)invocation { id none = nil; if ([[invocation methodSignature] methodReturnLength] == sizeof(id)) [invocation setReturnValue:&none]; } \
++ (NSMethodSignature *)methodSignatureForSelector:(SEL)selector { \
+    NSMethodSignature *s = [super methodSignatureForSelector:selector]; \
+    if (s == nil) { SFTolerantLog(self, selector); s = [NSMethodSignature signatureWithObjCTypes:"@@:"]; } \
+    return s; } \
++ (void)forwardInvocation:(NSInvocation *)invocation { id none = nil; if ([[invocation methodSignature] methodReturnLength] == sizeof(id)) [invocation setReturnValue:&none]; }
