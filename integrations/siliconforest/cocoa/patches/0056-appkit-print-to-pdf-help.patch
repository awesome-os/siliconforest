+/* The print panel. There is no printing system: what is printed can be saved as a PDF file, the
+ * way macOS's print panel offers it (PDF > Save as PDF). The operation draws its pages into the PDF
+ * context left in the dictionary (NSPrintOperation -createContext, "_KGContext") and closes it. */
 -(int)runModalPrintPanelWithPrintInfoDictionary:(NSMutableDictionary *)attributes {
-   return NSCancelButton;
+   NSString *title=[attributes objectForKey:@"_title"];
+   NSAlert  *alert=[[[NSAlert alloc] init] autorelease];
+
+   [alert setMessageText:NSLocalizedStringFromTableInBundle(@"There are no printers.", nil, [NSBundle bundleForClass:[NSDisplay class]], @"print panel")];
+   [alert setInformativeText:NSLocalizedStringFromTableInBundle(@"What you print can be saved as a PDF file.", nil, [NSBundle bundleForClass:[NSDisplay class]], @"print panel")];
+   [alert addButtonWithTitle:NSLocalizedStringFromTableInBundle(@"Save as PDF\u2026", nil, [NSBundle bundleForClass:[NSDisplay class]], @"print panel")];
+   [alert addButtonWithTitle:NSLocalizedStringFromTableInBundle(@"Cancel", nil, [NSBundle bundleForClass:[NSDisplay class]], @"print panel")];
+   if([alert runModal]!=NSAlertFirstButtonReturn)
+    return NSCancelButton;
+
+   NSSavePanel *save=[NSSavePanel savePanel];
+   NSString    *name=[[title length] ? title : @"Untitled" stringByReplacingOccurrencesOfString:@"/" withString:@"-"];
+
+   [save setAllowedFileTypes:[NSArray arrayWithObject:@"pdf"]];
+   [save setNameFieldStringValue:[name stringByAppendingPathExtension:@"pdf"]];
+   if([save runModal]!=NSOKButton)
+    return NSCancelButton;
+
+   NSSize            paper=[[attributes objectForKey:NSPrintPaperSize] sizeValue];
+   CGRect            media=CGRectMake(0,0,paper.width>0 ? paper.width : 612,paper.height>0 ? paper.height : 792);
+   CGDataConsumerRef consumer=CGDataConsumerCreateWithURL((CFURLRef)[save URL]);
+   CGContextRef      context=consumer ? CGPDFContextCreate(consumer,&media,NULL) : NULL;
+
+   if(consumer)
+    CGDataConsumerRelease(consumer);
+   if(context==NULL)
+    return NSCancelButton;
+   [attributes setObject:(id)context forKey:@"_KGContext"];
+   CGContextRelease(context);
+   [attributes setObject:NSPrintSaveJob forKey:NSPrintJobDisposition];
+   [attributes setObject:[[save URL] path] forKey:NSPrintSavePath];
+   return NSOKButton;
 }
 
