+/* The font bindings of a cell (macOS 10.4): fontBold, fontItalic, fontName, fontFamilyName, fontSize
+ * change the cell's font. Terminal's inspector binds fontBold of its process list to the frontmost
+ * process; the cell had no such key and every redraw raised. */
+#import <AppKit/NSCell.h>
+#import <AppKit/NSFont.h>
+#import <AppKit/NSFontManager.h>
+
+@implementation NSCell (SFFontBindings)
+
+- (id)fontBold { return [NSNumber numberWithBool:([[NSFontManager sharedFontManager] traitsOfFont:[self font]] & NSBoldFontMask) != 0]; }
+- (void)setFontBold:(id)value
+{
+    NSFont *font = [self font];
+    if (font == nil)
+        return;
+    font = [value boolValue] ? [[NSFontManager sharedFontManager] convertFont:font toHaveTrait:NSBoldFontMask]
+                             : [[NSFontManager sharedFontManager] convertFont:font toNotHaveTrait:NSBoldFontMask];
+    if (font != nil)
+        [self setFont:font];
+}
+- (id)fontItalic { return [NSNumber numberWithBool:([[NSFontManager sharedFontManager] traitsOfFont:[self font]] & NSItalicFontMask) != 0]; }
+- (void)setFontItalic:(id)value
+{
+    NSFont *font = [self font];
+    if (font == nil)
+        return;
+    font = [value boolValue] ? [[NSFontManager sharedFontManager] convertFont:font toHaveTrait:NSItalicFontMask]
+                             : [[NSFontManager sharedFontManager] convertFont:font toNotHaveTrait:NSItalicFontMask];
+    if (font != nil)
+        [self setFont:font];
+}
+- (id)fontName { return [[self font] fontName]; }
+- (void)setFontName:(id)value
+{
+    NSFont *font = [value isKindOfClass:[NSString class]] ? [NSFont fontWithName:value size:[[self font] pointSize]] : nil;
+    if (font != nil)
+        [self setFont:font];
+}
+- (id)fontSize { return [NSNumber numberWithDouble:[[self font] pointSize]]; }
+- (void)setFontSize:(id)value
+{
+    NSFont *font = [self font] && [value respondsToSelector:@selector(doubleValue)] ? [NSFont fontWithName:[[self font] fontName] size:[value doubleValue]] : nil;
+    if (font != nil)
+        [self setFont:font];
+}
+
+@end
