+/* A column that is hidden (macOS 10.5): Terminal's inspector hides some of its table's columns.
+ * Where the table has no hidden columns of its own a hidden column is one of width 0, and showing it
+ * again gives it back its width. Added only where NSTableColumn has no -isHidden (a table that lays
+ * out hidden columns brings its own). */
+#import <AppKit/NSTableColumn.h>
+#include <objc/runtime.h>
+
+static char SFColumnHiddenKey;
+
+static BOOL sfColumnIsHidden(id self, SEL _cmd)
+{
+    return objc_getAssociatedObject(self, &SFColumnHiddenKey) != nil;
+}
+
+static void sfColumnSetHidden(id self, SEL _cmd, BOOL hidden)
+{
+    NSNumber *width = objc_getAssociatedObject(self, &SFColumnHiddenKey);
+
+    if (hidden == (width != nil))
+        return;
+    if (hidden) {
+        objc_setAssociatedObject(self, &SFColumnHiddenKey, [NSNumber numberWithDouble:[self width]], OBJC_ASSOCIATION_RETAIN);
+        [self setMinWidth:0];
+        [self setWidth:0];
+    }
+    else {
+        objc_setAssociatedObject(self, &SFColumnHiddenKey, nil, OBJC_ASSOCIATION_RETAIN);
+        [self setWidth:[width doubleValue]];
+    }
+}
+
+@interface SFHiddenColumnsInstaller : NSObject
+@end
+
+@implementation SFHiddenColumnsInstaller
+
++ (void)load
+{
+    Class column = [NSTableColumn class];
+
+    if (!class_getInstanceMethod(column, @selector(isHidden)))
+        class_addMethod(column, @selector(isHidden), (IMP)sfColumnIsHidden, "c@:");
+    if (!class_getInstanceMethod(column, @selector(setHidden:)))
+        class_addMethod(column, @selector(setHidden:), (IMP)sfColumnSetHidden, "v@:c");
+}
+
+@end
