 	int bpr = O2ImageGetBytesPerRow(image);
 	png_bytep *row_pointers = calloc(sizeof(void *), height);
 	const uint8_t *bytes = [image directBytes];
+	// the byte order the pixels are really in: "default" is not the host's order for 8 bit
+	// components, it is the components in sequence (as O2Surface and O2Image read it)
+	O2BitmapInfo bitmapInfo = O2BitmapInfoResolveDefaultByteOrder(O2ImageGetBitmapInfo(image), O2ImageGetBitsPerComponent(image));
+	O2ImageAlphaInfo alphaInfo = bitmapInfo & kO2BitmapAlphaInfoMask;
+	uint8_t *straight = NULL;
+
+	/* PNG stores colour that is not multiplied by its alpha. A bitmap context's pixels are
+	 * (kO2ImageAlphaPremultipliedLast or First), so they are divided out into a copy; written
+	 * as they were, everything translucent came out darker than it was drawn. */
+	if ((alphaInfo == kO2ImageAlphaPremultipliedLast || alphaInfo == kO2ImageAlphaPremultipliedFirst) &&
+		O2ImageGetBitsPerPixel(image) == 32 && O2ImageGetBitsPerComponent(image) == 8 && bytes != NULL) {
+		BOOL little = (bitmapInfo & kO2BitmapByteOrderMask) == kO2BitmapByteOrder32Little;
+		// where the alpha byte is in memory: last for RGBA and for BGRA (alpha first, little endian)
+		int alphaAt = ((alphaInfo == kO2ImageAlphaPremultipliedLast) != little) ? 3 : 0;
+
+		straight = malloc((size_t)bpr * height);
+		memcpy(straight, bytes, (size_t)bpr * height);
+		for (size_t y = 0; y < height; y++) {
+			uint8_t *p = straight + y * bpr;
+
+			for (size_t x = 0; x < width; x++, p += 4) {
+				unsigned a = p[alphaAt];
+
+				if (a == 0 || a == 255)
+					continue;
+				for (int k = 0; k < 4; k++) {
+					if (k != alphaAt) {
+						unsigned v = (p[k] * 255u + a / 2) / a;
+
+						p[k] = v > 255 ? 255 : v;
+					}
+				}
+			}
+		}
+		bytes = straight;
+	}
