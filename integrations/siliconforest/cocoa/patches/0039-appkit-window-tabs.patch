+#pragma mark the Window menu's tab commands
+
+/* As on macOS, where AppKit adds them to an application's Window menu when its windows can be
+ * tabbed: Show Previous Tab (Command-Shift-[), Show Next Tab (Command-Shift-]), Move Tab to New
+ * Window, Merge All Windows, after Zoom. Not where the application has them itself or turned
+ * automatic tabbing off (+[NSWindow allowsAutomaticWindowTabbing]). */
+@interface SFTabMenuItems : NSObject
+@end
+
+@implementation SFTabMenuItems
+
++ (void)load
+{
+    [[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(_sfInstall:)
+                                                 name:NSApplicationDidFinishLaunchingNotification object:nil];
+}
+
++ (void)_sfInstall:(NSNotification *)note
+{
+    NSMenu *menu = [NSApp windowsMenu];
+
+    if (menu == nil || ![NSWindow allowsAutomaticWindowTabbing] || [menu indexOfItemWithTarget:nil andAction:@selector(selectNextTab:)] >= 0)
+        return;
+    NSInteger at = [menu indexOfItemWithTarget:nil andAction:@selector(performZoom:)];
+
+    if (at < 0)
+        at = [menu indexOfItemWithTarget:nil andAction:@selector(zoom:)];
+    at = at < 0 ? [menu numberOfItems] : at + 1;
+    struct { NSString *title; SEL action; NSString *key; } items[] = {
+        { @"Show Previous Tab", @selector(selectPreviousTab:), @"{" },
+        { @"Show Next Tab", @selector(selectNextTab:), @"}" },
+        { @"Move Tab to New Window", @selector(moveTabToNewWindow:), @"" },
+        { @"Merge All Windows", @selector(mergeAllWindows:), @"" },
+    };
+    [menu insertItem:[NSMenuItem separatorItem] atIndex:at++];
+    for (unsigned i = 0; i < sizeof(items) / sizeof(items[0]); i++) {
+        NSMenuItem *item = [[[NSMenuItem alloc] initWithTitle:items[i].title action:items[i].action keyEquivalent:items[i].key] autorelease];
+
+        // "{" and "}" are typed with shift: the menu counts that shift as part of the symbol
+        [menu insertItem:item atIndex:at++];
+    }
+}
+
+@end
