+#pragma mark NSWindowTabGroup
+
+// while a tab hands the toplevel over, ordering windows in and out is the hand-over's own
+static int sfTabSwitching;
+
+@interface NSWindowTabGroup : NSObject {
+    NSString *_identifier;
+    NSMutableArray *_windows;   // not retained: windows own their groups
+    NSWindow *_selected;        // not retained
+    BOOL _overviewVisible, _barShownAlone;
+}
+- (void)_sfUpdateBars;
+@end
+
+@implementation NSWindowTabGroup
+
+- (instancetype)_sfInitWithIdentifier:(NSString *)identifier
+{
+    if ((self = [super init])) {
+        _identifier = [identifier copy];
+        _windows = (NSMutableArray *)CFArrayCreateMutable(NULL, 0, NULL);
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    [_identifier release];
+    [_windows release];
+    [super dealloc];
+}
+
+- (NSString *)identifier { return _identifier; }
+- (NSArray *)windows { return [[_windows copy] autorelease]; }
+- (BOOL)isOverviewVisible { return _overviewVisible; }
+- (void)setOverviewVisible:(BOOL)visible { _overviewVisible = visible; }
+- (BOOL)isTabBarVisible { return [_windows count] > 1 || _barShownAlone; }
+- (void)_sfToggleBar { _barShownAlone = !_barShownAlone; [self _sfUpdateBars]; }
+- (NSWindow *)selectedWindow { return _selected; }
+
+// every window of the group shows the bar (or not) and draws it again
+- (void)_sfUpdateBars
+{
+    for (NSWindow *window in [self windows])
+        [window _sfUpdateTabBar];
+}
+
+/* Shows WINDOW in the toplevel of the tab shown now: the same frame, the WindowServer's records
+ * exchange identities, the tab shown before is ordered out and the new one in, with the key status. */
+- (void)setSelectedWindow:(NSWindow *)window
+{
+    if (window == nil || ![_windows containsObject:window])
+        return;
+    NSWindow *shown = _selected;
+
+    _selected = window;
+    [self _sfUpdateBars];
+    if (shown == nil || shown == window || ![shown isVisible] || [window isVisible])
+        return;
+
+    BOOL key = [shown isKeyWindow] || [NSApp keyWindow] == nil;
+
+    sfTabSwitching++;
+    [window setFrame:[shown frame] display:NO];
+    struct wsRPCWindow take = {
+        { kWSWindowTakeToplevel, sizeof(struct wsRPCWindow) - sizeof(struct wsRPCBase) },
+        (int)[window windowNumber], 0, 0, 0, 0, 0, (int)[shown windowNumber], {'\0'}, 0
+    };
+    BOOL taken = _windowServerRPC(&take, sizeof(take), NULL, NULL) == KERN_SUCCESS;
+
+    [shown orderOut:nil];
+    if (key)
+        [window makeKeyAndOrderFront:nil];
+    else
+        [window orderFront:nil];
+    sfTabSwitching--;
+    if (!taken)
+        NSLog(@"AppKit: tab: the WindowServer did not hand the toplevel over (the tab is a window of its own)");
+    [window display];
+}
+
+- (void)_sfAttach:(NSWindow *)window
+{
+    NSWindowTabGroup *old = objc_getAssociatedObject(window, &SFTabGroupKey);
+
+    if (old != nil && old != self)
+        [old removeWindow:window];
+    objc_setAssociatedObject(window, &SFTabGroupKey, self, OBJC_ASSOCIATION_RETAIN);
+}
+
+- (void)insertWindow:(NSWindow *)window atIndex:(NSInteger)index
+{
+    if (window == nil || [_windows containsObject:window])
+        return;
+    [self retain];
+    [self _sfAttach:window];
+    [_windows insertObject:window atIndex:(NSUInteger)MAX(0, MIN(index, (NSInteger)[_windows count]))];
+    if (_selected == nil)
+        _selected = window;
+    // a window that was on screen on its own becomes a tab: it leaves the screen unless it is shown
+    if (window != _selected && [window isVisible] && [_selected isVisible]) {
+        sfTabSwitching++;
+        [window orderOut:nil];
+        sfTabSwitching--;
+    }
+    if (window != _selected && [_selected isVisible])
+        [window setFrame:[_selected frame] display:NO];
+    [self _sfUpdateBars];
+    [self release];
+}
+
+- (void)addWindow:(NSWindow *)window
+{
+    [self insertWindow:window atIndex:(NSInteger)[_windows count]];
+}
+
+/* A window leaves the group (closed, or moved to a window of its own); the tab beside it is
+ * selected if it was. */
+- (void)removeWindow:(NSWindow *)window
+{
+    NSUInteger i = [_windows indexOfObject:window];
+
+    if (i == NSNotFound)
+        return;
+    [self retain];
+    BOOL wasSelected = _selected == window;
+    [_windows removeObjectAtIndex:i];
+    if (wasSelected)
+        _selected = [_windows count] ? [_windows objectAtIndex:MIN(i, [_windows count] - 1)] : nil;
+    if (objc_getAssociatedObject(window, &SFTabGroupKey) == self)
+        objc_setAssociatedObject(window, &SFTabGroupKey, nil, OBJC_ASSOCIATION_RETAIN);
+    [window _sfUpdateTabBar];
+    [self _sfUpdateBars];
+    [self release];
+}
+
+@end
+
+#pragma mark the tab bar
+
+@interface SFTabBarView : NSView {
+    NSInteger _hover, _hoverClose;
+    NSTrackingArea *_tracking;
+}
+@end
+
+@implementation SFTabBarView
+
+static const CGFloat SFTabBarHeight = 28, SFTabPlusWidth = 28, SFTabCloseSize = 16;
+
+- (instancetype)initWithFrame:(NSRect)frame
+{
+    if ((self = [super initWithFrame:frame]))
+        _hover = _hoverClose = -1;
+    return self;
+}
+
+- (void)dealloc
+{
+    [_tracking release];
+    [super dealloc];
+}
+
+- (BOOL)isOpaque { return YES; }
+- (BOOL)acceptsFirstMouse:(NSEvent *)event { return YES; }
+
+- (NSArray *)_windows
+{
+    NSWindowTabGroup *group = objc_getAssociatedObject([self window], &SFTabGroupKey);
+
+    return group ? [group windows] : ([self window] ? @[ [self window] ] : @[]);
+}
+
+- (NSRect)_tabRect:(NSUInteger)index of:(NSUInteger)count
+{
+    NSRect bounds = [self bounds];
+    CGFloat width = (NSWidth(bounds) - SFTabPlusWidth) / (count ? count : 1);
+
+    return NSMakeRect(floor(index * width), 0, floor((index + 1) * width) - floor(index * width), NSHeight(bounds));
+}
+
+- (NSRect)_closeRectIn:(NSRect)tab
+{
+    return NSMakeRect(NSMinX(tab) + 8, NSMidY(tab) - SFTabCloseSize / 2, SFTabCloseSize, SFTabCloseSize);
+}
+
+- (NSRect)_plusRect
+{
+    NSRect bounds = [self bounds];
+
+    return NSMakeRect(NSMaxX(bounds) - SFTabPlusWidth, 0, SFTabPlusWidth, NSHeight(bounds));
+}
+
+- (void)drawRect:(NSRect)rect
+{
+    BOOL dark = [[NSAppearance currentDrawingAppearance] _isDark];
+    NSRect bounds = [self bounds];
+    NSArray *windows = [self _windows];
+    NSWindowTabGroup *group = objc_getAssociatedObject([self window], &SFTabGroupKey);
+    NSWindow *selected = group ? [group selectedWindow] : [self window];
+    NSUInteger count = [windows count];
+    NSColor *ground = dark ? [NSColor colorWithCalibratedWhite:0.11 alpha:1] : [NSColor colorWithCalibratedWhite:0.86 alpha:1];
+    NSColor *chosen = dark ? [NSColor colorWithCalibratedWhite:0.20 alpha:1] : [NSColor colorWithCalibratedWhite:0.97 alpha:1];
+    NSColor *line = [NSColor colorWithCalibratedWhite:0 alpha:dark ? 0.6 : 0.18];
+    NSColor *text = dark ? [NSColor colorWithCalibratedWhite:0.92 alpha:1] : [NSColor colorWithCalibratedWhite:0.12 alpha:1];
+    NSColor *dim = dark ? [NSColor colorWithCalibratedWhite:0.62 alpha:1] : [NSColor colorWithCalibratedWhite:0.38 alpha:1];
+    NSMutableParagraphStyle *style = [[[NSMutableParagraphStyle alloc] init] autorelease];
+
+    [style setAlignment:NSCenterTextAlignment];
+    [style setLineBreakMode:NSLineBreakByTruncatingMiddle];
+    [ground setFill];
+    NSRectFill(rect);
+    for (NSUInteger i = 0; i < count; i++) {
+        NSWindow *window = [windows objectAtIndex:i];
+        NSRect tab = [self _tabRect:i of:count];
+        BOOL isSelected = window == selected;
+
+        if (isSelected) {
+            [chosen setFill];
+            NSRectFill(tab);
+        }
+        else if ((NSInteger)i == _hover) {
+            [[NSColor colorWithCalibratedWhite:dark ? 1 : 0 alpha:0.05] setFill];
+            NSRectFillUsingOperation(tab, NSCompositeSourceOver);
+        }
+        // a hairline between tabs
+        if (i > 0) {
+            [line setFill];
+            NSRectFillUsingOperation(NSMakeRect(NSMinX(tab), NSMinY(tab) + 5, 1, NSHeight(tab) - 10), NSCompositeSourceOver);
+        }
+        NSString *title = [[window tab] title];
+        NSDictionary *attributes = @{ NSFontAttributeName: [NSFont systemFontOfSize:12],
+                                      NSForegroundColorAttributeName: isSelected ? text : dim,
+                                      NSParagraphStyleAttributeName: style };
+        NSRect titleRect = NSInsetRect(tab, 30, 0);
+        NSSize size = [title sizeWithAttributes:attributes];
+
+        titleRect.origin.y = floor(NSMidY(tab) - size.height / 2);
+        titleRect.size.height = ceil(size.height);
+        [title drawInRect:titleRect withAttributes:attributes];
+        // the close mark, on every tab (macOS shows it under the pointer)
+        if (count > 1) {
+            NSRect close = [self _closeRectIn:tab];
+            NSBezierPath *x = [NSBezierPath bezierPath];
+
+            if ((NSInteger)i == _hoverClose) {
+                [[NSColor colorWithCalibratedWhite:dark ? 1 : 0 alpha:0.12] setFill];
+                [[NSBezierPath bezierPathWithRoundedRect:close xRadius:3 yRadius:3] fill];
+            }
+            [x moveToPoint:NSMakePoint(NSMinX(close) + 4.5, NSMinY(close) + 4.5)];
+            [x lineToPoint:NSMakePoint(NSMaxX(close) - 4.5, NSMaxY(close) - 4.5)];
+            [x moveToPoint:NSMakePoint(NSMinX(close) + 4.5, NSMaxY(close) - 4.5)];
+            [x lineToPoint:NSMakePoint(NSMaxX(close) - 4.5, NSMinY(close) + 4.5)];
+            [x setLineWidth:1.25];
+            [(isSelected ? text : dim) setStroke];
+            [x stroke];
+        }
+    }
+    // new tab
+    NSRect plus = [self _plusRect];
+    NSBezierPath *p = [NSBezierPath bezierPath];
+
+    [line setFill];
+    NSRectFillUsingOperation(NSMakeRect(NSMinX(plus), NSMinY(plus) + 5, 1, NSHeight(plus) - 10), NSCompositeSourceOver);
+    [p moveToPoint:NSMakePoint(NSMidX(plus) - 5, NSMidY(plus))];
+    [p lineToPoint:NSMakePoint(NSMidX(plus) + 5, NSMidY(plus))];
+    [p moveToPoint:NSMakePoint(NSMidX(plus), NSMidY(plus) - 5)];
+    [p lineToPoint:NSMakePoint(NSMidX(plus), NSMidY(plus) + 5)];
+    [p setLineWidth:1.25];
+    [dim setStroke];
+    [p stroke];
+    // a hairline between the bar and the content
+    [line setFill];
+    NSRectFillUsingOperation(NSMakeRect(0, [self isFlipped] ? NSMaxY(bounds) - 1 : 0, NSWidth(bounds), 1), NSCompositeSourceOver);
+}
+
+- (void)updateTrackingAreas
+{
+    [super updateTrackingAreas];
+    if (_tracking != nil)
+        [self removeTrackingArea:_tracking];
+    [_tracking release];
+    _tracking = [[NSTrackingArea alloc] initWithRect:[self bounds]
+                                             options:NSTrackingMouseMoved | NSTrackingMouseEnteredAndExited | NSTrackingActiveAlways
+                                               owner:self userInfo:nil];
+    [self addTrackingArea:_tracking];
+}
+
+- (void)_hit:(NSPoint)point tab:(NSInteger *)tab close:(BOOL *)close
+{
+    NSArray *windows = [self _windows];
+    NSUInteger count = [windows count];
+
+    *tab = -1;
+    *close = NO;
+    for (NSUInteger i = 0; i < count; i++) {
+        NSRect rect = [self _tabRect:i of:count];
+
+        if (NSPointInRect(point, rect)) {
+            *tab = (NSInteger)i;
+            *close = count > 1 && NSPointInRect(point, NSInsetRect([self _closeRectIn:rect], -3, -3));
+            return;
+        }
+    }
+}
+
+- (void)mouseMoved:(NSEvent *)event
+{
+    NSInteger tab;
+    BOOL close;
+
+    [self _hit:[self convertPoint:[event locationInWindow] fromView:nil] tab:&tab close:&close];
+    if (tab != _hover || (close ? tab : -1) != _hoverClose) {
+        _hover = tab;
+        _hoverClose = close ? tab : -1;
+        [self setNeedsDisplay:YES];
+    }
+}
+
+- (void)mouseExited:(NSEvent *)event
+{
+    _hover = _hoverClose = -1;
+    [self setNeedsDisplay:YES];
+}
+
+- (void)mouseDown:(NSEvent *)event
+{
+    NSPoint point = [self convertPoint:[event locationInWindow] fromView:nil];
+    NSArray *windows = [self _windows];
+    NSInteger tab;
+    BOOL close;
+
+    if (NSPointInRect(point, [self _plusRect])) {
+        [NSApp sendAction:@selector(newWindowForTab:) to:nil from:[self window]];
+        return;
+    }
+    [self _hit:point tab:&tab close:&close];
+    if (tab < 0)
+        return;
+    NSWindow *window = [windows objectAtIndex:(NSUInteger)tab];
+    if (close)
+        [window performClose:self];
+    else
+        [[window tabGroup] setSelectedWindow:window];
+}
+
+@end
+
+#pragma mark NSWindow
+
+@implementation NSWindow (SFTabbing)
+
+- (NSWindowTabGroup *)tabGroup
+{
+    NSWindowTabGroup *group = objc_getAssociatedObject(self, &SFTabGroupKey);
+
+    if (group == nil) {
+        group = [[[NSWindowTabGroup alloc] _sfInitWithIdentifier:[self tabbingIdentifier]] autorelease];
+        [group addWindow:self];
+    }
+    return group;
+}
+
+- (NSWindowTab *)tab
+{
+    NSWindowTab *tab = objc_getAssociatedObject(self, &SFTabKey);
+
+    if (tab == nil) {
+        tab = [[[NSWindowTab alloc] _sfInitWithWindow:self] autorelease];
+        objc_setAssociatedObject(self, &SFTabKey, tab, OBJC_ASSOCIATION_RETAIN);
+    }
+    return tab;
+}
+
+// Unless set, Apple's form: the class, its controller's and delegate's, and "VT".
+- (NSString *)tabbingIdentifier
+{
+    NSString *set = objc_getAssociatedObject(self, &SFTabbingIdentifierKey);
+
+    if (set != nil)
+        return set;
+    return [NSString stringWithFormat:@"%@-%@-%@-VT-", [self className],
+                     [self windowController] ? NSStringFromClass([[self windowController] class]) : @"(null)",
+                     [self delegate] ? NSStringFromClass([(id)[self delegate] class]) : @"(null)"];
+}
+
+- (void)setTabbingIdentifier:(NSString *)identifier
+{
+    objc_setAssociatedObject(self, &SFTabbingIdentifierKey, identifier, OBJC_ASSOCIATION_COPY);
+}
+
+- (NSInteger)tabbingMode
+{
+    return [objc_getAssociatedObject(self, &SFTabbingModeKey) integerValue];
+}
+
+- (void)setTabbingMode:(NSInteger)mode
+{
+    objc_setAssociatedObject(self, &SFTabbingModeKey, @(mode), OBJC_ASSOCIATION_RETAIN);
+}
+
+// NSWindowUserTabbingPreferenceInFullScreen, macOS's default: new windows are windows
++ (NSInteger)userTabbingPreference
+{
+    return 2;
+}
+
+- (NSArray *)tabbedWindows
+{
+    NSWindowTabGroup *group = objc_getAssociatedObject(self, &SFTabGroupKey);
+
+    return [[group windows] count] > 1 ? [group windows] : nil;
+}
+
+// The new tab goes beside this one (after it for NSWindowAbove) and is selected.
+- (void)addTabbedWindow:(NSWindow *)window ordered:(NSWindowOrderingMode)ordered
+{
+    if (window == nil || window == self)
+        return;
+    NSWindowTabGroup *group = [self tabGroup];
+    NSUInteger at = [[group windows] indexOfObject:self];
+
+    [group insertWindow:window atIndex:(NSInteger)(ordered == NSWindowBelow ? at : at + 1)];
+    if ([self isVisible])
+        [group setSelectedWindow:window];
+}
+
+- (void)_sfSelectTabBy:(NSInteger)step
+{
+    NSWindowTabGroup *group = objc_getAssociatedObject(self, &SFTabGroupKey);
+    NSArray *windows = [group windows];
+    NSUInteger n = [windows count], i = [windows indexOfObject:[group selectedWindow] ?: self];
+
+    if (n < 2 || i == NSNotFound)
+        return;
+    [group setSelectedWindow:[windows objectAtIndex:(i + n + (NSUInteger)step) % n]];
+}
+
+- (void)selectNextTab:(id)sender { [self _sfSelectTabBy:1]; }
+- (void)selectPreviousTab:(id)sender { [self _sfSelectTabBy:-1]; }
+
+// The tab leaves its group and becomes a window of its own, a little below and to the right.
+- (void)moveTabToNewWindow:(id)sender
+{
+    NSWindowTabGroup *group = objc_getAssociatedObject(self, &SFTabGroupKey);
+
+    if ([[group windows] count] < 2)
+        return;
+    NSRect frame = [self frame];
+
+    if ([group selectedWindow] == self)
+        [self _sfTabOrderWindow:NSWindowOut relativeTo:0];
+    [group removeWindow:self];
+    [self setFrame:NSOffsetRect(frame, 24, -24) display:NO];
+    [self makeKeyAndOrderFront:nil];
+}
+
+// Every window with this window's tabbing identifier becomes a tab of its group.
+- (void)mergeAllWindows:(id)sender
+{
+    for (NSWindow *window in [NSApp windows])
+        if (window != self && [window isVisible] && ![window isKindOfClass:[NSPanel class]] &&
+            [[window tabbingIdentifier] isEqualToString:[self tabbingIdentifier]] && [window tabbingMode] != 2)
+            [[self tabGroup] addWindow:window];
+    [[self tabGroup] setSelectedWindow:self];
+}
+
+- (void)toggleTabBar:(id)sender
+{
+    [[self tabGroup] _sfToggleBar];
+}
+
+- (void)toggleTabOverview:(id)sender
+{
+    [[self tabGroup] setOverviewVisible:![[self tabGroup] isOverviewVisible]];
+}
+
+// for -[NSWindow validateMenuItem:]: the tab commands need a second tab
+- (BOOL)_sfTabCommandEnabled:(SEL)action
+{
+    return [[objc_getAssociatedObject(self, &SFTabGroupKey) windows] count] > 1;
+}
+
+#pragma mark the tab bar of a window
+
+- (NSView *)_sfTabBarView
+{
+    return objc_getAssociatedObject(self, &SFTabBarKey);
+}
+
+- (CGFloat)_sfTabBarHeight
+{
+    NSView *bar = objc_getAssociatedObject(self, &SFTabBarKey);
+
+    return bar ? NSHeight([bar frame]) : 0;
+}
+
+/* Shows the bar where the window is a tab of a group of two or more (or the user asked for it with
+ * one), takes it away otherwise. The frame stays: the content gives up the bar's height. */
+- (void)_sfUpdateTabBar
+{
+    NSWindowTabGroup *group = objc_getAssociatedObject(self, &SFTabGroupKey);
+    BOOL want = group != nil && [group isTabBarVisible] && NSWindowFrameIsDrawnByServer([self styleMask]) &&
+                ([self styleMask] & NSTitledWindowMask) && ![self isKindOfClass:[NSPanel class]];
+    NSView *bar = objc_getAssociatedObject(self, &SFTabBarKey);
+    NSView *frameView = [[self contentView] superview];
+
+    if (want && bar == nil && frameView != nil) {
+        bar = [[[SFTabBarView alloc] initWithFrame:NSMakeRect(0, 0, NSWidth([self frame]), SFTabBarHeight)] autorelease];
+        [bar setAutoresizingMask:NSViewWidthSizable | NSViewMinYMargin];
+        objc_setAssociatedObject(self, &SFTabBarKey, bar, OBJC_ASSOCIATION_RETAIN);
+        [frameView addSubview:bar];
