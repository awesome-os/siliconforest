+@interface NSWindowTab : NSObject {
+    NSWindow *_window;      // not retained: the window owns its tab
+    NSString *_title, *_toolTip;
+    NSAttributedString *_attributedTitle;
+    NSView *_accessoryView;
+}
+@property(copy) NSString *title;
+@property(copy) NSAttributedString *attributedTitle;
+@property(copy) NSString *toolTip;
+@property(retain) NSView *accessoryView;
+@end
+
+@implementation NSWindowTab
+
+- (instancetype)_sfInitWithWindow:(NSWindow *)window
+{
+    if ((self = [super init]))
+        _window = window;
+    return self;
+}
+
+- (void)dealloc
+{
+    [_title release];
+    [_attributedTitle release];
+    [_toolTip release];
+    [_accessoryView release];
+    [super dealloc];
+}
+
+- (NSWindow *)window { return _window; }
+- (NSString *)title
+{
+    if (_title != nil)
+        return _title;
+    if (_attributedTitle != nil)
+        return [_attributedTitle string];
+    return [_window title] ?: @"";
+}
+- (void)setTitle:(NSString *)title
+{
+    if (title == _title || [title isEqualToString:_title])
+        return;
+    [_title autorelease];
+    _title = [title copy];
+    [objc_getAssociatedObject(_window, &SFTabGroupKey) _sfUpdateBars];
+}
+- (NSAttributedString *)attributedTitle { return _attributedTitle; }
+- (void)setAttributedTitle:(NSAttributedString *)title
+{
+    [_attributedTitle autorelease];
+    _attributedTitle = [title copy];
+    [objc_getAssociatedObject(_window, &SFTabGroupKey) _sfUpdateBars];
+}
+- (NSString *)toolTip { return _toolTip ?: [self title]; }
+- (void)setToolTip:(NSString *)tip
+{
+    [_toolTip autorelease];
+    _toolTip = [tip copy];
+}
+- (NSView *)accessoryView { return _accessoryView; }
+- (void)setAccessoryView:(NSView *)view
+{
+    [_accessoryView autorelease];
+    _accessoryView = [view retain];
+}
+- (NSImage *)image { return nil; }
+- (void)setImage:(NSImage *)image { }
+
+@end
