+// A layer tree renders through OpenGL (CALayerContext, CGL on EGL). Where the system has no EGL
+// (a root without Mesa) CGL calls a function it could not load: such a view is drawn as an ordinary
+// view instead (its -drawRect: into the window), without a layer context. SFLayerRendering=NO in the
+// environment or the defaults does the same. (First met with Activity Monitor's graphs, which ask for
+// a layer: docs/roadmap/issues/SF-AA-activity-monitor.md.)
+static BOOL sfLayerRenderingAvailable(void){
+   static int available=-1;
+
+   if(available<0){
+    const char *env=getenv("SFLayerRendering");
+
+    if(env!=NULL && (env[0]=='N' || env[0]=='n' || env[0]=='0'))
+     available=0;
+    else {
+     void *egl=dlopen("/usr/lib/libEGL.1.dylib",RTLD_LAZY|RTLD_LOCAL);
+
+     available=(egl!=NULL);
+     if(!available)
+      NSLog(@"no OpenGL (libEGL) on this system: layer-backed views are drawn as ordinary views");
+    }
+   }
+   return available;
+}
+
 -(void)_createLayerContextIfNeeded {
+   if(!sfLayerRenderingAvailable())
+    return;
    if([_superview layer]==nil){
     _layerContext=[[CALayerContext alloc] initWithFrame:[self frame]];
     [_layerContext setDelegate:self];
@@ -1807,7 +1837,10 @@
