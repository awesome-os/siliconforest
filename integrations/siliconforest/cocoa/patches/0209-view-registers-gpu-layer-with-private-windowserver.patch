+// (TERM9) the whole-window GPU presenter is asked for only with SFFX_GPU_PRESENT=1 (Firefox's launcher sets it);
+// the answer and WindowServer's entry are looked up once: every other application never calls it
+typedef int (*sfSFFXSetGPULayerFn)(int,uintptr_t,void *,double,double,double,double,double,double,double,double);
+static sfSFFXSetGPULayerFn sfSFFXGPUPresenter(void){
+ static sfSFFXSetGPULayerFn set;
+ static int known;
+ if(!known){
+  const char *gpu=getenv("SFFX_GPU_PRESENT");
+  set=(gpu&&!strcmp(gpu,"1"))?(sfSFFXSetGPULayerFn)dlsym(RTLD_DEFAULT,"_windowServerSFFXSetGPULayer"):NULL;
+  known=1;
+ }
+ return set;
+}
+static int sfSFFXSetGPULayer(NSView *view,NSWindow *window,CFTypeRef surface,
+ double sx,double sy,double sw,double sh,double dx,double dy,double dw,double dh){
+ sfSFFXSetGPULayerFn set=sfSFFXGPUPresenter();
+ return set&&window?set((int)[window windowNumber],(uintptr_t)view,(void *)surface,sx,sy,sw,sh,dx,dy,dw,dh):0;
+}
+static void sfSFFXClearGPULayer(NSView *view,NSWindow *window){sfSFFXSetGPULayer(view,window,NULL,0,0,0,0,0,0,0,0);}
