+/* The file a name resolves to, found once per name: every NSFont made by name was a fontconfig
+ * substitution and match (a third of Terminal.app's launch went to sizing its menu strip that way).
+ * Names that resolve to nothing are not kept: an application's own fonts are added later. */
 +(NSString*)filenameForPattern:(NSString *)pattern {
+   static NSMutableDictionary *found;
+   static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
+   NSString *key=pattern ? pattern : @"";
+   NSString *result;
+
+   pthread_mutex_lock(&lock);
+   result=[[found objectForKey:key] retain];
+   pthread_mutex_unlock(&lock);
+   if(result!=nil)
+    return [result autorelease];
+   result=[self _filenameForPattern:pattern];
+   if(result!=nil){
+    pthread_mutex_lock(&lock);
+    if(found==nil)
+     found=[[NSMutableDictionary alloc] init];
+    [found setObject:result forKey:key];
+    pthread_mutex_unlock(&lock);
+   }
+   return result;
+}
