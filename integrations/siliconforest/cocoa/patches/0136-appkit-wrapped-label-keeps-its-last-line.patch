     if(![self wraps] && line<titleRect.size.height)
      titleRect=SFRectFromTop(titleRect,flipped,1,line);
+    else if([self wraps])
+     // (TERM7) wrapped lines keep the whole height: a label as high as its lines (a nib's two-line explanation,
+     // 32 points for two 16-point lines) lost its last line to the point it was moved down (Terminal's
