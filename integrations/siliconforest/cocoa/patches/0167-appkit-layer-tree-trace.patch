+// (TERM11) SF_WIN_TRACE: the shape of a layer tree read back
+static void sfTraceLayerTree(CALayer *layer,int depth){
+   static int lines;
+   if(layer==nil || depth>8 || lines++>400)
+    return;
+   CGRect b=[layer bounds];
+   fprintf(stderr,"SFWIN   %*s%s %p bounds %gx%g hidden %d opacity %.2f contents %s %p sublayers %lu delegate %s\n",depth*2,"",
+           object_getClassName(layer),(void *)layer,b.size.width,b.size.height,(int)[layer isHidden],(double)[layer opacity],
+           [layer contents]?object_getClassName([layer contents]):"-",[layer contents],(unsigned long)[[layer sublayers] count],
+           [layer delegate]?object_getClassName([layer delegate]):"-");
+   for(CALayer *sub in [layer sublayers])
+    sfTraceLayerTree(sub,depth+1);
+}
