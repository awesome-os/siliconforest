+// one layer and its sublayers, in its own coordinates (the caller put its bounds where they go)
+static void sfDrawLayerCPU(CALayer *layer,CGContextRef ctx,CGFloat alpha,int depth) {
+   if([layer isHidden] || alpha*[layer opacity]<=0.001 || depth>32)
+    return;
+   alpha*=[layer opacity];
+
+   CGRect b=[layer bounds];
+   CGFloat radius=[layer cornerRadius];
+   id contents=[layer contents];
+
+   CGContextSaveGState(ctx);
+   CGContextSetAlpha(ctx,alpha);
+   if([layer masksToBounds]){
+    CGContextBeginPath(ctx);
+    sfAddRoundedRect(ctx,b,radius);
+    CGContextClip(ctx);
+   }
+   if([layer backgroundColor]!=NULL){
+    CGContextSetFillColorWithColor(ctx,[layer backgroundColor]);
+    CGContextBeginPath(ctx);
+    sfAddRoundedRect(ctx,b,radius);
+    CGContextFillPath(ctx);
+   }
+   if(contents!=nil){
+    Class cls=object_getClass(contents);
+    static Class o2Image;
+
+    if(o2Image==Nil)
+     o2Image=NSClassFromString(@"O2Image");
+    if(cls!=Nil && o2Image!=Nil && [contents isKindOfClass:o2Image]){
+     CGImageRef image=(CGImageRef)contents;
+     CGFloat scale=[layer contentsScale]>0 ? [layer contentsScale] : 1;
+     CGRect r=sfGravityRect([layer contentsGravity],b,CGSizeMake(CGImageGetWidth(image)/scale,CGImageGetHeight(image)/scale));
+
+     CGContextDrawImage(ctx,r,image);
+    }
+    else if(cls!=Nil && [contents isKindOfClass:[NSImage class]]){
+     NSImage *image=contents;
+     CGRect r=sfGravityRect([layer contentsGravity],b,NSSizeToCGSize([image size]));
+     NSGraphicsContext *g=[NSGraphicsContext graphicsContextWithGraphicsPort:ctx flipped:NO];
+
+     [NSGraphicsContext saveGraphicsState];
+     [NSGraphicsContext setCurrentContext:g];
+     [image drawInRect:NSRectFromCGRect(r) fromRect:NSZeroRect operation:NSCompositeSourceOver fraction:1];
+     [NSGraphicsContext restoreGraphicsState];
+    }
+    else if(cls==Nil){
+     void *unlock=NULL;
+     CGImageRef image=sfImageOfPixelBuffer(contents,&unlock);
+
+     if(image!=NULL){
+      CGContextDrawImage(ctx,sfGravityRect([layer contentsGravity],b,CGSizeMake(CGImageGetWidth(image),CGImageGetHeight(image))),image);
+      CGImageRelease(image);
+      ((int (*)(void *,uint64_t))unlock)(contents,1);
+     }
+    }
+   }
+   if([layer borderWidth]>0 && [layer borderColor]!=NULL){
+    CGFloat w=[layer borderWidth];
+
+    CGContextSetStrokeColorWithColor(ctx,[layer borderColor]);
+    CGContextSetLineWidth(ctx,w);
+    CGContextBeginPath(ctx);
+    sfAddRoundedRect(ctx,CGRectInset(b,w/2,w/2),MAX(0,radius-w/2));
+    CGContextStrokePath(ctx);
+   }
+   for(CALayer *sub in [layer sublayers]){
+    CGRect sb=[sub bounds];
+    CGPoint pos=[sub position],anchor=[sub anchorPoint];
+    CGAffineTransform t=CATransform3DGetAffineTransform([sub transform]);
+
+    CGContextSaveGState(ctx);
+    CGContextTranslateCTM(ctx,pos.x,pos.y);
+    CGContextConcatCTM(ctx,t);
+    CGContextTranslateCTM(ctx,-anchor.x*sb.size.width-sb.origin.x,-anchor.y*sb.size.height-sb.origin.y);
+    if([sub isGeometryFlipped]!=[layer isGeometryFlipped]){
+     CGContextTranslateCTM(ctx,0,2*sb.origin.y+sb.size.height);
+     CGContextScaleCTM(ctx,1,-1);
+    }
+    sfDrawLayerCPU(sub,ctx,1,depth+1);
+    CGContextRestoreGState(ctx);
+   }
+   CGContextRestoreGState(ctx);
+}
+
+// a view hosting a layer draws the layer's tree when nothing else does (no EGL); NO when it has none to draw
+static BOOL sfDrawHostedLayer(NSView *view,CALayer *layer,CGContextRef ctx) {
+   if(layer==nil || [layer isKindOfClass:[NSViewBackingLayer class]])
+    return NO;
+   if([layer contents]==nil && [layer backgroundColor]==NULL && [[layer sublayers] count]==0){
+    sfCPULayerRegister(view);
+    return NO;
+   }
+   CGRect b=[layer bounds];
+
+   sfCPULayerRegister(view);
+   CGContextSaveGState(ctx);
+   // the root layer's bounds are the view's (configureLayerGeometry); layer geometry is y up
+   if([view isFlipped] && ![layer isGeometryFlipped]){
+    NSRect vb=[view bounds];
+
+    CGContextTranslateCTM(ctx,0,NSMinY(vb)+NSMaxY(vb));
+    CGContextScaleCTM(ctx,1,-1);
+   }
+   CGContextTranslateCTM(ctx,-b.origin.x+[view bounds].origin.x,-b.origin.y+[view bounds].origin.y);
+   sfDrawLayerCPU(layer,ctx,1,0);
+   CGContextRestoreGState(ctx);
+   return YES;
+}
