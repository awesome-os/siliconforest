+// a CVPixelBuffer's pixels as a CGImage without a copy (32-bit BGRA or ARGB only), NULL for anything else
+static CGImageRef sfImageOfPixelBuffer(id contents, void **lockedOut) {
+   static CFTypeID (*getTypeID)(void);
+   static int (*lock)(void *,uint64_t), (*unlock)(void *,uint64_t);
+   static void *(*base)(void *);
+   static size_t (*rowBytes)(void *), (*width)(void *), (*height)(void *);
+   static uint32_t (*format)(void *);
+   static int looked;
+
+   *lockedOut=NULL;
+   if(!looked){
+    looked=1;
+    getTypeID=dlsym(RTLD_DEFAULT,"CVPixelBufferGetTypeID");
+    lock=dlsym(RTLD_DEFAULT,"CVPixelBufferLockBaseAddress"); unlock=dlsym(RTLD_DEFAULT,"CVPixelBufferUnlockBaseAddress");
+    base=dlsym(RTLD_DEFAULT,"CVPixelBufferGetBaseAddress"); rowBytes=dlsym(RTLD_DEFAULT,"CVPixelBufferGetBytesPerRow");
+    width=dlsym(RTLD_DEFAULT,"CVPixelBufferGetWidth"); height=dlsym(RTLD_DEFAULT,"CVPixelBufferGetHeight");
+    format=dlsym(RTLD_DEFAULT,"CVPixelBufferGetPixelFormatType");
+   }
+   if(getTypeID==NULL || lock==NULL || unlock==NULL || base==NULL || rowBytes==NULL || width==NULL || height==NULL || format==NULL)
+    return NULL;
+   if(CFGetTypeID((CFTypeRef)contents)!=getTypeID())
+    return NULL;
+   uint32_t f=format(contents);
+   CGBitmapInfo info;
+
+   if(f=='BGRA')
+    info=kCGImageAlphaPremultipliedFirst|kCGBitmapByteOrder32Little;
+   else if(f==0x20 /* kCVPixelFormatType_32ARGB */)
+    info=kCGImageAlphaPremultipliedFirst|kCGBitmapByteOrder32Big;
+   else
+    return NULL;
+   if(lock(contents,1 /* read only */)!=0)
+    return NULL;
+   size_t w=width(contents),h=height(contents),r=rowBytes(contents);
+   CGDataProviderRef provider=CGDataProviderCreateWithData(NULL,base(contents),r*h,NULL);
+   CGColorSpaceRef space=CGColorSpaceCreateDeviceRGB();
+   CGImageRef image=CGImageCreate(w,h,8,32,r,space,info,provider,NULL,false,kCGRenderingIntentDefault);
+
+   CGColorSpaceRelease(space);
+   CGDataProviderRelease(provider);
+   if(image==NULL){
+    unlock(contents,1);
+    return NULL;
+   }
+   *lockedOut=(void *)unlock;
+   return image;
+}
