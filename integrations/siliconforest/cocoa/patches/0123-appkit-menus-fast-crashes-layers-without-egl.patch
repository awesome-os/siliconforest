+// where contents of a size go in a layer's bounds (layer coordinates, y up)
+static CGRect sfGravityRect(NSString *g,CGRect b,CGSize size) {
+   if(size.width<=0 || size.height<=0 || g==nil || [g isEqualToString:@"resize"])
+    return b;
+   if([g isEqualToString:@"resizeAspect"] || [g isEqualToString:@"resizeAspectFill"]){
+    CGFloat sx=b.size.width/size.width,sy=b.size.height/size.height;
+    CGFloat k=[g isEqualToString:@"resizeAspect"] ? MIN(sx,sy) : MAX(sx,sy);
+    CGSize s=CGSizeMake(size.width*k,size.height*k);
+
+    return CGRectMake(CGRectGetMidX(b)-s.width/2,CGRectGetMidY(b)-s.height/2,s.width,s.height);
+   }
+   CGFloat x=CGRectGetMidX(b)-size.width/2,y=CGRectGetMidY(b)-size.height/2;
+
+   if([g hasSuffix:@"eft"] || [g isEqualToString:@"left"]) x=CGRectGetMinX(b);
+   if([g hasSuffix:@"ight"]) x=CGRectGetMaxX(b)-size.width;
+   if([g hasPrefix:@"top"]) y=CGRectGetMaxY(b)-size.height;
+   if([g hasPrefix:@"bottom"]) y=CGRectGetMinY(b);
+   return CGRectMake(x,y,size.width,size.height);
+}
+
+static void sfAddRoundedRect(CGContextRef ctx,CGRect r,CGFloat radius) {
+   radius=MIN(radius,MIN(r.size.width,r.size.height)/2);
+   if(radius<=0){
+    CGContextAddRect(ctx,r);
+    return;
+   }
+   CGContextMoveToPoint(ctx,CGRectGetMinX(r)+radius,CGRectGetMinY(r));
+   CGContextAddArcToPoint(ctx,CGRectGetMaxX(r),CGRectGetMinY(r),CGRectGetMaxX(r),CGRectGetMaxY(r),radius);
+   CGContextAddArcToPoint(ctx,CGRectGetMaxX(r),CGRectGetMaxY(r),CGRectGetMinX(r),CGRectGetMaxY(r),radius);
+   CGContextAddArcToPoint(ctx,CGRectGetMinX(r),CGRectGetMaxY(r),CGRectGetMinX(r),CGRectGetMinY(r),radius);
+   CGContextAddArcToPoint(ctx,CGRectGetMinX(r),CGRectGetMinY(r),CGRectGetMaxX(r),CGRectGetMinY(r),radius);
+   CGContextClosePath(ctx);
+}
