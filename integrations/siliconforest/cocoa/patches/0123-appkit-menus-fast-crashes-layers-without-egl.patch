+// the panel of a vertical menu as vectors: clear, then a soft shadow and the rounded panel (light or dark)
+static void sfDrawPanel(NSRect bounds, BOOL dark)
+{
+    // the window is clear, so the panel's rounded corners and shadow show what is behind it
+    NSRect box = NSInsetRect(bounds, SHADOW_M, SHADOW_M);
+
+    // back to transparent first, NSRectFill copies, or every redraw would stack the translucent layers
+    [[NSColor clearColor] setFill];
+    NSRectFill(bounds);
+    NSBezierPath *panel = [NSBezierPath bezierPathWithRoundedRect:NSInsetRect(box, 0.5, 0.5)
+                                                          xRadius:PANEL_R yRadius:PANEL_R];
+
+    // stacked faint rounded rects make the soft shadow, dropped a few pixels as in the demo; each
+    // is a ring round the panel (even-odd), not the panel's whole area again: eight fills of
+    // the whole menu were half the time it took to open
+    NSRect inner = NSInsetRect(box, PANEL_R, PANEL_R);
+    for (int k = 8; k >= 1; k--) {
+        NSRect r = NSOffsetRect(NSInsetRect(box, -k * 1.5, -k * 1.5), 0, 5);
+        NSBezierPath *ring = [NSBezierPath bezierPathWithRoundedRect:r xRadius:PANEL_R + k yRadius:PANEL_R + k];
+
+        if (inner.size.width > 0 && inner.size.height > 0) {
+            [ring appendBezierPathWithRect:inner];
+            [ring setWindingRule:NSEvenOddWindingRule];
+        }
+        [[NSColor colorWithCalibratedWhite:0 alpha:0.018] setFill];
+        [ring fill];
+    }
+    // the demo's 92%, the compositor blurs what shows through
+    [(dark ? [NSColor colorWithCalibratedRed:0.172 green:0.172 blue:0.18 alpha:0.92]
+           : [NSColor colorWithCalibratedRed:0.98 green:0.969 blue:0.961 alpha:0.92]) setFill];
+    [panel fill];
+    [[NSColor colorWithCalibratedWhite:dark ? 1 : 0 alpha:0.12] setStroke];
+    [panel setLineWidth:1];
+    [panel stroke];
+}
+
+/* The panel drawn once small, then pieced together for any size (nine pieces: corners as they are, edges
+ * stretched along themselves, the middle one colour). Its shadow is eight path fills over the whole menu:
+ * that rasterising was half the time a menu took to open, and every row the highlight moved to paid for it
+ * again (clipped). The pieces are cut on the device's pixels at the menu's own pixel phases, so that the
+ * result is the vector drawing's pixels (SF_MENU_VECTOR=1 draws the vectors, for comparison). */
+typedef struct {
+    int used, dark, K;
+    CGFloat scale, pl, pr, pb, pt;
+    CGImageRef piece[9];
+    CGFloat center[4];
+} SFPanelTemplate;
+
+static SFPanelTemplate sfPanelCache[6];
+static unsigned sfPanelNext;
+
+// the rows and columns the corners take, beyond which every row (column) of the panel is the same
+#define PANEL_CORNER (SHADOW_M + 14.0)
+
+static SFPanelTemplate *sfPanelTemplate(BOOL dark, CGFloat scale, CGFloat pl, CGFloat pr, CGFloat pb, CGFloat pt)
+{
+    SFPanelTemplate *t;
+    unsigned i;
+
+    for (i = 0; i < sizeof(sfPanelCache) / sizeof(sfPanelCache[0]); i++) {
+        t = &sfPanelCache[i];
+        if (t->used && t->dark == dark && fabs(t->scale - scale) < 1e-4 && fabs(t->pl - pl) < 1.0 / 64 &&
+            fabs(t->pr - pr) < 1.0 / 64 && fabs(t->pb - pb) < 1.0 / 64 && fabs(t->pt - pt) < 1.0 / 64)
+            return t;
+    }
+    t = &sfPanelCache[sfPanelNext++ % (sizeof(sfPanelCache) / sizeof(sfPanelCache[0]))];
+    for (i = 0; i < 9; i++)
+        if (t->piece[i] != NULL)
+            CGImageRelease(t->piece[i]), t->piece[i] = NULL;
+    t->used = 0;
+
+    int K = (int)ceil(PANEL_CORNER * scale) + 1, T = 2 * K + 1;
+    CGFloat vw = T - pl - pr, vh = T - pb - pt;
+    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+    CGContextRef c = CGBitmapContextCreate(NULL, T, T, 8, T * 4, space, kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
+
+    CGColorSpaceRelease(space);
+    if (c == NULL)
+        return NULL;
+    // the view's flipped points onto the template's pixels: (x, y) -> (pl + x s, pb + vh - y s)
+    CGContextConcatCTM(c, CGAffineTransformMake(scale, 0, 0, -scale, pl, pb + vh));
+    [NSGraphicsContext saveGraphicsState];
+    [NSGraphicsContext setCurrentContext:[NSGraphicsContext graphicsContextWithGraphicsPort:c flipped:YES]];
+    sfDrawPanel(NSMakeRect(0, 0, vw / scale, vh / scale), dark);
+    [NSGraphicsContext restoreGraphicsState];
+
+    CGImageRef all = CGBitmapContextCreateImage(c);
+    const uint8_t *px = CGBitmapContextGetData(c);
+    size_t row = CGBitmapContextGetBytesPerRow(c);
+
+    if (all == NULL || px == NULL) {
+        if (all != NULL)
+            CGImageRelease(all);
+        CGContextRelease(c);
+        return NULL;
+    }
+    // columns (and rows, the image's from its top) [0, K), [K, K + 1), [K + 1, T)
+    int at[4] = { 0, K, K + 1, T };
+    for (int j = 0; j < 3; j++) {
+        for (int k = 0; k < 3; k++) {
+            // piece (k, j): k across, j up the device (the image counts rows down from its top)
+            CGRect r = CGRectMake(at[k], T - at[j + 1], at[k + 1] - at[k], at[j + 1] - at[j]);
+
+            t->piece[j * 3 + k] = (j == 1 && k == 1) ? NULL : CGImageCreateWithImageInRect(all, r);
+        }
+    }
+    // the middle pixel, premultiplied blue, green, red, alpha in memory
+    const uint8_t *m = px + (size_t)K * row + (size_t)K * 4;
+    CGFloat a = m[3] / 255.0;
+
+    t->center[3] = a;
+    t->center[0] = a > 0 ? m[2] / 255.0 / a : 0;
+    t->center[1] = a > 0 ? m[1] / 255.0 / a : 0;
+    t->center[2] = a > 0 ? m[0] / 255.0 / a : 0;
+    CGImageRelease(all);
+    CGContextRelease(c);
+    t->dark = dark, t->K = K, t->scale = scale, t->pl = pl, t->pr = pr, t->pb = pb, t->pt = pt;
+    t->used = 1;
+    return t;
+}
+
+static BOOL sfDrawPanelFromTemplate(NSRect bounds, NSRect dirty)
+{
+    static int vector = -1;
+
+    if (vector < 0)
+        vector = getenv("SF_MENU_VECTOR") != NULL;
+    if (vector)
+        return NO;
+
+    CGContextRef ctx = (CGContextRef)[[NSGraphicsContext currentContext] graphicsPort];
+    CGAffineTransform m = ctx != NULL ? CGContextGetCTM(ctx) : CGAffineTransformIdentity;
+
+    // only where the view's points go onto the device's pixels by a scale and a flip (a menu's window)
+    if (ctx == NULL || fabs(m.b) > 1e-9 || fabs(m.c) > 1e-9 || m.a <= 0 || m.d >= 0 || fabs(m.a + m.d) > 1e-9)
+        return NO;
+
+    CGRect dev = CGRectApplyAffineTransform(NSRectToCGRect(bounds), m);
+    CGFloat x0 = dev.origin.x, y0 = dev.origin.y, x1 = x0 + dev.size.width, y1 = y0 + dev.size.height;
+    BOOL dark = [[NSAppearance currentDrawingAppearance] _isDark];
+    SFPanelTemplate *t = sfPanelTemplate(dark, m.a, x0 - floor(x0), ceil(x1) - x1, y0 - floor(y0), ceil(y1) - y1);
+
+    if (t == NULL || ceil(x1) - floor(x0) < 2 * t->K + 1 || ceil(y1) - floor(y0) < 2 * t->K + 1)
+        return NO;
+
+    CGFloat xs[4] = { floor(x0), floor(x0) + t->K, ceil(x1) - t->K, ceil(x1) };
+    CGFloat ys[4] = { floor(y0), floor(y0) + t->K, ceil(y1) - t->K, ceil(y1) };
+    CGRect want = CGRectInset(CGRectApplyAffineTransform(NSRectToCGRect(dirty), m), -1, -1);
+
+    CGContextSaveGState(ctx);
+    CGContextConcatCTM(ctx, CGAffineTransformInvert(m));
+    CGContextSetBlendMode(ctx, kCGBlendModeCopy);
+    CGContextSetInterpolationQuality(ctx, kCGInterpolationNone);
+    for (int j = 0; j < 3; j++) {
+        for (int k = 0; k < 3; k++) {
+            CGRect r = CGRectMake(xs[k], ys[j], xs[k + 1] - xs[k], ys[j + 1] - ys[j]);
+
+            if (r.size.width <= 0 || r.size.height <= 0 || !CGRectIntersectsRect(r, want))
+                continue;
+            if (j == 1 && k == 1) {
+                CGContextSetRGBFillColor(ctx, t->center[0], t->center[1], t->center[2], t->center[3]);
+                CGContextFillRect(ctx, r);
+            }
+            else
+                CGContextDrawImage(ctx, r, t->piece[j * 3 + k]);
+        }
+    }
+    CGContextRestoreGState(ctx);
+    return YES;
+}
