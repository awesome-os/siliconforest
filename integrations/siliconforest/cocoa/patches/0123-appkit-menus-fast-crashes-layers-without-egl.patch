+static uint64_t sfLayerSignature(CALayer *layer, int depth) {
+   uint64_t h=0xcbf29ce484222325ULL;
+   CGRect b=[layer bounds];
+   CGPoint p=[layer position];
+   float o=[layer opacity];
+   uint32_t ob;
+
+   memcpy(&ob,&o,4);
+   h=sfMix(h,(uintptr_t)[layer contents]);
+   if([layer respondsToSelector:@selector(_contentsSeed)])
+    h=sfMix(h,((uint32_t (*)(id,SEL))objc_msgSend)(layer,@selector(_contentsSeed)));
+   h=sfMix(h,(uint64_t)(int64_t)(b.size.width*64)); h=sfMix(h,(uint64_t)(int64_t)(b.size.height*64));
+   h=sfMix(h,(uint64_t)(int64_t)(b.origin.x*64)); h=sfMix(h,(uint64_t)(int64_t)(b.origin.y*64));
+   h=sfMix(h,(uint64_t)(int64_t)(p.x*64)); h=sfMix(h,(uint64_t)(int64_t)(p.y*64));
+   h=sfMix(h,ob); h=sfMix(h,[layer isHidden]); h=sfMix(h,(uintptr_t)[layer backgroundColor]);
+   NSArray *subs=[layer sublayers];
+   h=sfMix(h,[subs count]);
+   if(depth<16)
+    for(CALayer *sub in subs)
+     h=sfMix(h,sfLayerSignature(sub,depth+1));
+   return h;
+}
+
+static void sfCPULayerTick(CFRunLoopTimerRef timer,void *info) {
+   for(unsigned i=0;i<sfCPULayerCount;i++){
+    NSView *view=sfCPULayerViews[i].view;
+    NSWindow *window=[view window];
+    CALayer *layer=[view layer];
+
+    if(window==nil || ![window isVisible] || layer==nil)
+     continue;
+    uint64_t sig=sfLayerSignature(layer,0);
+
+    if(!sfCPULayerViews[i].have || sfCPULayerViews[i].sig!=sig){
+     if(sfCPULayerViews[i].have)
+      [view setNeedsDisplay:YES];
+     sfCPULayerViews[i].sig=sig;
+     sfCPULayerViews[i].have=1;
+    }
+   }
+}
+
+static void sfCPULayerRegister(NSView *view) {
+   for(unsigned i=0;i<sfCPULayerCount;i++)
+    if(sfCPULayerViews[i].view==view)
+     return;
+   if(sfCPULayerCount==sfCPULayerCap){
+    sfCPULayerCap=sfCPULayerCap ? sfCPULayerCap*2 : 8;
+    sfCPULayerViews=realloc(sfCPULayerViews,sfCPULayerCap*sizeof(SFCPULayerView));
+   }
+   sfCPULayerViews[sfCPULayerCount++]=(SFCPULayerView){ view, 0, 0 };
+   if(sfCPULayerTimer==NULL){
+    sfCPULayerTimer=CFRunLoopTimerCreate(NULL,CFAbsoluteTimeGetCurrent()+1.0/60,1.0/60,0,0,sfCPULayerTick,NULL);
+    CFRunLoopAddTimer(CFRunLoopGetMain(),sfCPULayerTimer,kCFRunLoopCommonModes);
+   }
+}
+
+static void sfCPULayerForget(NSView *view) {
+   for(unsigned i=0;i<sfCPULayerCount;i++){
+    if(sfCPULayerViews[i].view!=view)
+     continue;
+    sfCPULayerViews[i]=sfCPULayerViews[--sfCPULayerCount];
+    if(sfCPULayerCount==0 && sfCPULayerTimer!=NULL){
+     CFRunLoopTimerInvalidate(sfCPULayerTimer);
+     CFRelease(sfCPULayerTimer);
+     sfCPULayerTimer=NULL;
+    }
+    return;
+   }
+}
