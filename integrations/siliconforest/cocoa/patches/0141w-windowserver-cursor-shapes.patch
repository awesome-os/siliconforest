+static uint32_t cursorShapeFor(const char *name) {
+    for (size_t i = 0; name != NULL && i < sizeof(cursorShapeNames) / sizeof(cursorShapeNames[0]); i++) {
+        if (strcmp(cursorShapeNames[i].name, name) == 0)
+            return cursorShapeNames[i].shape;
+    }
+    return 0;
+}
