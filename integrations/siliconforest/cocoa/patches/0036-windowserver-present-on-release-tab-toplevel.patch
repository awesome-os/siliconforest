+/* SF_WS_TIMING=1: one line per flush and per released frame on standard error, with the wall
+ * clock in milliseconds (CLOCK_REALTIME, so lines of the compositor and of the application can be
+ * put side by side): where the time between drawing and the screen goes. */
+static int wsTiming(void) {
+    static int on = -1;
+    if (on < 0) on = getenv("SF_WS_TIMING") != NULL;
+    return on;
+}
+static double wsNowMs(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return (double)ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+static int windowPresent(struct wsWindow *window);
+
+/* A flush that found every frame on the compositor's side is presented when one comes back,
+ * from here (the thread that reads the connection), under the lock the flush takes too. The
+ * backing store may be in the middle of the next drawing then; that drawing ends in a flush of
+ * its own, which replaces what was shown. Before, such a flush waited up to 100 ms on the
+ * application's main thread and was then dropped: the last lines of a burst of output stayed
+ * off the screen until something else drew (Terminal: the cursor's next blink). */
+static void framePresentPending(struct wsFrame *frame) {
+    if (frame->ownerID == 0)
+        return;
+    pthread_mutex_lock(&ws.pixelsLock);
+    struct wsWindow *window = windowForID(frame->ownerID);
+    if (window != NULL && window->presentPending) {
+        window->presentPending = 0;
+        if (window->state != MINIMIZED && window->state != HIDDEN && window->surface != NULL && windowPresent(window)) {
+            wl_surface_commit(window->surface);
+            wl_display_flush(ws.display);
+            if (wsTiming())
+                fprintf(stderr, "WSTIME %.1f commit-on-release surface=%d frame=%p\n", wsNowMs(), window->windowID, (void *)window->front);
+        }
+    }
+    pthread_mutex_unlock(&ws.pixelsLock);
+}
+
 static void frameReleased(void *data, struct wl_buffer *buffer) {
     struct wsFrame *frame = data;
+    if (wsTiming()) fprintf(stderr, "WSTIME %.1f release frame=%p\n", wsNowMs(), (void *)frame);
 
     pthread_mutex_lock(&ws.queueLock);
     frame->busy = 0;
     pthread_cond_broadcast(&ws.queueReady);
     pthread_mutex_unlock(&ws.queueLock);
+    framePresentPending(frame);
 }
 
