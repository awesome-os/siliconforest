+@implementation NSColor (SFActivityMonitor)
++ (NSColor *)systemCyanColor { return [NSColor colorWithCatalogName:@"System" colorName:@"systemCyanColor"]; }
++ (NSColor *)systemMintColor { return [NSColor colorWithCalibratedRed:0.0 green:0.78 blue:0.75 alpha:1.0]; }
+/* An application's named colours, from its asset catalog (Contents/Resources/Assets.car), read with
+   Finch's catalog reader (SFCUIStore.m, SFCUIRendition.m): the colour rendition of the name for the
+   light appearance (or the one without an appearance), its components in its colour space, or the
+   system colour it names. A name the catalog does not have is nil, as on macOS. */
+#include "SFCUIPrivate.h"
+static NSMutableDictionary *sfCatalogs;   /* bundle path -> NSValue of cui_store * (or NSNull) */
+
+static cui_store *sfCatalogOfBundle(NSBundle *bundle) {
+    NSString *key = [bundle bundlePath];
+    if (key == nil)
+        return NULL;
+    if (sfCatalogs == nil)
+        sfCatalogs = [[NSMutableDictionary alloc] init];
+    id v = [sfCatalogs objectForKey:key];
+    if (v == nil) {
+        NSString *path = [bundle pathForResource:@"Assets" ofType:@"car"];
+        cui_store *store = path ? cui_store_open([path fileSystemRepresentation]) : NULL;
+        v = store ? (id)[NSValue valueWithPointer:store] : (id)[NSNull null];
+        [sfCatalogs setObject:v forKey:key];
+    }
+    return [v isKindOfClass:[NSValue class]] ? [v pointerValue] : NULL;
+}
+
++ (NSColor *)colorNamed:(NSString *)name bundle:(NSBundle *)bundle {
+    cui_store *store = sfCatalogOfBundle(bundle ? bundle : [NSBundle mainBundle]);
+    const cui_facet *facet = (store && name) ? cui_store_facet(store, [name UTF8String]) : NULL;
+    if (facet == NULL)
+        return nil;
+    uint16_t aqua = 0, dark = 0;
+    BOOL haveAqua = cui_store_appearance(store, "NSAppearanceNameAqua", &aqua);
+    BOOL haveDark = cui_store_appearance(store, "NSAppearanceNameDarkAqua", &dark);
+    size_t first = 0, n = cui_store_renditions_for_identifier(store, facet->attrs.v[CUI_ATTR_IDENTIFIER], &first);
+    const cui_csi *best = NULL;
+    cui_csi csi, chosen;
+    int bestScore = -1;
+    for (size_t i = first; i < first + n; i++) {
+        const cui_rendition *r = &store->rends[i];
+        if (!cui_csi_parse(r->csi, r->len, &csi) || csi.layout != CUI_LAYOUT_COLOR)
+            continue;
+        uint16_t app = r->key.v[CUI_ATTR_APPEARANCE];
+        int score = (haveAqua && app == aqua) ? 3 : (app == 0 ? 2 : ((haveDark && app == dark) ? 0 : 1));
+        if (score > bestScore) {
+            bestScore = score;
+            chosen = csi;
+            best = &chosen;
+        }
+    }
+    unsigned space = 0, ncomps = 0;
+    double comps[8];
+    char sysname[128];
+    if (best == NULL || !cui_csi_color(best, &space, comps, &ncomps, sysname, sizeof(sysname)))
+        return nil;
+    if (sysname[0]) {
+        NSColor *c = [NSColor colorWithCatalogName:@"System" colorName:[NSString stringWithUTF8String:sysname]];
+        if (c != nil)
+            return c;
+    }
+    if (ncomps >= 4)       /* sRGB, Display P3, extended sRGB: red, green, blue, alpha */
+        return [NSColor colorWithCalibratedRed:comps[0] green:comps[1] blue:comps[2] alpha:comps[3]];
+    if (ncomps == 2)       /* grey, alpha */
+        return [NSColor colorWithCalibratedWhite:comps[0] alpha:comps[1]];
+    return nil;
+}
++ (NSColor *)colorNamed:(NSString *)name { return [self colorNamed:name bundle:nil]; }
+@end
