+/* ---- NSSearchField's search-string options: kept; this field sends its action as it is set up to
+   (continuously or on Return), which is what "immediately" asks for when it is continuous ---- */
+static const char sfSendsImmediatelyKey, sfSendsWholeKey;
+@implementation NSSearchField (SFSearchOptions)
+- (BOOL)sendsSearchStringImmediately { return [objc_getAssociatedObject(self, &sfSendsImmediatelyKey) boolValue]; }
+- (void)setSendsSearchStringImmediately:(BOOL)b {
+    objc_setAssociatedObject(self, &sfSendsImmediatelyKey, [NSNumber numberWithBool:b], OBJC_ASSOCIATION_RETAIN);
+    if (b)
+        [self setContinuous:YES];
+}
+- (BOOL)sendsWholeSearchString { return [objc_getAssociatedObject(self, &sfSendsWholeKey) boolValue]; }
+- (void)setSendsWholeSearchString:(BOOL)b {
+    objc_setAssociatedObject(self, &sfSendsWholeKey, [NSNumber numberWithBool:b], OBJC_ASSOCIATION_RETAIN);
+    if (b)
+        [self setContinuous:NO];
+}
+// Apple's search field sends its action while the user types (incremental search) unless it sends the
+// whole search string only (then on Return, NSTextField's own behaviour)
+- (void)textDidChange:(NSNotification *)note {
+    [super textDidChange:note];
+    if (![self sendsWholeSearchString] && [self action] != NULL)
+        [self sendAction:[self action] to:[self target]];
+}
+@end
