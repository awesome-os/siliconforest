+/* ---- a diagnostic: SFViewTreeDump=<seconds> logs every window's view tree (class, frame, hidden)
+   that many seconds after launch, for finding where a view's layout differs from what is expected ---- */
+@interface SFViewTreeDumper : NSObject
+@end
+@implementation SFViewTreeDumper
+static void sfDumpView(NSView *v, int depth) {
+    NSRect f = [v frame];
+    NSLog(@"%*s%@ %p {{%.0f,%.0f},{%.0f,%.0f}}%@%@%@", depth * 2, "", [v class], v, f.origin.x, f.origin.y, f.size.width, f.size.height,
+        [v isHidden] ? @" hidden" : @"", [v translatesAutoresizingMaskIntoConstraints] ? @"" : @" constrained", [v respondsToSelector:@selector(identifier)] && [(id)v identifier] ? [NSString stringWithFormat:@" id=%@", [(id)v identifier]] : @"");
+    if (depth <= 8 && getenv("SFViewTreeConstraints"))
+        for (NSLayoutConstraint *c in [v constraints])
+            NSLog(@"%*s  constraint %@.%ld %ld %@.%ld x%.2f %+.1f @%.0f%@", depth * 2, "", [[c firstItem] class], (long)[c firstAttribute], (long)[c relation],
+                [c secondItem] ? (id)[[c secondItem] class] : (id)@"-", (long)[c secondAttribute], [c multiplier], [c constant], [c priority], [c isActive] ? @"" : @" inactive");
+    if (depth > 14)
+        return;
+    NSArray *subs = [v subviews];
+    NSUInteger n = [subs count];
+    for (NSUInteger i = 0; i < n && i < 40; i++)
+        sfDumpView([subs objectAtIndex:i], depth + 1);
+    if (n > 40)
+        NSLog(@"%*s... %lu more", (depth + 1) * 2, "", (unsigned long)(n - 40));
+}
++ (void)dump:(id)unused {
+    for (NSWindow *w in [NSApp windows]) {
+        if (![w isVisible])
+            continue;
+        NSRect f = [w frame];
+        NSLog(@"window %@ \"%@\" {{%.0f,%.0f},{%.0f,%.0f}}", [w class], [w title], f.origin.x, f.origin.y, f.size.width, f.size.height);
+        sfDumpView([w contentView], 1);
+    }
+}
++ (void)schedule:(NSNotification *)note {
+    const char *s = getenv("SFViewTreeDump");
+    [self performSelector:@selector(dump:) withObject:nil afterDelay:s ? atof(s) : 10];
+}
++ (void)load {
+    const char *s = getenv("SFViewTreeDump");
+    if (s)
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(atof(s) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            [SFViewTreeDumper dump:nil];
+        });
+}
+@end
