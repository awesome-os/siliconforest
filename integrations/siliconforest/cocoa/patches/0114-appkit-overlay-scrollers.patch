+/* (cocoa 0114) macOS's overlay scrollers, the style a Mac with a trackpad shows: a thin rounded knob over the
+ * content, no track and no arrows; while the knob is dragged it is wider on a faint track; it fades out
+ * a second after the last scroll. Nothing runs at rest: a one-shot timer after a scroll, then a short fade
+ * that stops itself. They appear when the user scrolls (the wheel or trackpad through NSView, or the
+ * knob) and with -[NSScrollView flashScrollers]. The legacy style (always shown, taking room) with AppleShowScrollBars=Always in the
+ * defaults, or SF_SCROLLERS=legacy, or -setScrollerStyle: */
+@interface NSScroller () {
+   CGFloat  _sfOverlayAlpha;
+   NSTimer *_sfOverlayTimer;
+}
+@end
+
+NSScrollerStyle SFScrollerPreferredStyle(void) {
+   static int style=-1;
+
+   if(style<0){
+    const char *env=getenv("SF_SCROLLERS");
+    NSString   *shown=[[NSUserDefaults standardUserDefaults] stringForKey:@"AppleShowScrollBars"];
+
+    style=((env!=NULL && strcmp(env,"legacy")==0) || [shown isEqualToString:@"Always"])?NSScrollerStyleLegacy:NSScrollerStyleOverlay;
+   }
+   return (NSScrollerStyle)style;
+}
+
+const CGFloat SFOverlayScrollerWidth=14;
+
 @implementation NSScroller
 
+-(BOOL)_sfOverlay {
+   return [(id)self scrollerStyle]==NSScrollerStyleOverlay;
+}
+
+-(void)_sfOverlayStopTimer {
+   [_sfOverlayTimer invalidate];
+   [_sfOverlayTimer release];
+   _sfOverlayTimer=nil;
+}
+
+-(void)_sfOverlayFadeStep:(NSTimer *)timer {
+   _sfOverlayAlpha-=0.12;
+   if(_sfOverlayAlpha<=0){
+    _sfOverlayAlpha=0;
+    [self _sfOverlayStopTimer];
+   }
+   [self setNeedsDisplay:YES];
+}
+
+-(void)_sfOverlayStartFade:(NSTimer *)timer {
+   [_sfOverlayTimer release];
+   _sfOverlayTimer=[[NSTimer scheduledTimerWithTimeInterval:1.0/30 target:self selector:@selector(_sfOverlayFadeStep:) userInfo:nil repeats:YES] retain];
+}
+
+// shown at once, faded out a second after the last call
+-(void)_sfOverlayReveal {
+   [self _sfOverlayStopTimer];
+   if(_sfOverlayAlpha!=1){
+    _sfOverlayAlpha=1;
+    [self setNeedsDisplay:YES];
+   }
+   if(!_isHighlighted && [self window]!=nil)
+    _sfOverlayTimer=[[NSTimer scheduledTimerWithTimeInterval:1.0 target:self selector:@selector(_sfOverlayStartFade:) userInfo:nil repeats:NO] retain];
+}
+
+-(BOOL)isOpaque {
+   return ![self _sfOverlay];
+}
+
+// a faded overlay scroller lets clicks through to the content under it
+-(NSView *)hitTest:(NSPoint)point {
+   if([self _sfOverlay] && _sfOverlayAlpha<=0)
+    return nil;
+   return [super hitTest:point];
+}
+
+-(void)viewWillMoveToWindow:(NSWindow *)window {
+   if(window==nil)
+    [self _sfOverlayStopTimer];
+   [super viewWillMoveToWindow:window];
+}
+
 +(CGFloat)scrollerWidth {
    return [[NSDisplay currentDisplay] scrollerWidth];
 }
