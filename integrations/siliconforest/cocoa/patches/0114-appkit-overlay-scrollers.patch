+/* (cocoa 0114) overlay scrollers (NSScroller.m) lie over the content and take no room: the clip view and the
+ * header have the whole width and height, there is no corner, and a scroller that has nothing to scroll is
+ * hidden; legacy ones take their width as before and the square where they meet is painted. */
+extern const CGFloat SFOverlayScrollerWidth;
+
+@interface NSScroller (SFOverlay)
+-(void)_sfOverlayReveal;
+@end
+
+static BOOL sfOverlayScrollers(NSScrollView *self) {
+   NSScroller *scroller=[self verticalScroller];
+
+   if(scroller==nil)
+    scroller=[self horizontalScroller];
+   return scroller!=nil ? [(id)scroller scrollerStyle]==NSScrollerStyleOverlay : [NSScroller preferredScrollerStyle]==NSScrollerStyleOverlay;
+}
+
+// the room a shown scroller takes from the content
+static CGFloat sfScrollerRoom(NSScrollView *self) {
+   return sfOverlayScrollers(self)?0:[NSScroller scrollerWidth];
+}
+
 @implementation NSScrollView
 
+-(NSScrollerStyle)scrollerStyle {
+   return sfOverlayScrollers(self)?NSScrollerStyleOverlay:NSScrollerStyleLegacy;
+}
+
+// overlay scrollers that have something to scroll appear, and fade a second later
+-(void)flashScrollers {
+   if(!sfOverlayScrollers(self))
+    return;
+   if([self hasVerticalScroller] && ![_verticalScroller isHidden] && [_verticalScroller isEnabled])
+    [(id)_verticalScroller _sfOverlayReveal];
+   if([self hasHorizontalScroller] && ![_horizontalScroller isHidden] && [_horizontalScroller isEnabled])
+    [(id)_horizontalScroller _sfOverlayReveal];
+}
+
+-(void)setScrollerStyle:(NSScrollerStyle)style {
+   [(id)[self verticalScroller] setScrollerStyle:style];
+   [(id)[self horizontalScroller] setScrollerStyle:style];
+   [self tile];
+   [self setNeedsDisplay:YES];
+}
