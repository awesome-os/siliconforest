 static int windowPresent(struct wsWindow *window);
 
+/* AppKit ordered a window to the front (-makeKeyAndOrderFront:, Command-`, the Window menu): the
+ * compositor is asked through xdg_activation_v1, with the serial of the last input event and the
+ * window that has the keyboard, which its rule against stealing focus wants to see. */
+static void activationDone(void *data, struct xdg_activation_token_v1 *token, const char *string) {
+    int windowID = (int)(intptr_t)data;
+    struct wsWindow *window;
+
+    for (window = ws.windows; window != NULL && window->windowID != windowID; window = window->next) {}
+    if (window != NULL && window->surface != NULL && ws.activation != NULL) {
+        xdg_activation_v1_activate(ws.activation, string, window->surface);
+        wl_display_flush(ws.display);
+        if (getenv("SF_WS_TRACE") != NULL)
+            fprintf(stderr, "WindowServer: window %d asked to come forward\n", windowID);
+    }
+    xdg_activation_token_v1_destroy(token);
+}
+
+static const struct xdg_activation_token_v1_listener activationTokenListener = {
+    .done = activationDone,
+};
+
+static void windowActivate(struct wsWindow *window) {
+    struct wsWindow *focused;
+    struct xdg_activation_token_v1 *token;
+
+    if (ws.activation == NULL || window == NULL || window->surface == NULL || window->toplevel == NULL)
+        return;
+    token = xdg_activation_v1_get_activation_token(ws.activation);
+    xdg_activation_token_v1_add_listener(token, &activationTokenListener, (void *)(intptr_t)window->windowID);
+    if (ws.seat != NULL && ws.inputSerial != 0)
+        xdg_activation_token_v1_set_serial(token, ws.inputSerial, ws.seat);
+    for (focused = ws.windows; focused != NULL && focused->windowID != ws.focusWindowID; focused = focused->next) {}
+    if (focused != NULL && focused->surface != NULL)
+        xdg_activation_token_v1_set_surface(token, focused->surface);
+    xdg_activation_token_v1_commit(token);
+    wl_display_flush(ws.display);
+}
