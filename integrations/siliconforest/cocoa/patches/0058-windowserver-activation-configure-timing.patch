+/* Layer-shell surfaces are for upstream's own desktop processes (its menu bar, dock, desktop), which
+ * place them themselves: SF_WS_LAYER_SHELL=1. An application's windows are xdg toplevels and its
+ * menus and tool tips xdg popups of them, placed by the compositor, also where the compositor offers
+ * layer shell for its own dock (SiliconForest's does since 14 November: with it every menu became an
+ * overlay at a fixed place that no press outside dismissed, and a modal panel lost its parent). */
+static int wsUsesLayerShell(void) {
+    static int asked = -1;
+
+    if (asked < 0)
+        asked = getenv("SF_WS_LAYER_SHELL") != NULL && atoi(getenv("SF_WS_LAYER_SHELL")) != 0;
+    return asked && ws.layerShell != NULL;
+}
