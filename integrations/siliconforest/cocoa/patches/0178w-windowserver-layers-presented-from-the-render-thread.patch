+// (TERM12) the window's geometry serial (0: no such window): AppKit keeps it with the geometry of a view's GPU layer
+uint64_t _windowServerSFFXGeometrySerial(int windowID){
+    pthread_mutex_lock(&ws.pixelsLock);
+    struct wsWindow *window=windowForID(windowID);
+    uint64_t serial=window?window->geometrySerial:0;
+    pthread_mutex_unlock(&ws.pixelsLock);
+    return serial;
+}
+/* (TERM12) A frame of GPU layers from QuartzCore's render thread (SFFX_GPU_RENDER_THREAD=1): the window is presented as
+ * a flush after a layer-only change presents it (AppKit drew nothing into the backing store), from that thread. Only
+ * a window shown already, flushed at its current size, as a toplevel, with the geometry serial AppKit worked its
+ * layers' geometry out under; else 0 and the main thread does this frame (its flush prepares what the window needs). */
+int _windowServerSFFXPresentLayers(int windowID,uint64_t geometry){
+    const char *enabled=getenv("SFFX_GPU_PRESENT");
+    if(!enabled||strcmp(enabled,"1")||!ws.connected||!ws.dmabuf)return 0;
+    double began = wsTiming() ? wsNowMs() : 0;
+    pthread_mutex_lock(&ws.pixelsLock);
+    struct wsWindow *window=windowForID(windowID);
+    int good=window!=NULL&&window->geometrySerial==geometry&&window->flushed&&window->attached&&window->pixels!=NULL&&
+        window->surface!=NULL&&window->toplevel!=NULL&&window->configured&&!window->rolePrepared&&window->staleConfigures==0&&
+        window->gpuPresenter!=NULL&&!window->gpuPresenter->failed&&window->state!=MINIMIZED&&window->state!=HIDDEN&&
+        sfGPURoleTakesDmabuf(window);
+    if(!good&&getenv("SF_WS_TRACE")!=NULL)
+        fprintf(stderr,"WindowServer: render-thread present of %d declined: window %d serial %llu/%llu flushed %d attached %d configured %d state %d\n",
+                windowID,window!=NULL,window?(unsigned long long)window->geometrySerial:0ULL,(unsigned long long)geometry,
+                window?window->flushed:-1,window?window->attached:-1,window?window->configured:-1,window?window->state:-1);
+    if(good){
+        window->presentPending=0;
+        if(wsPacePresents()&&window->frameOut&&wsNowMs()-window->frameOutAt<100)
+            window->presentPending=1;
+        else{
+            window->presentMaySkip=1;
+            if(windowPresent(window)){
+                __atomic_add_fetch(&wsPresentCounts[1],1,__ATOMIC_RELAXED);
+                windowPacedCommit(window);
+                if(wsTiming())
+                    fprintf(stderr,"WSTIME %.1f commit-render-thread surface=%d frame=%p took=%.1f\n",wsNowMs(),window->windowID,
+                            (void *)window->front,wsNowMs()-began);
+            }
+        }
+    }
+    pthread_mutex_unlock(&ws.pixelsLock);
+    return good;
+}
