+/* The panel's layout: metrics and order of parts after Finch's NSAlert.m (Finch, an open Darwin for
+ * Apple Silicon, userland/AppKit/NSAlert.m at commit 2d9b1bb; SPDX-License-Identifier: MIT OR
+ * Apache-2.0; Copyright (c) 2026 The Finch Project contributors), "measured on macOS 26": 420 points
+ * wide at least, a 64-point icon at the top left, the bold message beside it and the informative
+ * text under it, both wrapped, then the accessory view and the suppression checkbox, the buttons
+ * along the bottom from the right (the first rightmost), each its title plus 32 and at least 82
+ * wide. Adapted to this AppKit's ivars and its string drawer. */
+#define ALERT_WIDTH 420.
+#define ALERT_MARGIN 20.
+#define ALERT_ICON 64.
+#define ALERT_BUTTON_HEIGHT 24.
+#define ALERT_BUTTON_GAP 12.
+#define ALERT_MIN_BUTTON 82.
+
+static NSImage *sfDefaultAlertIcon(void){
+   static NSImage *icon;
+
+   if(icon==nil)
+    icon=[[NSImage imageNamed:@"NSAlertPanelExclamation"] retain];
+   return icon;
+}
+
+static CGFloat sfAlertTextHeight(NSString *s,NSFont *font,CGFloat width){
+   if([s length]==0)
+    return 0;
+   // a label's cell draws its text 2 points in from each side
+   NSSize size=[[NSStringDrawer sharedStringDrawer] sizeOfString:s withAttributes:[NSDictionary dictionaryWithObject:font forKey:NSFontAttributeName] inSize:NSMakeSize(width-4,NSStringDrawerLargeDimension)];
+   return ceil(size.height)+2;
+}
+
+static CGFloat sfAlertButtonWidth(NSButton *button){
+   NSFont *font=[button font];
+
+   if(font==nil)
+    font=[NSFont systemFontOfSize:13];
+   CGFloat width=ceil([[button title] sizeWithAttributes:[NSDictionary dictionaryWithObject:font forKey:NSFontAttributeName]].width)+32;
+   return MAX(ALERT_MIN_BUTTON,width);
+}
+
+static NSTextField *sfAlertLabel(NSString *text,NSFont *font,NSRect frame){
+   NSTextField *field=[[[NSTextField alloc] initWithFrame:frame] autorelease];
+
+   [field setStringValue:text];
+   [field setFont:font];
+   [field setEditable:NO];
+   [field setSelectable:YES];
+   [field setBordered:NO];
+   [field setDrawsBackground:NO];
+   [[field cell] setWraps:YES];
+   [[field cell] setLineBreakMode:NSLineBreakByWordWrapping];
+   return field;
+}
