+/* The legacy alert functions (Terminal's question before closing a window or quitting with running
+ * processes) are NSAlert on macOS: the title is the alert's bold message, the formatted text its
+ * informative text, and the buttons answer NSAlertDefaultReturn, NSAlertAlternateReturn and
+ * NSAlertOtherReturn. */
+static NSAlert *sfLegacyAlert(NSAlertStyle style,NSString *title,NSString *message,NSString *defaultButton,NSString *alternateButton,NSString *otherButton){
+   NSAlert *alert=[[[NSAlert alloc] init] autorelease];
+
+   [alert setAlertStyle:style];
+   if(title!=nil)
+    [alert setMessageText:title];
+   [alert setInformativeText:message!=nil?message:@""];
+   [alert addButtonWithTitle:defaultButton!=nil?defaultButton:NSLocalizedStringFromTableInBundle(@"OK", nil, [NSBundle bundleForClass:[NSAlert class]], @"Default button title for NSAlert")];
+   if(alternateButton!=nil)
+    [alert addButtonWithTitle:alternateButton];
+   if(otherButton!=nil)
+    [alert addButtonWithTitle:otherButton];
+   return alert;
+}
+
+static NSInteger sfLegacyReturn(NSInteger code){
+   switch(code){
+    case NSAlertFirstButtonReturn: return NSAlertDefaultReturn;
+    case NSAlertSecondButtonReturn: return NSAlertAlternateReturn;
+    case NSAlertThirdButtonReturn: return NSAlertOtherReturn;
+    default: return code;
+   }
+}
 
