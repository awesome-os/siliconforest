 -(NSImage *)applicationIconImage {
+   // the bundle's icon (CFBundleIconFile) as soon as it is asked for, not only once launching finished
+   if(_applicationIconImage==nil){
+    NSString *name=[[[NSBundle mainBundle] infoDictionary] objectForKey:@"CFBundleIconFile"];
+
+    if([name isKindOfClass:[NSString class]] && [name length]>0){
+     NSString *type=[[name pathExtension] length]>0?[name pathExtension]:@"icns";
+     NSString *path=[[NSBundle mainBundle] pathForResource:[name stringByDeletingPathExtension] ofType:type];
+
+     if(path!=nil)
+      _applicationIconImage=[[NSImage alloc] initWithContentsOfFile:path];
+    }
+   }
    return _applicationIconImage;
 }
 
