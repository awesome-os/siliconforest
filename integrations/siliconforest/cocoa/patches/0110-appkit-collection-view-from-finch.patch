+/* (SiliconForest) a size archived as an NSValue or as its string, "{w, h}" */
+static BOOL
+archived_size(NSCoder *coder, NSString *key, NSSize *out)
+{
+    id v = [coder containsValueForKey:key] ? [coder decodeObjectForKey:key] : nil;
+    if ([v isKindOfClass:[NSString class]]) {
+        *out = NSSizeFromString(v);
+        return YES;
+    }
+    if ([v respondsToSelector:@selector(sizeValue)]) {
+        *out = [v sizeValue];
+        return YES;
+    }
+    return NO;
+}
+
+- (instancetype)initWithCoder:(NSCoder *)coder
+{
+    self = [super initWithCoder:coder];
+    if (!self)
+        return nil;
+    archived_size(coder, @"NSMinimumItemSize", &_minItemSize);
+    archived_size(coder, @"NSMaximumItemSize", &_maxItemSize);
+    if ([coder containsValueForKey:@"NSMaximumNumberOfRows"])
+        _maxRows = [coder decodeIntegerForKey:@"NSMaximumNumberOfRows"];
+    if ([coder containsValueForKey:@"NSMaximumNumberOfColumns"])
+        _maxColumns = [coder decodeIntegerForKey:@"NSMaximumNumberOfColumns"];
+    if ([coder containsValueForKey:@"NSMinimumInteritemSpacing"])
+        _interitemSpacing = [coder decodeDoubleForKey:@"NSMinimumInteritemSpacing"];
+    if ([coder containsValueForKey:@"NSMinimumLineSpacing"])
+        _lineSpacing = [coder decodeDoubleForKey:@"NSMinimumLineSpacing"];
+    _backgroundColors = [[coder decodeObjectForKey:@"NSBackgroundColors"] copy];
+    return self;
+}
