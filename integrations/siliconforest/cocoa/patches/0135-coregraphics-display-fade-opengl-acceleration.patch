 #import <CoreFoundation/CFRuntime.h>
 #include <dispatch/dispatch.h>
 #import <CoreGraphics/CGDirectDisplayMetal.h>
+#include <unistd.h>
 
 #define SILICONFOREST_MAIN_DISPLAY_ID ((CGDirectDisplayID)1)
 
@@ -295,6 +296,30 @@
     return false;
 }
 
+// (TERM7, imported by VLC 3's video output) whether OpenGL on this display is drawn by the GPU: the M1's Asahi
+// Mesa driver is installed at /usr/local/lib/mesa-asahi (an answer about the driver, not about whether a CGL
+// context can be made: CGL says that when asked)
+boolean_t CGDisplayUsesOpenGLAcceleration(CGDirectDisplayID display) {
+    return display == SILICONFOREST_MAIN_DISPLAY_ID && access("/usr/local/lib/mesa-asahi/libEGL.1.dylib", R_OK) == 0;
+}
+
+// (TERM7, imported by VLC 3's interface) display fades: the compositor offers no fade of the whole display,
+// so no reservation is ever available (as macOS answers while another client holds one); callers skip the fade
+CGError CGAcquireDisplayFadeReservation(CGDisplayReservationInterval seconds, CGDisplayFadeReservationToken *token) {
+    if (token != NULL)
+        *token = kCGDisplayFadeReservationInvalidToken;
+    return kCGErrorNoneAvailable;
+}
+
+CGError CGDisplayFade(CGDisplayFadeReservationToken token, CGDisplayFadeInterval duration, CGDisplayBlendFraction startBlend,
+                      CGDisplayBlendFraction endBlend, float redBlend, float greenBlend, float blueBlend, boolean_t synchronous) {
+    return kCGErrorIllegalArgument;   // no token was ever handed out
+}
+
+CGError CGReleaseDisplayFadeReservation(CGDisplayFadeReservationToken token) {
+    return kCGErrorIllegalArgument;
+}
+
 CGDirectDisplayID CGDisplayMirrorsDisplay(CGDirectDisplayID display) {
     return kCGNullDirectDisplay;
 }
