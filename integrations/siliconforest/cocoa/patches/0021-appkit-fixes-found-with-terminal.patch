+/* The fonts an application carries for its own use: the files in the directory its Info.plist
+ * names with ATSApplicationFontsPath (relative to its resources), registered for this process
+ * only, as macOS does when it starts the application. Fonts are found through three fontconfig
+ * configurations here (CoreText's registry, NSFont's name lookup, Onyx2D's face lookup): each
+ * gets the files. SFApplicationFonts=NO in the defaults (or the environment) leaves them out. */
+-(void)_registerApplicationFonts {
+   NSBundle *bundle=[NSBundle mainBundle];
+   id        relative=[bundle objectForInfoDictionaryKey:@"ATSApplicationFontsPath"];
+   const char *off=getenv("SFApplicationFonts");
+
+   if(![relative isKindOfClass:[NSString class]] || [bundle resourcePath]==nil)
+    return;
+   if((off!=NULL && (off[0]=='N' || off[0]=='n' || off[0]=='0')) ||
+      ([[NSUserDefaults standardUserDefaults] objectForKey:@"SFApplicationFonts"]!=nil && ![[NSUserDefaults standardUserDefaults] boolForKey:@"SFApplicationFonts"]))
+    return;
+
+   NSString *directory=[[bundle resourcePath] stringByAppendingPathComponent:relative];
+
+   for(NSString *name in [[NSFileManager defaultManager] contentsOfDirectoryAtPath:directory error:NULL]){
+    NSString *extension=[[name pathExtension] lowercaseString];
+
+    if(![extension isEqualToString:@"ttf"] && ![extension isEqualToString:@"otf"] && ![extension isEqualToString:@"ttc"])
+     continue;
+
+    NSString *path=[directory stringByAppendingPathComponent:name];
+
+    CTFontManagerRegisterFontsForURL((CFURLRef)[NSURL fileURLWithPath:path],kCTFontManagerScopeProcess,NULL);
+    FcConfigAppFontAddFile(O2FontSharedFontConfig(),(const FcChar8 *)[path fileSystemRepresentation]);
+    FcConfigAppFontAddFile(NULL,(const FcChar8 *)[path fileSystemRepresentation]);
+   }
+}
