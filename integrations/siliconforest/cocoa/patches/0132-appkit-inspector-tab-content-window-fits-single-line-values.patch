+// the view's width is set by something other than its own size: its frame, or a constraint that fixes its trailing
+// edge or its width (held by the view or by any view above it)
+static BOOL sfWidthSetFromOutside(NSView *view) {
+    if ([view translatesAutoresizingMaskIntoConstraints])
+        return YES;
+    for (NSView *holder = view; holder != nil; holder = [holder superview]) {
+        for (NSLayoutConstraint *c in [holder constraints]) {
+            NSLayoutAttribute a;
+
+            if (![c isActive] || [c priority] < NSLayoutPriorityDefaultHigh || [c relation] != NSLayoutRelationEqual)
+                continue;
+            if ([c firstItem] == view)
+                a = [c firstAttribute];
+            else if ([c secondItem] == view)
+                a = [c secondAttribute];
+            else
+                continue;
+            if (a == NSLayoutAttributeTrailing || a == NSLayoutAttributeRight || a == NSLayoutAttributeWidth)
+                return YES;
+        }
+    }
+    return NO;
+}
