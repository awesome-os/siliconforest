+/* As macOS keeps a window at least as large as the required constraints of its content: a window about to be
+ * shown, or whose tab view showed another tab, is made larger (its top left kept) where its content's fitting
+ * size is larger than its content. Activity Monitor's inspector came out at its nib's 274 points, its tab's rows
+ * squeezed one over another. Only for a content view laid out by constraints; never past contentMaxSize. */
+-(void)_sfGrowToFitContent {
+   NSView *content=[self contentView];
+
+   if(content==nil || [[content performSelector:@selector(constraints)] count]==0)
+    return;
+
+   NSSize fit=((NSSize (*)(id,SEL))objc_msgSend)(content,@selector(fittingSize)),now=[content frame].size;
+
+   if(fit.width<=now.width+0.5 && fit.height<=now.height+0.5)
+    return;
+
+   NSSize want=NSMakeSize(MAX(now.width,ceil(fit.width)),MAX(now.height,ceil(fit.height)));
+   NSSize max=[self contentMaxSize];
+
+   if(max.width>0 && want.width>max.width) want.width=MAX(now.width,max.width);
+   if(max.height>0 && want.height>max.height) want.height=MAX(now.height,max.height);
+
+   NSRect frame=[self frame];
+   NSRect newFrame=[self frameRectForContentRect:NSMakeRect(0,0,want.width,want.height)];
+
+   newFrame.origin.x=frame.origin.x;
+   newFrame.origin.y=NSMaxY(frame)-newFrame.size.height;
+   if(getenv("SF_WINFRAME_TRACE")!=NULL)
+    fprintf(stderr,"PD-WINFRAME %p grows to fit its content: content %s, fitting %s\n",self,[NSStringFromSize(now) UTF8String],[NSStringFromSize(fit) UTF8String]);
+   [self setFrame:newFrame display:_isVisible];
+}
