+/* A sheet's toplevel names its parent's, so that the compositor keeps it over the parent and
+ * centres it there (AppKit's frame of the parent is not where the compositor put it). */
+static void windowApplyParent(struct wsWindow *window) {
+    struct wsWindow *parent = window->parentID != 0 ? windowForID(window->parentID) : NULL;
+
+    if (window->toplevel == NULL)
+        return;
+    xdg_toplevel_set_parent(window->toplevel, parent != NULL ? parent->toplevel : NULL);
+}
