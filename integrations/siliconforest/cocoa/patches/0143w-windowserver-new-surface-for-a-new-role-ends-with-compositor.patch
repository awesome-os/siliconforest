+// (TERM8) a fresh wl_surface for a window whose next role differs from the one its surface has
+static void windowRenewSurface(struct wsWindow *window) {
+    if (getenv("SF_WS_TRACE") != NULL)
+        fprintf(stderr, "WindowServer: window %d gets a new surface (its role changes kind)\n", window->windowID);
+    if (window->blurEffect != NULL) {
+        ext_background_effect_surface_v1_destroy(window->blurEffect);
+        window->blurEffect = NULL;
+        window->blurDirty = 1;
+    }
+    if (window->fractional != NULL) { wp_fractional_scale_v1_destroy(window->fractional); window->fractional = NULL; }
+    if (window->viewport != NULL)   { wp_viewport_destroy(window->viewport); window->viewport = NULL; }
+    wl_surface_destroy(window->surface);
+    window->surface = wl_compositor_create_surface(ws.compositor);
+    if (ws.fractionalManager != NULL && ws.viewporter != NULL) {
+        window->fractional = wp_fractional_scale_manager_v1_get_fractional_scale(ws.fractionalManager, window->surface);
+        wp_fractional_scale_v1_add_listener(window->fractional, &fractionalListener, window);
+        window->viewport = wp_viewporter_get_viewport(ws.viewporter, window->surface);
+    }
+    window->attached = 0;
+    window->opaqueDirty = 1;
+    window->inputDirty = 1;
+    window->surfaceRole = WS_ROLE_NONE;
+}
+
+// (TERM8) before a role of `kind` goes on the window's surface: a surface that had another kind is replaced
+static void windowSurfaceForRole(struct wsWindow *window, int kind) {
+    if (window->surfaceRole != WS_ROLE_NONE && window->surfaceRole != kind)
+        windowRenewSurface(window);
+    window->surfaceRole = kind;
+}
