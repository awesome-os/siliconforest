+-(void)_sfFullScreenUnanswered {
+   int asked=sfFullScreenAsked(self);
+
+   if(asked==0)
+    return;
+   sfSetFullScreenAsked(self,0);
+   NSLog(@"AppKit: the compositor did not %@ full screen", asked>0 ? @"enter" : @"leave");
+   if(asked>0){
+    _styleMask&=~(NSUInteger)NSFullScreenWindowMask;
+    objc_setAssociatedObject(self,&fullScreenFrameKey,nil,OBJC_ASSOCIATION_RETAIN);
+   }
+   else
+    _styleMask|=NSFullScreenWindowMask;
+   [self _updateWSState];
+   [_backgroundView setNeedsDisplay:YES];
+}
+
+// the compositor's answer: in full screen or out of it, asked for here or by its own keys
+-(void)_sfServerFullScreen:(BOOL)on {
