+/* The whole device pixels a clip covers: rounded out, but an edge within a thousandth of a pixel of a
+ * boundary is on it. A rectangle of whole pixels that went to points and back (a dirty rect at 150 %, where
+ * a window's pixels per point are 719/479) ends a hair past its last row: rounded out, the clip took one
+ * more row, which the window's clear made transparent and the view's fill of the same rect did not cover,
+ * so a translucent Terminal showed a hard line of the desk between its rows. */
+static O2Rect sfIntegralClip(O2Rect r){
+   const O2Float e=1.0/1024;
+   O2Float x0=floor(O2RectGetMinX(r)+e),y0=floor(O2RectGetMinY(r)+e),x1=ceil(O2RectGetMaxX(r)-e),y1=ceil(O2RectGetMaxY(r)-e);
+
+   if(!(r.size.width>0) || !(r.size.height>0) || !isfinite(r.origin.x) || !isfinite(r.origin.y) || !isfinite(r.size.width) || !isfinite(r.size.height))
+    return O2RectIntegral(r);
+   if(x1<x0)
+    x1=x0;
+   if(y1<y0)
+    y1=y0;
+   return O2RectMake(x0,y0,x1-x0,y1-y0);
+}
