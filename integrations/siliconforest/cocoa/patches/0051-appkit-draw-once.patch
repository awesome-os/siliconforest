+// a tab dragged along the bar to another place
+- (void)_sfMoveWindow:(NSWindow *)window toIndex:(NSUInteger)index
+{
+    NSUInteger from = [_windows indexOfObjectIdenticalTo:window];
+
+    if (from == NSNotFound || index >= [_windows count] || index == from)
+        return;
+    CFArrayRemoveValueAtIndex((CFMutableArrayRef)_windows, from);
+    CFArrayInsertValueAtIndex((CFMutableArrayRef)_windows, index, window);
+    [self _sfUpdateBars];
+}
