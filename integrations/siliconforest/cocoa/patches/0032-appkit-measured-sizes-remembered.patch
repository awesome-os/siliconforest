+/* Measuring is a pass of the whole text system (about 5 ms for a word on the M1), and interfaces
+ * measure the same few strings over and over: a menu's titles for every rectangle it asks for, a
+ * terminal the cell of each font of each of its profiles. The size of a string in one set of
+ * attributes with no bound is remembered (a few hundred of them; forgotten together when full). */
+#define SF_SIZE_CACHE_LIMIT 600
+
+-(BOOL)_sfCachedSize:(NSSize *)size ofString:(NSString *)string attributes:(NSDictionary *)attributes {
+   NSValue *value;
+
+   if(string==nil || [string length]>256)
+    return NO;
+   value=[[_sfSizes objectForKey:(attributes!=nil)?(id)attributes:(id)[NSNull null]] objectForKey:string];
+   if(value==nil)
+    return NO;
+   *size=[value sizeValue];
+   return YES;
+}
+
+-(void)_sfRememberSize:(NSSize)size ofString:(NSString *)string attributes:(NSDictionary *)attributes {
+   id key=(attributes!=nil)?(id)attributes:(id)[NSNull null];
+   NSMutableDictionary *strings;
+
+   if(string==nil || [string length]>256)
+    return;
+   if(_sfSizes==nil)
+    _sfSizes=[[NSMutableDictionary alloc] init];
+   if(_sfSizeCount>=SF_SIZE_CACHE_LIMIT){
+    [_sfSizes removeAllObjects];
+    _sfSizeCount=0;
+   }
+   strings=[_sfSizes objectForKey:key];
+   if(strings==nil){
+    strings=[NSMutableDictionary dictionary];
+    [_sfSizes setObject:strings forKey:[[key copy] autorelease]];
+   }
+   [strings setObject:[NSValue valueWithSize:size] forKey:[[string copy] autorelease]];
+   _sfSizeCount++;
+}
