+/* The content bindings. "content" is the array of the objects the items stand for, "contentObjects"
+ * (optional) what each item represents instead, "contentValues" (optional) what each item is
+ * called. Whichever arrives first makes the items; the others fill them in by index. A value that
+ * is not an array (a placeholder for "no selection") is no items. (Every array used to be given
+ * to -addItemsWithTitles: as if it held strings.) */
+static NSArray *sfBindingArray(id values) {
+    return [values isKindOfClass:[NSArray class]] ? values : [NSArray array];
+}
+
+static NSString *sfBindingTitle(id value) {
+    if([value isKindOfClass:[NSString class]])
+        return value;
+    if(value==nil || value==[NSNull null])
+        return @"";
+    return [value description];
+}
+
+// the items changed: what the selection is bound to is selected among the new items
+-(void)_sfSelectionFollowsContent {
+    static NSString * const names[]={@"selectedObject",@"selectedValue",@"selectedTag",@"selectedIndex"};
+    int i;
+
+    for(i=0;i<4;i++){
+        id binder=[self _binderForBinding:names[i]];
+
+        if(binder!=nil && [binder respondsToSelector:@selector(syncUp)]){
+            [binder syncUp];
+            break;
+        }
+    }
+}
+
+-(void)_sfSetItemCount:(NSUInteger)count {
+    NSInteger selected=[self indexOfSelectedItem];
+
+    while((NSUInteger)[_cell numberOfItems]>count)
+        [_cell removeItemAtIndex:[_cell numberOfItems]-1];
+    while((NSUInteger)[_cell numberOfItems]<count)
+        [[_cell menu] addItemWithTitle:@"" action:NULL keyEquivalent:@""];
+    if(selected>=(NSInteger)count)
+        [self selectItem:nil];
 }
 
