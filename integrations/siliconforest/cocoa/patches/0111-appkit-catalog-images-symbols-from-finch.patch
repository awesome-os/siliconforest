@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT
+ * SiliconForest (cocoa 0111): the two codec libraries the asset catalog's bitmaps need, found at run time
+ * (this AppKit is not linked against them, and a root without /usr/lib/libcompression.dylib still runs:
+ * its compressed images are then not read). zlib's types come from the SDK's header; libcompression's
+ * names and values are macOS's public ones.
+ */
+#ifndef SFCUICODECS_H
+#define SFCUICODECS_H
+#include <dlfcn.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <zlib.h>
+
+typedef enum {
+    COMPRESSION_LZ4 = 0x100,
+    COMPRESSION_ZLIB = 0x205,
+    COMPRESSION_LZMA = 0x306,
+    COMPRESSION_LZ4_RAW = 0x101,
+    COMPRESSION_BROTLI = 0xB02,
+    COMPRESSION_LZFSE = 0x801,
+    COMPRESSION_LZBITMAP = 0x702,
+} compression_algorithm;
+
+static inline void *sf_cui_symbol(const char *library, const char *name)
+{
+    void *h = dlopen(library, RTLD_LAZY | RTLD_LOCAL);
+    return h ? dlsym(h, name) : NULL;
+}
+
+static inline size_t sf_compression_decode_buffer(uint8_t *dst, size_t dst_size, const uint8_t *src, size_t src_size,
+                                                  void *scratch, compression_algorithm algorithm)
+{
+    static size_t (*fn)(uint8_t *, size_t, const uint8_t *, size_t, void *, compression_algorithm);
+    static int looked;
+    if (!looked) {
+        fn = (size_t (*)(uint8_t *, size_t, const uint8_t *, size_t, void *, compression_algorithm))
+            sf_cui_symbol("/usr/lib/libcompression.dylib", "compression_decode_buffer");
+        looked = 1;
+    }
+    return fn ? fn(dst, dst_size, src, src_size, scratch, algorithm) : 0;
+}
+#define compression_decode_buffer sf_compression_decode_buffer
+
+static inline int sf_inflateInit2_(z_streamp strm, int windowBits, const char *version, int stream_size)
+{
+    int (*fn)(z_streamp, int, const char *, int) = (int (*)(z_streamp, int, const char *, int))sf_cui_symbol("/usr/lib/libz.1.dylib", "inflateInit2_");
+    return fn ? fn(strm, windowBits, version, stream_size) : Z_VERSION_ERROR;
+}
+static inline int sf_inflate(z_streamp strm, int flush)
+{
+    int (*fn)(z_streamp, int) = (int (*)(z_streamp, int))sf_cui_symbol("/usr/lib/libz.1.dylib", "inflate");
+    return fn ? fn(strm, flush) : Z_STREAM_ERROR;
+}
+static inline int sf_inflateEnd(z_streamp strm)
+{
+    int (*fn)(z_streamp) = (int (*)(z_streamp))sf_cui_symbol("/usr/lib/libz.1.dylib", "inflateEnd");
+    return fn ? fn(strm) : Z_STREAM_ERROR;
+}
+#undef inflateInit2
+#define inflateInit2(strm, windowBits) sf_inflateInit2_((strm), (windowBits), ZLIB_VERSION, (int)sizeof(z_stream))
+#define inflate sf_inflate
+#define inflateEnd sf_inflateEnd
+#endif
