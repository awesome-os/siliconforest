+            g->draw(g->w, g->h, p.fill);
+        }
+        if (p.slash) {
+            CGContextSaveGState(cg);
+            CGContextSetBlendMode(cg, kCGBlendModeClear);
+            line(1, gh, gw, 1);
+            CGContextRestoreGState(cg);
+            line(1.5, gh - 0.5, gw - 0.5, 1.5);
+        }
+        if (p.badge == 4) {
+            SymbolGlyph *b = p.badgeGlyph;
+            CGFloat r = MIN(gw, gh) * 0.3, cx = gw - r, cy = r;
+            CGContextSaveGState(cg);
+            CGContextSetBlendMode(cg, kCGBlendModeClear);
+            circle(cx, cy, r + 1.2, YES);
+            CGContextRestoreGState(cg);
+            CGFloat s = 2 * r / MAX(b->w, b->h);
+            NSAffineTransform *in = [NSAffineTransform transform];
+            [in translateXBy:cx - b->w * s / 2 yBy:cy - b->h * s / 2];
+            [in scaleBy:s];
+            [NSGraphicsContext saveGraphicsState];
+            [in concat];
+            kStroke = stroke / s * 0.8;
+            b->draw(b->w, b->h, p.fill);
+            [NSGraphicsContext restoreGraphicsState];
+            kStroke = stroke;
+        } else if (p.badge) {
+            CGFloat r = MIN(gw, gh) * 0.24, cx = gw - r, cy = r;
+            CGContextSaveGState(cg);
+            CGContextSetBlendMode(cg, kCGBlendModeClear);
+            circle(cx, cy, r + 1, YES);
+            CGContextRestoreGState(cg);
+            circle(cx, cy, r, YES);
+            CGContextSaveGState(cg);
+            CGContextSetBlendMode(cg, kCGBlendModeClear);
+            kStroke = stroke * 0.8;
+            if (p.badge == 1)
+                plus(cx, cy, r * 0.55);
+            else if (p.badge == 2)
+                line(cx - r * 0.55, cy, cx + r * 0.55, cy);
+            else
+                POLY(NO, NO, cx - r * 0.5, cy, cx - r * 0.1, cy - r * 0.45, cx + r * 0.55, cy + r * 0.45);
+            CGContextRestoreGState(cg);
+        }
+        kStroke = saved;
+    }
+    [context flushGraphics];
+    [NSGraphicsContext restoreGraphicsState];
+    [rep setSize:size];
+    NSImage *im = [[[NSImage alloc] initWithSize:size] autorelease];
+    [im addRepresentation:rep];
+    [rep release];
+    [im setTemplate:YES];
+    return im;
+}
