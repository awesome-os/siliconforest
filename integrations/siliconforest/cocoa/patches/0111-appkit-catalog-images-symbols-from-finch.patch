+/*
+ * SiliconForest (cocoa 0111): +[NSImage imageNamed:] finds an image of the application's asset catalog
+ * (Contents/Resources/Assets.car) when its bundle has no image file of that name, as macOS's does.
+ * The choice of rendition (best_rendition, with its scores) and the making of a CGImage from a bitmap
+ * rendition (image_from_csi) are taken from Finch's userland/CoreUI/CUICatalog.m at 2d9b1bb
+ * (docs/roadmap/issues/SF-AA-activity-monitor.md, "Taken from Finch"); changed here: device colour
+ * spaces (Onyx2D has no named ones), a rendition packed into an atlas is cut out of it as Finch's
+ * CUINamedImage does, and vector (PDF) renditions are not drawn. The lookup itself is ours.
+ */
+#import <AppKit/NSImage.h>
+#import <AppKit/NSScreen.h>
+#import <Foundation/Foundation.h>
+#import <CoreGraphics/CoreGraphics.h>
+#include "SFCUIPrivate.h"
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+static BOOL
+is_bitmap_layout(unsigned layout)
+{
+    return (layout >= 10 && layout < 1000 && layout != CUI_LAYOUT_GRADIENT && layout != CUI_LAYOUT_EFFECT) ||
+           layout == CUI_LAYOUT_INTERNAL_LINK;
+}
+
+typedef struct {
+    double scale;
+    long idiom, gamut, direction;
+    unsigned long subtype;
+    uint16_t appearance;
+} query;
+
+static int
+pref(unsigned have, unsigned want)
+{
+    return have == want ? 2 : have == 0 ? 1 : 0;
+}
+
+static int
+scale_score(unsigned have, double want)
+{
+    unsigned w = (unsigned)ceil(want);
+    if (have == w)
+        return 1000;
+    if (have && have < w)
+        return 500 + (int)have;
+    if (!have)
+        return 400;
+    return 300 - (int)have;
+}
+
+#define NSCORES 12
+
+static int
+compare_scores(const int *a, const int *b)
+{
+    for (int j = 0; j < NSCORES; j++)
+        if (a[j] != b[j])
+            return a[j] > b[j] ? 1 : -1;
+    return 0;
+}
+
+/* (Finch) the best image rendition for a name; images may come from any part under the name's identifier */
+static const cui_rendition *
+best_rendition(cui_store *s, const cui_facet *f, const query *q, cui_csi *out)
+{
+    size_t first, n = cui_store_renditions_for_identifier(s, f->attrs.v[CUI_ATTR_IDENTIFIER], &first);
+    const cui_rendition *best = NULL;
+    int bscore[NSCORES] = {0};
+    for (size_t i = first; i < first + n; i++) {
+        const cui_rendition *r = &s->rends[i];
+        const uint16_t *k = r->key.v;
+        BOOL ok = YES;
+        for (int a = 0; a < CUI_ATTR_MAX && ok; a++)
+            if (((f->mask >> a) & 1) && a != CUI_ATTR_PART)
+                ok = k[a] == f->attrs.v[a];
+        if (!ok || k[CUI_ATTR_APPEARANCE] != q->appearance)
+            continue;
+        int sc[NSCORES];
+        sc[0] = k[CUI_ATTR_PART] == ((f->mask >> CUI_ATTR_PART) & 1 ? f->attrs.v[CUI_ATTR_PART] : 0);
+        sc[1] = 2 * scale_score(k[CUI_ATTR_SCALE], q->scale);
+        sc[2] = pref(k[CUI_ATTR_IDIOM], (unsigned)q->idiom);
+        sc[3] = pref(k[CUI_ATTR_SUBTYPE], (unsigned)q->subtype);
+        sc[4] = pref(k[CUI_ATTR_GAMUT], (unsigned)q->gamut);
+        if (!sc[2] || !sc[3] || !sc[4])
+            continue;
+        sc[5] = k[CUI_ATTR_DIRECTION] == q->direction ? 2 : k[CUI_ATTR_DIRECTION] == 0 ? 1 : 0;
+        sc[6] = k[CUI_ATTR_LOCALIZATION] == 0;
+        sc[7] = k[CUI_ATTR_DEPLOYMENT];
+        sc[8] = (k[CUI_ATTR_SIZE_CLASS_H] == 0) + (k[CUI_ATTR_SIZE_CLASS_V] == 0) + (k[CUI_ATTR_MEMORY_CLASS] == 0) +
+                (k[CUI_ATTR_GRAPHICS_CLASS] == 0) + (k[CUI_ATTR_GLYPH_WEIGHT] == 0) + (k[CUI_ATTR_GLYPH_SIZE] == 0);
+        sc[9] = (k[CUI_ATTR_STATE] == 0) + (k[CUI_ATTR_VALUE] == 0) + (k[CUI_ATTR_DIMENSION1] == 0) +
+                (k[CUI_ATTR_LAYER] == 0) + (k[CUI_ATTR_PRESENTATION_STATE] == 0) + (k[CUI_ATTR_PREVIOUS_STATE] == 0) +
+                (k[CUI_ATTR_PREVIOUS_VALUE] == 0) + (k[CUI_ATTR_SIZE] == 0);
+        sc[10] = k[CUI_ATTR_DIMENSION2];
+        sc[11] = 1;
+        if (compare_scores(sc, bscore) <= 0)
+            continue;
+        cui_csi c;
+        if (!cui_csi_parse(r->csi, r->len, &c) || !is_bitmap_layout(c.layout))
+            continue;
+        best = r;
+        *out = c;
+        memcpy(bscore, sc, sizeof sc);
+    }
+    return best;
+}
+
+static void
+release_pixels(void *info, const void *data, size_t size)
+{
+    free((void *)data);
+}
+
+/* (Finch's FinchCUICreateImageFromCSI) RGBA or gray and alpha, premultiplied; the alpha skipped when opaque */
+static CGImageRef
+image_from_csi(const cui_csi *c)
+{
+    if (c->pixel_format == CUI_FOURCC('J', 'P', 'E', 'G')) {
+        size_t len;
+        uint8_t *raw = cui_csi_raw_data(c, &len);
+        if (!raw)
+            return NULL;
+        CFDataRef d = CFDataCreateWithBytesNoCopy(NULL, raw, (CFIndex)len, kCFAllocatorMalloc);
+        CGImageSourceRef src = CGImageSourceCreateWithData(d, NULL);
+        CGImageRef im = src ? CGImageSourceCreateImageAtIndex(src, 0, NULL) : NULL;
+        if (src)
+            CFRelease(src);
+        CFRelease(d);
+        return im;
+    }
+    cui_bitmap b;
+    if (!cui_csi_decode_bitmap(c, &b))
+        return NULL;
+    CGColorSpaceRef cs;
+    CGBitmapInfo info;
+    size_t bpp;
+    if (b.format == CUI_FOURCC('A', 'R', 'G', 'B')) {
+        /* BGRA in memory, premultiplied */
+        cs = CGColorSpaceCreateDeviceRGB();
+        info = kCGBitmapByteOrder32Little | (b.opaque ? kCGImageAlphaNoneSkipFirst : kCGImageAlphaPremultipliedFirst);
+        bpp = 32;
+    } else if (b.format == CUI_FOURCC('G', 'A', '8', ' ')) {
+        /* gray and alpha: made RGBA, which every Onyx2D path draws */
+        uint8_t *rgba = malloc(b.width * b.height * 4);
+        if (!rgba) {
+            free(b.pixels);
+            return NULL;
+        }
+        for (size_t y = 0; y < b.height; y++)
+            for (size_t x = 0; x < b.width; x++) {
+                const uint8_t *p = b.pixels + y * b.rowbytes + 2 * x;
+                uint8_t *o = rgba + 4 * (y * b.width + x);
+                o[0] = o[1] = o[2] = p[0];
+                o[3] = p[1];
+            }
+        free(b.pixels);
+        b.pixels = rgba, b.rowbytes = b.width * 4;
+        cs = CGColorSpaceCreateDeviceRGB();
+        info = (CGBitmapInfo)(b.opaque ? kCGImageAlphaNoneSkipLast : kCGImageAlphaPremultipliedLast);
+        bpp = 32;
+    } else {
+        free(b.pixels);     /* half-float renditions ('GA16', 'RGBW') are not drawn here */
+        return NULL;
+    }
+    CGDataProviderRef dp = CGDataProviderCreateWithData(NULL, b.pixels, b.rowbytes * b.height, release_pixels);
+    CGImageRef im = CGImageCreate(b.width, b.height, 8, bpp, b.rowbytes, cs, info, dp, NULL, true, kCGRenderingIntentDefault);
+    CGDataProviderRelease(dp);
+    CGColorSpaceRelease(cs);
+    return im;
+}
+
+static cui_store *
+catalog_of_bundle(NSBundle *bundle)
+{
+    static NSMutableDictionary *catalogs;
+    NSString *key = [bundle bundlePath];
+    if (key == nil)
+        return NULL;
+    @synchronized([NSImage class]) {
+        if (catalogs == nil)
+            catalogs = [[NSMutableDictionary alloc] init];
+        id v = [catalogs objectForKey:key];
+        if (v == nil) {
+            NSString *path = [bundle pathForResource:@"Assets" ofType:@"car"];
+            cui_store *store = path ? cui_store_open([path fileSystemRepresentation]) : NULL;
+            v = store ? (id)[NSValue valueWithPointer:store] : (id)[NSNull null];
+            [catalogs setObject:v forKey:key];
+        }
+        return [v isKindOfClass:[NSValue class]] ? [v pointerValue] : NULL;
+    }
+}
+
+@implementation NSImage (SFCatalogImages)
+
++ (NSImage *)_sfCatalogImageNamed:(NSString *)name
+{
+    cui_store *store = name ? catalog_of_bundle([NSBundle mainBundle]) : NULL;
+    const cui_facet *facet = store ? cui_store_facet(store, [name UTF8String]) : NULL;
+    if (facet == NULL)
+        return nil;
+    CGFloat backing = [[NSScreen mainScreen] backingScaleFactor];
+    query q = { backing > 1 ? backing : 1, 0, 0, 0, 0, 0 };
+    uint16_t aqua = 0;
+    cui_csi csi;
+    const cui_rendition *r = NULL;
+    if (cui_store_appearance(store, "NSAppearanceNameAqua", &aqua)) {
+        q.appearance = aqua;
+        r = best_rendition(store, facet, &q, &csi);
+    }
+    if (r == NULL) {
+        q.appearance = 0;
+        r = best_rendition(store, facet, &q, &csi);
+    }
+    if (r == NULL)
+        return nil;
+    CGImageRef cg = NULL;
+    if (csi.layout == CUI_LAYOUT_INTERNAL_LINK) {
+        cui_key key;
+        uint32_t frame[4];
+        const cui_rendition *atlas = cui_csi_link(&csi, &key, frame, NULL) ? cui_store_rendition_with_key(store, &key) : NULL;
+        cui_csi ac;
+        CGImageRef whole = (atlas && cui_csi_parse(atlas->csi, atlas->len, &ac)) ? image_from_csi(&ac) : NULL;
+        if (whole) {
+            /* the frame's origin is the atlas's bottom left */
+            cg = CGImageCreateWithImageInRect(whole, CGRectMake(frame[0], (CGFloat)CGImageGetHeight(whole) - frame[1] - frame[3], frame[2], frame[3]));
+            CGImageRelease(whole);
+        }
+    } else {
+        cg = image_from_csi(&csi);
+    }
+    if (cg == NULL)
+        return nil;
+    double scale = csi.scale100 ? csi.scale100 / 100.0 : 1;
+    NSImage *image = [[[NSImage alloc] initWithCGImage:cg size:NSMakeSize(CGImageGetWidth(cg) / scale, CGImageGetHeight(cg) / scale)] autorelease];
+    CGImageRelease(cg);
+    if (cui_csi_template_mode(&csi) == 1)
+        [image setTemplate:YES];
+    return image;
+}
+
