+    const CGFloat px = 3;
+    NSBitmapImageRep *rep = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:(NSInteger)(size.width * px)
+                                                                    pixelsHigh:(NSInteger)(size.height * px) bitsPerSample:8
+                                                               samplesPerPixel:4 hasAlpha:YES isPlanar:NO
+                                                                colorSpaceName:NSDeviceRGBColorSpace bytesPerRow:0 bitsPerPixel:0];
+    NSGraphicsContext *context = [NSGraphicsContext graphicsContextWithBitmapImageRep:rep];
+    NSRect dst = NSMakeRect(0, 0, size.width, size.height);
+    [NSGraphicsContext saveGraphicsState];
+    [NSGraphicsContext setCurrentContext:context];
+    {
+        CGFloat saved = kStroke;
+        kStroke = stroke;
+        NSAffineTransform *t = [NSAffineTransform transform];
+        [t scaleBy:px];
+        [t translateXBy:dst.origin.x yBy:dst.origin.y];
+        [t scaleXBy:dst.size.width / gw yBy:dst.size.height / gh];
+        [t concat];
+        [[NSColor blackColor] set];
+        CGContextRef cg = (CGContextRef)[context graphicsPort];
+        if (p.enclosure) {
+            NSBezierPath *outline = p.enclosure == 1 ? [NSBezierPath bezierPathWithOvalInRect:NSMakeRect(1, 1, gw - 2, gh - 2)]
+                                                     : [NSBezierPath bezierPathWithRoundedRect:NSMakeRect(1, 1, gw - 2, gh - 2)
+                                                                                      xRadius:3.5
+                                                                                      yRadius:3.5];
