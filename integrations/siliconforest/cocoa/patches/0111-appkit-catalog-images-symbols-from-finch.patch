+@interface NSImageSymbolConfiguration (FinchSymbols)
+- (void)_finchPointSize:(CGFloat *)pointSize weight:(NSFontWeight *)weight hasWeight:(BOOL *)hasWeight scale:(NSImageSymbolScale *)scale;
+@end
