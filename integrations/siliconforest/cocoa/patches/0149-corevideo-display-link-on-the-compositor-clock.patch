         fillTimeStamp(&out, frame + 1, start, period);
-
-        NSAutoreleasePool *pool = [NSAutoreleasePool new];
-        if (link->_callback != NULL)
-            link->_callback(link, &now, &out, 0, &flagsOut, link->_userInfo);
-        [pool release];
+        last = at;
+        displayLinkCall(link, &now, &out);
     }
