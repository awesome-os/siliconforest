+// (FXPERF2) whether anything was drawn into a window's own backing store since its last layer-only flush: when not,
+// that flush tells the window server so (it skips comparing the whole backing store with what it uploaded last)
+static char sfSFFXBaseDrawnKey;
+static void sfSFFXNoteBaseDrawn(NSWindow *window){
+ if(window!=nil&&objc_getAssociatedObject(window,&sfSFFXBaseDrawnKey)==nil)
+  objc_setAssociatedObject(window,&sfSFFXBaseDrawnKey,(id)kCFBooleanTrue,OBJC_ASSOCIATION_ASSIGN);
+}
+static void sfSFFXFlushLayersOnly(NSWindow *window){
+ static void (*unchanged)(int);
+ static int looked;
+ if(!looked){
+  const char *gpu=getenv("SFFX_GPU_DAMAGE");
+  unchanged=(gpu&&!strcmp(gpu,"1"))?(void (*)(int))dlsym(RTLD_DEFAULT,"_windowServerSFFXBaseUnchanged"):NULL;
+  looked=1;
+ }
+ BOOL drawn=objc_getAssociatedObject(window,&sfSFFXBaseDrawnKey)!=nil;
+ if(drawn)
+  objc_setAssociatedObject(window,&sfSFFXBaseDrawnKey,nil,OBJC_ASSOCIATION_ASSIGN);
+ if(unchanged!=NULL&&!drawn&&![window isFlushWindowDisabled])
+  unchanged((int)[window windowNumber]);
+ [window flushWindow];
+}
