+/* SF_WS_SCALE=<percent> (a test instrument): the application draws its backing stores at that scale
+ * whatever the compositor prefers (which then scales the buffers to the output), e.g. 100 or 200 on a
+ * panel at 150 %, to see one program's drawing at every scale without changing the desk's. */
+static int wsForcedScale120(void) {
+    static int forced = -1;
+
+    if (forced < 0) {
+        const char *percent = getenv("SF_WS_SCALE");
+
+        forced = percent != NULL ? (atoi(percent) * 120 + 50) / 100 : 0;
+        if (forced < 60 || forced > 120 * 8)
+            forced = 0;
+    }
+    return forced;
+}
