+/*
+ * The window server. On macOS a process reaches it through the Mach service
+ * com.apple.windowserver.active, and a profile that lets its process have windows says
+ * (allow mach-lookup (global-name "com.apple.windowserver.active")). Here the window server is
+ * the Wayland compositor, reached through a Unix socket, and Mach lookups are not something
+ * this policy checks at all - so that permission, and only it, is also written as what it
+ * means on this system: an outbound connection to the compositor's socket, the one path
+ * $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY names in the process that is sandboxing itself. A profile
+ * without the permission gets nothing (a browser's content process is headless here as it
+ * is on macOS), and nothing else about the socket's directory is opened up.
+ */
+static void
+emit_window_server_rules(struct compiler *c, int line)
+{
+	const char *display = getenv("WAYLAND_DISPLAY");
+	const char *runtime = getenv("XDG_RUNTIME_DIR");
+	char path[PATH_MAX], resolved[PATH_MAX];
+
+	if (display == NULL || display[0] == '\0') {
+		display = "wayland-0";
+	}
+	if (display[0] == '/') {
+		snprintf(path, sizeof(path), "%s", display);
+	} else if (runtime != NULL && runtime[0] == '/') {
+		snprintf(path, sizeof(path), "%s/%s", runtime, display);
+	} else {
+		return;
+	}
+	/* the kernel checks the path the socket really has (/var is /private/var) */
+	emit_rule(c, line, SB_OP_NETWORK_OUTBOUND, SB_ACTION_ALLOW, SB_FILTER_UNIX_LITERAL,
+	    realpath(path, resolved) != NULL ? resolved : path);
+}
