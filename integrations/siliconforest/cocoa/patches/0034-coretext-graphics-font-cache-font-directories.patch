+/* The best record for a font name alone (CTFontCreateWithName), found once per name until the
+ * registry changes: a match scores every installed face, and Apple's Terminal makes a font by
+ * name for each line it draws. */
+const CTFontRecord *CTRegistryRecordForFontName(CFStringRef name) {
+    const CTFontRecord *record = NULL;
+    const void *cached;
+
+    CTRegistryLock();
+    cached = nameCache ? CFDictionaryGetValue(nameCache, name) : NULL;
+    if (cached != NULL)
+        record = cached == (const void *)kCFNull ? NULL : cached;
+    else {
+        const void *key = kCTFontNameAttribute;
+        CFDictionaryRef attributes = CFDictionaryCreate(NULL, &key, (const void **)&name, 1, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        const CTFontRecord **matches = NULL;
+
+        if (CTRegistryCopyMatchesUnlocked(attributes, &matches) > 0)
+            record = matches[0];
+        free(matches);
+        CFRelease(attributes);
+        if (nameCache == NULL)
+            nameCache = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks, NULL);
+        CFDictionarySetValue(nameCache, name, record ? (const void *)record : (const void *)kCFNull);
+    }
+    CTRegistryUnlock();
+    return record;
+}
