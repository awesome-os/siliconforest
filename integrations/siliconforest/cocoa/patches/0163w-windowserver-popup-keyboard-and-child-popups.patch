+static void keyFocusPush(int windowID, int code) {
+    struct mach_event event = {0};
+
+    event.windowID = windowID;
+    event.code = code;
+    queuePush(&event);
+    if (getenv("SF_WS_TRACE") != NULL)
+        fprintf(stderr, "WindowServer: AppKit told window %d %s the keyboard\n", windowID,
+                code == WS_EVENT_FOCUS_GAINED ? "has" : "lost");
+}
+
+// a keyboard leave that no enter on a window of ours answered in time is a loss of key
+static void keyFocusSettle(int force) {
+    if (ws.pendingKeyLossID == 0 || (!force && wsNowMs() - ws.pendingKeyLossAt < 40.0))
+        return;
+    keyFocusPush(ws.pendingKeyLossID, WS_EVENT_FOCUS_LOST);
+    if (ws.keyHolderID == ws.pendingKeyLossID)
+        ws.keyHolderID = 0;
+    ws.pendingKeyLossID = 0;
+}
+
+// milliseconds until a pending keyboard leave is told, -1 when none is pending
+static int keyFocusTimeout(void) {
+    if (ws.pendingKeyLossID == 0)
+        return -1;
+    double left = 40.0 - (wsNowMs() - ws.pendingKeyLossAt);
+    return left < 0 ? 0 : (int)left + 1;
+}
