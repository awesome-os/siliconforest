+/* (TERM11, FX-022) Which windows are popups: a window without a frame of its own at the pop-up menu level (a
+ * menu, a list, a tool tip), a child window without a frame (-addChildWindow:ordered:: Firefox's menu panel and
+ * its other doorhangers, at whatever level it gives them), or a window without a frame that was one before and is
+ * shown again (Firefox lowers a closing panel to the modal-panel level; shown again it is still a panel). On macOS
+ * these are windows at a level above their parent; here a toplevel would be placed, framed and focused by the desk
+ * as a window of its own. */
+static int windowIsPopupKind(struct wsWindow *window) {
+    if (wsStyleWantsServerFrame(window->style))
+        return 0;
+    return window->level == kWSPopUpMenuLevel || (window->popupParentHint != 0 && window->level >= 0) ||
+           (window->wasPopup && window->level >= 3);
+}
