+    [self setFrame:f];
+    if (shows && !_replaceField) {
+        _replaceField = [[NSTextField alloc] initWithFrame:NSMakeRect(8, kFindRow, 220, 22)];
+        [_replaceField setPlaceholderString:@"Replace"];
+        [_replaceField setAutoresizingMask:NSViewWidthSizable];
