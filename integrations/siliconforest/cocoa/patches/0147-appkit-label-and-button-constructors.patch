 @implementation NSButton
 
+/* (TERM8) the 10.12 convenience constructors: a push button (rounded bezel), a check box, a radio button, each with
+ * its target and action, sized to its title */
++(instancetype)_sfButtonWithTitle:(NSString *)title image:(NSImage *)image type:(NSButtonType)type target:(id)target action:(SEL)action {
+   NSButton *button=[[[self alloc] initWithFrame:NSMakeRect(0,0,100,24)] autorelease];
+
+   [button setButtonType:type];
+   if(type==NSMomentaryPushInButton)
+    [button setBezelStyle:NSRoundedBezelStyle];
+   [button setTitle:title!=nil ? title : @""];
+   if(image!=nil){
+    [button setImage:image];
+    if(title==nil)
+     [button setImagePosition:NSImageOnly];
+   }
+   [button setTarget:target];
+   [button setAction:action];
+   [button sizeToFit];
+   return button;
+}
+
++(instancetype)buttonWithTitle:(NSString *)title target:(id)target action:(SEL)action {
+   return [self _sfButtonWithTitle:title image:nil type:NSMomentaryPushInButton target:target action:action];
+}
+
++(instancetype)buttonWithTitle:(NSString *)title image:(NSImage *)image target:(id)target action:(SEL)action {
+   return [self _sfButtonWithTitle:title image:image type:NSMomentaryPushInButton target:target action:action];
+}
+
++(instancetype)buttonWithImage:(NSImage *)image target:(id)target action:(SEL)action {
+   return [self _sfButtonWithTitle:nil image:image type:NSMomentaryPushInButton target:target action:action];
+}
+
++(instancetype)checkboxWithTitle:(NSString *)title target:(id)target action:(SEL)action {
+   return [self _sfButtonWithTitle:title image:nil type:NSSwitchButton target:target action:action];
+}
+
++(instancetype)radioButtonWithTitle:(NSString *)title target:(id)target action:(SEL)action {
+   return [self _sfButtonWithTitle:title image:nil type:NSRadioButton target:target action:action];
+}
