 @implementation NSTextField
 
+/* (TERM8) the 10.12 convenience constructors (Firefox's crash reporter raised on +wrappingLabelWithString:, FX-004):
+ * a label is neither editable nor bezeled and draws no background, in the system font and label colour; a wrapping
+ * label wraps and can be selected; a text field is an editable, bezeled field. Each is sized to its text. */
++(instancetype)_sfLabelWithString:(NSString *)string wraps:(BOOL)wraps {
+   NSTextField *field=[[[self alloc] initWithFrame:NSMakeRect(0,0,100,17)] autorelease];
+
+   [field setStringValue:string!=nil ? string : @""];
+   [field setEditable:NO];
+   [field setSelectable:wraps];
+   [field setBezeled:NO];
+   [field setBordered:NO];
+   [field setDrawsBackground:NO];
+   [field setFont:[NSFont systemFontOfSize:[NSFont systemFontSize]]];
+   [field setTextColor:[NSColor labelColor]];
+   [[field cell] setLineBreakMode:wraps ? NSLineBreakByWordWrapping : NSLineBreakByClipping];
+   [[field cell] setWraps:wraps];
+   [field sizeToFit];
+   return field;
+}
+
++(instancetype)labelWithString:(NSString *)string {
+   return [self _sfLabelWithString:string wraps:NO];
+}
+
++(instancetype)wrappingLabelWithString:(NSString *)string {
+   return [self _sfLabelWithString:string wraps:YES];
+}
+
++(instancetype)labelWithAttributedString:(NSAttributedString *)attributedString {
+   NSTextField *field=[self _sfLabelWithString:[attributedString string] wraps:NO];
+
+   [field setAttributedStringValue:attributedString];
+   [field sizeToFit];
+   return field;
+}
+
++(instancetype)textFieldWithString:(NSString *)string {
+   NSTextField *field=[[[self alloc] initWithFrame:NSMakeRect(0,0,100,22)] autorelease];
+
+   [field setStringValue:string!=nil ? string : @""];
+   [field setEditable:YES];
+   [field setSelectable:YES];
+   [field setBezeled:YES];
+   [field setDrawsBackground:YES];
+   [field setFont:[NSFont systemFontOfSize:[NSFont systemFontSize]]];
+   [field sizeToFit];
+   return field;
+}
+
 +(Class)cellClass {
    return [NSTextFieldCell class];
 }
