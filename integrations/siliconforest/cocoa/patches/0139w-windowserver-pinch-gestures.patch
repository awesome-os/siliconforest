 static void pointerAxisDiscrete(void *data,struct wl_pointer *pointer,uint32_t axis,int32_t discrete){}
 
+/* (TERM8) a pinch on the trackpad (zwp_pointer_gestures_v1) as AppKit's magnify event: code WS_MAGNIFY, dx the change of
+ * scale since the event before (what -[NSEvent magnification] answers), repeat the phase (1 began, 2 changed, 3 ended,
+ * 4 cancelled), at the pointer in the window under it */
+#define WS_MAGNIFY 30
+static double pinchScale = 1.0;
+static int pinchWindowID;
+
+static void pinchPush(int phase, double magnification) {
+    struct mach_event event = {0};
+    struct wsWindow *window = windowForID(pinchWindowID);
+
+    noteInput();
+    event.windowID = pinchWindowID;
+    event.code = WS_MAGNIFY;
+    event.x = lastPointerX;
+    event.y = window != NULL ? window->h - lastPointerY : lastPointerY;
+    event.dx = magnification;
+    event.repeat = phase;
+    event.mods = currentModifiers;
+    queuePush(&event);
+}
+
+static void pinchBegin(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch, uint32_t serial, uint32_t time,
+                       struct wl_surface *surface, uint32_t fingers) {
+    pinchWindowID = ws.pointerWindowID;
+    for (struct wsWindow *w = ws.windows; w != NULL; w = w->next)
+        if (w->surface == surface)
+            pinchWindowID = w->windowID;
+    pinchScale = 1.0;
+    pinchPush(1, 0);
+}
+
+static void pinchUpdate(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch, uint32_t time, wl_fixed_t dx, wl_fixed_t dy,
+                        wl_fixed_t scale, wl_fixed_t rotation) {
+    double now = wl_fixed_to_double(scale);
+
+    pinchPush(2, now - pinchScale);
+    pinchScale = now;
+}
+
+static void pinchEnd(void *data, struct zwp_pointer_gesture_pinch_v1 *pinch, uint32_t serial, uint32_t time, int32_t cancelled) {
+    pinchPush(cancelled ? 4 : 3, 0);
+}
+
+static const struct zwp_pointer_gesture_pinch_v1_listener pinchListener = {
+    .begin = pinchBegin,
+    .update = pinchUpdate,
+    .end = pinchEnd,
+};
