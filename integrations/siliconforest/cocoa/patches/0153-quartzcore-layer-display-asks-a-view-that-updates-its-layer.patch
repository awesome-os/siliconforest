--- a/src/Frameworks/QuartzCore/CALayer.m
+++ b/src/Frameworks/QuartzCore/CALayer.m
@@ -697,6 +697,16 @@
     [_delegate displayLayer:self];
     return;
    }
+   // (FXLEAD) an AppKit view that updates its backing layer itself (-wantsUpdateLayer) is asked to, as AppKit's
+   // own -displayLayer: does on macOS. Firefox marks its pixel-hosting view's layer for display to be called back
+   // in -updateLayer on the main thread: there it composites, commits its layer tree and ends the suspension of
+   // its off-main-thread commits. Without it a suspension (a resize, the window becoming main, a GPU process
+   // restart) never ended and the window kept an old frame (FX-036, the blank page after a GPU process loss)
+   if([_delegate respondsToSelector:@selector(wantsUpdateLayer)] && [_delegate respondsToSelector:@selector(updateLayer)] &&
+      [(id)_delegate wantsUpdateLayer]){
+    [(id)_delegate updateLayer];
+    return;
+   }
    if([self methodForSelector:@selector(drawInContext:)]==[CALayer instanceMethodForSelector:@selector(drawInContext:)] &&
       ![_delegate respondsToSelector:@selector(drawLayer:inContext:)])
     return;
