+- (NSSize)_sfSizeOfItemAtIndex:(NSInteger)index
+{
+    NSArray *items = [self presentedItems];
+    NSUInteger count = [items count];
+
+    if (_sfSizes == nil || [_sfSizes length] != count * sizeof(NSSize)) {
+        NSUInteger i;
