+@implementation NSWindow (SFMenuStrip)
+
++ (BOOL)_sfMenuStripsEnabled
+{
+    static int enabled = -1;
+
+    if (enabled < 0) {
+        id value = [[NSUserDefaults standardUserDefaults] objectForKey:@"SFWindowMenuStrip"];
+
+        enabled = (value == nil || [value boolValue]) ? 1 : 0;
+    }
+    return enabled > 0;
+}
+
+- (BOOL)_sfWantsMenuStrip
+{
+    if (![NSWindow _sfMenuStripsEnabled] || [[NSApp mainMenu] numberOfItems] == 0)
+        return NO;
+    if ([self isKindOfClass:[NSPanel class]] || [self isSheet])
+        return NO;
+    if (!(_styleMask & NSTitledWindowMask) || (_styleMask & (NSFullScreenWindowMask | NSFullSizeContentViewWindowMask)))
+        return NO;
+    return NSWindowFrameIsDrawnByServer(_styleMask);
+}
+
+- (NSView *)_sfMenuStripView
+{
+    return _menuView;
+}
+
+/* Gives the window its strip, or takes it away, when what decides that changed (the application
+ * got its main menu, the window was created); the content keeps its size and the window's top edge
+ * its place. */
+- (void)_sfUpdateMenuStrip
+{
+    BOOL want = [self _sfWantsMenuStrip];
+    NSRect content, frame;
+    CGFloat height = 0;
+
+    if (want == (_menuView != nil)) {
+        if (_menuView != nil) {
+            [(SFMenuStripView *)_menuView setMenu:[NSApp mainMenu]];
+            [(SFMenuStripView *)_menuView _sfRefresh];
+        }
+        return;
+    }
+    content = [self contentRectForFrameRect:_frame];
+    if (want) {
+        SFMenuStripView *strip = [[SFMenuStripView alloc] initWithFrame:NSMakeRect(0, 0, NSWidth(content), 22)];
+
+        [strip setHorizontal:YES];
+        [strip _sfSetInWindow:YES];
+        [strip setMenu:[NSApp mainMenu]];
+        [strip sizeToFit];
+        height = MAX(22, ceil(NSHeight([strip frame])));
+        [strip setFrame:NSMakeRect(0, 0, NSWidth(content), height)];
+        [strip setAutoresizingMask:NSViewWidthSizable | NSViewMinYMargin];
+        _menuView = strip;
+        [_backgroundView addSubview:strip];
+        [strip _sfRefresh];
+    }
+    else {
+        height = -NSHeight([_menuView frame]);
+        [_menuView removeFromSuperview];
+        [_menuView release];
+        _menuView = nil;
+    }
+    if (_minSize.height > 0)
+        _minSize.height += height;
+    if (_maxSize.height < 32767)
+        _maxSize.height += height;
+    frame = [self frameRectForContentRect:content];
+    frame.origin.y = NSMaxY(_frame) - frame.size.height;
+    [self setFrame:frame display:NO];
+    [_backgroundView resizeSubviewsWithOldSize:[_backgroundView frame].size];
+    [_backgroundView setNeedsDisplay:YES];
+    [self _sendSizeLimits];
+}
+
+// Control-F2 with this window in front
+- (BOOL)_sfMenuStripTakesKeyEvent:(NSEvent *)event
+{
+    NSString *chars;
+
+    if (_menuView == nil || [event type] != NSKeyDown || !([event modifierFlags] & NSControlKeyMask) ||
+        ([event modifierFlags] & (NSCommandKeyMask | NSAlternateKeyMask)))
+        return NO;
+    chars = [event charactersIgnoringModifiers];
+    if ([chars length] != 1 || [chars characterAtIndex:0] != NSF2FunctionKey)
+        return NO;
+    [(SFMenuStripView *)_menuView _sfTrackFromKeyEvent:event];
+    return YES;
+}
+
+@end
