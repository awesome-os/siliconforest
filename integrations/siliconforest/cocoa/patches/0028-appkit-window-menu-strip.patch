+/* SPDX-License-Identifier: MIT
+ *
+ * The application's main menu as a strip at the top of each of its standard windows.
+ *
+ * SiliconForest's desktop has no global menu bar: a window is its content inside the frame the
+ * compositor draws. The main menu of a Mac application is shown where the user already looks, as
+ * the first row inside that frame, in every titled window that is not a panel. It is the
+ * application's own NSMenu drawn by a horizontal NSMenuView: the menu of a title is the same popup
+ * window (an xdg_popup of the window) as every other menu, tracked by the same loop, so pointer and
+ * keyboard behave as in a context menu; Control-F2 (macOS: "move focus to the menu bar") opens the
+ * first menu from the keyboard, Left and Right go along the titles.
+ *
+ * The strip belongs to the window's frame, not to its content: -frameRectForContentRect: and
+ * -contentRectForFrameRect: count it like the title bar, so an application that sizes its window
+ * from its content (a terminal: columns by rows) gets the content it asked for.
+ *
+ * Only where the compositor draws the frames (NSWindowFrameIsDrawnByServer): on upstream's desktop
+ * the menu bar process shows the menu. The default SFWindowMenuStrip=NO turns it off.
+ */
+#import <AppKit/NSWindow.h>
+#import <AppKit/NSWindow-Private.h>
+#import <AppKit/NSPanel.h>
+#import <AppKit/NSApplication.h>
+#import <AppKit/NSMenu.h>
+#import <AppKit/NSMenuItem.h>
+#import <AppKit/NSMenuView.h>
+#import <AppKit/NSColor.h>
+#import <AppKit/NSGraphics.h>
+#import <AppKit/NSAppearance.h>
+#import <AppKit/NSEvent.h>
+#import <Foundation/NSUserDefaults.h>
+#import <Foundation/NSBundle.h>
+#import <Foundation/NSProcessInfo.h>
