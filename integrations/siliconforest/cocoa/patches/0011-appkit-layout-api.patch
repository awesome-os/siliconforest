+#import <AppKit/NSLayoutConstraint.h>
+#import <AppKit/NSModernAppKit.h>
+
+// "no intrinsic size along this axis"; the second spelling is the one AppKit first shipped with
+APPKIT_EXPORT const CGFloat NSViewNoIntrinsicMetric;
+APPKIT_EXPORT const CGFloat NSViewNoInstrinsicMetric;
