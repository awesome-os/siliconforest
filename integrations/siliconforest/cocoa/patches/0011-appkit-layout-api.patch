+// SFLayoutSolver.h - the linear constraint solver under Auto Layout
+// Copyright (c) 2026 The SiliconForest contributors, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+//
+// An incremental simplex solver for linear equalities and inequalities with strengths, after
+// Badros, Borning and Stuckey, "The Cassowary Linear Arithmetic Constraint Solving Algorithm"
+// (ACM TOCHI 8(4), 2001). Written for this tree from the paper; constraints are only ever added
+// (a layout builds a solver, reads the answer and throws it away), so the paper's removal and
+// edit-variable machinery is not here.
+#ifndef SFLAYOUTSOLVER_H
+#define SFLAYOUTSOLVER_H
+
+typedef struct SFSolver SFSolver;
+typedef int SFSolverVariable;
+
+enum { SFSolverLessOrEqual = -1, SFSolverEqual = 0, SFSolverGreaterOrEqual = 1 };
+
+// a strength at or above this is "must hold"
+#define SFSolverRequired 1000.0
+
+SFSolver *SFSolverCreate(void);
+void SFSolverFree(SFSolver *solver);
+SFSolverVariable SFSolverAddVariable(SFSolver *solver);
+
+/* Adds: sum(coefficients[i] * variables[i]) + constant  (relation)  0, at an Auto Layout
+ * priority (1...1000). Returns 1, or 0 when the constraint is required and cannot hold together
+ * with the required ones already there - it is then left out. */
+int SFSolverAddConstraint(SFSolver *solver, const SFSolverVariable *variables, const double *coefficients,
+                          int count, double constant, int relation, double priority);
+
+// a variable's value in the current solution (0 for one no constraint mentions)
+double SFSolverValue(SFSolver *solver, SFSolverVariable variable);
+
+#endif
