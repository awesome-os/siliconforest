+// SFLayoutSolver.m - the linear constraint solver under Auto Layout (see SFLayoutSolver.h)
+// Copyright (c) 2026 The SiliconForest contributors, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+#import "SFLayoutSolver.h"
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+/* Symbols. External ones are the caller's variables and may take any value; slack and error
+ * symbols are the solver's own and never negative; a dummy stands for a required equality and
+ * never enters the basis. */
+enum { SYM_INVALID = 0, SYM_EXTERNAL, SYM_SLACK, SYM_ERROR, SYM_DUMMY };
+
+typedef int Symbol;    // index into SFSolver.kinds, 0 is "none"
+
+// a linear expression: constant + sum(coefficient * symbol)
+typedef struct {
+    double constant;
+    int count, capacity;
+    Symbol *symbols;
+    double *coefficients;
+} Row;
+
+struct SFSolver {
+    int symbolCount, symbolCapacity;
+    unsigned char *kinds;
+    Row **rows;            // by basic symbol: the row that defines it, or NULL when it is not basic
+    Row objective;
+    Row *artificial;
+};
+
+static const double epsilon = 1.0e-8;
+
+static int nearZero(double value) {
+    return value < 0 ? -value < epsilon : value < epsilon;
+}
+
+static void rowFree(Row *row) {
+    free(row->symbols);
+    free(row->coefficients);
+    row->symbols = NULL, row->coefficients = NULL, row->count = row->capacity = 0;
+}
+
+static Row *rowCopy(const Row *row) {
+    Row *copy = calloc(1, sizeof(Row));
+
+    copy->constant = row->constant;
+    copy->count = copy->capacity = row->count;
+    if (row->count > 0) {
+        copy->symbols = malloc(row->count * sizeof(Symbol));
+        copy->coefficients = malloc(row->count * sizeof(double));
+        memcpy(copy->symbols, row->symbols, row->count * sizeof(Symbol));
+        memcpy(copy->coefficients, row->coefficients, row->count * sizeof(double));
+    }
+    return copy;
+}
+
+static int rowFind(const Row *row, Symbol symbol) {
+    for (int i = 0; i < row->count; i++) {
+        if (row->symbols[i] == symbol)
+            return i;
+    }
+    return -1;
+}
+
+static double rowCoefficient(const Row *row, Symbol symbol) {
+    int i = rowFind(row, symbol);
+
+    return i < 0 ? 0 : row->coefficients[i];
+}
+
+static void rowRemoveAt(Row *row, int i) {
+    row->count--;
+    row->symbols[i] = row->symbols[row->count];
+    row->coefficients[i] = row->coefficients[row->count];
+}
+
+static void rowRemove(Row *row, Symbol symbol) {
+    int i = rowFind(row, symbol);
+
+    if (i >= 0)
+        rowRemoveAt(row, i);
+}
+
+// row += coefficient * symbol; a term that cancels out is dropped
+static void rowAdd(Row *row, Symbol symbol, double coefficient) {
+    int i = rowFind(row, symbol);
+
+    if (i >= 0) {
+        row->coefficients[i] += coefficient;
+        if (nearZero(row->coefficients[i]))
+            rowRemoveAt(row, i);
+        return;
+    }
+    if (nearZero(coefficient))
+        return;
+    if (row->count == row->capacity) {
+        row->capacity = row->capacity ? row->capacity * 2 : 8;
+        row->symbols = realloc(row->symbols, row->capacity * sizeof(Symbol));
+        row->coefficients = realloc(row->coefficients, row->capacity * sizeof(double));
+    }
+    row->symbols[row->count] = symbol;
+    row->coefficients[row->count] = coefficient;
+    row->count++;
+}
+
+// row += coefficient * other
+static void rowAddRow(Row *row, const Row *other, double coefficient) {
+    row->constant += other->constant * coefficient;
+    for (int i = 0; i < other->count; i++)
+        rowAdd(row, other->symbols[i], other->coefficients[i] * coefficient);
+}
+
+static void rowReverseSign(Row *row) {
+    row->constant = -row->constant;
+    for (int i = 0; i < row->count; i++)
+        row->coefficients[i] = -row->coefficients[i];
+}
+
+/* The row says 0 = constant + ... + c * symbol + ...; afterwards it says
+ * symbol = -constant/c - .../c, with the symbol gone from the right side. */
+static void rowSolveFor(Row *row, Symbol symbol) {
+    int at = rowFind(row, symbol);
+    double scale = -1.0 / row->coefficients[at];
+
+    rowRemoveAt(row, at);
+    row->constant *= scale;
+    for (int i = 0; i < row->count; i++)
+        row->coefficients[i] *= scale;
+}
+
+// the row says left = ...right...; afterwards it says right = ...left...
+static void rowSolveForPair(Row *row, Symbol left, Symbol right) {
+    rowAdd(row, left, -1.0);
+    rowSolveFor(row, right);
+}
+
+// replaces a symbol by the row that defines it
+static void rowSubstitute(Row *row, Symbol symbol, const Row *definition) {
+    int at = rowFind(row, symbol);
+
+    if (at >= 0) {
+        double coefficient = row->coefficients[at];
+
+        rowRemoveAt(row, at);
+        rowAddRow(row, definition, coefficient);
+    }
+}
+
+static Symbol newSymbol(SFSolver *solver, int kind) {
+    if (solver->symbolCount == solver->symbolCapacity) {
+        int capacity = solver->symbolCapacity ? solver->symbolCapacity * 2 : 64;
+
+        solver->kinds = realloc(solver->kinds, capacity);
+        solver->rows = realloc(solver->rows, capacity * sizeof(Row *));
+        memset(solver->rows + solver->symbolCapacity, 0, (capacity - solver->symbolCapacity) * sizeof(Row *));
+        solver->symbolCapacity = capacity;
+    }
+    solver->kinds[solver->symbolCount] = kind;
+    solver->rows[solver->symbolCount] = NULL;
+    return solver->symbolCount++;
+}
+
+SFSolver *SFSolverCreate(void) {
+    SFSolver *solver = calloc(1, sizeof(SFSolver));
+
+    newSymbol(solver, SYM_INVALID);    // symbol 0 is "none"
+    return solver;
+}
+
+void SFSolverFree(SFSolver *solver) {
+    if (solver == NULL)
+        return;
+    for (int i = 0; i < solver->symbolCount; i++) {
+        if (solver->rows[i] != NULL) {
+            rowFree(solver->rows[i]);
+            free(solver->rows[i]);
+        }
+    }
+    rowFree(&solver->objective);
+    if (solver->artificial != NULL) {
+        rowFree(solver->artificial);
+        free(solver->artificial);
+    }
+    free(solver->kinds);
+    free(solver->rows);
+    free(solver);
+}
+
+SFSolverVariable SFSolverAddVariable(SFSolver *solver) {
+    return newSymbol(solver, SYM_EXTERNAL);
+}
+
+double SFSolverValue(SFSolver *solver, SFSolverVariable variable) {
+    if (variable <= 0 || variable >= solver->symbolCount || solver->rows[variable] == NULL)
+        return 0;
+    return solver->rows[variable]->constant;
+}
+
+/* An Auto Layout priority as a weight in the objective. Cassowary's strengths are strictly
+ * ordered; in one sum of doubles that is approximated by weights that grow a thousandfold every
+ * 250 priority points (1 at 250, 1e3 at 500, 1e6 at 750, just under 1e9 at 999). Between two
+ * conflicting constraints the higher priority always wins, whatever the difference; only many
+ * low ones against one high one can outweigh it. */
+static double weightForPriority(double priority) {
+    if (priority < 1)
+        priority = 1;
+    return pow(1000.0, priority / 250.0 - 1.0);
+}
+
+// a symbol becomes basic, defined by `row`: every other row and the objective lose it
+static void substitute(SFSolver *solver, Symbol symbol, const Row *row) {
+    for (int i = 1; i < solver->symbolCount; i++) {
+        if (solver->rows[i] != NULL && solver->rows[i] != row)
+            rowSubstitute(solver->rows[i], symbol, row);
+    }
+    rowSubstitute(&solver->objective, symbol, row);
+    if (solver->artificial != NULL)
+        rowSubstitute(solver->artificial, symbol, row);
+}
+
+/* Minimises an objective by pivoting: a symbol with a negative coefficient in it enters the
+ * basis, in place of the basic symbol that reaches zero first as the entering one grows. */
+static void optimize(SFSolver *solver, Row *objective) {
+    for (int guard = 0; guard < 100000; guard++) {
+        Symbol entering = 0, leaving = 0;
+        double best = 0;
+
+        // Bland's rule (lowest index) on both choices: no cycling
+        for (int i = 0; i < objective->count; i++) {
+            Symbol s = objective->symbols[i];
+
+            if (solver->kinds[s] != SYM_DUMMY && objective->coefficients[i] < 0 && (entering == 0 || s < entering))
+                entering = s;
+        }
+        if (entering == 0)
+            return;
+
+        for (Symbol s = 1; s < solver->symbolCount; s++) {
+            Row *row = solver->rows[s];
+
+            if (row == NULL || solver->kinds[s] == SYM_EXTERNAL)
+                continue;
+
+            double coefficient = rowCoefficient(row, entering);
+
+            if (coefficient < 0) {
+                double ratio = -row->constant / coefficient;
+
+                if (leaving == 0 || ratio < best) {
+                    best = ratio;
+                    leaving = s;
+                }
+            }
+        }
+        if (leaving == 0)
+            return;    // unbounded: cannot happen with error symbols weighted positively
+
+        Row *row = solver->rows[leaving];
+
+        solver->rows[leaving] = NULL;
+        rowSolveForPair(row, leaving, entering);
+        substitute(solver, entering, row);
+        solver->rows[entering] = row;
+    }
+}
+
+// a row with no symbol that can be its subject gets an artificial one, driven to zero
+static int addWithArtificial(SFSolver *solver, Row *row) {
+    Symbol art = newSymbol(solver, SYM_SLACK);
+    int success;
+
+    solver->rows[art] = rowCopy(row);
+    solver->artificial = rowCopy(row);
+    optimize(solver, solver->artificial);
+    success = nearZero(solver->artificial->constant);
+    rowFree(solver->artificial);
+    free(solver->artificial);
+    solver->artificial = NULL;
+
+    Row *basic = solver->rows[art];
+
+    if (basic != NULL) {
+        solver->rows[art] = NULL;
+        if (basic->count == 0) {
+            rowFree(basic);
+            free(basic);
+            return success;
+        }
+
+        Symbol entering = 0;
+
+        for (int i = 0; i < basic->count; i++) {
+            int kind = solver->kinds[basic->symbols[i]];
+
+            if (kind == SYM_SLACK || kind == SYM_ERROR) {
+                entering = basic->symbols[i];
+                break;
+            }
+        }
+        if (entering == 0) {
+            rowFree(basic);
+            free(basic);
+            return 0;
+        }
+        rowSolveForPair(basic, art, entering);
+        substitute(solver, entering, basic);
+        solver->rows[entering] = basic;
+    }
+    for (int i = 1; i < solver->symbolCount; i++) {
+        if (solver->rows[i] != NULL)
+            rowRemove(solver->rows[i], art);
+    }
+    rowRemove(&solver->objective, art);
+    return success;
+}
+
+int SFSolverAddConstraint(SFSolver *solver, const SFSolverVariable *variables, const double *coefficients,
+                          int count, double constant, int relation, double priority) {
+    Row *row = calloc(1, sizeof(Row));
+    Symbol marker = 0, other = 0, subject = 0;
+    int required = priority >= SFSolverRequired;
+
+    // the expression, with every basic variable replaced by its definition
+    row->constant = constant;
+    for (int i = 0; i < count; i++) {
+        Symbol s = variables[i];
+
+        if (s <= 0 || s >= solver->symbolCount || nearZero(coefficients[i]))
+            continue;
+        if (solver->rows[s] != NULL)
+            rowAddRow(row, solver->rows[s], coefficients[i]);
+        else
+            rowAdd(row, s, coefficients[i]);
+    }
+
+    if (relation != SFSolverEqual) {
+        double coefficient = relation == SFSolverLessOrEqual ? 1.0 : -1.0;
+
+        marker = newSymbol(solver, SYM_SLACK);
+        rowAdd(row, marker, coefficient);
+        if (!required) {
+            other = newSymbol(solver, SYM_ERROR);
+            rowAdd(row, other, -coefficient);
+            rowAdd(&solver->objective, other, weightForPriority(priority));
+        }
+    } else if (!required) {
+        marker = newSymbol(solver, SYM_ERROR);
+        other = newSymbol(solver, SYM_ERROR);
+        rowAdd(row, marker, -1.0);
+        rowAdd(row, other, 1.0);
+        rowAdd(&solver->objective, marker, weightForPriority(priority));
+        rowAdd(&solver->objective, other, weightForPriority(priority));
+    } else {
+        marker = newSymbol(solver, SYM_DUMMY);
+        rowAdd(row, marker, 1.0);
+    }
+    if (row->constant < 0)
+        rowReverseSign(row);
+
+    // the subject: an external variable, else a new slack or error symbol with a negative coefficient
+    for (int i = 0; i < row->count; i++) {
+        if (solver->kinds[row->symbols[i]] == SYM_EXTERNAL && (subject == 0 || row->symbols[i] < subject))
+            subject = row->symbols[i];
+    }
+    if (subject == 0 && (solver->kinds[marker] == SYM_SLACK || solver->kinds[marker] == SYM_ERROR) &&
+        rowCoefficient(row, marker) < 0)
+        subject = marker;
+    if (subject == 0 && other != 0 && rowCoefficient(row, other) < 0)
+        subject = other;
+
+    if (subject == 0) {
+        int allDummies = 1;
+
+        for (int i = 0; i < row->count; i++) {
+            if (solver->kinds[row->symbols[i]] != SYM_DUMMY)
+                allDummies = 0;
+        }
+        if (allDummies) {
+            if (!nearZero(row->constant)) {
+                // a required constraint that contradicts the required ones before it
+                rowFree(row);
+                free(row);
+                return 0;
+            }
+            subject = marker;
+        }
+    }
+
+    if (subject == 0) {
+        int ok = addWithArtificial(solver, row);
+
+        rowFree(row);
+        free(row);
+        if (!ok)
+            return 0;
+    } else {
+        rowSolveFor(row, subject);
+        substitute(solver, subject, row);
+        solver->rows[subject] = row;
+    }
+    optimize(solver, &solver->objective);
+    return 1;
+}
