+// NSViewLayout.m - what a view tells Auto Layout about itself
+// Copyright (c) 2026 The SiliconForest contributors, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+//
+// The sizes come from the cells, so they are as right as -cellSize is. The rules on top of that
+// are the ones macOS 26 shows when asked (integrations/siliconforest/cocoa/conformance):
+//   - a control's intrinsic size is its cell's size, raised to whole device pixels;
+//   - a field the user types into, a horizontal slider and a progress bar have no intrinsic
+//     width, a vertical slider no intrinsic height;
+//   - a label's alignment rectangle leaves out the 2 points the cell keeps on either side of
+//     its text, so its intrinsic width is that much less than the cell's;
+//   - the fitting size of a view that holds no constraints is the frame of its intrinsic size,
+//     with 0 where there is none;
+//   - text sits in the middle of the control: the baseline is the descent above the line's
+//     bottom, the line being ascent plus descent each rounded to whole points.
+#import <AppKit/NSViewLayout.h>
+#import <AppKit/NSControl.h>
+#import <AppKit/NSCell.h>
+#import <AppKit/NSTextField.h>
+#import <AppKit/NSButton.h>
+#import <AppKit/NSSlider.h>
+#import <AppKit/NSProgressIndicator.h>
+#import <AppKit/NSFont.h>
+#import <AppKit/NSWindow.h>
+#import <AppKit/NSScreen.h>
+#import <Foundation/NSValue.h>
+#import <objc/runtime.h>
+#include <math.h>
+
+const CGFloat NSViewNoIntrinsicMetric = -1;
+const CGFloat NSViewNoInstrinsicMetric = -1;
+
+static const char compressionKey[2], needsUpdateKey;
+
+// up to the next device pixel of the view's window, or of the main screen for a view in none
+static CGFloat raised(NSView *view, CGFloat value) {
+    CGFloat scale = [view window] ? [[view window] backingScaleFactor] : [[NSScreen mainScreen] backingScaleFactor];
+
+    if (scale <= 0)
+        scale = 1;
+    return ceil(value * scale - 0.001) / scale;
+}
+
+@implementation NSView (NSViewLayout)
+
+- (NSSize)intrinsicContentSize {
+    return NSMakeSize(NSViewNoIntrinsicMetric, NSViewNoIntrinsicMetric);
+}
+
+- (void)invalidateIntrinsicContentSize {
+    NSView *holder = [self superview];
+
+    if (holder != nil)
+        [holder setNeedsLayout:YES];
+}
+
+- (NSEdgeInsets)alignmentRectInsets {
+    return NSEdgeInsetsMake(0, 0, 0, 0);
+}
+
+- (NSRect)alignmentRectForFrame:(NSRect)frame {
+    NSEdgeInsets insets = [self alignmentRectInsets];
+    BOOL flipped = [[self superview] isFlipped];
+
+    frame.origin.x += insets.left;
+    frame.origin.y += flipped ? insets.top : insets.bottom;
+    frame.size.width -= insets.left + insets.right;
+    frame.size.height -= insets.top + insets.bottom;
+    return frame;
+}
+
+- (NSRect)frameForAlignmentRect:(NSRect)rect {
+    NSEdgeInsets insets = [self alignmentRectInsets];
+    BOOL flipped = [[self superview] isFlipped];
+
+    rect.origin.x -= insets.left;
+    rect.origin.y -= flipped ? insets.top : insets.bottom;
+    rect.size.width += insets.left + insets.right;
+    rect.size.height += insets.top + insets.bottom;
+    return rect;
+}
+
+/* The smallest size the view's constraints, and the intrinsic sizes of what is in it, leave room
+ * for. A view with nothing in it is as large as its own intrinsic size. */
+- (NSSize)fittingSize {
+    NSSize intrinsic = [self intrinsicContentSize];
+    NSEdgeInsets insets = [self alignmentRectInsets];
+    NSSize size;
+
+    size.width = intrinsic.width < 0 ? 0 : intrinsic.width;
+    size.height = intrinsic.height < 0 ? 0 : intrinsic.height;
+    if ([[self subviews] count] != 0)
+        size = [self _sfFittingSize];
+    size.width = raised(self, fmax(0, size.width) + insets.left + insets.right);
+    size.height = raised(self, fmax(0, size.height) + insets.top + insets.bottom);
+    if (intrinsic.width < 0 && size.width <= insets.left + insets.right)
+        size.width = 0;
+    if (intrinsic.height < 0 && size.height <= insets.top + insets.bottom)
+        size.height = 0;
+    return size;
+}
+
+- (CGFloat)lastBaselineOffsetFromBottom {
+    return [self baselineOffsetFromBottom];
+}
+
+- (CGFloat)baselineOffsetFromBottom {
+    return 0;
+}
+
+- (CGFloat)firstBaselineOffsetFromTop {
+    NSSize intrinsic = [self intrinsicContentSize];
+    CGFloat height = intrinsic.height >= 0 ? intrinsic.height : [self bounds].size.height;
+
+    return height - [self baselineOffsetFromBottom];
+}
+
+- (NSLayoutPriority)contentCompressionResistancePriorityForOrientation:(NSLayoutConstraintOrientation)orientation {
+    NSNumber *value = objc_getAssociatedObject(self, &compressionKey[orientation ? 1 : 0]);
+
+    return value ? [value floatValue] : NSLayoutPriorityDefaultHigh;
+}
+
+- (void)setContentCompressionResistancePriority:(NSLayoutPriority)priority forOrientation:(NSLayoutConstraintOrientation)orientation {
+    objc_setAssociatedObject(self, &compressionKey[orientation ? 1 : 0], [NSNumber numberWithFloat:priority], OBJC_ASSOCIATION_RETAIN);
+    [self invalidateIntrinsicContentSize];
+}
+
+// what -contentHuggingPriorityForOrientation: answers until one is set
+- (NSLayoutPriority)_sfDefaultContentHuggingPriorityForOrientation:(NSLayoutConstraintOrientation)orientation {
+    return NSLayoutPriorityDefaultLow;
+}
+
++ (BOOL)requiresConstraintBasedLayout {
+    return NO;
+}
+
+- (BOOL)needsUpdateConstraints {
+    return [objc_getAssociatedObject(self, &needsUpdateKey) boolValue];
+}
+
+- (void)setNeedsUpdateConstraints:(BOOL)flag {
+    objc_setAssociatedObject(self, &needsUpdateKey, flag ? [NSNumber numberWithBool:YES] : nil, OBJC_ASSOCIATION_RETAIN);
+}
+
+- (void)updateConstraints {
+    [self setNeedsUpdateConstraints:NO];
+}
+
+- (void)updateConstraintsForSubtreeIfNeeded {
+    for (NSView *subview in [self subviews])
+        [subview updateConstraintsForSubtreeIfNeeded];
+    if ([self needsUpdateConstraints])
+        [self updateConstraints];
+}
+
+- (void)layout {
+    [self _sfSolveConstraints];
+}
+
+@end
+
+@implementation NSControl (NSViewLayout)
+
+// a label: text only, nothing drawn around it and nothing to type into
+- (BOOL)_sfIsLabel {
+    NSCell *cell = [self cell];
+
+    return [self isKindOfClass:[NSTextField class]] && ![cell isBezeled] && ![cell isBordered] && ![cell isEditable];
+}
+
+// a control holds on to its height; one with no border of its own (a checkbox, a radio button) does not
+- (NSLayoutPriority)_sfDefaultContentHuggingPriorityForOrientation:(NSLayoutConstraintOrientation)orientation {
+    if (orientation == NSLayoutConstraintOrientationHorizontal)
+        return NSLayoutPriorityDefaultLow;
+    if ([self isKindOfClass:[NSButton class]] && ![[self cell] isBordered])
+        return NSLayoutPriorityDefaultLow;
+    return NSLayoutPriorityDefaultHigh;
+}
+
+- (NSEdgeInsets)alignmentRectInsets {
+    return [self _sfIsLabel] ? NSEdgeInsetsMake(0, 2, 0, 2) : NSEdgeInsetsMake(0, 0, 0, 0);
+}
+
+- (NSSize)intrinsicContentSize {
+    NSCell *cell = [self cell];
+    NSEdgeInsets insets = [self alignmentRectInsets];
+    NSSize size;
+
+    if (cell == nil)
+        return NSMakeSize(NSViewNoIntrinsicMetric, NSViewNoIntrinsicMetric);
+    size = [cell cellSize];
+    size.width = raised(self, size.width - insets.left - insets.right);
+    size.height = raised(self, size.height - insets.top - insets.bottom);
+    if ([self isKindOfClass:[NSTextField class]] && ![self _sfIsLabel] && [cell isEditable])
+        size.width = NSViewNoIntrinsicMetric;
+    return size;
+}
+
+- (CGFloat)baselineOffsetFromBottom {
+    NSFont *font = [self font];
+    CGFloat ascent, descent, height;
+
+    if (font == nil)
+        return 0;
+    ascent = round([font ascender]);
+    descent = round(-[font descender]);
+    // of the control at its own size, where its text is centred: a baseline is used to line views
+    // up before they have frames
+    height = [[self cell] cellSize].height;
+    if (height <= 0 || height > 1000)
+        height = [self bounds].size.height;
+    return floor((height - ascent - descent) / 2 * 2) / 2 + descent;
+}
+
+@end
+
+@implementation NSSlider (NSViewLayout)
+
+// the track runs as far as it is given: only the thickness is the slider's own
+- (NSSize)intrinsicContentSize {
+    NSSize frame = [self frame].size, cell = [[self cell] cellSize];
+    CGFloat thickness = MIN(cell.width, cell.height);
+
+    if (frame.height > frame.width)
+        return NSMakeSize(raised(self, thickness), NSViewNoIntrinsicMetric);
+    return NSMakeSize(NSViewNoIntrinsicMetric, raised(self, thickness));
+}
+
+- (CGFloat)baselineOffsetFromBottom {
+    return 0;
+}
+
+@end
+
+@implementation NSProgressIndicator (NSViewLayout)
+
+- (NSLayoutPriority)_sfDefaultContentHuggingPriorityForOrientation:(NSLayoutConstraintOrientation)orientation {
+    return orientation == NSLayoutConstraintOrientationHorizontal ? NSLayoutPriorityDefaultLow : NSLayoutPriorityDefaultHigh;
+}
+
+- (NSSize)intrinsicContentSize {
+    // the bar: 20 points, 12 for the small and mini sizes (macOS 26); a spinner is as large as it was made
+    if ([self style] == NSProgressIndicatorBarStyle)
+        return NSMakeSize(NSViewNoIntrinsicMetric, [self controlSize] == NSRegularControlSize ? 20 : 12);
+    return [self frame].size;
+}
+
+@end
