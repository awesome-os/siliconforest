+/* A nib's "standard space" constraint carries no constant but NSSymbolicConstant = "NSSpace", which
+ * Foundation's decoder does not read: every such constraint (246 of the 692 in Terminal's
+ * preferences) was 0 points, and the controls it spaces overlapped once the nib's booleans made those
+ * views laid out by their constraints. Kept as a mark at decoding and resolved when the constraint is
+ * first laid out, when the items' superviews are known: 20 points to the superview's edge, 8 between
+ * siblings (macOS's standard spacing; the same values as Finch's CoreAutoLayout, MIT OR Apache-2.0,
+ * commit 2d9b1bb, NSLayoutConstraint.m -constant). */
+
+// SF_LAYOUT_TRACE=1: every constraint of a layout and every frame it sets, on stderr (a diagnostic)
+static int sfLayoutTrace = -1;
+static NSString *sfTraceName(id item) {
+    NSString *text = nil;
+
+    if (item == nil)
+        return @"-";
+    if ([item respondsToSelector:@selector(stringValue)] && [item isKindOfClass:NSClassFromString(@"NSControl")])
+        text = [item stringValue];
+    if ([text length] > 18)
+        text = [text substringToIndex:18];
+    return [NSString stringWithFormat:@"%s:%p%@%@%@", object_getClassName(item), item, text ? @"'" : @"", text ? text : @"", text ? @"'" : @""];
+}
+static const char symbolicSpaceKey;
+static id (*sfDecodeConstraint)(id, SEL, NSCoder *);
+
+static id sfDecodeConstraintWithSymbolicSpace(id self, SEL _cmd, NSCoder *coder) {
+    self = sfDecodeConstraint(self, _cmd, coder);
+    if (self != nil && [coder allowsKeyedCoding]) {
+        id symbolic = [coder decodeObjectForKey:@"NSSymbolicConstant"];
+
+        if ([symbolic isKindOfClass:[NSString class]] && [symbolic isEqualToString:@"NSSpace"])
+            objc_setAssociatedObject(self, &symbolicSpaceKey, [NSNumber numberWithBool:YES], OBJC_ASSOCIATION_RETAIN);
+    }
+    return self;
+}
+
 @implementation NSLayoutConstraint (SFActivation)
 
++ (void)load {
+    Method m = class_getInstanceMethod(self, @selector(initWithCoder:));
+
+    if (m != NULL && sfDecodeConstraint == NULL)
+        sfDecodeConstraint = (id (*)(id, SEL, NSCoder *))method_setImplementation(m, (IMP)sfDecodeConstraintWithSymbolicSpace);
+}
+
+- (void)_sfResolveSymbolicSpace {
+    id first = _firstItem, second = _secondItem;
+    BOOL toSuperview;
+
+    if (objc_getAssociatedObject(self, &symbolicSpaceKey) == nil)
+        return;
+    toSuperview = second != nil && (([first isKindOfClass:[NSView class]] && [(NSView *)first superview] == second) ||
+                                    ([second isKindOfClass:[NSView class]] && [(NSView *)second superview] == first));
+    _constant = toSuperview ? 20 : 8;
+    objc_setAssociatedObject(self, &symbolicSpaceKey, nil, OBJC_ASSOCIATION_RETAIN);
+}
