+@implementation NSMatrix (NSViewLayout)
+
+/* its cells as they are laid out: the rows and columns of the cell size with the spacing between them
+ * (NSControl's answer, the size of a cell, was that of a cell with no title: 10000 points each way, and a
+ * pair of radio buttons pushed the labels beside it narrower than their text) */
+- (NSSize)intrinsicContentSize {
+    NSSize cell = [self cellSize], gap = [self intercellSpacing];
+    NSInteger rows = [self numberOfRows], columns = [self numberOfColumns];
+
+    if (rows <= 0 || columns <= 0)
+        return NSMakeSize(NSViewNoIntrinsicMetric, NSViewNoIntrinsicMetric);
+    return NSMakeSize(raised(self, columns * cell.width + (columns - 1) * gap.width),
+                      raised(self, rows * cell.height + (rows - 1) * gap.height));
+}
+
+// the first row's text, as a control of one cell's height
+- (CGFloat)firstBaselineOffsetFromTop {
+    NSSize cell = [self cellSize];
+    NSFont *font = [self font];
+
+    if (font == nil || cell.height <= 0)
+        return 0;
+    return cell.height - (floor((cell.height - round([font ascender]) - round(-[font descender])) / 2 * 2) / 2 + round(-[font descender]));
+}
+
+- (CGFloat)baselineOffsetFromBottom {
+    NSSize cell = [self cellSize];
+    NSFont *font = [self font];
+
+    if (font == nil || cell.height <= 0)
+        return 0;
+    return floor((cell.height - round([font ascender]) - round(-[font descender])) / 2 * 2) / 2 + round(-[font descender]);
+}
+
+@end
