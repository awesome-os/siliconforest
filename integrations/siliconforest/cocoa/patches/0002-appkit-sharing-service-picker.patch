+
+// the picker: system services there are none, so the menu holds what the delegate proposes
+@implementation NSSharingServicePicker {
+    NSArray *_items;
+    NSArray *_services;
+    NSMenu *_menu;
+    NSMenuItem *_standardItem;
+    id<NSSharingServicePickerDelegate> _delegate;
+}
+
+- (instancetype)initWithItems:(NSArray *)items
+{
+    if ((self = [super init]))
+        _items = [items copy];
+    return self;
+}
+
+- (void)dealloc
+{
+    [_items release];
+    [_services release];
+    [_menu release];
+    [_standardItem release];
+    [super dealloc];
+}
+
+- (id<NSSharingServicePickerDelegate>)delegate { return _delegate; }
+- (void)setDelegate:(id<NSSharingServicePickerDelegate>)delegate { _delegate = delegate; }
+
+// the services for the items: the system's (none) as the delegate reshapes them
+- (NSArray *)_services
+{
+    NSArray *proposed = [NSSharingService sharingServicesForItems:_items] ?: @[];
+
+    if ([_delegate respondsToSelector:@selector(sharingServicePicker:sharingServicesForItems:proposedSharingServices:)])
+        proposed = [_delegate sharingServicePicker:self sharingServicesForItems:_items proposedSharingServices:proposed] ?: @[];
+    return proposed;
+}
+
+- (void)_chooseService:(NSMenuItem *)item
+{
+    NSSharingService *service = [item representedObject];
+
+    if ([_delegate respondsToSelector:@selector(sharingServicePicker:delegateForSharingService:)])
+        [service setDelegate:[_delegate sharingServicePicker:self delegateForSharingService:service]];
+    if ([_delegate respondsToSelector:@selector(sharingServicePicker:didChooseSharingService:)])
+        [_delegate sharingServicePicker:self didChooseSharingService:service];
+    [service performWithItems:_items];
+}
+
+- (NSMenu *)_buildMenu
+{
+    NSMenu *menu = [[[NSMenu alloc] initWithTitle:@"Share"] autorelease];
+
+    [_services release];
+    _services = [[self _services] copy];
+    for (NSSharingService *service in _services) {
+        NSString *title = [service menuItemTitle] ?: [service title] ?: @"";
+        NSMenuItem *item = [[[NSMenuItem alloc] initWithTitle:title action:@selector(_chooseService:) keyEquivalent:@""] autorelease];
+
+        [item setTarget:self];
+        [item setRepresentedObject:service];
+        [item setImage:[service image]];
+        [menu addItem:item];
+    }
+    return menu;
+}
+
+// a menu item whose submenu is the picker's menu, for an application's own Share menu
+- (NSMenuItem *)standardShareMenuItem
+{
+    if (_standardItem == nil) {
+        _standardItem = [[NSMenuItem alloc] initWithTitle:@"Share" action:NULL keyEquivalent:@""];
+        [_standardItem setSubmenu:[self _buildMenu]];
+    }
+    return _standardItem;
+}
+
+// with no service to offer nothing is shown, and the delegate hears that nothing was chosen
+- (void)showRelativeToRect:(NSRect)rect ofView:(NSView *)view preferredEdge:(NSRectEdge)preferredEdge
+{
+    [_menu release];
+    _menu = [[self _buildMenu] retain];
+    if ([_menu numberOfItems] == 0) {
+        if ([_delegate respondsToSelector:@selector(sharingServicePicker:didChooseSharingService:)])
+            [_delegate sharingServicePicker:self didChooseSharingService:nil];
+        return;
+    }
+    NSPoint where = NSMakePoint(preferredEdge == NSMaxXEdge ? NSMaxX(rect) : NSMinX(rect),
+                                preferredEdge == NSMaxYEdge ? NSMaxY(rect) : NSMinY(rect));
+    [_menu popUpMenuPositioningItem:nil atLocation:where inView:view];
+}
+
+- (void)close
+{
+    [_menu cancelTracking];
+}
+
+@end
