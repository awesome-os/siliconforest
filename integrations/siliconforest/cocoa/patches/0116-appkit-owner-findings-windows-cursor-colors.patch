+// on the main thread: the answer to one request line
+static NSString *sfAppMenuAnswer(NSString *line) {
+    NSArray *words = [line componentsSeparatedByString:@" "];
+    NSString *verb = [words count] ? [words objectAtIndex:0] : @"";
+    if ([verb isEqualToString:@"menu"]) {
+        NSMutableString *out = [NSMutableString string];
+        if ([NSApp mainMenu] != nil)
+            sfAppMenuAppend(out, [NSApp mainMenu], nil, 0);
+        [out appendString:@"end\n"];
+        return out;
+    }
+    if ([verb isEqualToString:@"invoke"] && [words count] > 1) {
+        NSArray *path = [[words objectAtIndex:1] componentsSeparatedByString:@"."];
+        NSMenu *menu = [NSApp mainMenu];
+        for (NSUInteger k = 0; menu != nil && k + 1 < [path count]; k++) {
+            NSInteger i = [[path objectAtIndex:k] integerValue];
+            menu = (i >= 0 && i < [menu numberOfItems]) ? [[menu itemAtIndex:i] submenu] : nil;
+        }
+        NSInteger last = [[path lastObject] integerValue];
+        if (menu == nil || last < 0 || last >= [menu numberOfItems])
+            return @"error gone\n";
+        [menu update];
+        NSMenuItem *item = [menu itemAtIndex:last];
+        if (![item isEnabled] || [item hasSubmenu] || [item isSeparatorItem])
+            return @"error disabled\n";
+        // after the answer, as a click in the strip does it (an action may run a modal session)
+        dispatch_async(dispatch_get_main_queue(), ^{ [NSApp sendAction:[item action] to:[item target] from:item]; });
+        return @"ok\n";
+    }
+    if ([verb isEqualToString:@"menubar"]) {
+        NSString *how = [words count] > 1 ? [words objectAtIndex:1] : nil;
+        BOOL on = [NSWindow _sfMenuStripsEnabled];
+        if (how == nil)
+            return on ? @"shown\n" : @"hidden\n";
+        if ([how isEqualToString:@"show"]) on = YES;
+        else if ([how isEqualToString:@"hide"]) on = NO;
+        else if ([how isEqualToString:@"toggle"]) on = !on;
+        else return @"error request\n";
+        [NSWindow _sfSetMenuStripsEnabled:on];
+        return on ? @"ok shown\n" : @"ok hidden\n";
+    }
+    return @"error request\n";
+}
+
+static void sfAppMenuServe(int fd) {
+    char buf[1024];
+    size_t used = 0;
+    struct timeval tv = { 2, 0 };
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+    for (;;) {
+        ssize_t n = read(fd, buf + used, sizeof buf - 1 - used);
+        if (n <= 0)
+            break;
+        used += (size_t)n;
+        char *nl;
+        while ((nl = memchr(buf, '\n', used)) != NULL) {
+            *nl = 0;
+            NSString *line = [NSString stringWithUTF8String:buf];
+            __block NSString *answer = nil;
+            if (line != nil)
+                dispatch_sync(dispatch_get_main_queue(), ^{
+                    NSAutoreleasePool *pool = [NSAutoreleasePool new];
+                    answer = [sfAppMenuAnswer(line) retain];
+                    [pool release];
+                });
+            const char *text = answer ? [answer UTF8String] : "error request\n";
+            size_t left = strlen(text);
+            while (left > 0) {
+                ssize_t w = write(fd, text, left);
+                if (w <= 0) break;
+                text += w; left -= (size_t)w;
+            }
+            [answer release];
+            used -= (size_t)(nl + 1 - buf);
+            memmove(buf, nl + 1, used);
+        }
+        if (used == sizeof buf - 1)  // a line longer than any request
+            break;
+    }
+    close(fd);
+}
+
++ (void)_sfStartAppMenuServer
+{
+    static BOOL started;
+    const char *runtime = getenv("XDG_RUNTIME_DIR");
+    if (started || runtime == NULL || runtime[0] == 0)
+        return;
+    started = YES;
+    char dir[200];
+    snprintf(dir, sizeof dir, "%s/app-menu", runtime);
+    mkdir(dir, 0700);
+    snprintf(sfAppMenuPath, sizeof sfAppMenuPath, "%s/%d", dir, (int)getpid());
+    unlink(sfAppMenuPath);
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    struct sockaddr_un addr = { 0 };
+    addr.sun_family = AF_UNIX;
+    strlcpy(addr.sun_path, sfAppMenuPath, sizeof addr.sun_path);
+    if (fd < 0 || bind(fd, (struct sockaddr *)&addr, sizeof addr) != 0 || listen(fd, 4) != 0) {
+        if (fd >= 0) close(fd);
+        sfAppMenuPath[0] = 0;
+        return;
+    }
+    chmod(sfAppMenuPath, 0600);
+    atexit(sfAppMenuRemove);
+    dispatch_source_t source = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, (uintptr_t)fd, 0,
+                                                      dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0));
+    dispatch_source_set_event_handler(source, ^{
+        int client = accept(fd, NULL, NULL);
+        if (client < 0)
+            return;
+        uid_t uid; gid_t gid;
+        if (getpeereid(client, &uid, &gid) != 0 || uid != getuid()) {
+            close(client);
+            return;
+        }
+        dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{ sfAppMenuServe(client); });
+    });
+    dispatch_resume(source);
+}
+
 @end
