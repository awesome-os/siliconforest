+/* ---- the desk's window menu (DESK3's per-application socket, runs/m1-coord/answers-from-DESK3.md):
+ * $XDG_RUNTIME_DIR/app-menu/<pid>, UTF-8 lines. `menu 1` answers the main menu depth first, one line per item
+ * (`item <id> <depth> <flags> <key> <title>`, then `end`), validated at that moment; `invoke <id>` runs an item as a
+ * click in the strip does; `menubar [show|hide|toggle]` reads or sets the in-window strip. Nothing runs until the
+ * compositor connects (a listening socket and a dispatch source). */
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <dispatch/dispatch.h>
+
+static char sfAppMenuPath[256];
+
+static void sfAppMenuRemove(void) {
+    if (sfAppMenuPath[0])
+        unlink(sfAppMenuPath);
+}
+
+static NSString *sfAppMenuKey(NSMenuItem *item) {
+    NSString *key = [item keyEquivalent];
+    if ([key length] == 0)
+        return @"-";
+    NSUInteger mods = [item keyEquivalentModifierMask];
+    unichar c = [key characterAtIndex:0];
+    if (c >= 'A' && c <= 'Z') {
+        mods |= NSShiftKeyMask;
+        c = c - 'A' + 'a';
+    }
+    NSMutableString *s = [NSMutableString string];
+    if (mods & NSCommandKeyMask) [s appendString:@"cmd+"];
+    if (mods & NSShiftKeyMask) [s appendString:@"shift+"];
+    if (mods & NSAlternateKeyMask) [s appendString:@"opt+"];
+    if (mods & NSControlKeyMask) [s appendString:@"ctrl+"];
+    switch (c) {
+    case '\r': case '\n': case 3: [s appendString:@"return"]; break;
+    case '\t': [s appendString:@"tab"]; break;
+    case 8: case 0x7f: [s appendString:@"delete"]; break;
+    case 0x1b: [s appendString:@"esc"]; break;
+    case ' ': [s appendString:@"space"]; break;
+    case NSLeftArrowFunctionKey: [s appendString:@"left"]; break;
+    case NSRightArrowFunctionKey: [s appendString:@"right"]; break;
+    case NSUpArrowFunctionKey: [s appendString:@"up"]; break;
+    case NSDownArrowFunctionKey: [s appendString:@"down"]; break;
+    default:
+        if (c >= NSF1FunctionKey && c <= NSF35FunctionKey)
+            [s appendFormat:@"f%d", (int)(c - NSF1FunctionKey + 1)];
+        else
+            [s appendString:[NSString stringWithCharacters:&c length:1]];
+    }
+    return s;
+}
+
+static void sfAppMenuAppend(NSMutableString *out, NSMenu *menu, NSString *prefix, int depth) {
+    [menu update];  // validateMenuItem: / autoenabling, as when the menu opens
+    NSArray *items = [menu itemArray];
+    for (NSUInteger i = 0; i < [items count]; i++) {
+        NSMenuItem *item = [items objectAtIndex:i];
+        if ([item respondsToSelector:@selector(isHidden)] && [item isHidden])
+            continue;
+        NSString *ident = prefix ? [NSString stringWithFormat:@"%@.%lu", prefix, (unsigned long)i]
+                                 : [NSString stringWithFormat:@"%lu", (unsigned long)i];
+        if ([item isSeparatorItem]) {
+            [out appendFormat:@"item %@ %d p - \n", ident, depth];
+            continue;
+        }
+        NSMutableString *flags = [NSMutableString string];
+        if ([item hasSubmenu]) [flags appendString:@"s"];
+        if (![item isEnabled]) [flags appendString:@"d"];
+        if ([item state] == NSOnState) [flags appendString:@"c"];
+        if ([item state] == NSMixedState) [flags appendString:@"m"];
+        NSString *title = [item title];
+        if (depth == 0 && i == 0) {
+            [flags appendString:@"a"];
+            title = [[NSProcessInfo processInfo] processName];
+        }
+        title = [[[title stringByReplacingOccurrencesOfString:@"\t" withString:@" "]
+                    stringByReplacingOccurrencesOfString:@"\n" withString:@" "] stringByReplacingOccurrencesOfString:@"\r" withString:@" "];
+        [out appendFormat:@"item %@ %d %@ %@ %@\n", ident, depth, [flags length] ? flags : @"-", sfAppMenuKey(item), title];
+        if ([item hasSubmenu])
+            sfAppMenuAppend(out, [item submenu], ident, depth + 1);
+    }
+}
