+    xdg_popup_reposition(window->popup, positioner, ++ws.popupToken);
+    xdg_positioner_destroy(positioner);
+    if (getenv("SF_WS_TRACE") != NULL)
+        fprintf(stderr, "WindowServer: popup %d moved to %d,%d of window %d, %gx%g\n", window->windowID, x, y,
+                parent->windowID, window->w, window->h);
+}
