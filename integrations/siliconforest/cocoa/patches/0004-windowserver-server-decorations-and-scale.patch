+static void unmapPassed(void *data, struct wl_callback *callback, uint32_t serial) {
+    struct wsWindow *window = windowForID((int)(intptr_t)data);
+
+    (void)serial;
+    wl_callback_destroy(callback);
+    if (window != NULL) {
+        pthread_mutex_lock(&ws.queueLock);
+        if (window->staleConfigures > 0)
+            window->staleConfigures--;
+        pthread_mutex_unlock(&ws.queueLock);
+    }
+}
