+// where a popup goes: its frame against its parent's, as AppKit has them
+static struct xdg_positioner *popupPositioner(struct wsWindow *window, struct wsWindow *parent, int32_t *xp, int32_t *yp) {
+    struct xdg_positioner *positioner;
+    int32_t x, y;
+
+    // AppKit's y runs up from the bottom of the screen: the popup's top edge below the parent's top edge
+    x = (int32_t)floor(window->x - parent->x);
+    y = (int32_t)floor((parent->y + parent->h) - (window->y + window->h));
+    positioner = xdg_wm_base_create_positioner(ws.wmBase);
+    xdg_positioner_set_size(positioner, (int32_t)fmax(1, window->w), (int32_t)fmax(1, window->h));
+    xdg_positioner_set_anchor_rect(positioner, x, y, 1, 1);
+    xdg_positioner_set_anchor(positioner, XDG_POSITIONER_ANCHOR_TOP_LEFT);
+    xdg_positioner_set_gravity(positioner, XDG_POSITIONER_GRAVITY_BOTTOM_RIGHT);
+    // kept on the screen by sliding, as a menu at the screen's edge is on macOS
+    xdg_positioner_set_constraint_adjustment(positioner, XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_X |
+                                                         XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_Y);
+    *xp = x, *yp = y;
+    return positioner;
+}
