+ * under the pointer, else the one with the keyboard; the place is the difference of the two
+ * frames as AppKit has them, which is right wherever the compositor really put the parent. */
+static struct wsWindow *popupParentFor(struct wsWindow *window) {
+    struct wsWindow *candidate, *best = NULL;
+
+    if (window->level != kWSPopUpMenuLevel || wsStyleWantsServerFrame(window->style))
+        return NULL;
+    for (candidate = ws.windows; candidate != NULL; candidate = candidate->next) {
+        // the list is newest first: the first mapped popup found is the last one opened
+        if (candidate != window && candidate->popup != NULL && candidate->attached)
+            return candidate;
+    }
+    best = windowForID(ws.pointerWindowID);
+    if (best == NULL || best == window || best->xdgSurface == NULL || !best->attached)
+        best = windowForID(ws.focusWindowID);
+    if (best == NULL || best == window || best->xdgSurface == NULL || !best->attached)
+        return NULL;
+    return best;
+}
