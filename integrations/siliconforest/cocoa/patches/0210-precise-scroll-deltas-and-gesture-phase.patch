+// Private wire metadata is removed by NSApplication before modifierFlags reach clients.
+-(void)_sfSetPreciseScrolling:(BOOL)precise phase:(NSEventPhase)phase {
+    _sfPreciseScroll=(_type==NSScrollWheel)&&precise;
+    _sfScrollPhase=_sfPreciseScroll?phase:NSEventPhaseNone;
+}
+-(BOOL)hasPreciseScrollingDeltas {return _sfPreciseScroll;}
+-(NSEventPhase)phase {return _sfScrollPhase;}
+
