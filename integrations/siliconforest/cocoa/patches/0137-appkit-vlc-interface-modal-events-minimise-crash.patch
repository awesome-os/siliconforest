+
+/* (TERM8) NSString's -drawWithRect:options:attributes: (macOS 10.0) and its 10.11 form with a context: what Terminal draws
+ * its miniaturised window's title with. With NSStringDrawingUsesLineFragmentOrigin the rect is the text's box, as for
+ * -drawInRect:withAttributes:; without it the string is one line from the rect's origin. Without a current graphics
+ * context nothing is drawn (CoreGraphics on macOS logs an invalid context): Terminal draws so while miniaturising. */
+@implementation NSString(NSStringDrawingWithRect)
+
+-(void)drawWithRect:(NSRect)rect options:(NSStringDrawingOptions)options attributes:(NSDictionary *)attributes {
+   if(NSCurrentGraphicsPort()==NULL)
+    return;
+   if(options&NSStringDrawingUsesLineFragmentOrigin)
+    [self drawInRect:rect withAttributes:attributes];
+   else
+    [self drawAtPoint:rect.origin withAttributes:attributes];
+}
+
+-(void)drawWithRect:(NSRect)rect options:(NSStringDrawingOptions)options attributes:(NSDictionary *)attributes context:(id)context {
+   [self drawWithRect:rect options:options attributes:attributes];
+}
+
+-(NSRect)boundingRectWithSize:(NSSize)size options:(NSStringDrawingOptions)options attributes:(NSDictionary *)attributes context:(id)context {
+   return [self boundingRectWithSize:size options:options attributes:attributes];
