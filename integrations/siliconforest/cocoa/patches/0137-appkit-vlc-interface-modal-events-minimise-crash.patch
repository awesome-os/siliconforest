+@implementation NSMutableAttributedString (SFAlignmentRange)
+
+- (void)setAlignment:(NSTextAlignment)alignment range:(NSRange)range {
+    NSString *string = [self string];
+    NSUInteger length = [string length];
+
+    if (NSMaxRange(range) > length)
+        [NSException raise:NSRangeException format:@"-[%@ %s]: range %@ beyond length %lu", [self class],
+                                                   sel_getName(_cmd), NSStringFromRange(range), (unsigned long)length];
+    if (length == 0)
+        return;
+    range = [string paragraphRangeForRange:range];
+    [self beginEditing];
+    for (NSUInteger at = range.location; at < NSMaxRange(range);) {
+        NSRange paragraph = [string paragraphRangeForRange:NSMakeRange(at, 0)];
+        NSRange effective;
+        NSParagraphStyle *style = [self attribute:NSParagraphStyleAttributeName atIndex:paragraph.location
+                                   effectiveRange:&effective];
+        NSMutableParagraphStyle *changed = [[(style ?: [NSParagraphStyle defaultParagraphStyle]) mutableCopy] autorelease];
+
+        [changed setAlignment:alignment];
+        [self addAttribute:NSParagraphStyleAttributeName value:changed range:paragraph];
+        if (NSMaxRange(paragraph) <= at)
+            break;
+        at = NSMaxRange(paragraph);
+    }
+    [self endEditing];
+}
+
+@end
+
+@implementation NSTextView (SFAlignmentRange)
+
+- (void)setAlignment:(NSTextAlignment)alignment range:(NSRange)range {
+    [self _setAlignment:alignment range:range];
+}
+
+@end
