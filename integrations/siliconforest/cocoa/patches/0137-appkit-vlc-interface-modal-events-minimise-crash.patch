+// (TERM8) +currentControlTint (VLC's interface asks it): macOS's AppleAquaColorVariant in the global domain, 6 graphite and
+// anything else blue; an accent colour of graphite (AppleAccentColor -1) is graphite too. Read again only when a global
+// preferences file changed, as for controlAccentColor.
++(NSControlTint)currentControlTint {
+    static NSControlTint tint = NSBlueControlTint;
+    static struct timespec seen[2];
+    static BOOL read;
+    static char paths[2][1024];
+    struct timespec now[2] = { { 0, 0 }, { 0, 0 } };
+    struct stat st;
+    CFPropertyListRef v;
+
+    if (paths[0][0] == 0) {
+        const char *home = getenv("CFFIXED_USER_HOME") ?: getenv("HOME") ?: "/var/root";
+
+        snprintf(paths[0], sizeof(paths[0]), "%s/Library/Preferences/.GlobalPreferences.plist", home);
+        snprintf(paths[1], sizeof(paths[1]), "/Library/Preferences/.GlobalPreferences.plist");
+    }
+    for (int i = 0; i < 2; i++)
+        if (stat(paths[i], &st) == 0)
+            now[i] = st.st_mtimespec;
+    if (read && memcmp(now, seen, sizeof(now)) == 0)
+        return tint;
+    memcpy(seen, now, sizeof(now));
+    read = YES;
+    CFPreferencesAppSynchronize(kCFPreferencesAnyApplication);
+    tint = NSBlueControlTint;
+    if ((v = CFPreferencesCopyAppValue(CFSTR("AppleAquaColorVariant"), kCFPreferencesAnyApplication)) != NULL) {
+        if ([(id)v respondsToSelector:@selector(intValue)] && [(id)v intValue] == NSGraphiteControlTint)
+            tint = NSGraphiteControlTint;
+        CFRelease(v);
+    }
+    if ((v = CFPreferencesCopyAppValue(CFSTR("AppleAccentColor"), kCFPreferencesAnyApplication)) != NULL) {
+        if ([(id)v respondsToSelector:@selector(intValue)] && [(id)v intValue] == -1)
+            tint = NSGraphiteControlTint;
+        CFRelease(v);
+    }
+    return tint;
+}
+
+// the colour of a tint: the accent colour for blue (and the default), graphite grey, clear
++(NSColor *)colorForControlTint:(NSControlTint)controlTint {
+    if (controlTint == NSDefaultControlTint)
+        controlTint = [self currentControlTint];
+    if (controlTint == NSGraphiteControlTint)
+        return [NSColor colorWithCalibratedRed:0x8c / 255.0 green:0x8c / 255.0 blue:0x8c / 255.0 alpha:1];
+    if (controlTint == NSClearControlTint)
+        return [NSColor clearColor];
+    return [self controlAccentColor];
+}
+
