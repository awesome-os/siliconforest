+@interface NSTextView (SFAlignment)
+- (void)_setAlignment:(NSTextAlignment)alignment range:(NSRange)range;
+@end
+
+static char kAllowsEditingTextAttributes, kImportsGraphics;
+
+static BOOL flag(id self, const void *key) {
+    return [objc_getAssociatedObject(self, key) boolValue];
+}
+
+static void setFlag(id self, const void *key, BOOL value) {
+    objc_setAssociatedObject(self, key, value ? [NSNumber numberWithBool:YES] : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
