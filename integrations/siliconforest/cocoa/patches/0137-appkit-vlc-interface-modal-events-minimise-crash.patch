+}
+
+- (void)setAllowsEditingTextAttributes:(BOOL)value {
+    setFlag(self, &kAllowsEditingTextAttributes, value);
+    if (!value)
+        setFlag(self, &kImportsGraphics, NO);   // macOS: importing graphics needs editable attributes
+}
+
+- (BOOL)importsGraphics {
+    return flag(self, &kImportsGraphics);
+}
+
+- (void)setImportsGraphics:(BOOL)value {
+    setFlag(self, &kImportsGraphics, value);
+    if (value)
