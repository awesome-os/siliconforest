  * its own, which replaces what was shown. Before, such a flush waited up to 100 ms on the
  * application's main thread and was then dropped: the last lines of a burst of output stayed
  * off the screen until something else drew (Terminal: the cursor's next blink). */
+/* (TERM9, FXPERF's FX-029 ask) SF_WS_PACE_PRESENTS=1: a window presents at most once per frame callback, as a Wayland
+ * client paced by the compositor does (and as Core Animation coalesces commits per refresh): a flush that comes while
+ * the window's last commit has not been drawn yet only marks presentPending, and the callback presents the newest
+ * backing store once. A callback that has not come in 100 ms no longer holds a flush back. */
+static int wsPacePresents(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char *v = getenv("SF_WS_PACE_PRESENTS");
+        on = v != NULL && strcmp(v, "1") == 0;
+    }
+    return on;
+}
+static void windowPacedCommit(struct wsWindow *window);
+static void pacedFrameDone(void *data, struct wl_callback *callback, uint32_t time) {
+    int windowID = (int)(intptr_t)data;
+    wl_callback_destroy(callback);
+    pthread_mutex_lock(&ws.pixelsLock);
+    struct wsWindow *window = windowForID(windowID);
+    if (window != NULL) {
+        window->frameOut = 0;
+        if (window->presentPending && window->state != MINIMIZED && window->state != HIDDEN && window->surface != NULL) {
+            window->presentPending = 0;
+            if (windowPresent(window)) {
+                windowPacedCommit(window);
+                if (wsTiming())
+                    fprintf(stderr, "WSTIME %.1f commit-on-frame surface=%d\n", wsNowMs(), window->windowID);
+            }
+        }
+    }
+    pthread_mutex_unlock(&ws.pixelsLock);
+}
+static const struct wl_callback_listener pacedFrameListener = { .done = pacedFrameDone };
+// the commit of a presented frame, with the callback that paces the next one (called with ws.pixelsLock held)
+static void windowPacedCommit(struct wsWindow *window) {
+    if (wsPacePresents()) {
+        struct wl_callback *callback = wl_surface_frame(window->surface);
+        if (callback != NULL) {
+            wl_callback_add_listener(callback, &pacedFrameListener, (void *)(intptr_t)window->windowID);
+            window->frameOut = 1;
+            window->frameOutAt = wsNowMs();
+        }
+    }
+    wl_surface_commit(window->surface);
+    wl_display_flush(ws.display);
+}
