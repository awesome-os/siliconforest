+/* The uniform type identifier of a file, from its extension: the types the application itself
+ * declares (UTExportedTypeDeclarations, UTImportedTypeDeclarations of its Info.plist; there is no
+ * system-wide type database here), then a few public types. A file whose extension nothing
+ * declares is answered with the extension, as before. */
 -(NSString *)typeOfFile:(NSString *)path error:(NSError **)error {
+   NSString     *extension=[[path pathExtension] lowercaseString];
+   NSDictionary *info=[[NSBundle mainBundle] infoDictionary];
+   BOOL          isDirectory=NO;
+
+   for(NSString *key in [NSArray arrayWithObjects:@"UTExportedTypeDeclarations",@"UTImportedTypeDeclarations",nil]){
+    id declarations=[info objectForKey:key];
+
+    if(![declarations isKindOfClass:[NSArray class]])
+     continue;
+    for(NSDictionary *declaration in declarations){
+     if(![declaration isKindOfClass:[NSDictionary class]])
+      continue;
+     id tags=[[declaration objectForKey:@"UTTypeTagSpecification"] objectForKey:@"public.filename-extension"];
+     NSString *identifier=[declaration objectForKey:@"UTTypeIdentifier"];
+
+     if([tags isKindOfClass:[NSString class]])
+      tags=[NSArray arrayWithObject:tags];
+     if(![tags isKindOfClass:[NSArray class]] || ![identifier isKindOfClass:[NSString class]])
+      continue;
+     for(NSString *tag in tags)
+      if([tag isKindOfClass:[NSString class]] && [[tag lowercaseString] isEqualToString:extension])
+       return identifier;
+    }
+   }
+   if([extension length]==0 && [[NSFileManager defaultManager] fileExistsAtPath:path isDirectory:&isDirectory] && isDirectory)
+    return @"public.folder";
+   {
+    static NSDictionary *known=nil;
+
+    if(known==nil)
+     known=[[NSDictionary alloc] initWithObjectsAndKeys:@"public.plain-text",@"txt",@"com.apple.property-list",@"plist",
+       @"public.png",@"png",@"public.jpeg",@"jpg",@"public.jpeg",@"jpeg",@"public.tiff",@"tiff",@"public.tiff",@"tif",
+       @"com.adobe.pdf",@"pdf",@"public.rtf",@"rtf",@"public.html",@"html",@"public.xml",@"xml",@"public.json",@"json",
+       @"public.shell-script",@"sh",@"com.apple.application-bundle",@"app",nil];
+    if([known objectForKey:extension]!=nil)
+     return [known objectForKey:extension];
+   }
    return [path pathExtension];
 }
 
