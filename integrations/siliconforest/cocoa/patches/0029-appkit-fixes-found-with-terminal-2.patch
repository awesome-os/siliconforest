+/* SPDX-License-Identifier: MIT
+ *
+ * -[NSAttributedString URLAtIndex:effectiveRange:] (AppKit's addition for automatic link
+ * detection): the URL of a link attribute at the index, or the URL that the text around the index
+ * spells. Text counts as a URL when the run of characters without white space around the index
+ * (less surrounding punctuation) has a scheme followed by "://", is a mailto: address, or begins
+ * with "www."; nothing else is guessed.
+ */
+#import <Foundation/Foundation.h>
+#import <AppKit/NSAttributedString.h>
+
+@implementation NSAttributedString (SFURLAtIndex)
+
+- (NSURL *)URLAtIndex:(NSUInteger)location effectiveRange:(NSRangePointer)effectiveRange
+{
+    NSString *string = [self string];
+    NSUInteger length = [string length], start, end;
+    NSRange linkRange = NSMakeRange(NSNotFound, 0);
+    NSCharacterSet *space = [NSCharacterSet whitespaceAndNewlineCharacterSet];
+    NSCharacterSet *trimmed = [NSCharacterSet characterSetWithCharactersInString:@"<>()[]{}\"'`.,;:!?"];
+    NSString *word, *lower;
+    NSURL *url = nil;
+    id link;
+
+    if (effectiveRange != NULL)
+        *effectiveRange = NSMakeRange(location, 0);
+    if (location >= length)
+        return nil;
+    link = [self attribute:NSLinkAttributeName atIndex:location effectiveRange:&linkRange];
+    if ([link isKindOfClass:[NSString class]])
+        link = [NSURL URLWithString:link];
+    if ([link isKindOfClass:[NSURL class]]) {
+        if (effectiveRange != NULL)
+            *effectiveRange = linkRange;
+        return link;
+    }
+    if ([space characterIsMember:[string characterAtIndex:location]])
+        return nil;
+    // the run without white space round the index, at most 2048 characters each way
+    for (start = location; start > 0 && location - start < 2048 && ![space characterIsMember:[string characterAtIndex:start - 1]]; start--)
+        ;
+    for (end = location + 1; end < length && end - location < 2048 && ![space characterIsMember:[string characterAtIndex:end]]; end++)
+        ;
+    while (start < end && [trimmed characterIsMember:[string characterAtIndex:start]])
+        start++;
+    while (end > start && [trimmed characterIsMember:[string characterAtIndex:end - 1]])
+        end--;
+    if (location < start || location >= end)
+        return nil;
+    word = [string substringWithRange:NSMakeRange(start, end - start)];
+    lower = [word lowercaseString];
+    if ([lower hasPrefix:@"www."] && [word length] > 6)
+        url = [NSURL URLWithString:[@"http://" stringByAppendingString:word]];
+    else if ([lower hasPrefix:@"mailto:"] && [word rangeOfString:@"@"].location != NSNotFound)
+        url = [NSURL URLWithString:word];
+    else {
+        NSRange sep = [word rangeOfString:@"://"];
+        NSUInteger i;
+        BOOL scheme = sep.location != NSNotFound && sep.location > 0 && NSMaxRange(sep) < [word length];
+
+        for (i = 0; scheme && i < sep.location; i++) {
+            unichar c = [lower characterAtIndex:i];
+
+            scheme = (c >= 'a' && c <= 'z') || (i > 0 && ((c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'));
+        }
+        if (scheme)
+            url = [NSURL URLWithString:word];
+    }
+    if (url != nil && effectiveRange != NULL)
+        *effectiveRange = NSMakeRange(start, end - start);
+    return url;
+}
+
+@end
