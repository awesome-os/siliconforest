+/* Of the faces with the traits, the one whose style is the plain form of them: "Bold" for bold,
+ * "Italic" (or "Regular Italic") for italic, "Regular" for neither. A family with weights between
+ * (a variable font's named instances: Light, Medium, Semibold, Bold, Heavy) has several faces with
+ * the bold or the italic trait; the first in the list was taken (Terminal's bold came out Heavy,
+ * its italic Light Italic). Then the first, as before. */
+static NSString *SFPlainStyle(NSFontTraitMask traits) {
+   BOOL bold=(traits&NSBoldFontMask)!=0,italic=(traits&NSItalicFontMask)!=0;
+
+   return bold ? (italic ? @"bold italic" : @"bold") : (italic ? @"italic" : @"regular");
+}
