#!/bin/sh
# One boot for everything that depends on the kernel of ../kernel.nix, least risky first:
# DL45 (DRM fd waits, as darwin-dcp-wait-test.in: a regression check on the new kernel),
# DL48 (sync_file and dma-buf waits, darwin-dcp-fence-test.in) and DL47 (SCM_RIGHTS,
# darwin-dcp-scm-test.in). Needs SFAgx + SFDcp, sfagx=1 sfdcp=2. Pass criteria are in those
# three scripts. (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
run() { # tag, label, test arguments...
    tag=$1; label=$2; shift 2
    out=$(dcp-flip-test "$@" 2>&1); rc=$?
    printf '%s\n' "$out" | grep -e 'flips' -e 'timing:' -e 'wait mode' -e 'fence' -e 'child' -e 'received' -e 'readback' \
        -e 'exporting process' -e FAIL -e 'failed' -e PASS | cut -c1-240 | sed "s/^/$tag /"
    printf '%s_%s_RC=%s\n' "$tag" "$label" "$rc"
}
uname -v | cut -c1-120 | sed 's/^/DL45 kernel: /'
printf '\nDL45_WAIT_BEGIN_%s\n' "$nonce"
for mode in read poll select kqueue; do run DL45 "WAIT_$mode" --seconds 1 --wait "$mode"; done
printf 'DL45_WAIT_END_%s\n' "$nonce"
printf '\nDL48_FENCE_BEGIN_%s\n' "$nonce"
for mode in poll select kqueue; do run DL48 "FENCE_$mode" --seconds 1 --fence "$mode"; done
run DL48 FENCE_gpubuf --seconds 1 --prime-from auto --fence poll
printf 'DL48_FENCE_END_%s\n' "$nonce"
printf '\nDL47_SCM_BEGIN_%s\n' "$nonce"
run DL47 SCM --seconds 2 --prime-from auto --scm-rights
printf 'DL47_SCM_END_%s\n' "$nonce"
