#!/bin/sh
# Guest side of the display sleep test (SFDcp, sfdcp=2): after one second of flips, 20 cycles
# of CRTC ACTIVE = 0 for two seconds and ACTIVE = 1, each followed by half a second of flips.
# Pass: DL53_SLEEP_RC=0 and "display sleep: 20 of 20 cycles woke and flipped", lowest rate
# about 60 per second.
# (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nDL53_SLEEP_BEGIN_%s\n' "$nonce"
sf-backlight get 2>&1 | sed 's/^/DL53 before: /'
out=$(dcp-flip-test --seconds 1 --dpms-cycles ${DL53_CYCLES:-20} --dpms-off-ms ${DL53_OFF_MS:-2000} 2>&1); rc=$?
printf '%s\n' "$out" | grep -e 'flips in' -e 'sleep' -e FAIL -e 'failed' -e PASS | cut -c1-260 | sed 's/^/DL53 /'
sf-backlight get 2>&1 | sed 's/^/DL53 after: /'
printf 'DL53_SLEEP_RC=%s\n' "$rc"
printf 'DL53_SLEEP_END_%s\n' "$nonce"
