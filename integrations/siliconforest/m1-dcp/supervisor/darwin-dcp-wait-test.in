#!/bin/sh
# Guest side of the DRM fd readiness test (SFDcp, sfdcp=2): the 1 s flip loop once per way of
# waiting for the flip-complete event. Pass: about 60 flips per second and no timeout in each.
# (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nDL45_WAIT_BEGIN_%s\n' "$nonce"
sysctl kern.sf_dri 2>&1 | head -12
for mode in read poll select kqueue; do
    out=$(dcp-flip-test --seconds 1 --wait "$mode" 2>&1); rc=$?
    printf '%s\n' "$out" | grep -e 'flips in' -e 'wait mode' -e FAIL -e 'revents' -e 'wait for' | cut -c1-200
    printf 'DL45_WAIT_%s_RC=%s\n' "$mode" "$rc"
done
printf 'DL45_WAIT_END_%s\n' "$nonce"
