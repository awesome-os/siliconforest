#!/bin/sh
# Guest side of the display flip test (SFDcp, sfdcp=2): KMS through /dev/dri/card0.
# (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nDL43_DCP_BEGIN_%s\n' "$nonce"
ls -l /dev/dri 2>&1 | head -5
sysctl kern.sf_dri 2>&1 | head -12
out=$(dcp-flip-test --seconds 2 2>&1); rc=$?
printf '%s\n' "$out" | cut -c1-200
printf 'DL43_FLIP_RC=%s\n' "$rc"
printf 'DL43_DCP_END_%s\n' "$nonce"
