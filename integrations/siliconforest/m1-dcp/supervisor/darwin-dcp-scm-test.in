#!/bin/sh
# Guest side of the descriptor-passing test (SFAgx + SFDcp, sfagx=1 sfdcp=2, on the kernel of
# ../kernel.nix): a child process creates two GPU buffers and sends their dma-buf descriptors
# over a Unix socket (SCM_RIGHTS); the parent imports them into the display driver and flips.
# Pass: DL47_SCM_RC=0, with the child's "sent and closed both descriptors", the parent's
# "received descriptors", both readbacks 0 pixels, "exporting process exited: status 0x0",
# about 60 flips per second and "10 flips after the exporting process exited".
# (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nDL47_SCM_BEGIN_%s\n' "$nonce"
out=$(dcp-flip-test --seconds 2 --prime-from auto --scm-rights 2>&1); rc=$?
printf '%s\n' "$out" | grep -e 'child' -e 'received' -e 'readback' -e 'exporting process' -e 'flips' -e 'timing:' -e 'wait mode' -e FAIL -e PASS | cut -c1-200 | sed 's/^/DL47 /'
printf 'DL47_SCM_RC=%s\n' "$rc"
printf 'DL47_SCM_END_%s\n' "$nonce"
