#!/bin/sh
# Guest side of the cross-driver scanout test (SFAgx + SFDcp, sfagx=1 sfdcp=2): buffers of the
# GPU driver, exported from the render node, imported into the card node and page-flipped.
# The plain flip test runs first so that a failure of the import is told apart from a
# failure of KMS itself. (@SSID@/@PSK@ are unused; the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nDL44_PRIME_BEGIN_%s\n' "$nonce"
ls -l /dev/dri 2>&1 | head -6
sysctl kern.sf_dri 2>&1 | head -12
out=$(dcp-flip-test --seconds 1 2>&1); rc=$?
printf '%s\n' "$out" | cut -c1-200
printf 'DL44_DUMB_RC=%s\n' "$rc"
out=$(dcp-flip-test --seconds 2 --prime-from auto 2>&1); rc=$?
printf '%s\n' "$out" | cut -c1-200
printf 'DL44_PRIME_RC=%s\n' "$rc"
printf 'DL44_PRIME_END_%s\n' "$nonce"
