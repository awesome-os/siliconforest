+// mmap of a linux file (kern_mman.c): ENODEV when the object's kind cannot be mapped
+int
+sf_lfile_mmap_pages(struct fileproc *fp, off_t offset, vm_size_t size, int prot,
+    ppnum_t *pages, unsigned int *wimg, void (**release)(void *), void **release_arg)
+{
+	void *obj = fp_get_data(fp);
+
+	if (fp->f_ops != &sf_lfileops || obj == NULL || sf_lfile_ops == NULL ||
+	    sf_lfile_ops->mmap_pages == NULL) {
+		return ENODEV;
+	}
+	return sf_lfile_ops->mmap_pages(obj, offset, size, prot, pages, wimg, release, release_arg);
+}
