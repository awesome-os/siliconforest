 #include <platform/string.h>
+#include <stdint.h>
+
+/*
+ * SiliconForest: the pattern is laid 16 bytes at a time (two 8-byte stores) from the start of the
+ * buffer, the partial pattern at the end byte by byte. The generic code called _platform_memmove()
+ * for every 4, 8 or 16 bytes. Compiled with -fno-builtin (see bzero.c).
+ */
+typedef uint64_t __attribute__((may_alias, aligned(1))) sf_u64u;
+
+static void
+sf_memset_pattern16(unsigned char *p, const unsigned char pat[16], size_t len)
+{
+	uint64_t lo = *(const sf_u64u *)pat, hi = *(const sf_u64u *)(pat + 8);
+	size_t i = 0;
+	for (; len - i >= 64; i += 64) {
+		*(sf_u64u *)(p + i) = lo; *(sf_u64u *)(p + i + 8) = hi;
+		*(sf_u64u *)(p + i + 16) = lo; *(sf_u64u *)(p + i + 24) = hi;
+		*(sf_u64u *)(p + i + 32) = lo; *(sf_u64u *)(p + i + 40) = hi;
+		*(sf_u64u *)(p + i + 48) = lo; *(sf_u64u *)(p + i + 56) = hi;
+	}
+	for (; len - i >= 16; i += 16) {
+		*(sf_u64u *)(p + i) = lo;
+		*(sf_u64u *)(p + i + 8) = hi;
+	}
+	for (size_t k = 0; i < len; i++, k++)
+		p[i] = pat[k];
+}
 
