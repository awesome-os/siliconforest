+/*
+ * realpath: stdlib.h decorates the definition in stdlib/FreeBSD/realpath.c
+ * as _realpath$DARWIN_EXTSN, but ICU (built against a plain-POSIX profile)
+ * imports the undecorated _realpath. Forward one to the other.
+ */
+extern char *__sf_realpath_extsn(const char * __restrict, char * __restrict)
+    __asm("_realpath$DARWIN_EXTSN");
+char *__sf_realpath_plain(const char * __restrict, char * __restrict)
+    __asm("_realpath");
+char *
+__sf_realpath_plain(const char * __restrict path, char * __restrict resolved)
+{
+    return __sf_realpath_extsn(path, resolved);
+}
