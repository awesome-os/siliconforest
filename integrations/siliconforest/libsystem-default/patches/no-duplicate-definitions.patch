+/* This fork's sys/cdefs.h stubs __weak_reference to a no-op (needed for
+ * static archive linking), so s_scalbn.c's `__strong_reference(scalbn,
+ * ldexp)` alias never gets pulled in unless something references it by name
+ * first. Forward explicitly to the real scalbn instead of aliasing. */
+double
+ldexp(double x, int n)
+{
+    return scalbn(x, n);
+}
+
+static pthread_key_t sf_dlerror_key;
+static pthread_once_t sf_dlerror_once = PTHREAD_ONCE_INIT;
+
+static void
+sf_dlerror_key_init(void)
+{
+    if (pthread_key_create(&sf_dlerror_key, free) != 0) {
+        sf_dlerror_key = 0;
+    }
+}
+
+static void
+sf_dlerror_set(const char *fmt, const char *a, const char *b)
+{
+    char *msg;
+
+    pthread_once(&sf_dlerror_once, sf_dlerror_key_init);
+    if (sf_dlerror_key == 0) {
+        return;
+    }
+    if (asprintf(&msg, fmt, a, b) < 0) {
+        return;
+    }
+    free(pthread_getspecific(sf_dlerror_key));
+    (void)pthread_setspecific(sf_dlerror_key, msg);
+}
+
+static char *
+sf_dlerror_take(void)
+{
+    char *msg;
+
+    pthread_once(&sf_dlerror_once, sf_dlerror_key_init);
+    if (sf_dlerror_key == 0) {
+        return NULL;
+    }
+    msg = pthread_getspecific(sf_dlerror_key);
+    if (msg != NULL) {
+        /* dlerror() reports an error once, then clears it. The buffer is kept
+         * and freed on the next set or at thread exit so the caller can read it. */
+        (void)pthread_setspecific(sf_dlerror_key, NULL);
+    }
+    return msg;
+}
+
+int
+dlclose(void *handle)
+{
+    typedef int (*dlclose_fn)(void *);
+    static dlclose_fn fn;
+
+    if (fn == NULL && !_dyld_func_lookup("__dyld_dlclose", (void **)&fn)) {
+        return -1;
+    }
+
+    return fn(handle);
+}
+
+void *
+dlopen(const char *path, int mode)
+{
+    typedef void *(*dlopen_fn)(const char *, int, void *);
+    static dlopen_fn fn;
+
+    if (fn == NULL && !_dyld_func_lookup("__dyld_dlopen_internal", (void **)&fn)) {
+        return NULL;
+    }
+
+    void *handle = fn(path, mode, __builtin_return_address(0));
+    if (handle == NULL) {
+        sf_dlerror_set("dlopen(%s): image not loaded%s", path ? path : "(null)", "");
+    }
+    return handle;
+}
