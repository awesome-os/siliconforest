+{
+    typedef bool (*dyld_is_memory_immutable_fn)(const void *, size_t);
+    static dyld_is_memory_immutable_fn fn;
+
+    if (fn == NULL && !_dyld_func_lookup("__dyld_is_memory_immutable", (void **)&fn)) {
+        return false;
+    }
+
+    return fn(addr, length);
