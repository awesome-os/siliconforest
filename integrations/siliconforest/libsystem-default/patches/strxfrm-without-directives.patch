diff -ruN a/src/Libraries/libSystem/libc/string/FreeBSD/strxfrm.c b/src/Libraries/libSystem/libc/string/FreeBSD/strxfrm.c
--- a/src/Libraries/libSystem/libc/string/FreeBSD/strxfrm.c	2026-11-13 10:17:27.334952002 -0800
+++ b/src/Libraries/libSystem/libc/string/FreeBSD/strxfrm.c	2026-11-13 10:18:17.791941699 -0800
@@ -85,6 +85,20 @@
 
 	__collate_xfrm(wcs, xf, loc);
 
+	/*
+	 * A collation table without directives (or an allocation that failed)
+	 * leaves no transformed string: wcslen(NULL) below ended every program
+	 * that called strxfrm() in such a locale (en_US.UTF-8 here; perl does
+	 * at start). Such a locale collates by byte value, as the C locale.
+	 */
+	if (xf[0] == NULL) {
+		sverrno = errno;
+		free(wcs);
+		free(xf[1]);
+		errno = sverrno;
+		return strlcpy(dest, src, len);
+	}
+
 	slen = wcslen(xf[0]) * XFRM_BYTES;
 	if (xf[1])
 		slen += (wcslen(xf[1]) + 1) * XFRM_BYTES;
diff -ruN a/src/Libraries/libSystem/libc/string/FreeBSD/wcsxfrm.c b/src/Libraries/libSystem/libc/string/FreeBSD/wcsxfrm.c
--- a/src/Libraries/libSystem/libc/string/FreeBSD/wcsxfrm.c	2026-11-13 10:17:27.334987145 -0800
+++ b/src/Libraries/libSystem/libc/string/FreeBSD/wcsxfrm.c	2026-11-13 10:18:17.791995144 -0800
@@ -71,6 +71,23 @@
 
 	__collate_xfrm(src, xf, loc);
 
+	/* no transformed string (see strxfrm_l): as without a collation table */
+	if (xf[0] == NULL) {
+		sverrno = errno;
+		free(xf[1]);
+		errno = sverrno;
+		slen = wcslen(src);
+		if (len > 0) {
+			if (slen < len)
+				wcscpy(dest, src);
+			else {
+				wcsncpy(dest, src, len - 1);
+				dest[len - 1] = L'\0';
+			}
+		}
+		return (slen);
+	}
+
 	slen = wcslen(xf[0]);
 	if (xf[1])
 		slen += wcslen(xf[1]) + 1;
