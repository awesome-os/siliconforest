+// The Objective-C runtime corrects references in an image when it is told the image is mapped
+// (protocol and superclass references among them). Current linkers put those sections into the
+// read-only __DATA_CONST segment and Apple's current dyld opens that segment for the runtime;
+// dyld2.cpp does the same around the "mapped" notification with this and makeDataReadOnly().
+void ImageLoaderMachOCompressed::makeDataWritable() const
+{
+#if !TEXT_RELOC_SUPPORT
+	if ( fReadOnlyDataSegment && !this->ImageLoader::inSharedCache() ) {
+		for (unsigned int i=0; i < fSegmentsCount; ++i) {
+			if ( segIsReadOnlyData(i) )
+				::mprotect((void*)segActualLoadAddress(i), segSize(i), PROT_READ | PROT_WRITE);
+		}
+	}
+#endif
+}
