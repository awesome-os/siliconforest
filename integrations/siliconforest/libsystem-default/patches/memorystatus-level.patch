+++ b/src/Libraries/libSystem/stub/sf_memorystatus.c	2026-11-14 01:31:11.285028623 -0800
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: MIT
+// memorystatus_get_level() for SiliconForest's libSystem (GitHub issue 53,
+// docs/roadmap/issues/SF-AA-activity-monitor.md): Apple's Activity Monitor reads the system's
+// memory-pressure level (the percentage of memory available, 0 to 100, kept by the kernel's
+// memorystatus) with it. The kernel has the system call (XNU's bsd/kern/syscalls.master, 453:
+// memorystatus_get_level(user_addr_t level)); libsystem_kernel here had no wrapper for it.
+#include <stdint.h>
+#include <unistd.h>
+int memorystatus_get_level(uint64_t level)
+{
+	return syscall(453, level);
+}
