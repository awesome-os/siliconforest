+/* The parsed collection capabilities of a successfully started event service
+ * authorize only matching real queue endpoints. No report is manufactured.
+ * Native SPI keyboard: keyboard only. PDSerialHID: keyboard + virtual mouse. */
+static void
+pdHIDPublishSupportedQueues(bool ready, OSArray *pairs)
+{
+    if (!ready || !pairs) return;
+    for (unsigned i = 0; i < pairs->getCount(); i++) {
+        OSDictionary *pair = OSDynamicCast(OSDictionary, pairs->getObject(i));
+        if (!pair) continue;
+        OSNumber *page = OSDynamicCast(OSNumber, pair->getObject(kIOHIDDeviceUsagePageKey));
+        OSNumber *usage = OSDynamicCast(OSNumber, pair->getObject(kIOHIDDeviceUsageKey));
+        if (!page || !usage || page->unsigned32BitValue() != kHIDPage_GenericDesktop) continue;
+        switch (usage->unsigned32BitValue()) {
+            case kHIDUsage_GD_Keyboard:
+            case kHIDUsage_GD_Keypad:
+                PDHIDPublishKeyboardDevice();
+                break;
+            case kHIDUsage_GD_Mouse:
+                PDHIDPublishMouseDevice();
+                break;
+            default:
+                break;
+        }
+    }
+}
