+    fn fd_closed(fd: i32) -> bool {
+        let rc = unsafe { libc::fcntl(fd, libc::F_GETFD) };
+        rc < 0 && io::Error::last_os_error().raw_os_error() == Some(libc::EBADF)
+    }
