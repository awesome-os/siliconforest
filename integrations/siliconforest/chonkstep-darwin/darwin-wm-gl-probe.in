#!/bin/sh
# Guest side of the compositor's first GPU step (SFAgx + SFDcp, sfagx=1 sfdcp=2): the compositor
# binary's own KMS backend, alone. `--gl-probe` loads the Mesa bundle with dlopen, makes a
# surfaceless GLES 3 context, sets the mode on the display node, creates three scanout buffers
# (GPU GEM object -> dma-buf -> EGLImage -> framebuffer object, and -> card node -> ADDFB2),
# checks one cleared frame by GL readback and through the CPU mapping, then clears to a slowly
# changing colour and page-flips for 5 s. Lines: WMGL (results), "chonkstep-gl: step:" (also
# written to /dev/console before each call).
# Three runs, one per way of taking flip-complete events: poll() on the card fd (what the
# compositor will use), the reference's blocking read(), and a reader thread. Later runs are
# skipped when the first fails.
# The new desktop binary is staged over the RAM root's own /usr/bin/chonkstep-darwin-desktop
# (tools/wm_gl_boot.sh), which replaces the old one and reclaims its space.
# (@SSID@/@PSK@ are unused; the placeholders exist because the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nWMGL1_BEGIN_%s\n' "$nonce"
ls -l /dev/dri 2>&1 | head -6
ls -l /usr/local/lib/mesa-asahi 2>&1 | head -8
first=
for wait in poll inline thread; do
    if [ -n "$first" ] && [ "$first" != 0 ]; then
        printf 'WMGL1_SKIPPED flip-wait=%s first run failed\n' "$wait"
        continue
    fi
    printf 'WMGL1_RUN flip-wait=%s start=%s\n' "$wait" "$(date +%s)"
    chonkstep-darwin-desktop --gl-probe --seconds 5 --flip-wait "$wait" 2>&1
    rc=$?
    [ -z "$first" ] && first=$rc
    printf 'WMGL1_RC=%s flip-wait=%s end=%s\n' "$rc" "$wait" "$(date +%s)"
done
printf 'WMGL1_END_%s\n' "$nonce"
