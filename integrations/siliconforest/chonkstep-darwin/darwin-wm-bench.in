#!/bin/sh
# Guest side of a compositor rendering benchmark: the damage-tracked renderer and the original
# full-frame renderer of the same chonkstep-darwin-desktop binary, each on the panel and
# off-screen (heap framebuffer, which separates compute from the cost of the mapping).
# Stage the binary to benchmark with PCIE_EXTRA_FILES=<binary>=/usr/bin/chonkstep-wm-bench.
# (@SSID@/@PSK@ are unused; the placeholders exist because the assembler fills templates.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
F="--font-regular /usr/share/darwin-desktop/DejaVuSans.ttf --font-bold /usr/share/darwin-desktop/DejaVuSans-Bold.ttf"
printf '\nDL39_WMBENCH_BEGIN_%s\n' "$nonce"
for mode in "damage" "legacy" "damage --offscreen" "legacy --offscreen"; do
    printf 'DL39_RUN %s start=%s\n' "$mode" "$(date +%s)"
    chonkstep-wm-bench --bench $F --quick --renderer $mode 2>&1
    printf 'DL39_RC=%s end=%s\n' "$?" "$(date +%s)"
done
printf 'DL39_WMBENCH_END_%s\n' "$nonce"
