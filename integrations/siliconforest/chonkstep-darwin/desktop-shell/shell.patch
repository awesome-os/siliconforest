+            ops.result = Err(libc::ECHILD);
+            app.service(now + Duration::from_secs(10), true, &mut audit, &mut ops);
+            assert!(matches!(app.completion(), Completion::Incomplete(_)));
+            assert_eq!(ops.signals.len(), 1);
+            assert!(!app.cleanup_complete());
+        }
+    }
+}
