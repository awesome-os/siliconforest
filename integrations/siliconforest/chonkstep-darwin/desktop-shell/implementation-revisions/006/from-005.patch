+}
+impl std::fmt::Display for CsStatus {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Unsupported => write!(f, "unsupported"),
+            Self::Flags(flags) => write!(f, "flags={flags:#010x}"),
+            Self::QueryFailed(errno) => write!(f, "query_failed errno={errno}"),
+        }
+    }
