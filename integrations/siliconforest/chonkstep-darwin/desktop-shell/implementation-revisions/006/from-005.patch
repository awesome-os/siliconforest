+            fn csops(pid: libc::pid_t, ops: u32, useraddr: *mut libc::c_void, usersize: libc::size_t) -> libc::c_int;
+        }
+        let mut flags: u32 = 0;
+        let returned = unsafe {
+            csops(pid, 0, (&mut flags as *mut u32).cast(), std::mem::size_of::<u32>())
+        };
+        if returned == 0 {
