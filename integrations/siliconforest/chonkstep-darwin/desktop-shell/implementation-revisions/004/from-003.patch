     #[test]
+    fn first_two_instances_have_distinct_visible_prefixes_and_exact_full_ids() {
+        let (_root, mut launcher, _manager) = fixture();
+        let session = "0123456789abcdef0123456789abcdef0123456789abcdef";
+        launcher.session = Instance::parse(session).unwrap();
+        let first = launcher.identity().unwrap();
+        let second = launcher.identity().unwrap();
+        assert_eq!(first.as_str(), format!("0001{}", &session[..44]));
+        assert_eq!(second.as_str(), format!("0002{}", &session[..44]));
+        assert_eq!(&first.as_str()[..12], "000101234567");
+        assert_eq!(&second.as_str()[..12], "000201234567");
+        assert_ne!(&first.as_str()[..12], &second.as_str()[..12]);
+        for id in [&first, &second] {
+            assert_eq!(id.as_str().len(), 48);
+            assert!(Instance::parse(id.as_str()).is_ok());
+            assert_eq!(&id.as_str()[4..], &session[..44]);
+        }
+        let a = launcher.prepare(first.clone(), Instant::now()).unwrap();
+        let b = launcher.prepare(second.clone(), Instant::now()).unwrap();
+        assert_eq!(a.args[3], first.as_str());
+        assert_eq!(b.args[3], second.as_str());
+        assert!(a.directory.path.ends_with(first.as_str()));
+        assert!(b.directory.path.ends_with(second.as_str()));
+        assert_ne!(a.directory.path, b.directory.path);
+        // Preparing distinct real private inputs does not create apps/READY.
+    }
