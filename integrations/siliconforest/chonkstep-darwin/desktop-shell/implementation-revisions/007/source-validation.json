 "new_test_coverage": [
  "line selection keeps the newest 8 matches, counts all matches, sanitizes to printable ASCII and truncates to 240 bytes",
  "kernel messages read once, only after a signal reap; not while running or after a normal exit; SIGKILL stays a failure",
  "record kept once per attempt; query_failed and read snapshot formats; largest journal lines fit the 1024-byte bound; host build Unsupported"
 ],
