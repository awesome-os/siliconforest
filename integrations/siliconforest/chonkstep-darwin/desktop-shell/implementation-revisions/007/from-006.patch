+    #[test]
+    fn kernel_messages_keep_the_newest_matching_lines_sanitized_and_bounded() {
+        let mut log = Vec::new();
+        log.extend_from_slice(b"unrelated boot line\n");
+        for i in 0..10 {
+            log.extend_from_slice(
+                format!("process chonk-terminal-d[{i}] caught allocating too many file descriptors. \tNum of fds allocated 9; \n")
+                    .as_bytes(),
+            );
+        }
+        log.extend_from_slice(b"process x[14] Unable to create task token ident object\x01\xff\n");
+        log.extend_from_slice(format!("send_resource_violation(ports, ...): error 0x10000003 {}\n", "z".repeat(400)).as_bytes());
+        let (matched, lines) = select_kernel_messages(&log);
+        assert_eq!(matched, 12);
+        assert_eq!(lines.len(), KERNEL_MESSAGE_LINE_LIMIT);
+        assert!(lines[0].starts_with("process chonk-terminal-d[4] caught"), "{lines:?}");
+        assert!(lines[0].contains("descriptors. ?Num"), "tab sanitized: {lines:?}");
+        assert!(lines[6].ends_with("ident object??"), "{lines:?}");
+        assert_eq!(lines[7].len(), KERNEL_MESSAGE_LINE_BYTES);
