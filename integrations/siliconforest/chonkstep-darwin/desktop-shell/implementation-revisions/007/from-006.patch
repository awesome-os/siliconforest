+/// Kernel message-buffer lines about per-process resource limits, read once
+/// after an owned child is reaped by a signal. Diagnostic only: it never
+/// changes the wait status, ownership or outcome.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum KernelMessages {
+    /// Non-Apple host build: no proc_kmsgbuf.
+    Unsupported,
+    /// proc_kmsgbuf returned no bytes; EPERM means this process is not root.
+    QueryFailed { euid: u32, errno: i32 },
+    /// `matched` counts every matching line; `lines` keeps the most recent
+    /// KERNEL_MESSAGE_LINE_LIMIT of them, sanitized and truncated.
+    Read { euid: u32, bytes: usize, matched: usize, lines: Vec<String> },
+}
+/// Substrings of the pinned XNU os_log lines on the resource-limit fatal-port
+/// path (osfmk/kern/task.c SENDING_NOTIFICATION__THIS_PROCESS_HAS_TOO_MANY_*).
+pub const KERNEL_MESSAGE_NEEDLES: [&str; 3] = [
+    "caught allocating too many",
+    "Unable to create task token ident object",
+    "send_resource_violation",
+];
+pub const KERNEL_MESSAGE_LINE_LIMIT: usize = 8;
+pub const KERNEL_MESSAGE_LINE_BYTES: usize = 240;
+/// log_dmesg copies the newest bytes when the buffer is smaller than the log.
+pub const KERNEL_MESSAGE_BUFFER_BYTES: usize = 256 * 1024;
+impl std::fmt::Display for KernelMessages {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Unsupported => write!(f, "unsupported"),
+            Self::QueryFailed { euid, errno } => write!(f, "query_failed euid={euid} errno={errno}"),
+            Self::Read { euid, bytes, matched, lines } => write!(
+                f,
+                "read euid={euid} bytes={bytes} matched={matched} kept={}",
+                lines.len()
+            ),
+        }
+    }
+}
+/// Keeps the most recent matching lines, each limited to printable ASCII
+/// (others become '?') and KERNEL_MESSAGE_LINE_BYTES bytes.
+pub fn select_kernel_messages(buffer: &[u8]) -> (usize, Vec<String>) {
+    let mut matched = 0;
+    let mut kept = std::collections::VecDeque::with_capacity(KERNEL_MESSAGE_LINE_LIMIT);
+    for raw in buffer.split(|&b| b == b'\n') {
+        if !KERNEL_MESSAGE_NEEDLES
+            .iter()
+            .any(|needle| raw.windows(needle.len()).any(|w| w == needle.as_bytes()))
+        {
+            continue;
+        }
+        matched += 1;
+        if kept.len() == KERNEL_MESSAGE_LINE_LIMIT {
+            kept.pop_front();
+        }
+        kept.push_back(
+            raw.iter()
+                .take(KERNEL_MESSAGE_LINE_BYTES)
+                .map(|&b| if (0x20..0x7f).contains(&b) { b as char } else { '?' })
+                .collect::<String>(),
+        );
+    }
+    (matched, kept.into())
+}
+/// Reads the kernel message buffer (root only in pinned XNU proc_kmsgbuf).
+pub fn query_kernel_messages() -> KernelMessages {
+    #[cfg(target_vendor = "apple")]
+    {
+        unsafe extern "C" {
+            fn proc_kmsgbuf(buffer: *mut libc::c_void, buffersize: u32) -> libc::c_int;
+        }
+        let euid = unsafe { libc::geteuid() };
+        let mut buffer = vec![0u8; KERNEL_MESSAGE_BUFFER_BYTES];
+        let returned = unsafe {
+            proc_kmsgbuf(buffer.as_mut_ptr().cast(), KERNEL_MESSAGE_BUFFER_BYTES as u32)
+        };
+        if returned <= 0 {
+            let errno = io::Error::last_os_error().raw_os_error().unwrap_or(libc::EIO);
+            return KernelMessages::QueryFailed { euid, errno };
+        }
+        let bytes = (returned as usize).min(KERNEL_MESSAGE_BUFFER_BYTES);
+        let (matched, lines) = select_kernel_messages(&buffer[..bytes]);
+        KernelMessages::Read { euid, bytes, matched, lines }
+    }
+    #[cfg(not(target_vendor = "apple"))]
+    {
+        KernelMessages::Unsupported
+    }
+}
