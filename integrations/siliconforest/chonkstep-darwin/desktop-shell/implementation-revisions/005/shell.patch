+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WaitState {
+    Running,
+    Reaped(i32),
+    Unknown(i32),
+}
+/// Kernel exit reason read from the owned zombie before it is reaped.
+/// Diagnostic only: it never changes the wait status, ownership or outcome.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ExitReason {
+    /// This host has no proc_pidinfo exit-reason query (non-Apple builds).
+    Unsupported,
+    /// The non-reaping exit check or the reason query failed with this errno.
+    /// ENOENT from the query means the kernel recorded no reason for an exit.
+    QueryFailed(i32),
+    /// PROC_PIDEXITREASONBASICINFO, used when the reason payload did not fit.
+    Basic { namespace: u32, code: u64, flags: u64, payload_bytes: u32 },
+    /// PROC_PIDEXITREASONINFO with the kernel's kcdata payload, at most
+    /// EXIT_REASON_PAYLOAD_LIMIT bytes, copied verbatim for host decoding.
+    Full { namespace: u32, code: u64, flags: u64, payload: Vec<u8> },
+}
+pub const EXIT_REASON_PAYLOAD_LIMIT: usize = 320;
+impl std::fmt::Display for ExitReason {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Unsupported => write!(f, "unsupported"),
+            Self::QueryFailed(errno) => write!(f, "query_failed errno={errno}"),
+            Self::Basic { namespace, code, flags, payload_bytes } => write!(
+                f,
+                "basic namespace={namespace} code={code:#x} flags={flags:#x} payload_bytes={payload_bytes}"
+            ),
+            Self::Full { namespace, code, flags, payload } => {
+                write!(
+                    f,
+                    "full namespace={namespace} code={code:#x} flags={flags:#x} payload_bytes={} payload_hex=",
+                    payload.len()
+                )?;
+                payload.iter().try_for_each(|b| write!(f, "{b:02x}"))
+            }
+        }
+    }
+}
+pub struct OwnedChild {
+    pid: NonZeroI32,
+    state: WaitState,
+    exit_reason: Option<ExitReason>,
+}
+impl OwnedChild {
+    fn new(pid: i32) -> Option<Self> {
+        (pid > 0).then(|| Self {
+            pid: NonZeroI32::new(pid).unwrap(),
+            state: WaitState::Running,
+            exit_reason: None,
+        })
+    }
+    pub fn pid(&self) -> i32 {
+        self.pid.get()
+    }
+    pub fn state(&self) -> WaitState {
+        self.state
+    }
+    pub fn exit_reason(&self) -> Option<&ExitReason> {
+        self.exit_reason.as_ref()
+    }
+    pub fn poll(&mut self) -> WaitState {
+        self.poll_using(&mut UnixWait)
+    }
+    fn poll_using(&mut self, ops: &mut impl WaitApi) -> WaitState {
+        if self.state == WaitState::Running {
+            // Read the reason while the child is still an unreaped zombie of
+            // this owner. The reap below stays the only ownership decision.
+            if self.exit_reason.is_none() {
+                self.exit_reason = ops.exit_reason(self.pid());
+            }
+            self.state = match ops.wait(self.pid()) {
+                Ok(Some(status)) => WaitState::Reaped(status),
+                Ok(None) | Err(libc::EINTR) => WaitState::Running,
+                Err(error) => WaitState::Unknown(error),
+            };
+        }
+        self.state
+    }
+    pub fn terminate(&mut self) -> io::Result<()> {
+        self.signal_using(&mut UnixWait, libc::SIGTERM)
+    }
+    pub fn kill(&mut self) -> io::Result<()> {
+        self.signal_using(&mut UnixWait, libc::SIGKILL)
+    }
+    fn signal_using(&mut self, ops: &mut impl WaitApi, signal: i32) -> io::Result<()> {
+        if self.state != WaitState::Running {
+            return Err(io::Error::other("child no longer exclusively wait-owned"));
+        }
+        ops.signal(self.pid(), signal)
+            .map_err(io::Error::from_raw_os_error)
+    }
+}
+trait WaitApi {
+    fn wait(&mut self, pid: i32) -> Result<Option<i32>, i32>;
+    fn signal(&mut self, pid: i32, signal: i32) -> Result<(), i32>;
+    /// Some(reason) only once the child has exited and is still unreaped.
+    fn exit_reason(&mut self, _pid: i32) -> Option<ExitReason> {
+        None
+    }
+}
+/// Non-reaping exit check: WEXITED|WNOHANG|WNOWAIT leaves the zombie waitable.
+/// si_pid is zeroed first because XNU leaves siginfo untouched when nothing
+/// has exited (kern_exit.c waitid WNOHANG path).
+fn exited_without_reaping(pid: i32) -> Result<bool, i32> {
+    let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+    let returned = unsafe {
+        libc::waitid(
+            libc::P_PID,
+            pid as libc::id_t,
+            &mut info,
+            libc::WEXITED | libc::WNOHANG | libc::WNOWAIT,
+        )
+    };
+    if returned != 0 {
+        return Err(io::Error::last_os_error()
+            .raw_os_error()
+            .unwrap_or(libc::EIO));
+    }
+    #[cfg(target_vendor = "apple")]
+    let reported = info.si_pid;
+    #[cfg(not(target_vendor = "apple"))]
+    let reported = unsafe { info.si_pid() };
+    Ok(reported == pid)
+}
+#[cfg(target_vendor = "apple")]
+fn query_exit_reason(pid: i32) -> ExitReason {
+    // Pinned XNU sys/proc_info_private.h flavors and packed layouts.
+    const PROC_PIDEXITREASONINFO: libc::c_int = 24;
+    const PROC_PIDEXITREASONBASICINFO: libc::c_int = 25;
+    #[repr(C, packed)]
+    #[derive(Default)]
+    struct Info {
+        namespace: u32,
+        code: u64,
+        flags: u64,
+        buf_size: u32,
+        kcd_buf: u64,
+    }
+    #[repr(C, packed)]
+    #[derive(Default)]
+    struct Basic {
+        namespace: u32,
+        code: u64,
+        flags: u64,
+        buf_size: u32,
+    }
+    const _: () = assert!(std::mem::size_of::<Info>() == 32 && std::mem::size_of::<Basic>() == 24);
+    let errno = || io::Error::last_os_error().raw_os_error().unwrap_or(libc::EIO);
+    let mut payload = [0u8; EXIT_REASON_PAYLOAD_LIMIT];
+    let mut info = Info {
+        buf_size: EXIT_REASON_PAYLOAD_LIMIT as u32,
+        kcd_buf: payload.as_mut_ptr() as u64,
+        ..Default::default()
+    };
+    let size = std::mem::size_of::<Info>() as libc::c_int;
+    let returned = unsafe {
+        libc::proc_pidinfo(pid, PROC_PIDEXITREASONINFO, 0, (&mut info as *mut Info).cast(), size)
+    };
+    if returned == size {
+        let used = (info.buf_size as usize).min(EXIT_REASON_PAYLOAD_LIMIT);
+        return ExitReason::Full {
+            namespace: info.namespace,
+            code: info.code,
+            flags: info.flags,
+            payload: payload[..used].to_vec(),
+        };
+    }
+    let first = errno();
+    if first != libc::ENOMEM {
+        return ExitReason::QueryFailed(first);
+    }
+    // The payload exceeded the bound; keep the namespace/code/flags facts.
+    let mut basic = Basic::default();
+    let size = std::mem::size_of::<Basic>() as libc::c_int;
+    let returned = unsafe {
+        libc::proc_pidinfo(pid, PROC_PIDEXITREASONBASICINFO, 0, (&mut basic as *mut Basic).cast(), size)
+    };
+    if returned == size {
+        ExitReason::Basic {
+            namespace: basic.namespace,
+            code: basic.code,
+            flags: basic.flags,
+            payload_bytes: basic.buf_size,
+        }
+    } else {
+        ExitReason::QueryFailed(errno())
+    }
+}
+struct UnixWait;
+impl WaitApi for UnixWait {
+    fn exit_reason(&mut self, pid: i32) -> Option<ExitReason> {
+        match exited_without_reaping(pid) {
+            Ok(false) | Err(libc::EINTR) => None,
+            // ECHILD or another error: the reap below reports ownership facts.
+            Err(errno) => Some(ExitReason::QueryFailed(errno)),
+            #[cfg(target_vendor = "apple")]
+            Ok(true) => Some(query_exit_reason(pid)),
+            #[cfg(not(target_vendor = "apple"))]
+            Ok(true) => Some(ExitReason::Unsupported),
+        }
+    }
+    fn wait(&mut self, pid: i32) -> Result<Option<i32>, i32> {
+        let mut status = 0;
+        // Only this positive, directly returned child PID is ever waited on.
+        let returned = unsafe { libc::waitpid(pid, &mut status, libc::WNOHANG) };
+        if returned == 0 {
+            return Ok(None);
+        }
+        if returned < 0 {
+            return Err(io::Error::last_os_error()
+                .raw_os_error()
+                .unwrap_or(libc::EIO));
+        }
+        if returned != pid || !(libc::WIFEXITED(status) || libc::WIFSIGNALED(status)) {
+            return Err(libc::EPROTO);
+        }
+        Ok(Some(status))
+    }
+    fn signal(&mut self, pid: i32, signal: i32) -> Result<(), i32> {
+        if unsafe { libc::kill(pid, signal) } == 0 {
+            Ok(())
+        } else {
+            Err(io::Error::last_os_error()
+                .raw_os_error()
+                .unwrap_or(libc::EIO))
+        }
+    }
+}
