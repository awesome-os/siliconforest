+pub struct DesktopSession {
+    pub shell: Shell<CpuBackend>,
+    pub applications: OwnedApplications,
+    pub closing: bool,
+    launcher: Option<TerminalLauncher>,
+    startup_requested: bool,
+}
+
+/// Pending wins: no owned application is abandoned while another is still
+/// moving through TERM/KILL/reap/CLEANUP. Incomplete is reported only after
+/// every application is terminal, and it is never turned into Complete.
+fn cleanup_state(
+    pending: bool,
+    incomplete: bool,
+    complete: bool,
+) -> crate::session_entry::CleanupState {
+    use crate::session_entry::CleanupState;
+    if pending {
+        CleanupState::Pending
+    } else if incomplete {
+        CleanupState::Incomplete
+    } else if complete {
+        CleanupState::Complete
+    } else {
+        CleanupState::Pending
+    }
+}
