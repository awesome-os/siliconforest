+    #[test]
+    fn four_hex_counter_accepts_last_value_then_refuses_without_wrap_or_side_effects() {
+        let (root, mut launcher, mut manager) = fixture();
+        launcher.next = MAX_INSTANCE_COUNTER - 1;
+        let last = launcher.identity().unwrap();
+        assert_eq!(last.as_str(), format!("ffff{}", "a".repeat(44)));
