+impl crate::server::Server {
+    /// One explicit packaged request, before normal dispatch. Zero is the
+    /// default; it does not synthesize HID/Wayland input or create a process.
+    pub fn queue_startup_terminals(&mut self, count: u8) -> Result<(), String> {
+        if count == 0 {
+            return Ok(());
+        }
+        if count > 2 {
+            return Err("startup terminal count must be1..2".into());
+        }
+        let desktop = self.desktop.as_mut().ok_or("desktop Shell is absent")?;
+        if desktop.startup_requested || desktop.closing {
+            return Err("startup already requested or session closing".into());
+        }
+        desktop.startup_requested = true;
+        for _ in 0..count {
+            let outcome = desktop.shell.run_explicit_startup_terminal(&mut self.wm)?;
+            desktop.outcome(outcome)?;
+        }
+        Ok(())
+    }
+    pub fn adopt_managed_applications(
+        &mut self,
+        launcher: TerminalLauncher,
+        applications: OwnedApplications,
+    ) -> Result<(), String> {
+        let desktop = self.desktop.as_mut().ok_or("desktop Shell is absent")?;
+        if desktop.launcher.is_some() || desktop.closing || !applications.audit.durable() {
+            return Err("managed application owners cannot be adopted".into());
+        }
+        desktop.applications = applications;
+        desktop.launcher = Some(launcher);
+        Ok(())
+    }
+    /// Error-path cleanup does not depend on rendering, input, or successful
+    /// Wayland dispatch. Call on the same loop that exclusively owns children.
+    pub fn begin_desktop_shutdown(&mut self) {
+        if let Some(desktop) = self.desktop.as_mut() {
+            desktop.closing = true;
+            desktop.applications.begin_shutdown();
+            // No Shell/WM operation here: its grab invariants may have caused
+            // the frame panic. Keep cleanup independent of that poisoned UI.
+        }
+    }
+    pub fn poll_desktop_shutdown(&mut self) -> crate::session_entry::CleanupState {
+        let Some(desktop) = self.desktop.as_mut() else {
+            return crate::session_entry::CleanupState::Incomplete;
+        };
+        desktop.applications.poll();
+        // One incomplete application must not end the wait for the others:
+        // every owned app keeps its TERM/KILL/reap/CLEANUP path until it is
+        // terminal, within the coordinator's bounded cleanup window.
+        cleanup_state(
+            desktop.applications.shutdown_pending(),
+            desktop.applications.shutdown_incomplete(),
+            desktop.applications.shutdown_complete(),
+        )
