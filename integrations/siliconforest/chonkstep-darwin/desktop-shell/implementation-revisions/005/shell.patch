+    }
+    #[test]
+    fn explicit_cli_only_and_finite_bounds() {
+        assert_eq!(Options::parse(&args()).unwrap().startup_terminals, 0);
+        for (word, count) in [("1", 1), ("2", 2)] {
+            let mut a = args();
+            a.extend(["--startup-terminals".into(), word.into()]);
+            assert_eq!(Options::parse(&a).unwrap().startup_terminals, count);
+        }
+        for word in ["0", "3", "01", "+1", "-1"] {
+            let mut a = args();
+            a.extend(["--startup-terminals".into(), word.into()]);
+            assert!(Options::parse(&a).is_err());
+        }
+        for index in [0, 1, 3, 5, 7, 9, 11, 13, 15, 16] {
+            let mut a = args();
+            a[index] = "bad".into();
+            assert!(Options::parse(&a).is_err());
+        }
+        for seconds in ["0", "10", "181", "+120", "0120"] {
+            let mut a = args();
+            a[10] = seconds.into();
+            assert!(Options::parse(&a).is_err());
+        }
+        for index in [2, 4, 8, 12, 14] {
+            let mut a = args();
+            a[index] = "relative".into();
+            assert!(Options::parse(&a).is_err());
+        }
+        let mut a = args();
+        a.push("extra".into());
+        assert!(Options::parse(&a).is_err());
+    }
+    #[test]
+    fn host_never_opens_native_devices() {
+        assert!(run(Options::parse(&args()).unwrap())
+            .unwrap_err()
+            .contains("unsupported on this build"));
+    }
+    #[test]
+    fn font_input_must_be_regular_bounded_and_not_a_link() {
+        let dir = tempfile::tempdir().unwrap();
+        let p = dir.path().join("font");
+        std::fs::write(&p, b"bad font bytes").unwrap();
+        let bytes = font_bytes(&p).unwrap();
+        assert!(wm_theme::FontState::from_packaged_fonts(bytes.clone(), bytes).is_err());
+        let link = dir.path().join("link");
+        std::os::unix::fs::symlink(&p, &link).unwrap();
+        assert!(font_bytes(&link).is_err());
+        assert!(regular_file(Path::new("/dev/null"), 1024, false).is_err());
+    }
+    #[test]
+    fn explicit_packaged_fonts_have_real_ascii_faces() {
+        // Explicit host font fixtures. Not copied into the product or claimed
+        // to be guest-packaged; root separately binds font licenses/bytes.
+        let regular = font_bytes(Path::new("/usr/share/fonts/TTF/DejaVuSans.ttf")).unwrap();
+        let bold = font_bytes(Path::new("/usr/share/fonts/TTF/DejaVuSans-Bold.ttf")).unwrap();
+        assert!(
+            wm_theme::FontState::from_packaged_fonts(regular.clone(), regular.clone()).is_err()
+        );
+        let fonts = wm_theme::FontState::from_packaged_fonts(regular, bold).unwrap();
+        assert_eq!(fonts.cache_statistics().available_faces, 2);
+    }
+    #[test]
+    fn existing_socket_or_lock_is_refused_without_probe_or_unlink() {
+        let dir = tempfile::tempdir().unwrap();
+        let p = dir.path().join("wayland");
+        require_fresh_socket(&p).unwrap();
+        let listener = std::os::unix::net::UnixListener::bind(&p).unwrap();
+        assert!(require_fresh_socket(&p).is_err());
+        assert!(p.exists());
+        drop(listener);
+        std::fs::remove_file(&p).unwrap();
+        std::fs::write(p.with_extension("lock"), b"existing").unwrap();
+        assert!(require_fresh_socket(&p).is_err());
+        assert_eq!(
+            std::fs::read(p.with_extension("lock")).unwrap(),
+            b"existing"
+        );
+    }
+}
