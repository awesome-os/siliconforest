+    use super::*;
+    struct Fake {
+        time: Duration,
+        frame_fail: bool,
+        frame_panic: bool,
+        stop: bool,
+        cleanup: CleanupState,
+        seal_fail: bool,
+        calls: Vec<&'static str>,
+    }
+    impl SessionIo for Fake {
+        fn elapsed(&self) -> Duration {
+            self.time
+        }
+        fn frame(&mut self) -> Result<FrameState, String> {
+            self.calls.push("frame");
+            assert!(!self.frame_panic, "injected UI invariant failure");
+            if self.frame_fail {
+                Err("injected display/present/input failure".into())
+            } else {
+                Ok(FrameState::Stop)
+            }
+        }
+        fn stop_requested(&self) -> bool {
+            self.stop
+        }
+        fn begin_shutdown(&mut self) {
+            self.calls.push("begin")
+        }
+        fn cleanup(&mut self) -> CleanupState {
+            self.calls.push("cleanup");
+            self.cleanup
+        }
+        fn pause(&mut self) {
+            self.time += Duration::from_secs(1)
+        }
+        fn seal(&mut self, _: &Outcome) -> Result<(), String> {
+            self.calls.push("seal");
+            if self.seal_fail {
+                Err("injected record failure".into())
+            } else {
+                Ok(())
+            }
+        }
+    }
+    fn fake() -> Fake {
+        Fake {
+            time: Duration::ZERO,
+            frame_fail: false,
+            frame_panic: false,
+            stop: false,
+            cleanup: CleanupState::Complete,
+            seal_fail: false,
+            calls: vec![],
+        }
+    }
+    #[test]
+    fn every_result_exit_drives_cleanup_then_seals() {
+        for why in 0..4 {
+            let mut io = fake();
+            match why {
+                0 => {}
+                1 => io.frame_fail = true,
+                2 => io.stop = true,
+                _ => io.time = Duration::from_secs(120),
+            }
+            let result = drive(&mut io, Duration::from_secs(120));
+            let start = io.calls.iter().position(|s| *s == "begin").unwrap();
+            assert_eq!(&io.calls[start..], ["begin", "cleanup", "seal"]);
+            assert_eq!(result.frame_error.is_some(), why == 1);
+            assert_eq!(result.deadline_reached, why == 3);
+        }
+    }
+    #[test]
+    fn hung_or_unowned_child_never_becomes_complete() {
+        for state in [CleanupState::Pending, CleanupState::Incomplete] {
+            let mut io = fake();
+            io.cleanup = state;
+            let result = drive(&mut io, Duration::from_secs(120));
+            assert_eq!(result.cleanup, CleanupState::Incomplete);
+            assert!(!result.successful());
+            assert!(io.time <= Duration::from_secs(10));
+            assert_eq!(io.calls.iter().filter(|s| **s == "begin").count(), 1);
+            assert_eq!(io.calls.last(), Some(&"seal"));
+            assert_eq!(io.calls.iter().filter(|s| **s == "frame").count(), 1);
+        }
+    }
+    #[test]
+    fn sealing_error_stays_failure_after_real_cleanup() {
+        let mut io = fake();
+        io.seal_fail = true;
+        let result = drive(&mut io, Duration::from_secs(120));
+        assert_eq!(result.cleanup, CleanupState::Complete);
+        assert!(!result.successful());
+    }
+    #[test]
+    fn ui_panic_keeps_owner_and_drives_cleanup_without_resuming_ui() {
+        let mut io = fake();
+        io.frame_panic = true;
+        let result = drive(&mut io, Duration::from_secs(120));
+        assert_eq!(io.calls, ["frame", "begin", "cleanup", "seal"]);
+        assert_eq!(result.cleanup, CleanupState::Complete);
+        assert!(result.frame_error.as_ref().unwrap().contains("panicked"));
+        assert!(!result.successful());
+    }
+}
