+            assert_eq!(action.sa_sigaction, handler);
+            assert_eq!(action.sa_flags, 0);
+            for signal in [
+                libc::SIGPIPE,
+                libc::SIGCHLD,
+                libc::SIGINT,
+                libc::SIGTERM,
+                libc::SIGHUP,
