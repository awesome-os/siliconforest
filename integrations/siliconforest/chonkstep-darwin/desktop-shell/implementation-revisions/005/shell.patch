+//! Process-global signal policy for the single native entry. No app is spawned
+//! here. Other code must not concurrently replace these dispositions. The
+//! entry guard excludes only another invocation of our own managed session.
+use std::{
+    panic::{catch_unwind, AssertUnwindSafe},
+    sync::atomic::{AtomicBool, Ordering},
+};
+
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+static POISONED: AtomicBool = AtomicBool::new(false);
+
+trait SignalOps {
+    type Saved;
+    fn replace(&mut self, signal: i32, handler: libc::sighandler_t) -> Result<Self::Saved, i32>;
+    fn restore(&mut self, signal: i32, saved: &Self::Saved) -> Result<(), i32>;
+}
+struct UnixSignals;
+fn new_action(signal: i32, handler: libc::sighandler_t) -> Result<libc::sigaction, i32> {
+    let mut action: libc::sigaction = unsafe { std::mem::zeroed() };
+    action.sa_sigaction = handler;
+    action.sa_flags = 0;
+    if matches!(signal, libc::SIGINT | libc::SIGTERM | libc::SIGHUP) {
+        // Preserve the ordinary restart behavior of the previous signal()
+        // stop handlers; SIGCHLD's autoreap flags remain explicitly clear.
+        action.sa_flags = libc::SA_RESTART;
+    }
+    if unsafe { libc::sigemptyset(&mut action.sa_mask) } != 0 {
+        return Err(std::io::Error::last_os_error()
+            .raw_os_error()
+            .unwrap_or(libc::EIO));
+    }
+    Ok(action)
+}
+impl SignalOps for UnixSignals {
+    type Saved = libc::sigaction;
+    fn replace(&mut self, signal: i32, handler: libc::sighandler_t) -> Result<Self::Saved, i32> {
+        // Use sigaction rather than signal: in particular SIGCHLD must clear
+        // an inherited SA_NOCLDWAIT as well as SIG_IGN. Save the entire old
+        // action, including flags and handler mask, for exact restoration.
+        let action = new_action(signal, handler)?;
+        let mut old: libc::sigaction = unsafe { std::mem::zeroed() };
+        if unsafe { libc::sigaction(signal, &action, &mut old) } != 0 {
+            return Err(std::io::Error::last_os_error()
+                .raw_os_error()
+                .unwrap_or(libc::EIO));
+        }
+        Ok(old)
+    }
+    fn restore(&mut self, signal: i32, old: &Self::Saved) -> Result<(), i32> {
+        if unsafe { libc::sigaction(signal, old, std::ptr::null_mut()) } != 0 {
+            return Err(std::io::Error::last_os_error()
+                .raw_os_error()
+                .unwrap_or(libc::EIO));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+struct Failure {
+    setup: Option<(i32, i32)>,
+    restore: Vec<(i32, i32)>,
+    body: Option<String>,
+    panicked: bool,
+}
+impl Failure {
+    fn message(&self) -> String {
+        format!(
+            "managed signal scope failed: setup={:?} restore={:?} body={:?} body_panicked={}",
+            self.setup, self.restore, self.body, self.panicked
+        )
+    }
+}
+fn restore_all<O: SignalOps>(ops: &mut O, saved: &mut Vec<(i32, O::Saved)>) -> Vec<(i32, i32)> {
+    let mut errors = vec![];
+    while let Some((signal, action)) = saved.pop() {
+        // Every saved action gets one restoration attempt, even after a prior
+        // failure. No blind retry or successful-restoration claim on error.
+        if let Err(error) = ops.restore(signal, &action) {
+            errors.push((signal, error));
+        }
+    }
+    errors
+}
+fn checked_scope<T, O: SignalOps>(
+    ops: &mut O,
+    stop: libc::sighandler_t,
+    body: impl FnOnce() -> Result<T, String>,
+) -> Result<T, Failure> {
+    let mut saved = Vec::with_capacity(5);
+    for (signal, handler) in [
+        (libc::SIGPIPE, libc::SIG_IGN),
+        (libc::SIGCHLD, libc::SIG_DFL),
+        (libc::SIGINT, stop),
+        (libc::SIGTERM, stop),
+        (libc::SIGHUP, stop),
+    ] {
+        match ops.replace(signal, handler) {
+            Ok(action) => saved.push((signal, action)),
+            Err(error) => {
+                return Err(Failure {
+                    setup: Some((signal, error)),
+                    restore: restore_all(ops, &mut saved),
+                    body: None,
+                    panicked: false,
+                })
+            }
+        }
+    }
+    // This outer boundary only restores dispositions after an unwind. The
+    // inner frame coordinator owns app cleanup; an unwind outside it is a
+    // failed/incomplete session, never an invented app/PTY cleanup result.
+    let result = catch_unwind(AssertUnwindSafe(body));
+    let restore = restore_all(ops, &mut saved);
+    match result {
+        Ok(Ok(value)) if restore.is_empty() => Ok(value),
+        result => Err(Failure {
+            setup: None,
+            restore,
+            body: match &result {
+                Ok(Err(error)) => Some(error.clone()),
+                _ => None,
+            },
+            panicked: result.is_err(),
+        }),
+    }
+}
+
+struct EntryClaim<'a> {
+    active: &'a AtomicBool,
+}
+impl<'a> EntryClaim<'a> {
+    fn new(active: &'a AtomicBool, poisoned: &AtomicBool) -> Result<Self, String> {
+        if active
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return Err("another managed entry owns process signal dispositions".into());
+        }
+        let claim = Self { active };
+        if poisoned.load(Ordering::Acquire) {
+            return Err(
+                "previous signal restoration failed; process cannot start another session".into(),
+            );
+        }
+        Ok(claim)
+    }
+}
+impl Drop for EntryClaim<'_> {
+    fn drop(&mut self) {
+        self.active.store(false, Ordering::Release);
+    }
+}
+
+pub(crate) fn with_process_signals<T>(
+    stop_flag: &AtomicBool,
+    stop: libc::sighandler_t,
+    body: impl FnOnce() -> Result<T, String>,
+) -> Result<T, String> {
+    let _claim = EntryClaim::new(&ACTIVE, &POISONED)?;
+    stop_flag.store(false, Ordering::Relaxed);
+    checked_scope(&mut UnixSignals, stop, body).map_err(|failure| {
+        if !failure.restore.is_empty() {
+            POISONED.store(true, Ordering::Release);
+        }
+        failure.message()
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{cell::Cell, collections::BTreeMap};
+    #[test]
+    fn real_action_builder_clears_autoreap_and_handler_mask_without_global_changes() {
