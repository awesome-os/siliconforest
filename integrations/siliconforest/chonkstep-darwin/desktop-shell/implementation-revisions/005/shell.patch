+//! Finite frontend lifecycle. Production I/O implements the same coordinator
+//! exercised by host fault tests; a frame error cannot bypass owned cleanup.
+use std::{
+    panic::{catch_unwind, AssertUnwindSafe},
+    time::Duration,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CleanupState {
+    Pending,
+    Complete,
+    Incomplete,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FrameState {
+    Continue,
+    Stop,
+}
+pub trait SessionIo {
+    fn elapsed(&self) -> Duration;
+    fn frame(&mut self) -> Result<FrameState, String>;
+    fn stop_requested(&self) -> bool;
+    fn begin_shutdown(&mut self);
+    fn cleanup(&mut self) -> CleanupState;
+    fn pause(&mut self);
+    fn seal(&mut self, outcome: &Outcome) -> Result<(), String>;
+}
+#[derive(Debug)]
+pub struct Outcome {
+    pub frame_error: Option<String>,
+    pub cleanup: CleanupState,
+    pub seal_error: Option<String>,
+    pub deadline_reached: bool,
+}
+impl Outcome {
+    pub fn successful(&self) -> bool {
+        self.frame_error.is_none()
+            && self.cleanup == CleanupState::Complete
+            && self.seal_error.is_none()
+    }
+}
+pub fn drive(io: &mut impl SessionIo, lifetime: Duration) -> Outcome {
+    let mut result = Outcome {
+        frame_error: None,
+        cleanup: CleanupState::Pending,
+        seal_error: None,
+        deadline_reached: false,
+    };
+    loop {
+        if io.stop_requested() {
+            break;
+        }
+        if io.elapsed() >= lifetime {
+            result.deadline_reached = true;
+            break;
+        }
+        // I/O and child owners remain outside the unwind closure. A poisoned
+        // UI is never resumed; shutdown is restricted to owned status/PIDs.
+        match catch_unwind(AssertUnwindSafe(|| io.frame())) {
+            Ok(Ok(FrameState::Continue)) => io.pause(),
+            Ok(Ok(FrameState::Stop)) => break,
+            Ok(Err(error)) => {
+                result.frame_error = Some(error);
+                break;
+            }
+            Err(_) => {
+                result.frame_error = Some("UI frame panicked; UI will not be resumed".into());
+                break;
+            }
+        }
+    }
+    // Every ordinary Result/error/signal/deadline reaches this one path. A
+    // process abort/OOM cannot be made safe by a destructor and is not claimed.
+    io.begin_shutdown();
+    let stop_at = io.elapsed().saturating_add(Duration::from_secs(10));
+    loop {
+        result.cleanup = io.cleanup();
+        if result.cleanup != CleanupState::Pending {
+            break;
+        }
+        if io.elapsed() >= stop_at {
+            result.cleanup = CleanupState::Incomplete;
+            break;
+        }
+        io.pause();
+    }
+    if let Err(error) = io.seal(&result) {
+        result.seal_error = Some(error);
+    }
+    result
+}
