+//! Separate finite native Shell entry. Host tests never open PDGOP/HID.
+use crate::{
+    applications::{Instance, OwnedApplications},
+    hid::NativeHid,
+    presenter::Pdgop,
+    server::Server,
+    session_entry::{self, CleanupState, FrameState, Outcome, SessionIo},
+    terminal_launch::{PrivateDirectory, TerminalLauncher},
+};
+use smithay::reexports::wayland_server::{Display, ListeningSocket};
+use std::{
+    fs::{File, OpenOptions},
+    io::{Read, Write},
+    os::unix::fs::OpenOptionsExt,
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicBool, Ordering},
+    time::{Duration, Instant},
+};
+static STOP: AtomicBool = AtomicBool::new(false);
+extern "C" fn stop(_: libc::c_int) {
+    STOP.store(true, Ordering::Relaxed);
+}
+pub const USAGE: &str = "chonkstep-darwin-desktop --run --socket ABS --records ABS --session HEX48 --terminal ABS --seconds 11..180 --font-regular ABS --font-bold ABS --input pdhid [--startup-terminals 1..2]";
+pub struct Options {
+    socket: PathBuf,
+    records: PathBuf,
+    session: Instance,
+    terminal: PathBuf,
+    seconds: u64,
+    regular: PathBuf,
+    bold: PathBuf,
+    startup_terminals: u8,
+}
+impl Options {
+    pub fn parse(args: &[String]) -> Result<Self, String> {
+        let names = [
+            "--socket",
+            "--records",
+            "--session",
+            "--terminal",
+            "--seconds",
+            "--font-regular",
+            "--font-bold",
+            "--input",
+        ];
+        if !matches!(args.len(), 17 | 19)
+            || args[0] != "--run"
+            || names.iter().enumerate().any(|(i, n)| args[1 + i * 2] != *n)
+            || args[16] != "pdhid"
+        {
+            return Err(USAGE.into());
+        }
+        let startup_terminals = if args.len() == 19 {
+            if args[17] != "--startup-terminals" {
+                return Err(USAGE.into());
+            }
+            match args[18].as_str() {
+                "1" => 1,
+                "2" => 2,
+                _ => return Err(USAGE.into()),
+            }
+        } else {
+            0
+        };
+        let seconds: u64 = args[10].parse().map_err(|_| USAGE)?;
+        if !(11..=180).contains(&seconds) || seconds.to_string() != args[10] {
+            return Err(USAGE.into());
+        }
+        let path = |s: &str| -> Result<PathBuf, String> {
+            let p = PathBuf::from(s);
+            if !p.is_absolute()
+                || s.len() > 900
+                || s.as_bytes().contains(&0)
+                || p.components().any(|c| {
+                    matches!(
+                        c,
+                        std::path::Component::ParentDir | std::path::Component::CurDir
+                    )
+                })
+            {
+                return Err("invalid absolute bounded path".into());
+            }
+            Ok(p)
+        };
+        let socket = path(&args[2])?;
+        if socket.as_os_str().as_encoded_bytes().len() > 100 {
+            return Err("Wayland socket pathname too long".into());
+        }
+        Ok(Self {
+            socket,
+            records: path(&args[4])?,
+            session: Instance::parse(&args[6]).map_err(str::to_owned)?,
+            terminal: path(&args[8])?,
+            seconds,
+            regular: path(&args[12])?,
+            bold: path(&args[14])?,
+            startup_terminals,
+        })
+    }
+}
+fn regular_file(path: &Path, max: u64, executable: bool) -> Result<File, String> {
+    use std::os::unix::fs::MetadataExt;
+    let f = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK)
+        .open(path)
+        .map_err(|e| e.to_string())?;
+    let m = f.metadata().map_err(|e| e.to_string())?;
+    if !m.is_file() || m.len() == 0 || m.len() > max || (executable && m.mode() & 0o111 == 0) {
+        return Err("packaged file type/size/mode refused".into());
+    }
+    Ok(f)
+}
+fn font_bytes(path: &Path) -> Result<Vec<u8>, String> {
+    let f = regular_file(path, 8 * 1024 * 1024, false)?;
+    let mut bytes = vec![];
+    f.take(8 * 1024 * 1024 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|e| e.to_string())?;
+    if bytes.len() > 8 * 1024 * 1024 {
+        return Err("font changed past input bound".into());
+    }
+    Ok(bytes)
+}
+fn require_fresh_socket(path: &Path) -> Result<(), String> {
+    // No stale/live inference from connect errno. A future session receives a
+    // private unused name; an existing socket OR lock pathname is a refusal.
+    for path in [path.to_owned(), path.with_extension("lock")] {
+        match std::fs::symlink_metadata(path) {
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+            _ => return Err("Wayland socket/lock path is not fresh".into()),
+        }
+    }
+    Ok(())
+}
+struct NativeIo<'a> {
+    display: &'a mut Display<Server>,
+    server: &'a mut Server,
+    listener: &'a ListeningSocket,
+    input: &'a mut NativeHid,
+    presenter: &'a mut Pdgop,
+    result: &'a mut File,
+    started: Instant,
+    shutdown: bool,
+}
+impl SessionIo for NativeIo<'_> {
+    fn elapsed(&self) -> Duration {
+        self.started.elapsed()
+    }
+    fn stop_requested(&self) -> bool {
+        STOP.load(Ordering::Relaxed)
+    }
+    fn frame(&mut self) -> Result<FrameState, String> {
+        // Admission work per frame is finite so incoming clients cannot keep
+        // the loop from observing its wall-time/signal boundary forever.
+        for _ in 0..4 {
+            let Some(stream) = self.listener.accept().map_err(|e| e.to_string())? else {
+                break;
+            };
+            Server::add_client(self.display, stream).map_err(|e| e.to_string())?;
+        }
+        self.display
+            .dispatch_clients(self.server)
+            .map_err(|e| e.to_string())?;
+        let ms = self.elapsed().as_millis() as u32;
+        for event in self.input.drain()? {
+            self.server.deliver_hid(event, ms)?;
+        }
+        self.server.repaint(self.presenter, ms)?;
+        self.display.flush_clients().map_err(|e| e.to_string())?;
+        Ok(if self.server.desktop_closing() {
+            FrameState::Stop
+        } else {
+            FrameState::Continue
+        })
+    }
+    fn begin_shutdown(&mut self) {
+        if !self.shutdown {
+            self.shutdown = true;
+            self.server.begin_desktop_shutdown();
+        }
+    }
+    fn cleanup(&mut self) -> CleanupState {
+        // No UI/Wayland dispatch, input, or framebuffer access after entering
+        // cleanup, including after an assertion panic. App TERM is serviced
+        // through its private status socket and the single owned waitpid path;
+        // no possibly poisoned Shell/WM invariant can bypass that ownership.
+        self.server.poll_desktop_shutdown()
+    }
+    fn pause(&mut self) {
+        std::thread::sleep(Duration::from_millis(8));
+    }
+    fn seal(&mut self, outcome: &Outcome) -> Result<(), String> {
+        writeln!(self.result,"CHONKDESKTOP/1 elapsed_ms={} cleanup={:?} deadline={} frame_error={:?} manager_failed={}",
+            self.elapsed().as_millis(),outcome.cleanup,outcome.deadline_reached,outcome.frame_error,self.server.desktop_failed()).map_err(|e|e.to_string())?;
+        self.server
+            .desktop_snapshot(self.result)
+            .map_err(|e| e.to_string())?;
+        self.result.sync_all().map_err(|e| e.to_string())?;
+        if self.server.desktop_failed() {
+            return Err("managed application/cleanup failure retained in private records".into());
+        }
+        Ok(())
+    }
+}
+
+/// Root must bind exact package bytes and all pending independent/runtime gates
+/// before executing this entry. Compilation alone is never that admission.
+pub fn run(options: Options) -> Result<(), String> {
+    if !cfg!(panic = "unwind") {
+        return Err("native managed desktop requires panic=unwind".into());
+    }
+    if !cfg!(all(
+        target_os = "macos",
+        target_arch = "aarch64",
+        feature = "native-managed-spawn"
+    )) {
+        return Err("native desktop entry is unsupported on this build".into());
+    }
+    let records = PrivateDirectory::open(&options.records).map_err(|e| e.to_string())?;
+    let mut result = records
+        .file("session-result.txt")
+        .map_err(|e| e.to_string())?;
+    let _socket_directory =
+        PrivateDirectory::open(options.socket.parent().ok_or("socket parent missing")?)
+            .map_err(|e| e.to_string())?;
+    let _executable = regular_file(&options.terminal, 64 * 1024 * 1024, true)?;
+    require_fresh_socket(&options.socket)?;
+    let fonts = wm_theme::FontState::from_packaged_fonts(
+        font_bytes(&options.regular)?,
+        font_bytes(&options.bold)?,
+    )?;
+    let mut manager = OwnedApplications::default();
+    let launcher = TerminalLauncher::new(
+        &options.terminal,
+        &options.socket,
+        &options.records,
+        options.session,
+        Duration::from_secs(options.seconds),
+        &mut manager,
+    )
+    .map_err(|e| e.to_string())?;
+    // All path/font/private-log input refusals above precede HID/PDGOP open.
+    let listener = ListeningSocket::bind_absolute(options.socket).map_err(|e| e.to_string())?;
+    let mut display = Display::<Server>::new().map_err(|e| e.to_string())?;
+    STOP.store(false, Ordering::Relaxed);
+    unsafe {
+        for signal in [libc::SIGINT, libc::SIGTERM, libc::SIGHUP] {
+            if libc::signal(signal, stop as *const () as libc::sighandler_t) == libc::SIG_ERR {
+                return Err(std::io::Error::last_os_error().to_string());
+            }
+        }
+    }
+    let mut input = NativeHid::open()?;
+    let mut presenter = Pdgop::open()?;
+    let mut server = Server::new_with_fonts(&display.handle(), presenter.size(), fonts.clone())?;
+    server.enable_pdhid_seat_caps(&display.handle(), input.seat_caps())?;
+    server.enable_desktop_shell(fonts)?;
+    server.adopt_managed_applications(launcher, manager)?;
+    server.queue_startup_terminals(options.startup_terminals)?;
+    writeln!(result,"CHONKDESKTOP/1 initialized=1 input=both shell=shared native_runtime_qualification=not_inferred").map_err(|e|e.to_string())?;
+    result.sync_all().map_err(|e| e.to_string())?;
+    // No fallible early returns after this point until the coordinator has
+    // attempted/sealed cleanup. Prior startup errors cannot have spawned apps.
+    let outcome = {
+        let mut io = NativeIo {
+            display: &mut display,
+            server: &mut server,
+            listener: &listener,
+            input: &mut input,
+            presenter: &mut presenter,
+            result: &mut result,
+            started: Instant::now(),
+            shutdown: false,
+        };
+        session_entry::drive(&mut io, Duration::from_secs(options.seconds))
+    };
+    drop(listener);
+    drop(display);
+    drop(server);
+    drop(input);
+    #[cfg(all(target_os = "macos", target_arch = "aarch64"))]
+    drop(presenter);
+    if !outcome.successful() {
+        return Err(format!("finite desktop failure: {outcome:?}"));
+    }
+    Ok(())
+}
