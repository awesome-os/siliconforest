+    // SAFETY: socket returned a fresh, checked, nonnegative descriptor.
+    let fd = unsafe { OwnedFd::from_raw_fd(raw) };
+    #[cfg(target_os = "macos")]
+    let fd = configure_owned(fd)?;
+    Ok(fd)
+}
