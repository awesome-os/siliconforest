+//! Host policy/ownership tests. These do not execute the Darwin ABI on Linux.
+use super::*;
+use std::os::unix::net::UnixStream;
+
+fn pair() -> (OwnedFd, UnixStream) {
+    let (a, b) = UnixStream::pair().unwrap();
+    (a.into(), b)
