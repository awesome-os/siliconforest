+        time: Duration,
+        frame_fail: bool,
+        frame_panic: bool,
+        stop: bool,
+        cleanup: CleanupState,
+        seal_fail: bool,
+        calls: Vec<&'static str>,
+    }
+    impl SessionIo for Fake {
+        fn elapsed(&self) -> Duration {
+            self.time
+        }
