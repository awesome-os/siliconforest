+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{cell::Cell, collections::BTreeMap};
+    #[test]
+    fn real_action_builder_clears_autoreap_and_handler_mask_without_global_changes() {
+        for handler in [libc::SIG_DFL, libc::SIG_IGN] {
+            let action = new_action(libc::SIGCHLD, handler).unwrap();
+            assert_eq!(action.sa_sigaction, handler);
+            assert_eq!(action.sa_flags, 0);
+            for signal in [
+                libc::SIGPIPE,
+                libc::SIGCHLD,
+                libc::SIGINT,
+                libc::SIGTERM,
+                libc::SIGHUP,
+                libc::SIGUSR1,
+            ] {
+                assert_eq!(unsafe { libc::sigismember(&action.sa_mask, signal) }, 0);
+            }
+        }
+        for signal in [libc::SIGINT, libc::SIGTERM, libc::SIGHUP] {
+            let action = new_action(signal, 42).unwrap();
+            assert_eq!(action.sa_flags, libc::SA_RESTART);
+        }
+    }
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    struct Action {
+        handler: usize,
+        flags: i32,
+        mask: u64,
+    }
+    struct Fake {
+        actions: BTreeMap<i32, Action>,
+        original: BTreeMap<i32, Action>,
+        calls: Vec<(bool, i32, usize)>,
+        fail_setup: Option<usize>,
+        fail_restore: Option<i32>,
+        setup_calls: usize,
+    }
+    impl Fake {
+        fn new() -> Self {
+            let actions = [
+                libc::SIGPIPE,
+                libc::SIGCHLD,
+                libc::SIGINT,
+                libc::SIGTERM,
+                libc::SIGHUP,
+            ]
+            .into_iter()
+            .map(|s| {
+                (
+                    s,
+                    Action {
+                        handler: libc::SIG_IGN,
+                        flags: 0x1234,
+                        mask: s as u64,
+                    },
+                )
+            })
+            .collect::<BTreeMap<_, _>>();
+            Self {
+                original: actions.clone(),
+                actions,
+                calls: vec![],
+                fail_setup: None,
+                fail_restore: None,
+                setup_calls: 0,
+            }
+        }
+    }
+    impl SignalOps for Fake {
+        type Saved = Action;
+        fn replace(&mut self, signal: i32, handler: usize) -> Result<Action, i32> {
+            let index = self.setup_calls;
+            self.setup_calls += 1;
+            self.calls.push((true, signal, handler));
+            if self.fail_setup == Some(index) {
+                return Err(libc::EINVAL);
+            }
+            Ok(self
+                .actions
+                .insert(
+                    signal,
+                    Action {
+                        handler,
+                        flags: 0,
+                        mask: 0,
+                    },
+                )
+                .unwrap())
+        }
+        fn restore(&mut self, signal: i32, saved: &Action) -> Result<(), i32> {
+            self.calls.push((false, signal, saved.handler));
+            if self.fail_restore == Some(signal) {
+                return Err(libc::EIO);
+            }
+            self.actions.insert(signal, saved.clone());
+            Ok(())
+        }
+    }
+    #[test]
+    fn policy_precedes_body_and_restores_full_actions_in_reverse_order() {
+        let mut ops = Fake::new();
+        assert_eq!(checked_scope(&mut ops, 42, || Ok(7)).unwrap(), 7);
+        assert_eq!(ops.actions, ops.original);
+        assert_eq!(
+            &ops.calls[..5],
+            &[
+                (true, libc::SIGPIPE, libc::SIG_IGN),
+                (true, libc::SIGCHLD, libc::SIG_DFL),
+                (true, libc::SIGINT, 42),
+                (true, libc::SIGTERM, 42),
+                (true, libc::SIGHUP, 42)
+            ]
+        );
+        let restored: Vec<_> = ops.calls[5..].iter().map(|v| v.1).collect();
+        assert_eq!(
+            restored,
+            [
+                libc::SIGHUP,
+                libc::SIGTERM,
+                libc::SIGINT,
+                libc::SIGCHLD,
+                libc::SIGPIPE
+            ]
+        );
+    }
+    #[test]
+    fn every_setup_failure_rolls_back_and_never_enters_device_or_spawn_body() {
+        for failed in 0..5 {
+            let mut ops = Fake::new();
+            ops.fail_setup = Some(failed);
+            let called = Cell::new(false);
+            let error = checked_scope(&mut ops, 42, || {
+                called.set(true);
+                Ok(())
+            })
+            .unwrap_err();
+            assert!(!called.get());
+            assert!(error.setup.is_some());
+            assert!(error.restore.is_empty());
+            assert_eq!(ops.actions, ops.original);
+            assert_eq!(ops.calls.iter().filter(|c| !c.0).count(), failed);
+        }
+    }
+    #[test]
+    fn body_error_and_panic_restore_without_claiming_owned_process_cleanup() {
+        let mut ops = Fake::new();
+        let error = checked_scope::<(), _>(&mut ops, 42, || Err("actual session failed".into()))
+            .unwrap_err();
+        assert_eq!(error.body.as_deref(), Some("actual session failed"));
+        assert!(!error.panicked);
+        assert_eq!(ops.actions, ops.original);
+        let error =
+            checked_scope::<(), _>(&mut ops, 42, || panic!("outside frame cleanup")).unwrap_err();
+        assert!(error.panicked);
+        assert_eq!(ops.actions, ops.original);
+        assert!(!error.message().contains("cleanup=Complete"));
+    }
+    #[test]
+    fn every_restore_failure_disqualifies_success_and_does_not_skip_other_restores() {
+        for signal in [
+            libc::SIGPIPE,
+            libc::SIGCHLD,
+            libc::SIGINT,
+            libc::SIGTERM,
+            libc::SIGHUP,
+        ] {
+            let mut ops = Fake::new();
+            ops.fail_restore = Some(signal);
+            let error = checked_scope(&mut ops, 42, || Ok(())).unwrap_err();
+            assert_eq!(error.restore, [(signal, libc::EIO)]);
+            assert_eq!(ops.calls.iter().filter(|c| !c.0).count(), 5);
+        }
+        let mut ops = Fake::new();
+        ops.fail_setup = Some(2);
+        ops.fail_restore = Some(libc::SIGPIPE);
+        let error = checked_scope(&mut ops, 42, || Ok(())).unwrap_err();
+        assert!(error.setup.is_some());
+        assert_eq!(error.restore, [(libc::SIGPIPE, libc::EIO)]);
+    }
+    #[test]
+    fn shared_process_entry_is_exclusive_and_restore_failure_is_sticky() {
+        // Local atomics only: tests never change the harness's global signals.
+        let active = AtomicBool::new(false);
+        let poisoned = AtomicBool::new(false);
+        let first = EntryClaim::new(&active, &poisoned).unwrap();
+        assert!(EntryClaim::new(&active, &poisoned).is_err());
+        drop(first);
+        let next = EntryClaim::new(&active, &poisoned).unwrap();
+        poisoned.store(true, Ordering::Release);
+        drop(next);
+        assert!(EntryClaim::new(&active, &poisoned).is_err());
+        assert!(!active.load(Ordering::Acquire));
+    }
+}
