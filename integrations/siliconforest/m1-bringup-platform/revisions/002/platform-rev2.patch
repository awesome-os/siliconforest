diff --git a/src/Kernel/Extensions/PDArmPlatformExpert/PDAppleBootCPUPMGR.cpp b/src/Kernel/Extensions/PDArmPlatformExpert/PDAppleBootCPUPMGR.cpp
new file mode 100644
index 0000000..96021df
--- /dev/null
+++ b/src/Kernel/Extensions/PDArmPlatformExpert/PDAppleBootCPUPMGR.cpp
@@ -0,0 +1,130 @@
+#include "PDAppleBootCPUPMGR.h"
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPMGR.h>
+#include <arm/cpu_topology.h>
+
+/*
+ * Power manager for Apple SoCs running xnu's AppleARMSMP, where Apple's
+ * ApplePMGR is not available. It manages the boot processor only and touches
+ * no PMGR registers:
+ *
+ * - Idle: the platform offers no idle states. xnu's cpu_idle() executes the
+ *   WFI itself; each callback here disables xnu's idle timer (timeout 0).
+ * - Secondary cores and cluster power are not implemented. Every such request
+ *   panics with its reason instead of returning as if it had worked. Boot with
+ *   a topology holding only the boot CPU (cpus=1, or a tree that lists only
+ *   it) so that xnu never makes one.
+ */
+class PDAppleBootCPUPMGR : public IOPMGR
+{
+	OSDeclareDefaultStructors(PDAppleBootCPUPMGR);
+
+public:
+	void enableCPUCore(unsigned int cpu_id, uint64_t entry_pa) APPLE_KEXT_OVERRIDE;
+	void enableCPUCore(unsigned int cpu_id) APPLE_KEXT_OVERRIDE;
+	void disableCPUCore(unsigned int cpu_id) APPLE_KEXT_OVERRIDE;
+	void enableCPUCluster(unsigned int cluster_id) APPLE_KEXT_OVERRIDE;
+	void disableCPUCluster(unsigned int cluster_id) APPLE_KEXT_OVERRIDE;
+	void initCPUIdle(ml_processor_info_t *info) APPLE_KEXT_OVERRIDE;
+	void enterCPUIdle(UInt64 *newIdleTimeoutTicks) APPLE_KEXT_OVERRIDE;
+	void exitCPUIdle(UInt64 *newIdleTimeoutTicks) APPLE_KEXT_OVERRIDE;
+	void updateCPUIdle(UInt64 *newIdleTimeoutTicks) APPLE_KEXT_OVERRIDE;
+};
+
+#define super IOPMGR
+OSDefineMetaClassAndStructors(PDAppleBootCPUPMGR, IOPMGR);
+
+void
+PDAppleBootCPUPMGR::enableCPUCore(unsigned int cpu_id, uint64_t entry_pa)
+{
+	panic("PDAppleBootCPUPMGR: start of cpu %u requested (entry 0x%llx); "
+	    "secondary CPU bring-up is not implemented, boot with cpus=1",
+	    cpu_id, (unsigned long long)entry_pa);
+}
+
+void
+PDAppleBootCPUPMGR::enableCPUCore(unsigned int cpu_id)
+{
+	panic("PDAppleBootCPUPMGR: start of cpu %u requested; "
+	    "secondary CPU bring-up is not implemented, boot with cpus=1", cpu_id);
+}
+
+void
+PDAppleBootCPUPMGR::disableCPUCore(unsigned int cpu_id)
+{
+	panic("PDAppleBootCPUPMGR: power-down of cpu %u requested; not implemented", cpu_id);
+}
+
+void
+PDAppleBootCPUPMGR::enableCPUCluster(unsigned int cluster_id)
+{
+	panic("PDAppleBootCPUPMGR: power-up of cluster %u requested; not implemented", cluster_id);
+}
+
+void
+PDAppleBootCPUPMGR::disableCPUCluster(unsigned int cluster_id)
+{
+	panic("PDAppleBootCPUPMGR: power-down of cluster %u requested; not implemented", cluster_id);
+}
+
+void
+PDAppleBootCPUPMGR::initCPUIdle(ml_processor_info_t *info)
+{
+	/* No nap, no power gating and no platform idle tickle. */
+	info->supports_nap = FALSE;
+	info->idle_tickle = NULL;
+	info->idle_timer_refcon = NULL;
+	info->powergate_stub_addr = 0;
+	info->powergate_stub_length = 0;
+	info->powergate_latency = 0;
+}
+
+void
+PDAppleBootCPUPMGR::enterCPUIdle(UInt64 *newIdleTimeoutTicks)
+{
+	if (newIdleTimeoutTicks != NULL) {
+		*newIdleTimeoutTicks = 0;
+	}
+}
+
+void
+PDAppleBootCPUPMGR::exitCPUIdle(UInt64 *newIdleTimeoutTicks)
+{
+	if (newIdleTimeoutTicks != NULL) {
+		*newIdleTimeoutTicks = 0;
+	}
+}
+
+void
+PDAppleBootCPUPMGR::updateCPUIdle(UInt64 *newIdleTimeoutTicks)
+{
+	if (newIdleTimeoutTicks != NULL) {
+		*newIdleTimeoutTicks = 0;
+	}
+}
+
+bool
+PDAppleBootCPUPMGR_publish(IOService *provider)
+{
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	PDAppleBootCPUPMGR *pmgr = new PDAppleBootCPUPMGR;
+	bool ok;
+
+	if (pmgr == NULL) {
+		return false;
+	}
+	ok = pmgr->init() && pmgr->attach(provider);
+	if (ok && !pmgr->start(provider)) {
+		pmgr->detach(provider);
+		ok = false;
+	}
+	if (ok) {
+		if (topo != NULL && topo->num_cpus > 1) {
+			IOLog("PDAppleBootCPUPMGR: topology has %u processors; starting any "
+			    "but the boot CPU will panic (boot with cpus=1)\n", topo->num_cpus);
+		}
+		pmgr->registerService();
+	}
+	pmgr->release();
+	return ok;
+}
