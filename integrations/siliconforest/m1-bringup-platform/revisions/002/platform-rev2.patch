+/*
+ * xnu's Apple SoC board configurations build with USE_APPLEARMSMP. Then xnu's
+ * own cpu_boot_thread (iokit/Kernel/arm/AppleARMSMP.cpp) registers every
+ * processor with ml_processor_register() and starts it through an IOPMGR.
+ * A PDArmCPU would register the processors a second time, and it needs a GIC
+ * that Apple SoCs do not have. So leave the processors to xnu, after checking
+ * that this kernel really owns them: its PassthruInterruptController, created
+ * once this platform expert has matched, is the platform interrupt controller.
+ * Without it, stop: there is no other processor driver for this hardware.
+ */
+#define PD_APPLE_SMP_WAIT_NS	(30ULL * 1000ULL * 1000ULL * 1000ULL)
+
+bool
+PDAppleARMPlatformExpert::startProcessors(void)
+{
+	OSDictionary *matching;
+	IOService *passthru;
+
+	matching = propertyMatching(gPlatformInterruptControllerName, kOSBooleanTrue,
+	    serviceMatching("PassthruInterruptController"));
+	if (matching == NULL) {
+		return false;
+	}
+	passthru = waitForMatchingService(matching, PD_APPLE_SMP_WAIT_NS);
+	matching->release();
+	if (passthru == NULL) {
+		IOLog("PDAppleARMPlatformExpert: no AppleARMSMP interrupt controller; "
+		    "this kernel does not register Apple processors itself\n");
+		return false;
+	}
+	passthru->release();
+
+	if (!PDAppleBootCPUPMGR_publish(this)) {
+		IOLog("PDAppleARMPlatformExpert: could not publish the boot-CPU power manager\n");
+		return false;
+	}
+	IOLog("PDAppleARMPlatformExpert: processors are registered by xnu (AppleARMSMP)\n");
+	return true;
+}
