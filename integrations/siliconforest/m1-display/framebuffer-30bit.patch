diff --git a/src/Kernel/Extensions/IOGOPFramebuffer/IOGOPFramebuffer.cpp b/src/Kernel/Extensions/IOGOPFramebuffer/IOGOPFramebuffer.cpp
index 859278c..bbcc4bf 100644
--- a/src/Kernel/Extensions/IOGOPFramebuffer/IOGOPFramebuffer.cpp
+++ b/src/Kernel/Extensions/IOGOPFramebuffer/IOGOPFramebuffer.cpp
@@ -560,6 +560,10 @@ IOGOPFramebuffer::getPixelFormats()
         case 32:
             ret = IO32BitDirectPixels;
             break;
+        case 30:
+            // Apple firmware boot framebuffer: 10-bit RGB in a 32-bit word
+            ret = kIO30BitDirectPixels;
+            break;
     }
 
     return (ret);
@@ -686,6 +690,19 @@ IOGOPFramebuffer::getPixelInformation(IODisplayModeID      displayMode,
             info->componentCount        = 3;
             info->bitsPerComponent      = 8;
             break;
+        case 30:
+            // Apple firmware boot framebuffer (boot-args depth 30): one
+            // native little-endian 32-bit word per pixel, R[29:20] G[19:10]
+            // B[9:0], bits 31:30 unused. 30-bit colour, 32-bit storage.
+            strlcpy(info->pixelFormat, kIO30BitDirectPixels, sizeof(info->pixelFormat));
+            info->pixelType     = kIORGBDirectPixels;
+            info->componentMasks[0] = 0x3ff00000;
+            info->componentMasks[1] = 0x000ffc00;
+            info->componentMasks[2] = 0x000003ff;
+            info->bitsPerPixel  = 32;
+            info->componentCount        = 3;
+            info->bitsPerComponent      = 10;
+            break;
     }
 
     return (kIOReturnSuccess);
