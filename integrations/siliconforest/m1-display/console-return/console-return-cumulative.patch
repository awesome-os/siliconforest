+
+/*
+ * closeWork calls this virtual method with both the system and framebuffer
+ * gates held. The parent drains server cleanup and clears fServerConnect last;
+ * a replacement server cannot open between that cleanup and this request.
+ * IOGOP has no PM power-state table: state zero is not a scanout-off operation.
+ */
+void
+IOGOPFramebuffer::close(void)
+{
+    const bool hadServer = (fServerConnect != NULL);
+    super::close();
+
+    IOService *provider = getProvider();
+    if (provider == NULL || OSDynamicCast(IOPlatformDevice, provider) == NULL ||
+        !gop_apple_soc_firmware_fb(provider))
+        return;
+
+    enum {
+        NoServer = 1, OwnerRemains = 2, Unavailable = 4, ManagedPower = 8,
+        NoConsole = 16, DifferentFramebuffer = 32, NotText = 64, OptedOut = 128
+    };
+    unsigned int blocked = 0;
+    if (!hadServer)
+        blocked |= NoServer;
+    if (fServerConnect != NULL || fSharedConnect != NULL || captured)
+        blocked |= OwnerRemains;
+    if (isInactive() || provider->isInactive() || dead || suspended)
+        blocked |= Unavailable;
+    if (getPowerState() != 0)
+        blocked |= ManagedPower;
+
+    IOPlatformExpert *platform = getPlatform();
+    PE_Video console;
+    bzero(&console, sizeof(console));
+    if (platform == NULL || platform->getConsoleInfo(&console) != kIOReturnSuccess) {
+        blocked |= NoConsole;
+    } else {
+        /* Keep the retained firmware mapping; never commandeer a new console. */
+        if (fbBase == NULL || width == 0 || height == 0 || pitch == 0 ||
+            (console.v_baseAddr & ~3UL) != (uintptr_t)fbBase ||
+            console.v_width != width || console.v_height != height ||
+            console.v_rowBytes != pitch ||
+            (console.v_depth != 30 && console.v_depth != 32))
+            blocked |= DifferentFramebuffer;
+        if (console.v_display != 2)
+            blocked |= NotText;
+    }
+
+    uint32_t textBoot = 1, mirror = 0, gopConsole = 0;
+    PE_parse_boot_argn("pdtextboot", &textBoot, sizeof(textBoot));
+    PE_parse_boot_argn("serial_video_mirror", &mirror, sizeof(mirror));
+    PE_parse_boot_argn("gopconsole", &gopConsole, sizeof(gopConsole));
+    if (textBoot == 0 || (mirror == 0 && gopConsole == 0))
+        blocked |= OptedOut;
+
+    if (blocked != 0) {
+        IOLog("IOGOP: console-return skip=0x%02x\n", blocked);
+        return;
+    }
+    /* Explicit ownership return uses kernel003's existing route restoration.
+     * Do not force mode, paint directly, or claim that a panel was observed. */
+    IOReturn result = platform->setConsoleInfo(NULL, kPEAcquireScreen);
+    IOLog("IOGOP: console-return acquire-request result=0x%08x\n",
+          (unsigned int)result);
 }
 
