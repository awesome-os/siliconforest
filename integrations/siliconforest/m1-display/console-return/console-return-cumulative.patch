+/*
+ * True for the firmware boot framebuffer on an Apple SoC: published as a
+ * platform nub (not a PCI BAR) under a device tree whose root is "AppleARM".
+ * That buffer is DRAM (inside /chosen dram-base/dram-size, outside XNU-managed
+ * memory) which the display controller scans out without snooping CPU caches.
+ * XNU's boot console already maps it VM_WIMG_WCOMB (Normal non-cacheable).
+ * IOKit's default mode and kIOMapInhibitCache both give VM_WIMG_IO instead,
+ * which pmap turns into Device-GRE for DRAM, and Device memory faults on the
+ * unaligned stores and DC ZVA that memcpy/memset/pixman routinely emit.
+ */
+static bool
+gop_apple_soc_firmware_fb(IOService *provider)
+{
+    IORegistryEntry *root;
+    OSData *compat;
+    bool apple = false;
+
+    if (OSDynamicCast(IOPCIDevice, provider) != NULL)
+        return false;
+    root = IORegistryEntry::fromPath("/", gIODTPlane);
+    if (root == NULL)
+        return false;
+    compat = OSDynamicCast(OSData, root->getProperty("compatible"));
+    if (compat != NULL) {
+        const char *s = (const char *)compat->getBytesNoCopy();
+        unsigned int len = compat->getLength();
+        for (unsigned int o = 0; s != NULL && o < len; o += (unsigned int)strnlen(s + o, len - o) + 1) {
+            if (strncmp(s + o, "AppleARM", len - o) == 0) {
+                apple = true;
+                break;
+            }
+        }
+    }
+    root->release();
+    return apple;
+}
