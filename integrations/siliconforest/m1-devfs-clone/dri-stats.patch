+/* Snapshot owned clone state only; no timer, worker, device query or ioctl. */
+static int
+dri_sysctl_clone_slots(struct sysctl_oid *, void *, int, struct sysctl_req *req)
+{
+    char text[256];
+    unsigned used, scan = 0, peak;
+    unsigned long long allocations, frees, failures;
+    if (!sLock) return ENXIO;
+    lck_mtx_lock(sLock);
+    used = sCloneUsed; peak = sClonePeak;
+    allocations = sCloneAllocations; frees = sCloneFrees; failures = sCloneFailures;
+    for (unsigned slot = 1; slot < SF_DRI_SLOTS; slot++) scan += sSlotUsed[slot];
+    lck_mtx_unlock(sLock);
+    snprintf(text, sizeof(text),
+        "used=%u scan=%u capacity=%u allocations=%llu frees=%llu failures=%llu peak=%u",
+        used, scan, SF_DRI_SLOTS - 1, allocations, frees, failures, peak);
+    return SYSCTL_OUT(req, text, strlen(text) + 1);
+}
+
 SYSCTL_DECL(_kern);
 SYSCTL_NODE(_kern, OID_AUTO, sf_dri, CTLFLAG_RD | CTLFLAG_LOCKED, 0, "drm devices");
 SYSCTL_INT(_kern_sf_dri, OID_AUTO, major, CTLFLAG_RD | CTLFLAG_LOCKED, &sMajor, 0, "dri character major");
 SYSCTL_PROC(_kern_sf_dri, OID_AUTO, devices, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
     0, 0, dri_sysctl_devices, "A", "drm minors and their pci devices");
 
+SYSCTL_PROC(_kern_sf_dri, OID_AUTO, clone_slots, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, dri_sysctl_clone_slots, "A", "owned DRM clone reservations");
+
