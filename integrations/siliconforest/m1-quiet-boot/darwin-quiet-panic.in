#!/bin/sh
# Guest side of the quiet-boot panic check: a deliberate kernel panic (DEVELOPMENT/DEBUG
# kernels: debug.panic_test=4 panics from the sysctl handler), to see the whole panic report
# on the serial console while the panel shows the boot picture and all CPUs are up.
# The capture then runs out its time; without the sysctl the boot ends at once.
PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH
printf '\nQBPANIC_BEGIN ncpu=%s bootargs=%s\n' "$(sysctl -n hw.ncpu)" "$(sysctl -n kern.bootargs)"
sysctl debug.panic_test=4
printf 'QBPANIC_RETURNED rc=%s\n' "$?"
printf '\nPD_BENCH_DONE\n'
