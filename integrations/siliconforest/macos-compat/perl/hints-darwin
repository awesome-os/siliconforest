# cnf/hints/darwin for perl-cross: arm64 Darwin (SiliconForest), see ../build-perl.nix.
#
# Type sizes and byte order: perl-cross reads them from ELF objects (readelf, objdump) and
# cannot from Mach-O. These are the LP64 Darwin arm64 values; ./sizes.c asserts each with the
# cross compiler before configure runs.
charsize=1
shortsize=2
intsize=4
longsize=8
longlongsize=8
doublesize=8
longdblsize=8
ptrsize=8
sizesize=8
fpossize=8
lseeksize=8
uidsize=4
gidsize=4
timesize=8
byteorder=12345678

# What Perl's own hints/darwin.sh sets for a current Darwin: shared libraries are dylibs,
# extensions are bundles whose undefined symbols resolve in the program that loads them.
# (so, cccdlflags, ccdlflags and lddlflags are set by perl-cross before it reads hints: they
# are given on configure's command line in ../build-perl.nix)
dlext=bundle
usedl=define
dlsrc=dl_dlopen.xs
libperl=libperl.dylib
useshrplib=true
usenm=false
usemymalloc=n
d_procselfexe=undef
libc=/usr/lib/libSystem.dylib

# struct stat's st_ino is a 64-bit unsigned ino_t
st_ino_sign=1
st_ino_size=8

# clocks and sleeping: perl-cross takes these from its hints (cnf/hints/linux does the same);
# libSystem has nanosleep, clock_gettime, clock_getres and clock, and no clock_nanosleep
d_voidsig=define
d_nanosleep=define
d_clock_gettime=define
d_clock_getres=define
d_clock_nanosleep=undef
d_clock=define
