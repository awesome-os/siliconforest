+# Linux's GEM shmem helper (drm_gem_shmem_helper.c, ported onto sf_drm_shmem.c) is GPL-2.0,
+# unlike everything else in the core list, so it is left out unless a kext asks for it and
+# is GPL-2.0 compatible as a whole (the Asahi GPU kext; its Rust wrapper needs the helper)
+option(SF_DRM_GEM_SHMEM "Build the GPL-2.0 GEM shmem helper into the DRM core" OFF)
+if(SF_DRM_GEM_SHMEM)
+    list(APPEND SF_DRM_CORE_SOURCES drm_gem_shmem_helper.c)
+endif()
