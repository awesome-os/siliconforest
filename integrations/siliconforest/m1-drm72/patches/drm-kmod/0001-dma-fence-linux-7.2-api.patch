+ * fence without release/wait callbacks is signaled and reports a fixed name
+ * from then on; this implementation never detaches the ops (6.14-level code in
+ * this tree dereferences fence->ops of signaled fences), but reports the same
+ * fixed names so that 7.2 callers see the 7.2 strings.
+ */
+const char __rcu *
+dma_fence_driver_name(struct dma_fence *fence)
+{
+	const struct dma_fence_ops *ops;
+
+	ops = rcu_dereference(fence->ops);
+	if (!dma_fence_test_signaled_flag(fence) && ops != NULL)
+		return ((const char __rcu *)ops->get_driver_name(fence));
+	return ((const char __rcu *)"detached-driver");
