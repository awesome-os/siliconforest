+/// Which device node a record came from.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Queue { Keyboard, Mouse }
+impl Queue {
+    pub fn name(self) -> &'static str { match self { Queue::Keyboard => "keyboard", Queue::Mouse => "mouse" } }
+    pub fn path(self) -> &'static str { match self { Queue::Keyboard => "/dev/usb_hid_kbd", Queue::Mouse => "/dev/usb_hid_mouse" } }
+    pub fn record_len(self) -> usize { match self { Queue::Keyboard => 8, Queue::Mouse => 12 } }
+}
+
+/// Something wrong with what the input queues gave. None of these ends the desktop: the
+/// record is dropped, the state is put right (held keys released after a gap) or the device
+/// node is opened again, and the first of each kind is said once in the log (`WMHID`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Fault {
+    /// The sequence numbers skipped `lost` records: the kernel's ring (64 records, the oldest
+    /// overwritten when it is full) filled before the reader took them, or another process
+    /// read them. Held keys are released; the pointer's buttons come back with its next
+    /// record, which carries them all.
+    Gap { queue: Queue, lost: u32 },
+    Malformed { queue: Queue },
+    Unsupported { usage: u8 },
+    Short { queue: Queue, len: usize },
+    Read { queue: Queue, error: String },
+    /// A read returned no bytes at all: the device went away.
+    Closed { queue: Queue },
+}
+impl Fault {
+    fn kind(&self) -> usize {
+        match self { Fault::Gap { .. } => 0, Fault::Malformed { .. } => 1, Fault::Unsupported { .. } => 2, Fault::Short { .. } => 3, Fault::Read { .. } => 4, Fault::Closed { .. } => 5 }
+    }
+    pub fn describe(&self) -> String {
+        match self {
+            Fault::Gap { queue, lost } => format!("{} queue: {lost} records lost (the kernel's 64-record ring was full before they were read, or another reader took them); held keys released, input goes on", queue.name()),
+            Fault::Malformed { queue } => format!("{} queue: a malformed record dropped", queue.name()),
+            Fault::Unsupported { usage } => format!("keyboard usage {usage:#04x} has no key code here; dropped"),
+            Fault::Short { queue, len } => format!("{} queue: a short record ({len} of {} bytes) dropped", queue.name(), queue.record_len()),
+            Fault::Read { queue, error } => format!("{} queue: read failed: {error}", queue.name()),
+            Fault::Closed { queue } => format!("{} queue: the device gave no bytes (gone)", queue.name()),
+        }
+    }
+}
