+/// One device node: read, and when it keeps failing, closed and opened again with back-off
+/// (50 ms doubling to 5 s). Closing the keyboard node gives the console its keys for as long
+/// as it stays closed (the kernel's grab follows the open file).
+struct Endpoint {
+    queue: Queue,
+    source: Option<Box<dyn RecordSource>>,
+    opener: Option<Opener>,
+    errors_in_row: u32,
+    backoff: std::time::Duration,
+    retry_at: Option<std::time::Instant>,
+    down_since: Option<std::time::Instant>,
+}
+impl Endpoint {
+    fn new(queue: Queue, source: Box<dyn RecordSource>, opener: Option<Opener>) -> Self {
+        Self { queue, source: Some(source), opener, errors_in_row: 0, backoff: BACKOFF_FIRST, retry_at: None, down_since: None }
+    }
+    fn fail(&mut self, now: std::time::Instant) {
+        self.source = None;
+        self.errors_in_row = 0;
+        self.down_since.get_or_insert(now);
+        self.retry_at = Some(now + self.backoff);
+        eprintln!("WMHID {} queue closed after failures; reopening in {} ms (input from it is lost meanwhile; the desktop goes on)", self.queue.name(), self.backoff.as_millis());
+    }
+    /// Reopen when due. True when the endpoint was (re)opened just now.
+    fn revive(&mut self, now: std::time::Instant, health: &mut HidHealth) -> bool {
+        if self.source.is_some() || self.retry_at.is_some_and(|at| now < at) {
+            return false;
+        }
+        let Some(opener) = self.opener.as_mut() else {
+            self.retry_at = Some(now + BACKOFF_MAX);
+            return false;
+        };
+        match opener() {
+            Ok(source) => {
+                self.source = Some(source);
+                health.reopens += 1;
+                eprintln!("WMHID {} queue reopened after {} ms", self.queue.name(), self.down_since.take().map_or(0, |t| now.duration_since(t).as_millis()));
+                self.backoff = BACKOFF_FIRST;
+                self.retry_at = None;
+                true
+            }
+            Err(error) => {
+                health.open_failures += 1;
+                if health.open_failures == 1 || self.backoff < BACKOFF_MAX {
+                    eprintln!("WMHID {} queue: reopen failed: {error}; next try in {} ms", self.queue.name(), (self.backoff * 2).min(BACKOFF_MAX).as_millis());
+                }
+                self.backoff = (self.backoff * 2).min(BACKOFF_MAX);
+                self.retry_at = Some(now + self.backoff);
+                false
+            }
+        }
