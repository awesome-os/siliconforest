diff -ruN '--exclude=.git' '--exclude=target' desk3-src/crates/wm-darwin/src/input_latency.rs desk4-next-002/source/crates/wm-darwin/src/input_latency.rs
--- desk3-src/crates/wm-darwin/src/input_latency.rs	1969-12-31 16:00:00.000000000 -0800
+++ desk4-next-002/source/crates/wm-darwin/src/input_latency.rs	2026-11-14 18:32:28.815857838 -0800
@@ -0,0 +1,122 @@
+//! How long a pointer motion takes to reach the screen: from the moment the event was read
+//! from the device node (or injected, for tests) to the page flip of the first frame that
+//! draws the cursor there. The panel's own scan-out after the flip is not included.
+use std::time::{Duration, Instant};
+
+const BUCKETS: usize = 1001; // whole milliseconds, the last one is "1000 ms or more"
+
+pub(crate) struct MotionLatency {
+    /// The oldest motion not drawn yet.
+    pending: Option<Instant>,
+    /// The oldest motion in the frame on its way to the screen.
+    in_flight: Option<Instant>,
+    window: Vec<u32>,
+    histogram: Vec<u32>,
+    samples: u64,
+    max_us: u32,
+    logged_at: Instant,
+}
+impl Default for MotionLatency {
+    fn default() -> Self {
+        Self { pending: None, in_flight: None, window: Vec::new(), histogram: vec![0; BUCKETS], samples: 0, max_us: 0, logged_at: Instant::now() }
+    }
+}
+fn percentile(sorted: &[u32], p: f64) -> f64 {
+    if sorted.is_empty() {
+        return 0.0;
+    }
+    let index = ((sorted.len() - 1) as f64 * p).round() as usize;
+    f64::from(sorted[index]) / 1000.0
+}
+impl MotionLatency {
+    pub fn motion(&mut self, at: Instant) {
+        self.pending = Some(self.pending.map_or(at, |p| p.min(at)));
+    }
+    /// A frame was rendered; `in_flight`: it reaches the screen with a later flip.
+    pub fn rendered(&mut self, in_flight: bool) {
+        let Some(t) = self.pending.take() else { return };
+        if in_flight {
+            self.in_flight = Some(self.in_flight.map_or(t, |p| p.min(t)));
+        } else {
+            self.sample(t.elapsed());
+        }
+    }
+    pub fn presented(&mut self) {
+        if let Some(t) = self.in_flight.take() {
+            self.sample(t.elapsed());
+        }
+    }
+    fn sample(&mut self, d: Duration) {
+        let us = d.as_micros().min(u128::from(u32::MAX)) as u32;
+        if self.window.len() < 100_000 {
+            self.window.push(us);
+        }
+        self.histogram[((us / 1000) as usize).min(BUCKETS - 1)] += 1;
+        self.samples += 1;
+        self.max_us = self.max_us.max(us);
+    }
+    fn line(sorted: &[u32], what: &str) -> String {
+        format!(
+            "WMLATENCY pointer motion->flip {what} n={} p50_ms={:.1} p90_ms={:.1} p99_ms={:.1} max_ms={:.1} (read from the queue or injected -> page flip showing the cursor; scan-out not included)",
+            sorted.len(), percentile(sorted, 0.5), percentile(sorted, 0.9), percentile(sorted, 0.99), sorted.last().map_or(0.0, |v| f64::from(*v) / 1000.0)
+        )
+    }
+    /// A line every 10 s while the pointer moves.
+    pub fn maybe_log(&mut self) {
+        if self.window.is_empty() || self.logged_at.elapsed() < Duration::from_secs(10) {
+            return;
+        }
+        let mut sorted = std::mem::take(&mut self.window);
+        sorted.sort_unstable();
+        eprintln!("{} window_s={:.1}", Self::line(&sorted, "last"), self.logged_at.elapsed().as_secs_f64());
+        self.logged_at = Instant::now();
+    }
+    /// The whole run (whole milliseconds).
+    pub fn final_line(&self) -> Option<String> {
+        if self.samples == 0 {
+            return None;
+        }
+        let at = |p: f64| {
+            let target = ((self.samples as f64) * p).ceil().max(1.0) as u64;
+            let mut seen = 0u64;
+            for (ms, count) in self.histogram.iter().enumerate() {
+                seen += u64::from(*count);
+                if seen >= target {
+                    return ms;
+                }
+            }
+            BUCKETS - 1
+        };
+        Some(format!(
+            "WMLATENCY pointer motion->flip total n={} p50_ms<={} p90_ms<={} p99_ms<={} max_ms={:.1}",
+            self.samples, at(0.5) + 1, at(0.9) + 1, at(0.99) + 1, f64::from(self.max_us) / 1000.0
+        ))
+    }
+    #[cfg(test)]
+    pub fn samples(&self) -> u64 {
+        self.samples
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn a_motion_counts_from_its_read_to_the_flip_that_shows_it() {
+        let mut l = MotionLatency::default();
+        let read = Instant::now();
+        l.motion(read);
+        l.motion(read + Duration::from_millis(1));
+        std::thread::sleep(Duration::from_millis(5));
+        l.rendered(true);
+        assert_eq!(l.samples(), 0, "nothing on the screen before the flip");
+        std::thread::sleep(Duration::from_millis(5));
+        l.presented();
+        assert_eq!(l.samples(), 1, "two motions in one frame are one sample, from the older");
+        assert!(l.max_us >= 10_000);
+        l.presented();
+        l.rendered(false);
+        assert_eq!(l.samples(), 1, "no motion, no sample");
+        assert!(l.final_line().unwrap().contains("n=1"));
+    }
+}
