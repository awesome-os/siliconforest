+    struct RingReader(std::sync::Arc<std::sync::Mutex<Ring>>);
+    impl RecordSource for RingReader {
+        fn read_record_bytes(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            match self.0.lock().unwrap().records.pop_front() {
