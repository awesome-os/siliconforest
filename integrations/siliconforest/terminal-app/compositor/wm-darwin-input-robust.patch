+    /// sequence releases the keys held (their releases may be among the lost records; a key
+    /// still held comes back down with its next record, Wayland clients repeat from their own
+    /// timers so a lost release would repeat forever); malformed records and keys without a
+    /// key code are dropped. Each such thing is put in `faults`.
+    pub fn keyboard_into(&mut self,bytes:&[u8],out:&mut Vec<Event>,faults:&mut Vec<Fault>){
+        if bytes.len()!=8 {faults.push(Fault::Malformed{queue:Queue::Keyboard});return;}
+        // A record of the right size is numbered even when its contents are bad.
+        if let Some(lost)=sequence_gap(&mut self.keyboard_sequence,u32::from_le_bytes(bytes[..4].try_into().unwrap())){
