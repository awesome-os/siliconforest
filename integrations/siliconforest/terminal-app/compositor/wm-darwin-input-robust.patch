+/// Counts of everything that went wrong with the input queues, and of what was read.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct HidHealth {
+    pub records: u64,
+    pub events: u64,
+    pub gaps: u64,
+    pub lost: u64,
+    pub malformed: u64,
+    pub unsupported: u64,
+    pub short: u64,
+    pub read_errors: u64,
+    pub closed: u64,
+    pub reopens: u64,
+    pub open_failures: u64,
+    /// Events the reader thread could not hand on because the desktop had not taken the ones
+    /// before (only after a stall of many seconds), dropped or merged with the one before.
+    pub backlog_dropped: u64,
+}
+impl HidHealth {
+    fn note(&mut self, fault: &Fault) {
+        match fault {
+            Fault::Gap { lost, .. } => { self.gaps += 1; self.lost += u64::from(*lost); }
+            Fault::Malformed { .. } => self.malformed += 1,
+            Fault::Unsupported { .. } => self.unsupported += 1,
+            Fault::Short { .. } => self.short += 1,
+            Fault::Read { .. } => self.read_errors += 1,
+            Fault::Closed { .. } => self.closed += 1,
+        }
+    }
+    pub fn faults(&self) -> u64 {
+        self.gaps + self.malformed + self.unsupported + self.short + self.read_errors + self.closed + self.open_failures + self.backlog_dropped
+    }
+    pub fn summary(&self) -> String {
+        format!("records={} events={} gaps={} lost_records={} malformed={} unsupported_keys={} short={} read_errors={} gone={} reopens={} open_failures={} backlog_dropped={}",
+            self.records, self.events, self.gaps, self.lost, self.malformed, self.unsupported, self.short, self.read_errors, self.closed, self.reopens, self.open_failures, self.backlog_dropped)
+    }
+}
