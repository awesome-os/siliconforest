+    }
+    /// The pointer's record carries every button of its device, so after a gap the next one
+    /// puts the buttons right by itself; only the motion in the lost records is gone.
+    pub fn mouse_into(&mut self,bytes:&[u8],out:&mut Vec<Event>,faults:&mut Vec<Fault>){
+        if bytes.len()!=12 {faults.push(Fault::Malformed{queue:Queue::Mouse});return;}
+        if let Some(lost)=sequence_gap(&mut self.mouse_sequence,u32::from_le_bytes(bytes[..4].try_into().unwrap())){
+            faults.push(Fault::Gap{queue:Queue::Mouse,lost});
+        }
+        if bytes[5]&!7!=0 || bytes[9]&!1!=0 || (bytes[9]==0 && bytes[10..]!=[0,0]) {faults.push(Fault::Malformed{queue:Queue::Mouse});return;}
