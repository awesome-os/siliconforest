+/// An event and when it was read from the device node (for the motion-to-screen latency).
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Stamped {
+    pub event: Event,
+    pub at: std::time::Instant,
+}
+
+/// Events waiting for the desktop. Bounded: after a stall of many seconds the oldest pointer
+/// motions are merged or dropped (counted), keys are kept.
+#[derive(Default)]
+struct Pending {
+    events: std::collections::VecDeque<Stamped>,
+    dropped: u64,
+    health: HidHealth,
+}
+const PENDING_SOFT: usize = 4096;
+const PENDING_HARD: usize = 16384;
+fn motion_only(event: &Event) -> Option<(Motion, u8)> {
+    match event {
+        Event::Pointer { motion, buttons, wheel: 0 } => Some((*motion, *buttons)),
+        _ => None,
+    }
+}
+impl Pending {
+    fn push(&mut self, stamped: Stamped) {
+        if self.events.len() >= PENDING_SOFT {
+            // Merge a motion into the motion before it (same buttons, no wheel).
+            if let (Some((motion, buttons)), Some(last)) = (motion_only(&stamped.event), self.events.back_mut()) {
+                if let Some((before, last_buttons)) = motion_only(&last.event) {
+                    let merged = match (before, motion) {
+                        (Motion::Absolute(..), Motion::Absolute(..)) => Some(motion),
+                        (Motion::Relative(ax, ay), Motion::Relative(bx, by)) => i8::try_from(i16::from(ax) + i16::from(bx)).ok().zip(i8::try_from(i16::from(ay) + i16::from(by)).ok()).map(|(x, y)| Motion::Relative(x, y)),
+                        _ => None,
+                    };
+                    if let (Some(merged), true) = (merged, last_buttons == buttons) {
+                        last.event = Event::Pointer { motion: merged, buttons, wheel: 0 };
+                        self.dropped += 1;
+                        return;
+                    }
                 }
             }
-            if let Some(m) = m {
-                events.push(self.decoder.mouse(&m)?);
-            }
         }
-        Ok(events)
+        if self.events.len() >= PENDING_HARD {
+            self.events.pop_front();
+            self.dropped += 1;
+        }
+        self.events.push_back(stamped);
+    }
+}
+
+struct Shared {
+    pending: std::sync::Mutex<Pending>,
+    stop: std::sync::atomic::AtomicBool,
+    wake: std::fs::File,
+}
+impl Shared {
+    fn push(&self, events: impl IntoIterator<Item = Stamped>, health: Option<HidHealth>) {
+        let mut pending = self.pending.lock().unwrap_or_else(|e| e.into_inner());
+        let was_empty = pending.events.is_empty();
+        for stamped in events {
+            pending.push(stamped);
+        }
+        if let Some(health) = health {
+            pending.health = health;
+        }
+        let now_empty = pending.events.is_empty();
+        drop(pending);
+        if was_empty && !now_empty {
+            // Wakes the desktop's wait between frames (non-blocking: a full pipe is awake already).
+            let _ = std::io::Write::write(&mut &self.wake, &[1]);
+        }
+    }
+}
+
+/// The queues read on a thread of their own: every 1 ms while input arrives (4 ms after a
+/// quarter of a second without), whatever the desktop's frames are doing. The desktop takes
+/// what has accumulated once per loop turn (`take`), and its wait between frames ends when
+/// something arrives (`wake_fd`).
+pub struct InputThread {
+    shared: std::sync::Arc<Shared>,
+    wake_read: std::fs::File,
+    handle: Option<std::thread::JoinHandle<NativeHid>>,
+    caps: SeatCaps,
+    note: &'static str,
+}
+fn nonblocking_pipe() -> Result<(std::fs::File, std::fs::File), String> {
+    use std::os::fd::FromRawFd;
+    let mut fds = [0i32; 2];
+    if unsafe { libc::pipe(fds.as_mut_ptr()) } != 0 {
+        return Err(format!("input wake pipe: {}", io::Error::last_os_error()));
+    }
+    for fd in fds {
+        unsafe {
+            libc::fcntl(fd, libc::F_SETFL, libc::fcntl(fd, libc::F_GETFL) | libc::O_NONBLOCK);
+            libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC);
+        }
+    }
+    Ok(unsafe { (std::fs::File::from_raw_fd(fds[0]), std::fs::File::from_raw_fd(fds[1])) })
+}
+impl InputThread {
+    pub fn spawn(mut hid: NativeHid) -> Result<Self, String> {
+        let (wake_read, wake) = nonblocking_pipe()?;
+        let shared = std::sync::Arc::new(Shared { pending: Default::default(), stop: false.into(), wake });
+        let caps = hid.seat_caps();
+        let note = hid.qualification_note();
+        let thread_shared = shared.clone();
+        let handle = std::thread::Builder::new()
+            .name("sfhid-reader".into())
+            .spawn(move || {
+                let mut out = Vec::new();
+                let mut last_event = std::time::Instant::now() - std::time::Duration::from_secs(1);
+                while !thread_shared.stop.load(std::sync::atomic::Ordering::Acquire) {
+                    let faults = hid.health.faults();
+                    hid.poll(&mut out);
+                    let now = std::time::Instant::now();
+                    if !out.is_empty() || hid.health.faults() != faults {
+                        if !out.is_empty() {
+                            last_event = now;
+                        }
+                        thread_shared.push(out.drain(..).map(|event| Stamped { event, at: now }), Some(hid.health));
+                    }
+                    let quiet = now.duration_since(last_event) > std::time::Duration::from_millis(250);
+                    std::thread::sleep(std::time::Duration::from_millis(if quiet { 4 } else { 1 }));
+                }
+                hid
+            })
+            .map_err(|e| format!("input thread: {e}"))?;
+        Ok(Self { shared, wake_read, handle: Some(handle), caps, note })
+    }
+    pub fn seat_caps(&self) -> SeatCaps {
+        self.caps
+    }
+    pub fn qualification_note(&self) -> &'static str {
+        self.note
+    }
+    /// Everything read since the last call, oldest first.
+    pub fn take(&mut self) -> Vec<Stamped> {
+        let mut byte = [0u8; 64];
+        while matches!(Read::read(&mut self.wake_read, &mut byte), Ok(n) if n > 0) {}
+        let mut pending = self.shared.pending.lock().unwrap_or_else(|e| e.into_inner());
+        pending.events.drain(..).collect()
+    }
+    /// Readable when events are waiting.
+    pub fn wake_fd(&self) -> i32 {
+        std::os::fd::AsRawFd::as_raw_fd(&self.wake_read)
+    }
+    /// The reader's counts, and the events it could not hand on.
+    pub fn health(&self) -> HidHealth {
+        let pending = self.shared.pending.lock().unwrap_or_else(|e| e.into_inner());
+        HidHealth { backlog_dropped: pending.dropped, ..pending.health }
+    }
+    /// Events from elsewhere into the same queue, stamped now (the test instrument's timed
+    /// streams: they then take the path device events take).
+    pub fn injector(&self) -> Injector {
+        Injector { shared: self.shared.clone() }
+    }
+    /// Stop reading and close the device nodes (the keyboard's console grab ends).
+    pub fn stop(&mut self) -> Option<HidHealth> {
+        self.shared.stop.store(true, std::sync::atomic::Ordering::Release);
+        let hid = self.handle.take()?.join().ok()?;
+        let health = HidHealth { backlog_dropped: self.shared.pending.lock().map(|p| p.dropped).unwrap_or(0), ..hid.health };
+        eprintln!("WMHID final {}", health.summary());
+        Some(health)
+    }
+}
+impl Drop for InputThread {
+    fn drop(&mut self) {
+        let _ = self.stop();
+    }
+}
+/// Puts events into an `InputThread`'s queue as if read from a device node.
+#[derive(Clone)]
+pub struct Injector {
+    shared: std::sync::Arc<Shared>,
+}
+impl Injector {
+    /// The reader's counts as last handed on, and the events it could not hand on.
+    pub fn health(&self) -> HidHealth {
+        let pending = self.shared.pending.lock().unwrap_or_else(|e| e.into_inner());
+        HidHealth { backlog_dropped: pending.dropped, ..pending.health }
+    }
+    pub fn push(&self, event: Event) {
+        self.shared.push([Stamped { event, at: std::time::Instant::now() }], None);
     }
 }
 
