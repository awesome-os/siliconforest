+const BACKOFF_FIRST: std::time::Duration = std::time::Duration::from_millis(50);
+const BACKOFF_MAX: std::time::Duration = std::time::Duration::from_secs(5);
+/// Read errors in a row (no record, no empty queue between them) before the node is reopened.
+const ERRORS_BEFORE_REOPEN: u32 = 3;
