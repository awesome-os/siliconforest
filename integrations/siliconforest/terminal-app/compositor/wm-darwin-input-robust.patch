+    fn read_one(&mut self, decoder: &mut Decoder, out: &mut Vec<Event>, faults: &mut Vec<Fault>, health: &mut HidHealth, now: std::time::Instant) -> ReadOne {
+        let Some(source) = self.source.as_mut() else { return ReadOne::Empty };
+        let len = self.queue.record_len();
+        let mut buf = [0u8; 12];
+        loop {
+            match source.read_record_bytes(&mut buf[..len]) {
+                Ok(n) if n == len => {
+                    self.errors_in_row = 0;
+                    health.records += 1;
+                    match self.queue {
+                        Queue::Keyboard => decoder.keyboard_into(&buf[..len], out, faults),
+                        Queue::Mouse => decoder.mouse_into(&buf[..len], out, faults),
+                    }
+                    return ReadOne::Record;
+                }
+                Ok(0) => {
+                    faults.push(Fault::Closed { queue: self.queue });
+                    self.fail(now);
+                    return ReadOne::Failed;
+                }
+                Ok(n) => {
+                    faults.push(Fault::Short { queue: self.queue, len: n });
+                    return ReadOne::Record;
+                }
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                    self.errors_in_row = 0;
+                    return ReadOne::Empty;
+                }
+                Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
+                Err(e) => {
