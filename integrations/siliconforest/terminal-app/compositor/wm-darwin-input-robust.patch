+/// Where records come from: the device node, or (tests) anything that reads like it.
+pub trait RecordSource: Send {
+    fn read_record_bytes(&mut self, buf: &mut [u8]) -> io::Result<usize>;
+    fn raw_fd(&self) -> Option<i32> { None }
+}
+impl RecordSource for std::fs::File {
+    fn read_record_bytes(&mut self, buf: &mut [u8]) -> io::Result<usize> { Read::read(self, buf) }
+    fn raw_fd(&self) -> Option<i32> { Some(std::os::fd::AsRawFd::as_raw_fd(self)) }
