@@ -87,6 +87,69 @@ pub fn interactive_qos(what: &str) {
     let _ = what;
 }
 
+/// How long before a frame's moment the loop stops polling and waits for it precisely (DESK6).
+pub const PRECISE_WINDOW: std::time::Duration = std::time::Duration::from_micros(3000);
+
+#[cfg(target_os = "macos")]
+struct Mach {
+    policy_set: extern "C" fn(u32, u32, *const i32, u32) -> i32,
+    thread: extern "C" fn(libc::pthread_t) -> u32,
+    wait_until: extern "C" fn(u64) -> i32,
+    now: extern "C" fn() -> u64,
+    numer: u64,
+    denom: u64,
+}
+#[cfg(target_os = "macos")]
+static MACH: std::sync::OnceLock<Option<Mach>> = std::sync::OnceLock::new();
+#[cfg(target_os = "macos")]
+fn mach() -> Option<&'static Mach> {
+    MACH.get_or_init(|| unsafe {
+        let f = |name: &std::ffi::CStr| { let p = libc::dlsym(libc::RTLD_DEFAULT, name.as_ptr()); (!p.is_null()).then_some(p) };
+        let (Some(a), Some(b), Some(c), Some(d), Some(e)) = (f(c"thread_policy_set"), f(c"pthread_mach_thread_np"), f(c"mach_wait_until"), f(c"mach_absolute_time"), f(c"mach_timebase_info")) else {
+            eprintln!("WMPACE precise wait: a mach call is absent (the poll and nanosleep wait stays)");
+            return None;
+        };
+        let timebase: extern "C" fn(*mut [u32; 2]) -> i32 = std::mem::transmute(e);
+        let mut info = [0u32; 2];
+        if timebase(&mut info) != 0 || info[0] == 0 || info[1] == 0 {
+            return None;
+        }
+        Some(Mach { policy_set: std::mem::transmute(a), thread: std::mem::transmute(b), wait_until: std::mem::transmute(c), now: std::mem::transmute(d), numer: u64::from(info[0]), denom: u64::from(info[1]) })
+    }).as_ref()
+}
+
+/// Waits until `due` with the calling thread in the time-constraint (real-time) scheduling class
+/// for the wait, then back in the standard class (DESK6, item 4: frames missed their blank 0.3-0.9 %
+/// of the time because the loop woke 1-2.5 ms late at user-interactive QoS; a real-time thread is
+/// run when its timer fires). `false`: not available here (the caller sleeps as before).
+pub fn precise_wait_until(due: std::time::Instant) -> bool {
+    #[cfg(target_os = "macos")]
+    {
+        let Some(m) = mach() else { return false };
+        let left = due.saturating_duration_since(std::time::Instant::now());
+        let ticks = |d: std::time::Duration| (d.as_nanos() as u64).saturating_mul(m.denom) / m.numer;
+        let thread = (m.thread)(unsafe { libc::pthread_self() });
+        // period one refresh, a millisecond of work, done within four, preemptible
+        let policy = [ticks(std::time::Duration::from_micros(16_667)) as i32, ticks(std::time::Duration::from_micros(1000)) as i32, ticks(std::time::Duration::from_micros(4000)) as i32, 1];
+        let rc = (m.policy_set)(thread, 2, policy.as_ptr(), 4); // THREAD_TIME_CONSTRAINT_POLICY
+        static SAID: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+        if !SAID.swap(true, std::sync::atomic::Ordering::Relaxed) {
+            eprintln!("WMPACE precise wait: time-constraint policy for the last {} us before a commit rc={rc}", PRECISE_WINDOW.as_micros());
+        }
+        (m.wait_until)((m.now)().saturating_add(ticks(left)));
+        if rc == 0 {
+            let standard = [0i32; 1];
+            (m.policy_set)(thread, 1, standard.as_ptr(), 0); // THREAD_STANDARD_POLICY
+        }
+        true
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        let _ = due;
+        false
+    }
+}
+
