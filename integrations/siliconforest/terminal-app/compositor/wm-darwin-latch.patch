+/// When to render: late enough that the frame holds the newest input, early enough to make the
+/// vertical blank it aims at. Learns the blank's phase from flip-complete events, the refresh
+/// interval from their spacing, and the render time from the frames it times; a frame that
+/// arrived a refresh late widens the margin, good frames narrow it again.
+pub(crate) struct FramePacer {
+    enabled: bool,
+    /// A vertical blank (from the earliest-read flip events: the closest to the real blank).
+    phase: Option<Instant>,
+    interval: Duration,
+    /// Render times of the last frames (render start to commit returned), microseconds.
+    renders: std::collections::VecDeque<u32>,
+    margin_us: u32,
+    last_flip: Option<Instant>,
+    /// The blank the frame on its way is aimed at.
+    aim: Option<Instant>,
+    pub frames: u64,
+    pub late: u64,
+}
+// measured on the M1 (desk4-006): with 2.5 ms about 1 % of frames missed the blank they aimed at
+const MARGIN_MIN_US: u32 = 3_500;
+const MARGIN_MAX_US: u32 = 8_000;
+const BUDGET_MIN_US: u32 = 4_000;
+const BUDGET_MAX_US: u32 = 14_000;
+impl FramePacer {
+    pub fn new(enabled: bool) -> Self {
+        Self { enabled, phase: None, interval: Duration::from_micros(16_667), renders: Default::default(), margin_us: MARGIN_MIN_US, last_flip: None, aim: None, frames: 0, late: 0 }
+    }
+    /// How long a frame is given before its blank: the longest of the last 60 render times
+    /// plus the margin.
+    pub fn budget(&self) -> Duration {
+        let longest = self.renders.iter().copied().max().unwrap_or(BUDGET_MIN_US);
+        Duration::from_micros(u64::from((longest + self.margin_us).clamp(BUDGET_MIN_US, BUDGET_MAX_US)))
+    }
+    /// A frame took `render` from its start to the commit's return; `late`: how much after its
+    /// planned moment it started (a busy loop, e.g. a client flooding the desk with commits).
+    /// Both count against the budget, so a loop that wakes late plans earlier.
+    pub fn rendered(&mut self, render: Duration, late: Duration) {
+        let render = render + late;
+        if self.renders.len() == 60 {
+            self.renders.pop_front();
+        }
+        self.renders.push_back(render.as_micros().min(1_000_000) as u32);
+        self.frames += 1;
+    }
+    /// A flip completed (read) at `at`.
+    pub fn flipped(&mut self, at: Instant) {
+        // the spacing of consecutive flips, when it looks like one refresh, refines the interval
+        if let Some(last) = self.last_flip {
+            let d = at.saturating_duration_since(last);
+            if d > Duration::from_micros(15_000) && d < Duration::from_micros(18_500) {
+                let blended = (self.interval.as_micros() as u64 * 15 + d.as_micros() as u64) / 16;
+                self.interval = Duration::from_micros(blended);
+            }
+        }
+        self.last_flip = Some(at);
+        self.phase = Some(match self.phase {
+            None => at,
+            Some(phase) if at < phase => at,
+            Some(phase) => {
+                // the predicted blank nearest to `at`: an earlier event moves the phase there at
+                // once, a later one (read late) only by an eighth of the difference
+                let i = self.interval.as_micros();
+                let off = at.duration_since(phase).as_micros() % i;
+                let nearest_before = at - Duration::from_micros(off as u64);
+                if off > i / 2 {
+                    at
+                } else {
+                    nearest_before + Duration::from_micros((off / 8) as u64)
+                }
+            }
+        });
+        // a frame shown a refresh (or more) after the blank it was aimed at: more margin;
+        // otherwise slowly less
+        if let Some(aim) = self.aim.take() {
+            if at > aim + self.interval / 2 {
+                self.late += 1;
+                self.margin_us = (self.margin_us + 1_500).min(MARGIN_MAX_US);
+            } else {
+                // back by 1 ms over about 200 frames on time
+                self.margin_us = self.margin_us.saturating_sub(5).max(MARGIN_MIN_US);
+            }
+        }
+    }
+    /// Decide now: `Some(moment)` to render then, `None` at once; either way the blank aimed at
+    /// is remembered for the late count.
+    pub fn plan(&mut self, now: Instant) -> Option<Instant> {
+        let due = self.render_at(now);
+        if self.enabled {
+            if let Some(phase) = self.phase {
+                let i = self.interval.as_micros() as u64;
+                let start = due.unwrap_or(now) + self.budget();
+                let since = start.saturating_duration_since(phase).as_micros() as u64;
+                // the first blank at or after the frame's expected end
+                self.aim = Some(phase + Duration::from_micros(since.div_ceil(i) * i));
+            }
+        }
+        due
+    }
+    /// The moment to start the next frame (`None`: now). Without a flip in the last second (the
+    /// display woke, nothing moved for long) there is no reliable phase: render at once.
+    pub fn render_at(&self, now: Instant) -> Option<Instant> {
+        if !self.enabled || self.last_flip.is_none_or(|t| now.saturating_duration_since(t) > Duration::from_secs(1)) {
+            return None;
+        }
+        let phase = self.phase?;
+        let i = self.interval.as_micros() as u64;
+        let budget = self.budget();
+        // the first blank after now
+        let since = now.saturating_duration_since(phase).as_micros() as u64;
+        let next = phase + Duration::from_micros((since / i + 1) * i);
+        let left = next.saturating_duration_since(now);
+        if left >= budget {
+            return Some(next - budget);
+        }
+        // too close to make it with the full budget: at once if the typical render still fits,
+        // else aim at the blank after it
+        let typical = u64::from(self.renders.iter().copied().sum::<u32>()) / (self.renders.len().max(1) as u64);
+        if left >= Duration::from_micros(typical + 1_000) {
+            None
+        } else {
+            Some(next + Duration::from_micros(i) - budget)
+        }
+    }
+    pub fn describe(&self) -> String {
+        format!("pacer={} budget_ms={:.1} margin_ms={:.1} interval_ms={:.3} frames={} late={}", if self.enabled { "late-latch" } else { "off" }, self.budget().as_secs_f64() * 1000.0, f64::from(self.margin_us) / 1000.0, self.interval.as_secs_f64() * 1000.0, self.frames, self.late)
     }
 }
 
