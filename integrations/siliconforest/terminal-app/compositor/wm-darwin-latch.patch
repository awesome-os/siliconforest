+        assert_eq!(p.late, 1);
+        // a render that started late counts its lateness against the budget
+        p.rendered(Duration::from_millis(3), Duration::from_millis(6));
+        assert!(p.budget() >= Duration::from_micros(9_000 + 3_500));
+        // a slow render raises the budget (to at most 14 ms)
+        p.rendered(Duration::from_millis(30), Duration::ZERO);
+        assert_eq!(p.budget(), Duration::from_millis(14));
+        // a flip read 3 ms late moves the phase by an eighth of that at most
+        p.flipped(last + i * 4 + Duration::from_millis(3));
+        let off = (p.phase.unwrap().duration_since(t0).as_micros() as u64) % 16_667;
+        assert!(off < 600 || off > 16_000, "phase moved by an eighth at most: {off}");
+        // stale: a second without flips renders at once; a pacer that is off always does
+        assert_eq!(p.render_at(last + Duration::from_secs(3)), None);
+        assert_eq!(FramePacer::new(false).render_at(last + Duration::from_millis(1)), None);
     }
