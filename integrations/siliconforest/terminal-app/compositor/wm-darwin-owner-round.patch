diff -ruN '--exclude=.git' '--exclude=target' desk2-src/crates/wm-darwin/src/appmenu.rs desk3-src/crates/wm-darwin/src/appmenu.rs
--- desk2-src/crates/wm-darwin/src/appmenu.rs	1969-12-31 16:00:00.000000000 -0800
+++ desk3-src/crates/wm-darwin/src/appmenu.rs	2026-11-14 13:19:07.030154052 -0800
@@ -0,0 +1,300 @@
+//! A Mac application's own menu in the window menu (the owner, 14 November: "right-click a
+//! window title and maximize, show/hide the Mac menu bar (access the menu bar in a flattened
+//! Chonkstep menu as well)").
+//!
+//! When the window menu of a Mac application's window is about to open, the compositor asks the
+//! application, over a socket the application listens on, for its main menu and whether its
+//! in-window menu strip is shown. Nothing is sent at any other time. The rows go below the
+//! window's own verbs: "Hide Menu Bar" / "Show Menu Bar", then one submenu per top-level menu
+//! (the application menu, File, Edit, ...) with the key equivalents right-aligned, disabled rows
+//! dimmed and checked rows marked. A pick is sent back as `invoke <id>` (or `menubar toggle`).
+//! An application that has no socket, or does not answer within `TIMEOUT`, gets the window
+//! verbs only.
+//!
+//! The protocol (proposed to the AppKit stream in runs/m1-coord/requests-for-CLAUDE.md):
+//! the socket `$XDG_RUNTIME_DIR/app-menu/<pid>`, owned by the session's user; lines of UTF-8
+//! ending in `\n`. `menubar` -> `shown` | `hidden`; `menubar show|hide|toggle` -> `ok shown|hidden`;
+//! `menu 1` -> `item <id> <depth> <flags> <key> <title>` lines then `end`; `invoke <id>` -> `ok`
+//! or `error <text>`. Flags: `s` submenu, `d` disabled, `c` checked, `m` mixed, `p` separator,
+//! `a` the application menu, `-` none. Key: `cmd+shift+opt+ctrl+<char>` or `-`.
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::fs::{FileTypeExt, MetadataExt};
+use std::os::unix::net::UnixStream;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+use wm_theme::menu::{MenuItem, DISABLED};
+
+/// How long the compositor waits for an application's answer (the menu is on its way to the screen).
+pub const TIMEOUT: Duration = Duration::from_millis(200);
+/// The host id of the "Hide/Show Menu Bar" row; an item's row is its index plus one.
+pub const MENUBAR_TOGGLE: u32 = 0;
+/// The host id of a row that cannot be picked (disabled): nothing has it.
+pub const NOTHING: u32 = u32::MAX - 2_000_000;
+const MAX_ITEMS: usize = 4000;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Item {
+    pub id: String,
+    pub depth: u32,
+    pub flags: String,
+    pub key: String,
+    pub title: String,
+}
+
+/// What an application answered: its menu bar's state (when it said) and its main menu.
+#[derive(Clone, Debug, Default)]
+pub struct AppMenu {
+    pub pid: i32,
+    pub menubar: Option<bool>,
+    pub items: Vec<Item>,
+}
+
+pub fn socket_path(runtime: &Path, pid: i32) -> PathBuf {
+    runtime.join("app-menu").join(pid.to_string())
+}
+
+/// One line `item <id> <depth> <flags> <key> <title>`.
+pub fn parse_item(line: &str) -> Option<Item> {
+    let mut words = line.splitn(6, ' ');
+    if words.next()? != "item" {
+        return None;
+    }
+    let id = words.next()?.to_string();
+    let depth = words.next()?.parse().ok()?;
+    let flags = words.next()?.to_string();
+    let key = words.next()?.to_string();
+    let title = words.next().unwrap_or("").replace(['\t', '\r'], " ");
+    (!id.is_empty() && depth < 16).then_some(Item { id, depth, flags, key, title })
+}
+
+fn connect(runtime: &Path, pid: i32) -> Result<UnixStream, String> {
+    let path = socket_path(runtime, pid);
+    let meta = std::fs::symlink_metadata(&path).map_err(|_| "no menu socket".to_string())?;
+    if !meta.file_type().is_socket() {
+        return Err("not a socket".into());
+    }
+    if meta.uid() != unsafe { libc::geteuid() } {
+        return Err("the socket is another user's".into());
+    }
+    let stream = UnixStream::connect(&path).map_err(|e| format!("connect: {e}"))?;
+    stream.set_read_timeout(Some(TIMEOUT)).map_err(|e| e.to_string())?;
+    stream.set_write_timeout(Some(TIMEOUT)).map_err(|e| e.to_string())?;
+    if let Some(peer) = crate::server::stream_pid(&stream) {
+        if peer != pid {
+            return Err(format!("the socket is served by pid {peer}, not {pid}"));
+        }
+    }
+    Ok(stream)
+}
+
+/// The application's menu and menu bar state; an error when it has no socket or did not answer.
+pub fn fetch(runtime: &Path, pid: i32) -> Result<AppMenu, String> {
+    let mut stream = connect(runtime, pid)?;
+    stream.write_all(b"menubar\nmenu 1\n").map_err(|e| format!("write: {e}"))?;
+    let mut reader = BufReader::new(stream);
+    let mut menu = AppMenu { pid, ..AppMenu::default() };
+    let mut line = String::new();
+    let mut first = true;
+    loop {
+        line.clear();
+        match reader.read_line(&mut line) {
+            Ok(0) => return Err("the application closed the socket before `end`".into()),
+            Ok(_) => {}
+            Err(e) => return Err(format!("no answer: {e}")),
+        }
+        let text = line.trim_end_matches(['\n', '\r']);
+        if first {
+            first = false;
+            match text {
+                "shown" => { menu.menubar = Some(true); continue }
+                "hidden" => { menu.menubar = Some(false); continue }
+                _ if text.starts_with("error") => continue,
+                _ => {}
+            }
+        }
+        if text == "end" {
+            return Ok(menu);
+        }
+        if let Some(item) = parse_item(text) {
+            if menu.items.len() < MAX_ITEMS {
+                menu.items.push(item);
+            }
+        }
+    }
+}
+
+/// One request, one line of answer (`invoke <id>`, `menubar toggle`).
+pub fn request(runtime: &Path, pid: i32, line: &str) -> Result<String, String> {
+    let mut stream = connect(runtime, pid)?;
+    stream.write_all(format!("{line}\n").as_bytes()).map_err(|e| format!("write: {e}"))?;
+    let mut answer = String::new();
+    BufReader::new(stream).read_line(&mut answer).map_err(|e| format!("no answer: {e}"))?;
+    Ok(answer.trim_end().to_string())
+}
+
+/// `cmd+shift+t` as macOS writes it: ⇧⌘T (Control, Option, Shift, Command, then the key).
+pub fn key_label(key: &str) -> String {
+    if key.is_empty() || key == "-" {
+        return String::new();
+    }
+    let parts: Vec<&str> = key.split('+').collect();
+    let (mods, name) = parts.split_at(parts.len().saturating_sub(1));
+    let mut out = String::new();
+    for (word, glyph) in [("ctrl", "\u{2303}"), ("opt", "\u{2325}"), ("shift", "\u{21e7}"), ("cmd", "\u{2318}")] {
+        if mods.contains(&word) {
+            out.push_str(glyph);
+        }
+    }
+    let name = name.first().copied().unwrap_or("");
+    let named = match name {
+        "return" => "\u{21a9}".to_string(),
+        "tab" => "\u{21e5}".to_string(),
+        "delete" => "\u{232b}".to_string(),
+        "esc" => "\u{238b}".to_string(),
+        "left" => "\u{2190}".to_string(),
+        "right" => "\u{2192}".to_string(),
+        "up" => "\u{2191}".to_string(),
+        "down" => "\u{2193}".to_string(),
+        "space" => "Space".to_string(),
+        n if n.len() > 1 && n.starts_with('f') && n[1..].chars().all(|c| c.is_ascii_digit()) => n.to_uppercase(),
+        n => n.to_uppercase(),
+    };
+    out.push_str(&named);
+    out
+}
+
+/// The rows for the window menu: the menu bar's row, then the application's menus as submenus.
+pub fn rows(menu: &AppMenu) -> Vec<MenuItem> {
+    let mut rows = Vec::new();
+    if let Some(shown) = menu.menubar {
+        rows.push(MenuItem::Action { label: if shown { "Hide Menu Bar" } else { "Show Menu Bar" }.into(), action: MENUBAR_TOGGLE });
+    }
+    let mut index = 0;
+    while index < menu.items.len() {
+        let item = &menu.items[index];
+        if item.depth == 0 {
+            let (children, next) = level(&menu.items, index + 1, 1);
+            if !children.is_empty() && !item.flags.contains('p') {
+                rows.push(MenuItem::Submenu { label: item.title.clone(), items: children });
+            }
+            index = next;
+        } else {
+            index += 1;
+        }
+    }
+    rows
+}
+
+/// The rows of one menu at `depth`, from `start`; returns them and where the menu ends.
+fn level(items: &[Item], start: usize, depth: u32) -> (Vec<MenuItem>, usize) {
+    let mut rows = Vec::new();
+    let mut i = start;
+    while i < items.len() && items[i].depth >= depth {
+        let item = &items[i];
+        if item.depth > depth {
+            i += 1;
+            continue;
+        }
+        let flags = item.flags.as_str();
+        if flags.contains('p') || item.title.trim().is_empty() {
+            i += 1;
+            continue;
+        }
+        let mark = if flags.contains('c') { "\u{2713} " } else if flags.contains('m') { "\u{2013} " } else { "" };
+        if flags.contains('s') {
+            let (children, next) = level(items, i + 1, depth + 1);
+            if !children.is_empty() {
+                rows.push(MenuItem::Submenu { label: format!("{mark}{}", item.title), items: children });
+            }
+            i = next;
+            continue;
+        }
+        let key = key_label(&item.key);
+        let disabled = flags.contains('d');
+        let label = format!("{}{mark}{}{}", if disabled { DISABLED.to_string() } else { String::new() }, item.title, if key.is_empty() { String::new() } else { format!("\t{key}") });
+        rows.push(MenuItem::Action { label, action: if disabled { NOTHING } else { i as u32 + 1 } });
+        i += 1;
+    }
+    (rows, i)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::net::UnixListener;
+
+    const MENU: &str = "item 0 0 sa - Activity Monitor\n\
+        item 0.0 1 - - About Activity Monitor\n\
+        item 0.1 1 p - \n\
+        item 0.2 1 - cmd+q Quit Activity Monitor\n\
+        item 1 0 s - File\n\
+        item 1.0 1 - cmd+w Close\n\
+        item 1.1 1 d cmd+p Print\u{2026}\n\
+        item 2 0 s - View\n\
+        item 2.0 1 c - Show Toolbar\n\
+        item 2.1 1 s - Update Frequency\n\
+        item 2.1.0 2 c - Very often (1 sec)\n\
+        item 2.1.1 2 - - Often (2 sec)\n\
+        item 2.2 1 - cmd+opt+shift+ctrl+down Odd\n\
+        end\n";
+
+    #[test]
+    fn an_applications_menu_becomes_the_window_menus_rows() {
+        let items: Vec<Item> = MENU.lines().filter_map(parse_item).collect();
+        let menu = AppMenu { pid: 1, menubar: Some(true), items };
+        let rows = rows(&menu);
+        let labels: Vec<&str> = rows.iter().map(MenuItem::label).collect();
+        assert_eq!(labels, ["Hide Menu Bar", "Activity Monitor", "File", "View"]);
+        let MenuItem::Submenu { items: file, .. } = &rows[2] else { panic!("File is a submenu") };
+        assert_eq!(file[0].label(), "Close\t\u{2318}W");
+        assert!(matches!(file[0], MenuItem::Action { action: 6, .. }), "the item's index plus one");
+        assert_eq!(file[1].label(), "\u{1}Print\u{2026}\t\u{2318}P", "disabled and dimmed");
+        assert!(matches!(file[1], MenuItem::Action { action: NOTHING, .. }));
+        let MenuItem::Submenu { items: view, .. } = &rows[3] else { panic!() };
+        assert_eq!(view[0].label(), "\u{2713} Show Toolbar");
+        let MenuItem::Submenu { label, items: freq } = &view[1] else { panic!("a nested submenu") };
+        assert_eq!(label, "Update Frequency");
+        assert_eq!(freq.len(), 2);
+        assert_eq!(view[2].label(), "Odd\t\u{2303}\u{2325}\u{21e7}\u{2318}\u{2193}");
+        let MenuItem::Submenu { items: app, .. } = &rows[1] else { panic!() };
+        assert_eq!(app.len(), 2, "the separator is left out");
+    }
+
+    /// A fake application on a real socket: the menu is fetched, an item invoked, the menu bar
+    /// toggled; an application without a socket gives an error (the window verbs only).
+    #[test]
+    fn the_menu_is_fetched_and_an_item_invoked_over_the_applications_socket() {
+        let runtime = tempfile::tempdir().unwrap();
+        let pid = std::process::id() as i32;
+        std::fs::create_dir(runtime.path().join("app-menu")).unwrap();
+        let listener = UnixListener::bind(socket_path(runtime.path(), pid)).unwrap();
+        let app = std::thread::spawn(move || {
+            let mut seen = Vec::new();
+            for _ in 0..3 {
+                let (stream, _) = listener.accept().unwrap();
+                let mut reader = BufReader::new(stream.try_clone().unwrap());
+                let mut out = stream;
+                let mut line = String::new();
+                while reader.read_line(&mut line).unwrap() > 0 {
+                    let request = line.trim_end().to_string();
+                    line.clear();
+                    seen.push(request.clone());
+                    match request.as_str() {
+                        "menubar" => out.write_all(b"shown\n").unwrap(),
+                        "menu 1" => { out.write_all(MENU.as_bytes()).unwrap(); break }
+                        r if r.starts_with("invoke ") || r.starts_with("menubar ") => { out.write_all(b"ok\n").unwrap(); break }
+                        _ => out.write_all(b"error unknown\n").unwrap(),
+                    }
+                }
+            }
+            seen
+        });
+        let menu = fetch(runtime.path(), pid).unwrap();
+        assert_eq!(menu.menubar, Some(true));
+        assert_eq!(menu.items.len(), 13);
+        assert_eq!(request(runtime.path(), pid, &format!("invoke {}", menu.items[5].id)).unwrap(), "ok");
+        assert_eq!(request(runtime.path(), pid, "menubar toggle").unwrap(), "ok");
+        assert_eq!(app.join().unwrap(), ["menubar", "menu 1", "invoke 1.0", "menubar toggle"]);
+        assert!(fetch(runtime.path(), pid + 1).is_err(), "no socket: no rows");
+    }
+}
