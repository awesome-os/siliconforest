+    /// The windows' own pictures and the scene's surfaces (`dump <name>`).
+    fn dump(&mut self, server: &Server, name: &str) -> Result<(), String> {
+        let backend = server.wm.backend();
+        let mut text = String::new();
+        let mut ids: Vec<u64> = backend.windows.keys().copied().collect();
+        ids.sort_unstable();
+        for id in ids {
+            let w = &backend.windows[&id];
+            let frame = backend.window_frame_rect(id);
+            let image = w.image.as_ref();
+            text.push_str(&format!(
+                "window {id} app_id={:?} title={:?} mapped={} content={:?} frame={:?} picture={:?} external={}\n",
+                w.app_id.as_deref().or(w.last_app_id.as_deref()).unwrap_or(""), w.title.as_deref().unwrap_or(""), w.mapped, w.content, frame,
+                image.map(|i| (i.width, i.height)), w.external.is_some()
+            ));
+            let Some(image) = image.filter(|i| i.pixels.len() == i.width as usize * i.height as usize * 4) else { continue };
+            // how opaque the client's picture is (premultiplied RGBA): a translucent window shows
+            // what is under it
+            let mut alphas = std::collections::BTreeMap::<u8, u64>::new();
+            for pixel in image.pixels.chunks_exact(4) {
+                *alphas.entry(pixel[3]).or_default() += 1;
+            }
+            let mut common: Vec<(u8, u64)> = alphas.into_iter().collect();
+            common.sort_by(|a, b| b.1.cmp(&a.1));
+            common.truncate(4);
+            text.push_str(&format!("  alpha (value, pixels), most common: {common:?}\n"));
+            let mut file = format!("P6\n{} {}\n255\n", image.width, image.height).into_bytes();
+            for pixel in image.pixels.chunks_exact(4) {
+                file.extend_from_slice(&pixel[..3]);
+            }
+            std::fs::write(self.dir.join(format!("{name}-{id}.ppm")), file).map_err(|e| e.to_string())?;
+        }
+        text.push_str(&backend.describe_shells());
+        std::fs::write(self.dir.join(format!("{name}.txt")), text).map_err(|e| e.to_string())?;
+        eprintln!("WMINJECT dump={name}");
+        Ok(())
+    }
