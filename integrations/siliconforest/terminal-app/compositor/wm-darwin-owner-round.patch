+/// The owner's second finding: during an interactive resize the frame's old bottom edge stayed
+/// where the resize began until it ended. The frame now follows every frame, drawn for the size
+/// the client's picture has: no old edge across the content, no gap while the client catches up.
+#[test]
+fn the_frame_follows_an_interactive_resize_and_matches_the_clients_picture(){
+    let (h, connection) = Harness::with_input(true);
+    let mut queue = connection.new_event_queue();
+    let qh = queue.handle();
+    let mut c = Client::default();
+    connection.display().get_registry(&qh, ());
+    for _ in 0..3 { queue.roundtrip(&mut c).unwrap(); }
+    let surface = c.compositor.as_ref().unwrap().create_surface(&qh, ());
+    let xdg = c.shell.as_ref().unwrap().get_xdg_surface(&surface, &qh, ());
+    let top = xdg.get_toplevel(&qh, ());
+    let decor = c.decoration.as_ref().unwrap().get_toplevel_decoration(&top, &qh, ());
+    decor.set_mode(zxdg_toplevel_decoration_v1::Mode::ServerSide);
+    top.set_title("Resize".into());
+    surface.commit();
+    queue.roundtrip(&mut c).unwrap();
+    let mut file = tempfile::tempfile().unwrap();
+    file.write_all(&[0, 0, 255, 255].repeat(320 * 240)).unwrap(); // red, XRGB little endian
+    let pool = c.shm.as_ref().unwrap().create_pool(file.as_fd(), 320 * 240 * 4, &qh, ());
+    let present = |c: &mut Client, queue: &mut wayland_client::EventQueue<Client>, size: (i32, i32)| {
+        let buffer = pool.create_buffer(0, size.0, size.1, size.0 * 4, wl_shm::Format::Xrgb8888, &qh, ());
+        surface.attach(Some(&buffer), 0, 0);
+        surface.damage_buffer(0, 0, size.0, size.1);
+        surface.commit();
+        queue.roundtrip(c).unwrap();
+        queue.roundtrip(c).unwrap();
+    };
+    present(&mut c, &mut queue, (100, 60));
+    let before = h.snapshot();
+    let c0 = before.content.unwrap();
+    assert_eq!((c0.size.w, c0.size.h), (100, 60));
+    let px = |shot: &Snapshot, x: i32, y: i32| -> [u8; 4] { let at = (y as usize * 320 + x as usize) * 4; shot.pixels[at..at + 4].try_into().unwrap() };
+    let red = [255, 0, 0, 255];
+    let x = c0.pos.x + 50;
+    let old_bottom = c0.pos.y + 60;
+    assert_ne!(px(&before, x, old_bottom), red, "a frame edge below the content before the resize");
+    let grip = before.resize_corner.expect("a south-east resize handle");
+    let mut seq = 0;
+    let mut send = |p: wm_core::Point, buttons: u8| { seq += 1; h.tx.send(abs_mouse(seq, p, buttons)).unwrap(); };
+    send(grip, 0);
+    send(grip, 1);
+    send(wm_core::Point::new(grip.x + 40, grip.y + 30), 1);
+    h.snapshot();
+    queue.roundtrip(&mut c).unwrap();
+    let asked = *c.configured_sizes.last().unwrap();
+    assert!(asked.0 > 110 && asked.1 > 70, "the client is asked for a larger size: {asked:?}");
+    // Still held: the client draws the new size.
+    present(&mut c, &mut queue, asked);
+    let during = h.snapshot();
+    for y in [old_bottom, old_bottom + 1, old_bottom + 3] {
+        assert_eq!(px(&during, x, y), red, "row {y}: the old bottom edge must not stay across the content during the resize");
+    }
+    let new_bottom = c0.pos.y + asked.1;
+    assert_ne!(px(&during, x, new_bottom), red, "the frame's bottom edge is below the new content");
+    let edge_row: Vec<[u8; 4]> = (c0.pos.x..c0.pos.x + asked.0).map(|x| px(&during, x, new_bottom)).collect();
+    // The pointer goes further; the client has not drawn that size yet: the frame drawn stays the
+    // one around its picture, not a frame of the new size around a smaller picture.
+    send(wm_core::Point::new(grip.x + 40, grip.y + 45), 1);
+    h.snapshot();
+    let held = h.snapshot();
+    let policy = held.content.unwrap().size;
+    assert!(policy.h as i32 > asked.1 + 5, "the policy's size moved on: {policy:?}");
+    let held_row: Vec<[u8; 4]> = (c0.pos.x..c0.pos.x + asked.0).map(|x| px(&held, x, new_bottom)).collect();
+    assert_eq!(held_row, edge_row, "the frame drawn is the one for the client's picture until the client catches up");
+    queue.roundtrip(&mut c).unwrap();
+    let newest = *c.configured_sizes.last().unwrap();
+    present(&mut c, &mut queue, newest);
+    let caught = h.snapshot();
+    assert_eq!(px(&caught, x, new_bottom), red, "caught up: the content covers the old edge row");
+    assert_ne!(px(&caught, x, c0.pos.y + newest.1), red, "and the frame's edge is below the newest content");
+    send(wm_core::Point::new(grip.x + 40, grip.y + 45), 0);
+    h.snapshot();
+}
