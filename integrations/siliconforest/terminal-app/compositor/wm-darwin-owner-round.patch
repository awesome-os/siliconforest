+/// The owner's fifth finding: a right click (or Control-click) on a window's title bar opens its
+/// menu with the window's verbs (on the standalone desk it offered only Close); Maximize from it
+/// maximises the window.
+#[test]
+#[cfg(feature="desktop-shell")]
+fn a_right_click_on_the_title_opens_the_window_menu_and_maximize_works(){
+    let(h,a)=Harness::with_input(true);let(tx,rx)=mpsc::channel();h.tx.send(Request::Desktop(tx)).unwrap();rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let(mut q,mut c,_s,_x,_t)=map_client(&a,"menu-test");
+    let before=h.snapshot();let title=before.titlebar.expect("a title bar");let size=before.content.unwrap().size;
+    h.tx.send(abs_mouse(1,title,0)).unwrap();h.tx.send(abs_mouse(2,title,2)).unwrap();
+    let pressed=h.snapshot();
+    h.tx.send(abs_mouse(3,title,0)).unwrap();
+    let open=h.snapshot();q.roundtrip(&mut c).unwrap();
+    assert!(pressed.shells>before.shells,"the press opened the window menu: shells {} -> {}",before.shells,pressed.shells);
+    assert!(open.shells>before.shells,"the window menu opened: shells {} -> {}",before.shells,open.shells);
+    // Down to its first row (Maximize), Return.
+    for (seq,usage,down) in [(1,0x51,true),(2,0x51,false),(3,0x28,true),(4,0x28,false)]{h.tx.send(key_record(seq,usage,down)).unwrap();}
+    h.snapshot();q.roundtrip(&mut c).unwrap();q.roundtrip(&mut c).unwrap();
+    let after=h.snapshot();
+    let maximized=c.configured_sizes.iter().any(|&(w,hh)|w as u32>size.w && hh as u32>size.h);
+    assert!(maximized,"Maximize from the window menu asked the client for a larger size: {:?} (was {size:?})",c.configured_sizes);
+    assert_eq!(after.shells,before.shells,"the menu closed");
+}
