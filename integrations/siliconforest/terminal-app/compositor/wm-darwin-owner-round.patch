+    /// cover it, as the owner wants), so its title bar's buttons are not born under a tile.
+    pub(crate) fn place_clear_of_launchers(&mut self, window: u64) {
+        let Some(frame) = self.wm.backend().window_frame_rect(window) else { return };
+        let overlaps = |r: &Rect| r.pos.x < frame.pos.x + frame.size.w as i32 && frame.pos.x < r.pos.x + r.size.w as i32
+            && r.pos.y < frame.pos.y + frame.size.h as i32 && frame.pos.y < r.pos.y + r.size.h as i32;
