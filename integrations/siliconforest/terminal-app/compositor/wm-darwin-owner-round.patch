+        MenuItem::Action { label: if ctx.fullscreen { "Exit Full Screen" } else { "Enter Full Screen" }.to_string(), action: ACTION_WINDOW_FULLSCREEN },
+        MenuItem::Submenu { label: "Move to Space".to_string(), items: spaces },
+        MenuItem::Action { label: "Close".to_string(), action: ACTION_WINDOW_CLOSE },
+    ];
+    items.extend(ctx.extra.iter().cloned());
+    items
+}
