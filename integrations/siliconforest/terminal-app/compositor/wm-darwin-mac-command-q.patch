+    /// The focused toplevel belongs to a Mac application: its app id is the bundle identifier of an
+    /// application bundle in /Applications.
+    fn focused_is_mac_application(&self) -> bool {
+        let Some(client) = self.wm.focused_client().and_then(|id| self.wm.client(id)) else { return false };
+        let Some(app_id) = self.wm.backend().windows.get(&client.window).and_then(|w| w.app_id.clone()) else { return false };
+        crate::settings::mac_bundle_identifiers().iter().any(|id| *id == app_id)
+    }
+}
