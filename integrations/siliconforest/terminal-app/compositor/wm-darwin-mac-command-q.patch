+/// The bundle identifiers (`CFBundleIdentifier` of an XML `Info.plist`) of the application bundles
+/// in [`APPLICATION_DIRS`]: the app ids of Mac applications (their WindowServer names each toplevel
+/// after the bundle identifier). Read when asked, so a bundle installed later is known.
+pub fn mac_bundle_identifiers() -> Vec<String> {
+    let mut ids = Vec::new();
+    for app in applications_in(&APPLICATION_DIRS) {
+        let Ok(text) = std::fs::read_to_string(app.join("Contents/Info.plist")) else { continue };
+        let Some(at) = text.find("<key>CFBundleIdentifier</key>") else { continue };
+        let rest = &text[at..];
+        if let (Some(open), Some(close)) = (rest.find("<string>"), rest.find("</string>")) {
+            if open < close {
+                ids.push(rest[open + 8..close].trim().to_string());
+            }
+        }
+    }
+    ids
+}
