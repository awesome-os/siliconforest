@@ -0,0 +1,422 @@
+//! Applications' icons, for every place that shows an application: the dock's launcher and
+//! window tiles, the application switcher, minimised-window tiles, the launcher's rows.
+//!
+//! - An application bundle (`.app`): its icon is read at run time from the bundle in place
+//!   (Info.plist `CFBundleIconFile`, else the first `.icns` in `Contents/Resources`) and decoded
+//!   into memory; the entry nearest the size asked for is taken. Entries decoded here: PNG,
+//!   packed ARGB (`ic04`, `ic05`) and the RLE RGB images with their 8-bit masks (`is32`/`s8mk`,
+//!   `il32`/`l8mk`, `ih32`/`h8mk`, `it32`/`t8mk`). JPEG 2000 entries are skipped. A bundle with
+//!   only an asset catalog (`CFBundleIconName`, Assets.car) has no icon here yet. Nothing is
+//!   written anywhere: the only cache is this process's memory.
+//! - A `.desktop` item's `Icon=`: a bundle path, an absolute `.png`/`.icns` file, a name in
+//!   `/usr/share/icons/hicolor/*/apps` or `/usr/share/pixmaps`, or one of the icons drawn here
+//!   (`chonkstep-terminal`: the desktop's own terminal).
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use tiny_skia::{Color, FillRule, Paint, PathBuilder, Pixmap, PixmapPaint, Stroke, Transform};
+
+/// Where application bundles are, in the order `open -a` looks (SiliconForest's open.c).
+pub const APPLICATION_DIRS: [&str; 4] = ["/Applications", "/Applications/Utilities", "/System/Applications", "/System/Applications/Utilities"];
+
+type Cache = HashMap<(String, u32), Option<Arc<Pixmap>>>;
+static CACHE: Mutex<Option<Cache>> = Mutex::new(None);
+static BUNDLES: Mutex<Option<(std::time::Instant, Vec<(String, PathBuf)>)>> = Mutex::new(None);
+
+fn cached(key: String, size: u32, make: impl FnOnce() -> Option<Pixmap>) -> Option<Arc<Pixmap>> {
+    let mut guard = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    let cache = guard.get_or_insert_with(HashMap::new);
+    if let Some(hit) = cache.get(&(key.clone(), size)) {
+        return hit.clone();
+    }
+    let made = make().map(Arc::new);
+    if cache.len() > 256 {
+        cache.clear();
+    }
+    cache.insert((key, size), made.clone());
+    made
+}
+
+/// `<key>K</key> <string>V</string>` in an XML property list.
+pub fn plist_string(text: &str, key: &str) -> Option<String> {
+    let at = text.find(&format!("<key>{key}</key>"))?;
+    let rest = &text[at..];
+    let open = rest.find("<string>")?;
+    let close = rest.find("</string>")?;
+    (open < close).then(|| rest[open + 8..close].trim().to_string())
+}
+
+/// Every bundle in the application directories with its identifier (re-read every 5 s).
+pub fn bundles() -> Vec<(String, PathBuf)> {
+    let mut guard = BUNDLES.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((at, list)) = guard.as_ref() {
+        if at.elapsed() < std::time::Duration::from_secs(5) {
+            return list.clone();
+        }
+    }
+    let mut list: Vec<(String, PathBuf)> = Vec::new();
+    for dir in APPLICATION_DIRS {
+        let Ok(entries) = std::fs::read_dir(dir) else { continue };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if !path.extension().is_some_and(|e| e == "app") || !path.is_dir() || list.iter().any(|(_, p)| p.file_name() == path.file_name()) {
+                continue;
+            }
+            if let Some(id) = std::fs::read_to_string(path.join("Contents/Info.plist")).ok().and_then(|t| plist_string(&t, "CFBundleIdentifier")) {
+                list.push((id, path));
+            }
+        }
+    }
+    *guard = Some((std::time::Instant::now(), list.clone()));
+    list
+}
+
+/// The bundle whose `CFBundleIdentifier` is `id` (an AppKit window's app id).
+pub fn bundle_for_identifier(id: &str) -> Option<PathBuf> {
+    bundles().into_iter().find(|(b, _)| b.eq_ignore_ascii_case(id)).map(|(_, p)| p)
+}
+
+/// The `.app` a file is inside (a process's executable).
+pub fn enclosing_bundle(path: &Path) -> Option<PathBuf> {
+    path.ancestors().find(|p| p.extension().is_some_and(|e| e == "app")).map(Path::to_path_buf)
+}
+
+/// A bundle's icon at `size` pixels (square), decoded from its .icns.
+pub fn bundle_icon(bundle: &Path, size: u32) -> Option<Arc<Pixmap>> {
+    cached(bundle.display().to_string(), size, || {
+        let resources = bundle.join("Contents/Resources");
+        let named = std::fs::read_to_string(bundle.join("Contents/Info.plist")).ok().and_then(|t| plist_string(&t, "CFBundleIconFile"));
+        let file = named
+            .map(|n| if n.ends_with(".icns") { n } else { format!("{n}.icns") })
+            .map(|n| resources.join(n))
+            .filter(|p| p.is_file())
+            .or_else(|| std::fs::read_dir(&resources).ok()?.flatten().map(|e| e.path()).find(|p| p.extension().is_some_and(|x| x == "icns")))?;
+        let image = decode_icns(&std::fs::read(file).ok()?, size)?;
+        Some(fit(&image, size))
+    })
+}
+
+/// The icon of a `.desktop` `Icon=` value.
+pub fn icon_named(spec: &str, size: u32) -> Option<Arc<Pixmap>> {
+    let spec = spec.trim();
+    if spec.is_empty() {
+        return None;
+    }
+    if spec.ends_with(".app") {
+        return bundle_icon(Path::new(spec), size);
+    }
+    cached(spec.to_string(), size, || {
+        if let Some(drawn) = drawn(spec, size) {
+            return Some(drawn);
+        }
+        let file = if spec.starts_with('/') {
+            Some(PathBuf::from(spec))
+        } else {
+            let mut candidates = vec![PathBuf::from(format!("/usr/share/pixmaps/{spec}.png"))];
+            for px in [512, 256, 128, 96, 64, 48, 32] {
+                candidates.insert(0, PathBuf::from(format!("/usr/share/icons/hicolor/{px}x{px}/apps/{spec}.png")));
+            }
+            candidates.into_iter().find(|p| p.is_file())
+        }?;
+        let bytes = std::fs::read(&file).ok()?;
+        let image = if file.extension().is_some_and(|e| e == "icns") { decode_icns(&bytes, size)? } else { decode_png(&bytes)? };
+        Some(fit(&image, size))
+    })
+}
+
+/// An application's icon by its application id: its bundle's when the id is a bundle
+/// identifier, the desktop's own terminal's for `chonk-terminal-darwin`.
+pub fn for_app_id(app_id: &str, size: u32) -> Option<Arc<Pixmap>> {
+    if app_id.eq_ignore_ascii_case("chonk-terminal-darwin") || app_id.eq_ignore_ascii_case("org.siliconforest.terminal") {
+        return icon_named("chonkstep-terminal", size);
+    }
+    bundle_for_identifier(app_id).and_then(|b| bundle_icon(&b, size))
+}
+
+/// `image` scaled to fit a `size` square, centered.
+pub fn fit(image: &Pixmap, size: u32) -> Pixmap {
+    let size = size.max(1);
+    let mut out = Pixmap::new(size, size).expect("icon size");
+    let scale = (size as f32 / image.width() as f32).min(size as f32 / image.height() as f32);
+    let (w, h) = (image.width() as f32 * scale, image.height() as f32 * scale);
+    let paint = PixmapPaint { quality: tiny_skia::FilterQuality::Bicubic, ..PixmapPaint::default() };
+    out.draw_pixmap(0, 0, image.as_ref(), &paint, Transform::from_row(scale, 0.0, 0.0, scale, (size as f32 - w) / 2.0, (size as f32 - h) / 2.0), None);
+    out
+}
+
+/// Draw `icon` into `target` at `(x, y)` scaled to `size`.
+pub fn draw(target: &mut Pixmap, icon: &Pixmap, x: i32, y: i32, size: u32) {
+    let s = size as f32 / icon.width().max(icon.height()) as f32;
+    let paint = PixmapPaint { quality: tiny_skia::FilterQuality::Bicubic, ..PixmapPaint::default() };
+    target.draw_pixmap(0, 0, icon.as_ref(), &paint, Transform::from_row(s, 0.0, 0.0, s, x as f32, y as f32), None);
+}
+
+fn premultiplied(rgba: Vec<u8>, w: u32, h: u32) -> Option<Pixmap> {
+    let mut rgba = rgba;
+    for px in rgba.chunks_exact_mut(4) {
+        let a = u16::from(px[3]);
+        for c in &mut px[..3] {
+            *c = ((u16::from(*c) * a + 127) / 255) as u8;
+        }
+    }
+    Pixmap::from_vec(rgba, tiny_skia::IntSize::from_wh(w, h)?)
+}
+
+pub fn decode_png(data: &[u8]) -> Option<Pixmap> {
+    let mut decoder = png::Decoder::new(std::io::Cursor::new(data));
+    decoder.set_transformations(png::Transformations::normalize_to_color8());
+    let mut reader = decoder.read_info().ok()?;
+    let mut buf = vec![0; reader.output_buffer_size()?];
+    let info = reader.next_frame(&mut buf).ok()?;
+    let channels = match reader.output_color_type().0 {
+        png::ColorType::Rgba => 4,
+        png::ColorType::Rgb => 3,
+        png::ColorType::GrayscaleAlpha => 2,
+        png::ColorType::Grayscale => 1,
+        png::ColorType::Indexed => return None,
+    };
+    let mut rgba = Vec::with_capacity(info.width as usize * info.height as usize * 4);
+    for px in buf[..info.buffer_size()].chunks_exact(channels) {
+        rgba.extend_from_slice(&match channels {
+            4 => [px[0], px[1], px[2], px[3]],
+            3 => [px[0], px[1], px[2], 255],
+            2 => [px[0], px[0], px[0], px[1]],
+            _ => [px[0], px[0], px[0], 255],
+        });
+    }
+    premultiplied(rgba, info.width, info.height)
+}
+
+/// The icns run-length code: a byte n < 128 is n + 1 literal bytes, n >= 128 repeats the next
+/// byte n - 125 times; `out` bytes are produced.
+pub fn icns_rle(data: &[u8], out: usize) -> Option<Vec<u8>> {
+    let mut v = Vec::with_capacity(out);
+    let mut i = 0;
+    while v.len() < out {
+        let n = *data.get(i)? as usize;
+        i += 1;
+        if n < 128 {
+            v.extend_from_slice(data.get(i..i + n + 1)?);
+            i += n + 1;
+        } else {
+            let b = *data.get(i)?;
+            i += 1;
+            v.extend(std::iter::repeat_n(b, n - 125));
+        }
+    }
+    v.truncate(out);
+    Some(v)
+}
+
+/// One image of an .icns file: the entry nearest `want` pixels that decodes (the smallest at
+/// least that large, else the largest).
+pub fn decode_icns(bytes: &[u8], want: u32) -> Option<Pixmap> {
+    const SIG: &[u8] = b"\x89PNG\r\n\x1a\n";
+    if bytes.len() < 8 || &bytes[..4] != b"icns" {
+        return None;
+    }
+    let mut entries: Vec<([u8; 4], &[u8])> = Vec::new();
+    let mut i = 8usize;
+    while i + 8 <= bytes.len() {
+        let kind: [u8; 4] = bytes[i..i + 4].try_into().ok()?;
+        let size = u32::from_be_bytes(bytes[i + 4..i + 8].try_into().ok()?) as usize;
+        if size < 8 || i + size > bytes.len() {
+            break;
+        }
+        entries.push((kind, &bytes[i + 8..i + size]));
+        i += size;
+    }
+    let mask = |kind: &[u8; 4]| entries.iter().find(|(k, _)| k == kind).map(|(_, d)| *d);
+    // (pixel size, decoder)
+    let mut candidates: Vec<(u32, Box<dyn Fn() -> Option<Pixmap> + '_>)> = Vec::new();
+    for (kind, data) in &entries {
+        let data: &[u8] = data;
+        if data.starts_with(SIG) && data.len() > 24 {
+            let w = u32::from_be_bytes(data[16..20].try_into().ok()?);
+            candidates.push((w, Box::new(move || decode_png(data))));
+            continue;
+        }
+        let rle = match kind {
+            b"is32" => Some((16, b"s8mk", 0)),
+            b"il32" => Some((32, b"l8mk", 0)),
+            b"ih32" => Some((48, b"h8mk", 0)),
+            b"it32" => Some((128, b"t8mk", 4)),
+            _ => None,
+        };
+        if let Some((w, mask_kind, skip)) = rle {
+            let alpha = mask(mask_kind);
+            candidates.push((w, Box::new(move || {
+                let n = (w * w) as usize;
+                let rgb = if data.len() == n * 4 { data.chunks_exact(4).flat_map(|p| [p[1], p[2], p[3]]).collect::<Vec<u8>>() } else { icns_rle(data.get(skip..)?, n * 3)? };
+                let alpha = alpha.filter(|a| a.len() >= n);
+                let mut rgba = Vec::with_capacity(n * 4);
+                for p in 0..n {
+                    let a = alpha.map_or(255, |a| a[p]);
+                    if data.len() == n * 4 {
+                        rgba.extend_from_slice(&[rgb[p * 3], rgb[p * 3 + 1], rgb[p * 3 + 2], a]);
+                    } else {
+                        rgba.extend_from_slice(&[rgb[p], rgb[n + p], rgb[2 * n + p], a]);
+                    }
+                }
+                premultiplied(rgba, w, w)
+            })));
+            continue;
+        }
+        let argb = match kind {
+            b"ic04" => Some(16),
+            b"ic05" => Some(32),
+            _ => None,
+        };
+        if let Some(w) = argb.filter(|_| data.starts_with(b"ARGB")) {
+            candidates.push((w, Box::new(move || {
+                let n = (w * w) as usize;
+                let planes = icns_rle(&data[4..], n * 4)?;
+                let mut rgba = Vec::with_capacity(n * 4);
+                for p in 0..n {
+                    rgba.extend_from_slice(&[planes[n + p], planes[2 * n + p], planes[3 * n + p], planes[p]]);
+                }
+                premultiplied(rgba, w, w)
+            })));
+        }
+    }
+    candidates.sort_by_key(|(w, _)| if *w >= want { (0, *w as i64) } else { (1, -(*w as i64)) });
+    candidates.into_iter().find_map(|(_, decode)| decode())
+}
+
+fn rounded(x: f32, y: f32, w: f32, h: f32, r: f32) -> Option<tiny_skia::Path> {
+    let r = r.min(w / 2.0).min(h / 2.0);
+    let k = 0.552_284_8 * r;
+    let mut p = PathBuilder::new();
+    p.move_to(x + r, y);
+    p.line_to(x + w - r, y);
+    p.cubic_to(x + w - r + k, y, x + w, y + r - k, x + w, y + r);
+    p.line_to(x + w, y + h - r);
+    p.cubic_to(x + w, y + h - r + k, x + w - r + k, y + h, x + w - r, y + h);
+    p.line_to(x + r, y + h);
+    p.cubic_to(x + r - k, y + h, x, y + h - r + k, x, y + h - r);
+    p.line_to(x, y + r);
+    p.cubic_to(x, y + r - k, x + r - k, y, x + r, y);
+    p.close();
+    p.finish()
+}
+fn fill(p: &mut Pixmap, path: Option<tiny_skia::Path>, rgba: [u8; 4]) {
+    if let Some(path) = path {
+        let mut paint = Paint::default();
+        paint.set_color_rgba8(rgba[0], rgba[1], rgba[2], rgba[3]);
+        paint.anti_alias = true;
+        p.fill_path(&path, &paint, FillRule::Winding, Transform::identity(), None);
+    }
+}
+
+/// The icons drawn here (no file): `chonkstep-terminal` (the desktop's terminal) and
+/// `application` (any window whose application has no icon).
+pub fn drawn(name: &str, size: u32) -> Option<Pixmap> {
+    let size = size.max(16);
+    let s = size as f32;
+    let mut p = Pixmap::new(size, size)?;
+    match name {
+        "chonkstep-terminal" => {
+            // a squircle body, a title strip with three lamps, a dark screen, a green prompt
+            let m = s * 0.06;
+            fill(&mut p, rounded(m, m, s - 2.0 * m, s - 2.0 * m, s * 0.2), [70, 76, 88, 255]);
+            fill(&mut p, rounded(m + s * 0.035, m + s * 0.035, s - 2.0 * m - s * 0.07, s - 2.0 * m - s * 0.07, s * 0.17), [22, 24, 30, 255]);
+            fill(&mut p, rounded(m + s * 0.035, m + s * 0.035, s - 2.0 * m - s * 0.07, s * 0.16, s * 0.08), [52, 56, 66, 255]);
+            for (i, rgb) in [[255, 95, 86], [255, 189, 46], [39, 201, 63]].iter().enumerate() {
+                fill(&mut p, PathBuilder::from_circle(m + s * (0.13 + 0.075 * i as f32), m + s * 0.115, s * 0.025), [rgb[0], rgb[1], rgb[2], 255]);
+            }
+            let mut paint = Paint::default();
+            paint.set_color(Color::from_rgba8(110, 235, 130, 255));
+            paint.anti_alias = true;
+            let stroke = Stroke { width: (s * 0.065).max(1.5), line_cap: tiny_skia::LineCap::Round, line_join: tiny_skia::LineJoin::Round, ..Stroke::default() };
+            let mut chevron = PathBuilder::new();
+            chevron.move_to(s * 0.26, s * 0.42);
+            chevron.line_to(s * 0.42, s * 0.55);
+            chevron.line_to(s * 0.26, s * 0.68);
+            if let Some(path) = chevron.finish() {
+                p.stroke_path(&path, &paint, &stroke, Transform::identity(), None);
+            }
+            let mut line = PathBuilder::new();
+            line.move_to(s * 0.50, s * 0.70);
+            line.line_to(s * 0.72, s * 0.70);
+            if let Some(path) = line.finish() {
+                p.stroke_path(&path, &paint, &stroke, Transform::identity(), None);
+            }
+        }
+        "application" => {
+            let m = s * 0.08;
+            fill(&mut p, rounded(m, m, s - 2.0 * m, s - 2.0 * m, s * 0.18), [120, 128, 150, 255]);
+            fill(&mut p, rounded(m + s * 0.1, m + s * 0.16, s - 2.0 * m - s * 0.2, s - 2.0 * m - s * 0.28, s * 0.06), [235, 238, 245, 255]);
+            fill(&mut p, rounded(m + s * 0.1, m + s * 0.16, s - 2.0 * m - s * 0.2, s * 0.1, s * 0.05), [80, 120, 220, 255]);
+        }
+        _ => return None,
+    }
+    Some(p)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn png(w: u32) -> Vec<u8> {
+        let mut out = Vec::new();
+        {
+            let mut e = png::Encoder::new(&mut out, w, w);
+            e.set_color(png::ColorType::Rgba);
+            let mut writer = e.write_header().unwrap();
+            writer.write_image_data(&vec![200u8; (w * w * 4) as usize]).unwrap();
+        }
+        out
+    }
+    fn icns(entries: &[(&[u8; 4], Vec<u8>)]) -> Vec<u8> {
+        let mut icns = b"icns\0\0\0\0".to_vec();
+        for (kind, data) in entries {
+            icns.extend_from_slice(*kind);
+            icns.extend_from_slice(&((data.len() + 8) as u32).to_be_bytes());
+            icns.extend_from_slice(data);
+        }
+        let n = icns.len() as u32;
+        icns[4..8].copy_from_slice(&n.to_be_bytes());
+        icns
+    }
+    #[test]
+    fn the_png_nearest_the_size_asked_for_is_taken() {
+        let file = icns(&[(b"ic07", png(128)), (b"ic08", png(256)), (b"ic09", png(512))]);
+        assert_eq!(decode_icns(&file, 200).unwrap().width(), 256);
+        assert_eq!(decode_icns(&file, 1000).unwrap().width(), 512);
+        assert_eq!(decode_icns(&file, 16).unwrap().width(), 128);
+        assert!(decode_icns(b"nope", 16).is_none());
+    }
+    #[test]
+    fn rle_images_and_their_masks_and_argb_decode() {
+        // 16x16: red plane a run of 256 x 0xff (two runs: 130 + 126), green/blue literal 0
+        let n = 256usize;
+        let mut planes = Vec::new();
+        let run = |v: &mut Vec<u8>, count: usize, b: u8| { let mut left = count; while left > 0 { let c = left.min(130).max(3); v.push((c + 125) as u8); v.push(b); left -= c; } };
+        run(&mut planes, n, 0xff);
+        run(&mut planes, n, 0x00);
+        run(&mut planes, n, 0x10);
+        let mask = vec![128u8; n];
+        let file = icns(&[(b"is32", planes.clone()), (b"s8mk", mask)]);
+        let image = decode_icns(&file, 16).unwrap();
+        let px = image.pixel(3, 3).unwrap();
+        assert_eq!((px.alpha(), px.red(), px.green()), (128, 128, 0));
+        // ARGB: alpha 255, red 0, green 255, blue 0
+        let mut argb = b"ARGB".to_vec();
+        run(&mut argb, n, 255);
+        run(&mut argb, n, 0);
+        run(&mut argb, n, 255);
+        run(&mut argb, n, 0);
+        let image = decode_icns(&icns(&[(b"ic04", argb)]), 16).unwrap();
+        let px = image.pixel(0, 0).unwrap();
+        assert_eq!((px.alpha(), px.red(), px.green(), px.blue()), (255, 0, 255, 0));
+        assert_eq!(icns_rle(&[2, 1, 2, 3, 130, 9], 8).unwrap(), vec![1, 2, 3, 9, 9, 9, 9, 9]);
+    }
+    #[test]
+    fn the_drawn_icons_draw() {
+        let t = drawn("chonkstep-terminal", 64).unwrap();
+        assert!(t.pixels().iter().any(|p| p.green() > 150 && p.red() < 150));
+        assert!(drawn("application", 32).is_some());
+        assert!(drawn("unknown", 32).is_none());
+        assert!(icon_named("chonkstep-terminal", 48).is_some_and(|i| i.width() == 48));
+        assert_eq!(enclosing_bundle(Path::new("/Applications/Utilities/Terminal.app/Contents/MacOS/Terminal")), Some(PathBuf::from("/Applications/Utilities/Terminal.app")));
+    }
+}
