+/// TERM's Exit Full Screen (requests-for-DESK, 4.1 and 5.2): the client acknowledges the
+/// configure that gives it its old size back but commits once more a buffer of the full-screen
+/// size. That buffer must not be adopted as the size the client wants (on the M1 the adopted
+/// size, cut to the work area, was configured back to it: the window stayed nearly full screen).
+#[test]
+fn a_stale_full_screen_buffer_after_exit_is_not_adopted() {
+    let (h, connection) = Harness::sized(false, 320, 240, 15);
+    let mut queue = connection.new_event_queue();
+    let qh = queue.handle();
+    let mut c = Client::default();
+    connection.display().get_registry(&qh, ());
+    for _ in 0..3 { queue.roundtrip(&mut c).unwrap(); }
+    let surface = c.compositor.as_ref().unwrap().create_surface(&qh, ());
+    let xdg = c.shell.as_ref().unwrap().get_xdg_surface(&surface, &qh, ());
+    let top = xdg.get_toplevel(&qh, ());
+    let decor = c.decoration.as_ref().unwrap().get_toplevel_decoration(&top, &qh, ());
+    decor.set_mode(zxdg_toplevel_decoration_v1::Mode::ServerSide);
+    top.set_title("Full screen and back".into());
+    surface.commit();
+    queue.roundtrip(&mut c).unwrap();
+    let file = tempfile::tempfile().unwrap();
+    file.set_len(320 * 240 * 4).unwrap();
+    let pool = c.shm.as_ref().unwrap().create_pool(file.as_fd(), 320 * 240 * 4, &qh, ());
+    let present = |c: &mut Client, queue: &mut wayland_client::EventQueue<Client>, size: (i32, i32)| {
+        let buffer = pool.create_buffer(0, size.0, size.1, size.0 * 4, wl_shm::Format::Xrgb8888, &qh, ());
+        surface.attach(Some(&buffer), 0, 0);
+        surface.damage_buffer(0, 0, size.0, size.1);
+        surface.commit();
+        queue.roundtrip(c).unwrap();
+    };
+    present(&mut c, &mut queue, (120, 70));
+    for _ in 0..3 { queue.roundtrip(&mut c).unwrap(); thread::sleep(Duration::from_millis(5)); }
+    assert_eq!(h.snapshot().content.unwrap().size, Size::new(120, 70));
+    top.set_fullscreen(None);
+    for _ in 0..4 { queue.roundtrip(&mut c).unwrap(); thread::sleep(Duration::from_millis(5)); }
+    let full = *c.configured_sizes.last().unwrap();
+    assert_eq!(full, (320, 240), "configures: {:?}", c.configured_sizes);
+    present(&mut c, &mut queue, full);
+    for _ in 0..3 { queue.roundtrip(&mut c).unwrap(); thread::sleep(Duration::from_millis(5)); }
+    assert_eq!(h.snapshot().content.unwrap().size, Size::new(320, 240));
+    let before = c.configured_sizes.len();
+    top.unset_fullscreen();
+    for _ in 0..4 { queue.roundtrip(&mut c).unwrap(); thread::sleep(Duration::from_millis(5)); }
+    let back = *c.configured_sizes.last().unwrap();
+    assert_eq!(back, (120, 70), "configures after exit: {:?}", &c.configured_sizes[before..]);
+    // the stale frame, drawn before the client caught up
+    present(&mut c, &mut queue, full);
+    for _ in 0..4 { queue.roundtrip(&mut c).unwrap(); thread::sleep(Duration::from_millis(10)); }
+    assert_eq!(h.snapshot().content.unwrap().size, Size::new(120, 70), "the stale full-screen buffer was adopted");
+    present(&mut c, &mut queue, back);
+    for _ in 0..4 { queue.roundtrip(&mut c).unwrap(); thread::sleep(Duration::from_millis(10)); }
+    assert_eq!(h.snapshot().content.unwrap().size, Size::new(120, 70));
+    let later = &c.configured_sizes[before..];
+    assert!(later.iter().all(|s| *s == (120, 70) || *s == (0, 0)), "configured again after the exit: {later:?}");
+}
