+    /// Applications whose id names no bundle, by the bundle their process runs from.
+    pid_bundles: HashMap<String, PathBuf>,
+    /// An application just opened by the launcher or its dock tile: its first window gets the
+    /// focus when it comes (macOS brings a launched application forward).
+    launching: Option<(String, Instant)>,
