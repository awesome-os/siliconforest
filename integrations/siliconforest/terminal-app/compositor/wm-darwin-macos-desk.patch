+pub fn parse_record(line: &str) -> Option<RecordRequest> {
+    let rest = line.strip_prefix("record ")?;
+    let (target, rest) = if let Some(r) = rest.strip_prefix("screen ") {
+        (None, r)
+    } else {
+        let r = rest.strip_prefix("rect ")?;
+        let mut it = r.splitn(5, ' ');
+        let (x, y, w, h) = (it.next()?.parse().ok()?, it.next()?.parse().ok()?, it.next()?.parse::<u32>().ok()?, it.next()?.parse::<u32>().ok()?);
+        if w < 16 || h < 16 {
+            return None;
+        }
+        (Some(Rect::new(Point::new(x, y), Size::new(w, h))), it.next()?)
+    };
+    let mut it = rest.splitn(3, ' ');
+    let full = match it.next()? {
+        "full" => true,
+        "points" => false,
+        _ => return None,
+    };
+    let seconds = it.next()?.parse::<u32>().ok()?.min(24 * 3600);
+    let path = match it.next()?.trim_end() {
+        "-" => None,
+        p if p.starts_with('/') && !p.split('/').any(|c| c == "..") => Some(PathBuf::from(p)),
+        _ => return None,
+    };
+    Some(RecordRequest { target, full, seconds, path })
+}
