+#[derive(Default)]
+struct Catalog {
+    read: Option<Instant>,
+    bundles: Vec<Bundle>,
+    items: Vec<DesktopItem>,
+}
+
+/// `<key>K</key> <string>V</string>` in an XML property list.
+fn plist_string(text: &str, key: &str) -> Option<String> {
+    let at = text.find(&format!("<key>{key}</key>"))?;
+    let rest = &text[at..];
+    let open = rest.find("<string>")?;
+    let close = rest.find("</string>")?;
+    (open < close).then(|| rest[open + 8..close].trim().to_string())
+}
+
+impl Catalog {
+    fn refresh(&mut self) {
+        if self.read.is_some_and(|at| at.elapsed() < Duration::from_secs(5)) {
+            return;
+        }
+        self.read = Some(Instant::now());
+        self.bundles = crate::settings::applications_in(&crate::settings::APPLICATION_DIRS)
+            .into_iter()
+            .filter_map(|path| {
+                let text = std::fs::read_to_string(path.join("Contents/Info.plist")).ok()?;
+                let id = plist_string(&text, "CFBundleIdentifier")?;
+                let name = path.file_stem()?.to_string_lossy().into_owned();
+                Some(Bundle { id, name, path })
+            })
+            .collect();
+        self.items = std::fs::read_dir("/usr/share/applications")
+            .into_iter()
+            .flatten()
+            .flatten()
+            .filter(|e| e.path().extension().is_some_and(|x| x == "desktop"))
+            .filter_map(|e| {
+                let text = std::fs::read_to_string(e.path()).ok()?;
+                let field = |k: &str| text.lines().find_map(|l| l.strip_prefix(&format!("{k}=")).map(|v| v.trim().to_string()));
+                Some(DesktopItem { name: field("Name")?, class: field("StartupWMClass"), exec: field("Exec").unwrap_or_default(), icon: field("Icon") })
+            })
+            .collect();
+        self.items.sort_by(|a, b| a.name.cmp(&b.name));
+    }
+    fn bundle(&self, app_id: &str) -> Option<&Bundle> {
+        self.bundles.iter().find(|b| b.id.eq_ignore_ascii_case(app_id))
+    }
+    fn name(&self, app_id: &str) -> String {
+        if let Some(b) = self.bundle(app_id) {
+            return b.name.clone();
+        }
+        if let Some(item) = self.items.iter().find(|i| i.class.as_deref().is_some_and(|c| c.eq_ignore_ascii_case(app_id))) {
+            return item.name.clone();
+        }
+        if app_id.is_empty() { "Window".into() } else { app_id.to_string() }
+    }
+}
+
+/// A process's executable (proc_pidpath).
+#[cfg(target_os = "macos")]
+pub fn pid_path(pid: i32) -> Option<PathBuf> {
+    let mut buf = vec![0u8; 4096];
+    let n = unsafe { libc::proc_pidpath(pid, buf.as_mut_ptr().cast(), buf.len() as u32) };
+    (n > 0).then(|| PathBuf::from(String::from_utf8_lossy(&buf[..n as usize]).into_owned()))
+}
+#[cfg(not(target_os = "macos"))]
+pub fn pid_path(pid: i32) -> Option<PathBuf> {
+    std::fs::read_link(format!("/proc/{pid}/exe")).ok()
+}
+
+fn rounded(x: f32, y: f32, w: f32, h: f32, r: f32) -> Option<tiny_skia::Path> {
+    let r = r.min(w / 2.0).min(h / 2.0);
+    let k = 0.552_284_8 * r;
+    let mut p = PathBuilder::new();
+    p.move_to(x + r, y);
+    p.line_to(x + w - r, y);
+    p.cubic_to(x + w - r + k, y, x + w, y + r - k, x + w, y + r);
+    p.line_to(x + w, y + h - r);
+    p.cubic_to(x + w, y + h - r + k, x + w - r + k, y + h, x + w - r, y + h);
+    p.line_to(x + r, y + h);
+    p.cubic_to(x + r - k, y + h, x, y + h - r + k, x, y + h - r);
+    p.line_to(x, y + r);
+    p.cubic_to(x, y + r - k, x + r - k, y, x + r, y);
+    p.close();
+    p.finish()
+}
+
+pub(crate) fn fill_rounded(p: &mut Pixmap, r: Rect, radius: f32, rgba: [u8; 4]) {
+    if let Some(path) = rounded(r.pos.x as f32, r.pos.y as f32, r.size.w as f32, r.size.h as f32, radius) {
+        let mut paint = Paint::default();
+        paint.set_color_rgba8(rgba[0], rgba[1], rgba[2], rgba[3]);
+        paint.anti_alias = true;
+        p.fill_path(&path, &paint, FillRule::Winding, Transform::identity(), None);
+    }
+}
+
+pub(crate) fn draw_icon(p: &mut Pixmap, icon: &Pixmap, at: Rect) {
+    let sx = at.size.w as f32 / icon.width() as f32;
+    let sy = at.size.h as f32 / icon.height() as f32;
+    let paint = PixmapPaint { quality: tiny_skia::FilterQuality::Bicubic, ..PixmapPaint::default() };
+    p.draw_pixmap(0, 0, icon.as_ref(), &paint, Transform::from_row(sx, 0.0, 0.0, sy, at.pos.x as f32, at.pos.y as f32), None);
+}
+
+fn magnifier(p: &mut Pixmap, at: Point, size: f32, rgba: [u8; 4]) {
+    let mut paint = Paint::default();
+    paint.set_color_rgba8(rgba[0], rgba[1], rgba[2], rgba[3]);
+    paint.anti_alias = true;
+    let mut stroke = Stroke::default();
+    stroke.width = (size * 0.12).max(1.0);
+    stroke.line_cap = tiny_skia::LineCap::Round;
+    let (x, y) = (at.x as f32, at.y as f32);
+    if let Some(circle) = PathBuilder::from_circle(x + size * 0.42, y + size * 0.42, size * 0.30) {
+        p.stroke_path(&circle, &paint, &stroke, Transform::identity(), None);
+    }
+    let mut handle = PathBuilder::new();
+    handle.move_to(x + size * 0.64, y + size * 0.64);
+    handle.line_to(x + size * 0.90, y + size * 0.90);
+    if let Some(path) = handle.finish() {
+        p.stroke_path(&path, &paint, &stroke, Transform::identity(), None);
+    }
+}
+
+pub(crate) fn to_buffer(p: Pixmap) -> DecorationBuffer {
+    DecorationBuffer { width: p.width(), height: p.height(), pixels: p.take() }
+}
+
+/// What the launcher opens.
