diff --git a/dock/crates/chonk-dock-theme/src/techclock.rs b/dock/crates/chonk-dock-theme/src/techclock.rs
new file mode 100644
index 0000000..25fa810
--- /dev/null
+++ b/dock/crates/chonk-dock-theme/src/techclock.rs
@@ -0,0 +1,78 @@
+//! The dock's digital clock (SiliconForest): an instrument of the same family as the CPU/MEM
+//! and NET tiles — the theme's tile face, the recessed glass, the theme's LED ink over ghost
+//! segments — reading `HH:MM` large across the glass, the colon blinking with the seconds, and
+//! the date in the tile's lettering strip ("SAT 14"). Every colour, material and font is the
+//! active theme's (`panel::panel_palette`, `tile`), so it changes with the theme like its
+//! neighbours.
+
+use tiny_skia::{Paint, Pixmap, Rect as SkRect, Transform};
+use wm_theme_api::DecorationBuffer;
+
+use crate::model::{FontSpec, FontStyle, FontWeight, TextAlign, Theme};
+use crate::paint;
+use crate::panel;
+use crate::tile;
+
+/// The digital clock tile: `size` square; `date` goes in the strip under the glass.
+#[allow(clippy::too_many_arguments)]
+pub fn render_tech_clock(
+    theme: &Theme,
+    font_system: &mut cosmic_text::FontSystem,
+    swash_cache: &mut cosmic_text::SwashCache,
+    size: u32,
+    hour: u32,
+    minute: u32,
+    second: u32,
+    date: &str,
+) -> DecorationBuffer {
+    let size = size.max(16);
+    let mut pixmap = Pixmap::new(size, size).expect("clock tile size");
+    tile::draw_tile_base(&mut pixmap, 0, 0, size, theme);
+    // the geometry of the CPU/MEM tile: a well over a lettering strip
+    let t = theme.tile.bevel.width.max(1) as i32;
+    let margin = t + (size as i32 / 28).max(1);
+    let strip_h = ((size as f32) * 0.20).round().max(9.0) as i32;
+    let well_w = (size as i32 - margin * 2).max(0) as u32;
+    let well_h = (size as i32 - margin * 2 - strip_h).max(0) as u32;
+    let (gx, gy, gw, gh) = panel::draw_panel_glass(&mut pixmap, margin, margin, well_w, well_h, theme);
+    let pal = panel::panel_palette(theme);
+    // HH and MM, each a pair of digits across almost half the glass, the colon between
+    let pad = ((gw.min(gh)) as f32 * 0.05).round().max(1.0) as i32;
+    let colon_w = ((gw as f32) * 0.10).round().max(3.0) as i32;
+    let half = ((gw as i32 - pad * 2 - colon_w) / 2).max(4);
+    let digits_h = (gh as i32 - pad * 2).max(4);
+    let digits_y = gy + pad + (gh as i32 - pad * 2 - digits_h) / 2;
+    panel::draw_led_digits(&mut pixmap, gx + pad, digits_y, half as u32, digits_h as u32, &pal, &[Some((hour / 10 % 10) as u8), Some((hour % 10) as u8)]);
+    panel::draw_led_digits(&mut pixmap, gx + pad + half + colon_w, digits_y, half as u32, digits_h as u32, &pal, &[Some((minute / 10 % 10) as u8), Some((minute % 10) as u8)]);
+    let dot = ((colon_w as f32) * 0.42).round().max(2.0);
+    let cx = (gx + pad + half) as f32 + (colon_w as f32 - dot) / 2.0;
+    let mut paint = Paint { anti_alias: false, ..Default::default() };
+    paint.set_color(paint::sk_color(if second % 2 == 0 { pal.ink } else { pal.ghost }));
+    for frac in [0.32f32, 0.64] {
+        if let Some(r) = SkRect::from_xywh(cx, digits_y as f32 + digits_h as f32 * frac - dot / 2.0, dot, dot) {
+            pixmap.fill_rect(r, &paint, Transform::identity(), None);
+        }
+    }
+    // the date in the strip, in the tile's ink and the theme's menu face (as "CPU MEM")
+    let font = FontSpec { family: theme.menu.item_font.family.clone(), size: (strip_h as f32 * 0.68).max(6.0), weight: FontWeight::Bold, style: FontStyle::Normal };
+    paint::draw_text(&mut pixmap, font_system, swash_cache, date, &font, tile::tile_ink(theme), margin, margin + well_h as i32, well_w, strip_h as u32, TextAlign::Center);
+    DecorationBuffer { width: size, height: size, pixels: pixmap.take() }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn the_digital_clock_draws_in_every_theme() {
+        let mut fs = cosmic_text::FontSystem::new();
+        let mut sc = cosmic_text::SwashCache::new();
+        for theme in crate::default_theme::all_themes() {
+            for size in [56u32, 112] {
+                let a = render_tech_clock(&theme, &mut fs, &mut sc, size, 9, 41, 7, "SAT 14");
+                assert_eq!((a.width, a.height), (size, size));
+                let b = render_tech_clock(&theme, &mut fs, &mut sc, size, 9, 42, 7, "SAT 14");
+                assert_ne!(a.pixels, b.pixels, "{}: the minute shows", theme.id);
+            }
+        }
+    }
+}
