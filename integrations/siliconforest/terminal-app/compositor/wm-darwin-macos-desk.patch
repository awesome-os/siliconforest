+/// The clock, kept as the person left it (digital or analog) in the dock's state directory.
+pub struct PersistedClock {
+    inner: ClockWidget,
+}
+
+fn clock_file() -> Option<std::path::PathBuf> {
+    crate::startup::state_file("dock-clock")
+}
+
+impl PersistedClock {
+    pub fn new() -> Self {
+        let style = clock_file()
+            .and_then(|path| std::fs::read_to_string(path).ok())
+            .and_then(|text| ClockStyle::from_name(&text))
+            .unwrap_or(ClockStyle::Digital);
+        Self { inner: ClockWidget::with_style(style) }
+    }
+}
+
+impl Default for PersistedClock {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// "SAT 14", local time (the clock tile's strip).
+fn date_line() -> String {
+    let now = unsafe { libc::time(std::ptr::null_mut()) };
+    let mut tm: libc::tm = unsafe { std::mem::zeroed() };
+    unsafe { libc::localtime_r(&now, &mut tm) };
+    const DAYS: [&str; 7] = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];
+    const MONTHS: [&str; 12] = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
+    let _ = MONTHS;
+    format!("{} {}", DAYS[tm.tm_wday.clamp(0, 6) as usize], tm.tm_mday)
+}
+
+impl DockWidget for PersistedClock {
+    fn name(&self) -> &str {
+        self.inner.name()
+    }
+    fn sources(&self) -> Vec<Source> {
+        self.inner.sources()
+    }
+    fn bind(&mut self, ids: &[SourceId]) {
+        self.inner.bind(ids);
+    }
+    fn update(&mut self, samples: &Samples) -> bool {
+        let date = self.inner.set_date(&date_line());
+        self.inner.update(samples) || date
+    }
+    fn render(&self, theme: &wm_theme::Theme, tile: u32, fonts: &mut cosmic_text::FontSystem, swash: &mut cosmic_text::SwashCache) -> wm_theme_api::DecorationBuffer {
+        self.inner.render(theme, tile, fonts, swash)
+    }
+    fn on_input(&mut self, input: DockInput, _tile: u32) -> Vec<Effect> {
+        if let DockInput::Press { .. } = input {
+            let style = self.inner.toggle_style();
+            // written off the dock's UI thread (a disk write can take longer than a frame)
+            if let Some(path) = clock_file() {
+                std::thread::spawn(move || {
+                    if let Some(dir) = path.parent() {
+                        let _ = std::fs::create_dir_all(dir);
+                    }
+                    let _ = std::fs::write(path, style.name());
+                });
+            }
+            tracing::info!(style = style.name(), "clock face");
+            return vec![Effect::Repaint];
+        }
+        Vec::new()
+    }
+}
