+/// TERM, 5.1: a minimised window's tile on the desk goes when its client goes.
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn a_minimised_windows_tile_goes_with_its_client() {
+    let (h, a) = Harness::sized(true, 640, 480, 15);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let settle = || { for _ in 0..10 { h.snapshot(); thread::sleep(Duration::from_millis(10)); } };
+    settle();
+    let (other, b) = UnixStream::pair().unwrap();
+    h.tx.send(Request::AddClient(other)).unwrap();
+    let second = Connection::from_socket(b).unwrap();
+    let (mut qa, mut ca, _sa, _xa, _ta) = map_client(&a, "stays");
+    let (mut qb, mut cb, _sb, _xb, tb) = map_client(&second, "goes");
+    settle();
+    let shells_before = h.snapshot().shells;
+    tb.set_minimized();
+    qb.roundtrip(&mut cb).unwrap();
+    settle();
+    let shells_minimised = h.snapshot().shells;
+    assert!(shells_minimised > shells_before, "a tile for the minimised window: {shells_before} -> {shells_minimised}");
+    drop((qb, cb, _sb, _xb, tb));
+    drop(second);
+    settle();
+    qa.roundtrip(&mut ca).unwrap();
+    settle();
+    let after = h.snapshot();
+    assert_eq!(after.shells, shells_before, "the tile stayed after its client went");
+    assert_eq!(after.managed, 1);
+}
