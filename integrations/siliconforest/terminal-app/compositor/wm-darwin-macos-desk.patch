+//! macOS's own parts of the desk (the owner, 14 November: "I want the muscle memory to be
+//! macOS"):
+//! - the running applications as macOS's Command-Tab and Dock know them: every application with
+//!   a window, and an AppKit application that runs without one (it hid itself with Command-H, or
+//!   closed its last window), with its bundle's name and icon;
+//! - the application switcher: Command-Tab / Command-Shift-Tab with Command held; Tab, Shift-Tab,
+//!   the arrows and ` step, Q quits the selected application, Escape cancels, releasing Command
+//!   switches to it;
+//! - the launcher on Command-Space (Spotlight's place): type, Up/Down, Return opens the
+//!   application or brings it forward, Escape clears and closes;
+//! - Force Quit Applications on Command-Option-Escape (Return, and Return again to confirm).
+//!
+//! An AppKit application without windows comes back as the Dock brings it back on this system:
+//! AppKit listens for the notify(3) name `org.siliconforest.appkit.reopen` whose state is the pid
+//! asked for, and then unhides itself or opens its untitled window (`-[NSApplication _reopen]`).
+//! The compositor starts no program: an application that is not running is opened through the
+//! session's pipe (`settings::request_open`), as the desktop menu's Applications rows are.
+use crate::server::Server;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+use tiny_skia::{FillRule, Paint, PathBuilder, Pixmap, PixmapPaint, Stroke, Transform};
+use wm_core::{Backend, ClientId, Point, Rect, Size};
+use wm_theme_api::DecorationBuffer;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct App {
+    /// The application id in lower case (what groups windows into an application).
+    pub key: String,
+    pub app_id: String,
+    pub name: String,
+    pub bundle: Option<PathBuf>,
+    /// Its managed windows, the most recently used first.
+    pub clients: Vec<ClientId>,
+    pub pids: Vec<i32>,
+    /// An application bundle's (AppKit): it can run without windows.
+    pub mac: bool,
+}
+
+#[derive(Clone, Debug)]
+struct Bundle {
+    id: String,
+    name: String,
+    path: PathBuf,
+}
+
+#[derive(Clone, Debug)]
+struct DesktopItem {
+    name: String,
+    class: Option<String>,
+    exec: String,
+    icon: Option<String>,
+}
