diff --git a/dock/crates/chonk-dock/src/siliconforest.rs b/dock/crates/chonk-dock/src/siliconforest.rs
new file mode 100644
index 0000000..e6eff71
--- /dev/null
+++ b/dock/crates/chonk-dock/src/siliconforest.rs
@@ -0,0 +1,252 @@
+//! The dock's right-hand column on SiliconForest (the Darwin build; the Linux dock keeps its own):
+//! the SiliconForest mark at the top, then CPU/MEM, NET and the clock — nothing else (no sound,
+//! link, Bluetooth or power tile, no Clip: the desk has no control socket to feed it). The clock
+//! is digital by default; a click on it switches digital <-> analog, kept in
+//! `$XDG_STATE_HOME/chonkstep/dock-clock` ("digital" or "analog").
+//!
+//! The mark is drawn here (no image file): a conifer of three circuit-trace tiers with vias at
+//! their tips on a trunk trace that ends in a row of chip pads, light on a dark badge. A first
+//! draft for the owner to judge; the same geometry is in
+//! `integrations/siliconforest/desktop/branding/siliconforest-mark.svg` of the lab repository.
+use tiny_skia::{FillRule, LineCap, LineJoin, Paint, PathBuilder, Pixmap, Stroke, Transform};
+
+use crate::widgets::*;
+
+const BADGE: [u8; 3] = [0x0d, 0x1a, 0x15];
+const TRACE: [u8; 3] = [0xa6, 0xf2, 0xc8];
+
+fn paint(rgb: [u8; 3], alpha: u8) -> Paint<'static> {
+    let mut p = Paint::default();
+    p.set_color_rgba8(rgb[0], rgb[1], rgb[2], alpha);
+    p.anti_alias = true;
+    p
+}
+
+/// The SiliconForest mark, `size` square (transparent outside its badge).
+pub fn mark(size: u32) -> Pixmap {
+    mark_in(size, Some(BADGE), TRACE, BADGE)
+}
+
+/// The mark's drawing: on a badge of `badge` (none: transparent), traces in `trace`, the vias'
+/// holes in `hole`.
+pub fn mark_in(size: u32, badge: Option<[u8; 3]>, trace_rgb: [u8; 3], hole_rgb: [u8; 3]) -> Pixmap {
+    let size = size.max(16);
+    let s = size as f32;
+    let mut p = Pixmap::new(size, size).expect("mark size");
+    // the badge: a rounded square
+    let (m, r) = (s * 0.04, s * 0.2);
+    let (x0, y0, x1, y1) = (m, m, s - m, s - m);
+    let k = 0.552_284_8 * r;
+    let mut b = PathBuilder::new();
+    b.move_to(x0 + r, y0);
+    b.line_to(x1 - r, y0);
+    b.cubic_to(x1 - r + k, y0, x1, y0 + r - k, x1, y0 + r);
+    b.line_to(x1, y1 - r);
+    b.cubic_to(x1, y1 - r + k, x1 - r + k, y1, x1 - r, y1);
+    b.line_to(x0 + r, y1);
+    b.cubic_to(x0 + r - k, y1, x0, y1 - r + k, x0, y1 - r);
+    b.line_to(x0, y0 + r);
+    b.cubic_to(x0, y0 + r - k, x0 + r - k, y0, x0 + r, y0);
+    b.close();
+    if let (Some(path), Some(badge)) = (b.finish(), badge) {
+        p.fill_path(&path, &paint(badge, 255), FillRule::Winding, Transform::identity(), None);
+    }
+    let stroke = Stroke { width: (s * 0.055).max(1.6), line_cap: LineCap::Round, line_join: LineJoin::Round, ..Stroke::default() };
+    let trace = paint(trace_rgb, 255);
+    // the trunk
+    let cx = s * 0.5;
+    let mut trunk = PathBuilder::new();
+    trunk.move_to(cx, s * 0.17);
+    trunk.line_to(cx, s * 0.80);
+    if let Some(path) = trunk.finish() {
+        p.stroke_path(&path, &trace, &stroke, Transform::identity(), None);
+    }
+    // three tiers: chevrons from the trunk, a via at each tip
+    let via = (s * 0.045).max(1.6);
+    for (apex, foot, half) in [(0.17f32, 0.36f32, 0.17f32), (0.33, 0.55, 0.25), (0.50, 0.74, 0.33)] {
+        let mut tier = PathBuilder::new();
+        tier.move_to(cx - s * half, s * foot);
+        tier.line_to(cx, s * apex);
+        tier.line_to(cx + s * half, s * foot);
+        if let Some(path) = tier.finish() {
+            p.stroke_path(&path, &trace, &stroke, Transform::identity(), None);
+        }
+        for side in [-1.0f32, 1.0] {
+            if let Some(dot) = PathBuilder::from_circle(cx + side * s * half, s * foot, via) {
+                p.fill_path(&dot, &trace, FillRule::Winding, Transform::identity(), None);
+            }
+            if let Some(hole_path) = PathBuilder::from_circle(cx + side * s * half, s * foot, via * 0.45) {
+                p.fill_path(&hole_path, &paint(hole_rgb, 255), FillRule::Winding, Transform::identity(), None);
+            }
+        }
+    }
+    // the chip edge with its pads
+    let mut base = PathBuilder::new();
+    base.move_to(s * 0.30, s * 0.84);
+    base.line_to(s * 0.70, s * 0.84);
+    if let Some(path) = base.finish() {
+        p.stroke_path(&path, &trace, &stroke, Transform::identity(), None);
+    }
+    for x in [0.34f32, 0.5, 0.66] {
+        if let Some(rect) = tiny_skia::Rect::from_xywh(s * x - s * 0.03, s * 0.865, s * 0.06, s * 0.05) {
+            p.fill_rect(rect, &trace, Transform::identity(), None);
