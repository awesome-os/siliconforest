+/// The column's first tile: the theme's tile face and glass (the instruments' screen), the mark
+/// in the theme's LED ink on it — the logo is one of the set in every theme.
+pub fn logo_tile(theme: &wm_theme::Theme, size: u32) -> Pixmap {
+    use wm_theme::{panel, paint as tpaint, tile};
+    let size = size.max(16);
+    let mut p = Pixmap::new(size, size).expect("logo tile size");
+    tile::draw_tile_base(&mut p, 0, 0, size, theme);
+    let t = theme.tile.bevel.width.max(1) as i32;
+    let margin = t + (size as i32 / 28).max(1);
+    let well = (size as i32 - margin * 2).max(4) as u32;
+    let (gx, gy, gw, gh) = panel::draw_panel_glass(&mut p, margin, margin, well, well, theme);
+    let pal = panel::panel_palette(theme);
+    let to = |c: wm_theme::model::Color| [c.r, c.g, c.b];
+    let side = gw.min(gh);
+    let art = mark_in(side, None, to(pal.ink), to(pal.glass));
+    p.draw_pixmap(gx + (gw - side) as i32 / 2, gy + (gh - side) as i32 / 2, art.as_ref(), &tiny_skia::PixmapPaint::default(), Transform::identity(), None);
+    let _ = tpaint::sk_color;
+    p
+}
