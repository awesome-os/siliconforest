diff --git a/dock/crates/chonk-dock/src/widgets/darwin_proc.rs b/dock/crates/chonk-dock/src/widgets/darwin_proc.rs
new file mode 100644
index 0000000..3a3ce69
--- /dev/null
+++ b/dock/crates/chonk-dock/src/widgets/darwin_proc.rs
@@ -0,0 +1,149 @@
+//! The three Linux files the dock's instruments read, written from Darwin's own counters
+//! (SiliconForest): the instruments keep their parsers, and on Darwin the sampler thread gets
+//! the text from here instead of from a /proc that does not exist.
+//! - `/proc/stat`: the aggregate `cpu` line (and one per core) from `host_processor_info`
+//!   (PROCESSOR_CPU_LOAD_INFO: user, system, idle, nice ticks);
+//! - `/proc/meminfo`: `MemTotal` (sysctl hw.memsize) and `MemAvailable` (free + inactive +
+//!   speculative pages, `host_statistics64` HOST_VM_INFO64);
+//! - `/proc/net/dev`: each interface that is up and not loopback, its byte and packet counters
+//!   from `getifaddrs` (AF_LINK, `if_data`). The counters are what the driver reports: on the
+//!   M1 today en0's receive counters stay 0 in the kernel (the Wi-Fi driver does not count
+//!   them), so the tile shows the transmit rate and whatever receive the kernel has.
+use std::path::Path;
+
+/// `cpu` line(s) of /proc/stat from per-core (user, system, idle, nice) ticks.
+pub fn format_stat(cores: &[[u64; 4]]) -> String {
+    let line = |name: &str, t: [u64; 4]| format!("{name} {} {} {} {} 0 0 0 0\n", t[0], t[3], t[1], t[2]);
+    let mut total = [0u64; 4];
+    for core in cores {
+        for i in 0..4 {
+            total[i] += core[i];
+        }
+    }
+    let mut out = line("cpu", total);
+    for (n, core) in cores.iter().enumerate() {
+        out.push_str(&line(&format!("cpu{n}"), *core));
+    }
+    out
+}
+
+pub fn format_meminfo(total_bytes: u64, available_bytes: u64) -> String {
+    format!("MemTotal: {} kB\nMemAvailable: {} kB\n", total_bytes / 1024, available_bytes.min(total_bytes) / 1024)
+}
+
+/// (name, rx bytes, rx packets, tx bytes, tx packets)
+pub fn format_net_dev(interfaces: &[(String, u64, u64, u64, u64)]) -> String {
+    let mut out = String::from("Inter-|   Receive                                                |  Transmit\n face |bytes    packets errs drop fifo frame compressed multicast|bytes    packets errs drop fifo colls carrier compressed\n");
+    for (name, rxb, rxp, txb, txp) in interfaces {
+        out.push_str(&format!("{name:>6}: {rxb} {rxp} 0 0 0 0 0 0 {txb} {txp} 0 0 0 0 0 0\n"));
+    }
+    out
+}
+
+#[cfg(target_os = "macos")]
+fn cores() -> Option<Vec<[u64; 4]>> {
+    let mut count: libc::natural_t = 0;
+    let mut info: libc::processor_info_array_t = std::ptr::null_mut();
+    let mut info_count: libc::mach_msg_type_number_t = 0;
+    #[allow(deprecated)]
+    let host = unsafe { libc::mach_host_self() };
+    let kr = unsafe { libc::host_processor_info(host, libc::PROCESSOR_CPU_LOAD_INFO, &mut count, &mut info, &mut info_count) };
+    if kr != 0 || info.is_null() {
+        return None;
+    }
+    let values = unsafe { std::slice::from_raw_parts(info, info_count as usize) };
+    let out = (0..count as usize)
+        .filter_map(|c| values.get(c * 4..c * 4 + 4))
+        .map(|t| [t[0] as u32 as u64, t[1] as u32 as u64, t[2] as u32 as u64, t[3] as u32 as u64])
+        .collect();
+    #[allow(deprecated)]
+    unsafe {
+        libc::vm_deallocate(libc::mach_task_self(), info as libc::vm_address_t, info_count as libc::vm_size_t * std::mem::size_of::<libc::integer_t>() as libc::vm_size_t);
+    }
+    Some(out)
+}
+
+#[cfg(target_os = "macos")]
+fn memory() -> Option<(u64, u64)> {
+    let mut total: u64 = 0;
+    let mut len = std::mem::size_of::<u64>();
+    let name = c"hw.memsize";
+    if unsafe { libc::sysctlbyname(name.as_ptr(), (&mut total as *mut u64).cast(), &mut len, std::ptr::null_mut(), 0) } != 0 {
+        return None;
+    }
+    let mut stats: libc::vm_statistics64 = unsafe { std::mem::zeroed() };
+    let mut count = (std::mem::size_of::<libc::vm_statistics64>() / std::mem::size_of::<libc::integer_t>()) as libc::mach_msg_type_number_t;
+    #[allow(deprecated)]
+    let host = unsafe { libc::mach_host_self() };
+    let kr = unsafe { libc::host_statistics64(host, libc::HOST_VM_INFO64, (&mut stats as *mut libc::vm_statistics64).cast(), &mut count) };
+    if kr != 0 {
+        return None;
+    }
+    let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) }.max(4096) as u64;
+    let available = (u64::from(stats.free_count) + u64::from(stats.inactive_count) + u64::from(stats.speculative_count)) * page;
+    Some((total, available))
+}
+
+#[cfg(target_os = "macos")]
+fn interfaces() -> Option<Vec<(String, u64, u64, u64, u64)>> {
+    let mut list: *mut libc::ifaddrs = std::ptr::null_mut();
+    if unsafe { libc::getifaddrs(&mut list) } != 0 {
+        return None;
+    }
+    let mut out = Vec::new();
+    let mut at = list;
+    while !at.is_null() {
+        let ifa = unsafe { &*at };
+        at = ifa.ifa_next;
+        if ifa.ifa_addr.is_null() || ifa.ifa_data.is_null() || unsafe { (*ifa.ifa_addr).sa_family } as i32 != libc::AF_LINK {
+            continue;
+        }
+        let flags = ifa.ifa_flags as i32;
+        if flags & libc::IFF_UP == 0 || flags & libc::IFF_LOOPBACK != 0 {
+            continue;
+        }
+        let name = unsafe { std::ffi::CStr::from_ptr(ifa.ifa_name) }.to_string_lossy().into_owned();
+        let data = unsafe { &*(ifa.ifa_data as *const libc::if_data) };
+        out.push((name, u64::from(data.ifi_ibytes), u64::from(data.ifi_ipackets), u64::from(data.ifi_obytes), u64::from(data.ifi_opackets)));
+    }
+    unsafe { libc::freeifaddrs(list) };
+    // the wired/wireless ones first: the tile shows the first interface at start
+    out.sort_by_key(|(name, ..)| (!name.starts_with("en"), name.clone()));
+    Some(out)
+}
+
+/// The text of `path` when it is one of the three files this module writes.
+#[cfg(target_os = "macos")]
+pub fn synthesize(path: &Path) -> Option<String> {
+    match path.to_str()? {
+        "/proc/stat" => cores().map(|c| format_stat(&c)),
+        "/proc/meminfo" => memory().map(|(t, a)| format_meminfo(t, a)),
+        "/proc/net/dev" => interfaces().map(|i| format_net_dev(&i)),
+        _ => None,
+    }
+}
+#[cfg(not(target_os = "macos"))]
+pub fn synthesize(_: &Path) -> Option<String> {
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn the_written_files_read_as_linux_ones() {
+        let stat = format_stat(&[[10, 5, 80, 1], [20, 5, 70, 0]]);
+        let first = stat.lines().next().unwrap();
+        // user nice system idle
+        assert_eq!(first, "cpu 30 1 10 150 0 0 0 0");
+        assert!(stat.contains("cpu1 20 0 5 70"));
+        let mem = format_meminfo(16 << 30, 4 << 30);
+        assert!(mem.contains("MemTotal: 16777216 kB") && mem.contains("MemAvailable: 4194304 kB"));
+        let dev = format_net_dev(&[("en0".into(), 1000, 10, 5000, 50)]);
+        let line = dev.lines().nth(2).unwrap();
+        let (name, rest) = line.split_once(':').unwrap();
+        assert_eq!(name.trim(), "en0");
+        let fields: Vec<u64> = rest.split_whitespace().map(|f| f.parse().unwrap()).collect();
+        assert_eq!((fields[0], fields[8]), (1000, 5000));
+    }
+}
