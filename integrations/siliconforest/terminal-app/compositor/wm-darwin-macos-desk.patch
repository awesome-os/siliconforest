+/// `/proc/meminfo` -> bytes in use (MemTotal - MemAvailable).
+fn parse_mem_used_bytes(meminfo: &str) -> Option<u64> {
+    let field = |key: &str| meminfo.lines().find_map(|l| l.strip_prefix(key)).and_then(|rest| rest.split_whitespace().next()).and_then(|v| v.parse::<u64>().ok());
+    Some(field("MemTotal:")?.saturating_sub(field("MemAvailable:")?) * 1024)
+}
+
+/// "12%" (under the CPU graph) and "6.1G" (under the memory bar): the strip's figures.
+pub fn figures(cpu: f32, mem_bytes: u64) -> (String, String) {
+    let gib = mem_bytes as f64 / (1u64 << 30) as f64;
+    (format!("{:.0}%", (cpu * 100.0).clamp(0.0, 100.0)), if gib >= 10.0 { format!("{gib:.0}G") } else { format!("{gib:.1}G") })
 }
 
