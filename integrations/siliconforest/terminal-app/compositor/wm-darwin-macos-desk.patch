+/// What the keyboard filter does with a key while a panel of this module is open.
+pub enum MacKey {
+    /// The panel took it.
+    Taken,
+    /// To the client with the keyboard.
+    Forward,
+    /// The switcher's Q on a Mac application: the application gets the focus and then the key
+    /// (its own Command-Q, with its questions), as macOS asks the selected application to quit.
+    ForwardTo(smithay::reexports::wayland_server::protocol::wl_surface::WlSurface),
+}
+
+/// Ask an AppKit application to come forward (unhide, or open its untitled window).
+#[cfg(target_os = "macos")]
+pub fn reopen(pid: i32) -> bool {
+    use std::ffi::{c_char, c_int};
+    extern "C" {
+        fn notify_register_check(name: *const c_char, token: *mut c_int) -> u32;
+        fn notify_set_state(token: c_int, state: u64) -> u32;
+        fn notify_post(name: *const c_char) -> u32;
+        fn notify_cancel(token: c_int) -> u32;
+    }
+    let name = c"org.siliconforest.appkit.reopen";
+    let mut token: c_int = 0;
+    let ok = unsafe {
+        notify_register_check(name.as_ptr(), &mut token) == 0
+            && notify_set_state(token, pid as u64) == 0
+            && notify_post(name.as_ptr()) == 0
+    };
+    unsafe { notify_cancel(token) };
+    eprintln!("WMMAC reopen pid={pid} posted={ok}");
+    ok
+}
+#[cfg(not(target_os = "macos"))]
+pub fn reopen(pid: i32) -> bool {
+    eprintln!("WMMAC reopen pid={pid} posted=false (no notify(3) on this host)");
+    false
+}
+
+fn score(name: &str, query: &str) -> Option<u8> {
+    if query.is_empty() {
+        return Some(3);
+    }
+    let (n, q) = (name.to_lowercase(), query.to_lowercase());
+    if n.starts_with(&q) {
+        Some(0)
+    } else if n.split(|c: char| !c.is_alphanumeric()).any(|w| w.starts_with(&q)) {
+        Some(1)
+    } else if n.contains(&q) {
+        Some(2)
+    } else {
+        None
+    }
+}
+
+const MAX_ROWS: usize = 8;
+
+impl Server {
+    fn ui_scale(&self) -> f32 {
+        self.scale().factor() as f32
+    }
+    fn app_key_of(&self, id: ClientId) -> Option<String> {
+        let window = self.wm.client(id)?.window;
+        let w = self.wm.backend().windows.get(&window)?;
+        let app = w.app_id.clone().or_else(|| w.last_app_id.clone()).filter(|a| !a.is_empty());
+        Some(app.map(|a| a.to_ascii_lowercase()).unwrap_or_else(|| format!("window-{window}")))
+    }
+    /// Once a frame: the order in which applications were used (Command-Tab's order).
+    pub fn macdesk_tick(&mut self) {
+        if let Some((key, since)) = self.macdesk.launching.clone() {
+            if since.elapsed() > Duration::from_secs(20) {
+                self.macdesk.launching = None;
+            } else if !self.macdesk.modal() {
+                let window = self.wm.iter_clients().find(|(id, c)| {
+                    c.lifecycle == wm_core::Lifecycle::Normal && self.app_key_of(*id).as_deref() == Some(key.as_str())
+                }).map(|(id, _)| id);
+                if let Some(id) = window {
+                    self.macdesk.launching = None;
+                    if self.wm.focused_client() != Some(id) {
+                        eprintln!("WMMAC launched app={key}: its first window gets the focus");
+                        self.wm.activate_application(id);
+                    }
+                }
+            }
+        }
+        let focused = self.wm.focused_client();
+        if focused != self.macdesk.seen_focus {
+            self.macdesk.seen_focus = focused;
+            if let Some(id) = focused {
+                if let Some(key) = self.app_key_of(id) {
+                    self.macdesk.mru.retain(|k| *k != key);
+                    self.macdesk.mru.insert(0, key.clone());
+                    self.macdesk.last_client.insert(key, id);
+                }
+            }
+        }
+    }
+    /// The running applications, the most recently used first.
+    pub fn running_apps(&mut self) -> Vec<App> {
+        self.macdesk.catalog.refresh();
+        let mut apps: Vec<App> = Vec::new();
+        let mut windows: Vec<u64> = self.wm.backend().windows.keys().copied().collect();
+        windows.sort_unstable();
+        for window in windows {
+            let Some(w) = self.wm.backend().windows.get(&window) else { continue };
+            let app_id = w.app_id.clone().or_else(|| w.last_app_id.clone()).unwrap_or_default();
+            let pid = crate::server::peer_of(w.surface.wl_surface()).and_then(|p| p.pid);
+            let client = self.wm.client_for_window(window).filter(|id| {
+                self.wm.client(*id).is_some_and(|c| c.lifecycle != wm_core::Lifecycle::Withdrawn && !c.flags.contains(wm_core::ClientFlags::NO_FOCUS))
+            });
+            if app_id.is_empty() && client.is_none() {
+                continue;
+            }
+            let key = if app_id.is_empty() { format!("window-{window}") } else { app_id.to_ascii_lowercase() };
+            let index = match apps.iter().position(|a| a.key == key) {
+                Some(i) => i,
+                None => {
+                    let bundle = self.macdesk.catalog.bundle(&app_id).map(|b| b.path.clone());
+                    apps.push(App { key: key.clone(), app_id: app_id.clone(), name: self.macdesk.catalog.name(&app_id), mac: bundle.is_some(), bundle, clients: Vec::new(), pids: Vec::new() });
+                    apps.len() - 1
+                }
+            };
+            if let Some(c) = client {
+                apps[index].clients.push(c);
+            }
+            if let Some(pid) = pid.filter(|p| !apps[index].pids.contains(p)) {
+                apps[index].pids.push(pid);
+                if apps[index].bundle.is_none() && !self.macdesk.pid_bundles.contains_key(&apps[index].key) {
+                    if let Some(bundle) = pid_path(pid).and_then(|p| wm_theme::app_icon::enclosing_bundle(&p)) {
+                        self.macdesk.pid_bundles.insert(apps[index].key.clone(), bundle);
+                    }
+                }
+            }
+        }
+        // AppKit applications without a window (hidden, or their last window closed)
+        for peer in crate::server::live_peers() {
+            let Some(app_id) = peer.app_id.lock().ok().and_then(|a| a.clone()) else { continue };
+            let Some(bundle) = self.macdesk.catalog.bundle(&app_id).map(|b| b.path.clone()) else { continue };
+            let key = app_id.to_ascii_lowercase();
+            let index = match apps.iter().position(|a| a.key == key) {
+                Some(i) => i,
+                None => {
+                    apps.push(App { key, app_id: app_id.clone(), name: self.macdesk.catalog.name(&app_id), bundle: Some(bundle), clients: Vec::new(), pids: Vec::new(), mac: true });
+                    apps.len() - 1
+                }
+            };
+            if let Some(pid) = peer.pid.filter(|p| !apps[index].pids.contains(p)) {
+                apps[index].pids.push(pid);
+            }
+        }
+        apps.retain(|a| !a.clients.is_empty() || (a.mac && !a.pids.is_empty()));
+        for app in &mut apps {
+            if let Some(last) = self.macdesk.last_client.get(&app.key) {
+                if let Some(at) = app.clients.iter().position(|c| c == last) {
+                    let c = app.clients.remove(at);
+                    app.clients.insert(0, c);
+                }
+            }
+        }
+        let mru = &self.macdesk.mru;
+        apps.sort_by(|a, b| {
+            let rank = |x: &App| mru.iter().position(|k| *k == x.key).unwrap_or(usize::MAX);
+            rank(a).cmp(&rank(b)).then_with(|| a.name.cmp(&b.name))
+        });
+        apps
+    }
+    /// Bring an application forward: through its most recent window, or (an AppKit application
+    /// without windows) by asking it to reopen.
+    pub fn activate_app(&mut self, app: &App) {
+        eprintln!("WMMAC activate app={} windows={} pids={:?}", app.app_id, app.clients.len(), app.pids);
+        if let Some(&id) = app.clients.first() {
+            if self.wm.client(id).is_some() {
+                self.wm.activate_application(id);
+                return;
+            }
+        }
+        if app.mac {
+            for pid in &app.pids {
+                reopen(*pid);
+            }
+        }
+    }
+    fn macdesk_destroy(&mut self, surfaces: Vec<u64>) {
+        let backend = self.wm.backend_mut();
+        for id in surfaces {
+            backend.destroy_shell_surface(id);
+        }
+        backend.dirty = true;
+    }
+    fn shell_surface(&mut self, rect: Rect, buffer: &DecorationBuffer) -> Option<u64> {
+        let backend = self.wm.backend_mut();
+        let id = backend.create_shell_surface(rect, (0, 0, 0), true)?;
+        backend.paint_shell_surface(id, buffer);
+        backend.map_shell_surface(id);
+        backend.raise_shell_surface(id);
+        Some(id)
+    }
+    fn label(&mut self, text: &str, width: u32, height: u32, inverted: bool) -> Option<DecorationBuffer> {
+        let desktop = self.desktop.as_mut()?;
+        Some(desktop.shell.render_label(text, width, height, inverted))
+    }
+    fn label_height(&self) -> u32 {
+        let size = self.desktop.as_ref().map(|d| d.shell.label_font_size()).unwrap_or(13.0 * self.ui_scale());
+        (size * 2.1).round() as u32
+    }
+    /// An application's icon: its bundle's (by bundle identifier, else by the bundle its
+    /// process runs from), its `.desktop` item's `Icon=`, else the drawn "application" icon.
+    fn icon_for(&mut self, app_id: &str, size: u32) -> Option<Pixmap> {
+        use wm_theme::app_icon;
+        self.macdesk.catalog.refresh();
+        let named = self.macdesk.catalog.items.iter().find(|i| i.class.as_deref().is_some_and(|c| c.eq_ignore_ascii_case(app_id))).and_then(|i| i.icon.clone());
+        let pid_bundle = self.macdesk.pid_bundles.get(&app_id.to_ascii_lowercase()).cloned();
+        let icon = app_icon::for_app_id(app_id, size)
+            .or_else(|| named.and_then(|n| app_icon::icon_named(&n, size)))
+            .or_else(|| pid_bundle.and_then(|b| app_icon::bundle_icon(&b, size)));
+        match icon {
+            Some(icon) => Some((*icon).clone()),
+            None => app_icon::drawn("application", size),
+        }
+    }
+    // -- the application switcher ---------------------------------------------------------
+    pub fn switcher_key(&mut self, direction: i32) {
+        if let Some(sw) = self.macdesk.switcher.as_mut() {
+            let n = sw.apps.len() as i32;
+            sw.selected = (sw.selected as i32 + direction).rem_euclid(n) as usize;
+            self.switcher_draw();
+            return;
+        }
+        self.macdesk.list = self.macdesk.list.take().and_then(|l| {
+            self.macdesk_destroy(l.surfaces);
+            None
+        });
+        let apps = self.running_apps();
+        if apps.is_empty() {
+            return;
+        }
+        let n = apps.len();
+        let selected = if direction > 0 { 1 % n } else { n - 1 };
+        eprintln!("WMMAC switcher open apps={:?} selected={selected}", apps.iter().map(|a| a.name.as_str()).collect::<Vec<_>>());
+        self.macdesk.switcher = Some(Switcher { apps, selected, surfaces: Vec::new() });
+        self.switcher_draw();
+    }
+    fn switcher_draw(&mut self) {
+        let Some(sw) = self.macdesk.switcher.as_mut() else { return };
+        let old = std::mem::take(&mut sw.surfaces);
+        let apps = sw.apps.clone();
+        let selected = sw.selected;
+        self.macdesk_destroy(old);
+        let s = self.ui_scale();
+        let screen = self.wm.backend().screen_size();
+        let n = apps.len() as u32;
+        let pad = (18.0 * s) as u32;
+        let cpad = (10.0 * s) as u32;
+        let max_icon = (112.0 * s) as u32;
+        let room = (screen.w as f32 * 0.9) as u32;
+        let icon = max_icon.min(room.saturating_sub(2 * pad) / n.max(1)).saturating_sub(2 * cpad).max(16);
+        let cell = icon + 2 * cpad;
+        let name_h = self.label_height();
+        let name = apps[selected].name.clone();
+        let label = self.label(&name, (room).min((480.0 * s) as u32), name_h, false);
+        let label_w = label.as_ref().map_or(0, |l| l.width);
+        let (w, h) = ((n * cell + 2 * pad).max(label_w + 2 * pad), cell + 2 * pad + name_h);
+        let lead = (w - n * cell) / 2;
+        let at = Point::new((screen.w.saturating_sub(w) / 2) as i32, (screen.h.saturating_sub(h) / 2) as i32);
+        let Some(mut p) = Pixmap::new(w, h) else { return };
+        fill_rounded(&mut p, Rect::new(Point::new(0, 0), Size::new(w, h)), 22.0 * s, [30, 30, 34, 214]);
+        for (i, app) in apps.iter().enumerate() {
+            let x = lead + i as u32 * cell;
+            if i == selected {
+                fill_rounded(&mut p, Rect::new(Point::new(x as i32, pad as i32), Size::new(cell, cell)), 14.0 * s, [255, 255, 255, 56]);
+            }
+            if let Some(img) = self.icon_for(&app.app_id, icon) {
+                draw_icon(&mut p, &img, Rect::new(Point::new((x + cpad) as i32, (pad + cpad) as i32), Size::new(icon, icon)));
+            }
+            if app.clients.is_empty() {
+                // running without a window: a small dot under the icon, as the Dock marks a running app
+                fill_rounded(&mut p, Rect::new(Point::new((x + cell / 2) as i32 - (3.0 * s) as i32, (pad + cell) as i32 - (5.0 * s) as i32), Size::new((6.0 * s) as u32, (6.0 * s) as u32)), 3.0 * s, [235, 235, 235, 200]);
+            }
+        }
+        let mut surfaces = Vec::new();
+        surfaces.extend(self.shell_surface(Rect::new(at, Size::new(w, h)), &to_buffer(p)));
+        if let Some(label) = label {
+            let lx = at.x + lead as i32 + (selected as u32 * cell + cell / 2) as i32 - label.width as i32 / 2;
+            let lx = lx.clamp(at.x + (pad / 2) as i32, at.x + w as i32 - label.width as i32 - (pad / 2) as i32);
+            let ly = at.y + (pad + cell) as i32 + (pad as i32 / 3);
+            let rect = Rect::new(Point::new(lx, ly), Size::new(label.width, label.height));
+            surfaces.extend(self.shell_surface(rect, &label));
+        }
+        eprintln!("WMMAC switcher selected={selected} app={}", apps[selected].app_id);
+        if let Some(sw) = self.macdesk.switcher.as_mut() {
+            sw.surfaces = surfaces;
+        }
+    }
+    fn switcher_close(&mut self) -> Option<App> {
+        let sw = self.macdesk.switcher.take()?;
+        let app = sw.apps.get(sw.selected).cloned();
+        self.macdesk_destroy(sw.surfaces);
+        app
+    }
+
+    // -- the launcher and Force Quit --------------------------------------------------------
+    pub fn launcher_toggle(&mut self) {
+        if self.macdesk.list.as_ref().is_some_and(|l| l.kind == ListKind::Launcher) {
+            self.list_close();
+            return;
+        }
+        self.list_close();
+        self.macdesk.catalog.refresh();
+        let mut entries: Vec<Entry> = self
+            .macdesk
+            .catalog
+            .bundles
+            .iter()
+            .map(|b| Entry { name: b.name.clone(), icon_id: b.id.clone(), target: Target::Bundle { path: b.path.clone(), id: b.id.clone() } })
+            .collect();
+        for item in &self.macdesk.catalog.items {
+            if item.exec.contains("--desktop-request terminal") {
+                entries.push(Entry { name: item.name.clone(), icon_id: item.class.clone().unwrap_or_default(), target: Target::Terminal });
+            }
+        }
+        entries.sort_by(|a, b| a.name.to_lowercase().cmp(&b.name.to_lowercase()));
+        self.list_open(ListKind::Launcher, entries);
+    }
+    pub fn force_quit_open(&mut self) {
+        if self.macdesk.list.as_ref().is_some_and(|l| l.kind == ListKind::ForceQuit) {
+            self.list_close();
+            return;
+        }
+        self.list_close();
+        let mut apps = self.running_apps();
+        apps.retain(|a| !a.pids.is_empty());
+        apps.sort_by(|a, b| a.name.to_lowercase().cmp(&b.name.to_lowercase()));
+        let entries = apps.into_iter().map(|a| Entry { name: a.name.clone(), icon_id: a.app_id.clone(), target: Target::Running(a) }).collect();
+        self.list_open(ListKind::ForceQuit, entries);
+    }
+    fn list_open(&mut self, kind: ListKind, entries: Vec<Entry>) {
+        if let Some(sw) = self.macdesk.switcher.take() {
+            self.macdesk_destroy(sw.surfaces);
+        }
+        eprintln!("WMMAC list open kind={kind:?} entries={}", entries.len());
+        self.macdesk.list = Some(ListPanel { kind, query: String::new(), entries, shown: Vec::new(), selected: 0, confirm: false, surfaces: Vec::new(), rows: Vec::new(), panel: Rect::new(Point::new(0, 0), Size::new(1, 1)) });
+        self.list_filter();
+        self.list_draw();
+    }
+    pub fn list_close(&mut self) {
+        if let Some(list) = self.macdesk.list.take() {
+            self.macdesk_destroy(list.surfaces);
+        }
+    }
+    fn list_filter(&mut self) {
+        let Some(list) = self.macdesk.list.as_mut() else { return };
+        let mut ranked: Vec<(u8, usize)> = list.entries.iter().enumerate().filter_map(|(i, e)| score(&e.name, &list.query).map(|s| (s, i))).collect();
+        ranked.sort_by(|a, b| a.0.cmp(&b.0).then(list.entries[a.1].name.to_lowercase().cmp(&list.entries[b.1].name.to_lowercase())));
+        list.shown = ranked.into_iter().map(|(_, i)| i).take(MAX_ROWS).collect();
+        list.selected = list.selected.min(list.shown.len().saturating_sub(1));
+    }
+    fn list_draw(&mut self) {
+        let Some(list) = self.macdesk.list.as_mut() else { return };
+        let old = std::mem::take(&mut list.surfaces);
+        let (kind, query, confirm, selected) = (list.kind, list.query.clone(), list.confirm, list.selected);
+        let rows: Vec<Entry> = list.shown.iter().map(|&i| list.entries[i].clone()).collect();
+        self.macdesk_destroy(old);
+        let s = self.ui_scale();
+        let screen = self.wm.backend().screen_size();
+        let w = ((620.0 * s) as u32).min(screen.w.saturating_sub((40.0 * s) as u32));
+        let pad = (10.0 * s) as u32;
+        let field_h = (50.0 * s) as u32;
+        let row_h = (34.0 * s) as u32;
+        let icon = (24.0 * s) as u32;
+        let label_h = self.label_height().min(row_h);
+        let n = rows.len() as u32;
+        let empty_line = kind == ListKind::ForceQuit && rows.is_empty();
+        let body = if n > 0 { pad / 2 + n * row_h } else if empty_line { pad / 2 + row_h } else { 0 };
+        let h = pad + field_h + body + pad;
+        let at = Point::new((screen.w.saturating_sub(w) / 2) as i32, (screen.h as f32 * 0.18) as i32);
+        let Some(mut p) = Pixmap::new(w, h) else { return };
+        fill_rounded(&mut p, Rect::new(Point::new(0, 0), Size::new(w, h)), 14.0 * s, [36, 36, 40, 236]);
+        if kind == ListKind::Launcher {
+            magnifier(&mut p, Point::new((pad + (8.0 * s) as u32) as i32, (pad + (field_h - (26.0 * s) as u32) / 2) as i32), 26.0 * s, [200, 200, 205, 255]);
+        }
+        if body > 0 {
+            let y = (pad + field_h + pad / 4) as i32;
+            fill_rounded(&mut p, Rect::new(Point::new(pad as i32, y), Size::new(w - 2 * pad, (1.0 * s).max(1.0) as u32)), 0.0, [255, 255, 255, 40]);
+        }
+        let mut hit = Vec::new();
+        let mut row_icons = Vec::new();
+        for (i, entry) in rows.iter().enumerate() {
+            let y = pad + field_h + pad / 2 + i as u32 * row_h;
+            let r = Rect::new(Point::new(pad as i32, y as i32), Size::new(w - 2 * pad, row_h));
+            if i == selected {
+                fill_rounded(&mut p, r, 7.0 * s, if confirm { [200, 40, 40, 255] } else { [10, 96, 220, 255] });
+            }
+            row_icons.push((entry.icon_id.clone(), Rect::new(Point::new((pad + (8.0 * s) as u32) as i32, (y + (row_h - icon) / 2) as i32), Size::new(icon, icon))));
+            hit.push(Rect::new(Point::new(at.x + r.pos.x, at.y + r.pos.y), r.size));
+        }
+        for (id, r) in row_icons {
+            if let Some(img) = self.icon_for(&id, icon) {
+                draw_icon(&mut p, &img, r);
+            }
+        }
+        let mut surfaces = Vec::new();
+        surfaces.extend(self.shell_surface(Rect::new(at, Size::new(w, h)), &to_buffer(p)));
+        let text_x = at.x + (pad + (if kind == ListKind::Launcher { 44.0 } else { 12.0 } * s) as u32) as i32;
+        let field_text = match kind {
+            ListKind::Launcher if query.is_empty() => "Spotlight Search".to_string(),
+            ListKind::Launcher => format!("{query}|"),
+            ListKind::ForceQuit if confirm => rows.get(selected).map(|e| format!("Force quit \u{201c}{}\u{201d}? Return: Force Quit, Escape: Cancel", e.name)).unwrap_or_default(),
+            ListKind::ForceQuit => "Force Quit Applications".to_string(),
+        };
+        let field_w = w.saturating_sub((text_x - at.x) as u32 + pad);
+        if let Some(label) = self.label(&field_text, field_w, label_h.max((field_h as f32 * 0.6) as u32), false) {
+            let y = at.y + pad as i32 + (field_h as i32 - label.height as i32) / 2;
+            surfaces.extend(self.shell_surface(Rect::new(Point::new(text_x, y), Size::new(label.width, label.height)), &label));
+        }
+        for (i, entry) in rows.iter().enumerate() {
+            let y = at.y + (pad + field_h + pad / 2 + i as u32 * row_h) as i32;
+            let x = at.x + (pad + (8.0 * s) as u32 + icon + (10.0 * s) as u32) as i32;
+            let text = match &entry.target {
+                Target::Running(app) if app.clients.is_empty() => format!("{}  (no window)", entry.name),
+                _ => entry.name.clone(),
+            };
+            if let Some(label) = self.label(&text, w.saturating_sub((x - at.x) as u32 + pad), label_h, i == selected) {
+                let ly = y + (row_h as i32 - label.height as i32) / 2;
+                surfaces.extend(self.shell_surface(Rect::new(Point::new(x, ly), Size::new(label.width, label.height)), &label));
+            }
+        }
+        if empty_line {
+            if let Some(label) = self.label("No applications are running", w - 2 * pad, label_h, false) {
+                let y = at.y + (pad + field_h + pad / 2) as i32 + (row_h as i32 - label.height as i32) / 2;
+                surfaces.extend(self.shell_surface(Rect::new(Point::new(at.x + 2 * pad as i32, y), Size::new(label.width, label.height)), &label));
+            }
+        }
+        eprintln!("WMMAC list kind={kind:?} query={query:?} selected={selected} confirm={confirm} rows={}", rows.iter().zip(&hit).map(|(e, r)| format!("{:?}@{},{}", e.name, r.pos.x + r.size.w as i32 / 2, r.pos.y + r.size.h as i32 / 2)).collect::<Vec<_>>().join(" "));
+        if let Some(list) = self.macdesk.list.as_mut() {
+            list.surfaces = surfaces;
+            list.rows = hit;
+            list.panel = Rect::new(at, Size::new(w, h));
+        }
+    }
+    fn list_choose(&mut self) {
+        let Some(list) = self.macdesk.list.as_mut() else { return };
+        let Some(entry) = list.shown.get(list.selected).map(|&i| list.entries[i].clone()) else { return };
+        if list.kind == ListKind::ForceQuit && !list.confirm {
+            list.confirm = true;
+            self.list_draw();
+            return;
+        }
+        self.list_close();
+        eprintln!("WMMAC list choose name={:?}", entry.name);
+        match entry.target {
+            Target::Terminal => {
+                let answer = self.request_terminal();
+                eprintln!("WMMAC launcher terminal answer={}", answer.trim());
+            }
+            Target::Bundle { path, id } => self.open_application(&id, Some(&path)),
+            Target::Running(app) => {
+                for pid in &app.pids {
+                    crate::server::kill_pid(*pid, libc::SIGKILL);
+                }
+                self.mac_notice(&format!("{} was forced to quit", app.name));
+            }
+        }
+    }
+    /// An application by bundle identifier: brought forward when it runs, else opened.
+    pub fn open_application(&mut self, id: &str, path: Option<&Path>) {
+        let running = self.running_apps().into_iter().find(|a| a.app_id.eq_ignore_ascii_case(id));
+        if let Some(app) = running {
+            self.activate_app(&app);
+            return;
+        }
+        let path = path.map(Path::to_path_buf).or_else(|| self.macdesk.catalog.bundle(id).map(|b| b.path.clone()));
+        let Some(path) = path else {
+            self.mac_notice(&format!("No application {id}"));
+            return;
+        };
+        let name = path.file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+        match crate::settings::request_open(&path) {
+            Ok(()) => {
+                eprintln!("WMMAC open {}", path.display());
+                self.macdesk.launching = Some((id.to_ascii_lowercase(), Instant::now()));
+            }
+            Err(e) => self.mac_notice(&format!("{name} could not be opened (error {e})")),
+        }
+    }
+    fn mac_notice(&mut self, text: &str) {
+        if let Some(desktop) = self.desktop.as_mut() {
+            desktop.shell.notify(&mut self.wm, text);
+        }
+    }
+    /// A press of the pointer while a list panel is open: a row opens, outside closes.
+    /// Returns true when taken.
+    pub fn macdesk_pointer(&mut self, root: Point, buttons: u8, previous: u8) -> bool {
+        if self.macdesk.switcher.is_some() {
+            return true;
+        }
+        let Some(list) = self.macdesk.list.as_mut() else { return false };
+        if buttons & !previous == 0 {
+            return true;
+        }
+        let inside = |r: &Rect| root.x >= r.pos.x && root.y >= r.pos.y && root.x < r.pos.x + r.size.w as i32 && root.y < r.pos.y + r.size.h as i32;
+        if let Some(i) = list.rows.iter().position(inside) {
+            if list.selected != i {
+                list.confirm = false;
+            }
+            list.selected = i;
+            self.list_choose();
+        } else if !inside(&list.panel) {
+            self.list_close();
+        }
+        true
+    }
+    /// A key while the switcher or a list panel is open.
+    pub fn macdesk_key(&mut self, combo: wm_core::KeyCombo, text: Option<char>, down: bool) -> MacKey {
+        use wm_core::Modifiers as M;
+        let k = combo.keysym;
+        if self.macdesk.switcher.is_some() {
+            let command = combo.modifiers.contains(M::SUPER);
+            // releasing Command switches (or any key arriving without it: the release was lost)
+            if (!down && matches!(k, 0xffeb | 0xffec)) || (!command && !matches!(k, 0xffeb | 0xffec)) {
+                if let Some(app) = self.switcher_close() {
+                    eprintln!("WMMAC switcher commit app={}", app.app_id);
+                    self.activate_app(&app);
+                }
+                return if down { MacKey::Forward } else { MacKey::Taken };
+            }
+            if !down {
+                return MacKey::Taken;
+            }
+            match k {
+                0xff09 | 0xfe20 => self.switcher_key(if combo.modifiers.contains(M::SHIFT) || k == 0xfe20 { -1 } else { 1 }),
+                0xff53 | 0x60 if !combo.modifiers.contains(M::SHIFT) => self.switcher_key(1),
+                0xff51 | 0x60 => self.switcher_key(-1),
+                0xff1b => {
+                    self.switcher_close();
+                    eprintln!("WMMAC switcher cancelled");
+                }
+                0x71 | 0x51 => {
+                    let Some(sw) = self.macdesk.switcher.as_ref() else { return MacKey::Taken };
+                    let app = sw.apps[sw.selected].clone();
+                    eprintln!("WMMAC switcher quit app={}", app.app_id);
+                    if app.mac {
+                        if let Some(&id) = app.clients.first() {
+                            self.switcher_close();
+                            self.wm.activate_application(id);
+                            let surface = self.wm.client(id).and_then(|c| self.wm.backend().windows.get(&c.window)).map(|w| w.surface.wl_surface().clone());
+                            return surface.map(MacKey::ForwardTo).unwrap_or(MacKey::Taken);
+                        }
+                        for pid in &app.pids {
+                            crate::server::kill_pid(*pid, libc::SIGTERM);
+                        }
+                    } else {
+                        for id in &app.clients {
+                            self.wm.close_client(*id);
+                        }
+                    }
+                    if let Some(sw) = self.macdesk.switcher.as_mut() {
+                        sw.apps.retain(|a| a.key != app.key);
+                        if sw.apps.is_empty() {
+                            self.switcher_close();
+                        } else {
+                            sw.selected = sw.selected.min(sw.apps.len() - 1);
+                            self.switcher_draw();
+                        }
+                    }
+                }
+                _ => {}
+            }
+            return MacKey::Taken;
+        }
+        if self.macdesk.list.is_some() {
+            if !down {
+                return MacKey::Taken;
+            }
+            let mods = combo.modifiers;
+            let kind = self.macdesk.list.as_ref().map(|l| l.kind);
+            match k {
+                0xff1b if mods == M::SUPER | M::ALT => self.list_close(),
+                0xff1b => {
+                    let list = self.macdesk.list.as_mut().unwrap();
+                    if list.confirm {
+                        list.confirm = false;
+                        self.list_draw();
+                    } else if !list.query.is_empty() {
+                        list.query.clear();
+                        list.selected = 0;
+                        self.list_filter();
+                        self.list_draw();
+                    } else {
+                        self.list_close();
+                    }
+                }
+                0xff0d | 0xff8d => self.list_choose(),
+                0xff52 | 0xff54 => {
+                    let list = self.macdesk.list.as_mut().unwrap();
+                    let n = list.shown.len().max(1);
+                    list.selected = if k == 0xff52 { (list.selected + n - 1) % n } else { (list.selected + 1) % n };
+                    list.confirm = false;
+                    self.list_draw();
+                }
+                0xff08 if kind == Some(ListKind::Launcher) => {
+                    let list = self.macdesk.list.as_mut().unwrap();
+                    list.query.pop();
+                    list.selected = 0;
+                    self.list_filter();
+                    self.list_draw();
+                }
+                // Command-Space again closes the launcher; Command-Option-Escape the chooser
+                0x20 if mods == M::SUPER && kind == Some(ListKind::Launcher) => self.list_close(),
+                _ => {
+                    if let Some(c) = text.filter(|c| !c.is_control()) {
+                        if kind == Some(ListKind::Launcher) && !mods.intersects(M::SUPER | M::CONTROL) {
+                            let list = self.macdesk.list.as_mut().unwrap();
+                            if list.query.chars().count() < 64 {
+                                list.query.push(c);
+                            }
+                            list.selected = 0;
+                            self.list_filter();
+                            self.list_draw();
+                        }
+                    }
+                }
+            }
+            return MacKey::Taken;
+        }
+        MacKey::Forward
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn launcher_matching_prefers_a_prefix_then_a_word_then_anything() {
+        assert_eq!(super::score("Activity Monitor", "act"), Some(0));
+        assert_eq!(super::score("Activity Monitor", "mon"), Some(1));
+        assert_eq!(super::score("Activity Monitor", "tiv"), Some(2));
+        assert_eq!(super::score("Terminal", "x"), None);
+        assert_eq!(super::score("Terminal", ""), Some(3));
+    }
+}
