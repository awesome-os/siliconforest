+++ b/crates/wm-darwin/src/record.rs
@@ -0,0 +1,699 @@
+//! Screen recording: the screen or an area of it, into a QuickTime movie of Photo-JPEG frames
+//! ("Screen Recording <date> at <time>.mov"), as macOS's Command-Shift-5 and `screencapture -v`
+//! make one. There is no hardware video encoder here: each frame is compressed by the CPU
+//! (the `image` crate's baseline JPEG encoder) on worker threads, at half the panel's pixels
+//! each way by default (the GPU scales the frame before it is read: reading the whole panel
+//! costs ~100 ms on the M1). Frames are taken only when the screen
+//! changed, so a still screen costs nothing and the movie's frames have their own durations.
+//! No sound is recorded.
+//!
+//! What starts a recording is what starts a screenshot, nothing else (`capture.rs`): the
+//! compositor's own keys and capture toolbar, or a request on the session's uid-checked
+//! capture socket. It is stopped by Command-Control-Escape, the recording indicator (top
+//! right), the toolbar, the requesting connection (`--screencapture -v`: Return or Control-C)
+//! or its time limit (`-V <seconds>`).
+use crate::server::Server;
+use std::collections::BTreeMap;
+use std::io::{Seek, SeekFrom, Write};
