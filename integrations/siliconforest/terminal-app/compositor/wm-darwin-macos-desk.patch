+/// RGBA frame (`stride_px` pixels a row) -> RGB of `out`, the area `src` scaled to it
+/// (a 2x2 box where it halves, else bilinear).
+pub fn crop_scale(frame: &[u8], stride_px: u32, src: Rect, out: Size) -> Vec<u8> {
+    let (ow, oh) = (out.w as usize, out.h as usize);
+    let mut rgb = vec![0u8; ow * oh * 3];
+    let stride = stride_px as usize * 4;
+    let at = |x: usize, y: usize, c: usize| -> u32 { u32::from(frame[(src.pos.y as usize + y) * stride + (src.pos.x as usize + x) * 4 + c]) };
+    if src.size.w == out.w * 2 && src.size.h == out.h * 2 {
+        for y in 0..oh {
+            for x in 0..ow {
+                for c in 0..3 {
+                    let v = at(2 * x, 2 * y, c) + at(2 * x + 1, 2 * y, c) + at(2 * x, 2 * y + 1, c) + at(2 * x + 1, 2 * y + 1, c);
+                    rgb[(y * ow + x) * 3 + c] = ((v + 2) / 4) as u8;
+                }
+            }
+        }
+    } else if src.size == out {
+        for y in 0..oh {
+            for x in 0..ow {
+                for c in 0..3 {
+                    rgb[(y * ow + x) * 3 + c] = at(x, y, c) as u8;
+                }
+            }
+        }
+    } else {
+        let (sw, sh) = (src.size.w as f32, src.size.h as f32);
+        for y in 0..oh {
+            let fy = ((y as f32 + 0.5) * sh / oh as f32 - 0.5).clamp(0.0, sh - 1.0);
+            let (y0, ty) = (fy as usize, fy.fract());
+            let y1 = (y0 + 1).min(src.size.h as usize - 1);
+            for x in 0..ow {
+                let fx = ((x as f32 + 0.5) * sw / ow as f32 - 0.5).clamp(0.0, sw - 1.0);
+                let (x0, tx) = (fx as usize, fx.fract());
+                let x1 = (x0 + 1).min(src.size.w as usize - 1);
+                for c in 0..3 {
+                    let top = at(x0, y0, c) as f32 * (1.0 - tx) + at(x1, y0, c) as f32 * tx;
+                    let bottom = at(x0, y1, c) as f32 * (1.0 - tx) + at(x1, y1, c) as f32 * tx;
+                    rgb[(y * ow + x) * 3 + c] = (top * (1.0 - ty) + bottom * ty).round() as u8;
+                }
+            }
+        }
+    }
+    rgb
+}
+
+pub fn encode_jpeg(rgb: &[u8], size: Size) -> Result<Vec<u8>, String> {
+    let mut out = Vec::with_capacity(rgb.len() / 8);
+    image::codecs::jpeg::JpegEncoder::new_with_quality(&mut out, QUALITY)
+        .encode(rgb, size.w, size.h, image::ExtendedColorType::Rgb8)
+        .map_err(|e| e.to_string())?;
+    Ok(out)
+}
+
+fn atom(kind: &[u8; 4], body: &[u8]) -> Vec<u8> {
+    let mut a = Vec::with_capacity(body.len() + 8);
+    a.extend_from_slice(&((body.len() + 8) as u32).to_be_bytes());
+    a.extend_from_slice(kind);
+    a.extend_from_slice(body);
+    a
+}
+fn be32(v: &mut Vec<u8>, x: u32) {
+    v.extend_from_slice(&x.to_be_bytes());
+}
+fn be16(v: &mut Vec<u8>, x: u16) {
+    v.extend_from_slice(&x.to_be_bytes());
+}
+const MATRIX: [u32; 9] = [0x0001_0000, 0, 0, 0, 0x0001_0000, 0, 0, 0, 0x4000_0000];
+
+/// The movie's header (`moov`): one video track of Photo-JPEG samples, each its own chunk.
+pub fn movie_header(size: Size, sizes: &[u32], offsets: &[u64], durations_ms: &[u32]) -> Vec<u8> {
+    let duration: u32 = durations_ms.iter().sum();
+    let mut mvhd = Vec::new();
+    be32(&mut mvhd, 0);
+    be32(&mut mvhd, 0);
+    be32(&mut mvhd, 0);
+    be32(&mut mvhd, 1000);
+    be32(&mut mvhd, duration);
+    be32(&mut mvhd, 0x0001_0000);
+    be16(&mut mvhd, 0x0100);
+    mvhd.extend_from_slice(&[0; 10]);
+    MATRIX.iter().for_each(|m| be32(&mut mvhd, *m));
+    mvhd.extend_from_slice(&[0; 24]);
+    be32(&mut mvhd, 2);
+    let mut tkhd = Vec::new();
+    be32(&mut tkhd, 0x0000_000f);
+    be32(&mut tkhd, 0);
+    be32(&mut tkhd, 0);
+    be32(&mut tkhd, 1);
+    be32(&mut tkhd, 0);
+    be32(&mut tkhd, duration);
+    tkhd.extend_from_slice(&[0; 8]);
+    be16(&mut tkhd, 0);
+    be16(&mut tkhd, 0);
+    be16(&mut tkhd, 0);
+    be16(&mut tkhd, 0);
+    MATRIX.iter().for_each(|m| be32(&mut tkhd, *m));
+    be32(&mut tkhd, size.w << 16);
+    be32(&mut tkhd, size.h << 16);
+    let mut mdhd = Vec::new();
+    be32(&mut mdhd, 0);
+    be32(&mut mdhd, 0);
+    be32(&mut mdhd, 0);
+    be32(&mut mdhd, 1000);
+    be32(&mut mdhd, duration);
+    be16(&mut mdhd, 0);
+    be16(&mut mdhd, 0);
+    let handler = |kind: &[u8; 4], sub: &[u8; 4], name: &str| {
+        let mut h = Vec::new();
+        be32(&mut h, 0);
+        h.extend_from_slice(kind);
+        h.extend_from_slice(sub);
+        h.extend_from_slice(&[0; 12]);
+        h.push(name.len() as u8);
+        h.extend_from_slice(name.as_bytes());
+        atom(b"hdlr", &h)
+    };
+    let mut vmhd = Vec::new();
+    be32(&mut vmhd, 1);
+    be16(&mut vmhd, 0x0040);
+    for _ in 0..3 {
+        be16(&mut vmhd, 0x8000);
+    }
+    let mut dref = Vec::new();
+    be32(&mut dref, 0);
+    be32(&mut dref, 1);
+    be32(&mut dref, 12);
+    dref.extend_from_slice(b"alis");
+    be32(&mut dref, 1);
+    let dinf = atom(b"dinf", &atom(b"dref", &dref));
+    let mut entry = Vec::new();
+    entry.extend_from_slice(b"jpeg");
+    entry.extend_from_slice(&[0; 6]);
+    be16(&mut entry, 1);
+    be16(&mut entry, 0);
+    be16(&mut entry, 0);
+    be32(&mut entry, 0);
+    be32(&mut entry, 0);
+    be32(&mut entry, 512);
+    be16(&mut entry, size.w as u16);
+    be16(&mut entry, size.h as u16);
+    be32(&mut entry, 0x0048_0000);
+    be32(&mut entry, 0x0048_0000);
+    be32(&mut entry, 0);
+    be16(&mut entry, 1);
+    let mut name = [0u8; 32];
+    let label = b"Photo - JPEG";
+    name[0] = label.len() as u8;
+    name[1..1 + label.len()].copy_from_slice(label);
+    entry.extend_from_slice(&name);
+    be16(&mut entry, 24);
+    be16(&mut entry, 0xffff);
+    let mut stsd = Vec::new();
+    be32(&mut stsd, 0);
+    be32(&mut stsd, 1);
+    be32(&mut stsd, (entry.len() + 4) as u32);
+    stsd.extend_from_slice(&entry);
+    let mut runs: Vec<(u32, u32)> = Vec::new();
+    for d in durations_ms {
+        match runs.last_mut() {
+            Some((count, delta)) if *delta == *d => *count += 1,
+            _ => runs.push((1, *d)),
+        }
+    }
+    let mut stts = Vec::new();
+    be32(&mut stts, 0);
+    be32(&mut stts, runs.len() as u32);
+    for (count, delta) in runs {
+        be32(&mut stts, count);
+        be32(&mut stts, delta);
+    }
+    let mut stsc = Vec::new();
+    be32(&mut stsc, 0);
+    be32(&mut stsc, 1);
+    be32(&mut stsc, 1);
+    be32(&mut stsc, 1);
+    be32(&mut stsc, 1);
+    let mut stsz = Vec::new();
+    be32(&mut stsz, 0);
+    be32(&mut stsz, 0);
+    be32(&mut stsz, sizes.len() as u32);
+    sizes.iter().for_each(|s| be32(&mut stsz, *s));
+    let mut co64 = Vec::new();
+    be32(&mut co64, 0);
+    be32(&mut co64, offsets.len() as u32);
+    offsets.iter().for_each(|o| co64.extend_from_slice(&o.to_be_bytes()));
+    let stbl = [atom(b"stsd", &stsd), atom(b"stts", &stts), atom(b"stsc", &stsc), atom(b"stsz", &stsz), atom(b"co64", &co64)].concat();
+    let minf = [atom(b"vmhd", &vmhd), handler(b"dhlr", b"alis", "DataHandler"), dinf, atom(b"stbl", &stbl)].concat();
+    let mdia = [atom(b"mdhd", &mdhd), handler(b"mhlr", b"vide", "VideoHandler"), atom(b"minf", &minf)].concat();
+    let trak = [atom(b"tkhd", &tkhd), atom(b"mdia", &mdia)].concat();
+    atom(b"moov", &[atom(b"mvhd", &mvhd), atom(b"trak", &trak)].concat())
+}
+
+/// The file: `ftyp`, a 64-bit `mdat` the samples are appended to, then `moov`.
+struct MovieWriter {
+    file: std::fs::File,
+    size: Size,
+    mdat_at: u64,
+    at: u64,
+    sizes: Vec<u32>,
+    offsets: Vec<u64>,
+    times: Vec<u64>,
+}
+
+impl MovieWriter {
+    fn new(mut file: std::fs::File, size: Size) -> std::io::Result<Self> {
+        let mut head = atom(b"ftyp", &[b"qt  ".as_slice(), &0x0000_0200u32.to_be_bytes(), b"qt  "].concat());
+        let mdat_at = head.len() as u64;
+        be32(&mut head, 1);
+        head.extend_from_slice(b"mdat");
+        head.extend_from_slice(&16u64.to_be_bytes());
+        file.write_all(&head)?;
+        Ok(Self { file, size, mdat_at, at: head.len() as u64, sizes: Vec::new(), offsets: Vec::new(), times: Vec::new() })
+    }
+    fn add(&mut self, jpeg: &[u8], at_ms: u64) -> std::io::Result<()> {
+        self.file.write_all(jpeg)?;
+        self.offsets.push(self.at);
+        self.sizes.push(jpeg.len() as u32);
+        self.times.push(at_ms);
+        self.at += jpeg.len() as u64;
+        Ok(())
+    }
+    fn finish(mut self, end_ms: u64) -> std::io::Result<(u64, u64)> {
+        let mut durations: Vec<u32> = self.times.windows(2).map(|w| (w[1] - w[0]).max(1) as u32).collect();
+        if let Some(last) = self.times.last() {
+            durations.push(end_ms.saturating_sub(*last).clamp(1, 1000) as u32);
+        }
+        let moov = movie_header(self.size, &self.sizes, &self.offsets, &durations);
+        self.file.write_all(&moov)?;
+        self.file.seek(SeekFrom::Start(self.mdat_at + 8))?;
+        self.file.write_all(&(self.at - self.mdat_at).to_be_bytes())?;
+        self.file.sync_all()?;
+        Ok((durations.iter().map(|d| u64::from(*d)).sum(), self.at + moov.len() as u64))
+    }
+}
+
+/// Start the pipeline: workers that crop, scale and encode, a writer that appends in order.
+fn pipeline(file: std::fs::File, path: PathBuf, target: Rect, out: Size, stop_at: Arc<Mutex<Option<u64>>>, in_flight: Arc<AtomicUsize>)
+    -> std::io::Result<(mpsc::SyncSender<Job>, std::thread::JoinHandle<Result<Summary, String>>)> {
+    let mut writer = MovieWriter::new(file, out)?;
+    let (tx, rx) = mpsc::sync_channel::<Job>(WORKERS * 2);
+    let rx = Arc::new(Mutex::new(rx));
+    let (etx, erx) = mpsc::channel::<Result<Encoded, String>>();
+    for n in 0..WORKERS {
+        let (rx, etx, in_flight) = (rx.clone(), etx.clone(), in_flight.clone());
+        std::thread::Builder::new().name(format!("record-{n}")).spawn(move || loop {
+            let job = { rx.lock().unwrap_or_else(|e| e.into_inner()).recv() };
+            let Ok(job) = job else { break };
+            let t = Instant::now();
+            let src = if job.scaled { Rect::new(Point::new(0, 0), out) } else { target };
+            let rgb = crop_scale(&job.frame, job.stride_px, src, out);
+            drop(job.frame);
+            let result = encode_jpeg(&rgb, out).map(|jpeg| Encoded { seq: job.seq, at_ms: job.at_ms, jpeg, encode_us: t.elapsed().as_micros() as u64 });
+            in_flight.fetch_sub(1, Ordering::AcqRel);
+            if etx.send(result).is_err() {
+                break;
+            }
+        })?;
+    }
+    drop(etx);
+    let handle = std::thread::Builder::new().name("record-writer".into()).spawn(move || {
+        let mut waiting = BTreeMap::new();
+        let (mut next, mut encode_us, mut frames) = (0u64, 0u64, 0u64);
+        for result in erx {
+            let e = result?;
+            waiting.insert(e.seq, e);
+            while let Some(e) = waiting.remove(&next) {
+                writer.add(&e.jpeg, e.at_ms).map_err(|err| format!("{}: {err}", path.display()))?;
+                encode_us += e.encode_us;
+                frames += 1;
+                next += 1;
+            }
+        }
+        let end = stop_at.lock().map(|g| g.unwrap_or(0)).unwrap_or(0);
+        let (duration_ms, bytes) = writer.finish(end).map_err(|err| format!("{}: {err}", path.display()))?;
+        Ok(Summary { path, frames, duration_ms, bytes, encode_ms_avg: if frames > 0 { encode_us as f64 / frames as f64 / 1000.0 } else { 0.0 } })
+    })?;
+    Ok((tx, handle))
+}
+
+fn movie_name(dir: &Path) -> Result<(PathBuf, std::fs::File), String> {
+    std::fs::create_dir_all(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    let stamp = crate::capture::local_stamp();
+    for n in 0..100 {
+        let name = if n == 0 { format!("Screen Recording {stamp}.mov") } else { format!("Screen Recording {stamp} ({n}).mov") };
+        let path = dir.join(name);
+        match std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).custom_flags(libc::O_NOFOLLOW).open(&path) {
+            Ok(file) => return Ok((path, file)),
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => continue,
+            Err(e) => return Err(format!("{}: {e}", path.display())),
+        }
+    }
+    Err("no free file name".into())
+}
+
+impl Server {
+    /// A recording of `target` (panel pixels), after the toolbar's timer when there is one.
+    pub(crate) fn record_request(&mut self, target: Rect, path: Option<PathBuf>, reply: Option<UnixStream>, limit: Option<Duration>, full: bool, timer: u32) {
+        if self.recorder.recording() {
+            if let Some(mut r) = reply {
+                let _ = r.write_all(b"error a recording is already running\n");
+            }
+            return;
+        }
+        if timer == 0 {
+            self.record_start(target, path, reply, limit, full);
+        } else {
+            self.recorder.pending = Some(Pending { due: Instant::now() + Duration::from_secs(u64::from(timer)), target, path, reply, limit, full, last_second: u64::MAX });
+        }
+    }
+    fn record_start(&mut self, target: Rect, path: Option<PathBuf>, mut reply: Option<UnixStream>, limit: Option<Duration>, full: bool) {
+        let screen = { use wm_core::Backend; self.wm.backend().screen_size() };
+        let Some(target) = crate::capture::clip(target, screen) else {
+            self.record_fail(reply, "the area is off the screen");
+            return;
+        };
+        // half the panel's pixels each way by default (the CPU encodes every frame); -F: all
+        let factor = if full { 1.0 } else { 2.0 };
+        // even sizes (some players want them), at least 16 pixels
+        let even = |v: f64| ((v.round() as u32) & !1).max(16);
+        let out = Size::new(even(f64::from(target.size.w) / factor), even(f64::from(target.size.h) / factor));
+        let opened = match &path {
+            Some(p) => std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).custom_flags(libc::O_NOFOLLOW).open(p).map(|f| (p.clone(), f)).map_err(|e| format!("{}: {e}", p.display())),
+            None => movie_name(&self.capture_dir_for_movies()),
+        };
+        let (path, file) = match opened {
+            Ok(x) => x,
+            Err(e) => {
+                self.record_fail(reply, &e);
+                return;
+            }
+        };
+        let in_flight = Arc::new(AtomicUsize::new(0));
+        let stop_at = Arc::new(Mutex::new(None));
+        let (tx, writer) = match pipeline(file, path.clone(), target, out, stop_at.clone(), in_flight.clone()) {
+            Ok(x) => x,
+            Err(e) => {
+                self.record_fail(reply, &e.to_string());
+                return;
+            }
+        };
+        if let Some(r) = reply.as_mut() {
+            let _ = r.write_all(format!("recording {} {}x{}\n", path.display(), out.w, out.h).as_bytes());
+            let _ = r.set_nonblocking(true);
+        }
+        eprintln!("WMRECORD start target={},{} {}x{} out={}x{} file={}", target.pos.x, target.pos.y, target.size.w, target.size.h, out.w, out.h, path.display());
+        let now = Instant::now();
+        self.recorder.active = Some(Recording {
+            target, out, path, started: now, next_due: now, seq: 0, dropped: 0, grab_us: 0, last_frame_count: None,
+            tx: Some(tx), in_flight, writer: Some(writer), stop_at, reply, limit, indicator: None, cpu_start: cpu_seconds(), scaled_by_gpu: false,
+        });
+        self.wm.backend_mut().dirty = true;
+        self.record_indicator();
+    }
+    fn record_fail(&mut self, reply: Option<UnixStream>, why: &str) {
+        eprintln!("WMRECORD failed: {why}");
+        if let Some(mut r) = reply {
+            let _ = r.set_nonblocking(false);
+            let _ = r.write_all(format!("error {why}\n").as_bytes());
+        }
+        self.record_notice(&format!("Screen recording failed: {why}"));
+    }
+    fn record_notice(&mut self, text: &str) {
+        if let Some(desktop) = self.desktop.as_mut() {
+            desktop.shell.notify(&mut self.wm, text);
+        }
+    }
+    /// The recording indicator: a small panel at the top right with the time; a click stops.
+    fn record_indicator(&mut self) {
+        let Some(rec) = self.recorder.active.as_ref() else { return };
+        let second = rec.started.elapsed().as_secs();
+        if rec.indicator.as_ref().is_some_and(|(_, _, s)| *s == second) {
+            return;
+        }
+        let old = self.recorder.active.as_mut().and_then(|r| r.indicator.take());
+        if let Some((id, _, _)) = old {
+            use wm_core::Backend;
+            self.wm.backend_mut().destroy_shell_surface(id);
+        }
+        let s = self.scale().factor() as f32;
+        let screen = { use wm_core::Backend; self.wm.backend().screen_size() };
+        let text = format!("\u{25cf} {}:{:02}  Stop", second / 60, second % 60);
+        let height = (self.desktop.as_ref().map(|d| d.shell.label_font_size()).unwrap_or(13.0 * s) * 2.0) as u32;
+        let Some(label) = self.desktop.as_mut().map(|d| d.shell.render_label(&text, (220.0 * s) as u32, height, true)) else { return };
+        // at the top right of the work area: beside the dock's column, not over it
+        let right = self.layer_workarea.map_or(screen.w as i32, |a| a.pos.x + a.size.w as i32);
+        let rect = Rect::new(Point::new(right - label.width as i32 - (12.0 * s) as i32, (8.0 * s) as i32), Size::new(label.width, label.height));
+        use wm_core::Backend;
+        let backend = self.wm.backend_mut();
+        if let Some(id) = backend.create_shell_surface(rect, (0, 0, 0), true) {
+            backend.paint_shell_surface(id, &label);
+            backend.map_shell_surface(id);
+            backend.raise_shell_surface(id);
+            if let Some(r) = self.recorder.active.as_mut() {
+                r.indicator = Some((id, rect, second));
+            }
+        }
+    }
+    /// A press on the recording indicator stops the recording.
+    pub(crate) fn record_pointer(&mut self, root: Point, buttons: u8, previous: u8) -> bool {
+        let Some((_, r, _)) = self.recorder.active.as_ref().and_then(|a| a.indicator) else { return false };
+        let inside = root.x >= r.pos.x && root.y >= r.pos.y && root.x < r.pos.x + r.size.w as i32 && root.y < r.pos.y + r.size.h as i32;
+        if inside && buttons & !previous & 1 != 0 {
+            self.record_stop("indicator");
+            return true;
+        }
+        inside && buttons & 1 != 0
+    }
+    pub(crate) fn record_stop(&mut self, why: &str) {
+        if let Some(p) = self.recorder.pending.take() {
+            if let Some(mut r) = p.reply {
+                let _ = r.write_all(b"error cancelled\n");
+            }
+            self.record_notice("Screen recording cancelled");
+            return;
+        }
+        let Some(mut rec) = self.recorder.active.take() else { return };
+        let end = rec.started.elapsed().as_millis() as u64;
+        if let Ok(mut g) = rec.stop_at.lock() {
+            *g = Some(end);
+        }
+        rec.tx.take();
+        if let Some((id, _, _)) = rec.indicator.take() {
+            use wm_core::Backend;
+            self.wm.backend_mut().destroy_shell_surface(id);
+        }
+        let seconds = end as f64 / 1000.0;
+        eprintln!("WMRECORD stop why={why} file={} target={}x{} out={}x{} taken={} dropped={} seconds={seconds:.2} scaled_by_gpu={} grab_ms_avg={:.1}", rec.path.display(), rec.target.size.w, rec.target.size.h, rec.out.w, rec.out.h, rec.seq, rec.dropped, rec.scaled_by_gpu,
+            if rec.seq > 0 { rec.grab_us as f64 / rec.seq as f64 / 1000.0 } else { 0.0 });
+        if let Some(writer) = rec.writer.take() {
+            self.recorder.finishing.push((writer, rec.reply.take(), rec.dropped, seconds, rec.cpu_start, Instant::now()));
+        }
+        self.wm.backend_mut().dirty = true;
+    }
+    /// After each repaint: the timer, a frame when one is due and the screen changed, the
+    /// indicator, the requesting connection, recordings that finished writing.
+    pub fn record_after_repaint(&mut self) {
+        if let Some(p) = self.recorder.pending.as_mut() {
+            let left = p.due.saturating_duration_since(Instant::now());
+            let second = left.as_secs() + u64::from(left.subsec_nanos() > 0);
+            if left.is_zero() {
+                let p = self.recorder.pending.take().unwrap();
+                self.record_start(p.target, p.path, p.reply, p.limit, p.full);
+            } else if second != p.last_second {
+                p.last_second = second;
+                self.record_notice(&format!("Recording starts in {second}"));
+            }
+        }
+        let frames_now = self.frames_rendered();
+        let mut stop = None;
+        if let Some(rec) = self.recorder.active.as_mut() {
+            if let Some(r) = rec.reply.as_mut() {
+                let mut buf = [0u8; 64];
+                match std::io::Read::read(r, &mut buf) {
+                    Ok(0) => stop = Some("connection"),
+                    Ok(_) => stop = Some("request"),
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {}
+                    Err(_) => stop = Some("connection"),
+                }
+            }
+            if rec.limit.is_some_and(|l| rec.started.elapsed() >= l) {
+                stop = Some("limit");
+            }
+        }
+        if let Some(why) = stop {
+            self.record_stop(why);
+        }
+        let due = self.recorder.active.as_ref().is_some_and(|rec| {
+            Instant::now() >= rec.next_due && rec.last_frame_count != Some(frames_now)
+        });
+        if due {
+            let t = Instant::now();
+            let size = { use wm_core::Backend; self.wm.backend().screen_size() };
+            let (target, out) = { let r = self.recorder.active.as_ref().unwrap(); (r.target, r.out) };
+            // scaled by the GPU when the renderer can (a frame of the output's size, read
+            // cheaply), else the whole frame, cropped and scaled by the encoder threads
+            let (frame, scaled) = match self.read_back_scaled(target, out) {
+                Ok(Some(frame)) => (Some(frame), true),
+                _ => match self.read_back() {
+                    Ok(Some(frame)) => (Some(frame), false),
+                    _ => (self.wm.backend().render().ok().map(|p| p.take()), false),
+                },
+            };
+            let rec = self.recorder.active.as_mut().unwrap();
+            rec.scaled_by_gpu = scaled;
+            rec.last_frame_count = Some(frames_now);
+            rec.next_due = t + Duration::from_millis(u64::from(1000 / MAX_FPS));
+            let want = if scaled { out.w as usize * out.h as usize * 4 } else { size.w as usize * size.h as usize * 4 };
+            if let Some(frame) = frame.filter(|f| f.len() >= want) {
+                if rec.in_flight.load(Ordering::Acquire) >= WORKERS * 2 {
+                    rec.dropped += 1;
+                } else {
+                    rec.grab_us += t.elapsed().as_micros() as u64;
+                    let job = Job { seq: rec.seq, at_ms: rec.started.elapsed().as_millis() as u64, frame, stride_px: if scaled { out.w } else { size.w }, scaled };
+                    rec.in_flight.fetch_add(1, Ordering::AcqRel);
+                    if rec.tx.as_ref().is_some_and(|tx| tx.try_send(job).is_ok()) {
+                        rec.seq += 1;
+                    } else {
+                        rec.in_flight.fetch_sub(1, Ordering::AcqRel);
+                        rec.dropped += 1;
+                    }
+                }
+            }
+        }
+        if self.recorder.active.is_some() {
+            self.record_indicator();
+        }
+        let mut done = Vec::new();
+        let mut i = 0;
+        while i < self.recorder.finishing.len() {
+            if self.recorder.finishing[i].0.is_finished() {
+                done.push(self.recorder.finishing.remove(i));
+            } else {
+                i += 1;
+            }
+        }
+        for (handle, reply, dropped, seconds, cpu0, stopped) in done {
+            let result = handle.join().unwrap_or_else(|_| Err("the writer ended abnormally".into()));
+            let cpu1 = cpu_seconds();
+            let cpu = (cpu1.0 - cpu0.0) + (cpu1.1 - cpu0.1);
+            match result {
+                Ok(s) => {
+                    self.recorder.recorded += 1;
+                    let fps = if seconds > 0.0 { s.frames as f64 / seconds } else { 0.0 };
+                    eprintln!("WMRECORD saved file={} frames={} dropped={dropped} seconds={seconds:.2} fps={fps:.1} bytes={} encode_ms_avg={:.1} cpu_s={cpu:.2} cpu_pct_of_one_core={:.0} finish_ms={}",
+                        s.path.display(), s.frames, s.bytes, s.encode_ms_avg, if seconds > 0.0 { cpu / seconds * 100.0 } else { 0.0 }, stopped.elapsed().as_millis());
+                    if let Some(mut r) = reply {
+                        let _ = r.set_nonblocking(false);
+                        let _ = r.write_all(format!("ok {} {} {:.2}\n", s.path.display(), s.frames, seconds).as_bytes());
+                    }
+                    let name = s.path.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+                    self.record_notice(&format!("Screen recording saved: {name}"));
+                }
+                Err(e) => self.record_fail(reply, &e),
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn a_frame_is_halved_by_a_box_and_kept_at_its_size() {
+        let mut frame = vec![0u8; 4 * 4 * 4];
+        for (i, px) in frame.chunks_exact_mut(4).enumerate() {
+            px.copy_from_slice(&[(i * 10) as u8, 100, 200, 255]);
+        }
+        let half = crop_scale(&frame, 4, Rect::new(Point::new(0, 0), Size::new(4, 4)), Size::new(2, 2));
+        assert_eq!(&half[..3], &[25, 100, 200]); // (0 + 10 + 40 + 50) / 4
+        let same = crop_scale(&frame, 4, Rect::new(Point::new(1, 1), Size::new(2, 2)), Size::new(2, 2));
+        assert_eq!(same[0], 50);
+        let odd = crop_scale(&frame, 4, Rect::new(Point::new(0, 0), Size::new(4, 4)), Size::new(3, 3));
+        assert_eq!(odd.len(), 27);
+    }
+    #[test]
+    fn a_movie_of_three_frames_has_its_samples_and_durations() {
+        let dir = std::env::temp_dir().join(format!("record-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("t.mov");
+        let file = std::fs::File::create(&path).unwrap();
+        let size = Size::new(32, 16);
+        let mut w = MovieWriter::new(file, size).unwrap();
+        let rgb = vec![128u8; 32 * 16 * 3];
+        let jpeg = encode_jpeg(&rgb, size).unwrap();
+        assert_eq!(&jpeg[..2], &[0xff, 0xd8]);
+        for t in [0u64, 40, 120] {
+            w.add(&jpeg, t).unwrap();
+        }
+        let (duration, bytes) = w.finish(150).unwrap();
+        assert_eq!(duration, 150);
+        let data = std::fs::read(&path).unwrap();
+        assert_eq!(data.len() as u64, bytes);
+        assert_eq!(&data[4..8], b"ftyp");
+        assert_eq!(&data[24..28], b"mdat");
+        let mdat = u64::from_be_bytes(data[28..36].try_into().unwrap());
+        assert_eq!(mdat, 16 + 3 * jpeg.len() as u64);
+        let moov = 20 + mdat as usize;
+        assert_eq!(&data[moov + 4..moov + 8], b"moov");
+        assert_eq!(u32::from_be_bytes(data[moov..moov + 4].try_into().unwrap()) as usize, data.len() - moov);
+        // the sample table: 40, 80, 30 ms
+        let find = |tag: &[u8]| data.windows(4).position(|w| w == tag).unwrap();
+        let stts = find(b"stts");
+        assert_eq!(u32::from_be_bytes(data[stts + 8..stts + 12].try_into().unwrap()), 3);
+        // keep the file for a player when asked (RECORD_TEST_KEEP=1)
+        if std::env::var_os("RECORD_TEST_KEEP").is_none() {
+            let _ = std::fs::remove_dir_all(&dir);
+        } else {
+            eprintln!("kept {}", path.display());
+        }
+    }
+}
