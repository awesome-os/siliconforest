+/// Command-Tab: the switcher takes the keyboard while Command is held, and Command's release
+/// switches. Command went down while the client had the keyboard, so the client must not be
+/// told Command is still down when it gets the keyboard back (the desk's terminal ends on a
+/// second press of a key it believes held: "duplicate key press", seen on the M1).
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn after_the_switcher_no_key_is_left_held_for_the_client() {
+    let (h, a) = Harness::with_input(true);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let (mut qa, mut ca, _sa, _xa, _ta) = map_client(&a, "switcher");
+    assert!(ca.keyboard_enters > 0);
+    for (seq, (usage, down)) in [(0xe3, true), (0x2b, true), (0x2b, false), (0xe3, false), (0xe3, true), (0xe3, false)].into_iter().enumerate() {
+        h.tx.send(key_record(seq as u32 + 1, usage, down)).unwrap();
+        h.snapshot();
+        qa.roundtrip(&mut ca).unwrap();
+    }
+    for _ in 0..5 { h.snapshot(); qa.roundtrip(&mut ca).unwrap(); }
+    // KEY_LEFTMETA (125): released by then, so never listed as held when the keyboard comes back
+    assert!(ca.keyboard_enters >= 2, "the client got the keyboard back");
+    assert!(ca.held_on_enter.iter().all(|held| !held.contains(&125)), "held on enter: {:?}", ca.held_on_enter);
+}
