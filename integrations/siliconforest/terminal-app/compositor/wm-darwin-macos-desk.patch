+/// The chords that are the application's on macOS (in its own menus): a focused Mac
+/// application gets them; on the desk's own windows the desk carries them out (Quit, Close,
+/// Minimize, Minimize All, Enter Full Screen, New Window).
+pub fn standalone_darwin_app_chord(combo: KeyCombo) -> bool {
+    use wm_core::Modifiers as M;
+    let k = combo.keysym;
+    let m = combo.modifiers;
+    (m == M::SUPER && matches!(k, 0x71 | 0x51 | 0x77 | 0x57 | 0x6d | 0x4d | 0x6e | 0x4e))
+        || (m == M::SUPER | M::ALT && matches!(k, 0x6d | 0x4d))
+        || (m == M::SUPER | M::CONTROL && matches!(k, 0x66 | 0x46))
+}
