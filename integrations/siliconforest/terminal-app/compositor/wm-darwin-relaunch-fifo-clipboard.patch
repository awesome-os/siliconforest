new file mode 100644
index 0000000..c9ed21f
--- /dev/null
+++ b/crates/wm-darwin/src/session_restore.rs
@@ -0,0 +1,305 @@
+//! Applications open again after a compositor relaunch (DESK8). A relaunch ends every client's connection;
+//! with AppKit's cocoa 0143w (TERM8) an application whose connection ended ends itself, and before it the
+//! application lived on without a window (`foreign.rs` leftovers, DESK7). Either way its windows were gone.
+//!
+//! This compositor keeps `$XDG_RUNTIME_DIR/session-apps`: the applications that have windows now, one line
+//! each (pid, application id, bundle, windows, whether the desk opened it), rewritten when that changes and
+//! every 10 s, and once more when the compositor ends (with the session's end request, when there is one).
+//! The next compositor reads it once: an application the desk opened (the dock, the switcher, the launcher,
+//! a restore) that had a window when the compositor before ended, whose process has ended since, is opened
+//! again through the dock's own path (`open_application`), at most once. Nothing is signalled: a process
+//! still alive is left to the leftover handling. Not restored: a file older than 120 s, a compositor that
+//! ended for a power-off, reboot or log-out, applications started some other way (an agent's test instance
+//! started from a shell with its own profile; a `open` from a terminal), and with the policy's
+//! `restore=off`. Said in the log as `WMRESTORE`.
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+pub const FILE: &str = "session-apps";
+const HEADER: &str = "# chonkstep-darwin session-apps v1";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Record {
+    pub pid: i32,
+    pub app_id: String,
+    pub bundle: String,
+    pub windows: u32,
+    pub desk: bool,
+}
+
+/// The file's text: header, then a line per application.
+pub fn render(records: &[Record], writer: i32, now_ms: u128, ended: Option<&str>) -> String {
+    let mut text = format!("{HEADER} writer={writer} updated_unix_ms={now_ms} ended={}\n", ended.unwrap_or("-"));
+    for r in records {
+        text.push_str(&format!("{}\t{}\t{}\t{}\t{}\n", r.pid, r.app_id, r.bundle, r.windows, if r.desk { "desk" } else { "other" }));
+    }
+    text
+}
+
+/// (records, updated_unix_ms, ended) of a file's text; `None` when it is not one.
+pub fn parse(text: &str) -> Option<(Vec<Record>, u128, String)> {
+    let mut lines = text.lines();
+    let head = lines.next()?;
+    if !head.starts_with(HEADER) {
+        return None;
+    }
+    let field = |key: &str| head.split_whitespace().find_map(|w| w.strip_prefix(key)).map(str::to_string);
+    let updated = field("updated_unix_ms=")?.parse().ok()?;
+    let ended = field("ended=").unwrap_or_else(|| "-".into());
+    let records = lines
+        .filter_map(|line| {
+            let f: Vec<&str> = line.split('\t').collect();
+            (f.len() == 5).then_some(())?;
+            Some(Record { pid: f[0].parse().ok()?, app_id: f[1].to_string(), bundle: f[2].to_string(), windows: f[3].parse().ok()?, desk: f[4] == "desk" })
+        })
+        .collect();
+    Some((records, updated, ended))
+}
+
+/// The applications to open again, given the file of the compositor before, now, and a liveness test.
+/// Returns (to open, skipped with why).
+pub fn plan(text: &str, now_ms: u128, alive: impl Fn(i32) -> bool) -> (Vec<Record>, Vec<(Record, &'static str)>) {
+    let Some((records, updated, ended)) = parse(text) else { return (Vec::new(), Vec::new()) };
+    let stale = now_ms.saturating_sub(updated) > 120_000;
+    let session_ends = matches!(ended.as_str(), "reboot" | "poweroff" | "shutdown" | "logout");
+    let mut open = Vec::new();
+    let mut skipped = Vec::new();
+    let mut seen = HashSet::new();
+    for r in records.into_iter().filter(|r| r.windows > 0) {
+        let why = if stale {
+            Some("the file is older than 120 s")
+        } else if session_ends {
+            Some("the session ended (power-off, reboot or log-out)")
+        } else if !r.desk {
+            Some("not opened by the desk (a shell's or an agent's instance)")
+        } else if alive(r.pid) {
+            Some("still running (a leftover: its dock tile restarts it)")
+        } else if !seen.insert(r.app_id.to_ascii_lowercase()) {
+            Some("another process of the same application is opened already")
+        } else {
+            None
+        };
+        match why {
+            Some(why) => skipped.push((r, why)),
+            None => open.push(r),
+        }
+    }
+    (open, skipped)
+}
+
+pub fn unix_ms() -> u128 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_millis())
+}
+
+#[derive(Default)]
+pub struct SessionApps {
+    path: Option<PathBuf>,
+    written: Vec<Record>,
+    written_at: Option<Instant>,
+    checked: Option<Instant>,
+    /// The compositor before's file, read at start, until the restore ran.
+    previous: Option<String>,
+    started: Option<Instant>,
+    restore_done: bool,
+    /// Application ids (lower case) the desk asked to open, and when.
+    pub opened: HashMap<String, Instant>,
+    /// Processes the desk opened.
+    pub desk_pids: HashSet<i32>,
+    /// Application ids (lower case) opened again by the restore.
+    restored: HashSet<String>,
+}
+
+impl SessionApps {
+    /// At start: the file of the compositor before is moved aside and kept for the restore.
+    pub fn start(runtime: Option<PathBuf>) -> Self {
+        let path = runtime.map(|r| r.join(FILE));
+        let previous = path.as_ref().and_then(|p| {
+            let text = std::fs::read_to_string(p).ok()?;
+            let _ = std::fs::rename(p, p.with_extension("before"));
+            Some(text)
+        });
+        // the processes the desk before had opened stay desk-opened (a leftover of them may be restarted)
+        let desk_pids = previous.as_deref().and_then(parse).map(|(r, _, _)| r.into_iter().filter(|r| r.desk).map(|r| r.pid).collect()).unwrap_or_default();
+        Self { path, previous, desk_pids, started: Some(Instant::now()), ..Default::default() }
+    }
+    /// Whether the restore is due now (4 s after the start: the dock is up, applications that end with
+    /// their connection have ended), then once more at 10 s for those that ended later.
+    pub fn restore_due(&self) -> Option<bool> {
+        let since = self.started?.elapsed();
+        if self.previous.is_none() || since < Duration::from_secs(4) {
+            return None;
+        }
+        Some(since >= Duration::from_secs(10))
+    }
+    pub fn take_previous(&mut self, last: bool) -> Option<String> {
+        if last {
+            self.restore_done = true;
+            self.previous.take()
+        } else {
+            self.previous.clone()
+        }
+    }
+    /// The records now: written when they changed, and every 10 s (the next compositor judges the file's age).
+    pub fn update(&mut self, records: Vec<Record>, ended: Option<&str>) {
+        let now = Instant::now();
+        if ended.is_none() && self.checked.is_some_and(|t| now.duration_since(t) < Duration::from_secs(2)) {
+            return;
+        }
+        self.checked = Some(now);
+        let Some(path) = &self.path else { return };
+        let due = ended.is_some() || records != self.written || self.written_at.is_none_or(|t| now.duration_since(t) >= Duration::from_secs(10));
+        if !due {
+            return;
+        }
+        let text = render(&records, std::process::id() as i32, unix_ms(), ended);
+        let part = path.with_extension("part");
+        if std::fs::write(&part, text).and_then(|()| std::fs::rename(&part, path)).is_ok() {
+            if records != self.written {
+                eprintln!("WMRESTORE applications with windows now: {:?}", records.iter().map(|r| format!("{}({}){}", r.app_id, r.pid, if r.desk { "" } else { " not desk-opened" })).collect::<Vec<_>>());
+            }
+            self.written = records;
+            self.written_at = Some(now);
+        }
+    }
+}
+
+#[cfg(feature = "desktop-shell")]
+impl crate::server::Server {
+    /// The session's applications file (the desktop session only; host tests keep none).
+    pub fn enable_session_restore(&mut self) {
+        let runtime = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from);
+        self.session_apps = SessionApps::start(runtime);
+    }
+    /// The applications with windows now (AppKit applications in a bundle: the desk's own clients are
+    /// started by the session).
+    fn session_records(&mut self) -> Vec<Record> {
+        let mut by_pid: std::collections::BTreeMap<i32, Record> = Default::default();
+        let now = Instant::now();
+        let windows: Vec<(i32, String)> = self
+            .wm
+            .backend()
+            .windows
+            .values()
+            .filter(|w| w.mapped || w.committed)
+            .filter_map(|w| {
+                let pid = crate::server::peer_of(w.surface.wl_surface())?.pid?;
+                let app = w.app_id.clone().or_else(|| w.last_app_id.clone()).filter(|a| !a.is_empty())?;
+                Some((pid, app))
+            })
+            .collect();
+        for (pid, app_id) in windows {
+            if let Some(r) = by_pid.get_mut(&pid) {
+                r.windows += 1;
+                continue;
+            }
+            let Some(bundle) = crate::macdesk::pid_path(pid).and_then(|p| wm_theme::app_icon::enclosing_bundle(&p)) else { continue };
+            let key = app_id.to_ascii_lowercase();
+            let s = &mut self.session_apps;
+            if !s.desk_pids.contains(&pid) && s.opened.get(&key).is_some_and(|at| now.duration_since(*at) < Duration::from_secs(60)) {
+                s.desk_pids.insert(pid);
+                s.opened.remove(&key);
+            }
+            let desk = s.desk_pids.contains(&pid);
+            by_pid.insert(pid, Record { pid, app_id, bundle: bundle.display().to_string(), windows: 1, desk });
+        }
+        by_pid.into_values().collect()
+    }
+    /// Once a frame (cheap: every 2 s): the file, and the restore when it is due.
+    pub(crate) fn session_tick(&mut self) {
+        if let Some(last) = self.session_apps.restore_due() {
+            if let Some(text) = self.session_apps.take_previous(last) {
+                if self.policy.now.restore {
+                    let (open, skipped) = plan(&text, unix_ms(), |pid| unsafe { libc::kill(pid, 0) } == 0 || std::io::Error::last_os_error().raw_os_error() == Some(libc::EPERM));
+                    for r in open {
+                        if !self.session_apps.restored.insert(r.app_id.to_ascii_lowercase()) {
+                            continue;
+                        }
+                        eprintln!("WMRESTORE {}({}) had {} window(s) when the compositor before ended and has ended since: opened again", r.app_id, r.pid, r.windows);
+                        self.open_application(&r.app_id, None);
+                    }
+                    if last {
+                        for (r, why) in skipped {
+                            if !self.session_apps.restored.contains(&r.app_id.to_ascii_lowercase()) {
+                                eprintln!("WMRESTORE {}({}) not opened again: {why}", r.app_id, r.pid);
+                            }
+                        }
+                    }
+                } else if last {
+                    eprintln!("WMRESTORE off (policy restore=off): nothing opened again");
+                }
+            }
+        }
+        if self.session_apps.path.is_some() {
+            let records = self.session_records();
+            self.session_apps.update(records, None);
+        }
+    }
+    /// When the compositor ends: the file once more, with the session's end request (relaunch, reboot ...).
+    pub(crate) fn session_ended(&mut self) {
+        if self.session_apps.path.is_none() {
+            return;
+        }
+        let runtime = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from);
+        let word = runtime
+            .and_then(|r| std::fs::read_to_string(r.join("session-end-request")).ok())
+            .map(|t| t.trim().to_string())
+            .filter(|w| !w.is_empty() && w.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-'))
+            .unwrap_or_else(|| "exit".into());
+        let records = self.session_records();
+        eprintln!("WMRESTORE the compositor ends ({word}): {} application(s) with windows recorded", records.iter().filter(|r| r.windows > 0).count());
+        self.session_apps.update(records, Some(&word));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn rec(pid: i32, id: &str, windows: u32, desk: bool) -> Record {
+        Record { pid, app_id: id.into(), bundle: format!("/Applications/{id}.app"), windows, desk }
+    }
+    #[test]
+    fn after_a_relaunch_only_ended_desk_opened_applications_with_windows_open_again() {
+        let now = unix_ms();
+        let records = vec![
+            rec(10, "org.mozilla.firefox", 2, true),
+            rec(11, "com.apple.Terminal", 1, true),
+            rec(12, "org.mozilla.firefox", 1, false), // an agent's own instance from a shell
+            rec(13, "com.apple.ActivityMonitor", 0, true), // no window when it ended
+            rec(14, "com.apple.Terminal", 1, true),       // a second process of the same application
+        ];
+        let text = render(&records, 99, now - 3_000, Some("relaunch-next"));
+        assert_eq!(parse(&text).unwrap().0, records);
+        // 11 still runs (a leftover); 10 and 14 ended
+        let (open, skipped) = plan(&text, now, |pid| pid == 11);
+        assert_eq!(open.iter().map(|r| r.pid).collect::<Vec<_>>(), [10, 14]);
+        let why: Vec<(i32, &str)> = skipped.iter().map(|(r, w)| (r.pid, *w)).collect();
+        assert!(why.contains(&(11, "still running (a leftover: its dock tile restarts it)")), "{why:?}");
+        assert!(why.contains(&(12, "not opened by the desk (a shell's or an agent's instance)")), "{why:?}");
+        // the same application once only
+        let (open, _) = plan(&text, now, |_| false);
+        assert_eq!(open.iter().map(|r| r.pid).collect::<Vec<_>>(), [10, 11]);
+        // stale, or the machine going down: nothing
+        assert!(plan(&text, now + 200_000, |_| false).0.is_empty());
+        let down = render(&records, 99, now, Some("poweroff"));
+        assert!(plan(&down, now, |_| false).0.is_empty());
+        // a compositor that crashed (no end line) within the 120 s: restored
+        let crashed = render(&records, 99, now - 30_000, None);
+        assert_eq!(plan(&crashed, now, |_| false).0.len(), 2);
+        assert!(plan("not a session file", now, |_| false).0.is_empty());
+    }
+    #[test]
+    fn the_file_is_moved_aside_at_start_and_rewritten_on_change() {
+        let dir = std::env::temp_dir().join(format!("desk8-restore-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join(FILE), render(&[rec(5, "a.b", 1, true)], 1, unix_ms(), Some("relaunch"))).unwrap();
+        let mut s = SessionApps::start(Some(dir.clone()));
+        assert!(s.previous.is_some() && !dir.join(FILE).exists() && dir.join("session-apps.before").exists());
+        s.update(vec![rec(7, "c.d", 1, false)], None);
+        let (records, _, ended) = parse(&std::fs::read_to_string(dir.join(FILE)).unwrap()).unwrap();
+        assert_eq!((records.len(), ended.as_str()), (1, "-"));
+        s.update(vec![rec(7, "c.d", 1, false)], Some("relaunch-next"));
+        assert_eq!(parse(&std::fs::read_to_string(dir.join(FILE)).unwrap()).unwrap().2, "relaunch-next");
+        std::fs::remove_dir_all(&dir).ok();
+    }
+}
