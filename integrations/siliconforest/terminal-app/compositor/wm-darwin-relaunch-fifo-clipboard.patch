+//! The desk's switches that change without a compositor relaunch (DESK8). A relaunch ends every window on the
+//! desktop, so what is likely to be tuned or compared on the M1 is read from a file instead of being built in:
+//! `$XDG_STATE_HOME/chonkstep/policy` (`/private/var/db/desktop-state/chonkstep/policy` on SiliconForest), one
+//! `key=value` per line, `#` comments, read again within a second of a change (`WMPOLICY` says what changed).
+//! A key the file does not name keeps its default (or the environment's `CHONKSTEP_DARWIN_<KEY>=0|1`).
+//!
+//! | key | default | what |
+//! |---|---|---|
+//! | `fifo` | on | a GPU client's newer buffer waits for the next refresh instead of replacing one no frame showed yet (`server.rs` FIFO) |
+//! | `client_wake` | on | the loop wakes for client requests while it waits (a commit is read when it comes, not up to 8 ms later) |
+//! | `flip_time_callbacks` | on | frame callbacks carry the flip's time (CLOCK_MONOTONIC ms, wp_presentation's clock) and go out at the flip |
+//! | `flip_stamps` | on | a flip's time is the kernel's stamp of it (when on a clock we read), not when its event was read |
+//! | `restore` | on | applications the desk opened that had windows when the compositor before this one ended are opened again (`session_restore.rs`) |
+use std::path::PathBuf;
+use std::time::{Duration, Instant, SystemTime};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Switches {
+    pub fifo: bool,
+    pub client_wake: bool,
+    pub flip_time_callbacks: bool,
+    pub flip_stamps: bool,
+    pub restore: bool,
+}
+
+impl Switches {
+    const KEYS: [&'static str; 5] = ["fifo", "client_wake", "flip_time_callbacks", "flip_stamps", "restore"];
+    fn defaults() -> Self {
+        let env = |key: &str| std::env::var(format!("CHONKSTEP_DARWIN_{}", key.to_ascii_uppercase())).ok().and_then(|v| parse_bool(&v));
+        Self {
+            fifo: env("fifo").unwrap_or(true),
+            client_wake: env("client_wake").unwrap_or(true),
+            flip_time_callbacks: env("flip_time_callbacks").unwrap_or(true),
+            flip_stamps: env("flip_stamps").unwrap_or(true),
+            restore: env("restore").unwrap_or(true),
+        }
+    }
+    fn slot(&mut self, key: &str) -> Option<&mut bool> {
+        Some(match key {
+            "fifo" => &mut self.fifo,
+            "client_wake" => &mut self.client_wake,
+            "flip_time_callbacks" => &mut self.flip_time_callbacks,
+            "flip_stamps" => &mut self.flip_stamps,
+            "restore" => &mut self.restore,
+            _ => return None,
+        })
+    }
+    fn get(&self, key: &str) -> bool {
+        let mut copy = *self;
+        copy.slot(key).map(|v| *v).unwrap_or(false)
+    }
+    /// The file's text over the defaults; unknown keys and values are listed, not fatal.
+    pub fn parse(text: &str, base: Self) -> (Self, Vec<String>) {
+        let mut out = base;
+        let mut refused = Vec::new();
+        for line in text.lines() {
+            let line = line.split('#').next().unwrap_or("").trim();
+            if line.is_empty() {
+                continue;
+            }
+            let Some((key, value)) = line.split_once('=') else {
+                refused.push(line.to_string());
+                continue;
+            };
+            match (out.slot(key.trim()), parse_bool(value)) {
+                (Some(slot), Some(v)) => *slot = v,
+                _ => refused.push(line.to_string()),
+            }
+        }
+        (out, refused)
+    }
+    pub fn text(&self) -> String {
+        Self::KEYS.iter().map(|k| format!("{k}={}", if self.get(k) { "on" } else { "off" })).collect::<Vec<_>>().join(" ")
+    }
+}
+
+fn parse_bool(v: &str) -> Option<bool> {
+    match v.trim().to_ascii_lowercase().as_str() {
+        "1" | "on" | "yes" | "true" => Some(true),
+        "0" | "off" | "no" | "false" => Some(false),
+        _ => None,
+    }
+}
+
+pub struct Policy {
+    pub now: Switches,
+    defaults: Switches,
+    path: Option<PathBuf>,
+    checked: Option<Instant>,
+    stamp: Option<SystemTime>,
+    /// Set by the inject module (a test's own A/B); the file does not override it until `release`.
+    pinned: Option<Switches>,
+}
+
+impl Default for Policy {
+    fn default() -> Self {
+        let path = std::env::var_os("XDG_STATE_HOME").map(|d| PathBuf::from(d).join("chonkstep").join("policy"));
+        Self::with_path(path)
+    }
+}
+
+impl Policy {
+    pub fn with_path(path: Option<PathBuf>) -> Self {
+        let defaults = Switches::defaults();
+        let mut policy = Self { now: defaults, defaults, path, checked: None, stamp: None, pinned: None };
+        policy.tick();
+        eprintln!("WMPOLICY {} (file {})", policy.now.text(), policy.path.as_ref().map_or("none".into(), |p| p.display().to_string()));
+        policy
+    }
+    fn apply(&self) {
+        crate::kms::USE_FLIP_STAMPS.store(self.now.flip_stamps, std::sync::atomic::Ordering::Relaxed);
+    }
+    /// The file looked at once a second at most; a change is said in the log.
+    pub fn tick(&mut self) {
+        self.read_file();
+        self.apply();
+    }
+    fn read_file(&mut self) {
+        if self.checked.is_some_and(|t| t.elapsed() < Duration::from_secs(1)) {
+            return;
+        }
+        self.checked = Some(Instant::now());
+        let Some(path) = &self.path else { return };
+        let stamp = std::fs::metadata(path).and_then(|m| m.modified()).ok();
+        if stamp == self.stamp {
+            return;
+        }
+        self.stamp = stamp;
+        let (read, refused) = Switches::parse(&std::fs::read_to_string(path).unwrap_or_default(), self.defaults);
+        if !refused.is_empty() {
+            eprintln!("WMPOLICY {}: lines not understood (ignored): {refused:?}", path.display());
+        }
+        if self.pinned.is_none() && read != self.now {
+            eprintln!("WMPOLICY {} ({})", read.text(), path.display());
+            self.now = read;
+        }
+    }
+    /// A test instrument's own setting, kept until `release` (inject `policy key=value`).
+    pub fn pin(&mut self, text: &str) -> Result<String, String> {
+        let (next, refused) = Switches::parse(text, self.pinned.unwrap_or(self.now));
+        if !refused.is_empty() {
+            return Err(format!("not understood: {refused:?} (keys: {})", Switches::KEYS.join(", ")));
+        }
+        self.pinned = Some(next);
+        self.now = next;
+        self.apply();
+        eprintln!("WMPOLICY {} (test instrument)", next.text());
+        Ok(next.text())
+    }
+    pub fn release(&mut self) {
+        if self.pinned.take().is_some() {
+            self.stamp = None;
+            self.checked = None;
+            self.now = self.defaults;
+            self.tick();
+            eprintln!("WMPOLICY {} (test instrument's setting released)", self.now.text());
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn the_policy_file_changes_switches_without_a_relaunch_and_a_test_pin_wins_until_released() {
+        let base = Switches { fifo: true, client_wake: true, flip_time_callbacks: true, flip_stamps: true, restore: true };
+        let (s, refused) = Switches::parse("# comment\nfifo=off\nrestore = 0\nbogus=1\nclient_wake=maybe\n", base);
+        assert!(!s.fifo && !s.restore && s.client_wake && s.flip_time_callbacks);
+        assert_eq!(refused, vec!["bogus=1".to_string(), "client_wake=maybe".to_string()]);
+        let dir = std::env::temp_dir().join(format!("desk8-policy-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("policy");
+        std::fs::write(&path, "fifo=off\n").unwrap();
+        let mut p = Policy::with_path(Some(path.clone()));
+        assert!(!p.now.fifo);
+        p.pin("fifo=on").unwrap();
+        assert!(p.now.fifo);
+        // the file changes while pinned: the pin stays
+        std::fs::write(&path, "fifo=off\nflip_time_callbacks=off\n").unwrap();
+        p.checked = None;
+        p.stamp = None;
+        p.tick();
+        assert!(p.now.fifo);
+        p.release();
+        assert!(!p.now.fifo && !p.now.flip_time_callbacks);
+        assert!(p.pin("nonsense=1").is_err());
+        std::fs::remove_dir_all(&dir).ok();
+    }
+}
