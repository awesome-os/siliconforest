+/// DESK8, the FIFO: a GPU client that commits twice before a frame could draw the first gets both drawn, one
+/// frame each (without it the first was replaced unseen); three in a burst: one deep, the newest of the
+/// later two follows the first.
+#[test]
+fn fifo_a_dmabuf_committed_before_the_one_before_was_drawn_waits_for_the_next_frame() {
+    for fifo in [true, false] {
+        let (h, connection) = Harness::start_policy(true, if fifo { "fifo=on" } else { "fifo=off" });
+        let mut queue = connection.new_event_queue();
+        let qh = queue.handle();
+        let mut client = Client::default();
+        connection.display().get_registry(&qh, ());
+        queue.roundtrip(&mut client).unwrap();
+        let (dmabuf, _) = client.dmabuf.clone().expect("zwp_linux_dmabuf_v1 advertised");
+        let surface = client.compositor.as_ref().unwrap().create_surface(&qh, ());
+        let xdg = client.shell.as_ref().unwrap().get_xdg_surface(&surface, &qh, ());
+        let _top = xdg.get_toplevel(&qh, ());
+        surface.commit();
+        queue.roundtrip(&mut client).unwrap();
+        let (w, hgt, stride) = (64i32, 32i32, 256u32);
+        let files: Vec<_> = (0..6).map(|_| fake_dmabuf(stride as usize * hgt as usize)).collect();
+        let buffers: Vec<wl_buffer::WlBuffer> = files
+            .iter()
+            .enumerate()
+            .map(|(i, file)| {
+                let params = dmabuf.create_params(&qh, ());
+                params.add(file.as_fd(), 0, 0, stride, 0, 0);
+                let b = params.create_immed(w, hgt, XR24, zwp_linux_buffer_params_v1::Flags::empty(), &qh, i as u32 + 1);
+                params.destroy();
+                b
+            })
+            .collect();
+        queue.roundtrip(&mut client).unwrap();
+        let commit = |b: &wl_buffer::WlBuffer| {
+            surface.attach(Some(b), 0, 0);
+            surface.damage_buffer(0, 0, w, hgt);
+            surface.frame(&qh, ());
+            surface.commit();
+        };
+        commit(&buffers[0]);
+        let started = Instant::now();
+        while client.frames < 1 {
+            queue.roundtrip(&mut client).unwrap();
+            assert!(started.elapsed() < Duration::from_secs(5));
+            thread::sleep(Duration::from_millis(2));
+        }
+        let shows = |log: &Log, import: u64| log.drawn.iter().filter(|f| f.iter().any(|(_, id)| *id == import)).count();
+        // import ids follow creation: buffer n is import n
+        let burst = |seq: &[usize], h: &Harness, queue: &mut wayland_client::EventQueue<Client>, client: &mut Client| {
+            h.paused.store(true, Ordering::Release);
+            for i in seq {
+                commit(&buffers[*i]);
+            }
+            queue.roundtrip(client).unwrap(); // the server has read the burst; no frame drawn meanwhile
+            h.paused.store(false, Ordering::Release);
+            let last = *seq.last().unwrap() as u64 + 1;
+            h.wait("the burst's last buffer to be drawn", || shows(&h.log.lock().unwrap(), last) > 0);
+        };
+        burst(&[1, 2], &h, &mut queue, &mut client);
+        let log = h.log.lock().unwrap();
+        if fifo {
+            assert!(shows(&log, 2) >= 1, "with the FIFO the first of two commits is drawn: {:?}", log.drawn);
+            // the two are drawn in consecutive frames, the second after the first
+            let first = log.drawn.iter().position(|f| f.iter().any(|(_, id)| *id == 2)).unwrap();
+            let second = log.drawn.iter().position(|f| f.iter().any(|(_, id)| *id == 3)).unwrap();
+            assert_eq!(second, first + 1, "{:?}", log.drawn);
+        } else {
+            assert_eq!(shows(&log, 2), 0, "without the FIFO the newer commit replaces the first unseen: {:?}", log.drawn);
+        }
+        drop(log);
+        // three before a frame: the first, then the newest (one deep: the middle one is replaced)
+        burst(&[3, 4, 5], &h, &mut queue, &mut client);
+        let log = h.log.lock().unwrap();
+        if fifo {
+            assert!(shows(&log, 4) >= 1 && shows(&log, 5) == 0 && shows(&log, 6) >= 1, "{:?}", log.drawn);
+        } else {
+            assert_eq!(shows(&log, 4) + shows(&log, 5), 0, "{:?}", log.drawn);
+        }
+    }
+}
