+/// DESK8: wp_presentation's feedback says when the flip that showed a buffer happened (CLOCK_MONOTONIC), the
+/// refresh, the flip's sequence, vsync + hardware completion; a buffer replaced before any frame showed it is
+/// discarded; the frame callback carries the same flip's time in ms. With the FIFO both buffers of a burst
+/// are presented, on consecutive flips.
+#[test]
+fn presentation_feedback_carries_the_flip_and_the_fifo_presents_every_buffer_of_a_burst() {
+    for fifo in [false, true] {
+        let (h, connection) = Harness::start_full(true, if fifo { "fifo=on" } else { "fifo=off" }, true);
+        let mut queue = connection.new_event_queue();
+        let qh = queue.handle();
+        let mut client = Client::default();
+        connection.display().get_registry(&qh, ());
+        queue.roundtrip(&mut client).unwrap();
+        let presentation = client.presentation.clone().expect("wp_presentation advertised");
+        let (dmabuf, _) = client.dmabuf.clone().unwrap();
+        let surface = client.compositor.as_ref().unwrap().create_surface(&qh, ());
+        let xdg = client.shell.as_ref().unwrap().get_xdg_surface(&surface, &qh, ());
+        let _top = xdg.get_toplevel(&qh, ());
+        surface.commit();
+        queue.roundtrip(&mut client).unwrap();
+        let (w, hgt, stride) = (64i32, 32i32, 256u32);
+        let files: Vec<_> = (0..3).map(|_| fake_dmabuf(stride as usize * hgt as usize)).collect();
+        let buffers: Vec<wl_buffer::WlBuffer> = files.iter().enumerate().map(|(i, file)| {
+            let params = dmabuf.create_params(&qh, ());
+            params.add(file.as_fd(), 0, 0, stride, 0, 0);
+            let b = params.create_immed(w, hgt, XR24, zwp_linux_buffer_params_v1::Flags::empty(), &qh, i as u32 + 1);
+            params.destroy();
+            b
+        }).collect();
+        queue.roundtrip(&mut client).unwrap();
+        let commit = |b: &wl_buffer::WlBuffer, tag: u32| {
+            surface.attach(Some(b), 0, 0);
+            surface.damage_buffer(0, 0, w, hgt);
+            surface.frame(&qh, ());
+            presentation.feedback(&surface, &qh, tag);
+            surface.commit();
+        };
+        let wait = |client: &mut Client, queue: &mut wayland_client::EventQueue<Client>, n: usize| {
+            let started = Instant::now();
+            while client.feedback.len() < n {
+                queue.roundtrip(client).unwrap();
+                assert!(started.elapsed() < Duration::from_secs(5), "feedback {n} did not arrive: {:?}", client.feedback);
+                thread::sleep(Duration::from_millis(1));
+            }
+        };
+        commit(&buffers[0], 1);
+        wait(&mut client, &mut queue, 1);
+        let now = monotonic_ns();
+        let (tag, Some((ns, refresh, seq, flags))) = client.feedback[0] else { panic!("{:?}", client.feedback) };
+        assert_eq!(tag, 1);
+        assert!(ns <= now && now - ns < 200_000_000, "the flip's time is recent: {ns} vs {now}");
+        assert!(refresh > 10_000_000 && refresh < 40_000_000, "refresh {refresh}");
+        assert!(seq >= 1);
+        assert_eq!(flags & 0x5, 0x5, "vsync (0x1) and hw_completion (0x4)");
+        // the frame callback: the same flip, in ms of the same clock
+        let started = Instant::now();
+        while client.callback_times.is_empty() {
+            queue.roundtrip(&mut client).unwrap();
+            assert!(started.elapsed() < Duration::from_secs(5));
+        }
+        let cb = u128::from(client.callback_times[0]);
+        let flip_ms = (ns / 1_000_000) & 0xffff_ffff;
+        assert!(cb.abs_diff(flip_ms) <= 1, "frame callback time {cb} = the flip's {flip_ms} ms");
+        // a burst of two before a frame
+        h.paused.store(true, Ordering::Release);
+        commit(&buffers[1], 2);
+        commit(&buffers[2], 3);
+        queue.roundtrip(&mut client).unwrap();
+        h.paused.store(false, Ordering::Release);
+        wait(&mut client, &mut queue, 3);
+        let outcome: Vec<(u32, bool)> = client.feedback[1..].iter().map(|(t, f)| (*t, f.is_some())).collect();
+        if fifo {
+            assert_eq!(outcome, [(2, true), (3, true)], "both presented");
+            let (Some(a), Some(b)) = (client.feedback[1].1, client.feedback[2].1) else { unreachable!() };
+            assert_eq!(b.2, a.2 + 1, "on consecutive flips: {a:?} {b:?}");
+        } else {
+            assert!(outcome.contains(&(2, false)) && outcome.contains(&(3, true)), "the replaced one discarded: {outcome:?}");
+        }
+    }
+}
