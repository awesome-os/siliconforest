diff --git a/crates/wm-darwin/src/clipboard.rs b/crates/wm-darwin/src/clipboard.rs
new file mode 100644
index 0000000..37db84f
--- /dev/null
+++ b/crates/wm-darwin/src/clipboard.rs
@@ -0,0 +1,155 @@
+//! The clipboard outlives the application that copied (DESK8; Firefox and AppKit asked for it). Wayland's
+//! clipboard is the copying client's: it sends the bytes when another client pastes, so when it quits (or
+//! loses its connection) the clipboard is empty. As a macOS pasteboard does, the desk keeps a copy: when a
+//! client sets the clipboard, the desk asks it at once for every type it offers (at most 12 types and 32 MiB,
+//! read by a thread within 3 s), and when that client's data source goes away without a new selection the
+//! desk offers the same types itself (`WMCLIP`). A client that clears the clipboard while it lives clears it.
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use smithay::wayland::selection::SelectionSource;
+
+/// What the desk serves itself: (mime type, bytes) in the order offered.
+#[derive(Debug, Default)]
+pub struct ClipData {
+    pub items: Vec<(String, Vec<u8>)>,
+}
+
+const MAX_TYPES: usize = 12;
+const MAX_BYTES: usize = 32 << 20;
+const READ_FOR: Duration = Duration::from_secs(3);
+
+#[derive(Default)]
+pub struct Keeper {
+    /// The client's source of the clipboard now, and the copy's number.
+    source: Option<SelectionSource>,
+    serial: u64,
+    /// (serial, the bytes read so far) - written by the reading thread.
+    captured: Arc<Mutex<(u64, Vec<(String, Vec<u8>)>)>>,
+    /// The desk serves the clipboard itself (the copying client went).
+    pub serving: bool,
+    pub kept: u32,
+}
+
+fn pipe() -> Option<(OwnedFd, OwnedFd)> {
+    let mut fds = [0; 2];
+    if unsafe { libc::pipe(fds.as_mut_ptr()) } != 0 {
+        return None;
+    }
+    for fd in fds {
+        unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) };
+    }
+    unsafe { libc::fcntl(fds[0], libc::F_SETFL, libc::O_NONBLOCK) };
+    Some(unsafe { (OwnedFd::from_raw_fd(fds[0]), OwnedFd::from_raw_fd(fds[1])) })
+}
+
+/// Read every pipe to its end (the writers closed them), within the deadline and the size limit.
+fn read_all(serial: u64, pipes: Vec<(String, OwnedFd)>, into: Arc<Mutex<(u64, Vec<(String, Vec<u8>)>)>>) {
+    let deadline = Instant::now() + READ_FOR;
+    let mut total = 0usize;
+    let mut done: Vec<(String, Vec<u8>)> = Vec::new();
+    for (mime, fd) in pipes {
+        let mut bytes = Vec::new();
+        let mut complete = false;
+        while Instant::now() < deadline && total + bytes.len() <= MAX_BYTES {
+            let mut pfd = libc::pollfd { fd: fd.as_raw_fd(), events: libc::POLLIN, revents: 0 };
+            let left = deadline.saturating_duration_since(Instant::now()).as_millis().max(1) as libc::c_int;
+            if unsafe { libc::poll(&mut pfd, 1, left) } <= 0 {
+                break;
+            }
+            let mut chunk = [0u8; 65536];
+            let n = unsafe { libc::read(fd.as_raw_fd(), chunk.as_mut_ptr().cast(), chunk.len()) };
+            if n == 0 {
+                complete = true;
+                break;
+            }
+            if n < 0 {
+                if std::io::Error::last_os_error().raw_os_error() == Some(libc::EAGAIN) {
+                    continue;
+                }
+                break;
+            }
+            bytes.extend_from_slice(&chunk[..n as usize]);
+        }
+        if complete && total + bytes.len() <= MAX_BYTES {
+            total += bytes.len();
+            done.push((mime, bytes));
+        }
+    }
+    if let Ok(mut c) = into.lock() {
+        if c.0 == serial {
+            c.1 = done;
+        }
+    }
+}
+
+impl Keeper {
+    /// A client set the clipboard: its types are read now (nothing when the desk itself is the source).
+    pub fn copied(&mut self, source: SelectionSource) {
+        self.serial += 1;
+        self.serving = false;
+        let serial = self.serial;
+        if let Ok(mut c) = self.captured.lock() {
+            *c = (serial, Vec::new());
+        }
+        let mut pipes = Vec::new();
+        for mime in source.mime_types().into_iter().take(MAX_TYPES) {
+            let Some((read, write)) = pipe() else { break };
+            source.send(mime.clone(), write);
+            pipes.push((mime, read));
+        }
+        self.source = Some(source);
+        let into = self.captured.clone();
+        let _ = std::thread::Builder::new().name("clipboard-copy".into()).spawn(move || read_all(serial, pipes, into));
+    }
+    /// The desk set the clipboard itself (a screenshot): the client's copy is no longer the clipboard.
+    pub fn desk_set(&mut self) {
+        self.source = None;
+        self.serial += 1;
+        self.serving = false;
+    }
+    /// The clipboard was cleared or its source went. Returns the copy to serve when the source is gone
+    /// (its client quit or lost its connection); a live source that cleared it keeps it cleared.
+    pub fn cleared(&mut self) -> Option<Arc<ClipData>> {
+        let source = self.source.take()?;
+        if source.is_alive() {
+            return None;
+        }
+        self.take_copy()
+    }
+    /// The copy, when the source is gone (checked each turn: a source can go without a selection event).
+    pub fn orphaned(&mut self) -> Option<Arc<ClipData>> {
+        if self.source.as_ref().is_some_and(|s| !s.is_alive()) {
+            self.source = None;
+            return self.take_copy();
+        }
+        None
+    }
+    fn take_copy(&mut self) -> Option<Arc<ClipData>> {
+        let c = self.captured.lock().ok()?;
+        if c.0 != self.serial || c.1.is_empty() {
+            return None;
+        }
+        self.serving = true;
+        self.kept += 1;
+        Some(Arc::new(ClipData { items: c.1.clone() }))
+    }
+}
+
+impl crate::server::Server {
+    /// The desk offers the copy it kept of a clipboard whose client went.
+    pub(crate) fn clipboard_keep(&mut self, data: Arc<ClipData>) {
+        let Some(seat) = self.input.as_ref().map(|i| i.seat.clone()) else { return };
+        let mimes: Vec<String> = data.items.iter().map(|(m, _)| m.clone()).collect();
+        let bytes: usize = data.items.iter().map(|(_, b)| b.len()).sum();
+        eprintln!("WMCLIP the application that copied went: the desk keeps the clipboard ({} types, {bytes} bytes: {mimes:?})", mimes.len());
+        smithay::wayland::selection::data_device::set_data_device_selection(&self.display_handle.clone(), &seat, mimes, Some(data));
+    }
+    /// Once a turn: a clipboard source that went without a selection event.
+    pub(crate) fn clipboard_tick(&mut self) {
+        if let Some(data) = self.clipboard.orphaned() {
+            self.clipboard_keep(data);
+        }
+    }
+}
