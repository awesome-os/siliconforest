+    #[test]
+    fn shown_to_shown_intervals_come_from_the_flips_that_showed_a_new_buffer() {
+        let mut p = PacingTrace::default();
+        let t0 = Instant::now();
+        for (k, commit) in [(0u64, true), (1, true), (2, false), (3, true)] {
+            if commit {
+                p.commit(5, Some("org.mozilla.firefox"));
