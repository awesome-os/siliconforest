diff -ruN '--exclude=.git' '--exclude=target' desk4-007/crates/wm-darwin/src/displays.rs desk5-003/crates/wm-darwin/src/displays.rs
--- desk4-007/crates/wm-darwin/src/displays.rs	1969-12-31 16:00:00.000000000 -0800
+++ desk5-003/crates/wm-darwin/src/displays.rs	2026-11-14 20:46:26.000000000 -0800
@@ -0,0 +1,230 @@
+//! More than one output (DESK5): what the desk does when the layout of outputs.rs changes.
+//!
+//! The scene is one space in the panel's density (outputs.rs `Layout::scene_outputs`): the
+//! panel at its origin, an external display beside it (the primary: the dock, the launcher
+//! strip, the desk's panels and new windows go there). Here the scene follows a new set of
+//! outputs at run time:
+//! - wm-core's monitors (and so its work areas, its placement of new windows, the output a
+//!   window is on), with Spaces per display (macOS's default, wm-core `reconcile_display_spaces`)
+//!   or, without separate Spaces, the windows of an output that went brought to the remaining
+//!   ones (`rescue_departed_output`);
+//! - a `wl_output` per output, with its own mode, scale and position, and `xdg_output` (smithay)
+//!   telling clients its logical size; a window's surface enters the output it lies on;
+//! - the layer surfaces (the dock) placed on the primary;
+//! - the pointer kept on an output (it crosses where outputs touch, stops elsewhere).
+//! The single-output path is the one the desk always had: nothing here runs until a second
+//! output is set.
+use crate::outputs::{OutputKind, SceneOutput};
+use crate::server::Server;
+use smithay::output::{Mode, Output, PhysicalProperties, Scale, Subpixel};
+use smithay::reexports::wayland_server::backend::GlobalId;
+use smithay::utils::Transform;
+use wm_core::{Backend, MonitorInfo, Point, Rect};
+
+/// The outputs besides the panel's (which is `Server::output`): name, wl_output, its global.
+#[derive(Default)]
+pub struct ExtraOutputs {
+    pub(crate) outputs: Vec<(SceneOutput, Output, GlobalId)>,
+    /// The output each mapped window's surface was last told it is on.
+    pub(crate) entered: std::collections::HashMap<u64, String>,
+}
+
+fn contains(r: Rect, p: Point) -> bool {
+    p.x >= r.pos.x && p.y >= r.pos.y && p.x < r.pos.x + r.size.w as i32 && p.y < r.pos.y + r.size.h as i32
+}
+
+/// Where the pointer ends when it moves from `from` to `to` among `outputs` (scene pixels): on an
+/// output, there; between them (a gap, below a shorter one), at the edge of the output it was on.
+pub fn keep_on_outputs(outputs: &[Rect], from: Point, to: Point) -> Point {
+    if outputs.is_empty() || outputs.iter().any(|r| contains(*r, to)) {
+        return to;
+    }
+    let home = outputs.iter().copied().find(|r| contains(*r, from)).unwrap_or(outputs[0]);
+    Point::new(to.x.clamp(home.pos.x, home.pos.x + home.size.w as i32 - 1), to.y.clamp(home.pos.y, home.pos.y + home.size.h as i32 - 1))
+}
+
+impl Server {
+    /// The outputs as the scene has them now (one: the panel).
+    pub fn scene_outputs(&self) -> Vec<SceneOutput> {
+        let backend = self.wm.backend();
+        let mut list: Vec<SceneOutput> = self.extra_outputs.outputs.iter().map(|(o, ..)| o.clone()).collect();
+        let panel = backend.monitors_ref().iter().find(|m| !list.iter().any(|o| o.name == m.name));
+        if let Some(m) = panel {
+            list.insert(0, SceneOutput { primary: m.primary, ..SceneOutput::panel(m.geometry.size, self.scale()) });
+            list[0].rect = m.geometry;
+        }
+        list
+    }
+    /// Make the scene's outputs `outputs` (the panel first or anywhere: it is the one of kind
+    /// Internal). Returns what changed, for the log.
+    pub fn set_scene_outputs(&mut self, outputs: &[SceneOutput]) -> Result<String, String> {
+        if outputs.is_empty() {
+            return Err("no outputs".into());
+        }
+        let before: Vec<MonitorInfo> = self.wm.backend().monitors();
+        // the panel keeps its wl_output (and its name in the scene: SFGOP-0)
+        let monitors: Vec<MonitorInfo> = outputs
+            .iter()
+            .map(|o| MonitorInfo {
+                geometry: o.rect,
+                name: if o.kind == OutputKind::Internal { "SFGOP-0".into() } else { o.name.clone() },
+                identity: Some(o.id.clone()),
+                primary: o.primary,
+            })
+            .collect();
+        let departed: Vec<MonitorInfo> = before.iter().filter(|m| !monitors.iter().any(|n| n.name == m.name)).cloned().collect();
+        let added: Vec<String> = monitors.iter().filter(|m| !before.iter().any(|b| b.name == m.name)).map(|m| m.name.clone()).collect();
+        self.wm.backend_mut().set_outputs(monitors.clone());
+        // wl_output per external; the panel's moves and keeps its scale
+        let dh = self.display_handle.clone();
+        let keep: Vec<String> = outputs.iter().filter(|o| o.kind == OutputKind::External).map(|o| o.name.clone()).collect();
+        let mut i = 0;
+        while i < self.extra_outputs.outputs.len() {
+            if keep.contains(&self.extra_outputs.outputs[i].0.name) {
+                i += 1;
+                continue;
+            }
+            let (gone, output, global) = self.extra_outputs.outputs.remove(i);
+            // its windows' surfaces leave it (before it goes) and are on the panel's until they
+            // are placed again
+            let on_it: Vec<u64> = self.extra_outputs.entered.iter().filter(|(_, n)| **n == gone.name).map(|(id, _)| *id).collect();
+            for id in on_it {
+                if let Some(w) = self.wm.backend().windows.get(&id) {
+                    let surface = w.surface.wl_surface().clone();
+                    output.leave(&surface);
+                    self.output.enter(&surface);
+                }
+                self.extra_outputs.entered.insert(id, "SFGOP-0".into());
+            }
+            dh.disable_global::<Server>(global.clone());
+            dh.remove_global::<Server>(global);
+            eprintln!("WMOUTPUT wl_output {} removed", gone.name);
+        }
+        for o in outputs {
+            let scale = Scale::Fractional(o.scale.factor());
+            let position = Some((o.rect.pos.x, o.rect.pos.y).into());
+            let mode = Mode { size: (o.pixels.0 as i32, o.pixels.1 as i32).into(), refresh: 60_000 };
+            if o.kind == OutputKind::Internal {
+                self.output.change_current_state(None, None, None, position);
+                continue;
+            }
+            match self.extra_outputs.outputs.iter_mut().find(|(e, ..)| e.name == o.name) {
+                Some((e, output, _)) => {
+                    output.change_current_state(Some(mode), None, Some(scale), position);
+                    *e = o.clone();
+                }
+                None => {
+                    let output = Output::new(o.name.clone(), PhysicalProperties { size: (0, 0).into(), subpixel: Subpixel::Unknown, make: "External".into(), model: o.id.clone() });
+                    let global = output.create_global::<Server>(&dh);
+                    output.change_current_state(Some(mode), Some(Transform::Normal), Some(scale), position);
+                    output.set_preferred(mode);
+                    eprintln!("WMOUTPUT wl_output {} added {}x{} {} at {},{}", o.name, o.pixels.0, o.pixels.1, o.scale.label(), o.rect.pos.x, o.rect.pos.y);
+                    self.extra_outputs.outputs.push((o.clone(), output, global));
+                }
+            }
+        }
+        // wm-core: Spaces per display, or the departed outputs' windows rescued
+        if self.wm.spaces_mode() && self.wm.interaction_config().separate_spaces {
+            self.wm.reconcile_display_spaces();
+        } else {
+            for d in &departed {
+                self.wm.rescue_departed_output(d.geometry, &d.name, d.identity.as_deref());
+            }
+            self.wm.restore_evacuated_clients();
+        }
+        self.layers_relayout();
+        // the pointer stays on an output
+        let rects: Vec<Rect> = monitors.iter().map(|m| m.geometry).collect();
+        let pointer = self.wm.backend().pointer;
+        if !rects.iter().any(|r| contains(*r, pointer)) {
+            let p = self.wm.backend().primary_rect();
+            let centre = Point::new(p.pos.x + p.size.w as i32 / 2, p.pos.y + p.size.h as i32 / 2);
+            self.move_pointer_to(centre);
+        }
+        self.sync_surface_outputs();
+        self.renderer.invalidate();
+        let line = format!(
+            "outputs={} added={added:?} departed={:?} screen={}x{} primary={:?}",
+            monitors.iter().map(|m| format!("{}{}@{},{} {}x{}", m.name, if m.primary { "*" } else { "" }, m.geometry.pos.x, m.geometry.pos.y, m.geometry.size.w, m.geometry.size.h)).collect::<Vec<_>>().join(";"),
+            departed.iter().map(|d| d.name.clone()).collect::<Vec<_>>(),
+            self.wm.backend().screen_size().w,
+            self.wm.backend().screen_size().h,
+            self.wm.backend().primary_rect()
+        );
+        eprintln!("WMOUTPUT scene {line}");
+        Ok(line)
+    }
+    /// The pointer to a place (an output came or went): moved as by a motion there.
+    fn move_pointer_to(&mut self, p: Point) {
+        if let Some(input) = self.input.as_mut() {
+            input.position = (f64::from(p.x), f64::from(p.y));
+        }
+        let backend = self.wm.backend_mut();
+        backend.pointer = p;
+        backend.cursor_changed();
+        self.refresh_pointer();
+    }
+    /// Each mapped window's surface told which output it is on (its centre's), when there is more
+    /// than one output; with one, every surface is on the panel's as before.
+    pub(crate) fn sync_surface_outputs(&mut self) {
+        if self.extra_outputs.outputs.is_empty() && self.extra_outputs.entered.is_empty() {
+            return;
+        }
+        let monitors = self.wm.backend().monitors();
+        let windows: Vec<(u64, Rect, smithay::reexports::wayland_server::protocol::wl_surface::WlSurface)> = self
+            .wm
+            .backend()
+            .windows
+            .iter()
+            .filter(|(_, w)| w.mapped)
+            .map(|(id, w)| (*id, w.content, w.surface.wl_surface().clone()))
+            .collect();
+        for (id, content, surface) in windows {
+            let centre = Point::new(content.pos.x + content.size.w as i32 / 2, content.pos.y + content.size.h as i32 / 2);
+            let Some(on) = monitors.iter().find(|m| contains(m.geometry, centre)).or(monitors.iter().find(|m| m.primary)) else { continue };
+            if self.extra_outputs.entered.get(&id) == Some(&on.name) {
+                continue;
+            }
+            let output_of = |name: &str| -> Option<Output> {
+                if name == "SFGOP-0" { Some(self.output.clone()) } else { self.extra_outputs.outputs.iter().find(|(o, ..)| o.name == name).map(|(_, out, _)| out.clone()) }
+            };
+            if let Some(old) = self.extra_outputs.entered.get(&id).and_then(|n| output_of(n)) {
+                old.leave(&surface);
+            } else {
+                self.output.leave(&surface);
+            }
+            if let Some(new) = output_of(&on.name) {
+                new.enter(&surface);
+            }
+            self.extra_outputs.entered.insert(id, on.name.clone());
+        }
+        self.extra_outputs.entered.retain(|id, _| self.wm.backend().windows.contains_key(id));
+    }
+    /// A pointer motion's end among several outputs (input.rs): kept on an output.
+    pub(crate) fn pointer_on_outputs(&self, from: Point, to: Point) -> Point {
+        let monitors = self.wm.backend().monitors_ref();
+        if monitors.len() < 2 {
+            return to;
+        }
+        keep_on_outputs(&monitors.iter().map(|m| m.geometry).collect::<Vec<_>>(), from, to)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn the_pointer_crosses_where_outputs_touch_and_stops_below_the_shorter_one() {
+        let panel = Rect::new(Point::new(0, 0), wm_core::Size::new(2560, 1600));
+        let external = Rect::new(Point::new(2560, 0), wm_core::Size::new(3840, 2160));
+        let outputs = [panel, external];
+        // across the shared edge
+        assert_eq!(keep_on_outputs(&outputs, Point::new(2550, 800), Point::new(2600, 800)), Point::new(2600, 800));
+        // down from the external's lower part to where the panel has nothing: stays on the external
+        assert_eq!(keep_on_outputs(&outputs, Point::new(3000, 2000), Point::new(2500, 2000)), Point::new(2560, 2000));
+        // below the panel from the panel: at its bottom edge
+        assert_eq!(keep_on_outputs(&outputs, Point::new(100, 1590), Point::new(100, 1700)), Point::new(100, 1599));
+        // one output: kept on it (the caller does not ask then: it clamps to the screen as before)
+        assert_eq!(keep_on_outputs(&[panel], Point::new(1, 1), Point::new(5000, 5000)), Point::new(2559, 1599));
+    }
+}
