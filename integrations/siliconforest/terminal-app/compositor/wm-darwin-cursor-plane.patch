--- desk4-007/crates/wm-darwin/tests/wayland_outputs.rs	1969-12-31 16:00:00.000000000 -0800
+++ desk5-003/crates/wm-darwin/tests/wayland_outputs.rs	2026-11-14 20:46:26.000000000 -0800
@@ -0,0 +1,306 @@
+#![cfg(feature = "darwin-backend")]
+//! A virtual second output (DESK5): the scene's outputs set at run time while a real Wayland
+//! client has a window: a wl_output per output, the window's surface entering the output it is
+//! on, the pointer crossing where the outputs touch, the external as the primary, and on unplug
+//! the window brought back onto the panel and the external's wl_output gone. No kernel has a
+//! second display yet (dcpext, CODEX-TB): this is the compositor's half alone.
+use std::{
+    io::Write,
+    os::fd::AsFd,
+    os::unix::net::UnixStream,
+    sync::mpsc,
+    thread,
+    time::{Duration, Instant},
+};
+use wayland_client::{
+    delegate_noop,
+    protocol::{wl_buffer, wl_compositor, wl_output, wl_registry, wl_shm, wl_shm_pool, wl_surface},
+    Connection, Dispatch, QueueHandle,
+};
+use wayland_protocols::xdg::shell::client::{xdg_surface, xdg_toplevel, xdg_wm_base};
+use wm_core::{Point, Rect, Size};
+use wm_darwin::outputs::{OutputKind, SceneOutput};
+use wm_darwin::presenter::Presenter;
+use wm_darwin::server::Server;
+use wm_darwin::smithay::reexports::wayland_server::Display;
+
+type Job = Box<dyn FnOnce(&mut Server) -> String + Send>;
+struct Sink;
+impl Presenter for Sink {
+    fn present(&mut self, _: &tiny_skia::Pixmap) -> Result<(), String> {
+        Ok(())
+    }
+}
+struct Harness {
+    jobs: mpsc::Sender<(Job, mpsc::Sender<String>)>,
+    thread: Option<thread::JoinHandle<()>>,
+}
+impl Harness {
+    fn start(desktop: bool) -> (Self, Connection) {
+        let (server, client) = UnixStream::pair().unwrap();
+        let (jobs, rx) = mpsc::channel::<(Job, mpsc::Sender<String>)>();
+        let thread = thread::spawn(move || {
+            let mut display = Display::<Server>::new().unwrap();
+            let mut state = Server::new(&display.handle(), Size::new(2560, 1600)).unwrap();
+            state.enable_sfhid_seat_caps(&display.handle(), wm_darwin::hid::SeatCaps { keyboard: true, pointer: true }).unwrap();
+            #[cfg(feature = "desktop-shell")]
+            if desktop {
+                state.enable_desktop_shell(wm_theme::FontState::new()).unwrap();
+            }
+            #[cfg(not(feature = "desktop-shell"))]
+            let _ = desktop;
+            Server::add_client(&mut display, server).unwrap();
+            let started = Instant::now();
+            while started.elapsed() < Duration::from_secs(30) {
+                display.dispatch_clients(&mut state).unwrap();
+                let _ = state.repaint(&mut Sink, started.elapsed().as_millis() as u32);
+                display.flush_clients().unwrap();
+                match rx.try_recv() {
+                    Ok((job, reply)) => {
+                        let answer = job(&mut state);
+                        display.flush_clients().unwrap();
+                        if reply.send(answer).is_err() {
+                            break;
+                        }
+                    }
+                    Err(mpsc::TryRecvError::Disconnected) => break,
+                    Err(mpsc::TryRecvError::Empty) => {}
+                }
+                thread::sleep(Duration::from_millis(1));
+            }
+        });
+        (Self { jobs, thread: Some(thread) }, Connection::from_socket(client).unwrap())
+    }
+    fn run(&self, job: impl FnOnce(&mut Server) -> String + Send + 'static) -> String {
+        let (tx, rx) = mpsc::channel();
+        self.jobs.send((Box::new(job), tx)).unwrap();
+        rx.recv_timeout(Duration::from_secs(10)).unwrap()
+    }
+}
+impl Drop for Harness {
+    fn drop(&mut self) {
+        let (tx, _rx) = mpsc::channel();
+        drop(std::mem::replace(&mut self.jobs, tx));
+        if let Some(t) = self.thread.take() {
+            let _ = t.join();
+        }
+    }
+}
+
+#[derive(Default)]
+struct Client {
+    compositor: Option<wl_compositor::WlCompositor>,
+    shm: Option<wl_shm::WlShm>,
+    base: Option<xdg_wm_base::XdgWmBase>,
+    /// (registry name, the bound wl_output, its name event)
+    outputs: Vec<(u32, wl_output::WlOutput, String)>,
+    /// The output names the window's surface was last told it entered.
+    entered: Vec<String>,
+    configured: bool,
+}
+impl Dispatch<wl_registry::WlRegistry, ()> for Client {
+    fn event(s: &mut Self, r: &wl_registry::WlRegistry, e: wl_registry::Event, _: &(), _: &Connection, q: &QueueHandle<Self>) {
+        match e {
+            wl_registry::Event::Global { name, interface, version } => match interface.as_str() {
+                "wl_compositor" => s.compositor = Some(r.bind(name, version.min(6), q, ())),
+                "wl_shm" => s.shm = Some(r.bind(name, 1, q, ())),
+                "xdg_wm_base" => s.base = Some(r.bind(name, 1, q, ())),
+                "wl_output" => {
+                    let output: wl_output::WlOutput = r.bind(name, version.min(4), q, name);
+                    s.outputs.push((name, output, String::new()));
+                }
+                _ => {}
+            },
+            wl_registry::Event::GlobalRemove { name } => s.outputs.retain(|(n, ..)| *n != name),
+            _ => {}
+        }
+    }
+}
+impl Dispatch<wl_output::WlOutput, u32> for Client {
+    fn event(s: &mut Self, _: &wl_output::WlOutput, e: wl_output::Event, global: &u32, _: &Connection, _: &QueueHandle<Self>) {
+        if let wl_output::Event::Name { name } = e {
+            if let Some(o) = s.outputs.iter_mut().find(|(n, ..)| n == global) {
+                o.2 = name;
+            }
+        }
+    }
+}
+impl Dispatch<wl_surface::WlSurface, ()> for Client {
+    fn event(s: &mut Self, _: &wl_surface::WlSurface, e: wl_surface::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        match e {
+            wl_surface::Event::Enter { output } => {
+                let name = s.outputs.iter().find(|(_, o, _)| *o == output).map(|o| o.2.clone()).unwrap_or_default();
+                s.entered.push(name);
+            }
+            wl_surface::Event::Leave { output } => {
+                let name = s.outputs.iter().find(|(_, o, _)| *o == output).map(|o| o.2.clone()).unwrap_or_default();
+                s.entered.retain(|n| *n != name);
+            }
+            _ => {}
+        }
+    }
+}
+impl Dispatch<xdg_wm_base::XdgWmBase, ()> for Client {
+    fn event(_: &mut Self, b: &xdg_wm_base::XdgWmBase, e: xdg_wm_base::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        if let xdg_wm_base::Event::Ping { serial } = e {
+            b.pong(serial);
+        }
+    }
+}
+impl Dispatch<xdg_surface::XdgSurface, ()> for Client {
+    fn event(s: &mut Self, x: &xdg_surface::XdgSurface, e: xdg_surface::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        if let xdg_surface::Event::Configure { serial } = e {
+            x.ack_configure(serial);
+            s.configured = true;
+        }
+    }
+}
+delegate_noop!(Client: ignore wl_compositor::WlCompositor);
+delegate_noop!(Client: ignore wl_shm::WlShm);
+delegate_noop!(Client: ignore wl_shm_pool::WlShmPool);
+delegate_noop!(Client: ignore wl_buffer::WlBuffer);
+delegate_noop!(Client: ignore xdg_toplevel::XdgToplevel);
+
+fn panel(primary: bool) -> SceneOutput {
+    SceneOutput { primary, ..SceneOutput::panel(Size::new(2560, 1600), wm_darwin::scale::Scale::from_120(180).unwrap()) }
+}
+fn external() -> SceneOutput {
+    SceneOutput {
+        name: "DP-1".into(),
+        id: "SAM-0f00-597x336".into(),
+        kind: OutputKind::External,
+        rect: Rect::new(Point::new(2560, 0), Size::new(3840, 2160)),
+        pixels: (3840, 2160),
+        scale: wm_darwin::scale::Scale::from_120(180).unwrap(),
+        logical: (2560, 1440),
+        primary: true,
+    }
+}
+fn content(server: &Server) -> Rect {
+    server.wm.backend().windows.values().find(|w| w.mapped).map(|w| w.content).unwrap_or(Rect::new(Point::new(-1, -1), Size::new(0, 0)))
+}
+fn rect_text(r: Rect) -> String {
+    format!("{} {} {} {}", r.pos.x, r.pos.y, r.size.w, r.size.h)
+}
+fn parse(text: &str) -> Vec<i32> {
+    text.split_whitespace().filter_map(|v| v.parse().ok()).collect()
+}
+
+fn plug_move_unplug(desktop: bool) {
+    let (h, connection) = Harness::start(desktop);
+    let mut queue = connection.new_event_queue();
+    let qh = queue.handle();
+    let mut c = Client::default();
+    connection.display().get_registry(&qh, ());
+    for _ in 0..3 {
+        queue.roundtrip(&mut c).unwrap();
+    }
+    assert_eq!(c.outputs.len(), 1, "one output at start: the panel's");
+    let surface = c.compositor.as_ref().unwrap().create_surface(&qh, ());
+    let xdg = c.base.as_ref().unwrap().get_xdg_surface(&surface, &qh, ());
+    let top = xdg.get_toplevel(&qh, ());
+    top.set_title("outputs".into());
+    surface.commit();
+    while !c.configured {
+        queue.blocking_dispatch(&mut c).unwrap();
+    }
+    let (w, hgt) = (400, 300);
+    let mut file = tempfile::tempfile().unwrap();
+    file.write_all(&[40, 80, 200, 255].repeat(w * hgt)).unwrap();
+    let pool = c.shm.as_ref().unwrap().create_pool(file.as_fd(), (w * hgt * 4) as i32, &qh, ());
+    let buffer = pool.create_buffer(0, w as i32, hgt as i32, (w * 4) as i32, wl_shm::Format::Xrgb8888, &qh, ());
+    surface.attach(Some(&buffer), 0, 0);
+    surface.commit();
+    let settle = |queue: &mut wayland_client::EventQueue<Client>, c: &mut Client| {
+        for _ in 0..4 {
+            queue.roundtrip(c).unwrap();
+            thread::sleep(Duration::from_millis(15));
+        }
+    };
+    settle(&mut queue, &mut c);
+    let on_panel = parse(&h.run(|s| rect_text(content(s))));
+    assert!(on_panel[0] >= 0 && on_panel[0] + on_panel[2] <= 2560, "mapped on the panel: {on_panel:?}");
+    assert_eq!(c.entered, vec!["SFGOP-0".to_string()], "its surface is on the panel's output");
+
+    // plug: the external to the right of the panel, the primary
+    let line = h.run(|s| s.set_scene_outputs(&[panel(false), external()]).unwrap());
+    assert!(line.contains("added=[\"DP-1\"]"), "{line}");
+    settle(&mut queue, &mut c);
+    assert_eq!(c.outputs.len(), 2, "a wl_output per output");
+    assert!(c.outputs.iter().any(|o| o.2 == "DP-1"));
+    let (screen, primary, still) = {
+        let t = h.run(|s| {
+            let b = s.wm.backend();
+            format!("{} {} {} {}", wm_core::Backend::screen_size(b).w, wm_core::Backend::screen_size(b).h, rect_text(b.primary_rect()), rect_text(content(s)))
+        });
+        let v = parse(&t);
+        ((v[0], v[1]), (v[2], v[3], v[4], v[5]), (v[6], v[7]))
+    };
+    assert_eq!(screen, (6400, 2160), "the scene is both outputs");
+    assert_eq!(primary, (2560, 0, 3840, 2160), "the external is the primary");
+    assert_eq!(still, (on_panel[0], on_panel[1]), "the window stays where it was on the panel");
+    let displays = |h: &Harness| h.run(|s| s.wm.display_spaces_snapshot().map_or("none".to_string(), |d| format!("{} connected={}", d.displays.len(), d.displays.iter().filter(|x| x.connected).count())));
+    if desktop {
+        assert_eq!(displays(&h), "2 connected=2", "Spaces per display: the external has its own");
+    }
+
+    // the window to the external: its surface leaves the panel's output and enters the external's
+    let moved = parse(&h.run(|s| {
+        let id = *s.wm.backend().windows.keys().next().unwrap();
+        let client = s.wm.client_for_window(id).unwrap();
+        s.wm.set_client_content_geometry(client, Rect::new(Point::new(4000, 500), Size::new(400, 300)));
+        rect_text(content(s))
+    }));
+    settle(&mut queue, &mut c);
+    assert_eq!((moved[0], moved[1]), (4000, 500));
+    assert_eq!(c.entered, vec!["DP-1".to_string()], "the surface is on the external now");
+
+    // the pointer crosses where the outputs touch, and stops below the panel (the external is taller)
+    let crossed = parse(&h.run(|s| {
+        use wm_darwin::hid::{Event, Motion};
+        s.deliver_hid(Event::Pointer { motion: Motion::Absolute((2550 * 65535 / 6399) as u16, (800 * 65535 / 2159) as u16), buttons: 0, wheel: 0 }, 1).unwrap();
+        for i in 0..4 {
+            s.deliver_hid(Event::Pointer { motion: Motion::Relative(10, 0), buttons: 0, wheel: 0 }, 2 + i).unwrap();
+        }
+        let across = wm_core::Backend::pointer_position(s.wm.backend()).unwrap();
+        // from the external's lower part to the left: below the panel there is nothing
+        s.deliver_hid(Event::Pointer { motion: Motion::Absolute((2600 * 65535 / 6399) as u16, (2000 * 65535 / 2159) as u16), buttons: 0, wheel: 0 }, 10).unwrap();
+        for i in 0..8 {
+            s.deliver_hid(Event::Pointer { motion: Motion::Relative(-10, 0), buttons: 0, wheel: 0 }, 11 + i).unwrap();
+        }
+        let stopped = wm_core::Backend::pointer_position(s.wm.backend()).unwrap();
+        format!("{} {} {} {}", across.x, across.y, stopped.x, stopped.y)
+    }));
+    assert!(crossed[0] > 2560, "crossed onto the external: {crossed:?}");
+    assert_eq!(crossed[2], 2560, "stopped at the external's left edge below the panel: {crossed:?}");
+
+    // unplug: the window comes back onto the panel, the external's wl_output goes
+    let line = h.run(|s| s.set_scene_outputs(&[panel(true)]).unwrap());
+    assert!(line.contains("departed=[\"DP-1\"]"), "{line}");
+    settle(&mut queue, &mut c);
+    let back = parse(&h.run(|s| {
+        let b = s.wm.backend();
+        format!("{} {} {}", rect_text(content(s)), wm_core::Backend::screen_size(b).w, wm_core::Backend::pointer_position(b).unwrap().x)
+    }));
+    assert!(back[0] >= 0 && back[0] + back[2] <= 2560 && back[1] >= 0 && back[1] + back[3] <= 1600, "the window is on the panel again: {back:?}");
+    assert_eq!(back[4], 2560, "the scene is the panel again");
+    assert!(back[5] < 2560, "the pointer is on the panel");
+    assert_eq!(c.outputs.len(), 1, "the external's wl_output is gone");
+    if desktop {
+        assert_eq!(displays(&h), "2 connected=1", "the external's Spaces are kept for its return, its windows on the panel");
+    }
+    assert_eq!(c.entered, vec!["SFGOP-0".to_string()]);
+}
+
+#[test]
+fn a_window_moves_to_a_second_output_and_comes_back_when_it_is_unplugged() {
+    plug_move_unplug(false);
+}
+
+/// The desk's own session (Spaces, separate per display, as macOS): the same, through wm-core's
+/// display Spaces.
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn with_the_desk_each_output_has_its_spaces_and_an_unplugged_ones_windows_come_home() {
+    plug_move_unplug(true);
+}
