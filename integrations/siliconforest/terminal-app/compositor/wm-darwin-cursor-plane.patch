+/// Where the pointer's plane goes and where the image lies in its buffer: the plane always lies
+/// wholly on the screen (the DCP takes no plane that leaves the screen, nor one smaller than
+/// 32x32), so near an edge the image is drawn shifted inside the buffer instead.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CursorPlace {
+    /// The plane at `plane`, the image at `offset` inside the buffer.
+    Plane { plane: Point, offset: Point },
+    /// Nothing of the image is on the screen: the plane off.
+    Hidden,
+    /// The image does not fit the buffer: drawn into the frame.
+    Software,
+}
+pub fn place_cursor(origin: Point, image: (u32, u32), buffer: u32, screen: (u32, u32)) -> CursorPlace {
+    let (w, h) = (image.0 as i32, image.1 as i32);
+    let (sw, sh, b) = (screen.0 as i32, screen.1 as i32, buffer as i32);
+    if w <= 0 || h <= 0 || w > b || h > b || b > sw || b > sh {
+        return CursorPlace::Software;
+    }
+    if origin.x >= sw || origin.y >= sh || origin.x + w <= 0 || origin.y + h <= 0 {
+        return CursorPlace::Hidden;
+    }
+    let plane = Point::new(origin.x.clamp(0, sw - b), origin.y.clamp(0, sh - b));
+    CursorPlace::Plane { plane, offset: Point::new(origin.x - plane.x, origin.y - plane.y) }
+}
