+/// The calling thread to the user-interactive QoS class (DESK5): its timed waits are woken with
+/// the least timer coalescing the kernel applies, so a commit planned for its moment is not made
+/// late by a sleep that overran. Looked up at run time (a libSystem without it: nothing happens).
+pub fn interactive_qos(what: &str) {
+    #[cfg(target_os = "macos")]
+    unsafe {
+        let f = libc::dlsym(libc::RTLD_DEFAULT, c"pthread_set_qos_class_self_np".as_ptr());
+        if f.is_null() {
+            eprintln!("WMPACE {what} thread: pthread_set_qos_class_self_np absent (QoS unchanged)");
+            return;
+        }
+        let set: extern "C" fn(u32, i32) -> i32 = std::mem::transmute(f);
+        let rc = set(0x21, 0); // QOS_CLASS_USER_INTERACTIVE
+        eprintln!("WMPACE {what} thread: QoS user-interactive rc={rc}");
+    }
+    #[cfg(not(target_os = "macos"))]
+    let _ = what;
+}
