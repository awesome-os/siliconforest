+#[cfg(test)]
+mod cursor_plane_tests {
+    use super::*;
+    use std::{cell::RefCell, rc::Rc};
+    use crate::hid::{Event, Motion};
+    /// A renderer with a pointer plane: records what it is asked to do.
+    struct PlaneRenderer {
+        log: Rc<RefCell<Vec<String>>>,
+        staged: bool,
+        takes: bool,
+    }
+    impl Renderer for PlaneRenderer {
+        fn kind(&self) -> RendererKind {
+            RendererKind::Damage
+        }
+        fn render_frame(&mut self, scene: &mut CpuBackend, _: &mut dyn Presenter) -> Result<FrameStats, String> {
+            self.log.borrow_mut().push(format!("render on_plane={}", scene.cursor_on_plane));
+            Ok(FrameStats::default())
+        }
+        fn stage_frame(&mut self, scene: &mut CpuBackend, _: &mut dyn Presenter) -> Result<FrameStats, String> {
+            self.log.borrow_mut().push(format!("stage on_plane={}", scene.cursor_on_plane));
+            self.staged = true;
+            Ok(FrameStats::default())
+        }
+        fn staged(&self) -> bool {
+            self.staged
+        }
+        fn cursor_plane_takes(&self, image: (u32, u32)) -> bool {
+            self.takes && image.0 <= 128 && image.1 <= 128
+        }
+        fn commit(&mut self, cursor: Option<(Point, &wm_theme_api::DecorationBuffer, u64)>) -> Result<bool, String> {
+            self.log.borrow_mut().push(format!("commit {:?}", cursor.map(|c| (c.0.x, c.0.y))));
+            self.staged = false;
+            Ok(true)
+        }
+        fn invalidate(&mut self) {}
+    }
+    struct Sink;
+    impl Presenter for Sink {
+        fn present(&mut self, _: &tiny_skia::Pixmap) -> Result<(), String> {
+            Ok(())
+        }
+    }
+    fn take(log: &Rc<RefCell<Vec<String>>>) -> Vec<String> {
+        std::mem::take(&mut *log.borrow_mut())
+    }
+    #[test]
+    fn a_pointer_only_move_on_the_plane_is_a_commit_without_a_render() {
+        let display = Display::<Server>::new().unwrap();
+        let mut server = Server::new(&display.handle(), Size::new(640, 480)).unwrap();
+        let log = Rc::new(RefCell::new(Vec::new()));
+        server.set_renderer_boxed(Box::new(PlaneRenderer { log: log.clone(), staged: false, takes: true }));
+        server.enable_sfhid_seat_caps(&display.handle(), crate::hid::SeatCaps { keyboard: true, pointer: true }).unwrap();
+        server.repaint(&mut Sink, 0).unwrap();
+        let first = take(&log);
+        assert_eq!(first.first().map(String::as_str), Some("stage on_plane=true"), "{first:?}");
+        assert!(first.iter().any(|l| l.starts_with("commit Some")), "the first frame is committed with the pointer's plane: {first:?}");
+        // the pointer moves: its plane is placed anew, nothing is rendered
+        for (i, x) in [1000u16, 20000, 40000].into_iter().enumerate() {
+            server.deliver_hid(Event::Pointer { motion: Motion::Absolute(x, 30000), buttons: 0, wheel: 0 }, 10 + i as u32).unwrap();
+            server.repaint(&mut Sink, 10 + i as u32).unwrap();
+            let step = take(&log);
+            assert_eq!(step.len(), 1, "one commit, no render: {step:?}");
+            let expect_x = (f64::from(x) * 639.0 / 65535.0).floor() as i32;
+            assert!(step[0].starts_with(&format!("commit Some(({expect_x}, ")), "{step:?}");
+        }
+        // nothing moved: nothing is committed
+        server.repaint(&mut Sink, 20).unwrap();
+        assert!(take(&log).is_empty());
+        // the scene changes and the pointer moves: one staged frame, committed with the pointer
+        server.wm.backend_mut().dirty = true;
+        server.deliver_hid(Event::Pointer { motion: Motion::Absolute(50000, 30000), buttons: 0, wheel: 0 }, 30).unwrap();
+        server.repaint(&mut Sink, 30).unwrap();
+        let step = take(&log);
+        assert_eq!(step.len(), 2, "{step:?}");
+        assert!(step[0] == "stage on_plane=true" && step[1].starts_with("commit Some((487, "), "{step:?}");
+        // the plane not allowed (a recording, or the instrument): the pointer is drawn into frames
+        server.cursor_plane_allowed = false;
+        server.repaint(&mut Sink, 40).unwrap();
+        assert_eq!(take(&log), vec!["render on_plane=false".to_string()]);
+        server.deliver_hid(Event::Pointer { motion: Motion::Absolute(10000, 30000), buttons: 0, wheel: 0 }, 50).unwrap();
+        server.repaint(&mut Sink, 50).unwrap();
+        assert_eq!(take(&log), vec!["render on_plane=false".to_string()], "a move is a rendered frame again");
+        // and back
+        server.cursor_plane_allowed = true;
+        server.repaint(&mut Sink, 60).unwrap();
+        let step = take(&log);
+        assert!(step.first().is_some_and(|l| l == "stage on_plane=true") && step.len() == 2, "{step:?}");
+    }
+    #[test]
+    fn a_frame_read_back_has_the_pointer_of_the_plane_blended_in() {
+        let mut frame = vec![0u8; 4 * 4 * 4];
+        for p in frame.chunks_exact_mut(4) {
+            p.copy_from_slice(&[0, 0, 200, 255]);
+        }
+        let image = wm_theme_api::DecorationBuffer { width: 2, height: 1, pixels: vec![255, 255, 255, 255, 64, 64, 64, 64] };
+        blend_over(&mut frame, (4, 4), Point::new(3, 2), &image);
+        assert_eq!(&frame[(2 * 4 + 3) * 4..(2 * 4 + 3) * 4 + 4], &[255, 255, 255, 255]);
+        assert_eq!(&frame[(2 * 4 + 2) * 4..(2 * 4 + 2) * 4 + 4], &[0, 0, 200, 255], "left of the image unchanged");
+        blend_over(&mut frame, (4, 4), Point::new(0, 0), &image);
+        assert_eq!(&frame[4..8], &[64, 64, 214, 255], "a quarter-covered pixel: source over");
+    }
+}
