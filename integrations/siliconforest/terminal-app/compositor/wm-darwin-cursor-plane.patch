+/// Ask an AppKit application to quit as its menu's Quit does (its own questions, saving): the
+/// item with Command-Q of its menu over its app-menu socket (`$XDG_RUNTIME_DIR/app-menu/<pid>`,
+/// appmenu.rs), which a windowless application still serves; SIGTERM only when it has no socket.
+pub fn quit_mac_app(pid: i32) -> String {
+    let runtime = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from).unwrap_or_else(|| PathBuf::from("/private/var/run/gpu-desktop"));
+    let how = match crate::appmenu::fetch(&runtime, pid) {
+        Ok(menu) => match menu.items.iter().find(|i| i.key == "cmd+q" && !i.flags.contains('d')).or_else(|| menu.items.iter().find(|i| i.depth == 1 && i.title.starts_with("Quit"))) {
+            Some(item) => match crate::appmenu::request(&runtime, pid, &format!("invoke {}", item.id)) {
+                Ok(answer) => format!("menu item {:?} invoked: {answer}", item.title),
+                Err(e) => format!("menu item {:?} not invoked: {e}", item.title),
+            },
+            None => "its menu has no Quit item: nothing sent".to_string(),
+        },
+        Err(e) => {
+            crate::server::kill_pid(pid, libc::SIGTERM);
+            format!("no menu socket ({e}): SIGTERM")
+        }
+    };
+    eprintln!("WMMAC quit pid={pid}: {how}");
+    how
+}
