+/// Premultiplied RGBA (the scene's pictures) to straight alpha (what the DCP blends for an
+/// ARGB8888 plane: linux-aurora `apple_plane_atomic_update` marks only X formats premultiplied).
+pub fn unpremultiply(pixels: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(pixels.len());
+    for p in pixels.chunks_exact(4) {
+        let a = u32::from(p[3]);
+        match a {
+            0 => out.extend_from_slice(&[0, 0, 0, 0]),
+            255 => out.extend_from_slice(p),
+            _ => {
+                let c = |v: u8| ((u32::from(v) * 255 + a / 2) / a).min(255) as u8;
+                out.extend_from_slice(&[c(p[0]), c(p[1]), c(p[2]), p[3]]);
+            }
+        }
+    }
+    out
+}
