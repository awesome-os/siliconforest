+/// A premultiplied RGBA image over an opaque RGBA frame (source over), clipped to the frame.
+pub(crate) fn blend_over(frame: &mut [u8], (fw, fh): (u32, u32), origin: Point, image: &wm_theme_api::DecorationBuffer) {
+    for y in 0..image.height as i32 {
+        let fy = origin.y + y;
+        if fy < 0 || fy >= fh as i32 {
+            continue;
+        }
+        for x in 0..image.width as i32 {
+            let fx = origin.x + x;
+            if fx < 0 || fx >= fw as i32 {
+                continue;
+            }
+            let s = (y as usize * image.width as usize + x as usize) * 4;
+            let d = (fy as usize * fw as usize + fx as usize) * 4;
+            let (Some(src), true) = (image.pixels.get(s..s + 4), d + 4 <= frame.len()) else { continue };
+            let a = u32::from(src[3]);
+            for c in 0..3 {
+                frame[d + c] = (u32::from(src[c]) + (u32::from(frame[d + c]) * (255 - a) + 127) / 255).min(255) as u8;
+            }
+        }
+    }
+}
