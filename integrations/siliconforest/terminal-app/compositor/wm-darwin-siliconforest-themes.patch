--- /dev/null
+++ b/crates/wm-darwin/tests/theme_gallery.rs
@@ -0,0 +1,217 @@
+#![cfg(all(feature = "darwin-backend", feature = "desktop-shell"))]
+//! Host-only, for looking at (THEME): the desk in each SiliconForest theme at the M1 panel's size
+//! and the owner's scale, with windows whose contents are pictures given to it, drawn by the GL
+//! renderer off screen, written as PPM files.
+//!   THEME_GALLERY_OUT=<dir> THEME_GALLERY_SHOTS=<dir> CHONKSTEP_BACKGROUND_DIR=<dir with sf-*.jpg> \
+//!     cargo test -p wm-darwin --features desktop-shell --test theme_gallery -- --ignored
+//! THEME_GALLERY_SHOTS holds `<n>-<title>-<width>x<height>-<x>,<y>.bgra` files (raw B, G, R, x; the
+//! size in panel pixels, the place in panel pixels), drawn in the order of their names.
+use std::{
+    io::Write,
+    os::fd::AsFd,
+    os::unix::net::UnixStream,
+    sync::mpsc,
+    thread,
+    time::{Duration, Instant},
+};
+use wayland_client::{
+    delegate_noop,
+    protocol::{wl_buffer, wl_compositor, wl_registry, wl_shm, wl_shm_pool, wl_surface},
+    Connection, Dispatch, QueueHandle,
+};
+use wayland_protocols::xdg::{
+    decoration::zv1::client::{zxdg_decoration_manager_v1, zxdg_toplevel_decoration_v1},
+    shell::client::{xdg_surface, xdg_toplevel, xdg_wm_base},
+};
+use wm_core::{Backend, Point, Rect, Size};
+use wm_darwin::scale::Scale;
+use wm_darwin::server::Server;
+use wm_darwin::smithay::reexports::wayland_server::Display;
+
+const PANEL: Size = Size { w: 2560, h: 1600 };
+
+#[derive(Default)]
+struct Client {
+    compositor: Option<wl_compositor::WlCompositor>,
+    shm: Option<wl_shm::WlShm>,
+    shell: Option<xdg_wm_base::XdgWmBase>,
+    decoration: Option<zxdg_decoration_manager_v1::ZxdgDecorationManagerV1>,
+}
+impl Dispatch<wl_registry::WlRegistry, ()> for Client {
+    fn event(s: &mut Self, r: &wl_registry::WlRegistry, e: wl_registry::Event, _: &(), _: &Connection, q: &QueueHandle<Self>) {
+        if let wl_registry::Event::Global { name, interface, version } = e {
+            match interface.as_str() {
+                "wl_compositor" => s.compositor = Some(r.bind(name, version.min(5), q, ())),
+                "wl_shm" => s.shm = Some(r.bind(name, 1, q, ())),
+                "xdg_wm_base" => s.shell = Some(r.bind(name, version.min(6), q, ())),
+                "zxdg_decoration_manager_v1" => s.decoration = Some(r.bind(name, 1, q, ())),
+                _ => {}
+            }
+        }
+    }
+}
+impl Dispatch<xdg_wm_base::XdgWmBase, ()> for Client {
+    fn event(_: &mut Self, p: &xdg_wm_base::XdgWmBase, e: xdg_wm_base::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        if let xdg_wm_base::Event::Ping { serial } = e {
+            p.pong(serial);
+        }
+    }
+}
+impl Dispatch<xdg_surface::XdgSurface, ()> for Client {
+    fn event(_: &mut Self, p: &xdg_surface::XdgSurface, e: xdg_surface::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        if let xdg_surface::Event::Configure { serial } = e {
+            p.ack_configure(serial);
+        }
+    }
+}
+delegate_noop!(Client: ignore wl_compositor::WlCompositor);
+delegate_noop!(Client: ignore wl_shm::WlShm);
+delegate_noop!(Client: ignore wl_shm_pool::WlShmPool);
+delegate_noop!(Client: ignore wl_buffer::WlBuffer);
+delegate_noop!(Client: ignore wl_surface::WlSurface);
+delegate_noop!(Client: ignore xdg_toplevel::XdgToplevel);
+delegate_noop!(Client: ignore zxdg_decoration_manager_v1::ZxdgDecorationManagerV1);
+delegate_noop!(Client: ignore zxdg_toplevel_decoration_v1::ZxdgToplevelDecorationV1);
+
+
+struct Memory(Option<tiny_skia::Pixmap>);
+impl wm_darwin::presenter::Presenter for Memory {
+    fn present(&mut self, frame: &tiny_skia::Pixmap) -> Result<(), String> {
+        self.0 = Some(frame.clone());
+        Ok(())
+    }
+}
+
+struct Shot {
+    title: String,
+    size: (i32, i32),
+    at: (i32, i32),
+    pixels: Vec<u8>,
+}
+
+fn shots(dir: &std::path::Path) -> Vec<Shot> {
+    let mut names: Vec<_> = std::fs::read_dir(dir).unwrap().filter_map(|e| e.ok().map(|e| e.path())).filter(|p| p.extension().is_some_and(|e| e == "bgra")).collect();
+    names.sort();
+    names
+        .into_iter()
+        .map(|path| {
+            let stem = path.file_stem().unwrap().to_str().unwrap().to_string();
+            let parts: Vec<&str> = stem.split('-').collect();
+            let (w, h) = parts[parts.len() - 2].split_once('x').unwrap();
+            let (x, y) = parts[parts.len() - 1].split_once(',').unwrap();
+            let title = parts[1..parts.len() - 2].join(" ").replace('_', " ");
+            Shot { title, size: (w.parse().unwrap(), h.parse().unwrap()), at: (x.parse().unwrap(), y.parse().unwrap()), pixels: std::fs::read(&path).unwrap() }
+        })
+        .collect()
+}
+
+#[test]
+#[ignore]
+fn theme_gallery() {
+    let out = std::path::PathBuf::from(std::env::var("THEME_GALLERY_OUT").expect("THEME_GALLERY_OUT"));
+    let shots_dir = std::path::PathBuf::from(std::env::var("THEME_GALLERY_SHOTS").expect("THEME_GALLERY_SHOTS"));
+    let themes: Vec<String> = std::env::var("THEME_GALLERY_THEMES").unwrap_or_else(|_| "sf-clearing,sf-canopy,sf-wafer,sf-dieshot".into()).split(',').map(str::to_string).collect();
+    std::fs::create_dir_all(&out).unwrap();
+    let shots = shots(&shots_dir);
+    let (job_tx, job_rx) = mpsc::channel::<Box<dyn FnOnce(&mut Server, &mut Memory) + Send>>();
+    let (ready_tx, ready_rx) = mpsc::channel();
+    let mut sockets = Vec::new();
+    let mut server_ends = Vec::new();
+    for _ in 0..shots.len() {
+        let (server, client) = UnixStream::pair().unwrap();
+        server_ends.push(server);
+        sockets.push(client);
+    }
+    let first = themes[0].clone();
+    let thread = thread::spawn(move || {
+        let mut display = Display::<Server>::new().unwrap();
+        let mut state = Server::new(&display.handle(), PANEL).unwrap();
+        state.set_renderer_boxed(Box::new(wm_darwin::glrender::GlRenderer::offscreen(PANEL.w, PANEL.h).expect("GLES 3 off screen")));
+        state.set_scale(Scale::from_120(180).unwrap()).unwrap();
+        state.enable_sfhid_seat(&display.handle()).unwrap();
+        state.enable_desktop_shell_with(wm_theme::FontState::new(), Some(&first)).unwrap();
+        for server in server_ends {
+            Server::add_client(&mut display, server).unwrap();
+        }
+        ready_tx.send(()).unwrap();
+        let mut memory = Memory(None);
+        let started = Instant::now();
+        loop {
+            display.dispatch_clients(&mut state).unwrap();
+            state.repaint(&mut memory, started.elapsed().as_millis() as u32).unwrap();
+            display.flush_clients().unwrap();
+            match job_rx.try_recv() {
+                Ok(job) => job(&mut state, &mut memory),
+                Err(mpsc::TryRecvError::Disconnected) => break,
+                Err(mpsc::TryRecvError::Empty) => thread::sleep(Duration::from_micros(300)),
+            }
+        }
+    });
+    ready_rx.recv_timeout(Duration::from_secs(30)).unwrap();
+    let mut clients = Vec::new();
+    for (shot, socket) in shots.iter().zip(sockets) {
+        let connection = Connection::from_socket(socket).unwrap();
+        let mut queue = connection.new_event_queue();
+        let q = queue.handle();
+        let mut client = Client::default();
+        connection.display().get_registry(&q, ());
+        for _ in 0..3 {
+            queue.roundtrip(&mut client).unwrap();
+        }
+        let surface = client.compositor.as_ref().unwrap().create_surface(&q, ());
+        let xdg = client.shell.as_ref().unwrap().get_xdg_surface(&surface, &q, ());
+        let top = xdg.get_toplevel(&q, ());
+        top.set_title(shot.title.clone());
+        let decor = client.decoration.as_ref().unwrap().get_toplevel_decoration(&top, &q, ());
+        decor.set_mode(zxdg_toplevel_decoration_v1::Mode::ServerSide);
+        surface.commit();
+        for _ in 0..3 {
+            queue.roundtrip(&mut client).unwrap();
+        }
+        let (w, h) = shot.size;
+        let mut file = tempfile::tempfile().unwrap();
+        file.write_all(&shot.pixels).unwrap();
+        let pool = client.shm.as_ref().unwrap().create_pool(file.as_fd(), w * h * 4, &q, ());
+        let buffer = pool.create_buffer(0, w, h, w * 4, wl_shm::Format::Xrgb8888, &q, ());
+        surface.attach(Some(&buffer), 0, 0);
+        surface.damage_buffer(0, 0, w, h);
+        surface.commit();
+        for _ in 0..4 {
+            queue.roundtrip(&mut client).unwrap();
+        }
+        clients.push((connection, queue, client, file));
+    }
+    let places: Vec<(i32, i32)> = shots.iter().map(|s| s.at).collect();
+    let run = |job: Box<dyn FnOnce(&mut Server, &mut Memory) + Send>| {
+        let (tx, rx) = mpsc::channel();
+        job_tx.send(Box::new(move |server: &mut Server, memory: &mut Memory| {
+            job(server, memory);
+            tx.send(()).unwrap();
+        })).unwrap();
+        rx.recv_timeout(Duration::from_secs(120)).unwrap();
+    };
+    for theme in themes {
+        let (id, dir, places) = (theme.clone(), out.clone(), places.clone());
+        run(Box::new(move |server, memory| {
+            server.set_desktop_theme(&id).unwrap();
+            let ids: Vec<_> = {
+                let mut ids: Vec<_> = server.wm.clients().map(|(id, client)| (client.window, id)).collect();
+                ids.sort();
+                ids.into_iter().map(|(_, id)| id).collect()
+            };
+            for (id, at) in ids.into_iter().zip(places) {
+                let size = server.wm.client(id).unwrap().geometry.size;
+                server.wm.set_client_content_geometry(id, Rect::new(Point::new(at.0, at.1), size));
+            }
+            server.repaint(memory, 0).unwrap();
+            let shown = server.read_back().unwrap().expect("the GL renderer reads its frame back");
+            let mut file = std::fs::File::create(dir.join(format!("{id}.ppm"))).unwrap();
+            write!(file, "P6\n{} {}\n255\n", PANEL.w, PANEL.h).unwrap();
+            let rgb: Vec<u8> = shown.chunks_exact(4).flat_map(|p| [p[0], p[1], p[2]]).collect();
+            file.write_all(&rgb).unwrap();
+        }));
+    }
+    drop(job_tx);
+    thread.join().unwrap();
+    drop(clients);
+}
