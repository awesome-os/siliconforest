+#[cfg(test)]
+mod tests {
+    use super::*;
+    use wm_core::{Rect, Size};
+
+    fn shadow(blur: u16, radius: u16) -> DecorationShadow {
+        DecorationShadow { rect: Rect::new(Point::new(0, 0), Size::new(10, 10)), radius, offset: Point::new(0, 0), blur, rgba: [10, 20, 30, 200] }
+    }
+
+    #[test]
+    fn the_shadows_pieces_meet_without_a_seam_and_fade_to_nothing() {
+        let mut cache = ShadowCache::default();
+        let tiles = cache.get(&shadow(24, 9));
+        assert!(Rc::ptr_eq(&tiles, &cache.get(&shadow(24, 9))), "one set of pictures per shadow");
+        for (w, h) in [(600, 400), (90, 70), (31, 200)] {
+            let r = DRect::new(200, 150, 200 + w, 150 + h);
+            let bounds = tiles.bounds(r);
+            let (bw, bh) = (bounds.width(), bounds.height() as usize);
+            let mut canvas = vec![0u8; bw as usize * bh * 4];
+            let mut covered = vec![0u8; bw as usize * bh];
+            for piece in tiles.pieces(r) {
+                assert!(piece.1.intersect(bounds) == piece.1, "a piece stays inside the bounds");
+                for y in piece.1.y0..piece.1.y1 {
+                    for x in piece.1.x0..piece.1.x1 {
+                        covered[(y - bounds.y0) as usize * bw as usize + (x - bounds.x0) as usize] += 1;
+                    }
+                }
+                blend_piece(&mut canvas, bw, (bounds.x0, bounds.y0), bounds, &piece);
+            }
+            assert!(covered.iter().all(|n| *n <= 1), "{w}x{h}: no pixel is drawn twice");
+            let alpha = |x: i32, y: i32| canvas[((y - bounds.y0) as usize * bw as usize + (x - bounds.x0) as usize) * 4 + 3];
+            // nothing at the outer edge, and along an edge the shadow never jumps
+            for x in bounds.x0..bounds.x1 {
+                assert!(alpha(x, bounds.y0) <= 2 && alpha(x, bounds.y1 - 1) <= 2, "{w}x{h}: the rim at x={x}");
+            }
+            let row = r.y0 - 3;
+            for x in bounds.x0 + 1..bounds.x1 {
+                let (a, b) = (alpha(x - 1, row), alpha(x, row));
+                assert!(a.abs_diff(b) <= 12, "{w}x{h}: a jump along the top at x={x}: {a} -> {b}");
+            }
+            if w >= 600 {
+                // just outside the middle of an edge: half of the shadow's alpha
+                let mid = alpha(r.x0 + w / 2, r.y0 - 1);
+                assert!((90..=110).contains(&mid), "half the alpha at the edge, got {mid}");
+            }
+        }
+    }
+
+    #[test]
+    fn a_corner_is_cut_to_its_radius_with_the_borders_ring() {
+        let clip = CornerClip { rect: DRect::new(100, 100, 300, 260), radius: 12, border: 1, rgb: [200, 100, 50] };
+        assert_eq!(clip.at(150, 255), (1.0, 0.0), "the straight bottom edge is not touched");
+        assert_eq!(clip.at(100, 200), (1.0, 0.0), "nor the side above the corner");
+        let (cover, _) = clip.at(100, 259);
+        assert_eq!(cover, 0.0, "the corner's tip is outside");
+        let (cover, ring) = clip.at(104, 256);
+        assert!(cover > 0.0 && ring > 0.0, "on the curve: {cover} {ring}");
+        let (w, h) = (400u32, 300usize);
+        let mut data = vec![0u8; w as usize * h * 4];
+        for p in data.chunks_exact_mut(4) {
+            p.copy_from_slice(&[9, 9, 9, 255]);
+        }
+        let keep = CornerKeep::take(clip, &data, w, (0, 0));
+        let mut window = DecorationBuffer { width: 198, height: 159, pixels: vec![255; 198 * 159 * 4] };
+        window.pixels.chunks_exact_mut(4).for_each(|p| p.copy_from_slice(&[255, 255, 255, 255]));
+        for y in 100..260usize {
+            for x in 100..300usize {
+                data[(y * w as usize + x) * 4..][..4].copy_from_slice(&[255, 255, 255, 255]);
+            }
+        }
+        keep.put(&mut data, w, (0, 0));
+        let whole = DRect::new(0, 0, w as i32, h as i32);
+        for (index, (at, picture)) in corner_patches(&clip, Some((&window, Point::new(101, 100)))).into_iter().enumerate() {
+            assert_eq!((picture.width, picture.height), (12, 12));
+            blend_piece(&mut data, w, (0, 0), whole, &(index as u8, DRect::from_xywh(at.x, at.y, 12, 12), &picture, at));
+        }
+        let px = |x: usize, y: usize| &data[(y * w as usize + x) * 4..][..4];
+        assert_eq!(px(100, 259), [9, 9, 9, 255], "what was behind the corner is back");
+        assert_eq!(px(299, 259), [9, 9, 9, 255]);
+        assert_eq!(px(120, 250), [255, 255, 255, 255], "inside the window nothing changed");
+        assert_eq!(px(111, 250), [255, 255, 255, 255], "the content at the square's inner end");
+        assert_eq!(px(150, 259), [255, 255, 255, 255], "(the straight border is the frame's, not drawn here)");
+        // on the curve: the border's colour, part of a pixel
+        let on = px(103, 256);
+        assert!(on[0] > on[2] && on[3] == 255, "the ring is the border's colour over what was behind: {on:?}");
+    }
+}
