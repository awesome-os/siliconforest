diff --git a/crates/wm-darwin/src/motion.rs b/crates/wm-darwin/src/motion.rs
new file mode 100644
index 0000000..4c0dd3f
--- /dev/null
+++ b/crates/wm-darwin/src/motion.rs
@@ -0,0 +1,145 @@
+//! How the desk moves (THEME, 17 November 2026): a window fades in while rising a few points
+//! when it appears, and a change of theme cross-fades, each as the theme in use says
+//! (`wm_theme::modern::WindowChrome`: `open_ms`, `open_rise`, `open_curve`, `switch_ms`).
+//! Also here: the theme's `effects` (shadows, rounded lower corners) told to the scene.
+//!
+//! Nothing runs while nothing moves: a window that appears is in `Motion::appear` for its
+//! `open_ms` (at most 400 ms), a theme change keeps one picture of the screen for its
+//! `switch_ms`. Only the session on a display moves (`Motion::live`, set by the desktop's entry;
+//! policy `motion=off` stops it): the host tests' frames are the scene, at rest.
+use crate::server::Server;
+use std::collections::{HashMap, HashSet};
+use std::time::Instant;
+
+#[derive(Default)]
+pub struct Motion {
+    /// The session is on a display: windows appear and themes change in time.
+    pub live: bool,
+    /// Windows that had a picture at the last look.
+    known: HashSet<u64>,
+    seen_once: bool,
+    appear: HashMap<u64, Instant>,
+    /// The theme (id, appearance) the desk wore at the last look.
+    theme: Option<(String, wm_theme::Appearance)>,
+    /// A theme change being shown: since when (`None` until the first frame of the new look
+    /// is out: dressing the desk takes longer than a frame), for how many milliseconds.
+    fade: Option<(Option<Instant>, u16)>,
+    fade_armed: bool,
+    /// The cross-fade of the theme worn at the last look (leaving it fades as entering it did).
+    switch_ms: u16,
+    /// Counted for the record: windows that appeared in time, theme changes cross-faded.
+    pub appeared: u64,
+    pub faded: u64,
+}
+
+/// 0..1 -> 0..1, fast first: `curve` 3 cubic, 5 quint, 10 exponential.
+pub(crate) fn ease_out(t: f32, curve: u8) -> f32 {
+    let t = t.clamp(0.0, 1.0);
+    match curve {
+        10 => 1.0 - (2f32.powf(-10.0 * t) - 2f32.powf(-10.0)) / (1.0 - 2f32.powf(-10.0)),
+        5 => 1.0 - (1.0 - t).powi(5),
+        _ => 1.0 - (1.0 - t).powi(3),
+    }
+}
+
+impl Server {
+    /// Once a frame, after the desktop's own work (a menu's theme pick is applied by then) and
+    /// before the frame is drawn.
+    pub(crate) fn motion_sync(&mut self) {
+        #[cfg(feature = "desktop-shell")]
+        {
+            let Some((id, appearance, window)) = self.desktop.as_ref().map(|d| {
+                let theme = d.shell.theme();
+                (theme.id.clone(), theme.appearance, theme.chrome.map(|c| c.window).unwrap_or_default())
+            }) else {
+                return;
+            };
+            let now = Instant::now();
+            let moving = self.motion.live && self.policy.now.motion;
+            let backend = self.wm.backend_mut();
+            if backend.effects != window.effects {
+                backend.effects = window.effects;
+                backend.dirty = true;
+            }
+            let wears = Some((id, appearance));
+            if self.motion.theme != wears {
+                let first = self.motion.theme.is_none();
+                self.motion.theme = wears;
+                self.wm.backend_mut().shadows.borrow_mut().clear();
+                let ms = window.switch_ms.max(self.motion.switch_ms);
+                self.motion.switch_ms = window.switch_ms;
+                if moving && !first && ms > 0 && self.renderer.fade_begin() {
+                    self.motion.fade = Some((None, ms));
+                    self.motion.faded += 1;
+                    eprintln!("WMMOTION theme change cross-fades over {ms} ms (the {}th)", self.motion.faded);
+                }
+            }
+            // windows that have a picture now and had none at the last look appear
+            let backend = self.wm.backend_mut();
+            let shown: HashSet<u64> = backend.windows.iter().filter(|(_, w)| w.mapped && w.image.is_some()).map(|(id, _)| *id).collect();
+            if moving && self.motion.seen_once && window.open_ms > 0 {
+                for id in shown.difference(&self.motion.known) {
+                    self.motion.appear.insert(*id, now);
+                    self.motion.appeared += 1;
+                    if self.motion.appeared <= 3 || self.motion.appeared % 50 == 0 {
+                        eprintln!("WMMOTION window {id} appears over {} ms rising {} pt (the {}th)", window.open_ms, window.open_rise, self.motion.appeared);
+                    }
+                }
+            }
+            self.motion.known = shown;
+            self.motion.seen_once = true;
+            let rise = f32::from(window.open_rise) * backend.scale.factor() as f32;
+            let (open_ms, curve) = (f32::from(window.open_ms.max(1)), window.open_curve);
+            let known = &self.motion.known;
+            self.motion.appear.retain(|id, since| moving && known.contains(id) && now.duration_since(*since).as_secs_f32() * 1000.0 < open_ms);
+            if !backend.appearing.is_empty() || !self.motion.appear.is_empty() {
+                backend.appearing.clear();
+                for (id, since) in &self.motion.appear {
+                    let e = ease_out(now.duration_since(*since).as_secs_f32() * 1000.0 / open_ms, curve);
+                    backend.appearing.insert(*id, ((e * 255.0).round() as u8, ((1.0 - e) * rise).round() as i32));
+                }
+                backend.dirty = true;
+            }
+            if let Some((since, ms)) = self.motion.fade {
+                let Some(since) = since else {
+                    // the new look's first frame is drawn under the whole old picture; time runs from the next
+                    if self.motion.fade_armed {
+                        self.motion.fade = Some((Some(now), ms));
+                        self.motion.fade_armed = false;
+                    } else {
+                        self.motion.fade_armed = true;
+                    }
+                    self.wm.backend_mut().dirty = true;
+                    return;
+                };
+                let t = now.duration_since(since).as_secs_f32() * 1000.0 / f32::from(ms.max(1));
+                if t >= 1.0 || !moving {
+                    self.motion.fade = None;
+                    self.renderer.fade_set(None);
+                } else {
+                    // the old picture leaves evenly at first and gently at the end
+                    self.renderer.fade_set(Some(((1.0 - ease_out(t, 3)) * 255.0).round() as u8));
+                }
+                self.wm.backend_mut().dirty = true;
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::ease_out;
+    #[test]
+    fn the_curves_start_at_nothing_end_whole_and_never_go_back() {
+        for curve in [3u8, 5, 10] {
+            assert!(ease_out(0.0, curve).abs() < 1e-6 && (ease_out(1.0, curve) - 1.0).abs() < 1e-6, "curve {curve}");
+            let mut last = 0.0;
+            for step in 0..=60 {
+                let v = ease_out(step as f32 / 60.0, curve);
+                assert!(v >= last - 1e-6 && (0.0..=1.0).contains(&v), "curve {curve} at {step}");
+                last = v;
+            }
+            assert!(ease_out(0.5, curve) > 0.8, "fast first: curve {curve}");
+        }
+    }
+}
