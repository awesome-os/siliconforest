+    });
+    let _ = harness.frame("washi, moving".into());
+    harness.theme("sf-canopy");
+    // the first frames of the new look carry the old picture
+    let during = harness.run(|server, out| {
+        server.repaint(out, 0).unwrap();
+        server.repaint(out, 0).unwrap();
+        thread::sleep(Duration::from_millis(60));
+        server.repaint(out, 0).unwrap();
+        server.read_back().unwrap().unwrap()
+    });
+    assert!(during != before && during != fresh, "a frame between the two looks is neither");
+    thread::sleep(Duration::from_millis(700));
+    let after = harness.frame("sf-canopy after the fade".into());
+    if let Some(diff) = difference(&after, &fresh) {
+        panic!("after the cross-fade the picture is not the new theme's: {diff}");
+    }
+    let (faded, appeared) = {
+        let counts = harness.run(|server, _| vec![server.motion.faded as u8, server.motion.appeared as u8]);
+        (counts[0], counts[1])
+    };
+    assert_eq!((faded, appeared), (1, 0), "one cross-fade; the windows were there before");
+}
