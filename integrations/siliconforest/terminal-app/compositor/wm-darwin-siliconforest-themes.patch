diff --git a/crates/wm-darwin/src/effects.rs b/crates/wm-darwin/src/effects.rs
new file mode 100644
index 0000000..2b4eac8
--- /dev/null
+++ b/crates/wm-darwin/src/effects.rs
@@ -0,0 +1,428 @@
+//! What the desk draws around a window for a theme that asks for it (THEME, 17 November 2026;
+//! `wm_theme::modern::WindowChrome::effects`): a soft shadow and rounded lower corners.
+//!
+//! The shadow is eight pieces of pictures made once for a theme's shadow (radius, blur, colour):
+//! four corner tiles and four edge strips one pixel long that the renderers stretch (their
+//! sampling clamps at an image's edge). No pass over the screen, no blur at run time: a frame
+//! draws the pieces that lie in what it repaints, blended like any other picture. Under the
+//! window itself nothing is drawn (a window covers its shadow there).
+//!
+//! The lower corners are cut where the window's pixels are drawn (the upper ones are part of
+//! the title band's picture): `CornerClip` says where the two corner squares are; a renderer
+//! multiplies what it draws there by the corner's coverage and draws the border's ring.
+use crate::damage::DRect;
+use std::rc::Rc;
+use wm_core::Point;
+use wm_theme_api::{DecorationBuffer, DecorationShadow, DecorationShape};
+
+/// The pictures of one shadow. `spread` is how far it reaches outside its rectangle.
+pub(crate) struct ShadowTiles {
+    /// Top left, top right, bottom left, bottom right: `tile` square.
+    corners: [DecorationBuffer; 4],
+    /// Top and bottom: 1 wide, `2 * spread` high; left and right: `2 * spread` wide, 1 high.
+    edges: [DecorationBuffer; 4],
+    tile: u32,
+    pub spread: u32,
+    /// What the tiles were made for, and a number that differs for every such key.
+    key: (u16, u16, [u8; 4]),
+    pub id: u64,
+}
+
+/// One piece: which of the eight it is, the output rectangle it covers, its picture, where the
+/// picture's texel 0,0 is.
+pub(crate) type Piece<'a> = (u8, DRect, &'a DecorationBuffer, Point);
+
+impl ShadowTiles {
+    /// Premultiplied pictures of `rgba` under a rounded rectangle blurred by `blur` (a CSS blur:
+    /// sigma is half of it), cut off where the shadow is under one 8-bit step.
+    fn new(radius: u16, blur: u16, rgba: [u8; 4], id: u64) -> Self {
+        let sigma = (f32::from(blur) / 2.0).max(0.5);
+        let spread = (sigma * 2.5).ceil() as usize + 1;
+        let radius = usize::from(radius);
+        // the corner's picture: `spread` outside, the corner's radius and `spread` inside
+        let tile = radius + 2 * spread;
+        // coverage of a rounded rectangle's top-left corner whose other edges are far away
+        let n = tile + spread;
+        let mut mask = vec![0f32; n * n];
+        for y in 0..n {
+            for x in 0..n {
+                let (px, py) = (x as f32 + 0.5 - spread as f32, y as f32 + 0.5 - spread as f32);
+                let r = radius as f32;
+                let inside = if px < 0.0 || py < 0.0 {
+                    0.0
+                } else if px < r && py < r {
+                    let d = ((r - px).powi(2) + (r - py).powi(2)).sqrt();
+                    (r + 0.5 - d).clamp(0.0, 1.0)
+                } else {
+                    1.0
+                };
+                mask[y * n + x] = inside;
+            }
+        }
+        let kernel: Vec<f32> = {
+            let k: Vec<f32> = (0..=2 * spread).map(|i| (-((i as f32 - spread as f32).powi(2)) / (2.0 * sigma * sigma)).exp()).collect();
+            let sum: f32 = k.iter().sum();
+            k.into_iter().map(|v| v / sum).collect()
+        };
+        let pass = |src: &[f32], horizontal: bool| -> Vec<f32> {
+            let mut out = vec![0f32; n * n];
+            for y in 0..n {
+                for x in 0..n {
+                    let mut acc = 0.0;
+                    for (i, k) in kernel.iter().enumerate() {
+                        let o = i as isize - spread as isize;
+                        // before the picture there is no shadow; after it the rectangle goes on
+                        let (sx, sy) = if horizontal { (x as isize + o, y as isize) } else { (x as isize, y as isize + o) };
+                        let v = if sx < 0 || sy < 0 { 0.0 } else { src[(sy as usize).min(n - 1) * n + (sx as usize).min(n - 1)] };
+                        acc += v * k;
+                    }
+                    out[y * n + x] = acc;
+                }
+            }
+            out
+        };
+        let blurred = pass(&pass(&mask, true), false);
+        let texel = |v: f32| -> [u8; 4] {
+            let a = (v.clamp(0.0, 1.0) * f32::from(rgba[3])).round();
+            let c = |channel: u8| (f32::from(channel) * a / 255.0).round() as u8;
+            [c(rgba[0]), c(rgba[1]), c(rgba[2]), a as u8]
+        };
+        let picture = |w: usize, h: usize, at: &dyn Fn(usize, usize) -> f32| -> DecorationBuffer {
+            let mut pixels = Vec::with_capacity(w * h * 4);
+            for y in 0..h {
+                for x in 0..w {
+                    pixels.extend_from_slice(&texel(at(x, y)));
+                }
+            }
+            DecorationBuffer { width: w as u32, height: h as u32, pixels }
+        };
+        let corner = |x: usize, y: usize| blurred[y * n + x];
+        let corners = [
+            picture(tile, tile, &|x, y| corner(x, y)),
+            picture(tile, tile, &|x, y| corner(tile - 1 - x, y)),
+            picture(tile, tile, &|x, y| corner(x, tile - 1 - y)),
+            picture(tile, tile, &|x, y| corner(tile - 1 - x, tile - 1 - y)),
+        ];
+        // an edge far from the corners: the picture's last column, going in from outside
+        let profile = |i: usize| blurred[i * n + (n - 1)];
+        let band = 2 * spread;
+        let edges = [
+            picture(1, band, &|_, y| profile(y)),
+            picture(1, band, &|_, y| profile(band - 1 - y)),
+            picture(band, 1, &|x, _| profile(x)),
+            picture(band, 1, &|x, _| profile(band - 1 - x)),
+        ];
+        Self { corners, edges, tile: tile as u32, spread: spread as u32, key: (radius as u16, blur, rgba), id }
+    }
+
+    /// Everything the shadow of the rectangle `r` (the shadow's own: the window's, moved by the
+    /// shadow's offset) can touch.
+    pub fn bounds(&self, r: DRect) -> DRect {
+        let s = self.spread as i32;
+        DRect::new(r.x0 - s, r.y0 - s, r.x1 + s, r.y1 + s)
+    }
+
+    /// The pieces for the shadow rectangle `r`. A rectangle smaller than two tiles gets each
+    /// corner's picture as far as its middle (the pictures are of a rectangle with far edges: a
+    /// small one's shadow comes out a little full, and whole).
+    pub fn pieces(&self, r: DRect) -> Vec<Piece<'_>> {
+        if r.is_empty() {
+            return Vec::new();
+        }
+        let (s, t) = (self.spread as i32, self.tile as i32);
+        let (mx, my) = (r.x0 + (r.x1 - r.x0) / 2, r.y0 + (r.y1 - r.y0) / 2);
+        let (ox0, oy0, ox1, oy1) = (r.x0 - s, r.y0 - s, r.x1 + s, r.y1 + s);
+        // where the corner pictures end along the edges
+        let (cx0, cx1) = ((ox0 + t).min(mx), (ox1 - t).max(mx));
+        let (cy0, cy1) = ((oy0 + t).min(my), (oy1 - t).max(my));
+        let (c, e) = (&self.corners, &self.edges);
+        let all: [(DRect, &DecorationBuffer, Point); 8] = [
+            (DRect::new(ox0, oy0, cx0, cy0), &c[0], Point::new(ox0, oy0)),
+            (DRect::new(cx1, oy0, ox1, cy0), &c[1], Point::new(ox1 - t, oy0)),
+            (DRect::new(ox0, cy1, cx0, oy1), &c[2], Point::new(ox0, oy1 - t)),
+            (DRect::new(cx1, cy1, ox1, oy1), &c[3], Point::new(ox1 - t, oy1 - t)),
+            (DRect::new(cx0, oy0, cx1, (oy0 + 2 * s).min(my)), &e[0], Point::new(cx0, oy0)),
+            (DRect::new(cx0, (oy1 - 2 * s).max(my), cx1, oy1), &e[1], Point::new(cx0, oy1 - 2 * s)),
+            (DRect::new(ox0, cy0, (ox0 + 2 * s).min(mx), cy1), &e[2], Point::new(ox0, cy0)),
+            (DRect::new((ox1 - 2 * s).max(mx), cy0, ox1, cy1), &e[3], Point::new(ox1 - 2 * s, cy0)),
+        ];
+        all.into_iter().enumerate().filter(|(_, (rect, _, _))| !rect.is_empty()).map(|(slot, (rect, image, origin))| (slot as u8, rect, image, origin)).collect()
+    }
+
+    /// Bytes of pictures held (for the record of what a theme costs).
+    pub fn bytes(&self) -> usize {
+        self.corners.iter().chain(self.edges.iter()).map(|b| b.pixels.len()).sum()
+    }
+}
+
+/// The shadows' pictures, one set per shadow in use (a theme has two: with and without focus).
+#[derive(Default)]
+pub(crate) struct ShadowCache {
+    sets: Vec<Rc<ShadowTiles>>,
+    next: u64,
+}
+
+impl ShadowCache {
+    pub fn get(&mut self, shadow: &DecorationShadow) -> Rc<ShadowTiles> {
+        let key = (shadow.radius, shadow.blur, shadow.rgba);
+        if let Some(found) = self.sets.iter().find(|t| t.key == key) {
+            return found.clone();
+        }
+        if self.sets.len() >= 4 {
+            self.sets.remove(0);
+        }
+        self.next += 1;
+        let tiles = Rc::new(ShadowTiles::new(shadow.radius, shadow.blur, shadow.rgba, self.next));
+        self.sets.push(tiles.clone());
+        tiles
+    }
+    pub fn clear(&mut self) {
+        self.sets.clear();
+    }
+    pub fn bytes(&self) -> usize {
+        self.sets.iter().map(|t| t.bytes()).sum()
+    }
+}
+
+/// A window's two lower corners: `rect` is the window's outline on the output.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct CornerClip {
+    pub rect: DRect,
+    pub radius: u16,
+    pub border: u16,
+    pub rgb: [u8; 3],
+}
+
+impl CornerClip {
+    pub fn of(shape: &DecorationShape, frame: Point) -> Option<Self> {
+        (shape.radius > 0).then(|| Self {
+            rect: DRect::from_rect(shape.rect).translate(frame.x, frame.y),
+            radius: shape.radius,
+            border: shape.border,
+            rgb: shape.border_rgb,
+        })
+    }
+    /// The two corner squares.
+    pub fn squares(&self) -> [DRect; 2] {
+        let r = i32::from(self.radius);
+        let c = self.rect;
+        [DRect::new(c.x0, c.y1 - r, c.x0 + r, c.y1), DRect::new(c.x1 - r, c.y1 - r, c.x1, c.y1)]
+    }
+    /// At the pixel `(x, y)` of a corner square: how much of the pixel the outline covers and how
+    /// much of it is the border's ring. Outside the squares: (1, 0).
+    pub fn at(&self, x: i32, y: i32) -> (f32, f32) {
+        let r = f32::from(self.radius);
+        let c = self.rect;
+        let py = y as f32 + 0.5 - (c.y1 as f32 - r);
+        if py <= 0.0 || y >= c.y1 {
+            return (1.0, 0.0);
+        }
+        let px = x as f32 + 0.5;
+        let dx = if px < c.x0 as f32 + r { c.x0 as f32 + r - px } else if px > c.x1 as f32 - r { px - (c.x1 as f32 - r) } else { 0.0 };
+        if dx <= 0.0 || x < c.x0 || x >= c.x1 {
+            return (1.0, 0.0);
+        }
+        let d = (dx * dx + py * py).sqrt();
+        ((r + 0.5 - d).clamp(0.0, 1.0), (d - (r - f32::from(self.border)) + 0.5).clamp(0.0, 1.0))
+    }
+}
+
+/// What a window's pieces are drawn with (THEME): `alpha` under 255 while it appears (the GPU
+/// renderer; the CPU ones draw it whole), its lower corners' cut. `patched`: the corner squares
+/// are left out of the piece altogether and two small pictures of them follow
+/// (`corner_patches`: a window whose pixels the desk holds); else the GPU renderer's shader cuts
+/// the piece as it draws it (a client's GPU buffer, which only it can read).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Fx {
+    pub alpha: u8,
+    pub clip: Option<CornerClip>,
+    pub patched: bool,
+}
+
+impl Fx {
+    pub const NONE: Fx = Fx { alpha: 255, clip: None, patched: false };
+}
+
+/// The pictures of a window's two lower corner squares: the window's own pixels there (its
+/// content, its frame's border), the border's ring on the curve, cut to the corner's coverage,
+/// premultiplied. Drawn over what is behind the window like any picture: the same pixels from
+/// every renderer. `content`: the window's picture and where its pixel 0,0 is on the output.
+pub(crate) fn corner_patches(clip: &CornerClip, content: Option<(&DecorationBuffer, Point)>) -> [(Point, DecorationBuffer); 2] {
+    let border = i32::from(clip.border);
+    clip.squares().map(|square| {
+        let (w, h) = (square.width(), square.height());
+        let mut pixels = Vec::with_capacity(w as usize * h as usize * 4);
+        for y in square.y0..square.y1 {
+            for x in square.x0..square.x1 {
+                let inside = content.and_then(|(image, at)| {
+                    let (lx, ly) = (x - at.x, y - at.y);
+                    (lx >= 0 && ly >= 0 && lx < image.width as i32 && ly < image.height as i32).then(|| {
+                        let i = (ly as usize * image.width as usize + lx as usize) * 4;
+                        [image.pixels[i], image.pixels[i + 1], image.pixels[i + 2], image.pixels[i + 3]]
+                    })
+                });
+                let on_border = x < clip.rect.x0 + border || x >= clip.rect.x1 - border || y >= clip.rect.y1 - border;
+                let own = match inside {
+                    Some(pixel) => pixel,
+                    None if on_border => [clip.rgb[0], clip.rgb[1], clip.rgb[2], 255],
+                    None => [0, 0, 0, 0],
+                };
+                let (cover, ring) = clip.at(x, y);
+                let line = [clip.rgb[0], clip.rgb[1], clip.rgb[2], 255];
+                for c in 0..4 {
+                    let v = f32::from(own[c]) + (f32::from(line[c]) - f32::from(own[c])) * ring;
+                    pixels.push((v * cover).round().clamp(0.0, 255.0) as u8);
+                }
+            }
+        }
+        (Point::new(square.x0, square.y0), DecorationBuffer { width: w, height: h, pixels })
+    })
+}
+
+/// The CPU renderers' corner cut: the pixels of a window's two corner squares are kept before
+/// the window is drawn and put back afterwards (the corner pictures are drawn over them then).
+pub(crate) struct CornerKeep {
+    pub clip: CornerClip,
+    saved: Vec<(i32, i32, [u8; 4])>,
+}
+
+impl CornerKeep {
+    /// `data` is a picture `width` wide whose pixel 0,0 is the output's `origin`.
+    pub fn take(clip: CornerClip, data: &[u8], width: u32, origin: (i32, i32)) -> Self {
+        let height = (data.len() / 4 / width.max(1) as usize) as i32;
+        let mut saved = Vec::new();
+        for square in clip.squares() {
+            for y in square.y0..square.y1 {
+                for x in square.x0..square.x1 {
+                    let (lx, ly) = (x - origin.0, y - origin.1);
+                    if lx < 0 || ly < 0 || lx >= width as i32 || ly >= height {
+                        continue;
+                    }
+                    let i = (ly as usize * width as usize + lx as usize) * 4;
+                    saved.push((x, y, [data[i], data[i + 1], data[i + 2], data[i + 3]]));
+                }
+            }
+        }
+        Self { clip, saved }
+    }
+    /// After the window was drawn: its corner squares as they were before it.
+    pub fn put(&self, data: &mut [u8], width: u32, origin: (i32, i32)) {
+        for (x, y, before) in &self.saved {
+            let i = ((*y - origin.1) as usize * width as usize + (*x - origin.0) as usize) * 4;
+            data[i..i + 4].copy_from_slice(before);
+        }
+    }
+}
+
+/// Source-over of one piece onto 8-bit premultiplied pixels, in the arithmetic a GPU's blend has
+/// (`src + dst * (1 - a)`, rounded once): the CPU renderers' shadow is the GPU's to the bit.
+/// `data` is `width` wide with its pixel 0,0 at the output's `origin`; `only` bounds what is drawn.
+pub(crate) fn blend_piece(data: &mut [u8], width: u32, origin: (i32, i32), only: DRect, piece: &Piece<'_>) {
+    let (_, rect, image, at) = piece;
+    let height = (data.len() / 4 / width.max(1) as usize) as i32;
+    let r = rect.intersect(only).intersect(DRect::new(origin.0, origin.1, origin.0 + width as i32, origin.1 + height));
+    for y in r.y0..r.y1 {
+        let sy = (y - at.y).clamp(0, image.height as i32 - 1) as usize;
+        for x in r.x0..r.x1 {
+            let sx = (x - at.x).clamp(0, image.width as i32 - 1) as usize;
+            let s = &image.pixels[(sy * image.width as usize + sx) * 4..][..4];
+            if s[3] == 0 {
+                continue;
+            }
+            let i = ((y - origin.1) as usize * width as usize + (x - origin.0) as usize) * 4;
+            let keep = 255 - u32::from(s[3]);
+            for c in 0..4 {
+                let d = u32::from(data[i + c]);
+                data[i + c] = (u32::from(s[c]) + (d * keep + 127) / 255).min(255) as u8;
+            }
+        }
+    }
+}
