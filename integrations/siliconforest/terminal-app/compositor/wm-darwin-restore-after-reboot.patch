+/// DESK9: when this boot began (unix ms, from the monotonic clock; good to a few ms).
+pub fn boot_unix_ms() -> u128 {
+    let mut t = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut t) };
+    unix_ms().saturating_sub(t.tv_sec as u128 * 1000 + t.tv_nsec as u128 / 1_000_000)
+}
+
+/// DESK9: the applications to open again in a new boot, from the copy the boot before kept (`text`, with its
+/// `boot=` field): those the desk had opened that had windows, when the boot before is another one, went down
+/// less than 30 minutes ago and not for a power-off or log-out.
+pub fn plan_after_reboot(text: &str, now_ms: u128, boot_ms: u128) -> (Vec<Record>, Vec<(Record, &'static str)>) {
+    let Some((records, updated, ended)) = parse(text) else { return (Vec::new(), Vec::new()) };
+    let header = text.lines().next().unwrap_or("");
+    let before: Option<u128> = header.split_whitespace().find_map(|f| f.strip_prefix("boot=")?.parse().ok());
+    let same_boot = before.is_none_or(|b| b.abs_diff(boot_ms) < 60_000);
+    let old = now_ms.saturating_sub(updated) > 30 * 60_000;
+    let down = matches!(ended.as_str(), "poweroff" | "shutdown" | "logout");
+    let mut open = Vec::new();
+    let mut skipped = Vec::new();
+    let mut seen = HashSet::new();
+    for r in records.into_iter().filter(|r| r.windows > 0) {
+        let why = if same_boot {
+            Some("the same boot (a relaunch: the runtime file decides)")
+        } else if old {
+            Some("the machine went down more than 30 minutes ago")
+        } else if down {
+            Some("the session ended with a power-off or log-out")
+        } else if !r.desk {
+            Some("not opened by the desk (a shell's or an agent's instance)")
+        } else if !seen.insert(r.app_id.to_ascii_lowercase()) {
+            Some("another process of the same application is opened already")
+        } else {
+            None
+        };
+        match why {
+            Some(why) => skipped.push((r, why)),
+            None => open.push(r),
+        }
+    }
+    (open, skipped)
+}
+
