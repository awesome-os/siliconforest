+/// DESK10 (Firefox on the M1: the desk kept "5 types, 0 bytes" and the paste after Firefox quit was empty): a copying
+/// client that answers the desk's first ask - made the moment it set the clipboard - with nothing for every type is
+/// asked again while it lives, and what it gives then is what the next client pastes after it quit.
+#[test]
+#[cfg(feature="desktop-shell")]
+fn a_clipboard_first_answered_with_nothing_is_asked_again_and_kept(){
+    let(h,a)=Harness::with_input(true);let(tx,rx)=mpsc::channel();h.tx.send(Request::Desktop(tx)).unwrap();rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    {
+        let(mut qa,mut ca,_sa,_xa,_ta)=map_client(&a,"late-copier");
+        qa.roundtrip(&mut ca).unwrap();
+        let source=ca.data_manager.as_ref().unwrap().create_data_source(&qa.handle(),());
+        source.offer("text/plain;charset=utf-8".into());
+        ca.data_device.as_ref().unwrap().set_selection(Some(&source),0);
+        // the first ask: answered with nothing (the pipe closed at once)
+        let started=Instant::now();
+        while ca.send_requests.is_empty() {qa.roundtrip(&mut ca).unwrap();h.snapshot();assert!(started.elapsed()<Duration::from_secs(3),"the desk asks at once");}
+        ca.send_requests.clear();
+        // asked again within a second, answered now
+        let started=Instant::now();
+        while ca.send_requests.is_empty() {qa.roundtrip(&mut ca).unwrap();h.snapshot();std::thread::sleep(Duration::from_millis(20));assert!(started.elapsed()<Duration::from_secs(3),"the desk asks again");}
+        for (_,fd) in ca.send_requests.drain(..) {std::fs::File::from(fd).write_all(b"ready late").unwrap();}
+        qa.roundtrip(&mut ca).unwrap();
+        std::thread::sleep(Duration::from_millis(200));
+        drop(source);
+    }
+    drop(a);
+    std::thread::sleep(Duration::from_millis(300));h.snapshot();
+    let(server,b)=UnixStream::pair().unwrap();h.tx.send(Request::AddClient(server)).unwrap();h.snapshot();let b=Connection::from_socket(b).unwrap();
+    let(mut qb,mut cb,_sb,_xb,_tb)=map_client(&b,"paster");
+    let started=Instant::now();
+    while cb.selection.is_none() {h.snapshot();qb.roundtrip(&mut cb).unwrap();assert!(started.elapsed()<Duration::from_secs(3),"B is offered the kept clipboard");std::thread::sleep(Duration::from_millis(10));}
+    let offer=cb.selection.clone().unwrap();
+    let (mut read,write)=std::io::pipe().unwrap();
+    offer.receive("text/plain;charset=utf-8".into(),write.as_fd());drop(write);
+    qb.roundtrip(&mut cb).unwrap();h.snapshot();
+    let mut text=String::new();read.read_to_string(&mut text).unwrap();
+    assert_eq!(text,"ready late");
+}
