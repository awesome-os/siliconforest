+/// DESK10 (FX-027: AppKit centres a modal file panel and the desk put it lower right): with policy
+/// window_position=on the desk advertises sf_window_position_v1; a window whose client set a position before it
+/// first mapped opens there (its frame's corner at that place, on the work area), and the client is told where
+/// its window is.
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn a_window_opens_where_its_application_put_it_with_sf_window_position() {
+    std::env::set_var("CHONKSTEP_DARWIN_WINDOW_POSITION", "1");
+    let (h, a) = Harness::with_input(true);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    h.snapshot();
+    // the position protocol on its own queue of the same connection
+    let mut pq = a.new_event_queue();
+    let mut pc = PositionClient::default();
+    a.display().get_registry(&pq.handle(), ());
+    for _ in 0..3 { pq.roundtrip(&mut pc).unwrap(); h.snapshot(); }
+    let manager = pc.manager.clone().expect("sf_window_position_manager_v1 advertised with window_position=on");
+    let mut queue = a.new_event_queue(); let q = queue.handle(); let mut c = Client::default();
+    a.display().get_registry(&q, ()); for _ in 0..3 { queue.roundtrip(&mut c).unwrap(); }
+    let surface = c.compositor.as_ref().unwrap().create_surface(&q, ());
+    let xdg = c.shell.as_ref().unwrap().get_xdg_surface(&surface, &q, ()); let top = xdg.get_toplevel(&q, ());
+    top.set_title("placed".into());
+    let position = manager.get_window_position(&surface, &pq.handle(), ());
+    position.set_position(150, 60);
+    pq.roundtrip(&mut pc).unwrap();
+    surface.commit(); queue.roundtrip(&mut c).unwrap();
+    let mut file = tempfile::tempfile().unwrap(); file.write_all(&[10, 20, 240, 255].repeat(60 * 40)).unwrap();
+    let pool = c.shm.as_ref().unwrap().create_pool(file.as_fd(), 60 * 40 * 4, &q, ());
+    let buffer = pool.create_buffer(0, 60, 40, 240, wl_shm::Format::Argb8888, &q, ());
+    surface.attach(Some(&buffer), 0, 0); surface.commit();
+    for _ in 0..3 { queue.roundtrip(&mut c).unwrap(); h.snapshot(); pq.roundtrip(&mut pc).unwrap(); }
+    let content = h.snapshot().content.unwrap();
+    // the frame's corner at (150, 60); the content inside it by the frame's border and title bar
+    assert!((150..=170).contains(&content.pos.x) && (60..=110).contains(&content.pos.y), "content at {:?}", content.pos);
+    for _ in 0..3 { pq.roundtrip(&mut pc).unwrap(); h.snapshot(); }
+    assert_eq!(pc.told.last().copied(), Some((content.pos.x, content.pos.y)), "the client is told where its window is: {:?}", pc.told);
+}
