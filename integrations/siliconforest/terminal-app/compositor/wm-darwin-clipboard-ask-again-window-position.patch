+}
+#[derive(Default)]
+struct PositionClient { manager: Option<sf_position::sf_window_position_manager_v1::SfWindowPositionManagerV1>, told: Vec<(i32, i32)> }
+impl Dispatch<wl_registry::WlRegistry, ()> for PositionClient {
+    fn event(s: &mut Self, r: &wl_registry::WlRegistry, e: wl_registry::Event, _: &(), _: &Connection, q: &QueueHandle<Self>) {
+        if let wl_registry::Event::Global { name, interface, .. } = e {
+            if interface == "sf_window_position_manager_v1" { s.manager = Some(r.bind(name, 1, q, ())); }
+        }
+    }
+}
+delegate_noop!(PositionClient: ignore sf_position::sf_window_position_manager_v1::SfWindowPositionManagerV1);
+impl Dispatch<sf_position::sf_window_position_v1::SfWindowPositionV1, ()> for PositionClient {
+    fn event(s: &mut Self, _: &sf_position::sf_window_position_v1::SfWindowPositionV1, e: sf_position::sf_window_position_v1::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+        if let sf_position::sf_window_position_v1::Event::Position { x, y } = e { s.told.push((x, y)); }
+    }
+}
