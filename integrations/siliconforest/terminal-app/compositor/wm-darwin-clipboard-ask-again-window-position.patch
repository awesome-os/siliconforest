diff -ruN desk10-next-002/source/crates/wm-darwin/src/window_position.rs desk10-next-003/source/crates/wm-darwin/src/window_position.rs
--- desk10-next-002/source/crates/wm-darwin/src/window_position.rs	1969-12-31 16:00:00.000000000 -0800
+++ desk10-next-003/source/crates/wm-darwin/src/window_position.rs	2026-11-15 22:44:25.758209625 -0800
@@ -0,0 +1,162 @@
+//! DESK10 (FX-027, TERM10's request): `sf_window_position_v1`, the window positions AppKit asks for and the
+//! ones the desk gives. libWindowServer binds the manager when it is advertised, asks for a window's
+//! position object when it gives the window its role, and sends the place AppKit put the window
+//! (`set_position`, top-left in the desk's logical coordinates: AppKit centres a modal panel, cascades a
+//! document window, restores a saved frame); it reads back where the desk placed and moved it (`position`
+//! events), which AppKit needs to turn surface-local pointer positions into screen coordinates.
+//!
+//! What the desk does with a `set_position`: before the window first maps, the place becomes the window's
+//! requested position, which the placement policy honours as a client's real position (wm-core: kept on
+//! the work area); after that it is only said in the log (a move by the application itself is not done yet).
+//! The global is advertised only with policy `window_position=on` (off by default: a change of where every
+//! AppKit window opens, for the owner to try), switched live; applications started after it see it.
+use smithay::reexports::wayland_server::backend::GlobalId;
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::reexports::wayland_server::{Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource};
+use wm_core::Backend;
+
+#[allow(non_upper_case_globals, non_camel_case_types, non_snake_case)]
+#[allow(dead_code, unused_imports, unused_variables, unused_unsafe)]
+#[allow(missing_docs, clippy::all)]
+pub mod bindings {
+    use smithay::reexports::wayland_server;
+    use smithay::reexports::wayland_server::protocol::*;
+
+    pub mod __interfaces {
+        use smithay::reexports::wayland_server::backend as wayland_backend;
+        use smithay::reexports::wayland_server::protocol::__interfaces::*;
+        wayland_scanner::generate_interfaces!("protocols/sf-window-position-v1.xml");
+    }
+    use self::__interfaces::*;
+    wayland_scanner::generate_server_code!("protocols/sf-window-position-v1.xml");
+}
+
+use bindings::sf_window_position_manager_v1::{self, SfWindowPositionManagerV1};
+use bindings::sf_window_position_v1::{self, SfWindowPositionV1};
+
+use crate::server::Server;
+
+/// One window's position object: its surface, and the position last told (logical units).
+pub(crate) struct Entry {
+    resource: SfWindowPositionV1,
+    surface: WlSurface,
+    told: Option<(i32, i32)>,
+}
+
+#[derive(Default)]
+pub(crate) struct WindowPositions {
+    global: Option<GlobalId>,
+    entries: Vec<Entry>,
+    /// requests honoured as an initial place, and requests after the map (said, not done)
+    pub placed: u64,
+    pub moves_asked: u64,
+}
+
+impl Server {
+    /// Every turn: the global follows the policy, and every live position object is told where its window is
+    /// now (only when that changed).
+    pub fn window_positions_tick(&mut self) {
+        let want = self.policy.now.window_position;
+        let dh = self.display_handle.clone();
+        match (want, self.window_positions.global.is_some()) {
+            (true, false) => {
+                self.window_positions.global = Some(dh.create_global::<Server, SfWindowPositionManagerV1, ()>(1, ()));
+                eprintln!("WMPOS sf_window_position_v1 advertised (policy window_position=on): applications started from now on place their windows");
+            }
+            (false, true) => {
+                if let Some(id) = self.window_positions.global.take() {
+                    dh.remove_global::<Server>(id);
+                }
+                eprintln!("WMPOS sf_window_position_v1 withdrawn (policy window_position=off)");
+            }
+            _ => {}
+        }
+        if self.window_positions.entries.is_empty() {
+            return;
+        }
+        self.window_positions.entries.retain(|e| e.resource.is_alive() && e.surface.is_alive());
+        let density = self.scale().factor();
+        let backend = self.wm.backend();
+        let mut tell = Vec::new();
+        for (i, e) in self.window_positions.entries.iter().enumerate() {
+            let Some(id) = backend.window_for_surface(&e.surface) else { continue };
+            let Some(w) = backend.windows.get(&id) else { continue };
+            if !w.mapped {
+                continue;
+            }
+            let at = ((f64::from(w.content.pos.x) / density).round() as i32, (f64::from(w.content.pos.y) / density).round() as i32);
+            if e.told != Some(at) {
+                tell.push((i, at));
+            }
+        }
+        for (i, at) in tell {
+            let e = &mut self.window_positions.entries[i];
+            e.resource.position(at.0, at.1);
+            e.told = Some(at);
+        }
+    }
+
+    fn window_position_asked(&mut self, surface: &WlSurface, x: i32, y: i32) {
+        let density = self.scale().factor();
+        let Some(id) = self.wm.backend().window_for_surface(surface) else {
+            eprintln!("WMPOS set_position {x},{y} for a surface that is no window of the desk: ignored");
+            return;
+        };
+        let at = wm_core::Point::new((f64::from(x) * density).round() as i32, (f64::from(y) * density).round() as i32);
+        let w = self.wm.backend_mut().windows.get_mut(&id).unwrap();
+        if w.committed {
+            self.window_positions.moves_asked += 1;
+            eprintln!("WMPOS window={id} asks to be moved to {x},{y} (logical) after it mapped: not done (the desk places mapped windows)");
+            return;
+        }
+        // (0,0) is AppKit's "anywhere" as much as any client's: the placement policy decides then
+        w.requested_pos = (at != wm_core::Point::new(0, 0)).then_some(at);
+        self.window_positions.placed += 1;
+        eprintln!("WMPOS window={id} opens where its application put it: {x},{y} logical = {},{} panel px (kept on the work area)", at.x, at.y);
+    }
+}
+
+impl GlobalDispatch<SfWindowPositionManagerV1, ()> for Server {
+    fn bind(_: &mut Self, _: &DisplayHandle, _: &Client, resource: New<SfWindowPositionManagerV1>, _: &(), data_init: &mut DataInit<'_, Self>) {
+        data_init.init(resource, ());
+    }
+}
+
+impl Dispatch<SfWindowPositionManagerV1, ()> for Server {
+    fn request(
+        state: &mut Self,
+        _: &Client,
+        _: &SfWindowPositionManagerV1,
+        request: sf_window_position_manager_v1::Request,
+        _: &(),
+        _: &DisplayHandle,
+        data_init: &mut DataInit<'_, Self>,
+    ) {
+        match request {
+            sf_window_position_manager_v1::Request::GetWindowPosition { id, surface } => {
+                let resource = data_init.init(id, surface.clone());
+                state.window_positions.entries.push(Entry { resource, surface, told: None });
+            }
+            sf_window_position_manager_v1::Request::Destroy => {}
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<SfWindowPositionV1, WlSurface> for Server {
+    fn request(
+        state: &mut Self,
+        _: &Client,
+        resource: &SfWindowPositionV1,
+        request: sf_window_position_v1::Request,
+        surface: &WlSurface,
+        _: &DisplayHandle,
+        _: &mut DataInit<'_, Self>,
+    ) {
+        match request {
+            sf_window_position_v1::Request::SetPosition { x, y } => state.window_position_asked(surface, x, y),
+            sf_window_position_v1::Request::Destroy => state.window_positions.entries.retain(|e| &e.resource != resource),
+            _ => {}
+        }
+    }
+}
