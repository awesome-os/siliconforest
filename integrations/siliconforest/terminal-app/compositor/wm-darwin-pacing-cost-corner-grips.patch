+/// DESK9 (FX-033): how far into a window's content its frame's corner grips reach (panel pixels).
+pub(crate) const CORNER_GRIP: i32 = 8;
+/// Is `point` (inside the content) within `CORNER_GRIP` of a content corner, on a corner resize hitbox of the
+/// frame (at `origin`)? Only a resizable frame has those hitboxes.
+pub(crate) fn corner_grip(layout: &wm_theme_api::DecorationLayout, origin: Point, content: Rect, point: Point) -> bool {
+    let (x0, y0) = (content.pos.x, content.pos.y);
+    let (x1, y1) = (x0 + content.size.w as i32, y0 + content.size.h as i32);
