+/// DESK9 (`skip_unchanged`): a commit that brings nothing new - a frame callback alone, or the buffer the window
+/// shows attached again without damage - repaints nothing, and its frame callback and presentation feedback come
+/// all the same, one refresh apart (never at once: a client drawing on its callbacks does not spin). With the
+/// switch off every such commit drew a frame, as before DESK9.
+#[test]
+fn a_commit_that_brings_nothing_new_repaints_nothing_and_is_answered_at_the_next_refresh() {
+    for skip in [true, false] {
+        let (h, connection) = Harness::start_full(true, if skip { "skip_unchanged=on" } else { "skip_unchanged=off" }, true);
+        let mut queue = connection.new_event_queue();
+        let qh = queue.handle();
+        let mut client = Client::default();
+        connection.display().get_registry(&qh, ());
+        queue.roundtrip(&mut client).unwrap();
+        let presentation = client.presentation.clone().expect("wp_presentation advertised");
+        let (dmabuf, _) = client.dmabuf.clone().unwrap();
+        let surface = client.compositor.as_ref().unwrap().create_surface(&qh, ());
+        let xdg = client.shell.as_ref().unwrap().get_xdg_surface(&surface, &qh, ());
+        let _top = xdg.get_toplevel(&qh, ());
+        surface.commit();
+        queue.roundtrip(&mut client).unwrap();
+        let (w, hgt, stride) = (64i32, 32i32, 256u32);
+        let file = fake_dmabuf(stride as usize * hgt as usize);
+        let params = dmabuf.create_params(&qh, ());
+        params.add(file.as_fd(), 0, 0, stride, 0, 0);
+        let buffer = params.create_immed(w, hgt, XR24, zwp_linux_buffer_params_v1::Flags::empty(), &qh, 1);
+        params.destroy();
+        surface.attach(Some(&buffer), 0, 0);
+        surface.damage_buffer(0, 0, w, hgt);
+        surface.frame(&qh, ());
+        surface.commit();
+        let until = |client: &mut Client, queue: &mut wayland_client::EventQueue<Client>, frames: u32| {
+            let started = Instant::now();
+            while client.frames < frames {
+                queue.roundtrip(client).unwrap();
+                assert!(started.elapsed() < Duration::from_secs(5), "callback {frames} did not come");
+                thread::sleep(Duration::from_millis(1));
+            }
+        };
+        until(&mut client, &mut queue, 1);
+        thread::sleep(Duration::from_millis(40));
+        let drawn_before = h.log.lock().unwrap().frames;
+        let started = Instant::now();
+        for i in 0..8u32 {
+            if i % 2 == 1 {
+                surface.attach(Some(&buffer), 0, 0); // the same buffer again, no damage
+            }
+            surface.frame(&qh, ());
+            presentation.feedback(&surface, &qh, 100 + i);
+            surface.commit();
+            until(&mut client, &mut queue, 2 + i);
+        }
+        let took = started.elapsed();
+        let drawn = h.log.lock().unwrap().frames - drawn_before;
+        let presented = client.feedback.iter().filter(|(t, f)| *t >= 100 && f.is_some()).count();
+        if skip {
+            assert_eq!(drawn, 0, "nothing new: no frame drawn for 8 commits");
+            assert_eq!(presented, 8, "every feedback presented: {:?}", client.feedback);
+            assert!(took >= Duration::from_millis(8 * 12), "answered a refresh apart, not at once: {took:?}");
+            let times = &client.callback_times[1..];
+            assert!(times.windows(2).all(|p| p[1] > p[0]), "callback times advance: {times:?}");
+        } else {
+            assert!(drawn >= 8, "as before: a frame for each commit ({drawn})");
+        }
+        drop(h);
+    }
+}
