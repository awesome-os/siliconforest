+/// DESK9: the screen's changes of the last frames and which frame each of the target's buffers holds. A
+/// buffer drawn `age` frames ago needs the changes of those frames repainted, nothing else: the rest of it
+/// already shows what the screen shows (before, every frame repainted the whole 2560x1600 screen for any
+/// change, a client's one-line commit included).
+#[derive(Default)]
+struct PartialRepaint {
+    /// The display list of the frame drawn last.
+    shown: Vec<crate::damage::ItemSig>,
+    /// The changes of the last frames, newest last (at most `HISTORY`).
+    history: std::collections::VecDeque<crate::damage::Region>,
+    /// buffer index -> the frame number drawn into it last
+    drawn: HashMap<usize, u64>,
+    size: (u32, u32),
+}
+const HISTORY: usize = 4;
+/// More rectangles than this are repainted as their bounding box (one pass over the display list each).
+const SCISSOR_PASSES: usize = 4;
+impl PartialRepaint {
+    fn reset(&mut self) {
+        self.shown.clear();
+        self.history.clear();
+        self.drawn.clear();
+    }
+    /// This frame's changes (`sigs` against the frame before) and what buffer `index` needs repainted:
+    /// `None` = everything (a buffer not drawn before, too old, or no list to compare with).
+    fn plan(&mut self, sigs: Vec<crate::damage::ItemSig>, size: (u32, u32), frame: u64, index: Option<usize>, partial: impl FnMut(ItemKey) -> Option<Vec<DRect>>) -> Option<crate::damage::Region> {
+        if self.size != size {
+            self.reset();
+            self.size = size;
+        }
+        let mut fresh = crate::damage::Region::new(size.0, size.1);
+        if self.shown.is_empty() {
+            fresh.add_all();
+        } else {
+            crate::damage::diff(&self.shown, &sigs, partial, &mut fresh);
+        }
+        self.shown = sigs;
+        let need = index.and_then(|i| {
+            let last = *self.drawn.get(&i)?;
+            let between = frame.checked_sub(last)?.checked_sub(1)? as usize;
+            if between > self.history.len() {
+                return None;
+            }
+            let mut need = fresh.clone();
+            for older in self.history.iter().rev().take(between) {
+                need.add_region(older);
+            }
+            Some(need)
+        });
+        if self.history.len() == HISTORY {
+            self.history.pop_front();
+        }
+        self.history.push_back(fresh);
+        if let Some(i) = index {
+            self.drawn.insert(i, frame);
+        }
+        need
+    }
+}
