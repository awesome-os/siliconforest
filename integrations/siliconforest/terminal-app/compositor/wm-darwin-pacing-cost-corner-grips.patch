+/// DESK9 `framehash`: FNV-1a over every third pixel of every third row of a 32-bit-per-pixel image (`offset` to
+/// the first row, `stride` bytes a row): enough to tell one frame of a video or a scroll from the next.
+pub(crate) fn sampled_hash(bytes: &[u8], offset: usize, stride: usize, width: usize, height: usize) -> u64 {
+    let mut h: u64 = 0xcbf29ce484222325;
+    let mut y = 0;
+    while y < height {
+        let row = offset + y * stride;
+        let mut x = 0;
+        while x < width {
+            let at = row + x * 4;
+            if let Some(p) = bytes.get(at..at + 4) {
+                h = (h ^ u64::from(u32::from_le_bytes([p[0], p[1], p[2], p[3]]))).wrapping_mul(0x100000001b3);
+            }
+            x += 3;
+        }
+        y += 3;
+    }
+    h
+}
