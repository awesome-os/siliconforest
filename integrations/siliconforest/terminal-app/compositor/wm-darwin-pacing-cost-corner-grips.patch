+            ResizeEdge::SouthWest => (x0, y1 - 1),
+            ResizeEdge::SouthEast => (x1 - 1, y1 - 1),
+            _ => return false,
+        };
+        let (rx, ry) = (origin.x + r.pos.x, origin.y + r.pos.y);
+        let on_box = point.x >= rx && point.y >= ry && point.x < rx + r.size.w as i32 && point.y < ry + r.size.h as i32;
+        on_box && near(point.x, corner.0) && near(point.y, corner.1)
+    })
+}
