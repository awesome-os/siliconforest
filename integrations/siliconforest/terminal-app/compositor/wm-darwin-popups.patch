diff --git a/crates/wm-darwin/src/popups.rs b/crates/wm-darwin/src/popups.rs
new file mode 100644
index 0000000..5c48bde
--- /dev/null
+++ b/crates/wm-darwin/src/popups.rs
@@ -0,0 +1,224 @@
+//! Client popups (`xdg_popup`): menus, pop-up button lists, combo boxes and
+//! tool tips of a client, placed against one of its windows.
+//!
+//! A popup is not a window of the desk: the window manager never sees it, it
+//! has no frame and no place in the stacking of windows. It is drawn through
+//! the scene's shell surfaces, above every window, at the place the client's
+//! positioner gives it relative to its parent (a toplevel or another popup),
+//! kept on the panel by the positioner's own constraint rules. The pointer
+//! goes to the topmost popup under it. A popup that asked for a grab is
+//! dismissed (`popup_done`) by a press anywhere that is not a surface of the
+//! same client; a press on the client's own window reaches that window, and
+//! the client closes its menu itself, as the protocol has it.
+use smithay::reexports::wayland_server::{protocol::wl_surface::WlSurface, Resource};
+use smithay::utils::{Logical, Rectangle};
+use smithay::wayland::compositor::{with_states, BufferAssignment, SurfaceAttributes};
+use smithay::wayland::shell::xdg::{PopupSurface, PositionerState};
+use wm_core::{Backend, Point, Rect, Size};
+
+use crate::server::Server;
+
+pub(crate) struct ClientPopup {
+    pub surface: PopupSurface,
+    /// Where it is on the panel, in panel pixels.
+    pub rect: Rect,
+    /// The scene surface that shows it, once it has a buffer.
+    pub shell: Option<u64>,
+    pub grab: bool,
+}
+
+impl Server {
+    /// A surface's origin on the panel and how many panel pixels its logical unit is.
+    fn popup_parent_place(&self, parent: &WlSurface) -> Option<(Point, f64)> {
+        if let Some(id) = self.wm.backend().window_for_surface(parent) {
+            let w = self.wm.backend().windows.get(&id)?;
+            return Some((w.content.pos, self.wm.backend().density(id)));
+        }
+        self.client_popups
+            .iter()
+            .find(|p| p.surface.wl_surface() == parent)
+            .map(|p| (p.rect.pos, self.scale().factor()))
+    }
+
+    fn popup_rect(&self, parent: &WlSurface, positioner: &PositionerState) -> Option<(Rectangle<i32, Logical>, Rect)> {
+        let (origin, density) = self.popup_parent_place(parent)?;
+        let screen = self.wm.backend().screen_size();
+        let logical = |v: i32| (f64::from(v) / density).floor() as i32;
+        // The panel, as the parent sees it: what the positioner may slide or flip within.
+        let target = Rectangle::new(
+            (-logical(origin.x), -logical(origin.y)).into(),
+            (logical(screen.w as i32), logical(screen.h as i32)).into(),
+        );
+        let geometry = positioner.get_unconstrained_geometry(target);
+        let px = |v: i32| (f64::from(v) * density).round() as i32;
+        let rect = Rect::new(
+            Point::new(origin.x + px(geometry.loc.x), origin.y + px(geometry.loc.y)),
+            Size::new(px(geometry.size.w).max(1) as u32, px(geometry.size.h).max(1) as u32),
+        );
+        Some((geometry, rect))
+    }
+
+    pub(crate) fn popup_created(&mut self, surface: PopupSurface, positioner: PositionerState) {
+        let placed = surface.get_parent_surface().and_then(|parent| self.popup_rect(&parent, &positioner));
+        let Some((geometry, rect)) = placed else {
+            // No parent this compositor knows: there is nowhere to put it.
+            eprintln!("WMPOPUP refused: no known parent");
+            surface.send_popup_done();
+            return;
+        };
+        surface.with_pending_state(|state| {
+            state.geometry = geometry;
+            state.positioner = positioner;
+        });
+        self.announce_scale(surface.wl_surface());
+        eprintln!("WMPOPUP new at={},{} size={}x{}", rect.pos.x, rect.pos.y, rect.size.w, rect.size.h);
+        self.client_popups.push(ClientPopup { surface, rect, shell: None, grab: false });
+    }
+
+    pub(crate) fn popup_repositioned(&mut self, surface: PopupSurface, positioner: PositionerState, token: u32) {
+        let placed = surface.get_parent_surface().and_then(|parent| self.popup_rect(&parent, &positioner));
+        let Some((geometry, rect)) = placed else { return };
+        surface.with_pending_state(|state| {
+            state.geometry = geometry;
+            state.positioner = positioner;
+        });
+        surface.send_repositioned(token);
+        let _ = surface.send_configure();
+        if let Some(index) = self.client_popups.iter().position(|p| p.surface == surface) {
+            let moved = self.client_popups[index].rect.pos != rect.pos;
+            self.client_popups[index].rect.pos = rect.pos;
+            if let Some(shell) = self.client_popups[index].shell {
+                // The picture it has moves with it: a client need not draw again because it was moved
+                // (a new size arrives with the client's next buffer, which makes a new scene surface).
+                let size = self.client_popups[index].rect.size;
+                self.wm.backend_mut().configure_shell_surface(shell, Rect::new(rect.pos, size));
+                if moved {
+                    self.refresh_pointer();
+                }
+            }
+        }
+    }
+
+    pub(crate) fn popup_grabbed(&mut self, surface: &PopupSurface) {
+        if let Some(popup) = self.client_popups.iter_mut().find(|p| &p.surface == surface) {
+            popup.grab = true;
+        }
+    }
+
+    pub(crate) fn popup_removed(&mut self, surface: &WlSurface) {
+        // children first: a popup whose parent goes has nothing to stand on
+        while let Some(index) = self.client_popups.iter().position(|p| {
+            p.surface.wl_surface() == surface || p.surface.get_parent_surface().as_ref() == Some(surface)
+        }) {
+            let popup = self.client_popups.remove(index);
+            if let Some(shell) = popup.shell {
+                self.wm.backend_mut().destroy_shell_surface(shell);
+            }
+            if popup.surface.wl_surface() != surface {
+                popup.surface.send_popup_done();
+            }
+            eprintln!("WMPOPUP gone remaining={}", self.client_popups.len());
+        }
+        self.refresh_pointer();
+    }
+
+    /// A commit on a popup's surface. False when the surface is not a popup.
+    pub(crate) fn popup_commit(&mut self, surface: &WlSurface) -> bool {
+        let Some(index) = self.client_popups.iter().position(|p| p.surface.wl_surface() == surface) else {
+            return false;
+        };
+        if !self.client_popups[index].surface.is_initial_configure_sent() {
+            let _ = self.client_popups[index].surface.send_configure();
+            return true;
+        }
+        let (buffer, callbacks) = with_states(surface, |s| {
+            let mut attributes = s.cached_state.get::<SurfaceAttributes>();
+            let a = attributes.current();
+            a.damage.clear();
+            (a.buffer.take(), std::mem::take(&mut a.frame_callbacks))
+        });
+        // released with the next frame that reaches the screen, like a cursor's
+        self.cursor_callbacks.extend(callbacks);
+        match buffer {
+            Some(BufferAssignment::NewBuffer(buffer)) => {
+                let copied = self.import_shm(&buffer);
+                buffer.release();
+                let image = match copied {
+                    Ok(image) => image,
+                    Err(error) => {
+                        eprintln!("WMPOPUP refused buffer: {error}");
+                        return true;
+                    }
+                };
+                let pos = self.client_popups[index].rect.pos;
+                let size = Size::new(image.width, image.height);
+                let old = self.client_popups[index].shell;
+                let backend = self.wm.backend_mut();
+                // a scene surface has the size it was made with: another size is another surface
+                let shell = match old.filter(|_| self.client_popups[index].rect.size == size) {
+                    Some(shell) => Some(shell),
+                    None => {
+                        if let Some(old) = old {
+                            backend.destroy_shell_surface(old);
+                        }
+                        backend.create_shell_surface(Rect::new(pos, size), (0, 0, 0), true)
+                    }
+                };
+                if let Some(shell) = shell {
+                    backend.paint_shell_surface(shell, &image);
+                    backend.map_shell_surface(shell);
+                    if old != Some(shell) {
+                        eprintln!("WMPOPUP mapped at={},{} size={}x{}", pos.x, pos.y, size.w, size.h);
+                    }
+                }
+                self.client_popups[index].shell = shell;
+                self.client_popups[index].rect.size = size;
+                if old != shell {
+                    // it may have come up under the pointer
+                    self.refresh_pointer();
+                }
+            }
+            Some(BufferAssignment::Removed) => {
+                if let Some(shell) = self.client_popups[index].shell.take() {
+                    self.wm.backend_mut().destroy_shell_surface(shell);
+                }
+            }
+            None => {}
+        }
+        true
+    }
+
+    /// The topmost shown popup under a point of the panel: its surface and
+    /// its origin in the logical units the pointer is reported in.
+    pub(crate) fn popup_at(&self, root: Point) -> Option<(WlSurface, (f64, f64))> {
+        let density = self.scale().factor();
+        self.client_popups.iter().rev().find_map(|p| {
+            let inside = p.shell.is_some()
+                && root.x >= p.rect.pos.x
+                && root.y >= p.rect.pos.y
+                && i64::from(root.x) < i64::from(p.rect.pos.x) + i64::from(p.rect.size.w)
+                && i64::from(root.y) < i64::from(p.rect.pos.y) + i64::from(p.rect.size.h);
+            inside.then(|| {
+                (p.surface.wl_surface().clone(), (f64::from(p.rect.pos.x) / density, f64::from(p.rect.pos.y) / density))
+            })
+        })
+    }
+
+    /// A button went down outside every popup, on `under` (a client window) or
+    /// on nothing of a client's. Popups that hold a grab are dismissed unless
+    /// the press is on a surface of their own client.
+    pub(crate) fn popup_press_outside(&mut self, under: Option<&WlSurface>) {
+        let grabbing: Vec<PopupSurface> =
+            self.client_popups.iter().filter(|p| p.grab).map(|p| p.surface.clone()).collect();
+        for surface in grabbing.into_iter().rev() {
+            let own = under.is_some_and(|u| u.client().map(|c| c.id()) == surface.wl_surface().client().map(|c| c.id()));
+            if !own {
+                eprintln!("WMPOPUP dismissed by a press outside");
+                surface.send_popup_done();
+                if let Some(popup) = self.client_popups.iter_mut().find(|p| p.surface == surface) {
+                    popup.grab = false;
+                }
+            }
+        }
+    }
+}
