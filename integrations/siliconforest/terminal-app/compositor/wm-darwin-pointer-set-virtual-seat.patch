diff --git a/crates/chonk-shell/src/miniwindows.rs b/crates/chonk-shell/src/miniwindows.rs
index 59e79a4..1d9cc36 100644
--- a/crates/chonk-shell/src/miniwindows.rs
+++ b/crates/chonk-shell/src/miniwindows.rs
@@ -74,9 +74,10 @@ impl<B: Backend> Miniwindows<B> {
             rect.pos.y = rect.pos.y.clamp(area.pos.y, area.pos.y + area.size.h.saturating_sub(size) as i32);
             let fresh = index.is_none();
             let index = if let Some(index) = index { index } else {
-                // DESK6: above the windows, as macOS keeps minimised windows in its Dock: at desktop
-                // level a window over the bottom left hid the tile, and a click there went to the window
-                let Some(surface) = wm.backend_mut().create_shell_surface(rect, (0, 0, 0), true) else { continue; };
+                // At desktop level, under the windows (DESK7, the owner: "minimized windows should not
+                // render over windows"; DESK6 had put them above). A tile a window covers is reached
+                // through the application's dock tile or Command-Tab, which restore the window.
+                let Some(surface) = wm.backend_mut().create_shell_surface(rect, (0, 0, 0), false) else { continue; };
                 self.tiles.push(Tile { client: id, surface, rect, manual: false, title: String::new(), mapped: false, missing_preview: true });
                 self.tiles.len() - 1
             };
