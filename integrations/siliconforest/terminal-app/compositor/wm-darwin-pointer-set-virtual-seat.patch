new file mode 100644
index 0000000..5bac71d
--- /dev/null
+++ b/crates/wm-darwin/src/owner.rs
@@ -0,0 +1,205 @@
+//! The owner's hand on the keyboard and trackpad, and the test instrument kept out of its way (DESK7).
+//!
+//! The owner felt the pointer stutter while agents injected pointer motion: injected absolute positions
+//! moved the one pointer there was. Now the instrument's events drive a pointer of their own (`input.rs`
+//! `VirtualPointer`), and the desk knows when real input came last:
+//! - `OwnerActivity` counts the device's records (never synthetic ones) and says the owner is *active*
+//!   for `ACTIVE_WINDOW` after the last;
+//! - that state is written to `$XDG_RUNTIME_DIR/owner-input` (on SiliconForest
+//!   `/private/var/run/gpu-desktop/owner-input`) for the agents' tools: `active=1` means hands off.
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+/// How long after the last real key or pointer record the owner counts as active.
+pub const ACTIVE_WINDOW: Duration = Duration::from_secs(10);
+
+#[derive(Debug)]
+pub struct OwnerActivity {
+    last: Option<Instant>,
+    last_unix_ms: u64,
+    pub pointer_records: u64,
+    pub key_records: u64,
+    /// Synthetic events that arrived while the owner was active (delivered to clients only, held back
+    /// or refused; see input.rs).
+    pub synthetic_while_active: u64,
+    /// Synthetic presses or keys let go because the owner's input came (the owner wins).
+    pub synthetic_interrupted: u64,
+    path: Option<std::path::PathBuf>,
+    written: Option<(bool, Instant)>,
+}
+
+fn unix_ms() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_millis() as u64)
+}
+
+impl Default for OwnerActivity {
+    fn default() -> Self {
+        let path = std::env::var_os("XDG_RUNTIME_DIR").map(|d| std::path::PathBuf::from(d).join("owner-input"));
+        Self { last: None, last_unix_ms: 0, pointer_records: 0, key_records: 0, synthetic_while_active: 0, synthetic_interrupted: 0, path, written: None }
+    }
+}
+
+impl OwnerActivity {
+    /// Without a state file (host tests).
+    pub fn in_memory() -> Self {
+        Self { path: None, ..Self::default() }
+    }
+    pub fn with_path(path: std::path::PathBuf) -> Self {
+        Self { path: Some(path), ..Self::default() }
+    }
+    /// A record from the keyboard or the trackpad (the device, not the instrument).
+    pub fn real(&mut self, key: bool) {
+        let was = self.active();
+        self.last = Some(Instant::now());
+        self.last_unix_ms = unix_ms();
+        if key {
+            self.key_records += 1;
+        } else {
+            self.pointer_records += 1;
+        }
+        if !was {
+            eprintln!("WMOWNER real input: the owner is active (synthetic input now reaches clients only, never the owner's pointer, keys or focus)");
+        }
+    }
+    pub fn active(&self) -> bool {
+        self.last.is_some_and(|t| t.elapsed() < ACTIVE_WINDOW)
+    }
+    /// Milliseconds since the last real record, if any.
+    pub fn idle_ms(&self) -> Option<u64> {
+        self.last.map(|t| t.elapsed().as_millis() as u64)
+    }
+    pub fn describe(&self) -> String {
+        format!(
+            "owner_active={} idle_ms={} real_pointer_records={} real_key_records={} synthetic_while_active={} synthetic_interrupted={}",
+            u8::from(self.active()),
+            self.idle_ms().map_or("never".into(), |m| m.to_string()),
+            self.pointer_records,
+            self.key_records,
+            self.synthetic_while_active,
+            self.synthetic_interrupted
+        )
+    }
+    fn text(&self) -> String {
+        format!(
+            "# chonkstep-darwin-desktop (DESK7): real keyboard/trackpad input. Synthetic input is never counted here.\n\
+             # active=1: the owner touched the M1 within window_ms: do not inject, relaunch or capture.\n\
+             active={}\nwindow_ms={}\nlast_real_input_unix_ms={}\nreal_pointer_records={}\nreal_key_records={}\n\
+             synthetic_while_active={}\nsynthetic_interrupted={}\nupdated_unix_ms={}\n",
+            u8::from(self.active()),
+            ACTIVE_WINDOW.as_millis(),
+            self.last_unix_ms,
+            self.pointer_records,
+            self.key_records,
+            self.synthetic_while_active,
+            self.synthetic_interrupted,
+            unix_ms()
+        )
+    }
+    /// Called every loop turn: the file follows the state (at a change at once, while active once a second).
+    pub fn tick(&mut self) {
+        let Some(path) = self.path.clone() else { return };
+        let active = self.active();
+        let due = match self.written {
+            None => true,
+            Some((was, at)) => was != active || (active && at.elapsed() >= Duration::from_secs(1)),
+        };
+        if !due {
+            return;
+        }
+        if let Some((true, _)) = self.written {
+            if !active {
+                eprintln!("WMOWNER no real input for {} s: the owner is idle", ACTIVE_WINDOW.as_secs());
+            }
+        }
+        self.written = Some((active, Instant::now()));
+        let part = path.with_extension("part");
+        if std::fs::write(&part, self.text()).and_then(|()| std::fs::rename(&part, &path)).is_err() {
+            // a full or read-only runtime directory costs only the file
+            self.path = None;
+            eprintln!("WMOWNER the state file {} cannot be written: agents' tools cannot see the owner's activity", path.display());
+        }
+    }
+}
+
+/// The pointer's speed (DESK7, item 2c): a plain factor on the trackpad's relative motion, after the
+/// trackpad driver's own curve (libinput's touchpad profile, driven by the controller's clock, in the
+/// kernel: `m1-trackpad-child/multitouch/m1tp_mt.c`). It does not depend on time, so a late frame or
+/// a late read cannot change it. Percent, 25..400, 100 = as the driver gives it (the speed before
+/// DESK7). Set by `CHONKSTEP_DARWIN_POINTER_SPEED=<percent>` or the file
+/// `$XDG_STATE_HOME/chonkstep/pointer-speed` (one number; read again within a second of a change).
+pub struct PointerSpeed {
+    factor: f64,
+    path: Option<std::path::PathBuf>,
+    checked: Option<Instant>,
+    stamp: Option<std::time::SystemTime>,
+    fixed: bool,
+}
+impl Default for PointerSpeed {
+    fn default() -> Self {
+        let env = std::env::var("CHONKSTEP_DARWIN_POINTER_SPEED").ok().and_then(|v| Self::parse(&v));
+        let path = std::env::var_os("XDG_STATE_HOME").map(|d| std::path::PathBuf::from(d).join("chonkstep").join("pointer-speed"));
+        let mut speed = Self { factor: 1.0, path, checked: None, stamp: None, fixed: env.is_some() };
+        if let Some(percent) = env {
+            speed.factor = f64::from(percent) / 100.0;
+            eprintln!("WMPOINTER speed {percent}% (environment)");
+        }
+        speed
+    }
+}
+impl PointerSpeed {
+    fn parse(text: &str) -> Option<u32> {
+        text.trim().trim_end_matches('%').parse::<u32>().ok().filter(|p| (25..=400).contains(p))
+    }
+    /// The factor for relative motion now (the file looked at once a second at most).
+    pub fn factor(&mut self) -> f64 {
+        if self.fixed || self.checked.is_some_and(|t| t.elapsed() < Duration::from_secs(1)) {
+            return self.factor;
+        }
+        self.checked = Some(Instant::now());
+        let Some(path) = &self.path else { return self.factor };
+        let stamp = std::fs::metadata(path).and_then(|m| m.modified()).ok();
+        if stamp != self.stamp {
+            self.stamp = stamp;
+            let percent = std::fs::read_to_string(path).ok().and_then(|t| Self::parse(&t)).unwrap_or(100);
+            if (f64::from(percent) / 100.0 - self.factor).abs() > f64::EPSILON {
+                eprintln!("WMPOINTER speed {percent}% ({})", path.display());
+            }
+            self.factor = f64::from(percent) / 100.0;
+        }
+        self.factor
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn the_pointer_speed_is_read_from_its_file_and_bounded() {
+        assert_eq!(PointerSpeed::parse("80"), Some(80));
+        assert_eq!(PointerSpeed::parse(" 150%\n"), Some(150));
+        assert_eq!(PointerSpeed::parse("10"), None);
+        assert_eq!(PointerSpeed::parse("fast"), None);
+        let dir = std::env::temp_dir().join(format!("sf-speed-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut speed = PointerSpeed { factor: 1.0, path: Some(dir.join("pointer-speed")), checked: None, stamp: None, fixed: false };
+        assert_eq!(speed.factor(), 1.0);
+        std::fs::write(dir.join("pointer-speed"), "70\n").unwrap();
+        speed.checked = None;
+        assert!((speed.factor() - 0.7).abs() < 1e-9);
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+    #[test]
+    fn real_input_makes_the_owner_active_and_the_file_says_so() {
+        let dir = std::env::temp_dir().join(format!("sf-owner-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut o = OwnerActivity::with_path(dir.join("owner-input"));
+        o.tick();
+        let text = std::fs::read_to_string(dir.join("owner-input")).unwrap();
+        assert!(text.contains("\nactive=0\n"), "{text}");
+        o.real(false);
+        assert!(o.active());
+        o.tick();
+        let text = std::fs::read_to_string(dir.join("owner-input")).unwrap();
+        assert!(text.contains("\nactive=1\n") && text.contains("real_pointer_records=1"), "{text}");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
