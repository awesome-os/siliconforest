+    assert_eq!(h.snapshot().cursor,Some((4,4)),"a custom image is shown as the client drew it");
+    // the frame's bottom-right resize corner: the set's diagonal double arrow; back over the desktop: the arrow
+    let corner=h.snapshot().resize_corner.expect("the focused window's resize corner");
+    h.tx.send(abs_mouse(3,corner,0)).unwrap();
+    assert_eq!(h.snapshot().cursor_id,Some(id("nwse-resize")),"the resize corner");
+    h.tx.send(abs_mouse(4,wm_core::Point::new(2,2),0)).unwrap();
+    assert_eq!(h.snapshot().cursor_id,Some(id("default")));
+}
+
+/// DESK7, the owner: "minimized windows should not render over windows; the ones at the bottom of the
+/// screen are on top of windows" (DESK6 had put the tiles above). A minimised window's tile is a desk
+/// surface under the windows, like the launcher strip; a tile a window covers is reached through the
+/// application's dock tile or Command-Tab, whose activation brings the window back.
+#[cfg(feature = "desktop-shell")]
+#[test]
+fn a_minimised_tile_lies_under_the_windows_and_an_activation_brings_the_window_back() {
+    let (h, a) = Harness::sized(true, 640, 480, 15);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let settle = || { for _ in 0..10 { h.snapshot(); thread::sleep(Duration::from_millis(10)); } };
+    settle();
+    let above_before = h.snapshot().shells_above;
+    let (mut q, mut c, _s, _x, t) = map_client(&a, "minimised under the windows");
+    settle();
+    let before = h.snapshot();
+    t.set_minimized();
+    q.roundtrip(&mut c).unwrap();
+    settle();
+    let minimised = h.snapshot();
+    assert!(minimised.shells > before.shells, "a tile for the minimised window");
+    assert_eq!(minimised.visible, 0);
+    assert_eq!(minimised.shells_above, above_before, "the tile is not drawn above the windows");
+    // the dock's tile (foreign-toplevel activate) or Command-Tab: the window comes back, the tile goes
+    h.tx.send(Request::ActivateOldest).unwrap();
+    for _ in 0..3 { q.roundtrip(&mut c).unwrap(); }
+    settle();
+    let back = h.snapshot();
+    assert_eq!(back.visible, 1, "the activation brought the minimised window back: {back:?}");
+    assert_eq!(back.shells, before.shells, "its tile went");
+}
