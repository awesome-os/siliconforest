+                self.max_us = us;
+                self.worst = text.clone();
+            }
+            if total >= STALL && self.said.is_none_or(|t| t.elapsed() >= Duration::from_secs(1)) {
+                self.said = Some(Instant::now());
+                eprintln!("WMSTALL loop turn {:.1} ms: {text}", total.as_secs_f64() * 1000.0);
+            }
+        }
+    }
+    /// A commit that showed the pointer at `at` (moved since the last one).
+    pub fn pointer_shown(&mut self, at: wm_core::Point) {
+        let now = Instant::now();
+        if let Some((last, when)) = self.last_pointer {
+            if last == at {
+                return;
+            }
+            let gap = now.saturating_duration_since(when);
+            if gap < Duration::from_millis(250) {
+                self.pointer_gaps.sample(gap);
+            }
+        }
+        self.last_pointer = Some((at, now));
+    }
+    pub fn take_line(&mut self) -> String {
+        let q = self.queue_wait.take_sorted();
+        let g = self.pointer_gaps.take_sorted();
+        let line = format!(
+            "WMLOOP turns={} over_4/8/16/33ms={:?} worst_ms={:.1} ({}) | {} | {}",
+            self.turns, self.over, self.max_us as f64 / 1000.0, self.worst, window_text(&q, "pointer records read->delivered"), window_text(&g, "gap between commits moving the pointer")
+        );
+        self.turns = 0;
+        self.over = [0; 4];
+        self.max_us = 0;
+        self.worst.clear();
+        line
+    }
+}
