+/// The calling thread to the time-constraint (real-time) class for good (DESK7): every `period_us` it
+/// needs up to `computation_us` within `constraint_us`. Mach demotes a thread that overruns this.
+pub fn time_constraint(what: &str, period_us: u64, computation_us: u64, constraint_us: u64) {
+    #[cfg(target_os = "macos")]
+    {
+        let Some(m) = mach() else { return };
+        let ticks = |us: u64| (us * 1000).saturating_mul(m.denom) / m.numer;
+        let thread = (m.thread)(unsafe { libc::pthread_self() });
+        let policy = [ticks(period_us) as i32, ticks(computation_us) as i32, ticks(constraint_us) as i32, 1];
+        let rc = (m.policy_set)(thread, 2, policy.as_ptr(), 4); // THREAD_TIME_CONSTRAINT_POLICY
+        eprintln!("WMPACE {what} thread: time-constraint policy period={period_us}us computation={computation_us}us constraint={constraint_us}us rc={rc} {}", sched_text());
+    }
+    #[cfg(not(target_os = "macos"))]
+    let _ = (what, period_us, computation_us, constraint_us);
+}
+/// The calling thread back to the standard (timeshare) policy.
+pub fn standard_policy(what: &str) {
+    #[cfg(target_os = "macos")]
+    {
+        let Some(m) = mach() else { return };
+        let thread = (m.thread)(unsafe { libc::pthread_self() });
+        let standard = [0i32; 1];
+        let rc = (m.policy_set)(thread, 1, standard.as_ptr(), 0); // THREAD_STANDARD_POLICY
+        eprintln!("WMPACE {what} thread: standard policy rc={rc}");
+    }
+    #[cfg(not(target_os = "macos"))]
+    let _ = what;
+}
+/// The calling thread's scheduling policy and priority as pthread reports them.
+#[cfg_attr(not(target_os = "macos"), allow(dead_code))]
+pub fn sched_text() -> String {
+    let mut policy = 0;
+    let mut param: libc::sched_param = unsafe { std::mem::zeroed() };
+    let rc = unsafe { libc::pthread_getschedparam(libc::pthread_self(), &mut policy, &mut param) };
+    format!("(pthread policy={policy} priority={} rc={rc})", param.sched_priority)
+}
