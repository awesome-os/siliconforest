+//! The SiliconForest pointer set (DESK7): one family of cursors for everything on the screen.
+//!
+//! The owner saw two pointers: the desk's own white triangle over the desk and native windows, and a
+//! black X11 arrow over Mac applications (AppKit's WindowServer loads `left_ptr` from libwayland-cursor's
+//! built-in set when no Xcursor theme is installed, and uploads it with `wl_pointer.set_cursor`). Now:
+//! - every pointer the desk draws itself (the default arrow, the frame's resize edges, a resize grab, a
+//!   client's hide giving way, a refused or missing client image) comes from this set;
+//! - a client may name a shape (`wp_cursor_shape_v1`); the shape is drawn from this set;
+//! - a client image that is one of the well-known images (libwayland-cursor's built-in set, or this set's
+//!   own Xcursor theme, `--write-cursor-theme`) is recognised by its pixels and replaced by this set's
+//!   drawing of the same shape at the display's scale, crisp; only truly custom images stay as drawn.
+//!
+//! The drawings are vector source in SVG (`../cursors/*.svg`, made by
+//! integrations/siliconforest/desktop/cursors/make_cursors.py; original drawings), rendered here with
+//! tiny-skia at the display's scale, the hotspot snapped to a pixel corner. Themes change nothing of it.
+use crate::scale::Scale;
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+use tiny_skia::{FillRule, LineCap, LineJoin, Paint, PathBuilder, Pixmap, Stroke, Transform};
+use wm_core::Point;
+use wm_theme_api::DecorationBuffer;
+
+include!("cursor_set.rs");
+
+/// The grid every drawing is made on (logical units: pixels at 100 %).
+pub const GRID: f32 = 24.0;
+
+#[derive(Clone, Debug, PartialEq)]
+enum Cmd {
+    M(f32, f32),
+    L(f32, f32),
+    C(f32, f32, f32, f32, f32, f32),
+    Z,
+}
+
+#[derive(Clone, Debug)]
+struct SvgPath {
+    cmds: Vec<Cmd>,
+    fill: Option<[u8; 3]>,
+    stroke: Option<([u8; 3], f32, bool, bool)>,
+}
+
+#[derive(Clone, Debug)]
+struct Drawing {
+    hotspot: (f32, f32),
+    paths: Vec<SvgPath>,
+}
+
+fn attr<'a>(element: &'a str, name: &str) -> Option<&'a str> {
+    let key = format!(" {name}=\"");
+    let start = element.find(&key)? + key.len();
+    let end = element[start..].find('"')? + start;
+    Some(&element[start..end])
+}
+
+fn colour(text: &str) -> Option<[u8; 3]> {
+    let hex = text.strip_prefix('#').filter(|h| h.len() == 6)?;
+    let v = u32::from_str_radix(hex, 16).ok()?;
+    Some([(v >> 16) as u8, (v >> 8) as u8, v as u8])
+}
+
+fn parse_d(d: &str) -> Result<Vec<Cmd>, String> {
+    let mut out = Vec::new();
+    let mut words = d.split_whitespace().peekable();
+    let num = |words: &mut std::iter::Peekable<std::str::SplitWhitespace>| -> Result<f32, String> {
+        words.next().ok_or("path data ends inside a command")?.parse::<f32>().map_err(|e| format!("path number: {e}"))
+    };
+    while let Some(word) = words.next() {
+        out.push(match word {
+            "M" => Cmd::M(num(&mut words)?, num(&mut words)?),
+            "L" => Cmd::L(num(&mut words)?, num(&mut words)?),
+            "C" => Cmd::C(num(&mut words)?, num(&mut words)?, num(&mut words)?, num(&mut words)?, num(&mut words)?, num(&mut words)?),
+            "Z" => Cmd::Z,
+            other => return Err(format!("path command {other:?} is not one this renderer reads (M L C Z)")),
+        });
+    }
+    Ok(out)
+}
+
+/// The subset of SVG make_cursors.py writes: a root with `data-hotspot`, then `<path>` elements with
+/// absolute M/L/C/Z data, `fill`, `stroke`, `stroke-width`, `stroke-linejoin`, `stroke-linecap`.
+fn parse(svg: &str) -> Result<Drawing, String> {
+    let root = svg.split('>').next().ok_or("no root element")?;
+    let hot = attr(root, "data-hotspot").ok_or("no data-hotspot")?;
+    let mut hot = hot.split_whitespace().map(|v| v.parse::<f32>());
+    let hotspot = match (hot.next(), hot.next()) {
+        (Some(Ok(x)), Some(Ok(y))) => (x, y),
+        _ => return Err("bad data-hotspot".into()),
+    };
+    let mut paths = Vec::new();
+    for element in svg.split("<path").skip(1) {
+        let element = element.split("/>").next().unwrap_or("");
+        let element = format!(" {}", element.trim_start());
+        let cmds = parse_d(attr(&element, "d").ok_or("a path without d")?)?;
+        let fill = attr(&element, "fill").filter(|f| *f != "none").map(|f| colour(f).ok_or(format!("fill {f:?}"))).transpose()?;
+        let stroke = match attr(&element, "stroke").filter(|s| *s != "none") {
+            Some(s) => {
+                let c = colour(s).ok_or(format!("stroke {s:?}"))?;
+                let w = attr(&element, "stroke-width").unwrap_or("1").parse::<f32>().map_err(|e| format!("stroke-width: {e}"))?;
+                Some((c, w, attr(&element, "stroke-linejoin") == Some("round"), attr(&element, "stroke-linecap") == Some("round")))
+            }
+            None => None,
+        };
+        paths.push(SvgPath { cmds, fill, stroke });
+    }
+    if paths.is_empty() {
+        return Err("no paths".into());
+    }
+    Ok(Drawing { hotspot, paths })
+}
+
+fn drawing(name: &str) -> Option<&'static Drawing> {
+    static DRAWINGS: OnceLock<HashMap<&'static str, Drawing>> = OnceLock::new();
+    DRAWINGS
+        .get_or_init(|| {
+            SET.iter()
+                .filter_map(|(name, svg)| match parse(svg) {
+                    Ok(d) => Some((*name, d)),
+                    Err(e) => {
+                        eprintln!("WMCURSOR the set's drawing {name} is unreadable: {e}");
+                        None
+                    }
+                })
+                .collect()
+        })
+        .get(name)
+}
+
+/// Every shape of the set by name.
+pub fn names() -> impl Iterator<Item = &'static str> {
+    SET.iter().map(|(n, _)| *n)
+}
+
+/// The shape `name` drawn at `factor` (physical pixels per logical unit): its hotspot (physical
+/// pixels from the image's top left) and its pixels (premultiplied RGBA). The hotspot lies on a
+/// pixel corner at every scale: the drawing is shifted by less than half a pixel to put it there.
+pub fn render(name: &str, factor: f32) -> Option<(Point, DecorationBuffer)> {
+    let d = drawing(name)?;
+    let side = (GRID * factor).ceil().max(1.0) as u32;
+    let mut pixmap = Pixmap::new(side, side)?;
+    let (hx, hy) = (d.hotspot.0 * factor, d.hotspot.1 * factor);
+    let hot = Point::new(hx.round() as i32, hy.round() as i32);
+    let transform = Transform::from_row(factor, 0.0, 0.0, factor, hot.x as f32 - hx, hot.y as f32 - hy);
+    for p in &d.paths {
+        let mut b = PathBuilder::new();
+        for c in &p.cmds {
+            match *c {
+                Cmd::M(x, y) => b.move_to(x, y),
+                Cmd::L(x, y) => b.line_to(x, y),
+                Cmd::C(a, bb, c2, d2, x, y) => b.cubic_to(a, bb, c2, d2, x, y),
+                Cmd::Z => b.close(),
+            }
+        }
+        let Some(path) = b.finish() else { continue };
+        let mut paint = Paint::default();
+        paint.anti_alias = true;
+        if let Some([r, g, bl]) = p.fill {
+            paint.set_color_rgba8(r, g, bl, 255);
+            pixmap.fill_path(&path, &paint, FillRule::Winding, transform, None);
+        }
+        if let Some(([r, g, bl], width, round_join, round_cap)) = p.stroke {
+            paint.set_color_rgba8(r, g, bl, 255);
+            let stroke = Stroke {
+                width,
+                line_join: if round_join { LineJoin::Round } else { LineJoin::Miter },
+                line_cap: if round_cap { LineCap::Round } else { LineCap::Butt },
+                ..Stroke::default()
+            };
+            pixmap.stroke_path(&path, &paint, &stroke, transform, None);
+        }
+    }
+    Some((hot, DecorationBuffer { width: side, height: side, pixels: pixmap.take() }))
+}
+
+/// `render` at the display's scale, kept: the same image every time it is asked for.
+pub fn image(name: &str, scale: Scale) -> (Point, DecorationBuffer) {
+    static CACHE: OnceLock<Mutex<HashMap<(String, u32), (Point, DecorationBuffer)>>> = OnceLock::new();
+    let cache = CACHE.get_or_init(Default::default);
+    let key = (name.to_string(), scale.v120());
+    if let Some(hit) = cache.lock().unwrap_or_else(|e| e.into_inner()).get(&key) {
+        return hit.clone();
+    }
+    let made = render(name, scale.factor() as f32)
+        .or_else(|| render("default", scale.factor() as f32))
+        .unwrap_or_else(|| (Point::new(0, 0), DecorationBuffer { width: 1, height: 1, pixels: vec![0, 0, 0, 255] }));
+    cache.lock().unwrap_or_else(|e| e.into_inner()).insert(key, made.clone());
+    made
+}
+
+/// The arrow at the display's scale (what `scale::arrow` drew before DESK7).
+pub fn arrow(scale: Scale) -> (Point, DecorationBuffer) {
+    image("default", scale)
+}
+
+/// A `wp_cursor_shape_v1` / CSS shape name to the set's shape: the set has every shape of the protocol
+/// (version 1) by its own name; newer ones go to their nearest.
+pub fn for_css_name(name: &str) -> &'static str {
+    if let Some(n) = names().find(|n| *n == name) {
+        return n;
+    }
+    match name {
+        "dnd-ask" => "context-menu",
+        "all-resize" => "move",
+        _ => "default",
+    }
+}
+
+/// The Xcursor (X11 and freedesktop) names a client may load from a theme, and AppKit's own
+/// (WindowServer `cursorNames`), to the set's shapes. Used for the theme the desk installs
+/// (`write_theme`): every name a client looks up finds this set's drawing.
+pub const XCURSOR_NAMES: &[(&str, &str)] = &[
+    ("left_ptr", "default"), ("arrow", "default"), ("top_left_arrow", "default"), ("default", "default"),
+    ("xterm", "text"), ("ibeam", "text"), ("text", "text"), ("vertical-text", "vertical-text"),
+    ("hand2", "pointer"), ("hand1", "pointer"), ("hand", "pointer"), ("pointer", "pointer"), ("pointing_hand", "pointer"),
+    ("openhand", "grab"), ("grab", "grab"), ("closedhand", "grabbing"), ("grabbing", "grabbing"), ("dnd-move", "grabbing"),
+    ("fleur", "move"), ("move", "move"), ("size_all", "move"), ("all-scroll", "all-scroll"),
+    ("crosshair", "crosshair"), ("cross", "crosshair"), ("tcross", "crosshair"), ("cell", "cell"), ("plus", "cell"),
+    ("sb_h_double_arrow", "ew-resize"), ("h_double_arrow", "ew-resize"), ("ew-resize", "ew-resize"), ("size_hor", "ew-resize"),
+    ("sb_v_double_arrow", "ns-resize"), ("v_double_arrow", "ns-resize"), ("ns-resize", "ns-resize"), ("size_ver", "ns-resize"),
+    ("fd_double_arrow", "nwse-resize"), ("size_fdiag", "nwse-resize"), ("nwse-resize", "nwse-resize"),
+    ("bd_double_arrow", "nesw-resize"), ("size_bdiag", "nesw-resize"), ("nesw-resize", "nesw-resize"),
+    ("col-resize", "col-resize"), ("split_h", "col-resize"), ("row-resize", "row-resize"), ("split_v", "row-resize"),
+    ("left_side", "w-resize"), ("w-resize", "w-resize"), ("right_side", "e-resize"), ("e-resize", "e-resize"),
+    ("top_side", "n-resize"), ("n-resize", "n-resize"), ("bottom_side", "s-resize"), ("s-resize", "s-resize"),
+    ("top_left_corner", "nw-resize"), ("nw-resize", "nw-resize"), ("top_right_corner", "ne-resize"), ("ne-resize", "ne-resize"),
+    ("bottom_left_corner", "sw-resize"), ("sw-resize", "sw-resize"), ("bottom_right_corner", "se-resize"), ("se-resize", "se-resize"),
+    ("not-allowed", "not-allowed"), ("crossed_circle", "not-allowed"), ("forbidden", "not-allowed"), ("no-drop", "no-drop"), ("dnd-none", "no-drop"),
+    ("copy", "copy"), ("dnd-copy", "copy"), ("alias", "alias"), ("link", "alias"), ("dnd-link", "alias"),
+    ("context-menu", "context-menu"), ("help", "help"), ("question_arrow", "help"), ("whats_this", "help"), ("dnd-ask", "context-menu"),
+    ("watch", "wait"), ("wait", "wait"), ("progress", "progress"), ("left_ptr_watch", "progress"), ("half-busy", "progress"),
+    ("zoom-in", "zoom-in"), ("zoom-out", "zoom-out"),
+];
+
+/// The nominal sizes the installed theme carries (a client loading size 24 at 100 % gets the first).
+pub const THEME_SIZES: [u32; 3] = [24, 36, 48];
+
+fn fnv(width: u32, height: u32, pixels: &[u8]) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for b in width.to_le_bytes().iter().chain(height.to_le_bytes().iter()).chain(pixels) {
+        h = (h ^ u64::from(*b)).wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    h
+}
+
+/// libwayland-cursor's built-in images (its `cursor-data.h`, what AppKit shows when no theme is
+/// installed): the hash of each image's RGBA pixels with its size, its name there, the set's shape.
+/// The shapes follow what AppKit asks those images for (WindowServer `cursorNames`): `right_side` is
+/// what resizeLeftRightCursor finds, `grabbing` (a fleur) what closedHandCursor finds, `hand1` what
+/// pointingHandCursor finds.
+const BUILT_IN: &[(u64, &str, &str)] = &[
+    (0x07b8a4b6061f3568, "bottom_left_corner", "nesw-resize"),
+    (0xf070e033c022fb28, "bottom_right_corner", "nwse-resize"),
+    (0x26115b5ba4a578f7, "bottom_side", "ns-resize"),
+    (0x6ca55e5b0b1ade91, "grabbing", "grabbing"),
+    (0x637a81e2352dd8df, "left_ptr", "default"),
+    (0x09332612a085ed7f, "left_side", "ew-resize"),
+    (0x1038738a42d174b7, "right_side", "ew-resize"),
+    (0xc82a1c25c8af30d8, "top_left_corner", "nwse-resize"),
+    (0xb1f1f9387c8abb98, "top_right_corner", "nesw-resize"),
+    (0xec178fed4a32501f, "top_side", "ns-resize"),
+    (0xf33fad4e4778e714, "xterm", "text"),
+    (0xcea831189e9ec7f1, "hand1", "pointer"),
+    (0x7242db70297e196c, "watch", "wait"),
+];
+
+/// What a client's cursor image is, when it is a well-known one: (the set's shape, where the image is
+/// from). `None`: a custom image, shown as the client drew it.
+pub fn recognise(image: &DecorationBuffer) -> Option<(&'static str, &'static str)> {
+    let hash = fnv(image.width, image.height, &image.pixels);
+    if let Some((_, _, shape)) = BUILT_IN.iter().find(|(h, _, _)| *h == hash) {
+        return Some((shape, "libwayland-cursor's built-in image"));
+    }
+    static THEME: OnceLock<HashMap<u64, &'static str>> = OnceLock::new();
+    THEME
+        .get_or_init(|| {
+            let mut table = HashMap::new();
+            for name in names() {
+                for size in THEME_SIZES {
+                    if let Some((_, img)) = render(name, size as f32 / GRID) {
+                        table.entry(fnv(img.width, img.height, &img.pixels)).or_insert(name);
+                    }
+                }
+            }
+            table
+        })
+        .get(&hash)
+        .map(|shape| (*shape, "the SiliconForest theme"))
+}
+
+/// The name a built-in image has in libwayland-cursor (for the log), when it is one.
+pub fn built_in_name(image: &DecorationBuffer) -> Option<&'static str> {
+    let hash = fnv(image.width, image.height, &image.pixels);
+    BUILT_IN.iter().find(|(h, _, _)| *h == hash).map(|(_, n, _)| *n)
+}
+
+/// The image's hash, as `recognise` computes it (for the log of images not recognised).
+pub fn image_hash(image: &DecorationBuffer) -> u64 {
+    fnv(image.width, image.height, &image.pixels)
+}
+
+/// An Xcursor file holding `shape` at every size of `THEME_SIZES` (premultiplied ARGB, the format
+/// libXcursor and libwayland-cursor read).
+pub fn xcursor_file(shape: &str) -> Option<Vec<u8>> {
+    let images: Vec<(u32, Point, DecorationBuffer)> =
+        THEME_SIZES.iter().filter_map(|size| render(shape, *size as f32 / GRID).map(|(h, i)| (*size, h, i))).collect();
+    if images.is_empty() {
+        return None;
+    }
+    let mut out = Vec::new();
+    let put = |out: &mut Vec<u8>, v: u32| out.extend_from_slice(&v.to_le_bytes());
+    put(&mut out, 0x7275_6358); // "Xcur"
+    put(&mut out, 16);
+    put(&mut out, 0x1_0000);
+    put(&mut out, images.len() as u32);
+    let mut position = 16 + 12 * images.len() as u32;
+    for (size, _, image) in &images {
+        put(&mut out, 0xfffd_0002);
+        put(&mut out, *size);
+        put(&mut out, position);
+        position += 36 + 4 * image.width * image.height;
+    }
+    for (size, hot, image) in &images {
+        for v in [36, 0xfffd_0002, *size, 1, image.width, image.height, hot.x as u32, hot.y as u32, 0] {
+            put(&mut out, v);
+        }
+        for p in image.pixels.chunks_exact(4) {
+            put(&mut out, u32::from(p[3]) << 24 | u32::from(p[0]) << 16 | u32::from(p[1]) << 8 | u32::from(p[2]));
+        }
+    }
+    Some(out)
+}
+
+/// `--write-cursor-theme <dir>`: the set as an Xcursor theme (`<dir>/cursors/<name>` for every name of
+/// `XCURSOR_NAMES` and every shape, `<dir>/index.theme`). Installed as `/usr/share/icons/default` it is
+/// what libwayland-cursor (AppKit's WindowServer) loads, so every NSCursor that maps to a theme name shows
+/// this set; the desk then recognises those images and draws them crisp at the display's scale.
+pub fn write_theme(dir: &std::path::Path) -> Result<usize, String> {
+    let cursors = dir.join("cursors");
+    std::fs::create_dir_all(&cursors).map_err(|e| format!("{}: {e}", cursors.display()))?;
+    let mut written = 0;
+    let mut all: Vec<(&str, &str)> = XCURSOR_NAMES.to_vec();
+    all.extend(names().map(|n| (n, n)));
+    for (file, shape) in all {
+        let bytes = xcursor_file(shape).ok_or(format!("no drawing for {shape}"))?;
+        std::fs::write(cursors.join(file), bytes).map_err(|e| format!("{file}: {e}"))?;
+        written += 1;
+    }
+    std::fs::write(dir.join("index.theme"), "[Icon Theme]\nName=SiliconForest\nComment=The SiliconForest pointer set (one family everywhere)\n")
+        .map_err(|e| format!("index.theme: {e}"))?;
+    Ok(written)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn at(img: &DecorationBuffer, x: i32, y: i32) -> [u8; 4] {
+        if x < 0 || y < 0 || x >= img.width as i32 || y >= img.height as i32 {
+            return [0; 4];
+        }
+        let i = (y as usize * img.width as usize + x as usize) * 4;
+        [img.pixels[i], img.pixels[i + 1], img.pixels[i + 2], img.pixels[i + 3]]
+    }
+
+    #[test]
+    fn every_drawing_of_the_set_is_read_and_drawn_at_every_scale() {
+        assert!(SET.len() >= 34, "{}", SET.len());
+        for (name, _) in SET {
+            for v120 in crate::scale::STEPS {
+                let scale = Scale::from_120(v120).unwrap();
+                let (hot, img) = render(name, scale.factor() as f32).unwrap_or_else(|| panic!("{name} not drawn"));
+                let side = (GRID * scale.factor() as f32).ceil() as u32;
+                assert_eq!((img.width, img.height), (side, side), "{name} at {v120}");
+                assert!(hot.x >= 0 && hot.y >= 0 && (hot.x as u32) < side && (hot.y as u32) < side, "{name}: hotspot {hot:?} outside");
+                let opaque = img.pixels.chunks_exact(4).filter(|p| p[3] > 200).count();
+                assert!(opaque > (side * side / 40) as usize, "{name} at {v120}: almost empty ({opaque})");
+                // nothing touches the image's edge: the outline is whole
+                for i in 0..side as i32 {
+                    for (x, y) in [(i, 0), (0, i), (i, side as i32 - 1), (side as i32 - 1, i)] {
+                        assert!(at(&img, x, y)[3] < 128, "{name} at {v120}: cut at the edge ({x},{y})");
+                    }
+                }
+            }
+        }
+    }
+
+    /// The tip pixel is the logical position: at every scale the arrow's tip lies on the hotspot pixel's
+    /// top-left corner, so that pixel is the tip's (opaque, darkened by the black tip that covers about
+    /// half of it), the one up and left of it holds no black, and the arrow is black with a white
+    /// outline (the look of the owner's Mac arrow, drawn by us).
+    #[test]
+    fn the_arrows_tip_pixel_is_the_hotspot_at_every_scale() {
+        for v120 in [120, 150, 180, 240] {
+            let scale = Scale::from_120(v120).unwrap();
+            let (hot, img) = arrow(scale);
+            let tip = at(&img, hot.x, hot.y);
+            assert!(tip[3] > 230 && u32::from(tip[0]) + u32::from(tip[1]) + u32::from(tip[2]) < 3 * 200, "{v120}: tip pixel {tip:?}");
+            let below = at(&img, hot.x, hot.y + scale.factor().ceil() as i32 + 1);
