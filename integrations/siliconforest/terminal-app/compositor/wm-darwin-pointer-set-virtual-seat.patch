+pub(crate) struct LoopProbe {
+    turns: u64,
+    over: [u64; 4],
+    max_us: u64,
+    worst: String,
+    said: Option<Instant>,
+    pub(crate) queue_wait: Series,
+    pub(crate) pointer_gaps: Series,
+    last_pointer: Option<(wm_core::Point, Instant)>,
+}
+impl Default for LoopProbe {
+    fn default() -> Self {
+        Self { turns: 0, over: [0; 4], max_us: 0, worst: String::new(), said: None, queue_wait: Series::default(), pointer_gaps: Series::default(), last_pointer: None }
+    }
+}
+pub(crate) const STALL: Duration = Duration::from_millis(8);
+impl LoopProbe {
+    pub fn turn(&mut self, parts: &[(&'static str, Duration)]) {
+        let total: Duration = parts.iter().map(|(_, d)| *d).sum();
+        let us = total.as_micros() as u64;
+        self.turns += 1;
+        for (i, limit) in [4_000, 8_000, 16_000, 33_000].iter().enumerate() {
+            if us > *limit {
+                self.over[i] += 1;
+            }
+        }
