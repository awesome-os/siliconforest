+/// DESK7, the owner's finding: "a time when moving the mouse around was laggy and stuttering ... maybe
+/// automation fighting for mouse control". The test instrument's events drive a pointer of their own:
+/// the owner's pointer is never moved or drawn elsewhere by them; while he is active they reach the
+/// client under the instrument's pointer only (no raise, no focus); its keys go to the window it pressed
+/// in, never to the window he types into; his input wins over whatever the instrument holds.
+#[cfg(feature = "desktop-shell")]
+#[test]
+fn synthetic_input_never_moves_the_owners_pointer_or_takes_his_keys(){
+    use wm_darwin::hid::{Event,Motion};
+    let(h,connection)=Harness::with_input(true);
+    let(mut qa,mut ca,_sa,_ta)=map_with_seat(&connection);
+    let (server_end,client_end)=UnixStream::pair().unwrap();
+    h.tx.send(Request::AddClient(server_end)).unwrap();
+    let other=Connection::from_socket(client_end).unwrap();
+    let(mut qb,mut cb,_sb,_tb)=map_with_seat(&other);
+    for _ in 0..3{h.snapshot();qa.roundtrip(&mut ca).unwrap();qb.roundtrip(&mut cb).unwrap();}
+    let shot=h.snapshot();
+    assert_eq!(shot.windows.len(),2,"{:?}",shot.windows);
+    let (a,b)=(shot.windows[0].0,shot.windows[1].0);
+    assert!(shot.windows[1].1,"the newer window B has the focus: {:?}",shot.windows);
+    let inside=|r:wm_core::Rect,p:wm_core::Point|p.x>=r.pos.x && p.y>=r.pos.y && p.x<r.pos.x+r.size.w as i32 && p.y<r.pos.y+r.size.h as i32;
+    let in_a=(0..a.size.h as i32).flat_map(|dy|(0..a.size.w as i32).map(move|dx|wm_core::Point::new(a.pos.x+dx,a.pos.y+dy))).find(|p|!inside(b,*p)&&p.x>a.pos.x+2&&p.y>a.pos.y+2).expect("a point of A that B does not cover");
+    let abs=|p:wm_core::Point|Motion::Absolute(((f64::from(p.x)+0.25)/319.*65535.).round() as u16,((f64::from(p.y)+0.25)/239.*65535.).round() as u16);
+    let virt=|e:Event|{let(tx,rx)=mpsc::channel();h.tx.send(Request::Virtual(e,tx)).unwrap();rx.recv_timeout(Duration::from_secs(3)).unwrap()};
+    let sync=|qa:&mut wayland_client::EventQueue<Client>,ca:&mut Client,qb:&mut wayland_client::EventQueue<Client>,cb:&mut Client|{for _ in 0..3{h.snapshot();qa.roundtrip(ca).unwrap();qb.roundtrip(cb).unwrap();}};
+    // the owner's hand: his pointer at the middle of B, he is active
+    let mine=wm_core::Point::new(b.pos.x+b.size.w as i32/2,b.pos.y+b.size.h as i32/2);
+    h.tx.send(Request::Owner(Event::Pointer{motion:abs(mine),buttons:0,wheel:0})).unwrap();
+    sync(&mut qa,&mut ca,&mut qb,&mut cb);
+    assert_eq!(h.snapshot().pointer,mine);
+    // the instrument clicks in A: A gets the click, the owner's pointer stays where it is, B keeps the focus
+    let before=ca.buttons.len();
+    virt(Event::Pointer{motion:abs(in_a),buttons:0,wheel:0}).unwrap();
+    virt(Event::Pointer{motion:Motion::Relative(0,0),buttons:1,wheel:0}).unwrap();
+    virt(Event::Pointer{motion:Motion::Relative(0,0),buttons:0,wheel:0}).unwrap();
+    sync(&mut qa,&mut ca,&mut qb,&mut cb);
+    let shot=h.snapshot();
+    assert_eq!(shot.pointer,mine,"the synthetic pointer moved the owner's");
+    assert_eq!(ca.buttons.len(),before+2,"A got the synthetic press and release");
+    assert!(shot.windows[1].1,"the owner's window kept the focus: {:?}",shot.windows);
+    // the instrument's keys go to A, the window it pressed in, not to B, where the owner types
+    let (ka,kb)=(ca.keys.len(),cb.keys.len());
+    virt(Event::Key{evdev:30,down:true}).unwrap();
+    virt(Event::Key{evdev:30,down:false}).unwrap();
+    sync(&mut qa,&mut ca,&mut qb,&mut cb);
+    assert_eq!(ca.keys.len(),ka+2,"A got the synthetic key");
+    assert_eq!(cb.keys.len(),kb,"the owner's window got none of the synthetic keys");
+    // the owner types: B gets his key, A none of it
+    let (ka,kb)=(ca.keys.len(),cb.keys.len());
+    h.tx.send(Request::Owner(Event::Key{evdev:48,down:true})).unwrap();
+    h.tx.send(Request::Owner(Event::Key{evdev:48,down:false})).unwrap();
+    sync(&mut qa,&mut ca,&mut qb,&mut cb);
+    assert_eq!((ca.keys.len(),cb.keys.len()),(ka,kb+2),"the owner's key went to his window");
+    // a synthetic modifier held when the owner types is let go first: his key is not modified by it
+    virt(Event::Key{evdev:29,down:true}).unwrap(); // Control, held by the instrument
+    sync(&mut qa,&mut ca,&mut qb,&mut cb);
+    let masks=cb.modifier_masks.len();
+    h.tx.send(Request::Owner(Event::Key{evdev:48,down:true})).unwrap();
+    h.tx.send(Request::Owner(Event::Key{evdev:48,down:false})).unwrap();
+    sync(&mut qa,&mut ca,&mut qb,&mut cb);
+    assert!(cb.modifier_masks[masks..].iter().all(|m|m&4==0),"the owner's key arrived with the synthetic Control: {:?}",&cb.modifier_masks[masks..]);
+    assert!(ca.keys.iter().rev().take(2).any(|(k,st)|*k==29 && *st==wayland_client::WEnum::Value(wl_keyboard::KeyState::Released)),"A saw the synthetic Control let go: {:?}",ca.keys);
