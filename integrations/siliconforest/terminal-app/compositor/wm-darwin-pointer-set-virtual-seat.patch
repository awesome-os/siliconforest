+    /// `CURSOR_SHEET_DIR=<dir>`: every shape at 100/150/200 % as PNG (evidence pictures), on a mid grey,
+    /// with the hotspot pixel marked in red beside each.
+    #[test]
+    fn a_contact_sheet_of_the_set_when_asked() {
+        let Some(dir) = std::env::var_os("CURSOR_SHEET_DIR") else { return };
+        let dir = std::path::PathBuf::from(dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        for v120 in [120, 180, 240] {
+            let scale = Scale::from_120(v120).unwrap();
+            let cell = (GRID * scale.factor() as f32).ceil() as u32 + 8;
+            let cols = 9u32;
+            let rows = (SET.len() as u32 + cols - 1) / cols;
+            let (w, h) = (cols * cell, rows * cell);
+            let mut sheet = vec![0u8; (w * h * 4) as usize];
+            for p in sheet.chunks_exact_mut(4) {
+                p.copy_from_slice(&[138, 155, 176, 255]);
+            }
+            for (i, (name, _)) in SET.iter().enumerate() {
+                let (hot, img) = image(name, scale);
+                let (ox, oy) = ((i as u32 % cols) * cell + 4, (i as u32 / cols) * cell + 4);
+                for y in 0..img.height {
+                    for x in 0..img.width {
+                        let s = ((y * img.width + x) * 4) as usize;
+                        let d = (((oy + y) * w + ox + x) * 4) as usize;
+                        let a = u32::from(img.pixels[s + 3]);
+                        for c in 0..3 {
+                            sheet[d + c] = (u32::from(img.pixels[s + c]) + u32::from(sheet[d + c]) * (255 - a) / 255) as u8;
+                        }
+                    }
+                }
+                let d = (((oy + hot.y as u32) * w + ox + hot.x as u32) * 4) as usize;
+                sheet[d..d + 4].copy_from_slice(&[255, 0, 0, 255]);
+            }
+            let file = std::fs::File::create(dir.join(format!("cursor-set-{}.png", scale.label().replace('%', "")))).unwrap();
+            let mut enc = png::Encoder::new(std::io::BufWriter::new(file), w, h);
+            enc.set_color(png::ColorType::Rgba);
+            enc.set_depth(png::BitDepth::Eight);
+            enc.write_header().unwrap().write_image_data(&sheet).unwrap();
+        }
+    }
+}
