+#![cfg(all(feature = "darwin-backend", feature = "desktop-shell"))]
+//! A headless two-output run of the desk on the workstation with real clients (DESK5): the
+//! compositor (CPU renderer, the desk's own session: Spaces per display) on a Wayland socket,
+//! two `foot` terminals (Linux programs, connecting as any client does), a virtual external
+//! display plugged at run time, one terminal dragged across onto it by pointer events through the
+//! desk's input path, the external unplugged. Pictures of each output are written as PNG files.
+//!
+//!   HEADLESS_DIR=<empty private dir> cargo test -p wm-darwin --features desktop-shell \
+//!       --test headless_outputs -- --ignored --nocapture
+//!
+//! Synthetic input (deliver_hid), no device; nothing here is evidence of a physical display.
+use std::{
+    os::unix::fs::PermissionsExt,
+    path::PathBuf,
+    process::{Child, Command},
+    time::{Duration, Instant},
+};
+use wm_core::{Point, Rect, Size};
+use wm_darwin::hid::{Event, Motion};
+use wm_darwin::outputs::{OutputKind, SceneOutput};
+use wm_darwin::presenter::Presenter;
+use wm_darwin::server::Server;
+use wm_darwin::smithay::reexports::wayland_server::{Display, ListeningSocket};
+
+struct Frame(Option<tiny_skia::Pixmap>);
+impl Presenter for Frame {
+    fn present(&mut self, f: &tiny_skia::Pixmap) -> Result<(), String> {
+        self.0 = Some(f.clone());
+        Ok(())
+    }
+}
+struct Desk {
+    display: Display<Server>,
+    server: Server,
+    listener: ListeningSocket,
+    frame: Frame,
+    started: Instant,
+}
+impl Desk {
+    fn ms(&self) -> u32 {
+        self.started.elapsed().as_millis() as u32
+    }
+    fn turn(&mut self) {
+        while let Some(stream) = self.listener.accept().unwrap() {
+            Server::add_client(&mut self.display, stream).unwrap();
+        }
+        self.display.dispatch_clients(&mut self.server).unwrap();
+        let ms = self.ms();
+        self.server.foreign_sync();
+        let _ = self.server.repaint(&mut self.frame, ms);
+        self.display.flush_clients().unwrap();
+        std::thread::sleep(Duration::from_millis(4));
+    }
+    fn run_for(&mut self, d: Duration) {
+        let until = Instant::now() + d;
+        while Instant::now() < until {
+            self.turn();
+        }
+    }
+    fn until(&mut self, what: &str, limit: Duration, mut done: impl FnMut(&Server) -> bool) {
+        let until = Instant::now() + limit;
+        while !done(&self.server) {
+            assert!(Instant::now() < until, "timed out: {what}");
+            self.turn();
+        }
+    }
+    fn pointer(&mut self, at: Point, buttons: u8) {
+        let size = wm_core::Backend::screen_size(self.server.wm.backend());
+        let x = (f64::from(at.x) * 65535.0 / f64::from(size.w - 1)).round() as u16;
+        let y = (f64::from(at.y) * 65535.0 / f64::from(size.h - 1)).round() as u16;
+        let ms = self.ms();
+        self.server.deliver_hid(Event::Pointer { motion: Motion::Absolute(x, y), buttons, wheel: 0 }, ms).unwrap();
+        self.turn();
+    }
+    fn shot(&mut self, dir: &PathBuf, name: &str) {
+        self.server.wm.backend_mut().dirty = true;
+        self.run_for(Duration::from_millis(60));
+        let frame = self.frame.0.as_ref().expect("a frame");
+        for o in self.server.scene_outputs() {
+            let r = o.rect;
+            let png = wm_darwin::capture::encode_png(frame, Rect::new(r.pos, Size::new(r.size.w.min(frame.width() - r.pos.x as u32), r.size.h.min(frame.height() - r.pos.y as u32)))).unwrap();
+            let path = dir.join(format!("{name}-{}.png", o.name));
+            std::fs::write(&path, png).unwrap();
+            println!("HEADLESS shot {} {}x{} at {},{}", path.display(), r.size.w, r.size.h, r.pos.x, r.pos.y);
+        }
+    }
+}
+fn terminals(server: &Server) -> Vec<(u64, Rect)> {
+    let mut v: Vec<(u64, Rect)> = server.wm.backend().windows.iter().filter(|(_, w)| w.mapped).filter_map(|(id, _)| Some((*id, server.wm.backend().window_frame_rect(*id)?))).collect();
+    v.sort_by_key(|(id, _)| *id);
+    v
+}
+/// A real Linux terminal as the client: foot (shm, server-side decorations when offered).
+fn foot(dir: &PathBuf, title: &str) -> Child {
+    Command::new("foot")
+        .args(["--title", title, "--app-id", "headless-foot", "-o", "csd.preferred=server", "sh", "-c", &format!("echo {title}; echo on the desk of SiliconForest, headless; sleep 60")])
+        .env("WAYLAND_DISPLAY", dir.join("wayland-0"))
+        .env("XDG_RUNTIME_DIR", dir)
+        .env_remove("DISPLAY")
+        .spawn()
+        .expect("foot")
+}
+
+#[test]
+#[ignore]
+fn two_outputs_with_real_terminals_a_drag_across_and_an_unplug() {
+    let dir = PathBuf::from(std::env::var("HEADLESS_DIR").expect("HEADLESS_DIR=<empty private dir>"));
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700)).unwrap();
+    let shots = dir.join("shots");
+    std::fs::create_dir_all(&shots).unwrap();
+    let _ = std::fs::remove_file(dir.join("wayland-0"));
+    let listener = ListeningSocket::bind_absolute(dir.join("wayland-0")).unwrap();
+    let display = Display::<Server>::new().unwrap();
+    let mut server = Server::new(&display.handle(), Size::new(2560, 1600)).unwrap();
+    server.enable_sfhid_seat_caps(&display.handle(), wm_darwin::hid::SeatCaps { keyboard: true, pointer: true }).unwrap();
+    server.enable_desktop_shell(wm_theme::FontState::new()).unwrap();
+    // foot will not start without a wl_subcompositor (its subsurfaces are not drawn here)
+    server.offer_subcompositor_for_host_clients(&display.handle());
+    server.set_scale(wm_darwin::scale::Scale::from_120(180).unwrap()).unwrap();
+    let mut desk = Desk { display, server, listener, frame: Frame(None), started: Instant::now() };
+    desk.run_for(Duration::from_millis(300));
+    let mut a = foot(&dir, "terminal-one");
+    let mut b = foot(&dir, "terminal-two");
+    desk.until("two terminal windows", Duration::from_secs(20), |s| terminals(s).len() >= 2);
+    desk.run_for(Duration::from_millis(800));
+    println!("HEADLESS windows before: {:?}", terminals(&desk.server));
+    desk.shot(&shots, "a-panel-only");
+
+    // plug a virtual 27" 4K beside the panel: the primary
+    let scale = wm_darwin::scale::Scale::from_120(180).unwrap();
+    let panel = SceneOutput { primary: false, ..SceneOutput::panel(Size::new(2560, 1600), scale) };
+    let external = SceneOutput { name: "DP-1".into(), id: "virtual-4k".into(), kind: OutputKind::External, rect: Rect::new(Point::new(2560, 0), Size::new(3840, 2160)), pixels: (3840, 2160), scale, logical: (2560, 1440), primary: true };
+    println!("HEADLESS plug: {}", desk.server.set_scene_outputs(&[panel.clone(), external.clone()]).unwrap());
+    desk.run_for(Duration::from_millis(500));
+    desk.shot(&shots, "b-plugged");
+
+    // drag the second terminal by its title bar across the panel's right edge onto the external
+    let (id, frame) = terminals(&desk.server)[1];
+    let grab = Point::new(frame.pos.x + frame.size.w as i32 / 2, frame.pos.y + 12);
+    desk.pointer(grab, 0);
+    desk.pointer(grab, 1);
+    let target = Point::new(2560 + 1400, 700);
+    for i in 1..=60 {
+        let p = Point::new(grab.x + (target.x - grab.x) * i / 60, grab.y + (target.y - grab.y) * i / 60);
+        desk.pointer(p, 1);
+    }
+    desk.pointer(target, 0);
+    desk.run_for(Duration::from_millis(400));
+    let after: Vec<(u64, Rect)> = terminals(&desk.server);
+    println!("HEADLESS windows after the drag: {after:?}");
+    let dragged = after.iter().find(|(w, _)| *w == id).unwrap().1;
+    assert!(dragged.pos.x >= 2560, "the dragged terminal is on the external: {dragged:?}");
+    let pointer = wm_core::Backend::pointer_position(desk.server.wm.backend()).unwrap();
+    assert!(pointer.x > 2560, "the pointer crossed onto the external: {pointer:?}");
+    desk.shot(&shots, "c-dragged-onto-external");
+    // the external's picture shows the terminal: not the wallpaper's colour at its centre
+    {
+        let f = desk.frame.0.as_ref().unwrap();
+        let c = Point::new(dragged.pos.x + dragged.size.w as i32 / 2, dragged.pos.y + dragged.size.h as i32 / 2);
+        let px = f.pixel(c.x as u32, c.y as u32).unwrap();
+        println!("HEADLESS external pixel at the terminal's centre {c:?}: rgba=({},{},{},{})", px.red(), px.green(), px.blue(), px.alpha());
+    }
+
+    // unplug: the terminal comes back onto the panel
+    let solo = SceneOutput { primary: true, ..panel };
+    println!("HEADLESS unplug: {}", desk.server.set_scene_outputs(&[solo]).unwrap());
+    desk.run_for(Duration::from_millis(500));
+    let back: Vec<(u64, Rect)> = terminals(&desk.server);
+    println!("HEADLESS windows after the unplug: {back:?}");
+    let home = back.iter().find(|(w, _)| *w == id).map(|(_, r)| *r).unwrap();
+    assert!(home.pos.x >= 0 && home.pos.x + home.size.w as i32 <= 2560 + 8, "the terminal is back on the panel: {home:?}");
+    desk.shot(&shots, "d-unplugged");
+    let _ = a.kill();
+    let _ = b.kill();
+    let _ = a.wait();
+    let _ = b.wait();
+}
