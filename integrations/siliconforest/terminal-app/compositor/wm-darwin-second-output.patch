+/// TERM, 5.1 again (DESK5): an application that closes a minimised window and keeps running (as
+/// an AppKit application outlives its windows) must not leave the window's tile on the desk.
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn a_minimised_windows_tile_goes_when_the_window_is_closed_and_the_application_stays() {
+    let (h, a) = Harness::sized(true, 640, 480, 15);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let settle = || { for _ in 0..10 { h.snapshot(); thread::sleep(Duration::from_millis(10)); } };
+    settle();
+    let (mut qa, mut ca, _sa, _xa, _ta) = map_client(&a, "stays");
+    let (mut qb, mut cb, sb, xb, tb) = map_client(&a, "closed while minimised");
+    settle();
+    let before = h.snapshot().shells;
+    tb.set_minimized();
+    qb.roundtrip(&mut cb).unwrap();
+    settle();
+    assert!(h.snapshot().shells > before, "a tile for the minimised window");
+    // the application closes that window (role objects and surface destroyed), the connection stays
+    tb.destroy();
+    xb.destroy();
+    sb.destroy();
+    qb.roundtrip(&mut cb).unwrap();
+    settle();
+    qa.roundtrip(&mut ca).unwrap();
+    settle();
+    let after = h.snapshot();
+    assert_eq!(after.shells, before, "the tile stayed after its window was closed");
+    assert_eq!(after.managed, 1);
+}
