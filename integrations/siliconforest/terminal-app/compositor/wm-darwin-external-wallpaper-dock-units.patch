+#[cfg(test)]
+mod output_background_tests {
+    use super::*;
+    /// DESK6 (second display): the wallpaper is fitted to an external output - scaled to cover
+    /// it, the middle kept - and drawn at the output's place in the scene; the colour alone there before.
+    #[test]
+    fn an_external_output_gets_the_wallpaper_fitted_to_its_shape() {
+        // a 16:10 picture: left half red, right half blue, a green stripe across the middle rows
+        let (w, h) = (160u32, 100u32);
+        let mut pixels = Vec::new();
+        for y in 0..h {
+            for x in 0..w {
+                pixels.extend_from_slice(&if (45..55).contains(&y) { [0, 255, 0, 255] } else if x < w / 2 { [255, 0, 0, 255] } else { [0, 0, 255, 255] });
+            }
+        }
+        let image = DecorationBuffer { width: w, height: h, pixels };
+        // 16:9 target: the picture's top and bottom rows are cut, it is scaled to the full width
+        let fitted = cover(&image, 320, 180).unwrap();
+        assert_eq!((fitted.width, fitted.height), (320, 180));
+        let at = |x: u32, y: u32| { let i = (y * 320 + x) as usize * 4; [fitted.pixels[i], fitted.pixels[i + 1], fitted.pixels[i + 2]] };
+        assert_eq!(at(10, 10), [255, 0, 0]);
+        assert_eq!(at(310, 10), [0, 0, 255]);
+        assert_eq!(at(10, 90), [0, 255, 0], "the middle stays in the middle");
+        let mut scene = CpuBackend::new(Size::new(160, 100)).unwrap();
+        wm_core::Backend::paint_root_image(&mut scene, &image);
+        let external = Rect::new(Point::new(160, 0), Size::new(320, 180));
+        scene.set_external_rects(vec![external]);
+        let list = scene.display_list();
+        let outputs = list.iter().find_map(|(_, op)| match op { DrawOp::Background { outputs, .. } => Some(outputs.len()), _ => None });
+        assert_eq!(outputs, Some(1), "the wallpaper for the external output is in the display list");
+        assert_eq!(scene.output_backgrounds[0].0, external);
+        scene.set_external_rects(Vec::new());
+        assert!(scene.output_backgrounds.is_empty(), "unplugged: no picture kept for it");
+    }
+}
