+/// `image` scaled to cover `width` x `height`, centred, the overhang cut.
+pub(crate) fn cover(image: &DecorationBuffer, width: u32, height: u32) -> Option<DecorationBuffer> {
+    if image.width == 0 || image.height == 0 || width == 0 || height == 0 || image.pixels.len() != image.width as usize * image.height as usize * 4 {
+        return None;
+    }
+    // the part of the image with the target's shape
+    let (iw, ih) = (u64::from(image.width), u64::from(image.height));
+    let (cw, ch) = if iw * u64::from(height) > ih * u64::from(width) { ((ih * u64::from(width) / u64::from(height)).max(1), ih) } else { (iw, (iw * u64::from(height) / u64::from(width)).max(1)) };
+    let (x0, y0) = ((iw - cw) / 2, (ih - ch) / 2);
+    let mut pixels = Vec::with_capacity(cw as usize * ch as usize * 4);
+    for y in y0..y0 + ch {
+        let row = (y * iw + x0) as usize * 4;
+        pixels.extend_from_slice(&image.pixels[row..row + cw as usize * 4]);
+    }
+    crate::pixels::resample(&DecorationBuffer { width: cw as u32, height: ch as u32, pixels }, width, height).ok()
+}
