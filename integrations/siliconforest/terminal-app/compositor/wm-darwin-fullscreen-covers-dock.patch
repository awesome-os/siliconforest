+    /// Once a frame: a full-screen window on the Space shown covers the top layer (the dock), as
+    /// on macOS and in wlroots compositors; the overlay layer stays above it.
+    pub fn layers_follow_fullscreen(&mut self) {
+        if self.layers.is_empty() {
+            return;
+        }
+        let space = self.wm.current_workspace();
+        let covered = self.wm.iter_clients().any(|(_, c)| {
+            c.workspace == space && c.lifecycle == wm_core::Lifecycle::Normal && c.flags.contains(wm_core::ClientFlags::FULLSCREEN)
+        });
+        let mut changed = false;
+        for i in 0..self.layers.len() {
+            let hide = covered && !self.layers[i].overlay && self.layers[i].above;
+            if self.layers[i].hidden == hide {
+                continue;
+            }
+            self.layers[i].hidden = hide;
+            changed = true;
+            if let Some(shell) = self.layers[i].shell {
+                let backend = self.wm.backend_mut();
+                if hide { backend.unmap_shell_surface(shell) } else { backend.map_shell_surface(shell) }
+            }
+        }
+        if changed {
+            eprintln!("WMLAYER top layer {} (full-screen window on Space {})", if covered { "covered" } else { "shown" }, space + 1);
+            self.refresh_pointer();
+        }
+    }
