+    /// Where a pointer delivery would send a wheel notch (DESK10): the finger frame waiting
+    /// (`finger_pending`) or the notch.
+    fn send_wheel(&mut self,pointer:&PointerHandle<Server>,wheel:i8,time:u32){
+        if let Some((dy,stop))=self.finger_pending.take(){
+            let mut frame=AxisFrame::new(time).source(AxisSource::Finger);
+            if dy!=0. {
+                let direction=if self.policy.now.natural_scroll {AxisRelativeDirection::Inverted} else {AxisRelativeDirection::Identical};
+                frame=frame.value(Axis::Vertical,dy).relative_direction(Axis::Vertical,direction);
+            }
+            if stop {frame=frame.stop(Axis::Vertical);}
+            if dy!=0. || stop {pointer.axis(self,frame);}
+        }
+        if wheel!=0 {pointer.axis(self,AxisFrame::new(time).source(AxisSource::Wheel).value(Axis::Vertical,-f64::from(wheel)*10.).v120(Axis::Vertical,-i32::from(wheel)*120));}
+    }
+    /// One finger frame of the trackpad's scrolling, on its seat: at once when that is the seat being
+    /// delivered now, else at the loop's next turn (`scroll_tick`).
+    pub(crate) fn deliver_finger(&mut self,out:crate::scroll::Out,time:u32)->Result<(),String>{
+        let now_virtual=self.input.as_ref().is_some_and(|i|i.virtual_active);
+        if out.virt!=now_virtual {self.finger_later.push(out);return Ok(());}
+        self.deliver_hid(Event::FingerAxis{dy_q8:(out.dy*256.).round() as i32,stop:out.stop},time)
+    }
+    /// Every turn of the loop (DESK10): a coarse step's travel as it falls due, the lift after a pause.
+    pub fn scroll_tick(&mut self,time:u32){
+        let mut outs=std::mem::take(&mut self.finger_later);
+        outs.extend(self.touch_scroll.tick(std::time::Instant::now()));
+        self.flush_scroll_log();
+        for out in outs {
+            let event=Event::FingerAxis{dy_q8:(out.dy*256.).round() as i32,stop:out.stop};
+            let result=if out.virt {self.deliver_virtual(event,time)} else {self.deliver_hid(event,time)};
+            if let Err(error)=result {eprintln!("WMSCROLL finger frame not delivered: {error}");}
+        }
+    }
+    pub(crate) fn flush_scroll_log(&mut self){
+        for line in self.touch_scroll.log.drain(..) {eprintln!("{line}");}
