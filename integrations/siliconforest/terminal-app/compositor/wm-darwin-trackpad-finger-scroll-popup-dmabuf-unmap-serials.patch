+/// DESK10 (FX-022, the first click on Firefox's menu button showed no menu): a popup whose client draws
+/// it on the GPU (a dma-buf, as Firefox's menu panel with its GPU layers) is shown like a toplevel's
+/// buffer - read through a CPU mapping into the popup's picture - not refused ("SHM access failed").
+#[test]
+fn a_popups_dmabuf_is_shown_not_refused() {
+    let (h, connection) = Harness::start(true);
+    let mut queue = connection.new_event_queue();
+    let qh = queue.handle();
+    let mut client = Client::default();
+    connection.display().get_registry(&qh, ());
+    queue.roundtrip(&mut client).unwrap();
+    let (dmabuf, _) = client.dmabuf.clone().unwrap();
+    let shell = client.shell.clone().unwrap();
+    let surface = client.compositor.as_ref().unwrap().create_surface(&qh, ());
+    let xdg = shell.get_xdg_surface(&surface, &qh, ());
+    let _top = xdg.get_toplevel(&qh, ());
+    surface.commit();
+    queue.roundtrip(&mut client).unwrap();
+    let buffer = |w: i32, hgt: i32, pixel: [u8; 4], tag: u32| {
+        use std::io::Write;
+        let mut file = fake_dmabuf(0);
+        file.write_all(&pixel.repeat((w * hgt) as usize)).unwrap();
+        let params = dmabuf.create_params(&qh, ());
+        params.add(file.as_fd(), 0, 0, (w * 4) as u32, 0, 0);
+        let b = params.create_immed(w, hgt, AR24, zwp_linux_buffer_params_v1::Flags::empty(), &qh, tag);
+        params.destroy();
+        (b, file)
+    };
+    let (window, _wf) = buffer(200, 120, [0, 0, 0, 255], 1);
+    surface.attach(Some(&window), 0, 0);
+    surface.commit();
+    queue.roundtrip(&mut client).unwrap();
+    h.wait("the window to map", || h.state.lock().unwrap().0 == 1);
+    // the menu: a popup under the window's top-left corner, drawn by the GPU
+    let positioner = shell.create_positioner(&qh, ());
+    positioner.set_size(80, 40);
+    positioner.set_anchor_rect(10, 10, 1, 1);
+    let menu = client.compositor.as_ref().unwrap().create_surface(&qh, ());
+    let menu_xdg = shell.get_xdg_surface(&menu, &qh, ());
+    let _popup = menu_xdg.get_popup(Some(&xdg), &positioner, &qh, ());
+    menu.commit();
+    queue.roundtrip(&mut client).unwrap();
+    let before = h.checks.lock().unwrap().1.cpu_pictures;
+    let (panel, _pf) = buffer(80, 40, [0x20, 0x40, 0xc0, 0xff], 2);
+    menu.attach(Some(&panel), 0, 0);
+    menu.commit();
+    queue.roundtrip(&mut client).unwrap();
+    h.wait("the popup's dma-buf to be read", || h.checks.lock().unwrap().1.cpu_pictures > before);
+    queue.roundtrip(&mut client).unwrap();
+    // read once and given back at once: the desk keeps its own copy, as for shared memory
+    assert!(client.released.contains(&2), "the popup's buffer is released after the copy: {:?}", client.released);
+    assert!(connection.protocol_error().is_none());
+}
