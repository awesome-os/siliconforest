+/// DESK10 (FX-022): a whole dma-buf picture through a CPU mapping, for the surfaces the desk shows from
+/// pictures (popups, layer surfaces): 32-bit XRGB or ARGB, linear (the formats and modifier the renderer
+/// takes), converted as a shared-memory buffer is (`pixels::shm_row_to_rgba`). The client's GPU writes
+/// are waited for (the dma-buf polls readable once its fences signalled), at most 50 ms.
+pub(crate) fn dmabuf_picture(dmabuf: &Dmabuf, width: u32, height: u32) -> Result<wm_theme_api::DecorationBuffer, String> {
+    let format = dmabuf.format();
+    let xrgb = match format.code {
+        Fourcc::Xrgb8888 => true,
+        Fourcc::Argb8888 => false,
+        other => return Err(format!("dma-buf format {other:?} is not read on the CPU (XRGB/ARGB8888 only)")),
+    };
+    if !matches!(format.modifier, Modifier::Linear | Modifier::Invalid) {
+        return Err(format!("dma-buf modifier {:#x} is not linear: not read on the CPU", u64::from(format.modifier)));
+    }
+    let (Some(fd), Some(offset), Some(stride)) = (dmabuf.handles().next(), dmabuf.offsets().next(), dmabuf.strides().next()) else {
+        return Err("dma-buf without a plane".into());
+    };
+    crate::pixels::image_len(width, height)?;
+    if (stride as u64) < u64::from(width) * 4 {
+        return Err("dma-buf stride smaller than its width".into());
+    }
+    let raw = std::os::fd::AsRawFd::as_raw_fd(&fd);
+    if !crate::kms::poll_readable(raw, Some(std::time::Duration::from_millis(50))).unwrap_or(true) {
+        eprintln!("WMDMABUF a popup/layer dma-buf's writes were not done after 50 ms: read as it is");
+    }
+    let length = offset as usize + stride as usize * height as usize;
+    let map = unsafe { libc::mmap(std::ptr::null_mut(), length, libc::PROT_READ, libc::MAP_SHARED, raw, 0) };
+    if map == libc::MAP_FAILED {
+        return Err(format!("dma-buf CPU mapping failed: {}", std::io::Error::last_os_error()));
+    }
+    let mut pixels = vec![0u8; width as usize * height as usize * 4];
+    let row_bytes = width as usize * 4;
+    for y in 0..height as usize {
+        let src = offset as usize + y * stride as usize;
+        let row = &mut pixels[y * row_bytes..(y + 1) * row_bytes];
+        // copied out of the mapping first, then interpreted (as from a client's shared memory)
+        unsafe { std::ptr::copy_nonoverlapping((map as *const u8).add(src), row.as_mut_ptr(), row_bytes) };
+        crate::pixels::shm_row_to_rgba(row, xrgb);
+    }
+    unsafe { libc::munmap(map, length) };
+    Ok(wm_theme_api::DecorationBuffer { width, height, pixels })
+}
