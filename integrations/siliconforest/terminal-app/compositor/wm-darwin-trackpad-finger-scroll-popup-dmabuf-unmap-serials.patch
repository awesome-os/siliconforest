+/// DESK10 (FX-022, the second click on Firefox's menu button killed its window: "wrong configure
+/// serial"): a client that unmaps a toplevel (null buffer) while it has the focus gets no protocol
+/// error for acking what it was sent - the desk moved the focus to another window and configured every
+/// window on the way, then reset the role and forgot the serial it had just sent - and the toplevel
+/// maps again after a commit without a buffer, which is answered with a configure.
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn a_toplevel_unmapped_by_its_client_acks_what_it_was_sent_and_maps_again() {
+    let (h, a) = Harness::with_input(true);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let (mut qb, mut cb, _sb, _xb, _tb) = map_client(&a, "stays");
+    let (mut q, mut c, s, _x, _t) = map_client(&a, "unmaps");
+    assert_eq!(h.snapshot().managed, 2);
+    // the focused window unmaps (as AppKit hides a window): its client acks every configure it gets
+    s.attach(None, 0, 0);
+    s.commit();
+    for _ in 0..4 {
+        h.snapshot();
+        q.roundtrip(&mut c).expect("no protocol error for acking a configure the desk sent");
+        qb.roundtrip(&mut cb).expect("the other window's client is fine");
+    }
+    assert!(a.protocol_error().is_none(), "{:?}", a.protocol_error());
+    // shown again: the initial commit is answered with a configure, then a buffer maps it
+    let before = c.configures;
+    s.commit();
+    for _ in 0..3 { h.snapshot(); q.roundtrip(&mut c).unwrap(); }
+    assert!(c.configures > before, "a configure answers the initial commit after the unmap");
+    let qh = q.handle();
+    let mut file = tempfile::tempfile().unwrap();
+    file.write_all(&[10, 20, 240, 255].repeat(100 * 60)).unwrap();
+    let pool = c.shm.as_ref().unwrap().create_pool(file.as_fd(), 100 * 60 * 4, &qh, ());
+    let buffer = pool.create_buffer(0, 100, 60, 400, wl_shm::Format::Argb8888, &qh, ());
+    s.attach(Some(&buffer), 0, 0);
+    s.commit();
+    for _ in 0..3 { h.snapshot(); q.roundtrip(&mut c).unwrap(); }
+    assert!(a.protocol_error().is_none(), "{:?}", a.protocol_error());
+    assert_eq!(h.snapshot().visible, 2, "both windows shown again");
+}
