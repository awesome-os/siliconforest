@@ -0,0 +1,476 @@
+//! DESK10: the built-in trackpad's two-finger scrolling as a Mac's, not as wheel steps.
+//!
+//! The owner (16 November): "I have to scroll a lot just to make the page move". The trackpad driver
+//! (`m1-trackpad-child/multitouch/m1tp_mt.c`, libinput's two-finger scroll with Omarchy's scroll factor
+//! 0.4) gives one wheel step for every 3.57 mm of two-finger travel, vertical only, with no lift-off
+//! record. Before DESK10 each step went to clients as one wheel notch (`AxisSource::Wheel`, 10 units,
+//! v120 120): AppKit made one line of it, Firefox moved 19 points for 3.57 mm of finger travel.
+//!
+//! On macOS a trackpad scrolls in points, as a gesture (began, changed, ended), and goes on by itself
+//! after the fingers lift (momentum, made by the system from the speed at the lift). At slow speed the
+//! content moves with the fingers in screen terms; faster swipes are accelerated. Here the desk turns
+//! the trackpad's steps into finger scrolling (`AxisSource::Finger`, no v120): every record's travel in
+//! logical pixels (the client's points), on this curve:
+//!
+//! - `SLOW_GAIN`: at slow speed one trackpad height of finger travel moves the content one screen height
+//!   (78.4 mm against the panel's 1600 pixels: 20.4 panel pixels a millimetre, 13.6 points at the
+//!   owner's 150 %), which is also what the pointer moves at slow speed (DESK7: 21 px/mm);
+//! - `accel`: flat (1.0) up to 50 mm/s, 1.6 at 150 mm/s, 2.6 at 300 mm/s, 3.5 from 600 mm/s on;
+//! - times the owner's scroll speed (policy `scroll_speed`, percent, 25..400, default 100);
+//! - natural direction (content follows the fingers, macOS's default; policy `natural_scroll`);
+//! - `axis_stop` when the fingers are taken as lifted: the driver has no lift record, so after a pause of
+//!   2.5 times the time the next step would have taken at the speed the fingers had (40..300 ms), or at
+//!   once when the trackpad's pointer moves, a button goes down, or another seat scrolls;
+//! - with the driver's coarse steps (1 mm or more) each step's travel is handed out over the next
+//!   16..48 ms (the time the step took), so a slow drag glides instead of jumping 49 points a step.
+//!
+//! The client makes the phases and the momentum (libWindowServer, TERM10: requests-for-TERM5.md
+//! "From DESK10"), as every Wayland client does its own kinetic scrolling after `axis_stop`.
+//! A mouse wheel (any other device of the pointer queue) stays a wheel.
+use std::time::{Duration, Instant};
+
+/// The trackpad's height in millimetres (m1tp_mt.h: Y -164..7439 at 97 units/mm).
+pub const TRACKPAD_HEIGHT_MM: f64 = 7603.0 / 97.0;
+/// Panel pixels per millimetre of finger travel at slow speed (one trackpad height = one screen height
+/// of the 1600-pixel panel); `logical_gain` turns it into the client's units for a screen and scale.
+pub const SLOW_GAIN: f64 = 1600.0 / TRACKPAD_HEIGHT_MM;
+/// The step size the old desk's Spaces stand-in (Control-Command + two-finger scroll) counts in.
+pub const OLD_STEP_MM: f64 = 3.566;
+
+/// What the driver does with two-finger travel, from the kernel's boot arguments (m1tp_mt.c
+/// `m1tp_mt_init`, SFM1SPIHIDMultitouch.inc): millimetres of travel per wheel step and whether it
+/// already inverted the direction (natural scrolling).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct KernelScroll {
+    pub mm_per_step: f64,
+    pub natural: bool,
+    /// `default` or the boot argument that set the step (`sfm1tpscroll`, `sfm1tpscrollfactor`).
+    pub source: &'static str,
+}
+
+impl KernelScroll {
+    /// The driver's own integer arithmetic: libinput's touchpad scroll (1000-dpi normalisation, baseline
+    /// 0.9, TP_MAGIC_SLOWDOWN 0.2968 = 26712/100000) times the scroll factor, 15 units a step; or
+    /// `sfm1tpscroll=N` contact units a step.
+    pub fn from_bootargs(args: &str) -> Self {
+        let arg = |name: &str| -> Option<i64> {
+            args.split_whitespace().find_map(|w| w.strip_prefix(name).and_then(|r| r.strip_prefix('='))).and_then(|v| v.parse::<i64>().ok())
+        };
+        let res_y = arg("sfm1tpresy").filter(|v| *v > 0 && *v < 1000).unwrap_or(97);
+        let step_px: i64 = 15;
+        let natural = arg("sfm1tpnatural").map_or(true, |v| v == 1);
+        if let Some(units) = arg("sfm1tpscroll").filter(|v| *v > 0).map(|v| v.min(100_000)) {
+            let per_unit = (step_px << 16) / units;
+            let units_per_step = (step_px << 16) as f64 / per_unit.max(1) as f64;
+            return Self { mm_per_step: units_per_step / res_y as f64, natural, source: "sfm1tpscroll" };
+        }
+        let factor = arg("sfm1tpscrollfactor").filter(|v| *v > 0).map_or(400, |v| v.min(100_000));
+        let per_unit = ((10_000i64 << 16) / (254 * res_y)) * 26_712 / 100_000 * factor / 1000;
+        let units_per_step = (step_px << 16) as f64 / per_unit.max(1) as f64;
+        Self { mm_per_step: units_per_step / res_y as f64, natural, source: if arg("sfm1tpscrollfactor").is_some() { "sfm1tpscrollfactor" } else { "default" } }
+    }
+    /// This kernel's (`sysctl kern.bootargs`), read once.
+    pub fn running() -> Self {
+        static RUNNING: std::sync::OnceLock<KernelScroll> = std::sync::OnceLock::new();
+        *RUNNING.get_or_init(|| Self::from_bootargs(&bootargs().unwrap_or_default()))
+    }
+    /// Steps of 1 mm or more are handed out over time (see the module's notes).
+    pub fn coarse(&self) -> bool {
+        self.mm_per_step >= 1.0
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn bootargs() -> Option<String> {
+    let name = std::ffi::CString::new("kern.bootargs").ok()?;
+    let mut len: libc::size_t = 0;
+    if unsafe { libc::sysctlbyname(name.as_ptr(), std::ptr::null_mut(), &mut len, std::ptr::null_mut(), 0) } != 0 || len == 0 {
+        return None;
+    }
+    let mut buf = vec![0u8; len];
+    if unsafe { libc::sysctlbyname(name.as_ptr(), buf.as_mut_ptr().cast(), &mut len, std::ptr::null_mut(), 0) } != 0 {
+        return None;
+    }
+    buf.truncate(len);
+    Some(String::from_utf8_lossy(&buf).trim_end_matches('\0').to_string())
+}
+#[cfg(not(target_os = "macos"))]
+fn bootargs() -> Option<String> {
+    None
+}
+
+/// The acceleration of scrolling with the fingers' speed (mm/s): flat while slow, so a slow drag
+/// tracks the fingers; piecewise linear through (50, 1.0), (150, 1.6), (300, 2.6), (600, 3.5).
+pub fn accel(mm_per_s: f64) -> f64 {
+    const POINTS: [(f64, f64); 4] = [(50.0, 1.0), (150.0, 1.6), (300.0, 2.6), (600.0, 3.5)];
+    let v = if mm_per_s.is_finite() { mm_per_s.max(0.0) } else { 0.0 };
+    if v <= POINTS[0].0 {
+        return POINTS[0].1;
+    }
+    for pair in POINTS.windows(2) {
+        let ((v0, f0), (v1, f1)) = (pair[0], pair[1]);
+        if v <= v1 {
+            return f0 + (f1 - f0) * (v - v0) / (v1 - v0);
+        }
+    }
+    POINTS[3].1
+}
+
+/// Logical pixels (the client's points) per millimetre at slow speed, for a screen `height` panel
+/// pixels tall shown at `scale` (1.5 at 150 %).
+pub fn logical_gain(screen_height_px: f64, scale: f64) -> f64 {
+    let panel = if screen_height_px > 0.0 { screen_height_px / TRACKPAD_HEIGHT_MM } else { SLOW_GAIN };
+    panel / if scale > 0.0 { scale } else { 1.0 }
+}
+
+/// The owner's settings, from the policy file.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Settings {
+    pub speed_percent: u16,
+    pub natural: bool,
+    pub trace: bool,
+}
+impl Default for Settings {
+    fn default() -> Self {
+        Self { speed_percent: 100, natural: true, trace: false }
+    }
+}
+
+/// One thing to send: finger travel on the vertical axis in logical units (wl_pointer.axis: positive
+/// scrolls down, i.e. moves the content up), and whether the fingers lifted with it (`axis_stop`).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Out {
+    pub dy: f64,
+    pub stop: bool,
+    /// The test instrument's pointer (`seat virtual`) rather than the owner's.
+    pub virt: bool,
+}
+
+/// Why a gesture ended (the `WMSCROLL` line).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum End {
+    Pause,
+    Pointer,
+    Button,
+    OtherSeat,
+    Off,
+}
+impl End {
+    fn name(self) -> &'static str {
+        match self {
+            End::Pause => "pause",
+            End::Pointer => "pointer-moved",
+            End::Button => "button",
+            End::OtherSeat => "other-seat",
+            End::Off => "policy-off",
+        }
+    }
+}
+
+struct Gesture {
+    virt: bool,
+    device: Option<u8>,
+    start: Instant,
+    last: Instant,
+    /// smoothed finger speed, mm/s
+    speed: f64,
+    /// travel not handed out yet (logical units, signed) and how fast it goes out (units per ms)
+    pending: f64,
+    rate: f64,
+    emitted_at: Instant,
+    deadline: Instant,
+    records: u32,
+    steps: i64,
+    mm: f64,
+    sent: f64,
+    frames: u32,
+    peak: f64,
+    factor_sum: f64,
+}
+
+/// The trackpad's scrolling, record by record (`record`), and in time (`tick`: handing out a coarse
+/// step's travel, the lift after a pause).
+pub struct TouchScroll {
+    pub kernel: KernelScroll,
+    gesture: Option<Gesture>,
+    /// gestures ended, for `stats`
+    pub gestures: u64,
+    /// Lines for the log (`WMSCROLL`, and `WMSCROLLRAW` per record with `scroll_trace`), taken by the server.
+    pub log: Vec<String>,
+}
+
+impl TouchScroll {
+    pub fn new(kernel: KernelScroll) -> Self {
+        Self { kernel, gesture: None, gestures: 0, log: Vec::new() }
+    }
+    pub fn active(&self) -> Option<bool> {
+        self.gesture.as_ref().map(|g| g.virt)
+    }
+
+    /// A wheel record of the trackpad: `steps` as the driver counts them (positive: the HID wheel's up),
+    /// read at `at`; `gain` logical units per millimetre at slow speed.
+    pub fn record(&mut self, steps: i8, at: Instant, virt: bool, device: Option<u8>, gain: f64, s: &Settings) -> Vec<Out> {
+        let mut out = Vec::new();
+        if steps == 0 {
+            return out;
+        }
+        if self.gesture.as_ref().is_some_and(|g| g.virt != virt) {
+            out.extend(self.end(End::OtherSeat, at));
+        }
+        // what is due from the step before goes out first
+        out.extend(self.hand_out(at));
+        let mm_step = self.kernel.mm_per_step;
+        let mm = f64::from(steps) * mm_step;
+        let (dt, first) = match &self.gesture {
+            Some(g) => (at.saturating_duration_since(g.last), false),
+            None => (Duration::ZERO, true),
+        };
+        // the speed this record shows: its travel over the time since the record before (at least 4 ms:
+        // records come every 8 ms and are read within 1); a gesture's first record counts as slow unless
+        // it brings several steps at once (its travel over one report, 8.3 ms)
+        let secs = dt.as_secs_f64().clamp(0.004, 0.2);
+        let instant = if !first { mm.abs() / secs } else if steps.unsigned_abs() > 1 { mm.abs() / 0.0083 } else { 25.0 };
+        let g = self.gesture.get_or_insert_with(|| Gesture {
+            virt, device, start: at, last: at, speed: instant, pending: 0.0, rate: 0.0, emitted_at: at, deadline: at,
+            records: 0, steps: 0, mm: 0.0, sent: 0.0, frames: 0, peak: 0.0, factor_sum: 0.0,
+        });
+        g.speed = if first { instant } else { 0.5 * g.speed + 0.5 * instant };
+        g.peak = g.peak.max(g.speed);
+        let factor = accel(g.speed);
+        // the kernel already inverted the direction when its natural scrolling is on
+        let direction = if s.natural == self.kernel.natural { 1.0 } else { -1.0 };
+        let speed = f64::from(s.speed_percent.clamp(25, 400)) / 100.0;
+        // a wheel step up (positive) scrolls up: wl_pointer's value is negative
+        let units = -mm * gain * factor * speed * direction;
+        g.records += 1;
+        g.steps += i64::from(steps);
+        g.mm += mm.abs();
+        g.factor_sum += factor;
+        g.last = at;
+        // the fingers are taken as lifted after 2.5 times the time the next step would take at this
+        // speed, plus a refresh (40..300 ms); with fine steps at least a record interval (8 ms)
+        let next = (mm_step / g.speed.max(1.0)).max(if self.kernel.coarse() { 0.0 } else { 0.0083 });
+        g.deadline = at + Duration::from_secs_f64((2.5 * next + 0.016).clamp(0.040, 0.300));
+        if s.trace {
+            self.log.push(format!(
+                "WMSCROLLRAW seat={} device={} t_ms={:.1} dt_ms={:.1} steps={steps} mm={:.2} speed_mm_s={:.0} factor={:.2} value={:.1}",
+                if virt { "virtual" } else { "owner" }, device.map_or("-".into(), |d| d.to_string()),
+                at.saturating_duration_since(g.start).as_secs_f64() * 1000.0, dt.as_secs_f64() * 1000.0, mm, g.speed, factor, units
+            ));
+        }
+        if self.kernel.coarse() {
+            // a coarse step glides over the time it took (16..48 ms; a first step over 32)
+            let spread = if first { 0.032 } else { dt.as_secs_f64().clamp(0.016, 0.048) };
+            g.pending += units;
+            g.rate = g.pending.abs() / (spread * 1000.0);
+            g.emitted_at = at;
+            // the first part at once: the content starts moving with the record
+            out.extend(self.hand_out_part(at, 0.25));
+        } else {
+            g.sent += units;
+            g.frames += 1;
+            out.push(Out { dy: units, stop: false, virt });
+        }
+        out
+    }
+
+    /// Hands out a quarter (`share`) of what a coarse step left, now.
+    fn hand_out_part(&mut self, now: Instant, share: f64) -> Vec<Out> {
+        let Some(g) = self.gesture.as_mut() else { return Vec::new() };
+        let part = g.pending * share;
+        if part == 0.0 {
+            return Vec::new();
+        }
+        g.pending -= part;
+        g.sent += part;
+        g.frames += 1;
+        g.emitted_at = now;
+        vec![Out { dy: part, stop: false, virt: g.virt }]
+    }
+
+    /// What a coarse step left that is due by `now`.
+    fn hand_out(&mut self, now: Instant) -> Vec<Out> {
+        let Some(g) = self.gesture.as_mut() else { return Vec::new() };
+        if g.pending == 0.0 {
+            return Vec::new();
+        }
+        let ms = now.saturating_duration_since(g.emitted_at).as_secs_f64() * 1000.0;
+        // at most one hand-out every 7 ms (two a refresh): the client draws once a refresh anyway
+        if ms < 7.0 && g.pending.abs() > 1e-6 && now < g.deadline {
+            return Vec::new();
+        }
+        let amount = (g.rate * ms).min(g.pending.abs());
+        if amount <= 0.0 {
+            return Vec::new();
+        }
+        let part = amount.copysign(g.pending);
+        g.pending -= part;
+        if g.pending.abs() < 1e-6 {
+            g.pending = 0.0;
+        }
+        g.sent += part;
+        g.frames += 1;
+        g.emitted_at = now;
+        vec![Out { dy: part, stop: false, virt: g.virt }]
+    }
+
+    /// Every turn of the desktop's loop: the travel that is due, and the lift once the pause is over.
+    pub fn tick(&mut self, now: Instant) -> Vec<Out> {
+        let mut out = self.hand_out(now);
+        if self.gesture.as_ref().is_some_and(|g| now >= g.deadline) {
+            out.extend(self.end(End::Pause, now));
+        }
+        out
+    }
+
+    /// The gesture ends (at `now`): what it had not handed out goes with the lift.
+    pub fn end(&mut self, why: End, now: Instant) -> Vec<Out> {
+        let Some(g) = self.gesture.take() else { return Vec::new() };
+        self.gestures += 1;
+        let ms = g.last.saturating_duration_since(g.start).as_secs_f64() * 1000.0;
+        let sent = g.sent + g.pending;
+        self.log.push(format!(
+            "WMSCROLL gesture seat={} device={} records={} steps={} travel_mm={:.1} ms={:.0} speed_mm_s(mean,peak)=({:.0},{:.0}) factor_mean={:.2} units={:.0} units_per_mm={:.1} frames={} end={} lift_after_ms={:.0} step_mm={:.3}({})",
+            if g.virt { "virtual" } else { "owner" }, g.device.map_or("-".into(), |d| d.to_string()), g.records, g.steps, g.mm, ms,
+            if ms > 0.0 { g.mm / (ms / 1000.0) } else { 0.0 }, g.peak, g.factor_sum / f64::from(g.records.max(1)), sent.abs(),
+            if g.mm > 0.0 { sent.abs() / g.mm } else { 0.0 }, g.frames + 1, why.name(),
+            now.saturating_duration_since(g.last).as_secs_f64() * 1000.0, self.kernel.mm_per_step, self.kernel.source
+        ));
+        vec![Out { dy: g.pending, stop: true, virt: g.virt }]
+    }
+}
