+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_drivers_step_from_its_boot_arguments() {
+        // the driver's default: 3.57 mm a step (the owner's "scroll a lot": 14 steps for 5 cm)
+        let d = KernelScroll::from_bootargs("-v debug=0x14e sfm1trackpadchild=1");
+        assert!((d.mm_per_step - 3.566).abs() < 0.01, "{d:?}");
+        assert!(d.natural && d.coarse() && d.source == "default");
+        let fine = KernelScroll::from_bootargs("sfm1tpscroll=20 sfm1tpnatural=2");
+        assert!((fine.mm_per_step - 20.0 / 97.0).abs() < 0.002, "{fine:?}");
+        assert!(!fine.natural && !fine.coarse());
+        let factor = KernelScroll::from_bootargs("sfm1tpscrollfactor=1000");
+        assert!((factor.mm_per_step - 3.566 * 0.4).abs() < 0.01, "{factor:?}");
+    }
+
+    #[test]
+    fn slow_drags_track_the_fingers_and_fast_ones_are_accelerated() {
+        assert_eq!(accel(10.0), 1.0);
+        assert_eq!(accel(50.0), 1.0);
+        assert!((accel(150.0) - 1.6).abs() < 1e-9);
+        assert!((accel(300.0) - 2.6).abs() < 1e-9);
+        assert_eq!(accel(5000.0), 3.5);
+        assert_eq!(accel(f64::NAN), 1.0);
+        // 150 %: 13.6 points a millimetre at slow speed
+        assert!((logical_gain(1600.0, 1.5) - 13.61).abs() < 0.02);
+    }
+
+    /// A swipe of `mm` millimetres at a constant speed, as the driver gives it: steps of its size, one
+    /// record every 8 ms (as many steps as the travel so far completes), the loop's turns every 8 ms.
+    fn swipe(kernel: KernelScroll, mm: f64, speed_mm_s: f64, s: Settings) -> (f64, Vec<Out>, TouchScroll) {
+        let mut t = TouchScroll::new(kernel);
+        let gain = logical_gain(1600.0, 1.5);
+        let start = Instant::now();
+        let mut outs = Vec::new();
+        let mut done_steps = 0i64;
+        let ms = (mm / speed_mm_s * 1000.0).ceil() as u64;
+        for k in 0..=(ms / 8 + 1) {
+            let at = start + Duration::from_millis(k * 8);
+            let travelled = (speed_mm_s * (k * 8) as f64 / 1000.0).min(mm);
+            let total = (travelled / kernel.mm_per_step).floor() as i64;
+            let n = (total - done_steps).clamp(0, 127);
+            done_steps += n;
+            // fingers moving towards the user with natural scrolling: the driver's wheel goes up
+            if n > 0 {
+                outs.extend(t.record(n as i8, at, false, Some(0), gain, &s));
+            }
+            outs.extend(t.tick(at));
+        }
+        // the loop goes on turning every 8 ms after the fingers stopped
+        for k in 1..=50 {
+            outs.extend(t.tick(start + Duration::from_millis((ms / 8 + 1) * 8 + k * 8)));
+        }
+        (outs.iter().map(|o| o.dy).sum(), outs, t)
+    }
+
+    #[test]
+    fn a_five_centimetre_swipe_scrolls_as_a_macs_does_and_ends_with_a_lift() {
+        let k = KernelScroll::from_bootargs("");
+        let s = Settings::default();
+        // slow (30 mm/s): one trackpad height per screen height: 5 cm = 680 points at 150 % (+- one step)
+        let (slow, outs, t) = swipe(k, 50.0, 30.0, s);
+        assert!((slow.abs() - 680.0).abs() < 50.0, "slow {slow}");
+        assert!(slow < 0.0, "natural: fingers towards the user move the content down (scroll up)");
+        assert_eq!(outs.iter().filter(|o| o.stop).count(), 1);
+        assert!(outs.last().unwrap().stop);
+        assert!(t.log.iter().any(|l| l.starts_with("WMSCROLL gesture") && l.contains("end=pause")));
+        // medium (150 mm/s) and fast (400 mm/s): accelerated
+        let (medium, _, _) = swipe(k, 50.0, 150.0, s);
+        let (fast, _, _) = swipe(k, 50.0, 400.0, s);
+        assert!(medium.abs() > 1.4 * 680.0 && medium.abs() < 1.7 * 680.0, "medium {medium}");
+        assert!(fast.abs() > 2.6 * 680.0 && fast.abs() < 3.1 * 680.0, "fast {fast}");
+        // the owner's speed and direction settings
+        let (slower, _, _) = swipe(k, 50.0, 30.0, Settings { speed_percent: 50, ..s });
+        assert!((slower - slow / 2.0).abs() < 1.0);
+        let (unnatural, _, _) = swipe(k, 50.0, 30.0, Settings { natural: false, ..s });
+        assert!((unnatural + slow).abs() < 1e-6);
+        // with fine steps (sfm1tpscroll=20) the same swipe gives the same travel, record by record
+        let fine = KernelScroll::from_bootargs("sfm1tpscroll=20");
+        let (f, fouts, _) = swipe(fine, 50.0, 30.0, s);
+        assert!((f.abs() - 680.0).abs() < 15.0, "fine {f}");
+        assert!(fouts.len() > 100);
+    }
+
+    /// The numbers for the hand-over (`cargo test ... scroll::tests::the_curve_in_numbers -- --nocapture`).
+    #[test]
+    fn the_curve_in_numbers() {
+        for (name, k) in [("driver default 3.57 mm/step", KernelScroll::from_bootargs("")), ("sfm1tpscroll=20, 0.21 mm/step", KernelScroll::from_bootargs("sfm1tpscroll=20"))] {
+            for v in [20.0, 50.0, 100.0, 150.0, 200.0, 300.0, 400.0, 600.0] {
+                let (total, outs, t) = swipe(k, 50.0, v, Settings::default());
+                let frames = outs.iter().filter(|o| !o.stop).count();
+                let lift = t.log.iter().find(|l| l.starts_with("WMSCROLL gesture")).and_then(|l| l.split("lift_after_ms=").nth(1)).and_then(|r| r.split(' ').next()).unwrap_or("?").to_string();
+                eprintln!("SCROLLNUM {name}: 5 cm at {v:>3} mm/s -> {:>5.0} points at 150 % ({:.2} screen heights of 1067), {frames} frames, lift seen {lift} ms after the last record", total.abs(), total.abs() / 1066.7);
+            }
+        }
+    }
+
+    #[test]
+    fn a_coarse_step_glides_and_a_slow_drag_is_not_ended_between_its_steps() {
+        let k = KernelScroll::from_bootargs("");
+        let mut t = TouchScroll::new(k);
+        let s = Settings::default();
+        let t0 = Instant::now();
+        let first = t.record(1, t0, false, Some(0), 13.6, &s);
+        // a quarter at once, the rest over 32 ms
+        assert_eq!(first.len(), 1);
+        let step = 3.566 * 13.6;
+        assert!((first[0].dy + step / 4.0).abs() < 0.01);
+        let mid = t.tick(t0 + Duration::from_millis(16));
+        assert!(mid.iter().map(|o| o.dy).sum::<f64>() < 0.0);
+        // at 20 mm/s the next step comes 178 ms later: the gesture is still on
+        assert!(t.tick(t0 + Duration::from_millis(170)).iter().all(|o| !o.stop));
+        let second = t.record(1, t0 + Duration::from_millis(178), false, Some(0), 13.6, &s);
+        assert!(!second.is_empty());
+        // the pause after it ends the gesture, with all of its travel handed out
+        let rest = t.tick(t0 + Duration::from_millis(178 + 320));
+        assert!(rest.last().unwrap().stop);
+        assert!(t.active().is_none());
+    }
+
+    #[test]
+    fn the_other_seat_ends_the_gesture_first() {
+        let mut t = TouchScroll::new(KernelScroll::from_bootargs("sfm1tpscroll=20"));
+        let s = Settings::default();
+        let t0 = Instant::now();
+        t.record(3, t0, true, None, 13.6, &s);
+        let outs = t.record(2, t0 + Duration::from_millis(8), false, Some(0), 13.6, &s);
+        assert!(outs[0].stop && outs[0].virt);
+        assert!(!outs[1].stop && !outs[1].virt);
+        assert_eq!(t.active(), Some(false));
+        assert!(t.end(End::Pointer, t0 + Duration::from_millis(9))[0].stop);
+    }
+}
