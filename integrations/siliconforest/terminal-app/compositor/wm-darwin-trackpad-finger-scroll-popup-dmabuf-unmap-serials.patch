+/// DESK10 (the owner: "I have to scroll a lot just to make the page move"): the built-in trackpad's
+/// two-finger scrolling reaches the window under the pointer as finger scrolling - axis source finger,
+/// travel in logical units, no wheel notch and no value120 - and ends with one axis_stop after a
+/// pause (the driver has no lift record); a mouse wheel stays a wheel (source wheel, value120 per
+/// notch); `trackpad_scroll=off` gives the notches of before.
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn the_trackpads_scrolling_reaches_the_client_as_finger_scrolling_and_a_wheel_stays_a_wheel() {
+    let (h, a) = Harness::with_input(true);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let (mut q, mut c, _s, _x, _t) = map_client(&a, "scrolled");
+    let content = h.snapshot().content.unwrap();
+    use wm_darwin::hid::{Event, Motion};
+    let at = |v: i32, of: f64| ((f64::from(v) + 0.25) / of * 65535.).round().clamp(0., 65535.) as u16;
+    h.tx.send(Request::Hid(Event::Pointer { motion: Motion::Absolute(at(content.pos.x + 30, 319.), at(content.pos.y + 30, 239.)), buttons: 0, wheel: 0 })).unwrap();
+    h.snapshot();
+    q.roundtrip(&mut c).unwrap();
+    c.axis_log.clear();
+    // three of the driver's steps down (wheel -1 each: fingers up the trackpad, reading on), 20 ms apart
+    for _ in 0..3 {
+        h.tx.send(Request::Hid(Event::TouchWheel { steps: -1, buttons: 0 })).unwrap();
+        thread::sleep(Duration::from_millis(20));
+    }
+    // the pause that ends the gesture (at most 300 ms)
+    thread::sleep(Duration::from_millis(450));
+    h.snapshot();
+    for _ in 0..3 { q.roundtrip(&mut c).unwrap(); }
+    let log = c.axis_log.clone();
+    assert!(log.iter().all(|l| l == "source Finger" || l.starts_with("axis ") || l == "stop" || l == "frame"), "finger frames only: {log:?}");
+    assert!(!log.iter().any(|l| l.starts_with("v120")), "no value120 for a trackpad: {log:?}");
+    assert_eq!(log.iter().filter(|l| *l == "stop").count(), 1, "one lift: {log:?}");
+    let travel: f64 = log.iter().filter_map(|l| l.strip_prefix("axis ")).map(|v| v.parse::<f64>().unwrap()).sum();
+    // 3 steps of 3.566 mm at this 240-pixel screen's gain (240 / 78.4 mm, scale 1), accelerated by their speed
+    let slow = 3.0 * 3.566 * 240.0 / (7603.0 / 97.0);
+    assert!(travel > slow * 0.99 && travel < slow * 3.6, "travel {travel:.1} for the slow gain's {slow:.1}: {log:?}");
+    // a mouse wheel notch (any other device) stays a wheel notch
+    c.axis_log.clear();
+    h.tx.send(Request::Hid(Event::Pointer { motion: Motion::Relative(0, 0), buttons: 0, wheel: -1 })).unwrap();
+    h.snapshot();
+    q.roundtrip(&mut c).unwrap();
+    assert_eq!(c.axis_log, ["source Wheel", "v120 120", "axis 10.000", "frame"], "{:?}", c.axis_log);
+}
