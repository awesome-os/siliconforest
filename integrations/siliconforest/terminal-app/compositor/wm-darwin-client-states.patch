+            if *other != id && w.surface.is_initial_configure_sent() {
+                w.surface.send_pending_configure();
+            }
+        }
+        let states = self.wm.backend().windows[&id].surface.with_pending_state(|p| (p.states.contains(xdg_state::Fullscreen), p.states.contains(xdg_state::Maximized), p.size));
