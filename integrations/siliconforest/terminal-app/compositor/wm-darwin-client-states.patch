+    fn client_state_request(&mut self, s: &ToplevelSurface, action: wm_core::NetStateAction, first: wm_core::NetState, second: Option<wm_core::NetState>) {
+        let Some(id) = self.wm.backend().window_for_surface(s.wl_surface()) else {
+            return;
+        };
