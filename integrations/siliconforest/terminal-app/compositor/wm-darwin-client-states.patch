+//! Multi-finger swipes on the desktop (see `crate::hid::Event::Swipe`).
+use crate::hid::SwipePhase;
+use crate::server::Server;
+
+impl Server {
+    pub(crate) fn swipe(&mut self, phase: SwipePhase, fingers: u8, dx: i16, dy: i16, _time: u32) {
+        eprintln!("WMGESTURE swipe phase={phase:?} fingers={fingers} dx={dx} dy={dy} handled=no");
+    }
+}
