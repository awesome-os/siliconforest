+/// DESK6, the owner: "Minimizing windows closes or kills them ... then it closes altogether".
+/// An AppKit window ordered out as it miniaturises takes its picture away (a null buffer) while
+/// the desk has it put away: the desk must keep it minimised - its tile stays, the window is not
+/// forgotten - and when the client shows it again it comes back at its place. (Fails on the old
+/// source: the unmap made the desk forget the window and its tile.)
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn a_minimised_window_whose_client_unmaps_it_stays_minimised_and_comes_back_at_its_place() {
+    let (h, a) = Harness::sized(true, 640, 480, 15);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let settle = || { for _ in 0..10 { h.snapshot(); thread::sleep(Duration::from_millis(10)); } };
+    settle();
+    let (mut q, mut c, s, _x, t) = map_client(&a, "ordered out while minimised");
+    settle();
+    let mapped = h.snapshot();
+    let (before, place) = (mapped.shells, mapped.content.expect("the window is shown"));
+    assert_eq!((mapped.managed, mapped.visible), (1, 1));
+    t.set_minimized();
+    q.roundtrip(&mut c).unwrap();
+    settle();
+    let minimised = h.snapshot();
+    assert!(minimised.shells > before, "a tile for the minimised window");
+    assert_eq!(minimised.visible, 0);
+    // the client takes its picture away (AppKit orders the miniaturised window out)
+    s.attach(None, 0, 0);
+    s.commit();
+    q.roundtrip(&mut c).unwrap();
+    settle();
+    let unmapped = h.snapshot();
+    assert_eq!(unmapped.managed, 1, "the desk still has the window");
+    assert_eq!(unmapped.shells, minimised.shells, "its tile stays");
+    // the client shows it again (AppKit's deminiaturize): an initial commit, the configure, a buffer
+    s.commit();
+    q.roundtrip(&mut c).unwrap();
+    let qh = q.handle();
+    let mut file = tempfile::tempfile().unwrap();
+    file.write_all(&[10, 20, 240, 255].repeat(100 * 60)).unwrap();
+    let pool = c.shm.as_ref().unwrap().create_pool(file.as_fd(), 100 * 60 * 4, &qh, ());
+    let buffer = pool.create_buffer(0, 100, 60, 400, wl_shm::Format::Argb8888, &qh, ());
+    s.attach(Some(&buffer), 0, 0);
+    s.commit();
+    for _ in 0..3 { q.roundtrip(&mut c).unwrap(); }
+    settle();
+    let back = h.snapshot();
+    assert_eq!((back.managed, back.visible), (1, 1), "shown again: {back:?}");
+    assert_eq!(back.shells, before, "its tile went");
+    assert_eq!(back.content.map(|r| r.pos), Some(place.pos), "at its place");
+}
