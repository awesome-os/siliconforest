+        let path = temp_state_file("stale-kept");
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(&path, "app.a\norg.mozilla.firefox\napp.b\n").unwrap();
+        let primary = Rect { pos: Point::new(0, 0), size: Size::new(640, 480) };
+        let mut dock: LaunchDock<crate::surface::FakeBackend> = LaunchDock::new(&mut backend, &theme, primary, 56, &[], wm_theme::FontState::new());
+        dock.state_path = Some(path.clone());
+        dock.reload(&mut backend, &theme, &apps);
+        assert_eq!(ids(&dock.pins), ["app.a", "app.b"]);
+        dock.handle_click(&mut backend, &theme, Point::new(28, 20), true, &[]);
+        dock.handle_motion(&mut backend, &theme, Point::new(28, 80));
+        dock.handle_release(&mut backend, &theme, Point::new(28, 80), &[]);
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "app.b\napp.a\norg.mozilla.firefox\n");
+        // installed later: the reload (the dock scans again when the items change) shows it
+        dock.reload(&mut backend, &theme, &[entry("app.a"), entry("app.b"), entry("org.mozilla.firefox")]);
+        assert_eq!(ids(&dock.pins), ["app.b", "app.a", "org.mozilla.firefox"]);
+        cleanup(&path);
