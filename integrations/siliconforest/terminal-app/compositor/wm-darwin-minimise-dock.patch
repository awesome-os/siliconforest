+/// A tile's Quit: on SiliconForest the desktop quits the application as its own menu's Quit does
+/// (a Mac application with its questions; the desk's terminal: every window of it closed), the
+/// way the Command-Tab switcher's Q does; elsewhere every matching window is asked to close.
+fn quit_application(display: &Client, app: &apps::AppEntry, running: &[(String, u32)]) {
+    let classes: Vec<&str> = running
+        .iter()
+        .filter(|(class, _)| apps::match_window_class(std::slice::from_ref(app), class).is_some())
+        .map(|(class, _)| class.as_str())
+        .collect();
+    if cfg!(target_os = "macos") {
+        let mut asked = Vec::new();
+        for class in classes {
+            if asked.contains(&class) {
+                continue;
+            }
+            asked.push(class);
+            eprintln!("chonk-dock: Quit {} (app id {class})", app.id);
+            crate::spawn::spawn_detached_with_env("/usr/bin/chonkstep-darwin-desktop", &["--desktop-request", "quit", class], &[], &[]);
+        }
+    } else {
+        for (class, window) in running {
+            if apps::match_window_class(std::slice::from_ref(app), class).is_some() {
+                display.close(*window);
+            }
+        }
+    }
+}
