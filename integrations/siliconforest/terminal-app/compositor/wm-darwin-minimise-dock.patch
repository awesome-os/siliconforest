+/// A dma-buf's picture, small (DESK6, a minimised window's tile): read through a CPU mapping
+/// (XRGB/ARGB8888, linear: what the renderer imports), one sample per output pixel, at most
+/// `edge` pixels on its longer side, opaque. `None` when the buffer cannot be mapped.
+pub(crate) fn dmabuf_preview(dmabuf: &Dmabuf, width: u32, height: u32, edge: u32) -> Option<wm_theme_api::DecorationBuffer> {
+    let (fd, offset, stride) = (dmabuf.handles().next()?, dmabuf.offsets().next()?, dmabuf.strides().next()?);
+    if width == 0 || height == 0 || (stride as u64) < u64::from(width) * 4 {
+        return None;
+    }
+    let length = offset as usize + stride as usize * height as usize;
+    let map = unsafe { libc::mmap(std::ptr::null_mut(), length, libc::PROT_READ, libc::MAP_SHARED, std::os::fd::AsRawFd::as_raw_fd(&fd), 0) };
+    if map == libc::MAP_FAILED {
+        return None;
+    }
+    let source = unsafe { std::slice::from_raw_parts(map as *const u8, length) };
+    let fit = (f64::from(edge) / f64::from(width.max(height))).min(1.0);
+    let (w, h) = (((f64::from(width) * fit).round() as u32).max(1), ((f64::from(height) * fit).round() as u32).max(1));
+    let mut pixels = Vec::with_capacity(w as usize * h as usize * 4);
+    for y in 0..h {
+        let sy = (u64::from(y) * u64::from(height) / u64::from(h)) as usize;
+        let row = offset as usize + sy * stride as usize;
+        for x in 0..w {
+            let sx = (u64::from(x) * u64::from(width) / u64::from(w)) as usize;
+            let p = &source[row + sx * 4..row + sx * 4 + 4];
+            // little-endian B, G, R, x -> R, G, B, opaque
+            pixels.extend_from_slice(&[p[2], p[1], p[0], 255]);
+        }
+    }
+    unsafe { libc::munmap(map, length) };
+    Some(wm_theme_api::DecorationBuffer { width: w, height: h, pixels })
+}
