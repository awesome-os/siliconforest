+    /// (missing file, or one with no id) starts with the default set and writes it; a file with
+    /// pins is left alone.
+    #[test]
+    fn a_missing_or_empty_pins_file_gets_the_default_set() {
+        let defaults: Vec<String> = SILICONFOREST_DEFAULT_PINS.iter().map(|s| s.to_string()).collect();
+        let path = temp_state_file("defaults");
+        assert!(write_defaults_if_empty(&path, &defaults), "missing: written");
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "org.siliconforest.terminal\ncom.apple.Terminal\ncom.apple.ActivityMonitor\norg.mozilla.firefox\n");
+        std::fs::write(&path, "\n  \n").unwrap();
+        assert!(write_defaults_if_empty(&path, &defaults), "blank: written");
+        std::fs::write(&path, "com.apple.Terminal\n").unwrap();
+        assert!(!write_defaults_if_empty(&path, &defaults), "pins of the owner's own: left alone");
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "com.apple.Terminal\n");
+        assert!(!write_defaults_if_empty(&path, &[]), "no defaults (Linux): nothing");
+        cleanup(&path);
+    }
