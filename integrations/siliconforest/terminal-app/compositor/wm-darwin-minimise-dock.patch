+/// private test copy) was not recognised by its app id alone, so the desk took the chord.
+pub(crate) fn is_mac_client(app_id: &str, pid: Option<i32>) -> bool {
+    if !app_id.is_empty() && wm_theme::app_icon::bundle_for_identifier(app_id).is_some() {
