--- /dev/null
+++ b/crates/wm-darwin/src/encoder.rs
@@ -0,0 +1,389 @@
+//! DESK11: the screen recorder's video encoders. The compositor converts each recorded frame to NV12 on the
+//! GPU, into one of a small ring of shareable buffers (linear dma-bufs, CPU-mapped cached: `glrender.rs`
+//! `record_capture`); a writer thread (`record.rs`) hands each frame with its time to an `Encoder`:
+//!
+//! - **software** (`Software`): `/usr/local/bin/ffmpeg` with libx264, a separate program (GPL; never linked
+//!   into this one). The frames go to its standard input as a Matroska stream of raw NV12 frames, each with its
+//!   time in microseconds (a variable frame rate: a frame only when the screen changed), and ffmpeg writes a
+//!   QuickTime movie of H.264 (`+faststart`). ffmpeg is also the muxer.
+//! - **hardware** (`hardware`): the Apple Video Encoder through our VideoToolbox (`VTCompressionSession`),
+//!   when the AVE driver (SF-AD, paused) works. A seam only: `hardware::probe` says it is not available. What
+//!   it gets is the same `NvFrame`: the dma-buf of the frame (NV12, linear, Y at 0 and U/V at
+//!   `width * height`, pitch `width`) and its time, so it can take the buffer without a copy; it would give
+//!   back an H.264/HEVC elementary stream, muxed by ffmpeg (`-c copy`) or by our own movie writer.
+use std::io::Write;
+use std::os::fd::{FromRawFd, OwnedFd};
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+pub const FFMPEG: &str = "/usr/local/bin/ffmpeg";
+
+/// One frame for an encoder: NV12, the Y plane (`width` x `height`, pitch `width`) then the interleaved U/V
+/// plane (`height / 2` rows of `width` bytes) in `data`; `dmabuf` the same memory as a dma-buf (or -1).
+pub struct NvFrame<'a> {
+    pub data: &'a [u8],
+    pub width: u32,
+    pub height: u32,
+    pub dmabuf: i32,
+    /// microseconds since the recording started
+    pub at_us: u64,
+}
+
+pub struct EncoderSummary {
+    pub frames: u64,
+    /// CPU seconds the encoder used (its own process, for the software one)
+    pub cpu_s: f64,
+    /// time spent handing frames over (writing them to ffmpeg), total
+    pub push_s: f64,
+    pub push_max_ms: f64,
+    pub detail: String,
+}
+
+/// What every encoder back end does: frames in order with their times, then the end, which completes the file.
+pub trait Encoder: Send {
+    fn name(&self) -> &'static str;
+    fn push(&mut self, frame: &NvFrame<'_>) -> Result<(), String>;
+    /// The last frame went; the file is complete (its index written) when this returns `Ok`.
+    fn finish(self: Box<Self>) -> Result<EncoderSummary, String>;
+}
+
+#[derive(Clone, Debug)]
+pub struct Settings {
+    pub width: u32,
+    pub height: u32,
+    pub fps: u32,
+    pub preset: &'static str,
+    pub crf: u32,
+    pub threads: u32,
+    pub nice: u32,
+    pub path: PathBuf,
+    pub ffmpeg: PathBuf,
+}
+
+/// The back end a recording uses, from `record_encoder`: probed when it starts.
+pub fn open(choice: crate::policy::RecordEncoder, settings: &Settings) -> Result<Box<dyn Encoder>, String> {
+    use crate::policy::RecordEncoder;
+    match choice {
+        RecordEncoder::Hardware => hardware::open(settings),
+        RecordEncoder::Auto => hardware::open(settings).or_else(|_| Ok(Box::new(Software::spawn(settings)?) as Box<dyn Encoder>)),
+        RecordEncoder::Software => Ok(Box::new(Software::spawn(settings)?)),
+    }
+}
+
+/// The software encoder can run (its program is there).
+pub fn software_available(ffmpeg: &Path) -> bool {
+    use std::os::unix::fs::PermissionsExt;
+    std::fs::metadata(ffmpeg).is_ok_and(|m| m.is_file() && m.permissions().mode() & 0o111 != 0)
+}
+
+pub mod hardware {
+    /// The Apple Video Encoder (SF-AD) through VideoToolbox's `VTCompressionSession`. Not available: the
+    /// driver work is paused and our VideoToolbox has no encoder. When it comes, `probe` opens a session for
+    /// NV12 frames of the recording's size and `open` returns an `Encoder` whose `push` passes the frame's
+    /// dma-buf (as an IOSurface-compatible `CVPixelBuffer`) with its time, without a copy.
+    pub fn probe() -> Result<(), String> {
+        Err("no hardware video encoder: the Apple Video Encoder driver (SF-AD) is not finished and VideoToolbox here has no encoder".into())
+    }
+    pub fn open(_: &super::Settings) -> Result<Box<dyn super::Encoder>, String> {
+        probe()?;
+        Err("not available".into())
+    }
+}
+
+// --- Matroska, as much as a stream of raw frames with times needs -----------------------------------
+
+fn ebml_id(out: &mut Vec<u8>, id: u32) {
+    let bytes = id.to_be_bytes();
+    let skip = bytes.iter().position(|b| *b != 0).unwrap_or(3);
+    out.extend_from_slice(&bytes[skip..]);
+}
+/// Sizes are written in 8 bytes (any size, the same length every time).
+fn ebml_size(out: &mut Vec<u8>, size: u64) {
+    out.push(0x01);
+    out.extend_from_slice(&size.to_be_bytes()[1..]);
+}
+fn el_uint(out: &mut Vec<u8>, id: u32, v: u64) {
+    ebml_id(out, id);
+    ebml_size(out, 8);
+    out.extend_from_slice(&v.to_be_bytes());
+}
+fn el_bytes(out: &mut Vec<u8>, id: u32, b: &[u8]) {
+    ebml_id(out, id);
+    ebml_size(out, b.len() as u64);
+    out.extend_from_slice(b);
+}
+fn el_master(out: &mut Vec<u8>, id: u32, body: &[u8]) {
+    el_bytes(out, id, body);
+}
+
+/// The stream's head: EBML header, a Segment of unknown size, its Info (times in microseconds) and one
+/// video track of raw NV12 (`V_UNCOMPRESSED`, ColourSpace `NV12`).
+pub fn mkv_head(width: u32, height: u32) -> Vec<u8> {
+    let mut ebml = Vec::new();
+    el_uint(&mut ebml, 0x4286, 1);
+    el_uint(&mut ebml, 0x42F7, 1);
+    el_uint(&mut ebml, 0x42F2, 4);
+    el_uint(&mut ebml, 0x42F3, 8);
+    el_bytes(&mut ebml, 0x4282, b"matroska");
+    el_uint(&mut ebml, 0x4287, 4);
+    el_uint(&mut ebml, 0x4285, 2);
+    let mut out = Vec::new();
+    el_master(&mut out, 0x1A45_DFA3, &ebml);
+    ebml_id(&mut out, 0x1853_8067);
+    out.extend_from_slice(&[0x01, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff]);
+    let mut info = Vec::new();
+    el_uint(&mut info, 0x2A_D7B1, 1000); // TimestampScale: 1000 ns
+    el_bytes(&mut info, 0x4D80, b"chonkstep-darwin-desktop");
+    el_bytes(&mut info, 0x5741, b"chonkstep-darwin-desktop");
+    el_master(&mut out, 0x1549_A966, &info);
+    let mut video = Vec::new();
+    el_uint(&mut video, 0xB0, u64::from(width));
+    el_uint(&mut video, 0xBA, u64::from(height));
+    el_bytes(&mut video, 0x2E_B524, b"NV12");
+    // BT.709 matrix, transfer and primaries, limited range: what the GPU's conversion makes (the frames carry it
+    // into the encoder, which writes it into the stream's VUI)
+    let mut colour = Vec::new();
+    el_uint(&mut colour, 0x55B1, 1);
+    el_uint(&mut colour, 0x55B9, 1);
+    el_uint(&mut colour, 0x55BA, 1);
+    el_uint(&mut colour, 0x55BB, 1);
+    el_master(&mut video, 0x55B0, &colour);
+    let mut track = Vec::new();
+    el_uint(&mut track, 0xD7, 1);
+    el_uint(&mut track, 0x73C5, 1);
+    el_uint(&mut track, 0x83, 1);
+    el_uint(&mut track, 0x9C, 0);
+    el_bytes(&mut track, 0x86, b"V_UNCOMPRESSED");
+    el_master(&mut track, 0xE0, &video);
+    let mut tracks = Vec::new();
+    el_master(&mut tracks, 0xAE, &track);
+    el_master(&mut out, 0x1654_AE6B, &tracks);
+    out
+}
+/// A Cluster with one SimpleBlock (a key frame of track 1 at `at_us`): everything before the frame's bytes.
+pub fn mkv_frame_head(at_us: u64, frame_len: usize) -> Vec<u8> {
+    let mut timestamp = Vec::new();
+    el_uint(&mut timestamp, 0xE7, at_us);
+    let block_len = 4 + frame_len as u64;
+    let mut out = Vec::with_capacity(64);
+    ebml_id(&mut out, 0x1F43_B675);
+    ebml_size(&mut out, timestamp.len() as u64 + 1 + 8 + block_len);
+    out.extend_from_slice(&timestamp);
+    ebml_id(&mut out, 0xA3);
+    ebml_size(&mut out, block_len);
+    out.extend_from_slice(&[0x81, 0x00, 0x00, 0x80]);
+    out
+}
+
+// --- the software encoder ---------------------------------------------------------------------------
+
+pub struct Software {
+    child: Option<Child>,
+    sink: Option<std::fs::File>,
+    frames: u64,
+    width: u32,
+    height: u32,
+    push_s: f64,
+    push_max_ms: f64,
+    started: Instant,
+    path: PathBuf,
+}
+
+/// The arguments ffmpeg gets: Matroska in, H.264 (x264) in a QuickTime movie out.
+pub fn ffmpeg_args(s: &Settings) -> Vec<String> {
+    let mut a: Vec<String> = ["-hide_banner", "-loglevel", "error", "-nostats", "-f", "matroska", "-i", "pipe:0", "-map", "0:v:0", "-c:v", "libx264", "-preset", s.preset]
+        .iter().map(|x| x.to_string()).collect();
+    a.extend(["-crf".into(), s.crf.to_string()]);
+    if s.threads > 0 {
+        a.extend(["-threads".into(), s.threads.to_string()]);
+    }
+    // a key frame every 2 s of the recording's time, whatever the frame rate (a player can seek)
+    a.extend(["-force_key_frames".into(), "expr:gte(t,n_forced*2)".into()]);
+    // the frames' own times (a frame only when the screen changed), on a 60 Hz grid; H.264 level 5.1 (the
+    // panel's size at 60 a second: what x264 cannot work out from times in microseconds)
+    a.extend(["-fps_mode".into(), "passthrough".into(), "-video_track_timescale".into(), "60000".into(), "-level:v".into(), "5.1".into()]);
+    a.extend(["-colorspace", "bt709", "-color_primaries", "bt709", "-color_trc", "bt709", "-color_range", "tv"].iter().map(|x| x.to_string()));
+    a.extend(["-movflags", "+faststart", "-f", "mov", "-y"].iter().map(|x| x.to_string()));
+    a.push(format!("file:{}", s.path.display()));
+    a
+}
+
+fn socketpair() -> std::io::Result<(OwnedFd, OwnedFd)> {
+    let mut fds = [0; 2];
+    if unsafe { libc::socketpair(libc::AF_UNIX, libc::SOCK_STREAM, 0, fds.as_mut_ptr()) } != 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    let (a, b) = unsafe { (OwnedFd::from_raw_fd(fds[0]), OwnedFd::from_raw_fd(fds[1])) };
+    for (fd, opt) in [(fds[0], libc::SO_SNDBUF), (fds[1], libc::SO_RCVBUF)] {
+        unsafe {
+            libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC);
+            // 4 MiB each way: the bytes of most of a frame go in one wake-up of ffmpeg's reader
+            let size: libc::c_int = 4 << 20;
