+        let mut end_us = 0;
+        for msg in rx {
+            match msg {
+                ToWriter::Frame(f, at_us) => {
+                    if error.is_none() {
+                        // SAFETY: the buffer stays mapped and unwritten until it is released below
+                        let data = unsafe { std::slice::from_raw_parts(f.data, f.len) };
