+        assert_eq!(renderer.record_capture((0, 0, W, H), (W, H), true, 1).unwrap(), None);
+        renderer.record_release(got[0].slot);
+        assert!(renderer.record_capture((0, 0, W, H), (W, H), true, 1).unwrap().is_some());
+    }
