+impl Software {
+    pub fn spawn(s: &Settings) -> Result<Self, String> {
+        if !software_available(&s.ffmpeg) {
+            return Err(format!("{} is not there", s.ffmpeg.display()));
+        }
+        let (ours, theirs) = socketpair().map_err(|e| format!("socketpair: {e}"))?;
+        let child = Command::new(&s.ffmpeg)
+            .args(ffmpeg_args(s))
+            .stdin(Stdio::from(theirs))
+            .stdout(Stdio::null())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .map_err(|e| format!("{}: {e}", s.ffmpeg.display()))?;
+        if s.nice > 0 {
+            unsafe { libc::setpriority(libc::PRIO_PROCESS, child.id() as _, s.nice as libc::c_int) };
+        }
+        let mut sink = std::fs::File::from(ours);
+        sink.write_all(&mkv_head(s.width, s.height)).map_err(|e| format!("ffmpeg: {e}"))?;
+        eprintln!("WMRECORD encoder software pid={} {} {}", child.id(), s.ffmpeg.display(), ffmpeg_args(s).join(" "));
+        Ok(Self { child: Some(child), sink: Some(sink), frames: 0, width: s.width, height: s.height, push_s: 0.0, push_max_ms: 0.0, started: Instant::now(), path: s.path.clone() })
+    }
+}
+
+impl Encoder for Software {
+    fn name(&self) -> &'static str {
+        "software"
+    }
+    fn push(&mut self, f: &NvFrame<'_>) -> Result<(), String> {
+        let len = self.width as usize * self.height as usize * 3 / 2;
+        if f.width != self.width || f.height != self.height || f.data.len() < len {
+            return Err(format!("a frame of {}x{} ({} bytes) for a recording of {}x{}", f.width, f.height, f.data.len(), self.width, self.height));
+        }
+        let t = Instant::now();
+        let sink = self.sink.as_mut().ok_or("the encoder was finished")?;
+        sink.write_all(&mkv_frame_head(f.at_us, len))
+            .and_then(|_| sink.write_all(&f.data[..len]))
+            .map_err(|e| format!("ffmpeg stopped taking frames: {e}"))?;
+        let took = t.elapsed().as_secs_f64();
+        self.push_s += took;
+        self.push_max_ms = self.push_max_ms.max(took * 1000.0);
+        self.frames += 1;
+        Ok(())
+    }
+    fn finish(mut self: Box<Self>) -> Result<EncoderSummary, String> {
+        drop(self.sink.take()); // the end of the stream: ffmpeg finishes the file
+        let mut child = self.child.take().ok_or("no ffmpeg")?;
+        let pid = child.id() as libc::pid_t;
+        // ffmpeg writes the movie's index and moves it to the front (+faststart): it may take a while for a
+        // long recording; this thread waits (the desk does not)
+        let deadline = Instant::now() + Duration::from_secs(600);
+        let mut status = 0;
+        let mut usage: libc::rusage = unsafe { std::mem::zeroed() };
+        loop {
+            let r = unsafe { libc::wait4(pid, &mut status, libc::WNOHANG, &mut usage) };
+            if r == pid {
+                break;
+            }
+            if r < 0 {
+                return Err(format!("waiting for ffmpeg: {}", std::io::Error::last_os_error()));
+            }
+            if Instant::now() > deadline {
+                let _ = child.kill();
+                return Err("ffmpeg did not finish the file within 10 minutes (ended)".into());
+            }
+            std::thread::sleep(Duration::from_millis(20));
+        }
+        let t = |tv: libc::timeval| tv.tv_sec as f64 + tv.tv_usec as f64 / 1e6;
+        let cpu = t(usage.ru_utime) + t(usage.ru_stime);
+        let exited = status & 0x7f == 0;
+        let code = (status >> 8) & 0xff;
+        if !exited || code != 0 {
+            return Err(format!("ffmpeg ended with {} (the file {} may be incomplete)", if exited { format!("status {code}") } else { format!("signal {}", status & 0x7f) }, self.path.display()));
+        }
+        let wall = self.started.elapsed().as_secs_f64();
+        Ok(EncoderSummary {
+            frames: self.frames,
+            cpu_s: cpu,
+            push_s: self.push_s,
+            push_max_ms: self.push_max_ms,
+            detail: format!("ffmpeg_cpu_s={cpu:.2} ffmpeg_cpu_pct_of_one_core={:.0}", if wall > 0.0 { cpu / wall * 100.0 } else { 0.0 }),
+        })
+    }
+}
