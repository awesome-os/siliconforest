+    /// DESK11: the recorder's GPU conversion of a frame (and of an area of it, at half size) to NV12 equals the
+    /// CPU's conversion of the same pixels within one step, and the frames come back in the order taken.
+    #[test]
+    fn a_recorded_frame_is_converted_to_nv12_on_the_gpu() {
+        const W: u32 = 96;
+        const H: u32 = 64;
+        let mut renderer = match GlRenderer::offscreen(W, H) {
+            Ok(renderer) => renderer,
+            Err(error) => {
+                eprintln!("SKIPPED a_recorded_frame_is_converted_to_nv12_on_the_gpu: no GL on this host ({error})");
+                return;
+            }
+        };
+        let mut rng = Lcg(0x11);
+        let mut scene = CpuBackend::new(Size::new(W, H)).unwrap();
+        let image = rng.image(W, H, true);
+        scene.paint_root_image(&image);
+        renderer.render_frame(&mut scene, &mut Nothing).unwrap();
+        let rgba = renderer.read_back().unwrap().unwrap();
+        // the whole frame at its size, an area at half size
+        let full = renderer.record_capture((0, 0, W, H), (W, H), true, 2).unwrap().unwrap();
+        let half = renderer.record_capture((16, 8, 64, 48), (32, 24), true, 2).unwrap().unwrap();
+        assert!(half > full);
+        let mut got = Vec::new();
+        for _ in 0..20 {
+            got.extend(renderer.record_ready(Duration::from_millis(100)));
+            if got.len() == 2 {
+                break;
+            }
+        }
+        assert_eq!(got.iter().map(|f| f.ticket).collect::<Vec<_>>(), vec![full, half]);
+        for (f, src, out) in [(got[0], (0, 0, W as usize, H as usize), (W as usize, H as usize)), (got[1], (16, 8, 64, 48), (32, 24))] {
+            let data = unsafe { std::slice::from_raw_parts(f.data, f.len) };
+            let want = nv12_reference(&rgba, W as usize, H as usize, src, out);
+            assert_eq!(data.len(), want.len());
+            let worst = data.iter().zip(&want).map(|(a, b)| a.abs_diff(*b)).max().unwrap();
+            let off = data.iter().zip(&want).filter(|(a, b)| a.abs_diff(**b) > 1).count();
+            eprintln!("nv12 {}x{}: largest difference {worst}, {off} bytes off by more than 1", out.0, out.1);
+            assert!(worst <= 1, "largest difference {worst}");
+        }
