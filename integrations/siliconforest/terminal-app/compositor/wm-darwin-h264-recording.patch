+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn the_matroska_head_and_a_frame_have_their_sizes() {
+        let head = mkv_head(64, 32);
+        assert_eq!(&head[..4], &[0x1A, 0x45, 0xDF, 0xA3]);
+        assert!(head.windows(4).any(|w| w == b"NV12"));
+        assert!(head.windows(14).any(|w| w == b"V_UNCOMPRESSED"));
+        let f = mkv_frame_head(16_667, 64 * 32 * 3 / 2);
+        assert_eq!(&f[..4], &[0x1F, 0x43, 0xB6, 0x75]);
+        let cluster = u64::from_be_bytes([0, f[5], f[6], f[7], f[8], f[9], f[10], f[11]]);
+        assert_eq!(cluster as usize, f.len() - 12 + 64 * 32 * 3 / 2);
+        assert_eq!(&f[f.len() - 4..], &[0x81, 0, 0, 0x80]);
+    }
+    /// The software encoder end to end with the host's ffmpeg (skipped without one): 60 frames at 60 a second,
+    /// moving bars, in a movie of H.264 whose frames, times and colours ffprobe and ffmpeg read back.
+    #[test]
+    fn software_encoder_makes_an_h264_movie_with_the_frames_times() {
+        let ffmpeg = std::env::var_os("RECORD_TEST_FFMPEG").map(PathBuf::from).unwrap_or_else(|| PathBuf::from("/usr/bin/ffmpeg"));
+        if !software_available(&ffmpeg) {
+            eprintln!("no ffmpeg at {}: skipped", ffmpeg.display());
+            return;
+        }
+        let dir = std::env::temp_dir().join(format!("encoder-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("Screen Recording test.mov");
+        let (w, h) = (320u32, 192u32);
+        let settings = Settings { width: w, height: h, fps: 60, preset: "ultrafast", crf: 20, threads: 0, nice: 0, path: path.clone(), ffmpeg: ffmpeg.clone() };
+        let mut enc: Box<dyn Encoder> = Box::new(Software::spawn(&settings).unwrap());
+        let mut frame = vec![0u8; (w * h * 3 / 2) as usize];
+        for n in 0..60u64 {
+            // Y: a bright bar moving right on a mid grey; U/V neutral except a red-ish block
+            for y in 0..h as usize {
+                for x in 0..w as usize {
+                    frame[y * w as usize + x] = if (x as u64 / 16) == n % 20 { 235 } else { 126 };
+                }
+            }
+            for p in frame[(w * h) as usize..].chunks_exact_mut(2) {
+                p.copy_from_slice(&[128, 128]);
+            }
+            enc.push(&NvFrame { data: &frame, width: w, height: h, dmabuf: -1, at_us: n * 16_667 }).unwrap();
+        }
+        let s = enc.finish().unwrap();
+        assert_eq!(s.frames, 60);
+        let probe = ffmpeg.with_file_name("ffprobe");
+        let out = Command::new(&probe)
+            .args(["-v", "error", "-select_streams", "v:0", "-count_frames", "-show_entries", "stream=codec_name,pix_fmt,width,height,nb_read_frames,color_space,color_transfer,color_primaries,level:format=duration", "-of", "default=nw=1"])
+            .arg(&path)
+            .output()
+            .unwrap();
+        let text = String::from_utf8_lossy(&out.stdout).to_string();
+        eprintln!("{text}");
+        assert!(text.contains("codec_name=h264"), "{text}");
+        assert!(text.contains("pix_fmt=yuv420p"), "{text}");
+        assert!(text.contains("nb_read_frames=60"), "{text}");
+        assert!(text.contains("color_space=bt709"), "{text}");
+        assert!(text.contains("color_transfer=bt709") && text.contains("color_primaries=bt709"), "{text}");
+        let duration: f64 = text.lines().find_map(|l| l.strip_prefix("duration=")).and_then(|d| d.parse().ok()).unwrap();
+        assert!((duration - 1.0).abs() < 0.05, "duration {duration}");
+        assert!(text.contains("level=51"), "{text}");
+        // the moov is at the front (+faststart)
+        let data = std::fs::read(&path).unwrap();
+        let moov = data.windows(4).position(|w| w == b"moov").unwrap();
+        let mdat = data.windows(4).position(|w| w == b"mdat").unwrap();
+        assert!(moov < mdat);
+        if std::env::var_os("RECORD_TEST_KEEP").is_none() {
+            let _ = std::fs::remove_dir_all(&dir);
+        }
+    }
+}
