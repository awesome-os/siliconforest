+fn h264_writer(mut encoder: Box<dyn crate::encoder::Encoder>, rx: mpsc::Receiver<ToWriter>, released: mpsc::Sender<usize>, failed: Arc<std::sync::atomic::AtomicBool>, path: PathBuf)
