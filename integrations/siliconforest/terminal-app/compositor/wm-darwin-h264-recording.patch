+    /// DESK11: BT.709 limited range, as the recorder's shader converts (the reference for its test).
+    fn nv12_reference(rgba: &[u8], w: usize, h: usize, src: (usize, usize, usize, usize), out: (usize, usize)) -> Vec<u8> {
+        let (sx, sy, sw, sh) = src;
+        let (ow, oh) = out;
+        // the mean of the source pixels a luma sample covers (exact for 1:1 and 2:1)
+        let fx = sw / ow;
+        let fy = sh / oh;
+        let px = |x: usize, y: usize| -> [f64; 3] {
+            let mut c = [0.0; 3];
+            for dy in 0..fy {
+                for dx in 0..fx {
+                    let at = ((sy + y * fy + dy) * w + sx + x * fx + dx) * 4;
+                    for k in 0..3 {
+                        c[k] += f64::from(rgba[at + k]) / 255.0;
+                    }
+                }
+            }
+            c.map(|v| v / (fx * fy) as f64)
+        };
+        let _ = h;
+        let mut nv = vec![0u8; ow * oh * 3 / 2];
+        for y in 0..oh {
+            for x in 0..ow {
+                let c = px(x, y);
+                nv[y * ow + x] = (16.0 + 219.0 * (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2])).round() as u8;
+            }
+        }
+        for y in 0..oh / 2 {
+            for x in 0..ow / 2 {
+                let mut c = [0.0; 3];
+                for (dx, dy) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
+                    let p = px(2 * x + dx, 2 * y + dy);
+                    for k in 0..3 {
+                        c[k] += p[k] / 4.0;
+                    }
+                }
+                let u = 128.0 + 224.0 * (-0.114572 * c[0] - 0.385428 * c[1] + 0.5 * c[2]);
+                let v = 128.0 + 224.0 * (0.5 * c[0] - 0.454153 * c[1] - 0.045847 * c[2]);
+                nv[ow * oh + y * ow + 2 * x] = u.round() as u8;
+                nv[ow * oh + y * ow + 2 * x + 1] = v.round() as u8;
+            }
+        }
+        nv
+    }
