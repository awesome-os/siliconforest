+#[cfg(test)]
+mod ring_tests {
+    use super::parse_ring;
+    fn event(bytes: &mut Vec<u8>, seq: u32, phase: u8, fingers: u8, dx: i16, dy: i16, kind: u8, scale: u32, angle: i32, v2: bool) {
+        bytes.extend_from_slice(&seq.to_ne_bytes());
+        bytes.extend_from_slice(&[phase, fingers]);
+        bytes.extend_from_slice(&dx.to_ne_bytes());
+        bytes.extend_from_slice(&dy.to_ne_bytes());
+        bytes.extend_from_slice(&[0, kind]);
+        bytes.extend_from_slice(&7u32.to_ne_bytes());
+        if v2 {
+            bytes.extend_from_slice(&scale.to_ne_bytes());
+            bytes.extend_from_slice(&angle.to_ne_bytes());
+        }
+    }
+    /// The kernel's ring as it is (version 1, swipes) and as DESK6 asks for it (version 2: a
+    /// kind, the pinch's scale and turn): both read; anything else is not taken.
+    #[test]
+    fn the_trackpad_ring_reads_swipes_of_version_1_and_pinches_of_version_2() {
+        let mut v1 = [1u32.to_ne_bytes(), 3u32.to_ne_bytes()].concat();
+        for i in 0..32 { event(&mut v1, i, if i == 1 { 1 } else { 2 }, 3, -12, 4, 0, 0, 0, false); }
+        let (version, next, events) = parse_ring(&v1).unwrap();
+        assert_eq!((version, next), (1, 3));
+        assert_eq!(events[1], (1, 1, 3, -12, 4, 0, 0, 65536, 0), "a version-1 event is a swipe");
+        let mut v2 = [2u32.to_ne_bytes(), 5u32.to_ne_bytes()].concat();
+        for i in 0..32 { event(&mut v2, i, 2, 2, 3, -1, 1, 98304, -250, true); }
+        let (version, _, events) = parse_ring(&v2).unwrap();
+        assert_eq!(version, 2);
+        assert_eq!(events[4], (4, 2, 2, 3, -1, 0, 1, 98304, -250), "a pinch: scale 1.5, turned 2.5 degrees anticlockwise");
+        assert!(parse_ring(&v2[..700]).is_none(), "a cut ring is not taken");
+        let mut bad = v1.clone();
+        bad[0] = 9;
+        assert!(parse_ring(&bad).is_none(), "an unknown version is not taken");
+    }
+}
