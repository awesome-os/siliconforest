+/// DESK6 (the Firefox and AppKit agents' request): a pinch from the trackpad goes to the client under
+/// the pointer through zwp_pointer_gestures_v1 - begin with the fingers, updates with the centre's
+/// motion, the scale since the begin and the turn, end - as a Linux compositor gives libinput's.
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn a_pinch_goes_to_the_client_under_the_pointer_through_pointer_gestures() {
+    let (h, a) = Harness::with_input(true);
+    let (tx, rx) = mpsc::channel();
+    h.tx.send(Request::Desktop(tx)).unwrap();
+    rx.recv_timeout(Duration::from_secs(3)).unwrap().unwrap();
+    let (mut q, mut c, _s, _x, _t) = map_client(&a, "pinched");
+    assert!(c.globals.iter().any(|g| g == "zwp_pointer_gestures_v1"), "the global is offered: {:?}", c.globals);
+    let qh = q.handle();
+    let pointer = c.pointer.clone().expect("a pointer");
+    let _pinch = c.gestures.as_ref().unwrap().get_pinch_gesture(&pointer, &qh, ());
+    q.roundtrip(&mut c).unwrap();
+    // the pointer onto the window, then a pinch out by half and a turn
+    let content = h.snapshot().content.unwrap();
+    use wm_darwin::hid::{Event, Motion, SwipePhase};
+    let at = |v: i32, of: f64| ((f64::from(v) + 0.25) / of * 65535.).round().clamp(0., 65535.) as u16;
+    h.tx.send(Request::Hid(Event::Pointer { motion: Motion::Absolute(at(content.pos.x + 30, 319.), at(content.pos.y + 30, 239.)), buttons: 0, wheel: 0 })).unwrap();
+    for (phase, scale, turn) in [(SwipePhase::Begin, 65536, 0), (SwipePhase::Update, 81920, 150), (SwipePhase::Update, 98304, 100), (SwipePhase::End, 98304, 0)] {
+        h.tx.send(Request::Hid(Event::Pinch { phase, fingers: 2, dx: 4, dy: -2, scale_q16: scale, rotation_cdeg: turn })).unwrap();
+    }
+    h.snapshot();
+    for _ in 0..3 { q.roundtrip(&mut c).unwrap(); }
+    assert_eq!(c.pinch_events, ["begin 2", "update 4.0 -2.0 1.25 1.50", "update 4.0 -2.0 1.50 1.00", "end 0"], "{:?}", c.pinch_events);
+}
