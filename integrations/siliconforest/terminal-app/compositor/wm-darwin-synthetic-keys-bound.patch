+
+/// DESK8 (the coordinator's safety item; FXQA's Return into the desk's terminal): the instrument's keys are
+/// bound to the window it pressed in. When that window's client goes in the middle of a request, the rest
+/// of the keys are refused and no other client gets any of them (before: they went to the focused window).
+#[test]
+#[cfg(feature="desktop-shell")]
+fn synthetic_keys_whose_window_went_reach_no_other_window(){
+    use wm_darwin::hid::{Event,Motion};
+    let(h,connection)=Harness::with_input(true);
+    let (server_end,client_end)=UnixStream::pair().unwrap();
+    h.tx.send(Request::AddClient(server_end)).unwrap();
+    let other=Connection::from_socket(client_end).unwrap();
+    let(mut qb,mut cb,_sb,_tb)=map_with_seat(&other);
+    let a_window;
+    {
+        let(mut qa,mut ca,_sa,_ta)=map_with_seat(&connection);
+        for _ in 0..3{h.snapshot();qa.roundtrip(&mut ca).unwrap();qb.roundtrip(&mut cb).unwrap();}
+        let shot=h.snapshot();
+        assert_eq!(shot.windows.len(),2,"{:?}",shot.windows);
+        a_window=shot.windows.iter().map(|w|w.0).find(|r|r.size.w>0).unwrap();
+        // the newest window is A here: press in it
+        let a=shot.windows[1].0;
+        let p=wm_core::Point::new(a.pos.x+a.size.w as i32/2,a.pos.y+a.size.h as i32/2);
+        let abs=Motion::Absolute(((f64::from(p.x)+0.25)/319.*65535.).round() as u16,((f64::from(p.y)+0.25)/239.*65535.).round() as u16);
+        let virt=|e:Event|{let(tx,rx)=mpsc::channel();h.tx.send(Request::Virtual(e,tx)).unwrap();rx.recv_timeout(Duration::from_secs(3)).unwrap()};
+        virt(Event::Pointer{motion:abs,buttons:0,wheel:0}).unwrap();
+        virt(Event::Pointer{motion:Motion::Relative(0,0),buttons:1,wheel:0}).unwrap();
+        virt(Event::Pointer{motion:Motion::Relative(0,0),buttons:0,wheel:0}).unwrap();
+        virt(Event::Key{evdev:30,down:true}).unwrap();
+        virt(Event::Key{evdev:30,down:false}).unwrap();
+        for _ in 0..3{h.snapshot();qa.roundtrip(&mut ca).unwrap();qb.roundtrip(&mut cb).unwrap();}
+        assert!(ca.keys.len()>=2,"A, pressed in, got the synthetic key");
+    }
+    // A's client quits in the middle of the request
+    drop(connection);
+    for _ in 0..5{h.snapshot();qb.roundtrip(&mut cb).unwrap();std::thread::sleep(Duration::from_millis(5));}
+    assert_eq!(h.snapshot().windows.len(),1,"A is gone");
+    let _=a_window;
+    let kb=cb.keys.len();
+    let virt=|e:Event|{let(tx,rx)=mpsc::channel();h.tx.send(Request::Virtual(e,tx)).unwrap();rx.recv_timeout(Duration::from_secs(3)).unwrap()};
+    // the rest of the request: a word and Return
+    let mut refused=0;
+    for code in [20u32,30,28] {
+        if virt(Event::Key{evdev:code,down:true}).is_err(){refused+=1;}
+        if virt(Event::Key{evdev:code,down:false}).is_err(){refused+=1;}
+    }
+    for _ in 0..3{h.snapshot();qb.roundtrip(&mut cb).unwrap();}
+    assert_eq!(cb.keys.len(),kb,"no key of the request reached B (the focused window now): {:?}",&cb.keys[kb..]);
+    assert_eq!(refused,6,"every remaining key is refused (reported to the instrument)");
+}
