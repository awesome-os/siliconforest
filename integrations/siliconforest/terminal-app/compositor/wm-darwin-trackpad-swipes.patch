+/// (seq, phase, fingers, dx, dy, synthetic) of one event of the ring.
+type RingEvent = (u32, u8, u8, i16, i16, u8);
+/// `kern.sf_trackpad_swipe`: (version, next sequence, the 32 events); None without it.
+#[cfg(not(target_os = "linux"))]
+fn read_swipe_ring() -> Option<(u32, u32, [RingEvent; 32])> {
+    let mut bytes = [0u8; 8 + 32 * 16];
+    let mut len = bytes.len();
+    let name = c"kern.sf_trackpad_swipe";
+    let rc = unsafe { libc::sysctlbyname(name.as_ptr(), bytes.as_mut_ptr().cast(), &mut len, std::ptr::null_mut(), 0) };
+    if rc != 0 || len != bytes.len() {
+        return None;
+    }
+    let u32_at = |o: usize| u32::from_ne_bytes(bytes[o..o + 4].try_into().unwrap());
+    let i16_at = |o: usize| i16::from_ne_bytes(bytes[o..o + 2].try_into().unwrap());
+    let mut events = [(0u32, 0u8, 0u8, 0i16, 0i16, 0u8); 32];
+    for (i, e) in events.iter_mut().enumerate() {
+        let o = 8 + i * 16;
+        *e = (u32_at(o), bytes[o + 4], bytes[o + 5], i16_at(o + 6), i16_at(o + 8), bytes[o + 10]);
+    }
+    (u32_at(0) == 1).then(|| (u32_at(0), u32_at(4), events))
+}
