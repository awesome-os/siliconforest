+                self.gesture.origin = None;
+                self.gesture.vertical = None;
+                self.gesture.swipes += 1;
+                eprintln!("WMGESTURE begin fingers={fingers} desktop={claimed} available={available}");
+            }
+            SwipePhase::Update => {
