diff --git a/crates/wm-darwin/src/layers.rs b/crates/wm-darwin/src/layers.rs
new file mode 100644
index 0000000..ce0a37b
--- /dev/null
+++ b/crates/wm-darwin/src/layers.rs
@@ -0,0 +1,307 @@
+//! `zwlr_layer_shell_v1`: surfaces of desktop programs that are not windows (the Chonkstep
+//! dock's column, its Clip and launcher strip), anchored to the panel's edges, above or below
+//! the windows, never managed by the window manager. What this desk does with them:
+//! - size and place them by anchors, size and margins (logical units, as the protocol has them);
+//! - draw them through the scene's shell surfaces (above the windows for the top and overlay
+//!   layers, below them for background and bottom), from the client's SHM buffer;
+//! - keep windows out of an exclusive zone (the work area wm-core places and maximizes in);
+//! - give them the pointer (motion, buttons, wheel) when it is over them; keyboard focus is
+//!   not given (the dock asks for none in its ordinary state);
+//! - popups whose parent is a layer surface (`get_popup`), placed against it.
+//! Not done: per-output placement (there is one panel), the keyboard, exclusive focus.
+use smithay::reexports::wayland_server::protocol::{wl_output::WlOutput, wl_surface::WlSurface};
+use smithay::wayland::compositor::{with_states, BufferAssignment, SurfaceAttributes};
+use smithay::wayland::shell::wlr_layer::{
+    Anchor, ExclusiveZone, Layer, LayerSurface, LayerSurfaceCachedState, WlrLayerShellHandler, WlrLayerShellState,
+};
+use smithay::wayland::shell::xdg::PopupSurface;
+use wm_core::{Backend, Point, Rect, Size};
+
+use crate::server::Server;
+
+pub struct LayerEntry {
+    pub surface: LayerSurface,
+    pub namespace: String,
+    /// On the panel, panel pixels.
+    pub rect: Rect,
+    pub shell: Option<u64>,
+    pub above: bool,
+    /// The edge and panel pixels it keeps windows away from.
+    pub exclusive: Option<(Anchor, u32)>,
+}
+
+impl Server {
+    fn layer_index(&self, surface: &WlSurface) -> Option<usize> {
+        self.layers.iter().position(|l| l.surface.wl_surface() == surface)
+    }
+    /// Size and place from the cached state; returns (logical size to configure, panel rect).
+    fn layer_place(&self, state: &LayerSurfaceCachedState) -> (Size, Rect) {
+        let density = self.scale().factor();
+        let screen = self.wm.backend().screen_size();
+        let (sw, sh) = ((f64::from(screen.w) / density).round() as i32, (f64::from(screen.h) / density).round() as i32);
+        let a = state.anchor;
+        let m = state.margin;
+        let mut w = state.size.w;
+        let mut h = state.size.h;
+        if w == 0 && a.contains(Anchor::LEFT) && a.contains(Anchor::RIGHT) {
+            w = sw - m.left - m.right;
+        }
+        if h == 0 && a.contains(Anchor::TOP) && a.contains(Anchor::BOTTOM) {
+            h = sh - m.top - m.bottom;
+        }
+        let w = w.clamp(1, sw.max(1));
+        let h = h.clamp(1, sh.max(1));
+        let x = if a.contains(Anchor::LEFT) && !a.contains(Anchor::RIGHT) {
+            m.left
+        } else if a.contains(Anchor::RIGHT) && !a.contains(Anchor::LEFT) {
+            sw - w - m.right
+        } else if a.contains(Anchor::LEFT) {
+            m.left
+        } else {
+            (sw - w) / 2
+        };
+        let y = if a.contains(Anchor::TOP) && !a.contains(Anchor::BOTTOM) {
+            m.top
+        } else if a.contains(Anchor::BOTTOM) && !a.contains(Anchor::TOP) {
+            sh - h - m.bottom
+        } else if a.contains(Anchor::TOP) {
+            m.top
+        } else {
+            (sh - h) / 2
+        };
+        let px = |v: i32| (f64::from(v) * density).round() as i32;
+        (
+            Size::new(w as u32, h as u32),
+            Rect::new(Point::new(px(x), px(y)), Size::new(px(w).max(1) as u32, px(h).max(1) as u32)),
+        )
+    }
+    fn layer_exclusive(&self, state: &LayerSurfaceCachedState) -> Option<(Anchor, u32)> {
+        let ExclusiveZone::Exclusive(zone) = state.exclusive_zone else { return None };
+        if zone == 0 {
+            return None;
+        }
+        let a = state.anchor;
+        let edge = if !state.exclusive_edge.is_empty() {
+            state.exclusive_edge
+        } else if a == Anchor::TOP || a == Anchor::TOP | Anchor::LEFT | Anchor::RIGHT {
+            Anchor::TOP
+        } else if a == Anchor::BOTTOM || a == Anchor::BOTTOM | Anchor::LEFT | Anchor::RIGHT {
+            Anchor::BOTTOM
+        } else if a == Anchor::LEFT || a == Anchor::LEFT | Anchor::TOP | Anchor::BOTTOM {
+            Anchor::LEFT
+        } else if a == Anchor::RIGHT || a == Anchor::RIGHT | Anchor::TOP | Anchor::BOTTOM {
+            Anchor::RIGHT
+        } else {
+            return None;
+        };
+        Some((edge, (f64::from(zone) * self.scale().factor()).round() as u32))
+    }
+    /// The work area: the panel less every exclusive zone (and the margin beside it).
+    fn layers_workarea(&mut self) {
+        let screen = self.wm.backend().screen_size();
+        let (mut left, mut right, mut top, mut bottom) = (0u32, 0u32, 0u32, 0u32);
+        for layer in &self.layers {
+            if layer.shell.is_none() {
+                continue;
+            }
+            match layer.exclusive {
+                Some((edge, px)) if edge == Anchor::LEFT => left = left.max(px),
+                Some((edge, px)) if edge == Anchor::RIGHT => right = right.max(px),
+                Some((edge, px)) if edge == Anchor::TOP => top = top.max(px),
+                Some((edge, px)) if edge == Anchor::BOTTOM => bottom = bottom.max(px),
+                _ => {}
+            }
+        }
+        let area = Rect::new(
+            Point::new(left as i32, top as i32),
+            Size::new(screen.w.saturating_sub(left + right).max(1), screen.h.saturating_sub(top + bottom).max(1)),
+        );
+        if self.layer_workarea != Some(area) {
+            self.layer_workarea = Some(area);
+            self.wm.set_workarea(area);
+            eprintln!("WMLAYER workarea={},{} {}x{}", area.pos.x, area.pos.y, area.size.w, area.size.h);
+        }
+    }
+    /// A commit on a layer surface. False when the surface is not one.
+    pub(crate) fn layer_commit(&mut self, surface: &WlSurface) -> bool {
+        let Some(index) = self.layer_index(surface) else { return false };
+        let state = with_states(surface, |s| *s.cached_state.get::<LayerSurfaceCachedState>().current());
+        let (size, rect) = self.layer_place(&state);
+        let exclusive = self.layer_exclusive(&state);
+        let above = matches!(state.layer, Layer::Top | Layer::Overlay);
+        let layer = &self.layers[index];
+        let configured = with_states(surface, |s| {
+            s.data_map.get::<smithay::wayland::shell::wlr_layer::LayerSurfaceData>().is_some_and(|d| d.lock().unwrap().initial_configure_sent)
+        });
+        if !configured || layer.rect.size != rect.size {
+            layer.surface.with_pending_state(|p| p.size = Some((size.w as i32, size.h as i32).into()));
+            if !configured {
+                self.announce_scale(surface);
+                layer.surface.send_configure();
+                self.layers[index].rect = rect;
+                self.layers[index].exclusive = exclusive;
+                self.layers[index].above = above;
+                return true;
+            }
+            layer.surface.send_pending_configure();
+        }
+        let (buffer, callbacks) = with_states(surface, |s| {
+            let mut attributes = s.cached_state.get::<SurfaceAttributes>();
+            let a = attributes.current();
+            a.damage.clear();
+            (a.buffer.take(), std::mem::take(&mut a.frame_callbacks))
+        });
+        self.cursor_callbacks.extend(callbacks);
+        // A surface already shown keeps the size it drew until its next buffer.
+        let rect = match self.layers[index].shell.and_then(|shell| self.wm.backend().shell_size(shell)) {
+            Some(drawn) => Rect::new(self.layer_drawn_pos(&state, rect.pos, drawn), drawn),
+            None => rect,
+        };
+        let moved = self.layers[index].rect.pos != rect.pos;
+        self.layers[index].rect = rect;
+        self.layers[index].exclusive = exclusive.map(|(edge, zone)| {
+            let shown = self.layers[index].shell.is_some();
+            let drawn = if edge == Anchor::LEFT || edge == Anchor::RIGHT { rect.size.w } else { rect.size.h };
+            (edge, if shown { zone.max(drawn) } else { zone })
+        });
+        self.layers[index].above = above;
+        match buffer {
+            Some(BufferAssignment::NewBuffer(buffer)) => {
+                let copied = self.import_shm(&buffer);
+                buffer.release();
+                let image = match copied {
+                    Ok(image) => image,
+                    Err(error) => {
+                        eprintln!("WMLAYER refused buffer: {error}");
+                        return true;
+                    }
+                };
+                let image_size = Size::new(image.width, image.height);
+                // Placed by what it drew: a surface anchored to the right or the bottom edge keeps
+                // its far side on that edge even when its buffer is larger than the size it asked
+                // for (the dock's column at 200%), and its exclusive zone covers what it drew.
+                let mut rect = rect;
+                rect.pos = self.layer_drawn_pos(&state, rect.pos, image_size);
+                let moved = moved || self.layers[index].rect.pos != rect.pos;
+                self.layers[index].rect.pos = rect.pos;
+                if let Some((edge, zone)) = exclusive {
+                    let drawn = if edge == Anchor::LEFT || edge == Anchor::RIGHT { image_size.w } else { image_size.h };
+                    self.layers[index].exclusive = Some((edge, zone.max(drawn)));
+                }
+                let old = self.layers[index].shell;
+                let backend = self.wm.backend_mut();
+                let shell = match old {
+                    Some(shell) if !moved && backend.shell_size(shell) == Some(image_size) => Some(shell),
+                    _ => {
+                        if let Some(old) = old {
+                            backend.destroy_shell_surface(old);
+                        }
+                        backend.create_shell_surface(Rect::new(rect.pos, image_size), (0, 0, 0), above)
+                    }
+                };
+                if let Some(shell) = shell {
+                    backend.paint_shell_surface(shell, &image);
+                    backend.map_shell_surface(shell);
+                    if old != Some(shell) {
+                        eprintln!("WMLAYER mapped namespace={} at={},{} size={}x{}", self.layers[index].namespace, rect.pos.x, rect.pos.y, image_size.w, image_size.h);
+                    }
+                }
+                self.layers[index].shell = shell;
+                self.layers[index].rect.size = image_size;
+                self.layers_workarea();
+                if old != shell {
+                    self.refresh_pointer();
+                }
+            }
+            Some(BufferAssignment::Removed) => {
+                if let Some(shell) = self.layers[index].shell.take() {
+                    self.wm.backend_mut().destroy_shell_surface(shell);
+                }
+                self.layers_workarea();
+            }
+            None => {}
+        }
+        true
+    }
+    /// The topmost shown layer surface under a point: its surface and its origin in logical units.
+    pub(crate) fn layer_at(&self, root: Point) -> Option<(WlSurface, (f64, f64))> {
+        let density = self.scale().factor();
+        let hit = |l: &&LayerEntry| {
+            l.shell.is_some()
+                && root.x >= l.rect.pos.x
+                && root.y >= l.rect.pos.y
+                && i64::from(root.x) < i64::from(l.rect.pos.x) + i64::from(l.rect.size.w)
+                && i64::from(root.y) < i64::from(l.rect.pos.y) + i64::from(l.rect.size.h)
+        };
+        self.layers.iter().rev().filter(|l| l.above).find(hit).map(|l| {
+            (l.surface.wl_surface().clone(), (f64::from(l.rect.pos.x) / density, f64::from(l.rect.pos.y) / density))
+        })
+    }
+    /// Where a surface of `drawn` panel pixels goes: its far side on the right or bottom edge it
+    /// is anchored to (a buffer larger than the size it asked for grows inwards, not off the panel).
+    fn layer_drawn_pos(&self, state: &LayerSurfaceCachedState, pos: Point, drawn: Size) -> Point {
+        let screen = self.wm.backend().screen_size();
+        let density = self.scale().factor();
+        let px = |v: i32| (f64::from(v) * density).round() as i32;
+        let (a, m) = (state.anchor, state.margin);
+        let mut pos = pos;
+        if a.contains(Anchor::RIGHT) && !a.contains(Anchor::LEFT) {
+            pos.x = screen.w as i32 - drawn.w as i32 - px(m.right);
+        }
+        if a.contains(Anchor::BOTTOM) && !a.contains(Anchor::TOP) {
+            pos.y = screen.h as i32 - drawn.h as i32 - px(m.bottom);
+        }
+        pos
+    }
+    /// One line per layer surface and the work area (tests, logs).
+    pub fn layer_report(&self) -> String {
+        let mut out = String::new();
+        for l in &self.layers {
+            out.push_str(&format!("layer namespace={} at={},{} size={}x{} shown={} exclusive={:?}\n", l.namespace, l.rect.pos.x, l.rect.pos.y, l.rect.size.w, l.rect.size.h, l.shell.is_some(), l.exclusive.map(|(_, px)| px)));
+        }
+        if let Some(a) = self.layer_workarea {
+            out.push_str(&format!("workarea={},{} {}x{}\n", a.pos.x, a.pos.y, a.size.w, a.size.h));
+        }
+        out.push_str(&format!("foreign_listeners={}\n", self.foreign_listener_count()));
+        out
+    }
+    /// Where a layer surface is, for a popup placed against it.
+    pub(crate) fn layer_place_of(&self, surface: &WlSurface) -> Option<Point> {
+        self.layers.iter().find(|l| l.surface.wl_surface() == surface).map(|l| l.rect.pos)
+    }
+    fn layer_gone(&mut self, surface: &WlSurface) {
+        if let Some(index) = self.layer_index(surface) {
+            let entry = self.layers.remove(index);
+            if let Some(shell) = entry.shell {
+                self.wm.backend_mut().destroy_shell_surface(shell);
+            }
+            eprintln!("WMLAYER gone namespace={}", entry.namespace);
+            self.layers_workarea();
+            self.refresh_pointer();
+        }
+    }
+}
+
+impl WlrLayerShellHandler for Server {
+    fn shell_state(&mut self) -> &mut WlrLayerShellState {
+        &mut self.layer_shell
+    }
+    fn new_layer_surface(&mut self, surface: LayerSurface, _output: Option<WlOutput>, layer: Layer, namespace: String) {
+        eprintln!("WMLAYER new namespace={namespace} layer={layer:?}");
+        self.layers.push(LayerEntry {
+            surface,
+            namespace,
+            rect: Rect::new(Point::new(0, 0), Size::new(1, 1)),
+            shell: None,
+            above: matches!(layer, Layer::Top | Layer::Overlay),
+            exclusive: None,
+        });
+    }
+    fn new_popup(&mut self, _parent: LayerSurface, popup: PopupSurface) {
+        self.popup_adopted(popup);
+    }
+    fn layer_destroyed(&mut self, surface: LayerSurface) {
+        self.layer_gone(surface.wl_surface());
+    }
+}
