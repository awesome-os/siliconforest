+        }
+        self.swipe(SwipePhase::Update, 3, i16::from(wheel) * 24, 0, time);
+        self.gesture.wheel_until = Some(Instant::now() + std::time::Duration::from_millis(250));
+    }
+    /// Every frame: the spring after a release.
+    pub fn gesture_tick(&mut self) {
+        if self.gesture.wheel_until.is_some_and(|until| Instant::now() >= until) {
+            self.gesture.wheel_until = None;
+            self.swipe(SwipePhase::End, 3, 0, 0, 0);
+        }
+        let Some(mut spring) = self.gesture.spring else { return };
+        let now = Instant::now();
+        let dt = now.duration_since(self.gesture.last).as_secs_f64().min(0.1);
+        self.gesture.last = now;
+        let settled = spring.advance(dt);
+        self.gesture.position = spring.position;
+        if settled {
+            self.gesture.spring = None;
+            self.finish_slide(Some(spring.target));
+        } else {
+            self.gesture.spring = Some(spring);
+            self.show_slide();
+        }
+    }
+    fn show_slide(&mut self) {
+        let Some((origin, previous, next)) = self.gesture.origin else { return };
+        let width = self.wm.backend().screen_size().w as f64;
+        let offset = (-self.gesture.position * width).round() as i32;
+        let windows_on = |server: &Server, space: usize| -> Vec<u64> {
+            server.wm.iter_clients().filter(|(_, c)| c.workspace == space && !c.flags.contains(wm_core::ClientFlags::STICKY)).map(|(_, c)| c.window).collect()
+        };
+        let current = windows_on(self, origin);
