+#[test]
+#[ignore]
+fn the_dock_comes_up_on_layer_shell_and_sees_the_windows() {
+    let dock = std::env::var("CHONK_DOCK_BIN").expect("CHONK_DOCK_BIN");
+    let runtime = tempfile::tempdir().unwrap();
+    let socket = runtime.path().join("wayland-test");
+    let (result_tx, result_rx) = mpsc::channel();
+    let socket_for_server = socket.clone();
+    let server = thread::spawn(move || {
+        let mut display = Display::<Server>::new().unwrap();
+        let mut state = Server::new(&display.handle(), PANEL).unwrap();
+        state.set_scale(Scale::from_120(120).unwrap()).unwrap();
+        state.enable_sfhid_seat(&display.handle()).unwrap();
+        state.enable_desktop_shell_with(fonts(), None).unwrap();
+        let listener = ListeningSocket::bind_absolute(socket_for_server).unwrap();
+        let mut out = Memory(None);
+        let started = Instant::now();
+        let mut report = String::new();
+        while started.elapsed() < Duration::from_secs(25) {
+            while let Ok(Some(stream)) = listener.accept() {
+                Server::add_client(&mut display, stream).unwrap();
+            }
+            display.dispatch_clients(&mut state).unwrap();
+            state.capture_step();
+            state.foreign_sync();
+            state.repaint(&mut out, started.elapsed().as_millis() as u32).unwrap();
+            display.flush_clients().unwrap();
+            thread::sleep(Duration::from_millis(8));
+            if started.elapsed() > Duration::from_secs(20) && report.is_empty() {
+                report = state.layer_report();
+                let pixmap = state.wm.backend_mut().render_for_capture().unwrap();
+                if let Ok(path) = std::env::var("CHONK_DOCK_PICTURE") {
+                    pixmap.save_png(path).unwrap();
+                }
+                break;
+            }
+        }
+        result_tx.send(report).unwrap();
+    });
+    thread::sleep(Duration::from_millis(500));
+    let xdg_state = tempfile::tempdir().unwrap();
+    // The desk's dock items (CHONK_DOCK_ITEMS=<dir with applications/ and dock-pins>).
+    let data = tempfile::tempdir().unwrap();
+    if let Ok(items) = std::env::var("CHONK_DOCK_ITEMS") {
+        let apps = data.path().join("applications");
+        std::fs::create_dir_all(&apps).unwrap();
+        for entry in std::fs::read_dir(format!("{items}/applications")).unwrap() {
+            let entry = entry.unwrap();
+            std::fs::copy(entry.path(), apps.join(entry.file_name())).unwrap();
+        }
+        std::fs::create_dir_all(xdg_state.path().join("chonkstep")).unwrap();
+        std::fs::copy(format!("{items}/dock-pins"), xdg_state.path().join("chonkstep/dock")).unwrap();
+    }
+    let mut child = Command::new(dock)
+        .arg("--wayland")
+        .env("WAYLAND_DISPLAY", &socket)
+        .env("XDG_RUNTIME_DIR", runtime.path())
+        .env("XDG_STATE_HOME", xdg_state.path())
+        .env("XDG_DATA_DIRS", data.path())
+        .env("XDG_DATA_HOME", data.path())
+        .stdout(Stdio::null())
+        .stderr(Stdio::inherit())
+        .spawn()
+        .unwrap();
+    let _ = UnixStream::connect(&socket);
+    let report = result_rx.recv_timeout(Duration::from_secs(60)).unwrap();
+    let _ = child.kill();
+    let _ = child.wait();
+    server.join().unwrap();
+    eprintln!("{report}");
+    assert!(report.contains("namespace=chonk-dock "), "{report}");
+    assert!(report.contains("workarea="), "{report}");
+}
