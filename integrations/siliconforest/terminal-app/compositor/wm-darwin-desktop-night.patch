+            next.map(|space| (windows_on(self, space), offset + width as i32)).unwrap_or_default()
+        } else if self.gesture.position < 0.0 {
+            previous.map(|space| (windows_on(self, space), offset - width as i32)).unwrap_or_default()
+        } else {
