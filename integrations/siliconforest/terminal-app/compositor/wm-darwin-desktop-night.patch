+/// What the standalone (Darwin) desk carries out from the keyboard: the
+/// window manager's own verbs. Programs are started only through the managed
+/// launcher (`SpawnTerminal`), so `run <command>`, reload and restart have no
+/// place here; nor have the second-monitor verbs on a single panel.
+pub fn standalone_darwin_supports(action: &Action) -> bool {
+    use wm_config::CaptureMode as C;
+    match action {
+        Action::Capture(mode) => matches!(mode, C::Screen | C::ScreenClipboard | C::Window | C::WindowClipboard | C::Area | C::AreaClipboard),
+        Action::Run(_) | Action::Reload | Action::Restart | Action::GlobalShortcut(_)
+        | Action::FocusMonitor(_) | Action::MoveWorkspaceToMonitor(_) | Action::ToggleOpaque
+        | Action::ForceQuitApplications => false,
+        _ => true,
+    }
+}
+
+/// The standalone desk's keys: the owner's Linux table, i.e. the Omarchy
+/// keymap (`wm_config::preset::omarchy_keybindings`, what `desktop =
+/// "omarchy"` selects) with Super being the Mac keyboard's Command key,
+/// limited to what the standalone desk carries out; the owner's own override
+/// (Super-O: Overview); Command-Space for the desktop menu (the launcher on
+/// this desk); and the Mac profile's global commands
+/// (`wm_config::preset::MAC_BINDINGS`) on chords the Omarchy table leaves
+/// free: Command-Q quits the application, Command-M miniaturizes, Command-H
+/// hides, Command-grave cycles an application's windows. The Mac profile's
+/// Control-arrows, F3 and F11 are left out: the owner's Linux table does not
+/// take them from applications.
+pub fn standalone_darwin_keybindings() -> Vec<(KeyCombo, Action)> {
+    let mut out: Vec<(KeyCombo, Action)> = Vec::new();
+    let put = |out: &mut Vec<(KeyCombo, Action)>, combo: KeyCombo, action: Action, replace: bool| {
+        if let Some(slot) = out.iter_mut().find(|(c, _)| *c == combo) {
+            if replace { slot.1 = action; }
+        } else {
+            out.push((combo, action));
+        }
+    };
+    for (combo, action) in wm_config::preset::omarchy_keybindings() {
+        if standalone_darwin_supports(&action) {
+            put(&mut out, combo, action, false);
+        }
+    }
+    let key = |spec: &str| wm_config::parse_key(spec).unwrap_or_else(|| panic!("standalone key spec {spec:?} must parse"));
+    put(&mut out, key("super+o"), Action::Overview, true);
+    put(&mut out, key("super+space"), Action::RootMenu, true);
+    put(&mut out, key("super+return"), Action::SpawnTerminal, true);
+    // The Linux capture toolbar (Command-Control-Shift-5) is not built here: the chord takes
+    // the focused window instead, one of the toolbar's modes.
+    put(&mut out, key("super+ctrl+shift+5"), Action::Capture(wm_config::CaptureMode::Window), true);
+    let skip = ["ctrl+up", "ctrl+down", "ctrl+left", "ctrl+right", "f3", "f11", "cmd+f3"].map(key);
+    for (combo, action) in wm_config::preset::mac_keybindings(wm_config::preset::Desktop::Chonkstep) {
+        if standalone_darwin_supports(&action) && !skip.contains(&combo) {
+            put(&mut out, combo, action, false);
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod standalone_darwin_key_tests {
+    #[test]
+    fn the_standalone_key_table_builds() {
+        let table = super::standalone_darwin_keybindings();
+        assert!(table.len() > 40, "{}", table.len());
+        let state = super::SessionState::standalone_darwin();
+        assert!(state.interaction.spaces_mode());
+    }
+}
+
+#[cfg(test)]
+mod standalone_darwin_key_dump {
+    /// `cargo test -p chonk-shell standalone_key_table_dump -- --ignored --nocapture`: the table.
+    #[test]
+    #[ignore]
+    fn standalone_key_table_dump() {
+        for (combo, action) in super::standalone_darwin_keybindings() {
+            println!("KEY {:?} {:#x} {:?}", combo.modifiers, combo.keysym, action);
+        }
+    }
+}
