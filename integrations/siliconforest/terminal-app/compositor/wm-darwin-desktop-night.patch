-//! Multi-finger swipes on the desktop (see `crate::hid::Event::Swipe`).
+//! Multi-finger swipes on the desktop (`crate::hid::Event::Swipe`), ported from the Linux
+//! session (`wm-wayland/src/input/gestures.rs`, `gesture_scene.rs`, docs/gestures.md):
+//! three- and four-finger horizontal swipes move between Spaces, the desk following the
+//! fingers (the current Space slides out, its neighbour in) and settling with the same
+//! velocity projection and critically damped spring (`wm_core::gesture_physics`); lift
+//! before halfway to stay, beyond it (or with a flick) to go; a missing neighbour resists
+//! elastically. Up opens Overview, down closes it (here without the Linux morph: it opens
+//! or closes when the swipe ends). Swipes are physical directions: natural scrolling does
+//! not turn them. The recognizer (axis lock, jitter, velocity) is wm-core's `SwipeTracker`,
+//! the Linux one. Two-finger swipes are not the desktop's: they are scrolling.
 use crate::hid::SwipePhase;
 use crate::server::Server;
+use std::time::Instant;
+use wm_core::{Backend, gesture_physics as physics, GestureConfig, SwipeAxis, SwipeMotion, SwipeTracker};
 
+/// The windows drawn displaced while a horizontal swipe is held or settling.
+#[derive(Clone, Debug, Default)]
+pub struct Slide {
+    /// Panel pixels the current Space is moved by (negative: to the left).
+    pub offset: i32,
+    pub current: Vec<u64>,
+    /// The neighbour coming in, and where it is drawn relative to its own place.
+    pub neighbour: Vec<u64>,
+    pub neighbour_offset: i32,
+}
+
+pub struct Gesture {
+    tracker: SwipeTracker,
+    /// Set when the horizontal axis locks: the Space it started on and its neighbours.
+    origin: Option<(usize, Option<usize>, Option<usize>)>,
+    position: f64,
+    velocity: f64,
+    spring: Option<physics::Spring>,
+    last: Instant,
+    vertical: Option<SwipeMotion>,
+    pub swipes: u64,
+    pub switches: u64,
+    /// The stand-in for the swipe while the trackpad driver reports no multi-finger swipes:
+    /// Control-Command with a two-finger scroll (`wheel_swipe`). When the scroll stops, the swipe ends.
+    wheel_until: Option<Instant>,
+}
+
+impl Default for Gesture {
+    fn default() -> Self {
+        Self { tracker: SwipeTracker::default(), origin: None, position: 0.0, velocity: 0.0, spring: None, last: Instant::now(), vertical: None, swipes: 0, switches: 0, wheel_until: None }
