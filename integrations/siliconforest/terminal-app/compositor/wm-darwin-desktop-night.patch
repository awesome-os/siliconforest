+//! The real Chonkstep dock (`chonk-dock`, built for this host) against this compositor's server
+//! on a socket: it must come up through zwlr_layer_shell_v1 (its column, Clip and launcher strip
+//! drawn above the windows, the column's exclusive zone keeping windows out), bind the
+//! foreign-toplevel list, and see a window (its running indicator). Needs the dock binary:
+//! `CHONK_DOCK_BIN=<path> cargo test -p wm-darwin --features desktop-shell --test dock_host -- --ignored`.
+//! `CHONK_DOCK_PICTURE=<file.png>` keeps the frame.
+#![cfg(all(feature = "darwin-backend", feature = "desktop-shell"))]
+use std::{
+    os::unix::net::UnixStream,
+    process::{Command, Stdio},
+    sync::mpsc,
+    thread,
+    time::{Duration, Instant},
+};
+use wm_core::Size;
+use wm_darwin::scale::Scale;
+use wm_darwin::server::Server;
+use wm_darwin::smithay::reexports::wayland_server::{Display, ListeningSocket};
+
+const PANEL: Size = Size { w: 1280, h: 800 };
+
+struct Memory(Option<tiny_skia::Pixmap>);
+impl wm_darwin::presenter::Presenter for Memory {
+    fn present(&mut self, frame: &tiny_skia::Pixmap) -> Result<(), String> {
+        self.0 = Some(frame.clone());
+        Ok(())
+    }
+}
+fn fonts() -> wm_theme::FontState {
+    let read = |name: &str| std::fs::read(format!("/usr/share/fonts/TTF/{name}")).expect("DejaVu Sans is installed on the test host");
+    wm_theme::FontState::from_packaged_fonts(read("DejaVuSans.ttf"), read("DejaVuSans-Bold.ttf")).unwrap()
+}
