diff --git a/crates/wm-darwin/src/foreign.rs b/crates/wm-darwin/src/foreign.rs
new file mode 100644
index 0000000..7f3ba67
--- /dev/null
+++ b/crates/wm-darwin/src/foreign.rs
@@ -0,0 +1,178 @@
+//! `zwlr_foreign_toplevel_management_v1`: the windows of the desk, told to a program that shows
+//! them (the Chonkstep dock: running indicators, a click that brings an application's window
+//! forward), with activate, close and minimize from it. The Linux session serves the same
+//! protocol (`wm-wayland/src/protocols.rs`); this is a small server of its own for this
+//! compositor: the list is brought up to date once a frame from wm-core's managed windows
+//! (title, app id, activated, minimized, maximized, full screen), and requests go to wm-core
+//! as the frame's buttons and the keys send them.
+use std::collections::HashMap;
+
+use smithay::reexports::wayland_protocols_wlr::foreign_toplevel::v1::server::{
+    zwlr_foreign_toplevel_handle_v1::{self as handle, ZwlrForeignToplevelHandleV1},
+    zwlr_foreign_toplevel_manager_v1::{self as manager, ZwlrForeignToplevelManagerV1},
+};
+use smithay::reexports::wayland_server::{
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource, backend::GlobalId,
+};
+use wm_core::{BackendEvent, ClientFlags, Lifecycle, NetState, NetStateAction};
+
+use crate::server::Server;
+
+#[derive(Clone, PartialEq, Eq, Default)]
+struct Shown {
+    title: String,
+    app_id: String,
+    states: Vec<u8>,
+}
+
+struct Listener {
+    manager: ZwlrForeignToplevelManagerV1,
+    handles: HashMap<u64, (ZwlrForeignToplevelHandleV1, Shown)>,
+}
+
+#[derive(Default)]
+pub struct ForeignToplevels {
+    listeners: Vec<Listener>,
+    global: Option<GlobalId>,
+}
+
+impl ForeignToplevels {
+    pub fn create_global(&mut self, dh: &DisplayHandle) {
+        self.global = Some(dh.create_global::<Server, ZwlrForeignToplevelManagerV1, ()>(3, ()));
+    }
+}
+
+fn states_bytes(states: &[handle::State]) -> Vec<u8> {
+    states.iter().flat_map(|s| (*s as u32).to_ne_bytes()).collect()
+}
+
+impl Server {
+    pub fn foreign_listener_count(&self) -> usize {
+        self.foreign.listeners.len()
+    }
+    /// What every listener should know now, per managed window.
+    fn foreign_now(&self) -> Vec<(u64, Shown)> {
+        let focused = self.wm.focused_client();
+        self.wm
+            .iter_clients()
+            .filter(|(_, c)| matches!(c.lifecycle, Lifecycle::Normal | Lifecycle::Miniaturized))
+            .filter_map(|(id, c)| {
+                let w = self.wm.backend().windows.get(&c.window)?;
+                let mut states = Vec::new();
+                if focused == Some(id) {
+                    states.push(handle::State::Activated);
+                }
+                if c.lifecycle == Lifecycle::Miniaturized {
+                    states.push(handle::State::Minimized);
+                }
+                if c.flags.contains(ClientFlags::MAXIMIZED_H | ClientFlags::MAXIMIZED_V) {
+                    states.push(handle::State::Maximized);
+                }
+                if c.flags.contains(ClientFlags::FULLSCREEN) {
+                    states.push(handle::State::Fullscreen);
+                }
+                Some((c.window, Shown { title: w.title.clone().unwrap_or_default(), app_id: w.app_id.clone().unwrap_or_default(), states: states_bytes(&states) }))
+            })
+            .collect()
+    }
+    /// Once a frame: new windows, changes, windows gone.
+    pub fn foreign_sync(&mut self) {
+        if self.foreign.listeners.is_empty() {
+            return;
+        }
+        let now = self.foreign_now();
+        let dh = self.display_handle.clone();
+        for listener in &mut self.foreign.listeners {
+            if !listener.manager.is_alive() {
+                continue;
+            }
+            listener.handles.retain(|window, (h, _)| {
+                let keep = now.iter().any(|(w, _)| w == window);
+                if !keep && h.is_alive() {
+                    h.closed();
+                }
+                keep
+            });
+            for (window, shown) in &now {
+                match listener.handles.get_mut(window) {
+                    Some((h, sent)) => {
+                        if sent == shown {
+                            continue;
+                        }
+                        if sent.title != shown.title {
+                            h.title(shown.title.clone());
+                        }
+                        if sent.app_id != shown.app_id {
+                            h.app_id(shown.app_id.clone());
+                        }
+                        if sent.states != shown.states {
+                            h.state(shown.states.clone());
+                        }
+                        h.done();
+                        *sent = shown.clone();
+                    }
+                    None => {
+                        let Some(client) = listener.manager.client() else { continue };
+                        let Ok(h) = client.create_resource::<ZwlrForeignToplevelHandleV1, u64, Server>(&dh, listener.manager.version(), *window) else { continue };
+                        listener.manager.toplevel(&h);
+                        h.title(shown.title.clone());
+                        h.app_id(shown.app_id.clone());
+                        h.state(shown.states.clone());
+                        h.done();
+                        listener.handles.insert(*window, (h, shown.clone()));
+                    }
+                }
+            }
+        }
+        self.foreign.listeners.retain(|l| l.manager.is_alive());
+    }
+}
+
+impl GlobalDispatch<ZwlrForeignToplevelManagerV1, ()> for Server {
+    fn bind(state: &mut Self, _: &DisplayHandle, _: &Client, resource: New<ZwlrForeignToplevelManagerV1>, _: &(), data: &mut DataInit<'_, Self>) {
+        let manager = data.init(resource, ());
+        eprintln!("WMFOREIGN listener bound");
+        // the next frame's sync tells it every window
+        state.foreign.listeners.push(Listener { manager, handles: HashMap::new() });
+    }
+}
+
+impl Dispatch<ZwlrForeignToplevelManagerV1, ()> for Server {
+    fn request(state: &mut Self, _: &Client, resource: &ZwlrForeignToplevelManagerV1, request: manager::Request, _: &(), _: &DisplayHandle, _: &mut DataInit<'_, Self>) {
+        if let manager::Request::Stop = request {
+            resource.finished();
+            state.foreign.listeners.retain(|l| l.manager != *resource);
+        }
+    }
+}
+
+impl Dispatch<ZwlrForeignToplevelHandleV1, u64> for Server {
+    fn request(state: &mut Self, _: &Client, _: &ZwlrForeignToplevelHandleV1, request: handle::Request, window: &u64, _: &DisplayHandle, _: &mut DataInit<'_, Self>) {
+        let window = *window;
+        if !state.wm.backend().windows.contains_key(&window) {
+            return;
+        }
+        let net = |state: &mut Self, action, first| state.wm.dispatch(BackendEvent::NetStateRequested { window, action, first, second: None });
+        match request {
+            handle::Request::Activate { .. } => {
+                // Another Space: go there first (an activation brings the window to the person).
+                if let Some(client) = state.wm.client_for_window(window) {
+                    if let Some(space) = state.wm.client(client).map(|c| c.workspace) {
+                        if space != state.wm.current_workspace() {
+                            state.wm.switch_workspace(space);
+                        }
+                    }
+                }
+                state.wm.dispatch(BackendEvent::ActivateRequested(window));
+            }
+            handle::Request::Close => state.wm.dispatch(BackendEvent::CloseRequested(window)),
+            handle::Request::SetMinimized => state.wm.dispatch(BackendEvent::MinimizeRequest(window)),
+            handle::Request::UnsetMinimized => state.wm.dispatch(BackendEvent::ActivateRequested(window)),
+            handle::Request::SetMaximized => state.wm.dispatch(BackendEvent::NetStateRequested { window, action: NetStateAction::Add, first: NetState::MaximizedHorz, second: Some(NetState::MaximizedVert) }),
+            handle::Request::UnsetMaximized => state.wm.dispatch(BackendEvent::NetStateRequested { window, action: NetStateAction::Remove, first: NetState::MaximizedHorz, second: Some(NetState::MaximizedVert) }),
+            handle::Request::SetFullscreen { .. } => net(state, NetStateAction::Add, NetState::Fullscreen),
+            handle::Request::UnsetFullscreen => net(state, NetStateAction::Remove, NetState::Fullscreen),
+            _ => {}
+        }
+    }
+}
