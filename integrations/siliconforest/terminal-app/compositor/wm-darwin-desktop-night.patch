diff --git a/crates/wm-darwin/src/activation.rs b/crates/wm-darwin/src/activation.rs
new file mode 100644
index 0000000..47862aa
--- /dev/null
+++ b/crates/wm-darwin/src/activation.rs
@@ -0,0 +1,47 @@
+//! `xdg_activation_v1`: an application asks for one of its windows to come forward (AppKit's
+//! -makeKeyAndOrderFront: through libWindowServer: Command-`, the Window menu, a new window of
+//! the active application, un-minimising). The rule against stealing focus: the token must have
+//! been asked for by the client that has the keyboard now (its focused window's client), or carry
+//! the serial of an input event no older than ten seconds; anything else is refused and logged.
+//! The window then comes forward as an activation from a pager does (wm-core's
+//! ActivateRequested: deminiaturize, focus, raise), on its own Space (which is shown).
+use smithay::reexports::wayland_server::{protocol::wl_surface::WlSurface, Resource};
+use smithay::wayland::xdg_activation::{XdgActivationHandler, XdgActivationState, XdgActivationToken, XdgActivationTokenData};
+use wm_core::BackendEvent;
+
+use crate::server::Server;
+
+impl XdgActivationHandler for Server {
+    fn activation_state(&mut self) -> &mut XdgActivationState {
+        &mut self.activation
+    }
+    fn request_activation(&mut self, token: XdgActivationToken, data: XdgActivationTokenData, surface: WlSurface) {
+        let Some(window) = self.wm.backend().window_for_surface(&surface) else {
+            self.activation.remove_token(&token);
+            return;
+        };
+        let focused_client = self
+            .wm
+            .focused_client()
+            .and_then(|id| self.wm.client(id))
+            .and_then(|c| self.wm.backend().windows.get(&c.window))
+            .and_then(|w| w.surface.wl_surface().client())
+            .map(|c| c.id());
+        let from_focused = data.client_id.is_some() && data.client_id == focused_client;
+        let recent = data.serial.is_some() && data.timestamp.elapsed() < std::time::Duration::from_secs(10);
+        let allowed = from_focused || recent;
+        eprintln!("WMACTIVATE window={window} from_focused_client={from_focused} recent_serial={recent} allowed={allowed}");
+        if allowed {
+            if let Some(client) = self.wm.client_for_window(window) {
+                if let Some(space) = self.wm.client(client).map(|c| c.workspace) {
+                    if space != self.wm.current_workspace() {
+                        self.wm.switch_workspace(space);
+                    }
+                }
+            }
+            self.wm.dispatch(BackendEvent::ActivateRequested(window));
+        }
+        self.activation.remove_token(&token);
+    }
+}
+smithay::delegate_xdg_activation!(Server);
