+        backend.slide = Some(Slide { offset, current, neighbour, neighbour_offset });
+        backend.dirty = true;
+    }
+    fn clear_slide(&mut self) {
+        let backend = self.wm.backend_mut();
+        if backend.slide.take().is_some() {
+            backend.dirty = true;
+        }
+        self.gesture.origin = None;
+        self.gesture.position = 0.0;
+    }
+    /// The swipe is over: go to the Space it settled on (one step at most) and draw
+    /// everything in its place again.
+    fn finish_slide(&mut self, target: Option<f64>) {
+        let origin = self.gesture.origin;
+        self.clear_slide();
+        let (Some((from, previous, next)), Some(target)) = (origin, target) else { return };
+        let to = if target > 0.5 { next } else if target < -0.5 { previous } else { None };
