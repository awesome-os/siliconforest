+                self.wm.switch_workspace(to);
+                self.gesture.switches += 1;
+                #[cfg(feature = "desktop-shell")]
+                let _ = self.service_desktop();
+            }
+        }
+        eprintln!("WMGESTURE settled target={target} space={}", self.wm.current_workspace() + 1);
     }
 }
