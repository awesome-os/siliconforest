index 0000000..6a373e0
--- /dev/null
+++ b/crates/wm-darwin/src/capture.rs
@@ -0,0 +1,486 @@
+//! Screenshots: a feature of the desktop, separate from the test-only inject module.
+//!
+//! What starts a capture, and nothing else:
+//! - the desktop's own keys (`Action::Capture`, bound as on the owner's Linux session:
+//!   Command-Control-Shift-3 the screen, -4 an area, Command-Shift-... see the hand-over doc), and
+//! - a request on the socket `capture` in the session's runtime directory (`screencapture`,
+//!   the compositor binary run with `--screencapture`). The directory is the session's own
+//!   (mode 0700, root's); the socket is mode 0600, and a connection is served only when the
+//!   peer's effective uid (`getpeereid`) is the compositor's own. No file anywhere can start
+//!   a capture: a request is a live connection from a process of the desktop's own user.
+//!
+//! The picture is the scene as the compositor composes it, without the pointer. Keyed captures
+//! are saved as PNG to `$HOME/Pictures/Screenshots` (mode 0600, never replacing a file) and put
+//! on the clipboard as `image/png` (the `...Clipboard` variants: the clipboard only), as the
+//! Linux session does in desktop mode; a notice says where it went. A socket request gets the
+//! PNG back on the connection; the client writes the file.
+use crate::server::Server;
+use std::collections::VecDeque;
+use std::io::{Read, Write};
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::os::unix::io::AsRawFd;
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+use wm_core::{Backend, Point, Rect, Size};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Target {
+    Screen,
+    Window,
+    Area(Rect),
+}
+
+pub(crate) struct Request {
+    target: Target,
+    file: bool,
+    clipboard: bool,
+    reply: Option<UnixStream>,
+}
+
+struct AreaSelect {
+    file: bool,
+    clipboard: bool,
+    start: Option<Point>,
+    outline: Vec<u64>,
+}
+
+struct Client {
+    stream: UnixStream,
+    line: Vec<u8>,
+    since: Instant,
+}
+
+#[derive(Default)]
+pub struct Captures {
+    pending: VecDeque<Request>,
+    area: Option<AreaSelect>,
+    listener: Option<UnixListener>,
+    clients: Vec<Client>,
+    pub taken: u64,
+}
+
+impl Captures {
+    /// The request socket, in the session's runtime directory.
+    pub fn listen(&mut self, path: &Path) -> Result<(), String> {
+        let _ = std::fs::remove_file(path);
+        let listener = UnixListener::bind(path).map_err(|e| format!("capture socket {}: {e}", path.display()))?;
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600)).map_err(|e| e.to_string())?;
+        listener.set_nonblocking(true).map_err(|e| e.to_string())?;
+        eprintln!("WMCAPTURE socket={} (peer uid must be {})", path.display(), unsafe { libc::geteuid() });
+        self.listener = Some(listener);
+        Ok(())
+    }
+    pub fn selecting(&self) -> bool {
+        self.area.is_some()
+    }
+}
+
+#[cfg(not(target_os = "linux"))]
+fn peer_uid(stream: &UnixStream) -> Option<u32> {
+    let (mut uid, mut gid) = (0 as libc::uid_t, 0 as libc::gid_t);
+    (unsafe { libc::getpeereid(stream.as_raw_fd(), &mut uid, &mut gid) } == 0).then_some(uid)
+}
+/// (Host tests on Linux: the same question through SO_PEERCRED.)
+#[cfg(target_os = "linux")]
+fn peer_uid(stream: &UnixStream) -> Option<u32> {
+    let mut cred: libc::ucred = unsafe { std::mem::zeroed() };
+    let mut len = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    (unsafe { libc::getsockopt(stream.as_raw_fd(), libc::SOL_SOCKET, libc::SO_PEERCRED, (&mut cred as *mut libc::ucred).cast(), &mut len) } == 0).then_some(cred.uid)
+}
+
+/// One request line: `screen`, `window`, or `rect <x> <y> <w> <h>` (panel pixels).
+fn parse_request(line: &str) -> Option<Target> {
+    let words: Vec<&str> = line.split_whitespace().collect();
+    match words.as_slice() {
+        ["screen"] => Some(Target::Screen),
+        ["window"] => Some(Target::Window),
+        ["rect", x, y, w, h] => {
+            let (x, y, w, h) = (x.parse().ok()?, y.parse().ok()?, w.parse::<u32>().ok()?, h.parse::<u32>().ok()?);
+            (w > 0 && h > 0).then(|| Target::Area(Rect::new(Point::new(x, y), Size::new(w, h))))
+        }
+        _ => None,
+    }
+}
+
+fn local_stamp() -> String {
+    let now = unsafe { libc::time(std::ptr::null_mut()) };
+    let mut tm: libc::tm = unsafe { std::mem::zeroed() };
+    unsafe { libc::localtime_r(&now, &mut tm) };
+    format!("{:04}-{:02}-{:02} at {:02}.{:02}.{:02}", tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec)
+}
+
+fn screenshot_dir() -> PathBuf {
+    let home = std::env::var_os("HOME").map(PathBuf::from).unwrap_or_else(|| PathBuf::from("/var/root"));
+    home.join("Pictures").join("Screenshots")
+}
+
+/// Writes the PNG as a new file (never replacing one), owner-only.
+fn save(png: &[u8]) -> Result<PathBuf, String> {
+    let dir = screenshot_dir();
+    std::fs::create_dir_all(&dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    let stamp = local_stamp();
+    for n in 0..100 {
+        let name = if n == 0 { format!("Screenshot {stamp}.png") } else { format!("Screenshot {stamp} ({n}).png") };
+        let path = dir.join(name);
+        match std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(&path) {
+            Ok(mut file) => {
+                file.write_all(png).map_err(|e| format!("{}: {e}", path.display()))?;
+                return Ok(path);
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => continue,
+            Err(e) => return Err(format!("{}: {e}", path.display())),
+        }
+    }
+    Err("no free file name".into())
+}
+
+/// RGBA (premultiplied, opaque scene) -> PNG RGB8, cropped to `rect`.
+pub fn encode_png(pixmap: &tiny_skia::Pixmap, rect: Rect) -> Result<Vec<u8>, String> {
+    let (w, h) = (rect.size.w, rect.size.h);
+    let stride = pixmap.width() as usize * 4;
+    let data = pixmap.data();
+    let mut rgb = Vec::with_capacity(w as usize * h as usize * 3);
+    for y in 0..h as usize {
+        let row = (rect.pos.y as usize + y) * stride + rect.pos.x as usize * 4;
+        for px in data[row..row + w as usize * 4].chunks_exact(4) {
+            rgb.extend_from_slice(&px[..3]);
+        }
+    }
+    let mut out = Vec::new();
+    {
+        let mut encoder = png::Encoder::new(&mut out, w, h);
+        encoder.set_color(png::ColorType::Rgb);
+        encoder.set_depth(png::BitDepth::Eight);
+        encoder.set_compression(png::Compression::Fast);
+        let mut writer = encoder.write_header().map_err(|e| e.to_string())?;
+        writer.write_image_data(&rgb).map_err(|e| e.to_string())?;
+    }
+    Ok(out)
+}
+
+fn clip(rect: Rect, screen: Size) -> Option<Rect> {
+    let x0 = rect.pos.x.clamp(0, screen.w as i32);
+    let y0 = rect.pos.y.clamp(0, screen.h as i32);
+    let x1 = (rect.pos.x + rect.size.w as i32).clamp(0, screen.w as i32);
+    let y1 = (rect.pos.y + rect.size.h as i32).clamp(0, screen.h as i32);
+    (x1 > x0 && y1 > y0).then(|| Rect::new(Point::new(x0, y0), Size::new((x1 - x0) as u32, (y1 - y0) as u32)))
+}
+
+impl Server {
+    /// A capture key (`Action::Capture`). Area: the next drag of the pointer selects it.
+    pub(crate) fn capture_key(&mut self, mode: wm_config::CaptureMode) {
+        use wm_config::CaptureMode as C;
+        let (file, clipboard) = match mode {
+            C::ScreenClipboard | C::AreaClipboard | C::WindowClipboard => (false, true),
+            _ => (true, true),
+        };
+        match mode {
+            C::Screen | C::ScreenClipboard => self.captures.pending.push_back(Request { target: Target::Screen, file, clipboard, reply: None }),
+            C::Window | C::WindowClipboard => self.captures.pending.push_back(Request { target: Target::Window, file, clipboard, reply: None }),
+            C::Area | C::AreaClipboard => {
+                if self.captures.area.is_none() {
+                    self.captures.area = Some(AreaSelect { file, clipboard, start: None, outline: Vec::new() });
+                    self.capture_notice("Drag to select an area; Escape cancels");
+                }
+            }
+            C::Toolbar | C::Stop => {}
+        }
+        eprintln!("WMCAPTURE key mode={mode:?}");
+    }
+    fn capture_notice(&mut self, text: &str) {
+        #[cfg(feature = "desktop-shell")]
+        if let Some(desktop) = self.desktop.as_mut() {
+            desktop.shell.notify(&mut self.wm, text);
+        }
+        #[cfg(not(feature = "desktop-shell"))]
+        let _ = text;
+    }
+    fn area_outline(&mut self, rect: Option<Rect>) {
+        let Some(area) = self.captures.area.as_mut() else { return };
+        let old = std::mem::take(&mut area.outline);
+        let backend = self.wm.backend_mut();
+        for id in old {
+            backend.destroy_shell_surface(id);
+        }
+        let Some(r) = rect else { return };
+        let t = 2u32;
+        let (x, y, w, h) = (r.pos.x, r.pos.y, r.size.w.max(1), r.size.h.max(1));
+        let edges = [
+            Rect::new(Point::new(x, y), Size::new(w, t)),
+            Rect::new(Point::new(x, y + h as i32 - t as i32), Size::new(w, t)),
+            Rect::new(Point::new(x, y), Size::new(t, h)),
+            Rect::new(Point::new(x + w as i32 - t as i32, y), Size::new(t, h)),
+        ];
+        let mut ids = Vec::new();
+        for edge in edges {
+            if let Some(id) = backend.create_shell_surface(edge, (90, 170, 255), true) {
+                backend.map_shell_surface(id);
+                ids.push(id);
+            }
+        }
+        if let Some(area) = self.captures.area.as_mut() {
+            area.outline = ids;
+        }
+    }
+    /// While an area is being selected the pointer and Escape belong to the selection.
+    /// Returns true when the event was taken.
+    pub(crate) fn capture_pointer(&mut self, root: Point, buttons: u8, previous: u8) -> bool {
+        let Some(area) = self.captures.area.as_mut() else { return false };
+        if buttons & !previous & 2 != 0 {
+            self.capture_cancel();
+            return true;
+        }
+        let rect = |a: Point, b: Point| Rect::new(Point::new(a.x.min(b.x), a.y.min(b.y)), Size::new((a.x - b.x).unsigned_abs() + 1, (a.y - b.y).unsigned_abs() + 1));
+        match area.start {
+            None if buttons & !previous & 1 != 0 => {
+                area.start = Some(root);
+                self.area_outline(Some(rect(root, root)));
+            }
+            Some(start) if buttons & 1 != 0 => self.area_outline(Some(rect(start, root))),
+            Some(start) => {
+                let (file, clipboard) = (area.file, area.clipboard);
+                self.area_outline(None);
+                self.captures.area = None;
+                let r = rect(start, root);
+                if r.size.w >= 4 && r.size.h >= 4 {
+                    self.captures.pending.push_back(Request { target: Target::Area(r), file, clipboard, reply: None });
+                } else {
+                    self.capture_notice("Screenshot cancelled");
+                }
+            }
+            None => {}
+        }
+        true
+    }
+    pub(crate) fn capture_cancel(&mut self) {
+        if self.captures.area.is_some() {
+            self.area_outline(None);
+            self.captures.area = None;
+            self.capture_notice("Screenshot cancelled");
+        }
+    }
+    /// Before the repaint: requests from the socket.
+    pub fn capture_step(&mut self) {
+        if let Some(listener) = &self.captures.listener {
+            for _ in 0..4 {
+                match listener.accept() {
+                    Ok((stream, _)) => {
+                        let uid = peer_uid(&stream);
+                        if uid != Some(unsafe { libc::geteuid() }) {
+                            eprintln!("WMCAPTURE refused peer uid={uid:?}");
+                            continue;
+                        }
+                        if stream.set_nonblocking(true).is_ok() && self.captures.clients.len() < 4 {
+                            self.captures.clients.push(Client { stream, line: Vec::new(), since: Instant::now() });
+                        }
+                    }
+                    Err(_) => break,
+                }
+            }
+        }
+        let mut keep = Vec::new();
+        for mut client in std::mem::take(&mut self.captures.clients) {
+            let mut buf = [0u8; 128];
+            match client.stream.read(&mut buf) {
+                Ok(0) => continue,
+                Ok(n) => client.line.extend_from_slice(&buf[..n]),
+                Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {}
+                Err(_) => continue,
+            }
+            if let Some(end) = client.line.iter().position(|b| *b == b'\n') {
+                let text = String::from_utf8_lossy(&client.line[..end]).to_string();
+                // A new terminal window (the dock's Terminal tile): the desktop's own launcher.
+                if text.trim() == "terminal" {
+                    let _ = client.stream.set_nonblocking(false);
+                    let answer = self.request_terminal();
+                    let _ = client.stream.write_all(answer.as_bytes());
+                    continue;
+                }
+                let mut words = text.split_whitespace().collect::<Vec<_>>();
+                let clipboard = words.last() == Some(&"clipboard");
+                if clipboard {
+                    words.pop();
+                }
+                match parse_request(&words.join(" ")) {
+                    Some(target) => {
+                        let _ = client.stream.set_nonblocking(false);
+                        self.captures.pending.push_back(Request { target, file: false, clipboard, reply: Some(client.stream) });
+                    }
+                    None => {
+                        let _ = client.stream.set_nonblocking(false);
+                        let _ = client.stream.write_all(b"error request not understood\n");
+                    }
+                }
+            } else if client.line.len() < 256 && client.since.elapsed() < Duration::from_secs(2) {
+                keep.push(client);
+            }
+        }
+        self.captures.clients = keep;
+    }
+    fn request_terminal(&mut self) -> String {
+        #[cfg(feature = "desktop-shell")]
+        if let Some(desktop) = self.desktop.as_mut() {
+            let outcome = desktop.shell.run_action(&mut self.wm, &wm_config::Action::SpawnTerminal);
+            return match desktop.outcome(outcome) {
+                Ok(()) => { eprintln!("WMCONTROL terminal requested"); "ok\n".into() }
+                Err(e) => format!("error {e}\n"),
+            };
+        }
+        "error no desktop\n".into()
+    }
+    /// After the repaint: carry out what is pending.
+    pub fn capture_after_repaint(&mut self) {
+        while let Some(request) = self.captures.pending.pop_front() {
+            let started = Instant::now();
+            let result = self.capture_one(&request);
+            match (result, request.reply) {
+                (Ok((png, rect)), Some(mut stream)) => {
+                    if request.clipboard {
+                        self.offer_png(Arc::new(png.clone()));
+                    }
+                    let header = format!("ok {} {}x{}\n", png.len(), rect.size.w, rect.size.h);
+                    std::thread::spawn(move || {
+                        let _ = stream.set_write_timeout(Some(Duration::from_secs(10)));
+                        let _ = stream.write_all(header.as_bytes()).and_then(|_| stream.write_all(&png));
+                    });
+                    eprintln!("WMCAPTURE request target={:?} size={}x{} ms={}", request.target, rect.size.w, rect.size.h, started.elapsed().as_millis());
+                }
+                (Ok((png, rect)), None) => {
+                    let saved = if request.file { Some(save(&png)) } else { None };
+                    let png = Arc::new(png);
+                    if request.clipboard {
+                        self.offer_png(png.clone());
+                    }
+                    let text = match &saved {
+                        Some(Ok(path)) => format!("Screenshot saved: {}", path.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default()),
+                        Some(Err(e)) => format!("Screenshot not saved: {e}"),
+                        None => "Screenshot copied to the clipboard".to_string(),
+                    };
+                    self.capture_notice(&text);
+                    self.captures.taken += 1;
+                    eprintln!("WMCAPTURE key target={:?} size={}x{} file={} clipboard={} ms={}", request.target, rect.size.w, rect.size.h,
+                        match &saved { Some(Ok(p)) => p.display().to_string(), Some(Err(e)) => format!("error:{e}"), None => "no".into() }, request.clipboard, started.elapsed().as_millis());
+                }
+                (Err(e), Some(mut stream)) => {
+                    let _ = stream.write_all(format!("error {e}\n").as_bytes());
+                }
+                (Err(e), None) => {
+                    eprintln!("WMCAPTURE failed: {e}");
+                    self.capture_notice(&format!("Screenshot failed: {e}"));
+                }
+            }
+        }
+    }
+    fn capture_one(&mut self, request: &Request) -> Result<(Vec<u8>, Rect), String> {
+        let screen = self.wm.backend().screen_size();
+        let rect = match request.target {
+            Target::Screen => Rect::new(Point::new(0, 0), screen),
+            Target::Area(r) => r,
+            Target::Window => {
+                let id = self.wm.focused_client().ok_or("no window is focused")?;
+                let window = self.wm.client(id).ok_or("no window is focused")?.window;
+                self.wm.backend().window_frame_rect(window).ok_or("the focused window is not on the screen")?
+            }
+        };
+        let rect = clip(rect, screen).ok_or("the area is off the screen")?;
+        let pixmap = self.wm.backend_mut().render_for_capture()?;
+        let png = encode_png(&pixmap, rect)?;
+        Ok((png, rect))
+    }
+    /// The PNG on the clipboard (`image/png`), served by the compositor.
+    fn offer_png(&mut self, png: Arc<Vec<u8>>) {
+        let Some(seat) = self.input.as_ref().map(|i| i.seat.clone()) else { return };
+        smithay::wayland::selection::data_device::set_data_device_selection(&self.display_handle.clone(), &seat, vec!["image/png".into()], Some(png));
+    }
+}
+
+/// `chonkstep-darwin-desktop --screencapture [-c] [-w | -R x,y,w,h] [file]`: a capture from
+/// the running desktop, through its socket (`$XDG_RUNTIME_DIR/capture`). Without a file name
+/// the PNG goes to `$HOME/Pictures/Screenshots`; `-c` puts it on the clipboard instead.
+/// `chonkstep-darwin-desktop --desktop-request terminal`: a new terminal window from the running
+/// desktop (what the dock's Terminal tile runs).
+pub fn request_cli(args: &[String]) -> i32 {
+    if args != ["terminal"] {
+        eprintln!("usage: chonkstep-darwin-desktop --desktop-request terminal");
+        return 2;
+    }
+    let runtime = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from).unwrap_or_else(|| PathBuf::from("/private/var/run/gpu-desktop"));
+    let mut stream = match UnixStream::connect(runtime.join("capture")) {
+        Ok(s) => s,
+        Err(e) => { eprintln!("no desktop answers at {}: {e}", runtime.join("capture").display()); return 1; }
+    };
+    let _ = stream.set_read_timeout(Some(Duration::from_secs(10)));
+    let mut answer = String::new();
+    if stream.write_all(b"terminal\n").is_err() || stream.read_to_string(&mut answer).is_err() {
+        eprintln!("the desktop did not answer");
+        return 1;
+    }
+    if answer.starts_with("ok") { 0 } else { eprintln!("{}", answer.trim()); 1 }
+}
+
+pub fn cli(args: &[String]) -> i32 {
+    let mut target = "screen".to_string();
+    let mut clipboard = false;
+    let mut file: Option<PathBuf> = None;
+    let mut i = 0;
+    while i < args.len() {
+        match args[i].as_str() {
+            "-c" => clipboard = true,
+            "-w" => target = "window".into(),
+            "-R" => {
+                i += 1;
+                let Some(spec) = args.get(i) else { eprintln!("screencapture: -R needs x,y,w,h"); return 2 };
+                target = format!("rect {}", spec.replace(',', " "));
+            }
+            "-h" | "--help" => {
+                eprintln!("usage: screencapture [-c] [-w | -R x,y,w,h] [file.png]\n  the screen of the running desktop (panel pixels, without the pointer);\n  -c: to the clipboard; -w: the focused window; no file: ~/Pictures/Screenshots");
+                return 0;
+            }
+            other if other.starts_with('-') => { eprintln!("screencapture: unknown option {other}"); return 2; }
+            other => file = Some(PathBuf::from(other)),
+        }
+        i += 1;
+    }
+    let runtime = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from).unwrap_or_else(|| PathBuf::from("/private/var/run/gpu-desktop"));
+    let mut stream = match UnixStream::connect(runtime.join("capture")) {
+        Ok(s) => s,
+        Err(e) => { eprintln!("screencapture: no desktop answers at {}: {e}", runtime.join("capture").display()); return 1; }
+    };
+    let _ = stream.set_read_timeout(Some(Duration::from_secs(20)));
+    if stream.write_all(format!("{target}{}\n", if clipboard { " clipboard" } else { "" }).as_bytes()).is_err() {
+        eprintln!("screencapture: the desktop closed the connection");
+        return 1;
+    }
+    let mut reply = Vec::new();
+    if let Err(e) = stream.read_to_end(&mut reply) {
+        eprintln!("screencapture: {e}");
+        return 1;
+    }
+    let Some(end) = reply.iter().position(|b| *b == b'\n') else { eprintln!("screencapture: no answer"); return 1 };
+    let head = String::from_utf8_lossy(&reply[..end]).to_string();
+    let words: Vec<&str> = head.split_whitespace().collect();
+    match words.as_slice() {
+        ["ok", len, size] => {
+            let png = &reply[end + 1..];
+            if len.parse::<usize>().ok() != Some(png.len()) {
+                eprintln!("screencapture: short answer ({} of {len} bytes)", png.len());
+                return 1;
+            }
+            if clipboard && file.is_none() {
+                println!("{size} on the clipboard");
+                return 0;
+            }
+            let written = match &file {
+                Some(path) => std::fs::write(path, png).map(|_| path.clone()).map_err(|e| e.to_string()),
+                None => save(png),
+            };
+            match written {
+                Ok(path) => { println!("{} {size}", path.display()); 0 }
+                Err(e) => { eprintln!("screencapture: {e}"); 1 }
+            }
+        }
+        _ => { eprintln!("screencapture: {head}"); 1 }
+    }
+}
