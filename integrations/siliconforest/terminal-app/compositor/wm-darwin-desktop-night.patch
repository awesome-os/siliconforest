+    /// reports of two fingers today) drive the same swipe between Spaces: each step is 24 units
+    /// of horizontal finger travel (scrolling down: to the next Space, up: to the one before),
+    /// followed on the screen, and released 250 ms after the last step. A stand-in, labelled so:
+    /// the swipe proper needs three or four fingers reported by the trackpad driver.
+    pub(crate) fn wheel_swipe(&mut self, wheel: i8, time: u32) {
+        if self.gesture.wheel_until.is_none() {
