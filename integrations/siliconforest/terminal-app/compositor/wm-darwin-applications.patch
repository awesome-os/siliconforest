+/// The directories whose application bundles the Applications submenu lists.
+pub const APPLICATION_DIRS: [&str; 2] = ["/Applications", "/Applications/Utilities"];
+
+/// The pipe in the session's runtime directory on which the session's listener
+/// (`open --listen`) takes the path of a bundle to open.
+pub const OPEN_REQUESTS: &str = "open-requests";
+
+/// The application bundles (`*.app` directories) of `dirs`, by name; at most
+/// [`APPLICATION_ROWS`].
+pub fn applications_in(dirs: &[&str]) -> Vec<std::path::PathBuf> {
+    let mut found: Vec<std::path::PathBuf> = Vec::new();
+    for dir in dirs {
+        let Ok(entries) = std::fs::read_dir(dir) else { continue };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if path.extension().is_some_and(|e| e == "app") && path.is_dir() {
+                found.push(path);
+            }
+        }
+    }
+    found.sort_by_key(|p| p.file_stem().map(|s| s.to_string_lossy().to_lowercase()));
+    found.truncate(APPLICATION_ROWS);
+    found
+}
+
+/// What the Applications submenu showed last: a row names its place in this list.
+static APPLICATIONS: std::sync::Mutex<Vec<std::path::PathBuf>> = std::sync::Mutex::new(Vec::new());
+
+/// The Applications submenu: one row per bundle in the application directories.
+pub fn application_rows(apps: &[std::path::PathBuf]) -> Vec<MenuItem> {
+    if apps.is_empty() {
+        return vec![row("No applications in /Applications", None)];
+    }
+    apps.iter()
+        .enumerate()
+        .map(|(n, path)| row(path.file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default(), Some(Action::OpenApplication(n as u8))))
+        .collect()
+}
+
+/// Ask the session to open a bundle: its path goes, as one line, into the
+/// session's pipe. The compositor starts no program for this; without a
+/// listener on the pipe (`ENXIO`, `ENOENT`) nothing is opened and the notice
+/// says so.
+pub fn request_open(path: &std::path::Path) -> Result<(), i32> {
+    use std::io::Write;
+    use std::os::unix::fs::OpenOptionsExt;
+    let dir = std::env::var_os("XDG_RUNTIME_DIR").ok_or(libc::ENOENT)?;
+    let pipe = std::path::Path::new(&dir).join(OPEN_REQUESTS);
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW)
+        .open(&pipe)
+        .map_err(|e| e.raw_os_error().unwrap_or(libc::EIO))?;
+    let mut line = path.as_os_str().as_encoded_bytes().to_vec();
+    line.push(b'\n');
+    file.write_all(&line).map_err(|e| e.raw_os_error().unwrap_or(libc::EIO))
+}
