+//! Outputs: the panel and an external display (J293 drives at most one, through dcpext), their
+//! arrangement, scale and what happens when one comes or goes. Pure policy, no device: the
+//! KMS side (kms.rs `connectors`) says what is connected, the scene and the renderer follow
+//! what this decides. Host-tested with a virtual second output (no kernel has a dcpext yet;
+//! see runs/m1-coord/requests-for-CODEX-TB.md for the kernel's half).
+//!
+//! macOS's defaults, which the owner expects ("plug in an external monitor and expect it to
+//! work … hotswap", the Samsung on the dock as the primary when present):
+//! - extended desktop, separate Spaces per display; the external is the primary (the dock
+//!   column, the launcher strip and new windows go there), the panel to its left, tops aligned;
+//! - the pointer crosses where the two touch and stops at edges where they do not;
+//! - each output has its own scale: the panel keeps the owner's file (`scale`), an external gets
+//!   its own (`scale-<output id>`), by default from its density, never the panel's file;
+//! - unplugged: its windows come to the panel at the same relative place, its Spaces' windows
+//!   join the panel's Spaces of the same number; plugged again: primary again;
+//! - mirroring on request: one picture at the primary's logical size, shown on both.
+use crate::scale::Scale;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum OutputKind {
+    /// The built-in panel (connector type eDP).
+    Internal,
+    /// Anything plugged in (DisplayPort, HDMI-A, USB-C).
+    External,
+}
+
+/// What the kernel says of a connected connector.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct OutputInfo {
+    /// The connector's name (`eDP-1`, `DP-1`): the key while it stays plugged.
+    pub name: String,
+    pub kind: OutputKind,
+    /// The mode in pixels.
+    pub pixels: (u32, u32),
+    /// The physical size in millimetres (0 when the EDID gives none).
+    pub mm: (u32, u32),
+    /// A stable key for remembering its scale across plugs: the EDID's manufacturer, product
+    /// and size, without a serial number (`SAM-7381-597x336`), or the connector name.
+    pub id: String,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Arrangement {
+    Extended,
+    Mirrored,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Placed {
+    pub info: OutputInfo,
+    pub scale: Scale,
+    /// Top left in the global logical space (the primary's top left is 0,0).
+    pub origin: (i32, i32),
+    /// The size in logical units at its scale.
+    pub logical: (i32, i32),
+    pub primary: bool,
+}
+impl Placed {
+    pub fn rect(&self) -> Rect {
+        Rect { x: self.origin.0, y: self.origin.1, w: self.logical.0, h: self.logical.1 }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Rect {
+    pub x: i32,
+    pub y: i32,
+    pub w: i32,
+    pub h: i32,
+}
+impl Rect {
+    pub fn contains(&self, x: f64, y: f64) -> bool {
+        x >= f64::from(self.x) && y >= f64::from(self.y) && x < f64::from(self.x + self.w) && y < f64::from(self.y + self.h)
+    }
+    fn clamp(&self, x: f64, y: f64) -> (f64, f64) {
+        (x.clamp(f64::from(self.x), f64::from(self.x + self.w) - 1.0), y.clamp(f64::from(self.y), f64::from(self.y + self.h) - 1.0))
+    }
+}
+
+/// What a change of the connected outputs did.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Change {
+    Added(String),
+    Removed(String),
+    /// The primary is now this output (the dock and the launchers move there).
+    Primary(String),
+}
+
+/// The scale an output gets when nobody chose one: the step nearest to a density of about
+/// 110 logical dots per inch, never under 100 %. The J293 panel (2560 px over 286 mm, 227 dpi)
+/// gets 200 %, a 27" 4K (597 mm, 163 dpi) 150 %, a 32" 4K (698 mm) 125 %, a 24" 1080p 100 %.
+/// Without a physical size: the width over 2560 (a 4K: 150 %).
+pub fn default_scale(info: &OutputInfo) -> Scale {
+    let factor = if info.mm.0 >= 100 {
+        let dpi = f64::from(info.pixels.0) / (f64::from(info.mm.0) / 25.4);
+        dpi / 110.0
+    } else if info.kind == OutputKind::Internal {
+        f64::from(info.pixels.0) / 1280.0
+    } else {
+        f64::from(info.pixels.0) / 2560.0
+    };
+    Scale::nearest(factor.max(1.0))
+}
+
+/// The arrangement of the outputs connected now.
+#[derive(Debug, Clone)]
+pub struct Layout {
+    outputs: Vec<Placed>,
+    arrangement: Arrangement,
+}
+impl Layout {
+    /// The panel alone (the state at start without an external).
+    pub fn single(info: OutputInfo, scale: Scale) -> Self {
+        let mut layout = Self { outputs: Vec::new(), arrangement: Arrangement::Extended };
+        layout.outputs.push(Placed { logical: logical(info.pixels, scale), info, scale, origin: (0, 0), primary: true });
+        layout
+    }
+    pub fn outputs(&self) -> &[Placed] {
+        &self.outputs
+    }
+    pub fn arrangement(&self) -> Arrangement {
+        self.arrangement
+    }
+    pub fn primary(&self) -> &Placed {
+        self.outputs.iter().find(|o| o.primary).unwrap_or(&self.outputs[0])
+    }
+    pub fn get(&self, name: &str) -> Option<&Placed> {
+        self.outputs.iter().find(|o| o.info.name == name)
+    }
+    /// Make the connected set `connected` (one per connector, from the kernel after a hotplug
+    /// signal). `scale_of` gives an output's scale (persisted, else `default_scale`). The panel
+    /// is never removed by this (a kernel that briefly lists it disconnected keeps it).
+    pub fn sync(&mut self, connected: &[OutputInfo], mut scale_of: impl FnMut(&OutputInfo) -> Scale) -> Vec<Change> {
+        let mut changes = Vec::new();
+        let before = self.primary().info.name.clone();
+        let gone: Vec<String> = self.outputs.iter()
+            .filter(|o| o.info.kind == OutputKind::External && !connected.iter().any(|c| c.name == o.info.name && c.pixels == o.info.pixels))
+            .map(|o| o.info.name.clone()).collect();
+        for name in gone {
+            self.outputs.retain(|o| o.info.name != name);
+            changes.push(Change::Removed(name));
+        }
+        for info in connected {
+            if self.get(&info.name).is_some() {
+                continue;
+            }
+            if info.kind == OutputKind::Internal && self.outputs.iter().any(|o| o.info.kind == OutputKind::Internal) {
+                continue;
+            }
+            let scale = scale_of(info);
+            self.outputs.push(Placed { logical: logical(info.pixels, scale), info: info.clone(), scale, origin: (0, 0), primary: false });
+            changes.push(Change::Added(info.name.clone()));
+        }
+        self.arrange();
+        let after = self.primary().info.name.clone();
+        if after != before {
+            changes.push(Change::Primary(after));
+        }
+        changes
+    }
+    /// A new scale for one output (the menu's Display > Scale applies to the output the pointer
+    /// is on); the arrangement follows.
+    pub fn set_scale(&mut self, name: &str, scale: Scale) -> bool {
+        let Some(output) = self.outputs.iter_mut().find(|o| o.info.name == name) else { return false };
+        output.scale = scale;
+        output.logical = logical(output.info.pixels, scale);
+        self.arrange();
+        true
+    }
+    pub fn set_arrangement(&mut self, arrangement: Arrangement) {
+        self.arrangement = arrangement;
+        self.arrange();
+    }
+    /// The external (the first one) is the primary when present; the others go to its left,
+    /// tops aligned (mirrored: all at 0,0 with the primary's logical size).
+    fn arrange(&mut self) {
+        for o in self.outputs.iter_mut() {
+            o.logical = logical(o.info.pixels, o.scale);
+        }
+        let primary = self.outputs.iter().position(|o| o.info.kind == OutputKind::External).unwrap_or(0);
+        for (i, o) in self.outputs.iter_mut().enumerate() {
+            o.primary = i == primary;
+        }
+        let size = self.outputs[primary].logical;
+        self.outputs[primary].origin = (0, 0);
+        let mut left = 0;
+        for i in 0..self.outputs.len() {
+            if i == primary {
+                continue;
+            }
+            match self.arrangement {
+                Arrangement::Mirrored => self.outputs[i].origin = (0, 0),
+                Arrangement::Extended => {
+                    left -= self.outputs[i].logical.0;
+                    self.outputs[i].origin = (left, 0);
+                }
+            }
+        }
+        if self.arrangement == Arrangement::Mirrored {
+            for o in self.outputs.iter_mut() {
+                o.logical = size;
+            }
+        }
+    }
+    /// The output under a global logical point.
+    pub fn output_at(&self, x: f64, y: f64) -> Option<&Placed> {
+        self.outputs.iter().find(|o| o.rect().contains(x, y))
+    }
+    /// The pointer moved from `from` to `to` (global logical units): where it ends. Into an
+    /// output: there. Into the space beside the outputs: it stops at the edge of the output it
+    /// was on (no jump over a gap), as on macOS.
+    pub fn move_pointer(&self, from: (f64, f64), to: (f64, f64)) -> (f64, f64) {
+        if self.output_at(to.0, to.1).is_some() {
+            return to;
+        }
+        let home = self.output_at(from.0, from.1).unwrap_or_else(|| self.primary());
+        home.rect().clamp(to.0, to.1)
+    }
+    /// Where a window that was on `removed` goes when it is unplugged: onto the primary, its
+    /// centre at the same place relative to the output's size, wholly inside (the title bar
+    /// reachable), its size kept when it fits, else shrunk to the output.
+    pub fn rehome(removed: Rect, target: Rect, window: Rect) -> Rect {
+        let w = window.w.min(target.w);
+        let h = window.h.min(target.h);
+        let fx = if removed.w > 0 { (f64::from(window.x - removed.x) + f64::from(window.w) / 2.0) / f64::from(removed.w) } else { 0.5 };
+        let fy = if removed.h > 0 { (f64::from(window.y - removed.y) + f64::from(window.h) / 2.0) / f64::from(removed.h) } else { 0.5 };
+        let x = target.x + (fx * f64::from(target.w) - f64::from(w) / 2.0).round() as i32;
+        let y = target.y + (fy * f64::from(target.h) - f64::from(h) / 2.0).round() as i32;
+        Rect { x: x.clamp(target.x, target.x + target.w - w), y: y.clamp(target.y, target.y + target.h - h), w, h }
+    }
+    /// The bounding box of every output (logical units).
+    pub fn bounds(&self) -> Rect {
+        let x0 = self.outputs.iter().map(|o| o.origin.0).min().unwrap_or(0);
+        let y0 = self.outputs.iter().map(|o| o.origin.1).min().unwrap_or(0);
+        let x1 = self.outputs.iter().map(|o| o.origin.0 + o.logical.0).max().unwrap_or(0);
+        let y1 = self.outputs.iter().map(|o| o.origin.1 + o.logical.1).max().unwrap_or(0);
+        Rect { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }
+    }
+    /// One line for the log.
+    pub fn describe(&self) -> String {
+        self.outputs.iter().map(|o| format!("{}{} {:?} {}x{}px {} at {},{} logical {}x{}", o.info.name, if o.primary { "*" } else { "" }, o.info.kind, o.info.pixels.0, o.info.pixels.1, o.scale.label(), o.origin.0, o.origin.1, o.logical.0, o.logical.1))
+            .collect::<Vec<_>>().join("; ")
+    }
+}
+fn logical(pixels: (u32, u32), scale: Scale) -> (i32, i32) {
+    (scale.to_logical(pixels.0 as i32), scale.to_logical(pixels.1 as i32))
+}
+
+/// Spaces per display (macOS's default): each output keeps its own list and its current one.
+/// When an output goes, its Spaces' windows join the remaining primary's Spaces of the same
+/// number (made when missing); the result is the space index each window lands on.
+pub fn spaces_after_unplug(removed_window_spaces: &[(u64, usize)], remaining_spaces: usize) -> (Vec<(u64, usize)>, usize) {
+    let needed = removed_window_spaces.iter().map(|(_, s)| s + 1).max().unwrap_or(0).max(remaining_spaces);
+    (removed_window_spaces.to_vec(), needed)
+}
+
+/// Watches the display driver's hotplug counter (`kern.sf_dcp.hotplug_seq`, asked of the kernel)
+/// twice a second; when it moves, the connected outputs are read again and the layout decides.
+/// Today the decision is said in the log (`WMOUTPUT hotplug ...`) and the desktop stays on the
+/// panel: the second scanout (kms.rs per CRTC, the renderer per output) comes with dcpext.
+pub struct Watch {
+    seq: Option<u64>,
+    said_absent: bool,
+    layout: Option<Layout>,
+    next: std::time::Instant,
+}
+impl Default for Watch {
+    fn default() -> Self {
+        Self { seq: None, said_absent: false, layout: None, next: std::time::Instant::now() }
+    }
+}
+impl Watch {
+    pub fn layout(&self) -> Option<&Layout> {
+        self.layout.as_ref()
+    }
+    pub fn tick(
+        &mut self,
+        read_seq: impl FnOnce() -> Option<u64>,
+        list: impl FnOnce() -> Result<Vec<OutputInfo>, String>,
+        panel_scale: Scale,
+    ) -> Vec<Change> {
+        let now = std::time::Instant::now();
+        if self.said_absent || now < self.next {
+            return Vec::new();
+        }
+        self.next = now + std::time::Duration::from_millis(500);
+        let Some(seq) = read_seq() else {
+            self.said_absent = true;
+            eprintln!("WMOUTPUT hotplug: kern.sf_dcp.hotplug_seq absent (this kernel has no external display yet); the panel only");
+            return Vec::new();
+        };
+        if self.seq == Some(seq) {
+            return Vec::new();
+        }
+        self.seq = Some(seq);
+        let connected = match list() {
+            Ok(list) => list,
+            Err(error) => {
+                eprintln!("WMOUTPUT hotplug seq={seq}: connectors not readable: {error}");
+                return Vec::new();
+            }
+        };
+        let layout = match self.layout.as_mut() {
+            Some(layout) => layout,
+            None => {
+                let Some(panel) = connected.iter().find(|o| o.kind == OutputKind::Internal).cloned() else {
+                    eprintln!("WMOUTPUT hotplug seq={seq}: no panel among the connectors");
+                    return Vec::new();
+                };
+                self.layout.insert(Layout::single(panel, panel_scale))
+            }
+        };
+        let changes = layout.sync(&connected, |info| persisted_scale(&info.id).unwrap_or_else(|| default_scale(info)));
+        if !changes.is_empty() {
+            eprintln!("WMOUTPUT hotplug seq={seq} changes={changes:?} layout: {} (the desktop stays on the panel: no second scanout yet)", layout.describe());
+        }
+        changes
+    }
+}
+
+/// The persisted scale of an external output (`scale-<id>` in the desktop's state directory,
+/// 120ths), when one was chosen; the panel's is `scale` (chonk_shell::scale_select).
+pub fn persisted_scale(id: &str) -> Option<Scale> {
+    if !id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'x') {
+        return None;
+    }
+    let path = std::path::PathBuf::from(std::env::var_os("XDG_STATE_HOME")?).join("chonkstep").join(format!("scale-{id}"));
+    std::fs::read_to_string(path).ok()?.trim().parse::<u32>().ok().and_then(Scale::from_120)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn panel() -> OutputInfo {
+        OutputInfo { name: "eDP-1".into(), kind: OutputKind::Internal, pixels: (2560, 1600), mm: (286, 179), id: "eDP-1".into() }
+    }
+    fn samsung() -> OutputInfo {
+        OutputInfo { name: "DP-1".into(), kind: OutputKind::External, pixels: (3840, 2160), mm: (597, 336), id: "SAM-0f00-597x336".into() }
+    }
+    fn s(v: u32) -> Scale {
+        Scale::from_120(v).unwrap()
+    }
+    #[test]
+    fn default_scales_follow_density_not_the_panel_file() {
+        assert_eq!(default_scale(&panel()).label(), "200%");
+        assert_eq!(default_scale(&samsung()).label(), "150%");
+        let mut big = samsung();
+        big.mm = (698, 393);
+        assert_eq!(default_scale(&big).label(), "125%");
+        let hd = OutputInfo { pixels: (1920, 1080), mm: (531, 299), ..samsung() };
+        assert_eq!(default_scale(&hd).label(), "100%");
+        let unknown = OutputInfo { mm: (0, 0), ..samsung() };
+        assert_eq!(default_scale(&unknown).label(), "150%");
+    }
+    #[test]
+    fn hot_add_makes_the_external_primary_and_puts_the_panel_left_and_unplug_undoes_it() {
+        // the owner's panel scale (150 %, file 180) stays the panel's
+        let mut layout = Layout::single(panel(), s(180));
+        assert_eq!(layout.primary().info.name, "eDP-1");
+        let changes = layout.sync(&[panel(), samsung()], default_scale);
+        assert_eq!(changes, vec![Change::Added("DP-1".into()), Change::Primary("DP-1".into())]);
+        let ext = layout.get("DP-1").unwrap();
+        assert!(ext.primary);
+        assert_eq!((ext.origin, ext.logical, ext.scale.label()), ((0, 0), (2560, 1440), "150%".to_string()));
+        let int = layout.get("eDP-1").unwrap();
+        assert_eq!((int.origin, int.logical, int.scale.v120()), ((-1707, 0), (1707, 1067), 180), "panel left of it, tops aligned, its own scale");
+        assert_eq!(layout.bounds(), Rect { x: -1707, y: 0, w: 4267, h: 1440 });
+        // the same set again: nothing happens
+        assert!(layout.sync(&[panel(), samsung()], default_scale).is_empty());
+        // unplugged: the panel is primary again
+        let changes = layout.sync(&[panel()], default_scale);
+        assert_eq!(changes, vec![Change::Removed("DP-1".into()), Change::Primary("eDP-1".into())]);
+        assert_eq!(layout.primary().origin, (0, 0));
+        // a kernel that lists the panel disconnected for a moment does not remove it
+        assert!(layout.sync(&[], default_scale).is_empty());
+        assert_eq!(layout.outputs().len(), 1);
+        // a mode change of the external is a remove and an add
+        layout.sync(&[panel(), samsung()], |_| s(180));
+        let mut hd = samsung();
+        hd.pixels = (1920, 1080);
+        let changes = layout.sync(&[panel(), hd], default_scale);
+        assert_eq!(changes, vec![Change::Removed("DP-1".into()), Change::Added("DP-1".into())]);
+    }
+    #[test]
+    fn the_pointer_crosses_where_outputs_touch_and_stops_elsewhere() {
+        let mut layout = Layout::single(panel(), s(180));
+        layout.sync(&[panel(), samsung()], default_scale);
+        // from the external's left edge into the panel, at a height both have
+        assert_eq!(layout.move_pointer((2.0, 500.0), (-10.0, 500.0)), (-10.0, 500.0));
+        // below the panel's bottom (1067) there is no panel: it stops at the external's edge
+        assert_eq!(layout.move_pointer((2.0, 1200.0), (-10.0, 1200.0)), (0.0, 1200.0));
+        // off the far right: clamped to the external
+        assert_eq!(layout.move_pointer((2550.0, 10.0), (2600.0, 10.0)), (2559.0, 10.0));
+        // from the panel back into the external
+        assert_eq!(layout.move_pointer((-5.0, 100.0), (3.0, 100.0)), (3.0, 100.0));
+    }
+    #[test]
+    fn windows_of_an_unplugged_output_come_to_the_panel_at_the_same_relative_place() {
+        let ext = Rect { x: 0, y: 0, w: 2560, h: 1440 };
+        let panel = Rect { x: 0, y: 0, w: 1707, h: 1067 };
+        // in the middle: stays in the middle (its centre at the same fraction)
+        let w = Layout::rehome(ext, panel, Rect { x: 1280 - 300, y: 720 - 200, w: 600, h: 400 });
+        assert_eq!(w, Rect { x: 554, y: 334, w: 600, h: 400 });
+        // larger than the panel: shrunk to it, at its top left
+        let w = Layout::rehome(ext, panel, Rect { x: 100, y: 50, w: 2400, h: 1300 });
+        assert_eq!(w, Rect { x: 0, y: 0, w: 1707, h: 1067 });
+        // at the far right edge: kept inside
+        let w = Layout::rehome(ext, panel, Rect { x: 2400, y: 1300, w: 300, h: 200 });
+        assert_eq!((w.x + w.w, w.y + w.h), (1707, 1067));
+        // Spaces: a window on the external's Space 3 lands on the panel's Space 3 (made)
+        let (moved, spaces) = spaces_after_unplug(&[(7, 2), (8, 0)], 1);
+        assert_eq!((moved, spaces), (vec![(7, 2), (8, 0)], 3));
+    }
+    #[test]
+    fn the_watch_follows_a_virtual_second_output_through_plug_and_unplug() {
+        let mut watch = Watch::default();
+        let mut tick = |watch: &mut Watch, seq: Option<u64>, list: Vec<OutputInfo>| {
+            watch.next = std::time::Instant::now();
+            watch.tick(|| seq, || Ok(list), s(180))
+        };
+        assert!(tick(&mut watch, Some(1), vec![panel()]).is_empty(), "the panel alone: nothing changes");
+        assert_eq!(watch.layout().unwrap().primary().info.name, "eDP-1");
+        assert_eq!(tick(&mut watch, Some(2), vec![panel(), samsung()]), vec![Change::Added("DP-1".into()), Change::Primary("DP-1".into())]);
+        assert_eq!(watch.layout().unwrap().get("eDP-1").unwrap().scale.v120(), 180, "the panel keeps the owner's scale");
+        assert!(tick(&mut watch, Some(2), vec![]).is_empty(), "the same counter: not read again");
+        assert_eq!(tick(&mut watch, Some(3), vec![panel()]), vec![Change::Removed("DP-1".into()), Change::Primary("eDP-1".into())]);
+        // a kernel without the counter: said once, then left alone
+        let mut old = Watch::default();
+        assert!(tick(&mut old, None, vec![panel(), samsung()]).is_empty());
+        assert!(old.said_absent && old.layout().is_none());
+    }
+    #[test]
+    fn mirroring_shows_the_primary_picture_on_both() {
+        let mut layout = Layout::single(panel(), s(180));
+        layout.sync(&[panel(), samsung()], default_scale);
+        layout.set_arrangement(Arrangement::Mirrored);
+        assert!(layout.outputs().iter().all(|o| o.origin == (0, 0) && o.logical == (2560, 1440)));
+        layout.set_arrangement(Arrangement::Extended);
+        assert_eq!(layout.get("eDP-1").unwrap().origin, (-1707, 0));
+        // a scale change on the panel moves it
+        assert!(layout.set_scale("eDP-1", s(240)));
+        assert_eq!(layout.get("eDP-1").unwrap().origin, (-1280, 0));
+    }
+}
