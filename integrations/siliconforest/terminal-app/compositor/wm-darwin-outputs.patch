+/// drm_mode.h's connector type names.
+pub fn connector_type_name(kind: u32) -> &'static str {
+    match kind {
+        1 => "VGA", 2 => "DVI-I", 3 => "DVI-D", 4 => "DVI-A", 5 => "Composite", 6 => "SVIDEO", 7 => "LVDS", 8 => "Component",
+        9 => "9PinDIN", 10 => "DP", 11 => "HDMI-A", 12 => "HDMI-B", 13 => "TV", 14 => "eDP", 15 => "Virtual", 16 => "DSI",
+        17 => "DPI", 18 => "Writeback", 19 => "SPI", 20 => "USB", _ => "Unknown",
+    }
+}
+/// A built-in panel's connector type (eDP, LVDS, DSI).
+pub fn is_internal_type(kind: u32) -> bool {
+    matches!(kind, 7 | 14 | 16)
+}
+/// A connector as the card node lists it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ConnectorInfo {
+    pub id: u32,
+    /// `<type>-<type id>`, as Linux names them (eDP-1, DP-1).
+    pub name: String,
+    pub kind: u32,
+    pub connected: bool,
+    /// width, height, refresh, preferred
+    pub modes: Vec<(u16, u16, u32, bool)>,
+    pub mm: (u32, u32),
+    pub has_edid: bool,
+    pub possible_crtcs: u32,
+}
+impl ConnectorInfo {
+    pub fn describe(&self) -> String {
+        let preferred = self.modes.iter().find(|m| m.3).or(self.modes.first()).map_or("-".to_string(), |m| format!("{}x{}@{}", m.0, m.1, m.2));
+        format!("id={} name={} type={} {} modes={} preferred={preferred} mm={}x{} edid={} possible_crtcs={:#x} {}",
+            self.id, self.name, connector_type_name(self.kind), if self.connected { "connected" } else { "disconnected" }, self.modes.len(),
+            self.mm.0, self.mm.1, if self.has_edid { "yes" } else { "no" }, self.possible_crtcs, if is_internal_type(self.kind) { "internal" } else { "external" })
+    }
+    /// The output policy's view of it (outputs.rs), when it is connected with a mode.
+    pub fn output_info(&self) -> Option<crate::outputs::OutputInfo> {
+        if !self.connected {
+            return None;
+        }
+        let mode = self.modes.iter().find(|m| m.3).or(self.modes.first())?;
+        let kind = if is_internal_type(self.kind) { crate::outputs::OutputKind::Internal } else { crate::outputs::OutputKind::External };
+        Some(crate::outputs::OutputInfo { name: self.name.clone(), kind, pixels: (u32::from(mode.0), u32::from(mode.1)), mm: self.mm, id: format!("{}-{}x{}", self.name, self.mm.0, self.mm.1) })
+    }
+}
+/// Every connector of the card node, read only: no DRM master, no commit.
+pub fn list_connectors(drm: &Drm, card: c_int) -> Result<Vec<ConnectorInfo>, String> {
+    let mut list = Vec::new();
+    unsafe {
+        let res = (drm.drmModeGetResources)(card);
+        if res.is_null() {
+            return Err(os_error("drmModeGetResources"));
+        }
+        for i in 0..(*res).count_connectors.max(0) as usize {
+            let c = (drm.drmModeGetConnector)(card, *(*res).connectors.add(i));
+            if c.is_null() {
+                continue;
+            }
+            let mut modes = Vec::new();
+            for m in 0..(*c).count_modes.max(0) as usize {
+                let mode = *(*c).modes.add(m);
+                modes.push((mode.hdisplay, mode.vdisplay, mode.vrefresh, mode.kind & DRM_MODE_TYPE_PREFERRED != 0));
+            }
+            let mut possible_crtcs = 0;
+            for e in 0..(*c).count_encoders.max(0) as usize {
+                let encoder = (drm.drmModeGetEncoder)(card, *(*c).encoders.add(e));
+                if !encoder.is_null() {
+                    possible_crtcs |= (*encoder).possible_crtcs;
+                    (drm.drmModeFreeEncoder)(encoder);
+                }
+            }
+            let id = (*c).connector_id;
+            let has_edid = Kms::property(drm, card, id, DRM_MODE_OBJECT_CONNECTOR, "EDID").is_some_and(|p| p.1 != 0);
+            list.push(ConnectorInfo {
+                id,
+                name: format!("{}-{}", connector_type_name((*c).connector_type), (*c).connector_type_id),
+                kind: (*c).connector_type,
+                connected: (*c).connection == DRM_MODE_CONNECTED,
+                modes,
+                mm: ((*c).mm_width, (*c).mm_height),
+                has_edid,
+                possible_crtcs,
+            });
+            (drm.drmModeFreeConnector)(c);
+        }
+        (drm.drmModeFreeResources)(res);
+    }
+    Ok(list)
+}
+/// `--outputs`: what the display driver offers, for the external-display work (CODEX-TB): every
+/// connector, CRTC and plane with its state, read only (no DRM master is taken, nothing is
+/// committed, the running desktop is not disturbed). Lines `WMOUTPUT ...`.
+pub fn outputs_cli() -> Result<(), String> {
+    let libs = Libraries::load()?;
+    let drm = &libs.drm;
+    let (card, path) = open_by_driver(drm, "card", "apple")?;
+    println!("WMOUTPUT card={path}");
+    unsafe {
+        let _ = (drm.drmSetClientCap)(card, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1);
+        let res = (drm.drmModeGetResources)(card);
+        if !res.is_null() {
+            println!("WMOUTPUT resources crtcs={} connectors={} encoders={} fb_max={}x{}", (*res).count_crtcs, (*res).count_connectors, (*res).count_encoders, (*res).max_width, (*res).max_height);
+            for i in 0..(*res).count_crtcs.max(0) as usize {
+                let id = *(*res).crtcs.add(i);
+                let active = Kms::property(drm, card, id, DRM_MODE_OBJECT_CRTC, "ACTIVE").map(|p| p.1);
+                println!("WMOUTPUT crtc index={i} id={id} active={active:?}");
+            }
+            (drm.drmModeFreeResources)(res);
+        }
+        for c in list_connectors(drm, card)? {
+            println!("WMOUTPUT connector {}", c.describe());
+            if let Some(info) = c.output_info() {
+                println!("WMOUTPUT policy {} kind={:?} default_scale={}", info.name, info.kind, crate::outputs::default_scale(&info).label());
+            }
+        }
+        let planes = (drm.drmModeGetPlaneResources)(card);
+        if !planes.is_null() {
+            for i in 0..(*planes).count_planes as usize {
+                let plane = (drm.drmModeGetPlane)(card, *(*planes).planes.add(i));
+                if plane.is_null() {
+                    continue;
+                }
+                let id = (*plane).plane_id;
+                let kind = Kms::property(drm, card, id, DRM_MODE_OBJECT_PLANE, "type").map(|p| p.1);
+                println!("WMOUTPUT plane id={id} type={} possible_crtcs={:#x} crtc={} fb={} formats={}", match kind { Some(0) => "overlay", Some(1) => "primary", Some(2) => "cursor", _ => "?" }, (*plane).possible_crtcs, (*plane).crtc_id, (*plane).fb_id, (*plane).count_formats);
+                (drm.drmModeFreePlane)(plane);
+            }
+            (drm.drmModeFreePlaneResources)(planes);
+        }
+        libc::close(card);
+    }
+    match read_hotplug_seq() {
+        Some(seq) => println!("WMOUTPUT kern.sf_dcp.hotplug_seq={seq}"),
+        None => println!("WMOUTPUT kern.sf_dcp.hotplug_seq absent (no hotplug signal from this kernel yet)"),
+    }
+    Ok(())
+}
+/// The display driver's hotplug counter (asked of CODEX-TB, K4), when the kernel has it.
+#[cfg(target_os = "macos")]
+pub fn read_hotplug_seq() -> Option<u64> {
+    let mut value: u64 = 0;
+    let mut size = std::mem::size_of::<u64>();
+    let rc = unsafe { libc::sysctlbyname(c"kern.sf_dcp.hotplug_seq".as_ptr(), (&mut value as *mut u64).cast(), &mut size, std::ptr::null_mut(), 0) };
+    (rc == 0 && (size == 8 || size == 4)).then_some(if size == 4 { value & 0xffff_ffff } else { value })
+}
+#[cfg(not(target_os = "macos"))]
+pub fn read_hotplug_seq() -> Option<u64> {
+    None
+}
