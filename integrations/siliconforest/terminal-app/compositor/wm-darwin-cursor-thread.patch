+/// `$XDG_RUNTIME_DIR/app-ids/<pid>`: the application id a client gave, for the compositor after this one
+/// (its leftover applications are shown under that id: the dock's tile matches it).
+pub(crate) fn record_app_id(pid: i32, app_id: &str) {
+    let Some(runtime) = std::env::var_os("XDG_RUNTIME_DIR").map(std::path::PathBuf::from) else { return };
+    let dir = runtime.join("app-ids");
+    let path = dir.join(pid.to_string());
+    if std::fs::read_to_string(&path).is_ok_and(|t| t == app_id) {
+        return;
+    }
+    let _ = std::fs::create_dir_all(&dir).and_then(|()| std::fs::write(&path, app_id));
