+            return;
+        }
+    };
+    // every refresh about a millisecond of work at most, done within four
+    crate::input_latency::time_constraint("sfcursor", 16_667, 1_000, 4_000);
+    let ring = |wake: &std::fs::File| {
+        let _ = std::io::Write::write(&mut &*wake, &[1]);
+    };
+    let mut seen = 0u64;
+    let mut errors = 0u32;
+    while !stop.load(std::sync::atomic::Ordering::Acquire) {
+        let (unshown, moment) = {
+            let mut c = core.lock().unwrap_or_else(|e| e.into_inner());
+            match c.read_flips(&libs) {
+                Ok(true) => ring(&wake),
+                Ok(false) => {}
+                Err(error) => {
+                    errors += 1;
+                    if errors <= 3 {
+                        eprintln!("WMCURSOR thread: reading flips: {error}");
+                    }
+                }
+            }
+            let unshown = c.plane.wanted.enabled && c.plane.committed != Some(pointer.root());
+            (unshown, c.plane.next_moment(Instant::now()))
+        };
+        if !unshown {
+            seen = pointer.wait_motion(seen, Duration::from_millis(20));
+            continue;
+        }
+        let blank = match moment {
+            Some((at, blank)) => {
+                if !crate::input_latency::wait_until(at) {
+                    std::thread::sleep(at.saturating_duration_since(Instant::now()));
+                }
+                Some(blank)
+            }
+            None => None,
+        };
+        let committed = {
+            let mut c = core.lock().unwrap_or_else(|e| e.into_inner());
+            if let Ok(true) = c.read_flips(&libs) {
+                ring(&wake);
+            }
+            let r = c.thread_commit(&libs, &pointer, blank);
+            if c.plane.needs_desk {
