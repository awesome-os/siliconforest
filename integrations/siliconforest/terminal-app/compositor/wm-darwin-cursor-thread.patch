@@ -0,0 +1,265 @@
+//! The pointer's plane, moved by a thread of its own (DESK7, item 2b: "the pointer must NEVER stutter").
+//!
+//! Before: a pointer-only frame (a commit that moves the overlay plane) was made by the desktop's loop,
+//! so it waited for whatever the loop was doing - a client's commits (12-22 ms measured), a repaint (up
+//! to 99 ms with eight busy cores), a late wake-up (17 ms) - and with eight busy cores the pointer
+//! skipped refreshes. Now the cursor thread ("sfcursor", time-constraint class) takes the owner's pointer
+//! position from the input thread (`pointer.rs`) at every refresh, `lead` before the blank, and commits
+//! the plane's move on its own when nothing is in flight; the loop keeps rendering, staging and
+//! committing frames (which carry the newest position too). The loop commits its staged frame before the
+//! thread's moment (its margin is kept above the thread's lead); a frame that is late for its blank no
+//! longer holds the pointer: the thread moves the pointer on that blank and the frame follows on the
+//! next. The plane's buffer is the one the loop drew (image and place inside it); a place that needs a
+//! buffer drawn anew (the pointer within its plane's size of the right or bottom edge) is left to the
+//! loop (`needs_desk`).
+//!
+//! This file is the thread's bookkeeping (testable without a display); the thread and the display it
+//! shares with the loop are in `glrender.rs` (`KmsCore`).
+use crate::input_latency::Series;
+use std::time::{Duration, Instant};
+use wm_core::Point;
+
+/// What the desktop wants of the plane (set every loop turn).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PlaneWanted {
+    /// The thread may move the plane: the pointer is on its plane and visible, no window follows it
+    /// (a move or resize grab draws the pointer with the window), no recording, one output.
+    pub enabled: bool,
+    /// The pointer image's generation, hotspot and size (the image's top left = pointer - hotspot).
+    pub generation: u64,
+    pub hotspot: Point,
+    pub image: (u32, u32),
+    pub screen: (u32, u32),
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Aim {
+    blank: Instant,
+    by_thread: bool,
+    pointer_only: bool,
+    motions: Option<(Instant, Instant)>,
+}
+
+/// The thread's state, shared with the loop under the display's lock.
+pub struct PlaneShare {
+    pub wanted: PlaneWanted,
+    /// The pointer position the newest commit put on the plane.
+    pub committed: Option<Point>,
+    /// The thread found that the pointer's place needs a buffer drawn anew: the loop does that commit.
+    pub needs_desk: bool,
+    /// The hotspot and size of the last images the loop wanted, by generation: the thread moves the image
+    /// that is drawn while the loop has not drawn a new one yet (the position never waits for a shape).
+    pub images: Vec<(u64, Point, (u32, u32))>,
+    phase: Option<Instant>,
+    interval: Duration,
+    /// How long before the blank the thread commits (learned upwards from misses).
+    pub lead_us: u32,
+    aim: Option<Aim>,
+    oldest: Series,
+    newest: Series,
+    gaps: Series,
+    /// The same for the line every 10 s (kept apart: the inject `stats` windows stay whole).
+    periodic: (Series, Series, Series),
+    last_shown: Option<(Point, Instant)>,
+    pub thread_commits: u64,
+    pub desk_commits: u64,
+    pub pointer_only_late: u64,
+    pub pointer_only_on_time: u64,
+    pub skipped_busy: u64,
+    pub skipped_edge: u64,
+    logged_at: Option<Instant>,
+}
+
+pub const LEAD_START_US: u32 = 3_000;
+pub const LEAD_MIN_US: u32 = 2_600;
+pub const LEAD_MAX_US: u32 = 8_000;
+
+impl Default for PlaneShare {
+    fn default() -> Self {
+        Self {
+            wanted: PlaneWanted { enabled: false, generation: 0, hotspot: Point::new(0, 0), image: (0, 0), screen: (0, 0) },
+            committed: None,
+            needs_desk: false,
+            images: Vec::new(),
+            phase: None,
+            interval: Duration::from_micros(16_667),
+            lead_us: LEAD_START_US,
+            aim: None,
+            oldest: Series::default(),
+            newest: Series::default(),
+            gaps: Series::default(),
+            periodic: Default::default(),
+            last_shown: None,
+            thread_commits: 0,
+            desk_commits: 0,
+            pointer_only_late: 0,
+            pointer_only_on_time: 0,
+            skipped_busy: 0,
+            skipped_edge: 0,
+            logged_at: None,
+        }
+    }
+}
+
+impl PlaneShare {
+    /// The desktop's wish of this turn; the image's hotspot and size are kept by generation.
+    pub fn want(&mut self, wanted: PlaneWanted) {
+        if wanted.image.0 > 0 && !self.images.iter().any(|(g, ..)| *g == wanted.generation) {
+            if self.images.len() == 8 {
+                self.images.remove(0);
+            }
+            self.images.push((wanted.generation, wanted.hotspot, wanted.image));
+        }
+        self.wanted = wanted;
+    }
+    /// The hotspot and size of the image of `generation`, when the loop wanted it lately.
+    pub fn image_of(&self, generation: u64) -> Option<(Point, (u32, u32))> {
+        self.images.iter().rev().find(|(g, ..)| *g == generation).map(|(_, h, s)| (*h, *s))
+    }
+    /// The moment to commit for the first blank that can still be reached from `now`, and that blank.
+    pub fn next_moment(&self, now: Instant) -> Option<(Instant, Instant)> {
+        let phase = self.phase.filter(|p| now.saturating_duration_since(*p) < Duration::from_secs(1))?;
+        let lead = Duration::from_micros(u64::from(self.lead_us));
+        let i = self.interval.as_micros() as u64;
+        let since = (now + lead).saturating_duration_since(phase).as_micros() as u64;
+        let blank = phase + Duration::from_micros(since.div_ceil(i).max(1) * i);
+        Some((blank - lead, blank))
+    }
+    /// A commit was made at `at` aimed at `blank`, showing the pointer at `pos` (`motions`: the motions it
+    /// shows, from `PointerShared::take_motions`).
+    pub fn committed(&mut self, pos: Option<Point>, blank: Option<Instant>, pointer_only: bool, by_thread: bool, motions: Option<(Instant, Instant)>) {
+        if by_thread {
+            self.thread_commits += 1;
+        } else {
+            self.desk_commits += 1;
+        }
+        if pos.is_some() {
+            self.committed = pos;
+        }
+        let blank = blank.or_else(|| self.next_moment(Instant::now()).map(|(_, b)| b));
+        self.aim = blank.map(|blank| Aim { blank, by_thread, pointer_only, motions });
+    }
+    /// A flip completed at `at` (read by whichever thread read it first).
+    pub fn flipped(&mut self, at: Instant) {
+        if let Some(phase) = self.phase {
+            let d = at.saturating_duration_since(phase);
+            let i = self.interval.as_micros().max(1);
+            let off = d.as_micros() % i;
+            // a flip read a little late moves the phase only by an eighth (as the loop's pacer)
+            if off > i / 2 {
+                self.phase = Some(at);
+            } else {
+                self.phase = Some(at - Duration::from_micros(off as u64) + Duration::from_micros((off / 8) as u64));
+            }
+            if d > Duration::from_micros(15_000) && d < Duration::from_micros(18_500) {
+                self.interval = Duration::from_micros((self.interval.as_micros() as u64 * 15 + d.as_micros() as u64) / 16);
+            }
+        } else {
+            self.phase = Some(at);
+        }
+        let Some(aim) = self.aim.take() else { return };
+        let late = at > aim.blank + self.interval / 2;
+        if aim.pointer_only {
+            if late {
+                self.pointer_only_late += 1;
+                if aim.by_thread {
+                    self.lead_us = (self.lead_us + 500).min(LEAD_MAX_US);
+                }
+            } else {
+                self.pointer_only_on_time += 1;
+                if aim.by_thread {
+                    self.lead_us = self.lead_us.saturating_sub(5).max(LEAD_MIN_US);
+                }
+            }
+        }
+        if let Some((o, n)) = aim.motions {
+            self.oldest.sample(at.saturating_duration_since(o));
+            self.newest.sample(at.saturating_duration_since(n));
+            self.periodic.0.sample(at.saturating_duration_since(o));
+            self.periodic.1.sample(at.saturating_duration_since(n));
+            if let Some(pos) = self.committed {
+                if let Some((last, when)) = self.last_shown {
+                    let gap = at.saturating_duration_since(when);
+                    if last != pos && gap < Duration::from_millis(250) {
+                        self.gaps.sample(gap);
+                        self.periodic.2.sample(gap);
+                    }
+                }
+                self.last_shown = Some((pos, at));
+            }
+        }
+    }
+    /// One line of what happened since the last (the inject `stats` step, and every 10 s while the
+    /// pointer moves).
+    pub fn take_line(&mut self) -> String {
+        let text = |s: &mut Series, what: &str| {
+            let v = s.take_sorted();
+            crate::input_latency::window_text(&v, what)
+        };
+        let line = format!(
+            "WMCURSORTHREAD pointer motion->flip {} | {} | {} | commits thread={} desk={} pointer_only on_time={} late={} skipped busy={} edge={} lead_ms={:.2} interval_ms={:.3}",
+            text(&mut self.oldest, "oldest"),
+            text(&mut self.newest, "newest"),
+            text(&mut self.gaps, "gap between flips moving the pointer"),
+            self.thread_commits,
+            self.desk_commits,
+            self.pointer_only_on_time,
+            self.pointer_only_late,
+            self.skipped_busy,
+            self.skipped_edge,
+            f64::from(self.lead_us) / 1000.0,
+            self.interval.as_secs_f64() * 1000.0
+        );
+        line
+    }
+    /// A line every 10 s while samples come in (the owner's own use leaves a trace), from its own series.
+    pub fn maybe_line(&mut self) -> Option<String> {
+        if self.periodic.0.window_len() == 0 {
+            return None;
+        }
+        let at = *self.logged_at.get_or_insert_with(Instant::now);
+        if at.elapsed() < Duration::from_secs(10) {
+            return None;
+        }
+        self.logged_at = Some(Instant::now());
+        let (o, n, g) = (self.periodic.0.take_sorted(), self.periodic.1.take_sorted(), self.periodic.2.take_sorted());
+        Some(format!(
+            "WMCURSORTHREAD last pointer motion->flip {} | {} | {} | pointer_only on_time={} late={} lead_ms={:.2}",
+            crate::input_latency::window_text(&o, "oldest"),
+            crate::input_latency::window_text(&n, "newest"),
+            crate::input_latency::window_text(&g, "gap between flips moving the pointer"),
+            self.pointer_only_on_time,
+            self.pointer_only_late,
+            f64::from(self.lead_us) / 1000.0
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn the_thread_commits_its_lead_before_the_next_reachable_blank_and_learns_from_a_miss() {
+        let mut p = PlaneShare::default();
+        let t0 = Instant::now();
+        assert!(p.next_moment(t0).is_none(), "no flip seen yet: no phase");
+        p.flipped(t0);
+        let (at, blank) = p.next_moment(t0 + Duration::from_millis(1)).unwrap();
+        assert_eq!(blank, t0 + Duration::from_micros(16_667));
+        assert_eq!(at, blank - Duration::from_micros(u64::from(LEAD_START_US)));
+        // too late for that blank: the one after
+        let (_, later) = p.next_moment(t0 + Duration::from_millis(15)).unwrap();
+        assert_eq!(later, t0 + Duration::from_micros(2 * 16_667));
+        // a pointer-only commit by the thread shown a refresh late: more lead; its latency is counted
+        let motion = t0 + Duration::from_millis(2);
+        p.committed(Some(Point::new(5, 5)), Some(blank), true, true, Some((motion, motion)));
+        p.flipped(later);
+        assert_eq!((p.pointer_only_late, p.lead_us), (1, LEAD_START_US + 500));
+        let line = p.take_line();
+        assert!(line.contains("oldest n=1") && line.contains("late=1"), "{line}");
+        // on time: the lead comes back down slowly, never under the floor
+        p.committed(Some(Point::new(6, 5)), Some(later + Duration::from_micros(16_667)), true, true, None);
+        p.flipped(later + Duration::from_micros(16_667));
+        assert_eq!(p.lead_us, LEAD_START_US + 495);
+    }
+}
