diff --git a/crates/wm-darwin/src/pacing.rs b/crates/wm-darwin/src/pacing.rs
new file mode 100644
index 0000000..e6ab722
--- /dev/null
+++ b/crates/wm-darwin/src/pacing.rs
@@ -0,0 +1,157 @@
+//! A client's frames from its commit to the flip that shows them (DESK7, Firefox's pacing: it draws at
+//! 60 Hz but 45-57 frames a second reached the screen). For every window that commits GPU buffers
+//! (dma-bufs): how many it committed, how many were shown, how many were replaced by a newer one before
+//! any frame showed them (lost), how long from commit to flip, when in the refresh the commits came (ms
+//! after the last flip) and how often a frame waited for a client's fence. `WMPACING` every 10 s and in
+//! the inject `stats` step.
+use crate::input_latency::{window_text, Series};
+use std::collections::HashMap;
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+struct Window {
+    app_id: String,
+    commits: u64,
+    shown: u64,
+    replaced: u64,
+    /// The newest commit not drawn into a frame yet.
+    pending: Option<Instant>,
+    /// Drawn into frame `seq`, waiting for that frame's flip.
+    drawn: Option<(Instant, u64)>,
+    commit_to_flip: Series,
+    /// commits by ms after the last flip (0..16, 17 = later)
+    phase: [u32; 18],
+    last_commit: Option<Instant>,
+    intervals: Series,
+}
+
+#[derive(Default)]
+pub struct PacingTrace {
+    windows: HashMap<u64, Window>,
+    seq: u64,
+    in_flight: Option<u64>,
+    last_flip: Option<Instant>,
+    pub fence_holds: u64,
+    logged: Option<Instant>,
+}
+
+impl PacingTrace {
+    /// A client committed a GPU buffer to window `id`.
+    pub fn commit(&mut self, id: u64, app_id: Option<&str>) {
+        let now = Instant::now();
+        let last_flip = self.last_flip;
+        let w = self.windows.entry(id).or_default();
+        if let Some(app) = app_id {
+            if w.app_id != app {
+                w.app_id = app.to_string();
+            }
+        }
+        w.commits += 1;
+        if w.pending.replace(now).is_some() {
+            w.replaced += 1;
+        }
+        if let Some(flip) = last_flip {
+            let ms = now.saturating_duration_since(flip).as_millis().min(17) as usize;
+            w.phase[ms] += 1;
+        }
+        if let Some(last) = w.last_commit.replace(now) {
+            let d = now.saturating_duration_since(last);
+            if d < Duration::from_millis(250) {
+                w.intervals.sample(d);
+            }
+        }
+    }
+    /// A frame was drawn (rendered or staged): the pending commits are in it.
+    pub fn drawn(&mut self) {
+        self.seq += 1;
+        let seq = self.seq;
+        for w in self.windows.values_mut() {
+            if let Some(at) = w.pending.take() {
+                // a buffer drawn before but not flipped yet is replaced by this one on the screen
+                if w.drawn.replace((at, seq)).is_some() {
+                    w.replaced += 1;
+                }
+            }
+        }
+    }
+    /// The frame drawn last was committed to the display.
+    pub fn frame_committed(&mut self) {
+        self.in_flight = Some(self.seq);
+    }
+    /// The number of the frame drawn last.
+    pub fn seq(&self) -> u64 {
+        self.seq
+    }
+    /// A flip completed; when it was a frame's, its windows' buffers are on the screen (that frame's
+    /// number is returned).
+    pub fn flipped(&mut self, at: Instant) -> Option<u64> {
+        self.last_flip = Some(at);
+        let seq = self.in_flight.take()?;
+        for w in self.windows.values_mut() {
+            if let Some((commit, s)) = w.drawn {
+                if s <= seq {
+                    w.drawn = None;
+                    w.shown += 1;
+                    w.commit_to_flip.sample(at.saturating_duration_since(commit));
+                }
+            }
+        }
+        Some(seq)
+    }
+    pub fn gone(&mut self, id: u64) {
+        self.windows.remove(&id);
+    }
+    /// One line per window that committed since the last line.
+    pub fn take_lines(&mut self) -> Vec<String> {
+        self.logged = Some(Instant::now());
+        let fence = std::mem::take(&mut self.fence_holds);
+        let mut lines = Vec::new();
+        for (id, w) in self.windows.iter_mut() {
+            if w.commits == 0 {
+                continue;
+            }
+            let ctf = w.commit_to_flip.take_sorted();
+            let iv = w.intervals.take_sorted();
+            lines.push(format!(
+                "WMPACING window={id} app={:?} commits={} shown={} replaced_before_shown={} | {} | {} | commits by ms after the last flip {:?} | frames held for a fence={fence}",
+                w.app_id, w.commits, w.shown, w.replaced, window_text(&ctf, "commit->flip"), window_text(&iv, "commit interval"), w.phase
+            ));
+            w.commits = 0;
+            w.shown = 0;
+            w.replaced = 0;
+            w.phase = [0; 18];
+        }
+        lines
+    }
+    /// Every 10 s while a GPU client commits.
+    pub fn maybe_lines(&mut self) -> Vec<String> {
+        if self.windows.values().all(|w| w.commits == 0) {
+            return Vec::new();
+        }
+        let at = *self.logged.get_or_insert_with(Instant::now);
+        if at.elapsed() < Duration::from_secs(10) {
+            return Vec::new();
+        }
+        self.take_lines()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn commits_replaced_before_a_frame_shows_them_are_counted_as_lost() {
+        let mut p = PacingTrace::default();
+        p.commit(7, Some("org.mozilla.firefox"));
+        p.commit(7, None); // a second commit before any frame drew the first: lost
+        p.drawn();
+        p.frame_committed();
+        p.flipped(Instant::now());
+        p.commit(7, None);
+        p.drawn();
+        p.frame_committed();
+        p.flipped(Instant::now());
+        let line = p.take_lines().pop().unwrap();
+        assert!(line.contains("commits=3 shown=2 replaced_before_shown=1"), "{line}");
+    }
+}
diff --git a/crates/wm-darwin/src/pointer.rs b/crates/wm-darwin/src/pointer.rs
new file mode 100644
index 0000000..8b4922f
--- /dev/null
+++ b/crates/wm-darwin/src/pointer.rs
@@ -0,0 +1,139 @@
+//! The owner's pointer position, kept by the input thread (DESK7, item 2b).
+//!
+//! Measured on the M1 (desk7-002, synthetic `seat owner` streams): the pointer reached the screen only when
+//! the desktop's loop got round to it, and the loop was held by other work (a client's commits 12-22 ms, a
+//! repaint up to 99 ms with eight busy cores, wake-ups 17 ms late at user-interactive QoS, which these
+//! cores do not honour: pthread priority stays 31). So the position no longer waits for the loop: the
+//! input thread applies every record of the owner's device (and the instrument's `seat owner` records)
+//! here, and the cursor thread (`cursor_thread.rs`) places the pointer's plane from it at every refresh,
+//! whatever the loop does. The loop reads the same position for its clients (`Stamped::pos`), so both
+//! agree. The test instrument's own pointer (`seat virtual`) never comes here.
+use crate::hid::Motion;
+use std::sync::{Condvar, Mutex};
+use std::time::{Duration, Instant};
+
+#[derive(Debug)]
+struct State {
+    x: f64,
+    y: f64,
+    width: u32,
+    height: u32,
+    speed: f64,
+    seq: u64,
+    /// The oldest and newest motion not shown yet (for the motion -> flip latency).
+    pending: Option<(Instant, Instant)>,
+    /// The last record of the owner's device: the instrument's `seat owner` records do not move the
+    /// pointer within `crate::owner::ACTIVE_WINDOW` of one.
+    last_device: Option<Instant>,
+}
+
+#[derive(Debug)]
+pub struct PointerShared {
+    state: Mutex<State>,
+    moved: Condvar,
+}
+
+impl Default for PointerShared {
+    fn default() -> Self {
+        Self { state: Mutex::new(State { x: 0.0, y: 0.0, width: 0, height: 0, speed: 1.0, seq: 0, pending: None, last_device: None }), moved: Condvar::new() }
+    }
+}
+
+impl PointerShared {
+    fn lock(&self) -> std::sync::MutexGuard<'_, State> {
+        self.state.lock().unwrap_or_else(|e| e.into_inner())
+    }
+    /// A pointer record from the owner's device (or `seat owner`): the new position, panel pixels.
+    /// Before the screen size is known the record is passed on unapplied (`None`).
+    pub fn apply(&self, motion: Motion, at: Instant) -> Option<(f64, f64)> {
+        self.apply_from(motion, at, true)
+    }
+    /// `apply`, saying whether the record is the owner's device's (`false`: the instrument's `seat owner`,
+    /// which never moves the pointer while the owner is active).
+    pub fn apply_from(&self, motion: Motion, at: Instant, device: bool) -> Option<(f64, f64)> {
+        let mut s = self.lock();
+        if device {
+            s.last_device = Some(at);
+        } else if s.last_device.is_some_and(|t| at.saturating_duration_since(t) < crate::owner::ACTIVE_WINDOW) {
+            return None;
+        }
+        if s.width == 0 || s.height == 0 {
+            return None;
+        }
+        let (w, h) = (f64::from(s.width - 1), f64::from(s.height - 1));
+        let (x, y) = match motion {
+            Motion::Absolute(x, y) => (f64::from(x) * w / 65535.0, f64::from(y) * h / 65535.0),
+            Motion::Relative(x, y) => (s.x + f64::from(x) * s.speed, s.y + f64::from(y) * s.speed),
+        };
+        let (x, y) = (x.clamp(0.0, w), y.clamp(0.0, h));
+        if (x.floor(), y.floor()) != (s.x.floor(), s.y.floor()) {
+            s.seq += 1;
+            s.pending = Some(s.pending.map_or((at, at), |(o, n)| (o.min(at), n.max(at))));
+            self.moved.notify_all();
+        }
+        s.x = x;
+        s.y = y;
+        Some((x, y))
+    }
+    /// Where the pointer is drawn (whole panel pixels).
+    pub fn root(&self) -> wm_core::Point {
+        let s = self.lock();
+        wm_core::Point::new(s.x.floor() as i32, s.y.floor() as i32)
+    }
+    pub fn seq(&self) -> u64 {
+        self.lock().seq
+    }
+    /// The desktop's loop moved the pointer itself (several outputs: it stops at the edges there).
+    pub fn set(&self, x: f64, y: f64) {
+        let mut s = self.lock();
+        s.x = x;
+        s.y = y;
+    }
+    pub fn set_screen(&self, width: u32, height: u32) {
+        let mut s = self.lock();
+        s.width = width;
+        s.height = height;
+    }
+    pub fn set_speed(&self, factor: f64) {
+        self.lock().speed = factor;
+    }
+    /// The motions since the last call (a commit showing the newest position takes them).
+    pub fn take_motions(&self) -> Option<(Instant, Instant)> {
+        self.lock().pending.take()
+    }
+    /// Waits until the pointer moved past `seen` (or `timeout`); the sequence number now.
+    pub fn wait_motion(&self, seen: u64, timeout: Duration) -> u64 {
+        let s = self.lock();
+        if s.seq != seen {
+            return s.seq;
+        }
+        let (s, _) = self.moved.wait_timeout(s, timeout).unwrap_or_else(|e| e.into_inner());
+        s.seq
+    }
+    /// Wakes `wait_motion` (the cursor thread's stop).
+    pub fn wake(&self) {
+        self.moved.notify_all();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn records_move_the_shared_pointer_within_the_screen_at_the_owners_speed() {
+        let p = PointerShared::default();
+        let now = Instant::now();
+        assert_eq!(p.apply(Motion::Relative(5, 5), now), None, "no screen yet");
+        p.set_screen(2560, 1600);
+        assert_eq!(p.apply(Motion::Absolute(65535, 0), now), Some((2559.0, 0.0)));
+        assert_eq!(p.apply(Motion::Relative(10, -3), now), Some((2559.0, 0.0)), "kept on the screen");
+        p.set_speed(0.5);
+        assert_eq!(p.apply(Motion::Relative(-10, 4), now), Some((2554.0, 2.0)));
+        assert_eq!(p.root(), wm_core::Point::new(2554, 2));
+        let seq = p.seq();
+        assert!(p.take_motions().is_some());
+        assert!(p.take_motions().is_none());
+        p.apply(Motion::Relative(0, 0), now);
+        assert_eq!(p.seq(), seq, "no movement, no new sequence");
+    }
+}
