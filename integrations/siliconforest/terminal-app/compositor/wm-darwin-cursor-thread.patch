+fn cursor_thread(core: std::sync::Arc<std::sync::Mutex<KmsCore>>, pointer: std::sync::Arc<crate::pointer::PointerShared>, stop: std::sync::Arc<std::sync::atomic::AtomicBool>, wake: std::fs::File, card: libc::c_int) {
