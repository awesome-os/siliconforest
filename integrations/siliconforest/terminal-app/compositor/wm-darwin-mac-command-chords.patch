+/// The Command chords the desk keeps even when a Mac application has the keyboard: the desktop
+/// menu (Command-Space), Spaces by Tab (Command-Tab, -Shift-Tab, -Control-Tab), carrying and sending
+/// a window to a Space (Command-Shift-<digit>, Command-Option-Shift-<digit>) and the screenshots
+/// (Command-Control-Shift-3/4/5).
+fn desktop_chord(combo:KeyCombo)->bool{
+    let m=combo.modifiers;let k=combo.keysym;
+    let digit=(0x30..=0x39).contains(&k);
+    (m==Modifiers::SUPER && k==0x20)
+        || (k==0xff09 && (m==Modifiers::SUPER || m==Modifiers::SUPER|Modifiers::SHIFT || m==Modifiers::SUPER|Modifiers::CONTROL))
+        || (digit && (m==Modifiers::SUPER|Modifiers::SHIFT || m==Modifiers::SUPER|Modifiers::SHIFT|Modifiers::ALT))
+        || (matches!(k,0x33|0x34|0x35) && m==Modifiers::SUPER|Modifiers::CONTROL|Modifiers::SHIFT)
+}
 fn modifiers(m:&ModifiersState)->Modifiers {
     let mut out=Modifiers::empty();out.set(Modifiers::SHIFT,m.shift);out.set(Modifiers::CONTROL,m.ctrl);
     out.set(Modifiers::ALT,m.alt);out.set(Modifiers::SUPER,m.logo);out
