+- (NSString *)commonPrefixWithString:(NSString *)other options:(NSStringCompareOptions)options {
+    NSUInteger limit = MIN([self length], [other length]), i = 0;
+    BOOL insensitive = (options & NSCaseInsensitiveSearch) != 0;
+    while (i < limit) {
+        unichar a = [self characterAtIndex:i], b = [other characterAtIndex:i];
+        if (a != b && !(insensitive && a < 128 && b < 128 && tolower(a) == tolower(b)))
+            break;
