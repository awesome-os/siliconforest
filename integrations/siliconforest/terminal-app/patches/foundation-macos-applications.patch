+- (void)enumerateSubstringsInRange:(NSRange)range options:(NSUInteger)options
+                        usingBlock:(void (^)(NSString *substring, NSRange substringRange, NSRange enclosingRange, BOOL *stop))block {
+    // by: 0 lines, 1 paragraphs, 2 composed character sequences, 3 words, 4 sentences; 0x100 reverse, 0x200 no substring
+    NSUInteger by = options & 0xff;
+    BOOL reverse = (options & 0x100) != 0, omit = (options & 0x200) != 0;
+    NSMutableArray *pieces = [NSMutableArray array];      // pairs: substring range, enclosing range
+    NSUInteger end = NSMaxRange(range), at = range.location;
+    if (end > [self length])
+        end = [self length];
+    if (by == 2) {
+        while (at < end) {
+            NSRange r = [self rangeOfComposedCharacterSequenceAtIndex:at];
+            [pieces addObject:[NSValue valueWithRange:r]];
+            [pieces addObject:[NSValue valueWithRange:r]];
+            at = NSMaxRange(r);
+        }
+    } else if (by == 3 || by == 4) {
+        // words: runs of letters and digits; sentences: runs up to a full stop, mark or line end
+        NSCharacterSet *separators = by == 3 ? [[NSCharacterSet alphanumericCharacterSet] invertedSet]
+                                             : [NSCharacterSet characterSetWithCharactersInString:@".!?\n"];
+        while (at < end) {
+            NSRange sep = [self rangeOfCharacterFromSet:separators options:0 range:NSMakeRange(at, end - at)];
+            NSUInteger stopAt = sep.location == NSNotFound ? end : sep.location;
+            NSUInteger next = sep.location == NSNotFound ? end : NSMaxRange(sep);
+            if (stopAt > at) {
+                [pieces addObject:[NSValue valueWithRange:NSMakeRange(at, stopAt - at)]];
+                [pieces addObject:[NSValue valueWithRange:NSMakeRange(at, next - at)]];
+            }
+            at = next;
+        }
+    } else {
+        while (at < end) {
+            NSUInteger lineStart = at, lineEnd = at, contentsEnd = at;
+            [self getLineStart:&lineStart end:&lineEnd contentsEnd:&contentsEnd forRange:NSMakeRange(at, 0)];
+            if (lineEnd > end) lineEnd = end;
+            if (contentsEnd > end) contentsEnd = end;
+            if (lineStart < range.location) lineStart = range.location;
+            [pieces addObject:[NSValue valueWithRange:NSMakeRange(lineStart, contentsEnd - lineStart)]];
+            [pieces addObject:[NSValue valueWithRange:NSMakeRange(lineStart, lineEnd - lineStart)]];
+            if (lineEnd <= at)
+                break;
+            at = lineEnd;
+        }
+    }
+    NSUInteger count = [pieces count] / 2;
+    for (NSUInteger n = 0; n < count; n++) {
+        NSUInteger i = reverse ? count - 1 - n : n;
+        NSRange sub = [[pieces objectAtIndex:i * 2] rangeValue], enclosing = [[pieces objectAtIndex:i * 2 + 1] rangeValue];
+        BOOL stop = NO;
+        block(omit ? nil : [self substringWithRange:sub], sub, enclosing, &stop);
+        if (stop)
+            break;
+    }
+}
