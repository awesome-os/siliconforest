+// Resource values a file system can answer here: name, path, directory, regular file, symbolic link
+- (BOOL)getResourceValue:(id *)value forKey:(NSString *)key error:(NSError **)error {
+    if (value != NULL)
+        *value = nil;
+    if (![self isFileURL] || key == nil)
+        return YES;
+    NSString *path = [self path];
+    NSDictionary *attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:path error:error];
+    if (attributes == nil)
+        return NO;
+    NSString *type = [attributes objectForKey:NSFileType];
+    id answer = nil;
+    if ([key isEqualToString:@"NSURLNameKey"] || [key isEqualToString:@"NSURLLocalizedNameKey"])
+        answer = [path lastPathComponent];
+    else if ([key isEqualToString:@"_NSURLPathKey"])
+        answer = path;
+    else if ([key isEqualToString:@"NSURLIsDirectoryKey"])
+        answer = [NSNumber numberWithBool:[type isEqualToString:NSFileTypeDirectory]];
+    else if ([key isEqualToString:@"NSURLIsRegularFileKey"])
+        answer = [NSNumber numberWithBool:[type isEqualToString:NSFileTypeRegular]];
+    else if ([key isEqualToString:@"NSURLIsSymbolicLinkKey"])
+        answer = [NSNumber numberWithBool:[type isEqualToString:NSFileTypeSymbolicLink]];
+    else if ([key isEqualToString:@"NSURLIsAliasFileKey"])
+        answer = [NSNumber numberWithBool:NO];
+    else if ([key isEqualToString:@"NSURLFileSizeKey"])
+        answer = [attributes objectForKey:NSFileSize];
+    else if ([key isEqualToString:@"NSURLContentModificationDateKey"])
+        answer = [attributes objectForKey:NSFileModificationDate];
+    if (value != NULL)
+        *value = answer;
+    return YES;
+}
