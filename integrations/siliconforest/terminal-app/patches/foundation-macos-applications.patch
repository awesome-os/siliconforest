+        return values;
+    if ([name isEqualToString:@"@distinctUnionOfObjects"])
+        return [[NSSet setWithArray:values] allObjects];
+    if ([name isEqualToString:@"@sum"] || [name isEqualToString:@"@avg"]) {
+        double total = 0;
+        for (id value in values)
+            total += [value doubleValue];
+        if ([name isEqualToString:@"@avg"])
+            return [values count] ? [NSNumber numberWithDouble:total / (double)[values count]] : [NSNumber numberWithInt:0];
