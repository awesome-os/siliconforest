+// The enumerator of -enumeratorAtPath: gives relative paths; this one gives file URLs under the
+// directory. Options: 1 skip descendants of subdirectories, 4 skip hidden files.
+// (TERM8) the name to show for a path: its last component, an application bundle without ".app" (there is no
+// localized Finder name or extension hiding preference here)
+- (NSString *)displayNameAtPath:(NSString *)path {
+    NSString *name = [path lastPathComponent];
+    if ([[name pathExtension] isEqualToString:@"app"])
+        name = [name stringByDeletingPathExtension];
+    return name;
