+/* An instance variable that is not an object, read and written in place: key-value coding reaches
+ * `_key` and `key` of any type where the class has no accessor (macOS does; an application that
+ * binds a scalar property it only declares as an instance variable depends on it). */
+static id boxedIvar(id self, Ivar ivar, const char *type) {
+    const void *at = (const char *)self + ivar_getOffset(ivar);
+
+    switch (type[0]) {
+        case 'c': return [NSNumber numberWithChar:*(const char *)at];
+        case 'C': return [NSNumber numberWithUnsignedChar:*(const unsigned char *)at];
+        case 's': return [NSNumber numberWithShort:*(const short *)at];
+        case 'S': return [NSNumber numberWithUnsignedShort:*(const unsigned short *)at];
+        case 'i': return [NSNumber numberWithInt:*(const int *)at];
+        case 'I': return [NSNumber numberWithUnsignedInt:*(const unsigned *)at];
+        case 'l': return [NSNumber numberWithLong:*(const long *)at];
+        case 'L': return [NSNumber numberWithUnsignedLong:*(const unsigned long *)at];
+        case 'q': return [NSNumber numberWithLongLong:*(const long long *)at];
+        case 'Q': return [NSNumber numberWithUnsignedLongLong:*(const unsigned long long *)at];
+        case 'f': return [NSNumber numberWithFloat:*(const float *)at];
+        case 'd': return [NSNumber numberWithDouble:*(const double *)at];
+        case 'B': return [NSNumber numberWithBool:*(const BOOL *)at];
+        case '{': return [NSValue valueWithBytes:at objCType:type];
+        default: return nil;
+    }
