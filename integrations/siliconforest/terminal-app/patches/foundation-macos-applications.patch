+- (NSRange)rangeOfCharacterFromSet:(NSCharacterSet *)set options:(NSStringCompareOptions)options range:(NSRange)range {
+    NSUInteger length = [self length];
+    if (set == nil || range.location > length || range.length > length - range.location)
+        return NSMakeRange(NSNotFound, 0);
+    BOOL backwards = (options & NSBackwardsSearch) != 0;
+    BOOL anchored = (options & NSAnchoredSearch) != 0;
+    NSUInteger count = anchored ? (range.length > 0 ? 1 : 0) : range.length;
+    for (NSUInteger step = 0; step < count; step++) {
+        NSUInteger index = backwards ? NSMaxRange(range) - 1 - step : range.location + step;
+        unichar c = [self characterAtIndex:index];
+        // a surrogate pair is one character of the set's domain
+        if (c >= 0xD800 && c <= 0xDBFF && index + 1 < NSMaxRange(range)) {
+            unichar low = [self characterAtIndex:index + 1];
+            if (low >= 0xDC00 && low <= 0xDFFF) {
+                uint32_t full = 0x10000 + (((uint32_t)c - 0xD800) << 10) + (low - 0xDC00);
+                if (CFCharacterSetIsLongCharacterMember((CFCharacterSetRef)set, full))
+                    return NSMakeRange(index, 2);
+                continue;
+            }
+        }
+        if ([set characterIsMember:c])
+            return NSMakeRange(index, 1);
+    }
+    return NSMakeRange(NSNotFound, 0);
+}
+
+- (NSRange)rangeOfCharacterFromSet:(NSCharacterSet *)set options:(NSStringCompareOptions)options {
+    return [self rangeOfCharacterFromSet:set options:options range:NSMakeRange(0, [self length])];
+}
+
+- (NSRange)rangeOfComposedCharacterSequenceAtIndex:(NSUInteger)index {
+    if (index >= [self length])
+        [NSException raise:NSRangeException format:@"-[NSString rangeOfComposedCharacterSequenceAtIndex:]: index %lu beyond length %lu",
+                           (unsigned long)index, (unsigned long)[self length]];
+    CFRange r = CFStringGetRangeOfComposedCharactersAtIndex((CFStringRef)self, (CFIndex)index);
+    return NSMakeRange((NSUInteger)r.location, (NSUInteger)r.length);
+}
+
+- (NSRange)rangeOfComposedCharacterSequencesForRange:(NSRange)range {
+    NSUInteger length = [self length];
+    if (range.location >= length)
+        return NSMakeRange(length, 0);
+    NSRange first = [self rangeOfComposedCharacterSequenceAtIndex:range.location];
+    if (range.length == 0)
+        return NSMakeRange(first.location, 0);
+    NSUInteger last = NSMaxRange(range) - 1;
+    if (last >= length)
+        last = length - 1;
+    NSRange end = [self rangeOfComposedCharacterSequenceAtIndex:last];
+    return NSMakeRange(first.location, NSMaxRange(end) - first.location);
+}
