+    @synchronized([NSBundle class]) {
+        if (tables == nil)
+            tables = [[NSMutableDictionary alloc] init];
+        table = [tables objectForKey:path];
+        if (table == nil) {
+            NSDictionary *all = [NSDictionary dictionaryWithContentsOfFile:path];
+
+            table = [NSNull null];
+            if ([all isKindOfClass:[NSDictionary class]]) {
+                // the user's preferred localization among those the table has, then English
+                NSMutableArray *have = [NSMutableArray array];
