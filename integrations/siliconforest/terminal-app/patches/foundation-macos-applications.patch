+static id kvcOperate(id collection, NSString *name, NSString *keyPath) {
+    NSArray *items = [collection isKindOfClass:[NSArray class]] ? collection : [collection allObjects];
+    if ([name isEqualToString:@"@count"])
+        return [NSNumber numberWithUnsignedInteger:[items count]];
