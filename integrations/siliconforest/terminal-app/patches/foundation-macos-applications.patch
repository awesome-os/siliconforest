+/* SPDX-License-Identifier: MIT
+ * SiliconForest: put in front of every source of this Foundation (-include, ../../../../terminal-app/
+ * build-foundation.nix). SiliconForest's CoreFoundation autoreleases only objects it does not own
+ * itself: for its own instances (every CFArray, CFString, CFDictionary... this Foundation hands out)
+ * CFAutorelease returns the object and nothing releases it (the Linux runtime's hook, argon_cf, is
+ * not there on Darwin). Every convenience constructor of this Foundation leaked its object. Here
+ * CFAutorelease sends -autorelease, as macOS's does (objc_autorelease): the pool sends -release,
+ * and the bridged classes hand that to CFRelease.
+ */
+#ifndef SF_AUTORELEASE_CF_H
+#define SF_AUTORELEASE_CF_H
+#include <CoreFoundation/CFBase.h>
+#ifdef __OBJC__
+#import <objc/message.h>
+static inline CFTypeRef SFCFAutorelease(CFTypeRef cf)
+{
+    return cf ? (CFTypeRef)((id (*)(id, SEL))objc_msgSend)((id)cf, @selector(autorelease)) : cf;
+}
+#define CFAutorelease(cf) SFCFAutorelease(cf)
+#endif
+#endif
