+                for (NSString *name in all)
+                    if ([[all objectForKey:name] isKindOfClass:[NSDictionary class]])
+                        [have addObject:name];
+                for (NSString *name in [[NSBundle preferredLocalizationsFromArray:have] arrayByAddingObjectsFromArray:@[ @"en", @"English", @"Base" ]]) {
+                    id chosen = [all objectForKey:name];
+
+                    if ([chosen isKindOfClass:[NSDictionary class]]) {
+                        table = chosen;
+                        break;
+                    }
+                }
+            }
+            [tables setObject:table forKey:path];
+        }
+    }
+    if (table == (id)[NSNull null])
+        return nil;
+
+    id text = [(NSDictionary *)table objectForKey:key];
