+/* Where -valueForKey: finds a key of a class: its getter, its instance variable, or neither
+ * (-valueForUndefinedKey:). The search formats up to nine method and variable names and asks the
+ * runtime for each; a terminal reads a few keys of the same objects thousands of times a second
+ * while it draws. Apple's key-value coding keeps the same answers. Classes that answer
+ * -respondsToSelector: themselves are searched each time; every answer is forgotten when an image
+ * is loaded (a bundle's categories may add accessors). */
+typedef struct { Class cls; char *name; unsigned hash; SEL getter; Ivar ivar; } SFKVCEntry;
+// says that this library keeps the answers (the installer's probe asks for it: sf-kvo-probe)
+__attribute__((visibility("default"))) const int SFFoundationKeyValueCodingCache = 1;
+#define SFKVC_SLOTS 4096
+static SFKVCEntry *kvcTable;
+static unsigned kvcCount;
+static pthread_mutex_t kvcLock = PTHREAD_MUTEX_INITIALIZER;
+
+static unsigned kvcHash(Class cls, const char *name) {
+    unsigned hash = (unsigned)((uintptr_t)cls >> 3) * 2654435761u;
+
+    while (*name)
+        hash = hash * 31 + (unsigned char)*name++;
+    return hash;
+}
+
+static void kvcForgetLocked(void) {
+    if (kvcTable == NULL)
+        return;
+    for (unsigned i = 0; i < SFKVC_SLOTS; i++)
+        free(kvcTable[i].name);
+    memset(kvcTable, 0, sizeof(SFKVCEntry) * SFKVC_SLOTS);
+    kvcCount = 0;
+}
+
+static void kvcImageAdded(const struct mach_header *header, intptr_t slide) {
+    pthread_mutex_lock(&kvcLock);
+    kvcForgetLocked();
+    pthread_mutex_unlock(&kvcLock);
+}
+
+static BOOL kvcCached(Class cls, const char *name, SEL *getter, Ivar *ivar) {
+    BOOL hit = NO;
+    unsigned hash = kvcHash(cls, name);
+
+    pthread_mutex_lock(&kvcLock);
+    if (kvcTable != NULL) {
+        for (unsigned i = 0; i < SFKVC_SLOTS; i++) {
+            SFKVCEntry *entry = &kvcTable[(hash + i) % SFKVC_SLOTS];
+
+            if (entry->cls == Nil)
+                break;
+            if (entry->cls == cls && entry->hash == hash && strcmp(entry->name, name) == 0) {
