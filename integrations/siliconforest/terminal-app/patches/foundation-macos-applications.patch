-/* Returns whatever can be read without blocking further; for a regular file
- * that is the rest of the file. */
+/* As Apple's: for a regular file the rest of the file; for a pipe, socket or terminal what one read
+ * gives once something is there (it waits for that), an empty data at the end. It read to the end of
+ * the stream, so a reader called as data arrived (a readability handler) got nothing until the writer
+ * had finished. */
 - (NSData *)availableData {
-    return [self readDataToEndOfFile];
+    struct stat st;
+
+    if (fstat(_fd, &st) == 0 && S_ISREG(st.st_mode)) {
+        return [self readDataToEndOfFile];
+    }
+
+    unsigned char chunk[65536];
+    ssize_t got;
+
+    do {
+        got = read(_fd, chunk, sizeof(chunk));
+    } while (got < 0 && errno == EINTR);
+    return got > 0 ? [NSData dataWithBytes:chunk length:(NSUInteger)got] : [NSData data];
+}
+
+/* Apple's readabilityHandler: called on a background queue, one call at a time, whenever the
+ * descriptor has something to read (the end of a pipe included: -availableData then gives empty data
+ * and the caller sets the handler to nil). Activity Monitor reads `sample`'s report this way; the
+ * message went nowhere, the report never came and its progress sheet stayed. */
+- (void (^)(NSFileHandle *))readabilityHandler {
+    void (^handler)(NSFileHandle *);
+
+    @synchronized(self) {
+        handler = [[_readabilityHandler retain] autorelease];
+    }
+    return handler;
+}
+
+- (void)setReadabilityHandler:(void (^)(NSFileHandle *))handler {
+    @synchronized(self) {
+        if (_readSource != NULL) {
+            dispatch_source_cancel(_readSource);
+            dispatch_release(_readSource);
+            _readSource = NULL;
+        }
+        void (^old)(NSFileHandle *) = _readabilityHandler;
+        _readabilityHandler = [handler copy];
+        [old release];
+        if (handler != nil && _fd >= 0) {
+            NSFileHandle *handle = self;
+
+            _readSource = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, (uintptr_t)_fd, 0,
+                                                 dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0));
+            // the source's handler keeps the file handle until the handler is replaced
+            dispatch_source_set_event_handler(_readSource, ^{
+                void (^call)(NSFileHandle *) = [handle readabilityHandler];
+
+                if (call != nil) {
+                    call(handle);
+                }
+            });
+            dispatch_resume(_readSource);
+        }
+    }
