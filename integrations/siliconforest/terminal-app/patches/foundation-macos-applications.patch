+
+- (NSEnumerator *)enumeratorAtURL:(NSURL *)url includingPropertiesForKeys:(NSArray *)keys options:(NSUInteger)options
+                     errorHandler:(BOOL (^)(NSURL *url, NSError *error))handler {
+    NSString *base = [url path];
+    NSMutableArray *urls = [NSMutableArray array];
+    NSDirectoryEnumerator *walk = [self enumeratorAtPath:base];
+    for (NSString *relative in walk) {
+        if ((options & 4) && [[relative lastPathComponent] hasPrefix:@"."]) {
+            [walk skipDescendants];
+            continue;
+        }
+        if ((options & 1) && [[relative pathComponents] count] > 1)
+            continue;
+        [urls addObject:[NSURL fileURLWithPath:[base stringByAppendingPathComponent:relative]]];
+    }
+    return [urls objectEnumerator];
+}
