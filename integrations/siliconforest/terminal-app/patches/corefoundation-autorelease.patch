--- a/Base.subproj/CFRuntime.c
+++ b/Base.subproj/CFRuntime.c
@@ -969,6 +969,12 @@
 #if ARGON_LIBOBJC2
     // a CF-owned object still goes in the pool, whose -release reaches CFRelease through argon_cf
     if (argon_cf.owns != NULL && argon_cf.owns(cf)) return (CFTypeRef)objc_autorelease((id)cf);
+#elif DEPLOYMENT_RUNTIME_OBJC
+    // SiliconForest: on Darwin CF's own instances are Objective-C objects too (__NSCFType, a bridged
+    // class, a constant string: CF-owned classes), so they go in the pool as on macOS; the pool's
+    // -release reaches CFRelease through those classes. Returned as they were, every CFAutorelease of
+    // a CF object leaked it.
+    if (((uintptr_t)cf & 7) == 0 && ((const CFRuntimeBase *)cf)->_cfisa != 0) return (CFTypeRef)objc_autorelease((id)cf);
 #endif
     return cf;
 }
