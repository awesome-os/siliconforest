<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT
     /System/Library/FeatureFlags/Domain/Terminal.plist on SiliconForest (GitHub issue 52).
     Terminal.app asks one feature flag, os_feature_enabled(Terminal, DirectColor), when it starts
     a shell: yes turns on 24-bit colour (SGR 38;2 and 48;2 drawn as given, COLORTERM=truecolor).
     macOS 26.5 has it on (DevelopmentPhase FeatureComplete); so here. -->
<plist version="1.0">
<dict>
	<key>DirectColor</key>
	<dict>
		<key>DevelopmentPhase</key>
		<string>FeatureComplete</string>
	</dict>
</dict>
</plist>
