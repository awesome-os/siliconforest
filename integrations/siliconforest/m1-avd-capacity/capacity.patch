+sf_sysctl_contexts(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+    char text[3072];size_t used=0;uint64_t freeBytes=0,largest=0;
+    IOLockLock(gLock);
+    gDart.space(&freeBytes,&largest);
+    used=(size_t)snprintf(text,sizeof(text),"version=1 span_kib=%llu mapped_kib=%llu free_kib=%llu largest_free_kib=%llu poisoned=%u\n",
+        SF_AVD_DART_SPAN/1024,gDart.mappedBytes/1024,freeBytes/1024,largest/1024,(unsigned)gDart.poisoned);
+    for(unsigned i=0;i<MAX_CONTEXTS && used<sizeof(text);i++) {
+        Context *c=&gContexts[i];if(!c->session)continue;
+        proc_t p=proc_find(c->owner);bool live=p && proc_task(p)==c->ownerTask;if(p)proc_rele(p);
+        uint64_t capture=0,prepared=0;
+        for(unsigned b=0;b<c->buffers;b++) {
+            void *cpu=NULL,*cookie=NULL;size_t bytes=0;
+            if(!sf_avd_session_buffer(c->session,b,&cpu,&bytes,&cookie)&&cookie) {
+                DmaCookie *d=(DmaCookie *)cookie;uint64_t rounded=(d->bytes+16383)&~(size_t)16383;
+                if(d->iova)capture+=rounded;if(d->prepared)prepared+=rounded;
+            }
+        }
+        int n=snprintf(text+used,sizeof(text)-used,
+            "ctx=%u generation=%llu pid=%d task_live=%u codec=0x%x width=%u height=%u buffers=%u imported=%u submitted=%u mapped_kib=%llu capture_iova_kib=%llu imported_iova_kib=%llu prepared_kib=%llu\n",
+            i,c->generation,c->owner,(unsigned)live,c->codec,c->format.width,c->format.height,c->buffers,
+            (unsigned)c->imported,(unsigned)c->submitted,c->mappedBytes/1024,capture/1024,
+            c->imported?capture/1024:0,prepared/1024);
+        if(n<0 || (size_t)n>=sizeof(text)-used){used=sizeof(text)-1;break;}used+=(size_t)n;
+    }
+    IOLockUnlock(gLock);
+    return SYSCTL_OUT(req,text,used+1);
+}
