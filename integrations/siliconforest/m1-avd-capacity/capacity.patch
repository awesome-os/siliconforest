+/* Diagnostic only; gLock -> DART lock is the existing allocation lock order. */
+void SFAvdDart::space(uint64_t *freeBytes, uint64_t *largestBytes)
+{
+    *freeBytes=0;*largestBytes=0;
+    if (!lock || !bitmap) return;
+    IOLockLock(lock);
+    uint32_t total=0,largest=0,run=0;
+    for (uint32_t p=0;p<pages;p++) {
+        if (bitmap[p/8] & (1u<<(p%8))) run=0;
+        else {total++;run++;if(run>largest)largest=run;}
+    }
+    *freeBytes=(uint64_t)total<<PAGE_SHIFT_16K;
+    *largestBytes=(uint64_t)largest<<PAGE_SHIFT_16K;
+    IOLockUnlock(lock);
+}
