+/// SiliconForest: where a parameter's value comes from.
+///
+/// There is no `__param` section walker, `modprobe` or sysfs under a kext. A parameter `p` of
+/// module `m` is read once, when the module initialises, from the xnu boot-arg `m.p=value`
+/// (the spelling Linux uses for a built-in module's parameter on the kernel command line),
+/// and parsed by the same [`ModuleParam::try_from_param_arg`] as on Linux. As there, a value
+/// that does not parse is reported and the default stays. Parameters cannot be changed
+/// afterwards (on Linux these are read-only too: `perm` is 0 and there is no `get`).
+#[cfg(sf_lkpi)]
+impl<T: ModuleParam> ModuleParamAccess<T> {
+    /// Sets the value from the boot-arg `name` if it is present. Called by `module!`.
+    #[doc(hidden)]
+    pub fn sf_set_from_boot_arg(&self, name: &CStr) {
+        let mut buf = [0u8; 64];
+        // SAFETY: `name` is NUL terminated and `buf` is valid for writes of `buf.len()` bytes;
+        // the helper NUL terminates what it writes.
+        let found = unsafe {
+            bindings::sf_boot_arg_str(name.as_char_ptr(), buf.as_mut_ptr().cast(), buf.len() as c_int)
+        };
+        if !found {
+            return;
+        }
+        let len = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());
+        let shown = name.to_str().unwrap_or("?");
+        match T::try_from_param_arg(BStr::from_bytes(&buf[..len])) {
+            Ok(value) => {
+                if !self.value.populate(value) {
+                    crate::pr_warn!("module parameter {}: already set\n", shown);
+                }
+            }
+            Err(_) => crate::pr_warn!(
+                "module parameter {}: invalid value, keeping the default\n",
+                shown
+            ),
+        }
+    }
+}
