# m1-lkpi-extras: appended to ../m1-rust-kext/lkpi/bindgen_parameters_pd.

# LinuxKPI's own xarray functions of these names take a uint32_t index and differ from
# Linux in error codes (linux/sf_xarray.h). rust/kernel/xarray.rs gets the helpers of the
# same names instead (helpers/xarray.c), which have Linux's signatures.
--blocklist-function xa_load
--blocklist-function __xa_erase
--blocklist-function __xa_store
--blocklist-function __xa_insert
--blocklist-function __xa_alloc

# LinuxKPI's seq_printf is a macro; lkpi_seq_printf does not know %pA (helpers/sf_extras.c).
# The sf_xa_* functions are reached through the helpers only.
--blocklist-function 'sf_xa_.*'
--blocklist-function 'sf___xa_.*'
