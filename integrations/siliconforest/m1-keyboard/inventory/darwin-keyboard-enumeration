#!/bin/sh
# Unattended registry/driver-start observation only. No keyboard prompt or read.
set -eu
nonce=${1-}
case "$nonce" in ''|*[!0-9a-f]*) exit 2 ;; esac
[ "${#nonce}" -eq 48 ] || exit 2
printf '\nDLKE_BEGIN_%s\n' "$nonce"
if /usr/bin/darwin-keyboard-inventory --require-native-keyboard; then
    printf '\nDLKE_SERVICE_PRESENT_%s\n' "$nonce"
else
    printf '\nDLKE_NOT_READY_%s\n' "$nonce"
    exit 77
fi
# A registered service is no proof of native typing or actual input delivery.
printf '\nDLKE_END_%s\n' "$nonce"
