#!/bin/sh
# Runs from md0. Never opens a HID queue, injects keys or touches native storage.
set -eu
nonce=${1-}
case "$nonce" in ''|*[!0-9a-f]*) exit 2 ;; esac
[ "${#nonce}" -eq 48 ] || exit 2
printf '\nDLK_BEGIN_%s\n' "$nonce"
/usr/bin/darwin-keyboard-inventory || printf '\nDLK_INVENTORY_FAILED_%s\n' "$nonce"
printf '\nDLK_READY_%s\nType m1keyboard on the BUILT-IN keyboard, then Return.\n' "$nonce"
IFS= read -r typed
if [ "$typed" = m1keyboard ]; then
    printf '\nDLK_TYPED_%s\n' "$nonce"
else
    printf '\nDLK_MISMATCH_%s\n' "$nonce"
    exit 1
fi
# The host records native-driver first-report evidence and physical observation
# separately. A matched line alone is never a claim of physical keyboard input.
