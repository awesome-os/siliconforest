#!/bin/sh
set -eu
[ "$#" -eq 1 ] || exit 2
nonce=$1
[ "${#nonce}" -eq 48 ] || exit 2
case "$nonce" in *[!0-9a-f]*) exit 2;; esac
printf '\nDL31_APCIE_TEST_BEGIN_%s scope=READ_ONLY_PORT_SNAPSHOT_NOT_WIFI\n' "$nonce"
rc=0
if /usr/bin/darwin-apcie-port-observe --nonce "$nonce"; then :; else rc=$?; fi
printf 'DL31_APCIE_COLLECTED_%s rc=%s\n' "$nonce" "$rc"
case "$rc" in
    0) result=OBSERVED;;
    77) result=GUARDED_NOT_READY;;
    *) printf 'DL31_APCIE_FAILED_%s collector_rc=%s\n' "$nonce" "$rc"; exit 1;;
esac
printf 'DL31_APCIE_STATUS_%s result=%s collector_rc=%s\n' "$nonce" "$result" "$rc"
printf '\nREAD-ONLY PCIE PORT SNAPSHOT RETURNED - NO INITIALIZATION OR WIFI CLAIM\n'
printf 'DL31_APCIE_RETURN_%s\n' "$nonce"
/bin/uname -s
/bin/uname -m
/bin/uname -r
printf 'DL31_APCIE_TEST_END_%s result=%s collector_rc=%s\n' "$nonce" "$result" "$rc"
