+#ifndef AVUTIL_HWCONTEXT_SFAVD_H
+#define AVUTIL_HWCONTEXT_SFAVD_H
+
+/**
+ * @file
+ * An API-specific header for AV_HWDEVICE_TYPE_SFAVD: the Apple Video Decoder of Apple
+ * Silicon through SiliconForest's /dev/sfavd (libsfavd).
+ *
+ * The decoder is stateless and writes into buffers that belong to one decoder context,
+ * which is created for a codec and a coded size. A frames context therefore is one
+ * decoder context with its fixed set of decoded buffers.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct AVFrame;
+
+/**
+ * This struct is allocated as AVHWDeviceContext.hwctx
+ */
+typedef struct AVPDAVDDeviceContext {
+    /**
+     * The open device (a sfavd_dev *). Owned by the device context.
+     */
+    void *dev;
+
+    /**
+     * If set (before decoding starts), called with each picture as soon as the
+     * hardware has finished it, that is in decoding order, before the decoder's
+     * reordering: for callers that present or reorder pictures themselves. The
+     * frame is the decoder's own (AV_PIX_FMT_SFAVD, coded size with its cropping
+     * fields set, opaque_ref of its packet when AV_CODEC_FLAG_COPY_OPAQUE is used);
+     * it may be referenced with av_frame_ref(). Called on the decoding thread.
+     * Pictures that are never shown (VP9) are reported too; frames that are shown
+     * again without being decoded are not.
+     */
+    void (*picture_decoded)(void *opaque, const struct AVFrame *frame);
+    void *picture_decoded_opaque;
+} AVPDAVDDeviceContext;
+
+#define AV_SFAVD_FORMAT_CTRL_MAX 2048
+
+/**
+ * This struct is allocated as AVHWFramesContext.hwctx
+ *
+ * The first three fields are set (by the decoder's frame_params) before
+ * av_hwframe_ctx_init(); the rest is filled by it.
+ */
+typedef struct AVPDAVDFramesContext {
+    /** SFAVD_CODEC_* */
+    uint32_t codec;
+    /** The control that decides the decoded format (the SPS, the VP9 frame header). */
+    uint32_t format_ctrl_id;
+    uint32_t format_ctrl_size;
+    uint8_t  format_ctrl[AV_SFAVD_FORMAT_CTRL_MAX];
+
+    /** The decoder context number. */
+    uint32_t ctx;
+    /** Layout of the decoded buffers. */
+    uint32_t pixelformat;
+    uint32_t width, height;
+    uint32_t bytesperline;
+    uint32_t uv_offset;
+    uint32_t sizeimage;
+    /** Number of decoded buffers. */
+    uint32_t nb_buffers;
+    /** Names the pictures of this context for references; incremented per picture. */
+    uint64_t timestamp;
+} AVPDAVDFramesContext;
+
+/**
+ * data[0] of an AV_PIX_FMT_SFAVD frame points to one of these.
+ */
+typedef struct AVPDAVDFrame {
+    uint32_t       ctx;
+    /** Decoded buffer of the context. */
+    uint32_t       index;
+    /** Read-only mapping of the buffer: luma at 0, interleaved chroma at uv_offset. */
+    const uint8_t *data;
+    size_t         size;
+    /** The timestamp of the decode that last wrote this buffer. */
+    uint64_t       timestamp;
+} AVPDAVDFrame;
+
+#endif /* AVUTIL_HWCONTEXT_SFAVD_H */
