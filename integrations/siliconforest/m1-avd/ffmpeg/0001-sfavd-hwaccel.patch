diff -ruN a/libavcodec/sfavd.c b/libavcodec/sfavd.c
--- a/libavcodec/sfavd.c	1969-12-31 16:00:00.000000000 -0800
+++ b/libavcodec/sfavd.c	2026-11-12 00:52:29.217958553 -0800
@@ -0,0 +1,182 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config.h"
+
+#include <errno.h>
+#include <string.h>
+
+#include "libavutil/hwcontext.h"
+#include "libavutil/mem.h"
+
+#include "decode.h"
+#include "hwaccel_internal.h"
+#include "internal.h"
+#include "sfavd.h"
+
+static SFAVDContext *sfavd_context(AVCodecContext *avctx)
+{
+    return avctx->internal->hwaccel_priv_data;
+}
+
+int ff_sfavd_frame_params(AVCodecContext *avctx, AVBufferRef *hw_frames_ctx,
+                          uint32_t codec, uint32_t ctrl_id, const void *ctrl,
+                          size_t ctrl_size, int refs)
+{
+    AVHWFramesContext *hwfc = (AVHWFramesContext *)hw_frames_ctx->data;
+    AVPDAVDFramesContext *fctx = hwfc->hwctx;
+
+    if (!ctrl || ctrl_size > AV_SFAVD_FORMAT_CTRL_MAX)
+        return AVERROR(EINVAL);
+
+    fctx->codec = codec;
+    fctx->format_ctrl_id = ctrl_id;
+    fctx->format_ctrl_size = ctrl_size;
+    memcpy(fctx->format_ctrl, ctrl, ctrl_size);
+
+    hwfc->format = AV_PIX_FMT_SFAVD;
+    hwfc->sw_format = AV_PIX_FMT_NV12;   /* replaced by the device's answer */
+    hwfc->width = avctx->coded_width;
+    hwfc->height = avctx->coded_height;
+    /*
+     * References, the picture being decoded, pictures waiting for output in the
+     * decoder, and a few in the hands of the caller (ff_decode_get_hw_frames_ctx()
+     * adds 3 more, the caller its extra_hw_frames).
+     */
+    hwfc->initial_pool_size = refs + 1 + avctx->has_b_frames + 2;
+    return 0;
+}
+
+int ff_sfavd_init(AVCodecContext *avctx)
+{
+    SFAVDContext *ctx = sfavd_context(avctx);
+    AVHWFramesContext *hwfc;
+    AVPDAVDDeviceContext *dev;
+    AVPDAVDFramesContext *fctx;
+    int ret;
+
+    ret = ff_decode_get_hw_frames_ctx(avctx, AV_HWDEVICE_TYPE_SFAVD);
+    if (ret < 0)
+        return ret;
+
+    hwfc = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+    dev = hwfc->device_ctx->hwctx;
+    fctx = hwfc->hwctx;
+    ctx->dev = dev->dev;
+    ctx->ctx = fctx->ctx;
+    return 0;
+}
+
+int ff_sfavd_uninit(AVCodecContext *avctx)
+{
+    SFAVDContext *ctx = sfavd_context(avctx);
+
+    if (ctx->pictures)
+        av_log(avctx, AV_LOG_VERBOSE, "AVD: %"PRIu64" pictures, decode time mean %.2f ms, max %.2f ms\n",
+               ctx->pictures, ctx->decode_us / 1000.0 / ctx->pictures, ctx->decode_us_max / 1000.0);
+    av_freep(&ctx->bitstream);
+    ctx->bitstream_alloc = ctx->bitstream_size = 0;
+    return 0;
+}
+
+uint64_t ff_sfavd_timestamp(const AVFrame *frame)
+{
+    const AVPDAVDFrame *f;
+
+    if (!frame || frame->format != AV_PIX_FMT_SFAVD || !frame->data[0])
+        return 0;
+    f = (const AVPDAVDFrame *)frame->data[0];
+    return f->timestamp;
+}
+
+uint64_t ff_sfavd_start_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    SFAVDContext *ctx = sfavd_context(avctx);
+    AVHWFramesContext *hwfc = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+    AVPDAVDFramesContext *fctx = hwfc->hwctx;
+    AVPDAVDFrame *f = (AVPDAVDFrame *)frame->data[0];
+
+    ctx->bitstream_size = 0;
+    f->timestamp = ++fctx->timestamp;
+    return f->timestamp;
+}
+
+void ff_sfavd_reset(AVCodecContext *avctx)
+{
+    sfavd_context(avctx)->bitstream_size = 0;
+}
+
+int ff_sfavd_append(AVCodecContext *avctx, const uint8_t *data, uint32_t size)
+{
+    SFAVDContext *ctx = sfavd_context(avctx);
+    uint8_t *p;
+
+    p = av_fast_realloc(ctx->bitstream, &ctx->bitstream_alloc, ctx->bitstream_size + size);
+    if (!p)
+        return AVERROR(ENOMEM);
+    ctx->bitstream = p;
+    memcpy(ctx->bitstream + ctx->bitstream_size, data, size);
+    ctx->bitstream_size += size;
+    return 0;
+}
+
+int ff_sfavd_decode(AVCodecContext *avctx, AVFrame *frame,
+                    const struct sfavd_ctrl *ctrls, int nb_ctrls, int hold)
+{
+    SFAVDContext *ctx = sfavd_context(avctx);
+    AVPDAVDFrame *f = (AVPDAVDFrame *)frame->data[0];
+    struct sfavd_decode decode = { 0 };
+    struct sfavd_meta meta = { 0 };
+
+    if (nb_ctrls > SFAVD_MAX_CTRLS || !ctx->bitstream_size)
+        return AVERROR(EINVAL);
+
+    decode.ctx = ctx->ctx;
+    decode.flags = hold ? SFAVD_DECODE_HOLD : 0;
+    decode.dst = f->index;
+    decode.timestamp = f->timestamp;
+    decode.data = (uintptr_t)ctx->bitstream;
+    decode.size = ctx->bitstream_size;
+    decode.nctrls = nb_ctrls;
+    memcpy(decode.ctrls, ctrls, nb_ctrls * sizeof(*ctrls));
+
+    meta.pts = frame->pts;
+    meta.width = avctx->width;
+    meta.height = avctx->height;
+    meta.crop_left = frame->crop_left;
+    meta.crop_top = frame->crop_top;
+    meta.flags = (frame->flags & AV_FRAME_FLAG_KEY) ? SFAVD_META_KEY : 0;
+
+    if (sfavd_decode(ctx->dev, &decode, hold ? NULL : &meta) < 0) {
+        int err = AVERROR(errno);
+        av_log(avctx, AV_LOG_ERROR, "AVD decode of picture %"PRIu64" failed: %s (decoder status 0x%x)\n",
+               f->timestamp, av_err2str(err), decode.status);
+        return err;
+    }
+    if (!hold) {
+        AVHWFramesContext *hwfc = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+        AVPDAVDDeviceContext *dev = hwfc->device_ctx->hwctx;
+
+        if (dev->picture_decoded)
+            dev->picture_decoded(dev->picture_decoded_opaque, frame);
+        ctx->pictures++;
+        ctx->decode_us += decode.decode_us;
+        ctx->decode_us_max = FFMAX(ctx->decode_us_max, decode.decode_us);
+    }
+    return 0;
+}
diff -ruN a/libavcodec/sfavd.h b/libavcodec/sfavd.h
--- a/libavcodec/sfavd.h	1969-12-31 16:00:00.000000000 -0800
+++ b/libavcodec/sfavd.h	2026-11-12 00:14:09.174478782 -0800
@@ -0,0 +1,70 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_SFAVD_H
+#define AVCODEC_SFAVD_H
+
+/**
+ * @file
+ * Common part of the `sfavd` hwaccels: the Apple Video Decoder through libsfavd. The
+ * decoder takes Linux's V4L2 stateless control structures; the per-codec files fill them
+ * the way the V4L2 request API hwaccels do.
+ */
+
+#include <stdint.h>
+
+#include <sfavd/sfavd.h>
+#include <sfavd/v4l2-controls.h>
+
+#include "libavutil/frame.h"
+#include "libavutil/hwcontext_sfavd.h"
+
+#include "avcodec.h"
+
+typedef struct SFAVDContext {
+    void    *dev;            /* sfavd_dev * of the device context */
+    uint32_t ctx;
+    /* coded data of the slice (H.264) or picture being collected */
+    uint8_t *bitstream;
+    unsigned bitstream_alloc;
+    unsigned bitstream_size;
+    /* statistics */
+    uint64_t pictures;
+    uint64_t decode_us, decode_us_max;
+} SFAVDContext;
+
+int ff_sfavd_init(AVCodecContext *avctx);
+int ff_sfavd_uninit(AVCodecContext *avctx);
+/**
+ * Fills the frames context for av_hwframe_ctx_init(): codec, format control, and a pool
+ * of `refs` reference pictures plus what the decoder and the caller hold besides.
+ */
+int ff_sfavd_frame_params(AVCodecContext *avctx, AVBufferRef *hw_frames_ctx,
+                          uint32_t codec, uint32_t ctrl_id, const void *ctrl,
+                          size_t ctrl_size, int refs);
+/** Starts a picture into `frame`: names it (the returned timestamp) and resets the coded data. */
+uint64_t ff_sfavd_start_frame(AVCodecContext *avctx, AVFrame *frame);
+/** The name of the picture in a decoded frame, for reference lists; 0 if none. */
+uint64_t ff_sfavd_timestamp(const AVFrame *frame);
+int ff_sfavd_append(AVCodecContext *avctx, const uint8_t *data, uint32_t size);
+void ff_sfavd_reset(AVCodecContext *avctx);
+/** Submits the collected coded data with these controls. `hold`: more slices follow. */
+int ff_sfavd_decode(AVCodecContext *avctx, AVFrame *frame,
+                    const struct sfavd_ctrl *ctrls, int nb_ctrls, int hold);
+
+#endif /* AVCODEC_SFAVD_H */
