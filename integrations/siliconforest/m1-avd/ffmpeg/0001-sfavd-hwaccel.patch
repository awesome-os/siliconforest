+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config.h"
+
+#include <errno.h>
+#include <string.h>
+
+#include <sfavd/sfavd.h>
+
+#include "avassert.h"
+#include "buffer.h"
+#include "common.h"
+#include "hwcontext.h"
+#include "hwcontext_internal.h"
+#include "hwcontext_sfavd.h"
+#include "imgutils.h"
+#include "mem.h"
+#include "pixdesc.h"
+#include "pixfmt.h"
+
+typedef struct SFAVDFramesPriv {
+    AVPDAVDFramesContext p;
+    int created;
+    /* decoded buffers handed out so far */
+    unsigned next;
+} SFAVDFramesPriv;
+
+static const enum AVPixelFormat supported_sw_formats[] = {
+    AV_PIX_FMT_NV12,
+    AV_PIX_FMT_P010,
+    AV_PIX_FMT_NV16,
+};
+
+static int sfavd_device_create(AVHWDeviceContext *ctx, const char *device,
+                               AVDictionary *opts, int flags)
+{
+    AVPDAVDDeviceContext *hwctx = ctx->hwctx;
+    struct sfavd_info info;
+
+    hwctx->dev = sfavd_open(device);
+    if (!hwctx->dev) {
+        int err = AVERROR(errno);
+        av_log(ctx, AV_LOG_ERROR, "Cannot open the AVD device %s: %s\n",
+               device ? device : "(default)", av_err2str(err));
+        return err;
+    }
+    if (sfavd_info(hwctx->dev, &info) < 0 || info.abi != SFAVD_ABI_VERSION) {
+        av_log(ctx, AV_LOG_ERROR, "The AVD device has another interface version\n");
+        sfavd_close(hwctx->dev);
+        hwctx->dev = NULL;
+        return AVERROR(ENOSYS);
+    }
+    av_log(ctx, AV_LOG_VERBOSE, "AVD: codecs 0x%x, firmware \"%s\"\n",
+           info.caps, info.firmware);
+    return 0;
+}
+
+static void sfavd_device_uninit(AVHWDeviceContext *ctx)
+{
+    AVPDAVDDeviceContext *hwctx = ctx->hwctx;
+
+    if (hwctx->dev)
+        sfavd_close(hwctx->dev);
+    hwctx->dev = NULL;
+}
+
+static int sfavd_frames_get_constraints(AVHWDeviceContext *ctx,
+                                        const void *hwconfig,
+                                        AVHWFramesConstraints *constraints)
+{
+    int i;
+
+    constraints->valid_sw_formats = av_malloc_array(FF_ARRAY_ELEMS(supported_sw_formats) + 1,
+                                                    sizeof(*constraints->valid_sw_formats));
+    if (!constraints->valid_sw_formats)
+        return AVERROR(ENOMEM);
+    for (i = 0; i < FF_ARRAY_ELEMS(supported_sw_formats); i++)
+        constraints->valid_sw_formats[i] = supported_sw_formats[i];
+    constraints->valid_sw_formats[i] = AV_PIX_FMT_NONE;
+
+    constraints->valid_hw_formats = av_malloc_array(2, sizeof(*constraints->valid_hw_formats));
+    if (!constraints->valid_hw_formats)
+        return AVERROR(ENOMEM);
+    constraints->valid_hw_formats[0] = AV_PIX_FMT_SFAVD;
+    constraints->valid_hw_formats[1] = AV_PIX_FMT_NONE;
+
+    constraints->min_width  = 64;
+    constraints->min_height = 64;
+    constraints->max_width  = 4096;
+    constraints->max_height = 4096;
+    return 0;
+}
+
+static void sfavd_pool_free(void *opaque, uint8_t *data)
+{
+    av_free(data);
+}
+
+static AVBufferRef *sfavd_pool_alloc(void *opaque, size_t size)
+{
+    AVHWFramesContext *hwfc = opaque;
+    SFAVDFramesPriv *priv = hwfc->hwctx;
+    AVPDAVDDeviceContext *dev = hwfc->device_ctx->hwctx;
+    AVPDAVDFrame *frame;
+    AVBufferRef *ref;
+
+    if (priv->next >= priv->p.nb_buffers) {
+        av_log(hwfc, AV_LOG_ERROR, "All %u decoded buffers of the AVD context are in use\n",
+               priv->p.nb_buffers);
+        return NULL;
+    }
+    frame = av_mallocz(sizeof(*frame));
+    if (!frame)
+        return NULL;
+    frame->ctx = priv->p.ctx;
+    frame->index = priv->next;
+    if (sfavd_map(dev->dev, frame->ctx, frame->index, &frame->data, &frame->size) < 0) {
+        av_log(hwfc, AV_LOG_ERROR, "Cannot map decoded buffer %u: %s\n",
+               frame->index, av_err2str(AVERROR(errno)));
+        av_free(frame);
+        return NULL;
+    }
+    ref = av_buffer_create((uint8_t *)frame, sizeof(*frame), sfavd_pool_free, NULL, 0);
+    if (!ref) {
+        av_free(frame);
+        return NULL;
+    }
+    priv->next++;
+    return ref;
+}
+
+static int sfavd_frames_init(AVHWFramesContext *hwfc)
+{
+    SFAVDFramesPriv *priv = hwfc->hwctx;
+    AVPDAVDFramesContext *fctx = &priv->p;
+    AVPDAVDDeviceContext *dev = hwfc->device_ctx->hwctx;
+    struct sfavd_create create = { 0 };
+
+    if (hwfc->pool) {
+        av_log(hwfc, AV_LOG_ERROR, "A frame pool of the caller cannot be used with the AVD\n");
+        return AVERROR(EINVAL);
+    }
+    if (!fctx->codec || !fctx->format_ctrl_size ||
+        fctx->format_ctrl_size > AV_SFAVD_FORMAT_CTRL_MAX) {
+        av_log(hwfc, AV_LOG_ERROR, "An AVD frames context is set up by the decoder "
+               "(avcodec_get_hw_frames_parameters())\n");
+        return AVERROR(EINVAL);
+    }
+
+    create.codec = fctx->codec;
+    create.width = hwfc->width;
+    create.height = hwfc->height;
+    create.buffers = FFMIN(hwfc->initial_pool_size > 0 ? hwfc->initial_pool_size : 20,
+                           SFAVD_MAX_BUFFERS);
+    create.format_ctrl.id = fctx->format_ctrl_id;
+    create.format_ctrl.size = fctx->format_ctrl_size;
+    create.format_ctrl.ptr = (uintptr_t)fctx->format_ctrl;
+    if (sfavd_create(dev->dev, &create) < 0) {
+        int err = AVERROR(errno);
+        av_log(hwfc, AV_LOG_ERROR, "Cannot create an AVD context for %ux%u: %s\n",
+               create.width, create.height, av_err2str(err));
+        return err;
+    }
+    priv->created = 1;
+    fctx->ctx = create.ctx;
+    fctx->pixelformat = create.format.pixelformat;
+    fctx->width = create.format.width;
+    fctx->height = create.format.height;
+    fctx->bytesperline = create.format.bytesperline;
+    fctx->uv_offset = create.format.uv_offset;
+    fctx->sizeimage = create.format.sizeimage;
+    fctx->nb_buffers = create.buffers;
+
+    switch (fctx->pixelformat) {
+    case SFAVD_PIX_NV12: hwfc->sw_format = AV_PIX_FMT_NV12; break;
+    case SFAVD_PIX_NV16: hwfc->sw_format = AV_PIX_FMT_NV16; break;
+    case SFAVD_PIX_P010: hwfc->sw_format = AV_PIX_FMT_P010; break;
+    default:
+        av_log(hwfc, AV_LOG_ERROR, "Unknown decoded format 0x%08x\n", fctx->pixelformat);
+        return AVERROR(ENOSYS);
+    }
+
+    ffhwframesctx(hwfc)->pool_internal =
+        av_buffer_pool_init2(sizeof(AVPDAVDFrame), hwfc, sfavd_pool_alloc, NULL);
+    if (!ffhwframesctx(hwfc)->pool_internal)
+        return AVERROR(ENOMEM);
+
+    av_log(hwfc, AV_LOG_VERBOSE, "AVD context %u: %ux%u (coded %ux%u), %u buffers of %u bytes, %s\n",
+           fctx->ctx, hwfc->width, hwfc->height, fctx->width, fctx->height,
+           fctx->nb_buffers, fctx->sizeimage, av_get_pix_fmt_name(hwfc->sw_format));
+    return 0;
+}
+
+static void sfavd_frames_uninit(AVHWFramesContext *hwfc)
+{
+    SFAVDFramesPriv *priv = hwfc->hwctx;
+    AVPDAVDDeviceContext *dev = hwfc->device_ctx->hwctx;
+
+    if (priv->created && dev->dev)
+        sfavd_destroy(dev->dev, priv->p.ctx);
+    priv->created = 0;
+}
+
+static int sfavd_get_buffer(AVHWFramesContext *hwfc, AVFrame *frame)
+{
+    frame->buf[0] = av_buffer_pool_get(hwfc->pool);
+    if (!frame->buf[0])
+        return AVERROR(ENOMEM);
+
+    frame->data[0] = frame->buf[0]->data;
+    frame->format  = AV_PIX_FMT_SFAVD;
+    frame->width   = hwfc->width;
+    frame->height  = hwfc->height;
+    return 0;
+}
+
+static int sfavd_transfer_get_formats(AVHWFramesContext *hwfc,
+                                      enum AVHWFrameTransferDirection dir,
+                                      enum AVPixelFormat **formats)
+{
+    enum AVPixelFormat *fmts;
+
+    if (dir != AV_HWFRAME_TRANSFER_DIRECTION_FROM)
+        return AVERROR(ENOSYS);
+    fmts = av_malloc_array(2, sizeof(*fmts));
+    if (!fmts)
+        return AVERROR(ENOMEM);
+    fmts[0] = hwfc->sw_format;
+    fmts[1] = AV_PIX_FMT_NONE;
+    *formats = fmts;
+    return 0;
+}
+
+static int sfavd_transfer_data_from(AVHWFramesContext *hwfc, AVFrame *dst,
+                                    const AVFrame *src)
+{
+    SFAVDFramesPriv *priv = hwfc->hwctx;
+    const AVPDAVDFramesContext *fctx = &priv->p;
+    const AVPDAVDFrame *frame = (const AVPDAVDFrame *)src->data[0];
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(hwfc->sw_format);
+    const uint8_t *data[4] = { 0 };
+    int linesize[4] = { 0 };
+    int w = FFMIN(dst->width, (int)fctx->width);
+    int h = FFMIN(dst->height, (int)fctx->height);
+    int bytes = (desc->comp[0].depth + 7) / 8;
+    size_t left, top;
+
+    if (dst->format != hwfc->sw_format)
+        return AVERROR(ENOSYS);
+    if (!frame || !frame->data)
+        return AVERROR(EINVAL);
+
+    /* the caller applies the frame's cropping afterwards, as for a software frame */
+    left = 0;
+    top = 0;
+    data[0] = frame->data + top * fctx->bytesperline + left * bytes;
+    data[1] = frame->data + fctx->uv_offset;
+    linesize[0] = linesize[1] = fctx->bytesperline;
+    av_image_copy2(dst->data, dst->linesize, (uint8_t **)data, linesize,
+                   hwfc->sw_format, w, h);
+    return 0;
+}
+
+const HWContextType ff_hwcontext_type_sfavd = {
+    .type                   = AV_HWDEVICE_TYPE_SFAVD,
+    .name                   = "sfavd",
+
+    .device_hwctx_size      = sizeof(AVPDAVDDeviceContext),
+    .frames_hwctx_size      = sizeof(SFAVDFramesPriv),
+
+    .device_create          = sfavd_device_create,
+    .device_uninit          = sfavd_device_uninit,
+    .frames_get_constraints = sfavd_frames_get_constraints,
+    .frames_init            = sfavd_frames_init,
+    .frames_uninit          = sfavd_frames_uninit,
+    .frames_get_buffer      = sfavd_get_buffer,
+    .transfer_get_formats   = sfavd_transfer_get_formats,
+    .transfer_data_from     = sfavd_transfer_data_from,
+
+    .pix_fmts = (const enum AVPixelFormat[]) { AV_PIX_FMT_SFAVD, AV_PIX_FMT_NONE },
+};
