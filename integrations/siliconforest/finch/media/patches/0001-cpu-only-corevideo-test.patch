@@ -24,6 +24,17 @@
 extern CVReturn CVMetalBufferCacheCreateBufferFromImage(CFAllocatorRef, CVMetalBufferCacheRef, CVImageBufferRef, CVMetalBufferRef *);
 
 /* A description with its pointers masked and the fill callbacks (pointers) left out. */
+
+/* Keep the comparison usable with PD's older public color-space name API. */
+static CFStringRef sf_copy_color_space_name(CGColorSpaceRef space)
+{
+    typedef CFStringRef (*CopyName)(CGColorSpaceRef);
+    CopyName copy = (CopyName)dlsym(RTLD_DEFAULT, "CGColorSpaceCopyName");
+    if (copy) return copy(space);
+    CFStringRef name = CGColorSpaceGetName(space);
+    return name ? CFRetain(name) : NULL;
+}
