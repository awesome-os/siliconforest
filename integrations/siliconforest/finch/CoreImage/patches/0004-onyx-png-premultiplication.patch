@@ -697,7 +697,7 @@
    if(pixels==NULL)
     return nil;
     
-// clamp premultiplied data, this should probably be moved into the O2Image init
+// PNG samples are unassociated; the resulting O2Image advertises premultiplied RGB.
    int i;
    for(i=0;i<bytesPerRow*height;i+=4){
        unsigned char a=pixels[i+3];
@@ -706,9 +706,9 @@
            unsigned char g=pixels[i+1];
            unsigned char b=pixels[i+2];
            
-           pixels[i+0]=MIN(r,a);
-           pixels[i+1]=MIN(g,a);
-           pixels[i+2]=MIN(b,a);
+           pixels[i+0]=((unsigned)r*a+127)/255;
