+static BOOL is_compressed(AVAudioFormat *format) {
+    if(!format || !format.streamDescription)return NO;
+    AudioFormatID id=format.streamDescription->mFormatID;
+    return id==kAudioFormatMPEG4AAC || id==kAudioFormatMPEGLayer3 || id==kAudioFormatAppleLossless;
+}
+static OSStatus compressed_input(struct AVAudioConverterInputContext *context, UInt32 *packets,
+    AudioBufferList *data, AudioStreamPacketDescription **descriptions) {
+    struct AVAudioConverterImpl *impl=context->impl;
+    if(impl->endOfStream){*packets=0;context->lastStatus=AVAudioConverterInputStatus_EndOfStream;return noErr;}
+    if(impl->pendingCompressed && impl->compressedPacket>=impl->pendingCompressed.packetCount){
+        [impl->pendingCompressed release];impl->pendingCompressed=nil;impl->compressedPacket=0;
+    }
+    if(!impl->pendingCompressed) {
+        AVAudioConverterInputStatus status=AVAudioConverterInputStatus_NoDataNow;
+        AVAudioBuffer *input=nil;
+        @try {input=context->block(1,&status);} @catch(NSException *e){return kAudioConverterErr_InvalidInputSize;}
+        context->lastStatus=status;
+        if(status==AVAudioConverterInputStatus_EndOfStream || status==AVAudioConverterInputStatus_NoDataNow){
+            if(input)return kAudioConverterErr_InvalidInputSize;
+            if(status==AVAudioConverterInputStatus_EndOfStream)impl->endOfStream=YES;
+            *packets=0;return noErr;
+        }
+        if(status!=AVAudioConverterInputStatus_HaveData || ![input isKindOfClass:[AVAudioCompressedBuffer class]] ||
+            ![input.format isEqual:context->format])return kAudioConverterErr_FormatNotSupported;
+        impl->pendingCompressed=[(AVAudioCompressedBuffer *)input retain];impl->compressedPacket=0;
+    }
+    AVAudioCompressedBuffer *buffer=impl->pendingCompressed;
+    if(!buffer.packetCount || impl->compressedPacket>=buffer.packetCount)return kAudioConverterErr_InvalidInputSize;
+    AudioStreamPacketDescription description;
+    if(buffer.packetDescriptions) description=buffer.packetDescriptions[impl->compressedPacket];
+    else if(buffer.packetCount==1) description=(AudioStreamPacketDescription){0,0,buffer.byteLength};
+    else return kAudioConverterErr_InvalidInputSize;
+    if(description.mStartOffset<0 || (uint64_t)description.mStartOffset>buffer.byteLength ||
+        description.mDataByteSize>buffer.byteLength-(uint64_t)description.mStartOffset)return kAudioConverterErr_InvalidInputSize;
+    data->mNumberBuffers=1;data->mBuffers[0]=(AudioBuffer){context->format.channelCount,description.mDataByteSize,(UInt8*)buffer.data+description.mStartOffset};
+    description.mStartOffset=0;impl->compressedDescription=description;
+    if(descriptions)*descriptions=&impl->compressedDescription;
+    impl->compressedPacket++;*packets=1;return noErr;
 }
 
