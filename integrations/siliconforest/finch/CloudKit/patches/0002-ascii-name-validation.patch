+
+/* PD lacks NSString's conversion predicate; this exactly checks the ASCII
+ * range used by the record and zone name contract, without lossy conversion. */
+static BOOL FinchCKIsASCII(NSString *string)
+{
+    for (NSUInteger i = 0; i < string.length; ++i)
+        if ([string characterAtIndex:i] > 0x7f) return NO;
+    return YES;
+}
 
