#!/bin/sh
# SPDX-License-Identifier: MIT
# Guest side of the boot-hang count (tools/la_hangrate.sh): the boot reached the shell with
# all processors. Nothing else. (@SSID@/@PSK@ are filled in by the assembler and unused.)
nonce=${1:-none}
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin; export PATH
printf '\nLA_UP_%s ncpu=%s active=%s\n' "$nonce" "$(sysctl -n hw.ncpu)" "$(sysctl -n hw.activecpu)"
printf '\nPD_BENCH_DONE\n'
