--- a/src/Kernel/Extensions/SFBwfm/sf_bwfm_compat.h	1969-12-31 16:00:00.000000000 -0800
+++ b/src/Kernel/Extensions/SFBwfm/sf_bwfm_compat.h	2026-11-15 23:56:07.713681135 -0800
@@ -0,0 +1,346 @@
+// SPDX-License-Identifier: MIT
+// the openbsd autoconf, pci, bus_space, bus_dma and fdt interfaces bwfm(4) uses,
+// carried out by SFBwfm.cpp and sf_bwfm_glue.c. Derived from SFQwx's sf_qwx_compat.h.
+#ifndef SF_BWFM_COMPAT_H
+#define SF_BWFM_COMPAT_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// every driver message carries this prefix, it is the device name bwfm prints
+#define SF_BWFM_NAME		"SFBwfm"
+// firmware, clm, txcap and nvram files live here, under their linux names
+#define SF_BWFM_FIRMWARE_DIR	"/Library/Firmware/brcm"
+// bwfm_pci_intr runs from the MSI and, as a safety net, from a timer every
+// SF_BWFM_MSI_FALLBACK_POLL_US; without an MSI vector the timer alone drives it, every SF_BWFM_POLL_US
+#define SF_BWFM_POLL_US		2000
+#define SF_BWFM_MSI_FALLBACK_POLL_US	250000
+
+// bwfm.c and if_bwfm_pci.c bring their own
+#undef DPRINTF
+#undef DPRINTFN
+#undef DEVNAME
+
+// autoconf
+
+struct device {
+	char		dv_xname[16];
+};
+struct cfattach {
+	size_t		ca_devsize;
+	int		(*ca_match)(struct device *, void *, void *);
+	void		(*ca_attach)(struct device *, struct device *, void *);
+	int		(*ca_detach)(struct device *, int);
+	int		(*ca_activate)(struct device *, int);
+};
+struct cfdriver {
+	void		**cd_devs;
+	const char	*cd_name;
+	int		cd_class;
+};
+#define DV_IFNET	1
+#define DVACT_QUIESCE	2
+#define DVACT_SUSPEND	3
+#define DVACT_RESUME	4
+#define DVACT_WAKEUP	5
+#define DVACT_POWERDOWN	6
+// SFBwfm runs the hook itself once the root file system is mounted
+void	sf_bwfm_mountroot(struct device *, void (*)(struct device *));
+#define config_mountroot(dev, fn)	sf_bwfm_mountroot((dev), (fn))
+
+// registers, the handle is the kernel virtual address of the BAR mapping
+
+typedef int		bus_space_tag_t;
+typedef uintptr_t	bus_space_handle_t;
+typedef uint64_t	bus_size_t;
+typedef uint64_t	bus_addr_t;
+typedef uint64_t	paddr_t;
+
+static inline uint8_t
+bus_space_read_1(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o)
+{
+	(void)t;
+	return *(volatile uint8_t *)(h + o);
+}
+
+static inline uint16_t
+bus_space_read_2(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o)
+{
+	(void)t;
+	return OSSwapLittleToHostInt16(*(volatile uint16_t *)(h + o));
+}
+
+static inline uint32_t
+bus_space_read_4(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o)
+{
+	(void)t;
+	return OSSwapLittleToHostInt32(*(volatile uint32_t *)(h + o));
+}
+
+static inline void
+bus_space_write_1(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o, uint8_t v)
+{
+	(void)t;
+	*(volatile uint8_t *)(h + o) = v;
+}
+
+static inline void
+bus_space_write_2(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o, uint16_t v)
+{
+	(void)t;
+	*(volatile uint16_t *)(h + o) = OSSwapHostToLittleInt16(v);
+}
+
+static inline void
+bus_space_write_4(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o, uint32_t v)
+{
+	(void)t;
+	*(volatile uint32_t *)(h + o) = OSSwapHostToLittleInt32(v);
+}
+
+static inline void
+bus_space_read_region_1(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o, uint8_t *buf, size_t n)
+{
+	while (n-- > 0)
+		*buf++ = bus_space_read_1(t, h, o++);
+}
+
+static inline void
+bus_space_write_region_1(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o, const uint8_t *buf, size_t n)
+{
+	while (n-- > 0)
+		bus_space_write_1(t, h, o++, *buf++);
+}
+
+static inline int
+bus_space_subregion(bus_space_tag_t t, bus_space_handle_t h, bus_size_t o, bus_size_t size,
+    bus_space_handle_t *nh)
+{
+	(void)t;
+	(void)size;
+	*nh = h + o;
+	return 0;
+}
+
+// the IOMemoryMap behind a BAR stays with SFBwfm until its stop releases it, after the detach
+#define bus_space_unmap(t, h, s)	((void)0)
+
+// dma, by default (sf_dart_map.h): every device visible address is an iova the DART mapper
+// handed out for exactly that buffer. bus_dmamem memory is wired kernel memory mapped for its
+// lifetime, an mbuf is mapped in place (its own data pages, no copy) from bus_dmamap_load_mbuf
+// to bus_dmamap_unload. A map only gets a slot, a mapped bounce buffer of its maximum size,
+// the first time an mbuf cannot be mapped in place; see sf_bwfm_glue.c.
+//
+// dma with SF_BWFM_DMA_BOUNCE defined (sf_dart_pool.h): every device visible address is an
+// iova inside the DART bounce pool. A map owns a pool slot of its maximum size. Transmit data
+// is copied into the slot when the mbuf is loaded, a map created with BUS_DMA_READ is a
+// receive buffer whose slot is copied into the loaded mbuf at BUS_DMASYNC_POSTREAD.
+
+typedef struct sf_bwfm_dma *bus_dma_tag_t;
+
+typedef struct {
+	bus_addr_t	ds_addr;
+	bus_size_t	ds_len;
+	void		*_ds_mem;
+} bus_dma_segment_t;
+
+struct bus_dmamap {
+	bus_size_t	dm_mapsize;
+	int		dm_nsegs;
+	int		_dm_flags;
+	bus_size_t	_dm_size;
+	void		*_dm_slot;
+	uint64_t	_dm_slot_iova;
+	struct mbuf	*_dm_mbuf;
+#ifndef SF_BWFM_DMA_BOUNCE
+	int		_dm_kind;	/* what is loaded, SF_BWFM_DMA_* in sf_bwfm_glue.c */
+	uint64_t	_dm_dva;	/* an mbuf mapped in place: its device address */
+#endif
+	bus_dma_segment_t dm_segs[1];
+};
+typedef struct bus_dmamap *bus_dmamap_t;
+
+#define BUS_DMA_WAITOK		0x0000
+#define BUS_DMA_NOWAIT		0x0001
+#define BUS_DMA_ALLOCNOW	0x0002
+#define BUS_DMA_COHERENT	0x0004
+#define BUS_DMA_ZERO		0x0008
+#define BUS_DMA_64BIT		0x0010
+#define BUS_DMA_READ		0x0200
+#define BUS_DMA_WRITE		0x0400
+#define BUS_DMASYNC_PREREAD	0x01
+#define BUS_DMASYNC_POSTREAD	0x02
+#define BUS_DMASYNC_PREWRITE	0x04
+#define BUS_DMASYNC_POSTWRITE	0x08
+
+int	bus_dmamap_create(bus_dma_tag_t, bus_size_t, int, bus_size_t, bus_size_t, int, bus_dmamap_t *);
+void	bus_dmamap_destroy(bus_dma_tag_t, bus_dmamap_t);
+int	bus_dmamap_load(bus_dma_tag_t, bus_dmamap_t, void *, bus_size_t, void *, int);
+int	bus_dmamap_load_mbuf(bus_dma_tag_t, bus_dmamap_t, struct mbuf *, int);
+void	bus_dmamap_unload(bus_dma_tag_t, bus_dmamap_t);
+void	bus_dmamap_sync(bus_dma_tag_t, bus_dmamap_t, bus_addr_t, bus_size_t, int);
+int	bus_dmamem_alloc(bus_dma_tag_t, bus_size_t, bus_size_t, bus_size_t, bus_dma_segment_t *, int, int *, int);
+void	bus_dmamem_free(bus_dma_tag_t, bus_dma_segment_t *, int);
+int	bus_dmamem_map(bus_dma_tag_t, bus_dma_segment_t *, int, size_t, caddr_t *, int);
+void	bus_dmamem_unmap(bus_dma_tag_t, caddr_t, size_t);
+
+// the packet id tables are sized to what the 16 MiB pool can back: every id owns a slot,
+// 2 KiB for transmit and 8 KiB for receive. OpenBSD uses 2048 and 1024. The per-buffer
+// mapper has no such limit; the sizes stay the same so the two can be compared.
+#define BWFM_NUM_TX_PKTIDS	512
+#define BWFM_NUM_RX_PKTIDS			640
+
+// pci, the tag is the IOPCIDevice
+
+typedef uint32_t	pcireg_t;
+typedef void		*pci_chipset_tag_t;
+typedef void		*pcitag_t;
+typedef struct {
+	int		ih_index;
+} pci_intr_handle_t;
+
+struct pci_attach_args {
+	pci_chipset_tag_t pa_pc;
+	pcitag_t	pa_tag;
+	bus_dma_tag_t	pa_dmat;
+	pcireg_t	pa_id;
+};
+struct pci_matchid {
+	uint16_t	pm_vid;
+	uint16_t	pm_pid;
+};
+
+#define PCI_VENDOR(id)		((id) & 0xffff)
+#define PCI_PRODUCT(id)		(((id) >> 16) & 0xffff)
+// from openbsd's pcidevs
+#define PCI_VENDOR_BROADCOM		0x14e4
+#define PCI_PRODUCT_BROADCOM_BCM4350	0x43a3
+#define PCI_PRODUCT_BROADCOM_BCM4356	0x43ec
+#define PCI_PRODUCT_BROADCOM_BCM43602	0x43ba
+#define PCI_PRODUCT_BROADCOM_BCM4371	0x440d
+#define PCI_PRODUCT_BROADCOM_BCM4378	0x4425
+#define PCI_PRODUCT_BROADCOM_BCM4387	0x4433
+#define PCI_MAPREG_START	0x10
+#define PCI_MAPREG_TYPE_MEM	0x00000000
+#define PCI_MAPREG_MEM_TYPE_64BIT	0x00000004
+
+pcireg_t pci_conf_read(pci_chipset_tag_t, pcitag_t, int);
+void	pci_conf_write(pci_chipset_tag_t, pcitag_t, int, pcireg_t);
+int	pci_mapreg_map(struct pci_attach_args *, int, pcireg_t, int, bus_space_tag_t *,
+	    bus_space_handle_t *, bus_addr_t *, bus_size_t *, bus_size_t);
+int	pci_matchbyid(struct pci_attach_args *, const struct pci_matchid *, int);
+int	pci_intr_map_msi(struct pci_attach_args *, pci_intr_handle_t *);
+int	pci_intr_map(struct pci_attach_args *, pci_intr_handle_t *);
+const char *pci_intr_string(pci_chipset_tag_t, pci_intr_handle_t);
+void	*pci_intr_establish(pci_chipset_tag_t, pci_intr_handle_t, int, int (*)(void *), void *, const char *);
+void	pci_intr_disestablish(pci_chipset_tag_t, void *);
+
+// the device tree: there is no fdt on Darwin. bwfm asks two nodes for properties, the root
+// for the board and the pci function for what m1n1 copies out of the Apple device tree on
+// linux. sf_bwfm_glue.c answers both, see sf_bwfm_board_identity() for the hard-coded part.
+
+#define __HAVE_FDT		1
+#define SF_BWFM_NODE_WLAN	1
+#define SF_BWFM_NODE_ROOT	2
+#define PCITAG_NODE(tag)	SF_BWFM_NODE_WLAN
+#define OF_peer(node)		SF_BWFM_NODE_ROOT
+int	OF_getproplen(int, const char *);
+int	OF_getprop(int, const char *, void *, int);
+
+// raw properties of the Apple device tree, read from the IORegistry by SFBwfm.cpp.
+// Returns the property length, or -1 when the node or the property is missing.
+int	sf_bwfm_adt_prop(const char *path, const char *name, void *buf, int len);
+// boot-args that override the hard-coded board identity, 0 when absent
+int	sf_bwfm_bootarg(const char *name, char *buf, int len);
+// 1 when the firmware supplicant should do the WPA2-PSK handshake (boot-arg bwfm_fwsup=0 turns it off)
+int	sf_bwfm_want_fwsup(void);
+// 1 when the firmware's deep sleep request is acknowledged as brcmfmac does (boot-arg bwfm_dsack=1; default 0)
+int	sf_bwfm_want_dsack(void);
+// the station's power save mode, BWFM_PM_* (boot-arg bwfm_pm, default 2: fast power save)
+int	sf_bwfm_want_pm(void);
+// ms the firmware stays awake after the last frame in fast power save (boot-arg bwfm_pm2_ret,
+// default 2000; 0 leaves the firmware's own 200 ms)
+int	sf_bwfm_want_pm2_ret(void);
+
+// the rest of the kernel bwfm touches
+
+#define le16toh(x)	OSSwapLittleToHostInt16(x)
+#define le32toh(x)	OSSwapLittleToHostInt32(x)
+#define le64toh(x)	OSSwapLittleToHostInt64(x)
+#define htolem32(p, v)	(*(uint32_t *)(p) = htole32(v))
+
+#define PWAIT		32
+#define taskq_create(n, t, ipl, f)	((struct taskq *)systq)
+#define taskq_destroy(tq)	((void)0)
+#define taskq_barrier(tq)	((void)0)
+
+// SFBwfm.cpp has the one from <net/ethernet.h>, the compat layer of the C files has none
+#ifndef __cplusplus
+struct ether_addr {
+	uint8_t		ether_addr_octet[ETHER_ADDR_LEN];
+};
+#endif
+
+// receive ring accounting, without openbsd's livelock back off
+struct if_rxring {
+	u_int		rxr_alive;
+	u_int		rxr_hwm;
+};
+
+static inline void
+if_rxr_init(struct if_rxring *rxr, u_int lwm, u_int hwm)
+{
+	(void)lwm;
+	rxr->rxr_alive = 0;
+	rxr->rxr_hwm = hwm;
+}
+
+static inline u_int
+if_rxr_get(struct if_rxring *rxr, u_int max)
+{
+	u_int n = rxr->rxr_hwm - rxr->rxr_alive;
+
+	if (n > max)
+		n = max;
+	rxr->rxr_alive += n;
+	return n;
+}
+
+static inline void
+if_rxr_put(struct if_rxring *rxr, u_int n)
+{
+	rxr->rxr_alive -= n;
+}
+
+#define ifq_restart(q)	do { ifq_clr_oactive(q); if_start((q)->ifq_if); } while (0)
+
+// one contiguous buffer of the asked size, the receive paths need that up to 8 KiB
+struct mbuf *sf_bwfm_mclgetl(int, u_int);
+#undef MCLGETL
+#define MCLGETL(m, how, l)	sf_bwfm_mclgetl((how), (l))
+
+// bwfm_lifecycle_enter remembers which thread is inside
+#include <kern/thread.h>
+
+int	loadfirmware(const char *, u_char **, size_t *);
+int	sf_bwfm_m_defrag(struct mbuf **, int);
+#define m_defrag(m, how)	sf_bwfm_m_defrag(&(m), (how))
+struct ifnet;
+int	if_setlladdr(struct ifnet *, const uint8_t *);
+
+#ifdef __cplusplus
+}
+#endif
+
+/* Driver messages. Define SF_BWFM_SLOW_LOG to follow each with a short sleep so the
+ * serial console drains before a possible hard stop (useful when chasing an SError). */
+int sf_bwfm_printf(const char *fmt, ...) __printflike(1, 2);
+/* log the first n occurrences of something on the data path */
+#define SF_LOGN(n, ...) do { static int sf_logn_; if (sf_logn_ < (n)) { sf_logn_++; sf_bwfm_printf(__VA_ARGS__); } } while (0)
+#ifndef SF_BWFM_NO_PRINTF_WRAP
+#undef printf
+#define printf(...) sf_bwfm_printf(__VA_ARGS__)
+#endif
+
+#endif
diff -ruN a/src/Kernel/Extensions/SFBwfm/SFBwfm.cpp b/src/Kernel/Extensions/SFBwfm/SFBwfm.cpp
--- a/src/Kernel/Extensions/SFBwfm/SFBwfm.cpp	1969-12-31 16:00:00.000000000 -0800
+++ b/src/Kernel/Extensions/SFBwfm/SFBwfm.cpp	2026-11-15 23:56:07.713417305 -0800
@@ -0,0 +1,1141 @@
+// SPDX-License-Identifier: MIT
+// Broadcom BCM4378 PCIe FullMAC 802.11ax (14e4:4425, Apple M1 J293), OpenBSD's bwfm(4) on
+// IO80211Family, with the pci calls it makes. Derived from SFQwx.cpp. The interrupt is one
+// MSI vector from the host bridge with a slow poll timer behind it, DMA goes through the DART
+// mapper, see sf_bwfm_compat.h.
+//
+// Lifecycle, all of it logged with one line per stage:
+//
+//   start       pci side attached, a thread loads the firmware once the root file system is
+//               there and attaches the 802.11 interface. A bring-up that fails leaves the
+//               chip reset, nothing allocated, the interrupt sources off and no interface.
+//   radio off   (wifiutil off, APPLE80211_IOC_POWER 0) boot-arg bwfm_off selects what it means:
+//               0, the default: OpenBSD's interface stop. Scan aborted, disassociated, flow
+//                  rings deleted, radio idle; the firmware stays loaded and served.
+//               1: after that the firmware is told (D3 inform), the chip masked and reset and
+//                  every ring, buffer and DMA mapping released. Radio on loads the firmware again.
+//               2: after that the host bridge shuts the port down and switches the radio's
+//                  power off through the SMC (SFApciePortShutdown). Radio on brings the port
+//                  back (SFApciePortResume) and loads the firmware. The SMC "off" value and
+//                  the port sequence are UNVERIFIED on hardware.
+//   sleep/wake  a priority sleep/wake interest on the root domain, nothing else: on sleep the
+//               steps of bwfm_off=1, and neither chip nor DART is touched from then on; on
+//               wake the bridge is asked for the port (it brings the link up if the SoC took
+//               it down), config space, DART and MSI are checked and written again if they
+//               were lost and, if the interface ran before, the firmware is loaded again.
+//               UNTESTED: the guest cannot sleep. The code is that of bwfm_off=1 and 2, which
+//               can be run with wifiutil.
+//   stop        see SFBwfm::stop.
+
+#include "sf_dart_pool.h"
+#include <IOKit/IOInterruptEventSource.h>
+#include <IOKit/IOInterruptController.h>
+#include "IO80211Controller.h"
+#include "sf_bwfm_glue.h"
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOMessage.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/pci/IOPCIDevice.h>
+#include <IOKit/pwr_mgt/RootDomain.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+#include <sys/vnode.h>
+#include <sys/fcntl.h>
+#include <sys/errno.h>
+#include <sys/kpi_mbuf.h>
+
+#include "sf_bwfm_compat.h"
+
+extern "C" {
+void *sf80211_malloc(size_t, int, int);
+void sf80211_free(void *, int, size_t);
+void sf80211_lock(void);
+void sf80211_unlock(void);
+vnode_t vfs_rootvnode(void);
+}
+
+#define LOG(fmt, ...)		IOLog(SF_BWFM_NAME ": " fmt "\n", ##__VA_ARGS__)
+
+#define BWFM_ROOT_WAIT_S	300
+#define BWFM_MAX_BARS		2
+#define BWFM_MAX_DEVICES	2
+
+// what "radio off" does, boot-arg bwfm_off
+enum {
+	kOffStop = 0,		// interface stop, firmware stays loaded
+	kOffHalt = 1,		// and firmware stopped, everything released
+	kOffPower = 2,		// and port shut down, radio power off
+};
+
+// how far SFBwfm::chipDown goes after it stopped the firmware
+enum {
+	kDownHalt = 0,		// no further: the chip stays powered and reachable
+	kDownSleep = 1,		// the system sleeps: the port counts as lost until the bridge has it back
+	kDownPower = 2,		// the bridge shuts the port down and switches the radio's power off
+};
+
+// the config registers a power loss clears: BARs, cache line and interrupt line. The command
+// register is kept apart, it goes back last
+static const UInt8 kSavedConfig[] = { 0x10, 0x14, 0x18, 0x1c, 0x20, 0x24, 0x0c, 0x3c };
+#define BWFM_SAVED_CONFIG	(sizeof(kSavedConfig) / sizeof(kSavedConfig[0]))
+
+class SFBwfm;
+
+struct sf_bwfm_dma {
+	IOPCIDevice	*pci;
+};
+
+class SFBwfm : public IO80211Controller
+{
+	OSDeclareDefaultStructors(SFBwfm)
+
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void free() APPLE_KEXT_OVERRIDE;
+	virtual IOReturn enable(IONetworkInterface *interface) APPLE_KEXT_OVERRIDE;
+	virtual SInt32 apple80211Request(bool set, int type, int value, void *data, uint32_t *len) APPLE_KEXT_OVERRIDE;
+	virtual const OSString *newVendorString() const APPLE_KEXT_OVERRIDE;
+	virtual const OSString *newModelString() const APPLE_KEXT_OVERRIDE;
+
+	IOPCIDevice *fPCI;
+	IOWorkLoop *fPollLoop;
+	IOTimerEventSource *fPollTimer;
+	IOInterruptEventSource *fIntSrc;
+	UInt32 fPollUS;
+	volatile UInt32 fIntrCount;
+	bool setupMSI();
+	static void intrAction(OSObject *owner, IOInterruptEventSource *sender, int count);
+	IOMemoryMap *fBars[BWFM_MAX_BARS];
+	int (*fIntrFn)(void *);
+	void *fIntrArg;
+	volatile bool fPolling;
+	static void pollAction(OSObject *owner, IOTimerEventSource *sender);
+
+private:
+	static void firmwareThread(void *arg, wait_result_t wr);
+	static void wakeThread(void *arg, wait_result_t wr);
+	static IOReturn sleepWake(void *target, void *refCon, UInt32 messageType, IOService *provider,
+	    void *messageArgument, vm_size_t argSize);
+	void bringUp();
+	void bringUpFailed(const char *what);
+	void systemSleep();
+	void systemWake();
+	IOReturn chipDown(int how, const char *why);
+	IOReturn chipUp(bool askBridge, const char *why);
+	IOReturn bridgeCall(const char *name, void *param2, void *param3);
+	void saveConfig();
+	bool restoreConfig();
+	static IOReturn syncAction(OSObject *owner, void *arg0, void *arg1, void *arg2, void *arg3);
+	void pauseInterrupts();
+	void resumeInterrupts();
+	void quiesceInterrupts();
+	void teardown(bool stopping);
+
+	struct sf_bwfm_dma fDma;
+	struct device *fDev;
+	IOLock *fLifecycle;		// one chipDown or chipUp at a time
+	IONotifier *fSleepWake;
+	bool fAttached;
+	bool f80211;
+	volatile bool fStopping;
+	volatile SInt32 fThreads;	// firmware and wake threads still running
+	int fOffMode;			// boot-arg bwfm_off, kOff*
+	bool fChipDown;			// the firmware was stopped on purpose: radio off or sleep
+	bool fPortDown;			// the bridge shut the port down, no register may be touched
+	bool fAsleep;
+	bool fSleepTookDown;		// this sleep stopped the firmware, the wake brings it back
+	bool fResumeUp;			// the interface ran when the system went to sleep
+	bool fHaveMSI;			// the bridge gave a vector, it goes back in stop
+	bool fConfigSaved;
+	UInt32 fSavedID;
+	UInt16 fSavedCommand;
+	UInt32 fSavedConfig[BWFM_SAVED_CONFIG];
+};
+
+#define super IO80211Controller
+OSDefineMetaClassAndStructors(SFBwfm, IO80211Controller)
+
+// the pci tag is the IOPCIDevice, this finds the driver behind it
+static struct {
+	IOPCIDevice *pci;
+	SFBwfm *owner;
+} sDevices[BWFM_MAX_DEVICES];
+static IOLock *sDevicesLock;
+
+static void setOwner(IOPCIDevice *pci, SFBwfm *owner)
+{
+	if (sDevicesLock == NULL) {
+		IOLock *lock = IOLockAlloc();
+
+		if (!OSCompareAndSwapPtr(NULL, lock, (void * volatile *)&sDevicesLock))
+			IOLockFree(lock);
+	}
+	IOLockLock(sDevicesLock);
+	for (int i = 0; i < BWFM_MAX_DEVICES; i++) {
+		if (owner != NULL && sDevices[i].pci == NULL) {
+			sDevices[i].pci = pci;
+			sDevices[i].owner = owner;
+			break;
+		}
+		if (owner == NULL && sDevices[i].pci == pci) {
+			sDevices[i].pci = NULL;
+			sDevices[i].owner = NULL;
+			break;
+		}
+	}
+	IOLockUnlock(sDevicesLock);
+}
+
+static SFBwfm *ownerOf(void *pci)
+{
+	SFBwfm *owner = NULL;
+
+	if (sDevicesLock == NULL)
+		return NULL;
+	IOLockLock(sDevicesLock);
+	for (int i = 0; i < BWFM_MAX_DEVICES; i++) {
+		if (sDevices[i].pci == pci)
+			owner = sDevices[i].owner;
+	}
+	IOLockUnlock(sDevicesLock);
+	return owner;
+}
+
+static bool rootMounted()
+{
+	vnode_t root = vfs_rootvnode();
+
+	if (root == NULLVP)
+		return false;
+	vnode_put(root);
+	return true;
+}
+
+bool SFBwfm::start(IOService *provider)
+{
+	struct pci_attach_args pa;
+	thread_t thread;
+
+	fPCI = OSDynamicCast(IOPCIDevice, provider);
+	if (fPCI == NULL || !super::start(provider))
+		return false;
+	if (!fPCI->open(this)) {
+		LOG("cannot open the pci device");
+		super::stop(provider);
+		return false;
+	}
+	fPollLoop = IOWorkLoop::workLoop();
+	fLifecycle = IOLockAlloc();
+	if (fPollLoop == NULL || fLifecycle == NULL) {
+		teardown(false);
+		super::stop(provider);
+		return false;
+	}
+	fOffMode = kOffStop;
+	PE_parse_boot_argn("bwfm_off", &fOffMode, sizeof(fOffMode));
+	if (fOffMode < kOffStop || fOffMode > kOffPower)
+		fOffMode = kOffStop;
+	setOwner(fPCI, this);
+	fPCI->setMemoryEnable(true);
+	fPCI->setBusMasterEnable(true);
+
+	fDma.pci = fPCI;
+	bzero(&pa, sizeof(pa));
+	pa.pa_pc = fPCI;
+	pa.pa_tag = fPCI;
+	pa.pa_dmat = &fDma;
+	pa.pa_id = fPCI->configRead32(kIOPCIConfigVendorID);
+	fSavedID = pa.pa_id;
+	LOG("attach: pci %04x:%04x, command 0x%04x, radio off mode %d (boot-arg bwfm_off)", pa.pa_id & 0xffff,
+	    pa.pa_id >> 16, fPCI->configRead16(kIOPCIConfigCommand), fOffMode);
+
+	fDev = sf_bwfm_alloc(SF_BWFM_NAME);
+	if (fDev == NULL || !sf_bwfm_match(&pa) || sf_bwfm_attach(fDev, &pa) != 0) {
+		LOG("the pci side did not attach");
+		teardown(false);
+		super::stop(provider);
+		return false;
+	}
+	fAttached = true;
+
+	// the firmware comes off the root file system. Waiting for it here would hold up the
+	// matching thread, so the rest of the bring-up has a thread of its own
+	OSIncrementAtomic(&fThreads);
+	retain();
+	if (kernel_thread_start(&SFBwfm::firmwareThread, this, &thread) != KERN_SUCCESS) {
+		release();
+		OSDecrementAtomic(&fThreads);
+		LOG("no thread for the firmware bring-up");
+		teardown(false);
+		super::stop(provider);
+		return false;
+	}
+	thread_deallocate(thread);
+	// Nothing comes of this unless the system really goes to sleep; the driver is not a
+	// power child of the pci device (IONetworkController gives that up when the driver
+	// registers no power states), so no power state change ever reaches it another way
+	fSleepWake = registerPrioritySleepWakeInterest(&SFBwfm::sleepWake, this, NULL);
+	if (fSleepWake == NULL)
+		LOG("attach: no sleep/wake notification, sleep is not handled");
+	LOG("attach: pci side done, firmware bring-up waits for the root file system");
+	return true;
+}
+
+void SFBwfm::firmwareThread(void *arg, wait_result_t wr)
+{
+	SFBwfm *self = (SFBwfm *)arg;
+
+	self->bringUp();
+	OSDecrementAtomic(&self->fThreads);
+	self->release();
+}
+
+void SFBwfm::bringUp()
+{
+	for (int i = 0; i < BWFM_ROOT_WAIT_S * 10 && !rootMounted() && !fStopping; i++)
+		IOSleep(100);
+	if (fStopping)
+		return;
+	if (!rootMounted()) {
+		LOG("no root file system after %d s, giving up", BWFM_ROOT_WAIT_S);
+		bringUpFailed("no root file system");
+		return;
+	}
+	LOG("root file system mounted, loading firmware from %s", SF_BWFM_FIRMWARE_DIR);
+	if (sf_bwfm_attach_hook(fDev) != 0) {
+		bringUpFailed("firmware bring-up");
+		return;
+	}
+	if (fStopping)
+		return;
+	LOG("firmware bring-up done, attaching the 802.11 interface");
+	if (!attach80211(sf_bwfm_ic(fDev))) {
+		// attach80211 hooked the interface before it failed
+		sf_bwfm_unhook(fDev);
+		fIC = NULL;
+		sf_bwfm_down(fDev, 0);
+		bringUpFailed("attach80211");
+		return;
+	}
+	f80211 = true;
+	registerService();
+	LOG("802.11 interface attached");
+	// There is no configd/InterfaceNamer in the RAM root: ask the stack to name every
+	// published interface, which is what IORegisterNetworkInterface does from userspace.
+	for (int i = 0; i < 10 && !fStopping; i++) {
+		OSObject *bsd = fInterface ? ((IOService *)fInterface)->copyProperty("BSD Name") : NULL;
+		OSString *name = OSDynamicCast(OSString, bsd);
+
+		if (name != NULL) {
+			LOG("interface is %s", name->getCStringNoCopy());
+			OSSafeReleaseNULL(bsd);
+			break;
+		}
+		OSSafeReleaseNULL(bsd);
+		OSDictionary *stackMatch = serviceMatching("IONetworkStack");
+		IOService *st = stackMatch ? copyMatchingService(stackMatch) : NULL;
+		OSDictionary *cmd = OSDictionary::withCapacity(1);
+		OSNumber *all = OSNumber::withNumber((unsigned long long)2 /* kIONetworkStackRegisterInterfaceAll */, 32);
+		if (st && cmd && all) {
+			cmd->setObject("IONetworkStackUserCommand", all);
+			st->setProperties(cmd);
+		}
+		OSSafeReleaseNULL(all);
+		OSSafeReleaseNULL(cmd);
+		OSSafeReleaseNULL(st);
+		OSSafeReleaseNULL(stackMatch);
+		IOSleep(500);
+	}
+}
+
+// The bus side has halted the chip and freed what the bring-up took (bwfm_attachhook); what
+// is left here is the interrupt, which has nothing to deliver any more. The driver stays
+// attached so nothing matches the device again, and stop() takes the rest apart.
+void SFBwfm::bringUpFailed(const char *what)
+{
+	quiesceInterrupts();
+	LOG("%s FAILED: no interface. The chip is quiet (reset, or never started), nothing is allocated for it, "
+	    "the interrupt is off; the driver stays attached and idle", what);
+}
+
+// stop: nothing of the driver may run or be reachable once the softc is freed. In order:
+//  1. the firmware and wake threads have ended (they see fStopping)
+//  2. no sleep/wake notification comes any more
+//  3. the 802.11 interface is detached, which stops it if it was up (scan aborted,
+//     disassociated, flow rings deleted: needs the interrupt, so it comes first), and the
+//     stack's hooks into this controller are cleared
+//  4. the chip is masked and reset and every ring, buffer and DMA mapping is released
+//  5. the MSI source and the poll timer are off the work loop: no handler runs from here on
+//  6. net80211 is detached: control messages and the task thread are out of the softc
+//  7. the MSI vector goes back to the bridge, bus mastering is off; with bwfm_off=2 the port
+//     is shut down
+//  8. softc, BAR mappings and work loop are released, the pci device is closed
+// Every step looks at what exists, so this is also what a failed start runs.
+void SFBwfm::stop(IOService *provider)
+{
+	LOG("stop: waiting for the driver's threads");
+	fStopping = true;
+	for (int i = 0; fThreads > 0; i++) {
+		IOSleep(50);
+		if (i % 200 == 199)
+			LOG("stop: a driver thread is still running after %d s", (i + 1) / 20);
+	}
+	if (fSleepWake != NULL) {
+		fSleepWake->remove();
+		fSleepWake = NULL;
+	}
+	if (f80211) {
+		LOG("stop: detaching the 802.11 interface");
+		detach80211();
+		sf_bwfm_unhook(fDev);
+	}
+	f80211 = false;
+	teardown(true);
+	LOG("stop: done");
+	super::stop(provider);
+}
+
+void SFBwfm::teardown(bool stopping)
+{
+	if (fLifecycle != NULL)
+		IOLockLock(fLifecycle);
+	// with the port down the chip was halted on the way there, and the DART is not read
+	if (fAttached && !fPortDown) {
+		LOG("stop: halting the chip");
+		sf_bwfm_down(fDev, 0);
+	}
+	// no handler may run once the softc goes away
+	quiesceInterrupts();
+	if (fAttached && sf_bwfm_detach(fDev) != 0) {
+		// better a leak than a thread on freed memory
+		LOG("stop: something is still inside the driver state, it is NOT freed");
+		fDev = NULL;
+	} else if (fAttached) {
+		LOG("stop: net80211 detached");
+	}
+	fAttached = false;
+	if (fPCI != NULL && fHaveMSI) {
+		// with the port down the bridge only takes the vector back
+		bridgeCall("SFApcieReleaseMSI", fPCI, NULL);
+		fHaveMSI = false;
+	}
+	if (fPCI != NULL && !fPortDown) {
+		fPCI->setBusMasterEnable(false);
+		// never on the way out of a failed start: that would be a boot path
+		if (stopping && fOffMode == kOffPower) {
+			UInt32 portDown = 0;
+
+			LOG("stop: bwfm_off=2, asking the bridge to shut the port down and switch the radio off");
+			bridgeCall("SFApciePortShutdown", (void *)(uintptr_t)1, &portDown);
+			fPortDown = portDown != 0;
+		}
+	}
+	if (fDev != NULL)
+		sf_bwfm_free(fDev);
+	fDev = NULL;
+	for (int i = 0; i < BWFM_MAX_BARS; i++)
+		OSSafeReleaseNULL(fBars[i]);
+	OSSafeReleaseNULL(fPollLoop);
+	if (fPCI != NULL) {
+		setOwner(fPCI, NULL);
+		fPCI->close(this);
+	}
+	// the lock itself stays until free(): a request that came in late may still wait for it
+	if (fLifecycle != NULL)
+		IOLockUnlock(fLifecycle);
+}
+
+void SFBwfm::free()
+{
+	if (fLifecycle != NULL)
+		IOLockFree(fLifecycle);
+	fLifecycle = NULL;
+	super::free();
+}
+
+// the interrupt sources: paused while the port is down (the poll also reads the DART, which
+// may not be powered then), gone for good in stop
+
+IOReturn SFBwfm::syncAction(OSObject *owner, void *arg0, void *arg1, void *arg2, void *arg3)
+{
+	return kIOReturnSuccess;
+}
+
+void SFBwfm::pauseInterrupts()
+{
+	fPolling = false;
+	if (fIntSrc != NULL)
+		fIntSrc->disable();
+	if (fPollTimer != NULL)
+		fPollTimer->cancelTimeout();
+	// a handler that was already running is through once this comes back
+	if (fPollLoop != NULL)
+		fPollLoop->runAction(&SFBwfm::syncAction, this);
+}
+
+void SFBwfm::resumeInterrupts()
+{
+	if (fPollTimer == NULL)
+		return;
+	fPolling = true;
+	if (fIntSrc != NULL)
+		fIntSrc->enable();
+	fPollTimer->setTimeoutUS(fPollUS);
+}
+
+void SFBwfm::quiesceInterrupts()
+{
+	fPolling = false;
+	if (fIntSrc != NULL) {
+		fIntSrc->disable();
+		if (fPollLoop != NULL)
+			fPollLoop->removeEventSource(fIntSrc);
+		OSSafeReleaseNULL(fIntSrc);
+	}
+	if (fPollTimer != NULL) {
+		fPollTimer->cancelTimeout();
+		fPollTimer->disable();
+		if (fPollLoop != NULL)
+			fPollLoop->removeEventSource(fPollTimer);
+		OSSafeReleaseNULL(fPollTimer);
+	}
+}
+
+// radio off beyond the interface stop, and system sleep
+
+IOReturn SFBwfm::bridgeCall(const char *name, void *param2, void *param3)
+{
+	const OSSymbol *fn = OSSymbol::withCString(name);
+	IOReturn ret = fn ? fPCI->callPlatformFunction(fn, true, this, param2, param3, NULL) : kIOReturnNoMemory;
+
+	OSSafeReleaseNULL(fn);
+	if (ret != kIOReturnSuccess)
+		LOG("%s: the host bridge answered 0x%x", name, ret);
+	return ret;
+}
+
+void SFBwfm::saveConfig()
+{
+	fSavedCommand = fPCI->configRead16(kIOPCIConfigCommand);
+	for (unsigned i = 0; i < BWFM_SAVED_CONFIG; i++)
+		fSavedConfig[i] = fPCI->configRead32(kSavedConfig[i]);
+	fConfigSaved = true;
+}
+
+// true when something had to be written back, which means the function lost its state
+bool SFBwfm::restoreConfig()
+{
+	bool lost = false;
+
+	if (!fConfigSaved)
+		return false;
+	for (unsigned i = 0; i < BWFM_SAVED_CONFIG; i++) {
+		if (fPCI->configRead32(kSavedConfig[i]) != fSavedConfig[i]) {
+			fPCI->configWrite32(kSavedConfig[i], fSavedConfig[i]);
+			lost = true;
+		}
+	}
+	if (fPCI->configRead16(kIOPCIConfigCommand) != fSavedCommand) {
+		fPCI->configWrite16(kIOPCIConfigCommand, fSavedCommand);
+		lost = true;
+	}
+	return lost;
+}
+
+// The firmware is stopped and everything it used is released (how: kDown*).
+// Order: interface stop, D3 inform, chip masked and reset, buffers and mappings released
+// (all in sf_bwfm_down: the last BAR and DART access), config space saved. Beyond a plain
+// halt: interrupt sources paused (the poll reads the DART), the bus told to keep off the
+// registers, and for kDownPower the port shut down and the radio's power off in the bridge.
+// For sleep the port is only counted as down: the SoC may take its power, so nothing reaches
+// for the chip or the DART until chipUp has asked the bridge.
+IOReturn SFBwfm::chipDown(int how, const char *why)
+{
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(fLifecycle);
+	if (fPortDown || fStopping || !fAttached) {
+		IOLockUnlock(fLifecycle);
+		return kIOReturnSuccess;
+	}
+	LOG("%s: stopping the firmware%s", why, how == kDownPower ? ", then the port and the radio's power" : "");
+	int d3 = sf_bwfm_down(fDev, 1);
+	saveConfig();
+	fChipDown = true;
+	LOG("%s: firmware stopped (D3 inform %s), chip reset, config space saved", why,
+	    d3 == 0 ? "acknowledged" : "not acknowledged");
+	if (how != kDownHalt) {
+		pauseInterrupts();
+		sf_bwfm_set_gone(fDev, 1);
+	}
+	if (how == kDownSleep) {
+		fPortDown = true;
+		LOG("%s: interrupt sources paused, chip and DART not touched until the bridge has the port back", why);
+	} else if (how == kDownPower) {
+		UInt32 portDown = 0;
+
+		// flags bit 0: also switch the radio's power off through the SMC
+		ret = bridgeCall("SFApciePortShutdown", (void *)(uintptr_t)1, &portDown);
+		fPortDown = portDown != 0;
+		if (!fPortDown) {
+			LOG("%s: the port is NOT shut down, the chip stays reachable", why);
+			sf_bwfm_set_gone(fDev, 0);
+			resumeInterrupts();
+		} else {
+			LOG("%s: port shut down%s", why, ret == kIOReturnSuccess ? ", radio power off" :
+			    ", radio power off FAILED");
+		}
+	}
+	IOLockUnlock(fLifecycle);
+	return ret;
+}
+
+// The way back up to the point where the firmware can be loaded: bwfm_init does that when
+// the interface is brought up. Order: port (the bridge brings the link up if it is down),
+// function there, config space, DART, MSI, then the bus may touch registers again and the
+// interrupt sources run. Nothing is written that still has its value.
+IOReturn SFBwfm::chipUp(bool askBridge, const char *why)
+{
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(fLifecycle);
+	if (fStopping || !fAttached || (!fChipDown && !fPortDown)) {
+		IOLockUnlock(fLifecycle);
+		return kIOReturnSuccess;
+	}
+	if (fPortDown || askBridge) {
+		UInt32 linkUp = 0;
+
+		LOG("%s: asking the bridge for the port", why);
+		ret = bridgeCall("SFApciePortResume", &linkUp, NULL);
+		if (ret != kIOReturnSuccess || !linkUp) {
+			LOG("%s: no link, the chip stays down and is not touched", why);
+			// from here on nothing may reach for a register, whatever state we were in
+			pauseInterrupts();
+			sf_bwfm_set_gone(fDev, 2);
+			fPortDown = true;
+			IOLockUnlock(fLifecycle);
+			return ret != kIOReturnSuccess ? ret : kIOReturnNotReady;
+		}
+	}
+	UInt32 id = fPCI->configRead32(kIOPCIConfigVendorID);
+	if (id != fSavedID) {
+		LOG("%s: the function reads id 0x%08x instead of 0x%08x, the chip stays down and is not touched",
+		    why, id, fSavedID);
+		pauseInterrupts();
+		sf_bwfm_set_gone(fDev, 2);
+		fPortDown = true;
+		IOLockUnlock(fLifecycle);
+		return kIOReturnNoDevice;
+	}
+	bool lost = restoreConfig();
+	int dart = sf_bwfm_dma_resume();
+	if (lost && fIntSrc != NULL) {
+		UInt32 vector = 0;
+		// the bridge gives the same vector again and writes the MSI capability
+		ret = bridgeCall("SFApcieSetupMSI", fPCI, &vector);
+		if (ret != kIOReturnSuccess)
+			LOG("%s: no MSI any more, the poll timer serves the chip", why);
+		ret = kIOReturnSuccess;
+	}
+	LOG("%s: chip reachable, config space %s, DART %s", why, lost ? "was lost and is restored" : "intact",
+	    dart == 0 ? "translating" : "NOT translating");
+	if (dart != 0) {
+		// no DMA without the DART: the firmware must not be loaded
+		LOG("%s: no DMA without the DART, the chip stays down", why);
+		sf_bwfm_set_gone(fDev, 1);
+		fChipDown = true;
+		IOLockUnlock(fLifecycle);
+		return kIOReturnNotReady;
+	}
+	sf_bwfm_set_gone(fDev, 0);
+	fPortDown = false;
+	fChipDown = false;
+	resumeInterrupts();
+	IOLockUnlock(fLifecycle);
+	return ret;
+}
+
+IOReturn SFBwfm::enable(IONetworkInterface *interface)
+{
+	// every way to a running interface goes through chipUp once the chip was taken down
+	if ((fChipDown || fPortDown) && chipUp(false, "interface up") != kIOReturnSuccess)
+		return kIOReturnNotReady;
+	return super::enable(interface);
+}
+
+// The requests that change the radio pass through here: power is where bwfm_off takes
+// effect, and once the chip was taken down every other one first needs it back.
+// FXNET: APPLE80211_IOC_POWERSAVE carries SiliconForest's own layout, not Apple's: a set takes
+// version, mode (0 constantly awake, 1 PS-Poll, 2 fast power save) and pm2_ret_ms (0 keeps
+// it); a get fills in what init will give the firmware and what the firmware says now (-1 when
+// it was not running). sf-wifipm (m1-bwfm/tools) is the userspace side.
+struct sf80211_powersave_data {
+	uint32_t	version;
+	uint32_t	mode;
+	uint32_t	pm2_ret_ms;
+	int32_t		fw_mode;
+	int32_t		fw_pm2_ret_ms;
+};
+
+SInt32 SFBwfm::apple80211Request(bool set, int type, int value, void *data, uint32_t *len)
+{
+	if (type == APPLE80211_IOC_POWERSAVE && fIC != NULL && fDev != NULL && len != NULL && data != NULL) {
+		struct sf80211_powersave_data *ps = (struct sf80211_powersave_data *)data;
+
+		if (set) {
+			if (*len < 3 * sizeof(uint32_t))
+				return EINVAL;
+			if ((fChipDown || fPortDown) && chipUp(false, "power save") != kIOReturnSuccess)
+				return EIO;
+			LOG("power save: mode %u, pm2_sleep_ret %u ms requested", ps->mode, ps->pm2_ret_ms);
+			return sf_bwfm_set_pm(fDev, (int)ps->mode, (int)ps->pm2_ret_ms);
+		}
+		if (*len < sizeof(*ps))
+			return EINVAL;
+		int fwMode, fwRet, wantMode, wantRet;
+		sf_bwfm_get_pm(fDev, &fwMode, &fwRet, &wantMode, &wantRet);
+		ps->version = APPLE80211_VERSION;
+		ps->mode = (uint32_t)wantMode;
+		ps->pm2_ret_ms = (uint32_t)wantRet;
+		ps->fw_mode = fwMode;
+		ps->fw_pm2_ret_ms = fwRet;
+		*len = sizeof(*ps);
+		return 0;
+	}
+	if (!set || fIC == NULL)
+		return super::apple80211Request(set, type, value, data, len);
+	if (type == APPLE80211_IOC_POWER && len != NULL && *len >= sizeof(struct apple80211_power_data)) {
+		bool on = ((struct apple80211_power_data *)data)->power_state != 0;
+		SInt32 error;
+
+		if (on) {
+			LOG("radio on");
+			if ((fChipDown || fPortDown) && chipUp(false, "radio on") != kIOReturnSuccess)
+				return EIO;
+			error = super::apple80211Request(set, type, value, data, len);
+			if (error == 0)
+				LOG("radio on: interface running");
+			else
+				LOG("radio on: FAILED (error %d), last control message: %s", error, sf_bwfm_ctlwhy(fDev));
+			return error;
+		}
+		LOG("radio off, mode %d", fOffMode);
+		error = fPortDown ? 0 : super::apple80211Request(set, type, value, data, len);
+		if (fOffMode >= kOffHalt)
+			chipDown(fOffMode == kOffPower ? kDownPower : kDownHalt, "radio off");
+		LOG("radio off: done (interface stop result %d)", error);
+		return error;
+	}
+	// scan, join and the like start the interface themselves
+	if ((fChipDown || fPortDown) && chipUp(false, "request") != kIOReturnSuccess)
+		return EIO;
+	return super::apple80211Request(set, type, value, data, len);
+}
+
+// System sleep and wake. UNTESTED: the guest under the hypervisor cannot sleep. Priority
+// clients get the capability change on current kernels and the classic messages on older
+// ones; both are taken, fAsleep makes the second of a pair a no-op. Returning without
+// touching the argument acknowledges at once: the work on the way down is done right here,
+// so the system does not go on to sleep before the firmware is quiet.
+IOReturn SFBwfm::sleepWake(void *target, void *refCon, UInt32 messageType, IOService *provider,
+    void *messageArgument, vm_size_t argSize)
+{
+	SFBwfm *self = (SFBwfm *)target;
+	bool sleep = messageType == kIOMessageSystemWillSleep;
+	bool wake = messageType == kIOMessageSystemHasPoweredOn;
+
+	if (messageType == kIOMessageSystemCapabilityChange &&
+	    argSize == sizeof(IOPMSystemCapabilityChangeParameters)) {
+		IOPMSystemCapabilityChangeParameters *params = (IOPMSystemCapabilityChangeParameters *)messageArgument;
+		bool fromCPU = (params->fromCapabilities & kIOPMSystemCapabilityCPU) != 0;
+		bool toCPU = (params->toCapabilities & kIOPMSystemCapabilityCPU) != 0;
+
+		if ((params->changeFlags & kIOPMSystemCapabilityWillChange) && fromCPU && !toCPU)
+			sleep = true;
+		if ((params->changeFlags & kIOPMSystemCapabilityDidChange) && !fromCPU && toCPU)
+			wake = true;
+	}
+	if (sleep)
+		self->systemSleep();
+	else if (wake)
+		self->systemWake();
+	return kIOReturnSuccess;
+}
+
+void SFBwfm::systemSleep()
+{
+	if (fAsleep || fStopping)
+		return;
+	fAsleep = true;
+	fSleepTookDown = false;
+	if (!fAttached || fPortDown) {
+		LOG("sleep: the port is down already, nothing to do");
+		return;
+	}
+	// also with the firmware stopped by a radio off: the poll must not read the DART
+	// across a sleep, and the wake has to ask the bridge for the port
+	fResumeUp = f80211 && !fChipDown && sf_bwfm_running(fDev) != 0;
+	LOG("sleep: interface %s", fResumeUp ? "running, it comes back on wake" : "down, it stays down on wake");
+	chipDown(kDownSleep, "sleep");
+	fSleepTookDown = true;
+}
+
+void SFBwfm::systemWake()
+{
+	thread_t thread;
+
+	if (!fAsleep || fStopping)
+		return;
+	fAsleep = false;
+	if (!fSleepTookDown) {
+		LOG("wake: the port was down before sleep, nothing to do");
+		return;
+	}
+	fSleepTookDown = false;
+	// loading the firmware takes seconds and needs the file system: not on the power thread
+	OSIncrementAtomic(&fThreads);
+	retain();
+	if (kernel_thread_start(&SFBwfm::wakeThread, this, &thread) != KERN_SUCCESS) {
+		release();
+		OSDecrementAtomic(&fThreads);
+		LOG("wake: no thread, the radio stays off until it is switched on");
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+void SFBwfm::wakeThread(void *arg, wait_result_t wr)
+{
+	SFBwfm *self = (SFBwfm *)arg;
+
+	LOG("wake: bringing the chip back");
+	if (self->chipUp(true, "wake") != kIOReturnSuccess)
+		LOG("wake: the chip did not come back, the radio stays off");
+	else if (!self->fResumeUp)
+		LOG("wake: chip back, the interface was down and stays down");
+	else if (self->fStopping)
+		LOG("wake: the driver is stopping");
+	else
+		LOG("wake: interface %s", sf_bwfm_up(self->fDev) == 0 ? "running again" : "did NOT come up");
+	OSDecrementAtomic(&self->fThreads);
+	self->release();
+}
+
+const OSString *SFBwfm::newVendorString() const
+{
+	return OSString::withCString("Broadcom");
+}
+
+const OSString *SFBwfm::newModelString() const
+{
+	return OSString::withCString("BCM4378 802.11ax");
+}
+
+// openbsd runs the interrupt handler at IPL_NET, here it runs on the poll work loop under the stack lock
+void SFBwfm::pollAction(OSObject *owner, IOTimerEventSource *sender)
+{
+	static unsigned ticks;
+	SFBwfm *self = (SFBwfm *)owner;
+
+	// paused while the port is down: neither the chip nor the DART may be read then
+	if (!self->fPolling)
+		return;
+	// a DART fault is logged and cleared here; with MSI this timer is only a slow safety net
+	if (++ticks % 16 == 0)
+		sf_dart_pool_check("poll");
+	sf80211_lock();
+	if (self->fIntrFn != NULL)
+		self->fIntrFn(self->fIntrArg);
+	sf80211_unlock();
+	if (self->fPolling)
+		sender->setTimeoutUS(self->fPollUS);
+}
+
+// the openbsd calls bwfm makes
+
+extern "C" {
+
+// every file asked for is logged with its result, the names are bwfm's fallback chain
+int loadfirmware(const char *name, u_char **bufp, size_t *sizep)
+{
+	char path[MAXPATHLEN];
+	vfs_context_t ctx;
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	u_char *buf = NULL;
+	size_t len = 0;
+	int error, resid = 0;
+
+	snprintf(path, sizeof(path), "%s/%s", SF_BWFM_FIRMWARE_DIR, name);
+	if (!rootMounted()) {
+		LOG("firmware file %s: no root file system", path);
+		return ENOENT;
+	}
+	ctx = vfs_context_create(NULL);
+	error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (error != 0) {
+		vfs_context_rele(ctx);
+		LOG("firmware file %s: not found (error %d)", path, error);
+		return error;
+	}
+
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	error = vnode_getattr(vp, &va, ctx);
+	if (error == 0 && (va.va_data_size == 0 || va.va_data_size > 32 * 1024 * 1024))
+		error = EFBIG;
+	if (error == 0) {
+		len = (size_t)va.va_data_size;
+		buf = (u_char *)sf80211_malloc(len, 2, 0);
+		if (buf == NULL)
+			error = ENOMEM;
+	}
+	if (error == 0) {
+		error = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, 0, UIO_SYSSPACE, 0,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error == 0 && resid != 0)
+			error = EIO;
+	}
+
+	vnode_close(vp, FREAD, ctx);
+	vfs_context_rele(ctx);
+	if (error != 0) {
+		if (buf != NULL)
+			sf80211_free(buf, 2, len);
+		LOG("firmware file %s: found but unreadable (error %d)", path, error);
+		return error;
+	}
+	LOG("firmware file %s: found, %zu bytes", path, len);
+	*bufp = buf;
+	*sizep = len;
+	return 0;
+}
+
+// a property of the Apple device tree, as XNU publishes it in the IORegistry
+int sf_bwfm_adt_prop(const char *path, const char *name, void *buf, int len)
+{
+	IORegistryEntry *entry = IORegistryEntry::fromPath(path, gIODTPlane);
+	OSData *data;
+	int n = -1;
+
+	if (entry == NULL)
+		return -1;
+	data = OSDynamicCast(OSData, entry->getProperty(name));
+	if (data != NULL) {
+		n = (int)data->getLength();
+		if (buf != NULL && len > 0)
+			memcpy(buf, data->getBytesNoCopy(), n < len ? n : len);
+	}
+	entry->release();
+	return n;
+}
+
+int sf_bwfm_bootarg(const char *name, char *buf, int len)
+{
+	char value[64];
+
+	if (!PE_parse_boot_argn(name, value, sizeof(value)) || value[0] == '\0')
+		return 0;
+	strlcpy(buf, value, len);
+	return 1;
+}
+
+int sf_bwfm_want_fwsup(void)
+{
+	int value = 1;
+
+	PE_parse_boot_argn("bwfm_fwsup", &value, sizeof(value));
+	return value != 0;
+}
+
+// Off by default: the driver never acknowledged the request on hardware, and with the
+// acknowledgement the firmware may really go to sleep, also while associated
+int sf_bwfm_want_dsack(void)
+{
+	int value = 0;
+
+	PE_parse_boot_argn("bwfm_dsack", &value, sizeof(value));
+	return value != 0;
+}
+
+// FXNET: replies that come more than the firmware's 200 ms after our last frame waited for
+// the next DTIM beacon in fast power save (LAN ping at 1 s: p50 159 ms, max 318 ms)
+int sf_bwfm_want_pm(void)
+{
+	int value = 2;
+
+	PE_parse_boot_argn("bwfm_pm", &value, sizeof(value));
+	return value >= 0 && value <= 2 ? value : 2;
+}
+
+int sf_bwfm_want_pm2_ret(void)
+{
+	int value = 2000;
+
+	PE_parse_boot_argn("bwfm_pm2_ret", &value, sizeof(value));
+	return value >= 0 && value <= 60000 ? value : 2000;
+}
+
+// config space, the tag is the IOPCIDevice
+
+pcireg_t pci_conf_read(pci_chipset_tag_t pc, pcitag_t tag, int reg)
+{
+	return ((IOPCIDevice *)tag)->configRead32(reg);
+}
+
+void pci_conf_write(pci_chipset_tag_t pc, pcitag_t tag, int reg, pcireg_t val)
+{
+	((IOPCIDevice *)tag)->configWrite32(reg, val);
+}
+
+// bwfm maps two BARs, the register window (0x10) and the chip's memory (0x18)
+int pci_mapreg_map(struct pci_attach_args *pa, int reg, pcireg_t type, int flags,
+    bus_space_tag_t *tagp, bus_space_handle_t *handlep, bus_addr_t *basep,
+    bus_size_t *sizep, bus_size_t maxsize)
+{
+	IOPCIDevice *pci = (IOPCIDevice *)pa->pa_tag;
+	SFBwfm *owner = ownerOf(pci);
+	IOMemoryMap *map;
+	int slot = -1;
+
+	if (owner == NULL)
+		return ENXIO;
+	for (int i = 0; i < BWFM_MAX_BARS && slot < 0; i++) {
+		if (owner->fBars[i] == NULL)
+			slot = i;
+	}
+	if (slot < 0)
+		return ENOMEM;
+	// Apple PCIe windows must be mapped posted-write (Device-nGnRE): a non-posted write faults (SError)
+	map = pci->mapDeviceMemoryWithRegister((UInt8)reg, kIOMapPostedWrite);
+	if (map == NULL) {
+		LOG("attach: BAR at config 0x%02x did not map", reg);
+		return ENOMEM;
+	}
+	owner->fBars[slot] = map;
+	LOG("attach: BAR at config 0x%02x mapped, physical 0x%llx, %llu bytes", reg,
+	    (unsigned long long)map->getPhysicalAddress(), (unsigned long long)map->getLength());
+	if (tagp != NULL)
+		*tagp = 0;
+	if (handlep != NULL)
+		*handlep = (bus_space_handle_t)map->getVirtualAddress();
+	if (basep != NULL)
+		*basep = map->getPhysicalAddress();
+	if (sizep != NULL)
+		*sizep = map->getLength();
+	return 0;
+}
+
+int pci_matchbyid(struct pci_attach_args *pa, const struct pci_matchid *ids, int n)
+{
+	for (int i = 0; i < n; i++) {
+		if (PCI_VENDOR(pa->pa_id) == ids[i].pm_vid && PCI_PRODUCT(pa->pa_id) == ids[i].pm_pid)
+			return 1;
+	}
+	return 0;
+}
+
+// "establishing" the interrupt sets up one MSI vector and a slow fallback poll (fast poll if MSI is unavailable)
+
+int pci_intr_map_msi(struct pci_attach_args *pa, pci_intr_handle_t *ih)
+{
+	ih->ih_index = 0;
+	return 0;
+}
+
+int pci_intr_map(struct pci_attach_args *pa, pci_intr_handle_t *ih)
+{
+	ih->ih_index = 0;
+	return 0;
+}
+
+const char *pci_intr_string(pci_chipset_tag_t pc, pci_intr_handle_t ih)
+{
+	return "msi";
+}
+
+void *pci_intr_establish(pci_chipset_tag_t pc, pci_intr_handle_t ih, int level,
+    int (*fn)(void *), void *arg, const char *name)
+{
+	SFBwfm *owner = ownerOf(pc);
+
+	if (owner == NULL || owner->fPollTimer != NULL)
+		return NULL;
+	owner->fIntrFn = fn;
+	owner->fIntrArg = arg;
+	owner->fPollTimer = IOTimerEventSource::timerEventSource(owner, &SFBwfm::pollAction);
+	if (owner->fPollTimer == NULL ||
+	    owner->fPollLoop->addEventSource(owner->fPollTimer) != kIOReturnSuccess) {
+		OSSafeReleaseNULL(owner->fPollTimer);
+		return NULL;
+	}
+	owner->fPolling = true;
+	owner->fPollUS = SF_BWFM_POLL_US;
+	if (owner->setupMSI())
+		owner->fPollUS = SF_BWFM_MSI_FALLBACK_POLL_US;
+	owner->fPollTimer->enable();
+	owner->fPollTimer->setTimeoutUS(owner->fPollUS);
+	LOG("attach: %s, handler also polled every %u us", owner->fIntSrc ? "MSI interrupt" : "no interrupt", owner->fPollUS);
+	return owner;
+}
+
+void SFBwfm::intrAction(OSObject *owner, IOInterruptEventSource *sender, int count)
+{
+	SFBwfm *self = (SFBwfm *)owner;
+
+	if (self->fIntrCount++ == 0)
+		LOG("first MSI interrupt delivered");
+	if (!self->fPolling)
+		return;
+	sf80211_lock();
+	if (self->fIntrFn != NULL)
+		self->fIntrFn(self->fIntrArg);
+	sf80211_unlock();
+}
+
+/*
+ * One MSI vector, allocated and programmed by the host bridge (SFApcieSetupMSI), which
+ * also describes the interrupt on this service. The handler then hangs off an ordinary
+ * IOInterruptEventSource on this service, not the PCI nub, whose interrupt state
+ * IOPCIFamily already resolved without a controller.
+ */
+bool SFBwfm::setupMSI()
+{
+	const OSSymbol *fn = OSSymbol::withCString("SFApcieSetupMSI");
+	UInt32 vector = 0;
+	IOReturn ret = fn ? fPCI->callPlatformFunction(fn, true, this, fPCI, &vector, NULL) : kIOReturnNoMemory;
+
+	OSSafeReleaseNULL(fn);
+	if (ret != kIOReturnSuccess) {
+		LOG("msi: the host bridge gave no vector (0x%x)", ret);
+		return false;
+	}
+	fHaveMSI = true;
+	fIntSrc = IOInterruptEventSource::interruptEventSource(this, &SFBwfm::intrAction, this, 0);
+	if (fIntSrc == NULL || fPollLoop->addEventSource(fIntSrc) != kIOReturnSuccess) {
+		LOG("msi: no interrupt event source for AIC vector %u", vector);
+		OSSafeReleaseNULL(fIntSrc);
+		return false;
+	}
+	fIntSrc->enable();
+	LOG("msi: AIC vector %u from the host bridge", vector);
+	return true;
+}
+
+
+void pci_intr_disestablish(pci_chipset_tag_t pc, void *cookie)
+{
+	SFBwfm *owner = (SFBwfm *)cookie;
+
+	if (owner == NULL || owner->fPollTimer == NULL)
+		return;
+	owner->fPolling = false;
+	owner->fPollTimer->cancelTimeout();
+}
+
+}
diff -ruN a/src/Kernel/Extensions/SFBwfm/sf_bwfm_glue.c b/src/Kernel/Extensions/SFBwfm/sf_bwfm_glue.c
--- a/src/Kernel/Extensions/SFBwfm/sf_bwfm_glue.c	1969-12-31 16:00:00.000000000 -0800
+++ b/src/Kernel/Extensions/SFBwfm/sf_bwfm_glue.c	2026-11-15 23:56:07.713710790 -0800
@@ -0,0 +1,975 @@
+// SPDX-License-Identifier: MIT
+// what SFBwfm.cpp needs from bwfm(4) without seeing its softc, the device tree answers bwfm
+// asks for, and OpenBSD's bus_dma on the DART: per-buffer mapping (sf_dart_map.h), or the
+// bounce pool (sf_dart_pool.h) with SF_BWFM_DMA_BOUNCE. Derived from SFQwx's sf_qwx_glue.c.
+
+#include "sf_bwfm_compat.h"
+#include <net80211/ieee80211_var.h>
+
+#include "bwfmvar.h"
+#include "sf_bwfm_glue.h"
+#include "sf_dart_pool.h"
+#include "sf_dart_map.h"
+
+// SF_BWFM_DMA_BOUNCE brings back the fixed bounce pool, the default maps every buffer
+#ifdef SF_BWFM_DMA_BOUNCE
+#define sf_bwfm_dma_init()	sf_dart_pool_init()
+#define sf_bwfm_dma_check(why)	sf_dart_pool_check(why)
+#define SF_BWFM_DMA_WHAT	"DMA pool"
+#else
+#define sf_bwfm_dma_init()	sf_dart_init()
+#define sf_bwfm_dma_check(why)	sf_dart_check(why)
+#define SF_BWFM_DMA_WHAT	"DART mapper"
+#endif
+
+extern const struct cfattach bwfm_pci_ca;
+
+// the attach hook bwfm defers to after the root mount, one per device
+struct sf_bwfm_hook {
+	struct device	*dev;
+	void		(*fn)(struct device *);
+};
+static struct sf_bwfm_hook sf_bwfm_hooks[2];
+
+void
+sf_bwfm_mountroot(struct device *dev, void (*fn)(struct device *))
+{
+	for (int i = 0; i < (int)nitems(sf_bwfm_hooks); i++) {
+		if (sf_bwfm_hooks[i].dev == NULL || sf_bwfm_hooks[i].dev == dev) {
+			sf_bwfm_hooks[i].dev = dev;
+			sf_bwfm_hooks[i].fn = fn;
+			return;
+		}
+	}
+	printf("%s: no room for the attach hook\n", dev->dv_xname);
+}
+
+static void
+(*sf_bwfm_take_hook(struct device *dev))(struct device *)
+{
+	for (int i = 0; i < (int)nitems(sf_bwfm_hooks); i++) {
+		if (sf_bwfm_hooks[i].dev == dev) {
+			void (*fn)(struct device *) = sf_bwfm_hooks[i].fn;
+
+			sf_bwfm_hooks[i].dev = NULL;
+			sf_bwfm_hooks[i].fn = NULL;
+			return fn;
+		}
+	}
+	return NULL;
+}
+
+struct device *
+sf_bwfm_alloc(const char *name)
+{
+	struct device *dev = malloc(bwfm_pci_ca.ca_devsize, M_DEVBUF, M_WAITOK | M_ZERO);
+
+	if (dev == NULL)
+		return NULL;
+	strlcpy(dev->dv_xname, name, sizeof(dev->dv_xname));
+	return dev;
+}
+
+void
+sf_bwfm_free(struct device *dev)
+{
+	free(dev, M_DEVBUF, bwfm_pci_ca.ca_devsize);
+}
+
+int
+sf_bwfm_match(struct pci_attach_args *pa)
+{
+	return bwfm_pci_ca.ca_match(NULL, NULL, pa);
+}
+
+// the pci half: both BARs mapped, the interrupt established, net80211 attached, no firmware yet
+int
+sf_bwfm_attach(struct device *dev, struct pci_attach_args *pa)
+{
+	sf80211_lock();
+	bwfm_pci_ca.ca_attach(NULL, dev, pa);
+	sf80211_unlock();
+
+	// bwfm_pci_attach registers its hook only once everything is set up
+	for (int i = 0; i < (int)nitems(sf_bwfm_hooks); i++) {
+		if (sf_bwfm_hooks[i].dev == dev)
+			return 0;
+	}
+	return ENXIO;
+}
+
+static void	sf_bwfm_dma_report(const char *);
+
+// the firmware half, run once the root file system is there. bwfm sleeps for every control
+// message, which gives up the stack lock, so the lock is held around the whole hook
+int
+sf_bwfm_attach_hook(struct device *dev)
+{
+	void (*fn)(struct device *) = sf_bwfm_take_hook(dev);
+	struct bwfm_softc *sc = (struct bwfm_softc *)dev;
+
+	if (fn == NULL)
+		return ENXIO;
+	if (sf_bwfm_dma_init() != 0) {
+		printf("%s: the " SF_BWFM_DMA_WHAT " did not come up\n", dev->dv_xname);
+		return ENOMEM;
+	}
+	sf80211_lock();
+	// a bring-up that fails halts the chip and frees what it took, see bwfm_attachhook
+	fn(dev);
+	if (!sc->sc_initialized)
+		sf_bwfm_dma_check("bring-up failed");
+	sf80211_unlock();
+	sf_bwfm_dma_report(dev->dv_xname);
+	return sc->sc_initialized ? 0 : EIO;
+}
+
+// the lifecycle after the bring-up. Each of these takes the stack lock and waits for an init
+// or stop that is under way (bwfm_lifecycle_enter), so they may come from any thread
+
+// why the last control message to the firmware failed, for the stage logs
+const char *
+sf_bwfm_ctlwhy(struct device *dev)
+{
+	struct bwfm_softc *sc = (struct bwfm_softc *)dev;
+
+	return sc->sc_bus_ops != NULL && sc->sc_bus_ops->bs_ctlwhy != NULL ?
+	    sc->sc_bus_ops->bs_ctlwhy(sc) : "?";
+}
+
+int
+sf_bwfm_running(struct device *dev)
+{
+	return (((struct bwfm_softc *)dev)->sc_ic.ic_if.if_flags & IFF_RUNNING) != 0;
+}
+
+// The radio goes down for good until sf_bwfm_up or the next interface up: interface stopped
+// (scan aborted, disassociated, flow rings deleted), with inform the firmware told (D3
+// inform), then the chip masked and reset and every ring, buffer and DMA mapping released.
+// Returns 0 when the firmware acknowledged D3, an errno when it did not or was not asked.
+int
+sf_bwfm_down(struct device *dev, int inform)
+{
+	struct bwfm_softc *sc = (struct bwfm_softc *)dev;
+	int error;
+
+	sf80211_lock();
+	error = bwfm_radio_down(sc, inform);
+	sf80211_unlock();
+	// the DART is behind the port: not read once that is down
+	if (!sc->sc_bus_gone)
+		sf_bwfm_dma_check("radio down");
+	sf_bwfm_dma_report(dev->dv_xname);
+	return inform ? error : ENXIO;
+}
+
+// the interface comes back if it is configured up: the firmware is loaded again when it is
+// not running. Returns 0 when the interface runs afterwards
+int
+sf_bwfm_up(struct device *dev)
+{
+	struct bwfm_softc *sc = (struct bwfm_softc *)dev;
+	struct ifnet *ifp = &sc->sc_ic.ic_if;
+	int running;
+
+	sf80211_lock();
+	if ((ifp->if_flags & (IFF_UP | IFF_RUNNING)) == IFF_UP)
+		bwfm_init(ifp);
+	running = (ifp->if_flags & IFF_RUNNING) != 0;
+	sf80211_unlock();
+	sf_bwfm_dma_report(dev->dv_xname);
+	return running ? 0 : EIO;
+}
+
+// after the port was powered down or the system slept: the DART translates again. Only
+// with the port up. The bounce pool has no such path
+int
+sf_bwfm_dma_resume(void)
+{
+#ifdef SF_BWFM_DMA_BOUNCE
+	printf(SF_BWFM_NAME ": the DMA pool cannot be programmed again after a power loss\n");
+	return ENOTSUP;
+#else
+	return sf_dart_resume();
+#endif
+}
+
+// The port is about to lose power (gone 1: a firmware that still runs is halted first), is
+// found dead (gone 2: nothing at all is touched) or is back (gone 0). While gone neither the
+// bus nor this file touches a register of the chip or the DART
+void
+sf_bwfm_set_gone(struct device *dev, int gone)
+{
+	struct bwfm_softc *sc = (struct bwfm_softc *)dev;
+
+	sf80211_lock();
+	bwfm_lifecycle_enter(sc);
+	if (gone == 2)
+		sc->sc_bus_gone = 1;
+	if (sc->sc_bus_ops->bs_gone != NULL)
+		sc->sc_bus_ops->bs_gone(sc, gone);
+	sc->sc_bus_gone = gone != 0;
+	bwfm_lifecycle_exit(sc);
+	sf80211_unlock();
+}
+
+// IO80211Controller's hooks point at the controller: once it detached its interface no frame
+// and no link change may go there. sf80211_hook allocated the block and nothing frees it
+void
+sf_bwfm_unhook(struct device *dev)
+{
+	struct ifnet *ifp = &((struct bwfm_softc *)dev)->sc_ic.ic_if;
+	void *hooks;
+
+	sf80211_lock();
+	hooks = ifp->if_pdowner;
+	ifp->if_pdinput = NULL;
+	ifp->if_pdlinkchange = NULL;
+	ifp->if_pdowner = NULL;
+	sf80211_unlock();
+	if (hooks != NULL)
+		free(hooks, M_DEVBUF, 0);
+}
+
+// The softc goes away after this. In order: interface stopped and bus halted if they still
+// were up (sf_bwfm_down did that already in the driver's stop), control messages out of the
+// softc, task thread drained, net80211 detached, blobs freed. Works after a bring-up that
+// never ran or failed: every step looks at what exists. Returns non-zero when a control
+// message or the task thread did not get out in time: the softc must then not be freed.
+int
+sf_bwfm_detach(struct device *dev)
+{
+	struct bwfm_softc *sc = (struct bwfm_softc *)dev;
+	int busy;
+
+	sf80211_lock();
+	// one piece: no init slips in between the halt and the detach
+	bwfm_lifecycle_enter(sc);
+	bwfm_radio_down(sc, 0);
+	busy = bwfm_pci_ca.ca_detach(dev, 0);
+	bwfm_lifecycle_exit(sc);
+	sf80211_unlock();
+	// a hook that never ran
+	(void)sf_bwfm_take_hook(dev);
+	sf_bwfm_dma_report(dev->dv_xname);
+	return busy;
+}
+
+// FXNET: the station's power save at run time, see bwfm_pm_set() and bwfm_pm_get() in bwfm.c
+int
+sf_bwfm_set_pm(struct device *dev, int mode, int ret_ms)
+{
+	struct bwfm_softc *sc = (struct bwfm_softc *)dev;
+	int error;
+
+	sf80211_lock();
+	error = bwfm_pm_set(sc, mode, ret_ms);
+	sf80211_unlock();
+	return error;
+}
+
+int
+sf_bwfm_get_pm(struct device *dev, int *fw_mode, int *fw_ret_ms, int *want_mode, int *want_ret_ms)
+{
+	struct bwfm_softc *sc = (struct bwfm_softc *)dev;
+
+	sf80211_lock();
+	bwfm_pm_get(sc, fw_mode, fw_ret_ms, want_mode, want_ret_ms);
+	sf80211_unlock();
+	return 0;
+}
+
+struct ieee80211com *
+sf_bwfm_ic(struct device *dev)
+{
+	return &((struct bwfm_softc *)dev)->sc_ic;
+}
+
+int
+if_setlladdr(struct ifnet *ifp, const uint8_t *lladdr)
+{
+	memcpy(((struct arpcom *)ifp)->ac_enaddr, lladdr, ETHER_ADDR_LEN);
+	return 0;
+}
+
+// a chain becomes one cluster, the caller's pointer follows the new mbuf
+int
+sf_bwfm_m_defrag(struct mbuf **mp, int how)
+{
+	struct mbuf *m = *mp, *n;
+	int len = M_PKTLEN(m);
+
+	if (M_NEXT(m) == NULL)
+		return 0;
+	n = sf_bwfm_mclgetl(how, len);
+	if (n == NULL) {
+		SF_LOGN(4, "SFBwfm: defrag: no buffer for %d bytes\n", len);
+		return ENOBUFS;
+	}
+	/* The driver only needs the bytes and the lengths; the packet header copy
+	 * failed on hardware for every frame and is not needed for transmit. */
+	m_copydata(m, 0, len, mtod(n, caddr_t));
+	M_SETLEN(n, len);
+	M_SETPKTLEN(n, len);
+	m_freem(m);
+	*mp = n;
+	return 0;
+}
+
+static void
+sf_bwfm_extfree(caddr_t buf, u_int size, caddr_t arg)
+{
+	(void)size;
+	(void)arg;
+	free(buf, M_DEVBUF, 0);
+}
+
+// a packet header mbuf with len bytes of contiguous storage. Control and event buffers are
+// 8 KiB, where the mbuf allocator may only have a chain to offer, then the storage is ours
+struct mbuf *
+sf_bwfm_mclgetl(int how, u_int len)
+{
+	unsigned int chunks = 1;
+	mbuf_t m = NULL;
+	caddr_t buf;
+
+	if (mbuf_allocpacket(how, len, &chunks, &m) == 0) {
+		if (mbuf_next(m) == NULL && mbuf_maxlen(m) >= len)
+			return m;
+		mbuf_freem(m);
+	}
+	m = NULL;
+	buf = malloc(len, M_DEVBUF, M_NOWAIT);
+	if (buf == NULL)
+		return NULL;
+	if (mbuf_gethdr(how, MBUF_TYPE_DATA, &m) != 0) {
+		free(buf, M_DEVBUF, len);
+		return NULL;
+	}
+	if (mbuf_attachcluster(how, MBUF_TYPE_DATA, &m, buf, sf_bwfm_extfree, len, NULL) != 0) {
+		mbuf_freem(m);
+		free(buf, M_DEVBUF, len);
+		return NULL;
+	}
+	return m;
+}
+
+// the board
+
+/*
+ * Board identity, used to pick the firmware and NVRAM files.
+ *
+ * On Linux the board type is in the device tree source ("brcm,board-type", e.g.
+ * apple,honshu for the J293) and the antenna SKU comes from m1n1, which copies bytes
+ * 8..15 of /arm-io/wlan wifi-antenna-sku-info into "apple,antenna-sku". Here both come
+ * from the Apple device tree: the board type is "apple," plus the lower-cased
+ * /arm-io/wlan module-instance, which is the same name on the J293. The boot-args
+ * bwfm_board= and bwfm_antenna= override them.
+ */
+static void
+sf_bwfm_board_identity(char *board, size_t boardlen, char *antenna, size_t antennalen)
+{
+	static int logged;
+	uint8_t info[16];
+	char adt[64];
+	const char *boardsrc = "missing", *antsrc = "missing";
+	int n;
+
+	board[0] = antenna[0] = '\0';
+	/* m1n1: brcm,board-type is "apple," + lower-cased /arm-io/wlan module-instance */
+	n = sf_bwfm_adt_prop("/arm-io/wlan", "module-instance", adt, sizeof(adt) - 1);
+	if (n > 0) {
+		adt[MIN(n, (int)sizeof(adt) - 1)] = '\0';
+		for (char *c = adt; *c != '\0'; c++) {
+			if (*c >= 'A' && *c <= 'Z')
+				*c += 'a' - 'A';
+		}
+		snprintf(board, boardlen, "apple,%s", adt);
+		boardsrc = "device tree";
+	}
+	/* m1n1: apple,antenna-sku is bytes 8..15 of /arm-io/wlan wifi-antenna-sku-info */
+	n = sf_bwfm_adt_prop("/arm-io/wlan", "wifi-antenna-sku-info", info, sizeof(info));
+	if (n >= (int)sizeof(info)) {
+		memcpy(adt, &info[8], 8);
+		adt[8] = '\0';
+		strlcpy(antenna, adt, antennalen);
+		antsrc = "device tree";
+	}
+	if (sf_bwfm_bootarg("bwfm_board", board, (int)boardlen))
+		boardsrc = "boot-arg";
+	if (sf_bwfm_bootarg("bwfm_antenna", antenna, (int)antennalen))
+		antsrc = "boot-arg";
+	if (logged)
+		return;
+	logged = 1;
+	printf(SF_BWFM_NAME ": board type %s (%s), antenna SKU %s (%s)\n",
+	    board[0] ? board : "(none)", boardsrc, antenna[0] ? antenna : "(none)", antsrc);
+}
+
+// the fdt properties bwfm reads. The calibration blob and the mac address are where m1n1
+// finds them for linux: /arm-io/wlan wifi-calibration-msf and /chosen mac-address-wifi0
+static int
+sf_bwfm_prop(int node, const char *name, void *buf, int len, int quiet)
+{
+	char board[64], antenna[16];
+	const char *str = NULL, *path = NULL, *adtname = NULL;
+	int n;
+
+	sf_bwfm_board_identity(board, sizeof(board), antenna, sizeof(antenna));
+	if (node == SF_BWFM_NODE_ROOT && strcmp(name, "compatible") == 0)
+		str = board;
+	else if (node == SF_BWFM_NODE_WLAN && strcmp(name, "brcm,board-type") == 0)
+		str = board;
+	else if (node == SF_BWFM_NODE_WLAN && strcmp(name, "apple,antenna-sku") == 0)
+		str = antenna;
+	else if (node == SF_BWFM_NODE_WLAN && strcmp(name, "brcm,cal-blob") == 0) {
+		path = "/arm-io/wlan";
+		adtname = "wifi-calibration-msf";
+	} else if (node == SF_BWFM_NODE_WLAN && strcmp(name, "local-mac-address") == 0) {
+		path = "/chosen";
+		adtname = "mac-address-wifi0";
+	}
+
+	if (str != NULL) {
+		n = (int)strlen(str) + 1;
+		if (buf != NULL && len > 0)
+			memcpy(buf, str, MIN(n, len));
+		return n;
+	}
+	if (path == NULL)
+		return -1;
+	n = sf_bwfm_adt_prop(path, adtname, buf, len);
+	if (!quiet) {
+		if (n <= 0)
+			printf(SF_BWFM_NAME ": device tree %s %s missing, continuing without\n", path, adtname);
+		else
+			printf(SF_BWFM_NAME ": device tree %s %s, %d bytes\n", path, adtname, n);
+	}
+	return n > 0 ? n : -1;
+}
+
+int
+OF_getproplen(int node, const char *name)
+{
+	return sf_bwfm_prop(node, name, NULL, 0, 1);
+}
+
+int
+OF_getprop(int node, const char *name, void *buf, int len)
+{
+	return sf_bwfm_prop(node, name, buf, len, 0);
+}
+
+#ifdef SF_BWFM_DMA_BOUNCE
+
+// bus_dma on the DART bounce pool. Everything runs under the stack lock.
+
+struct sf_bwfm_dmamem {
+	struct sf_bwfm_dmamem *next;
+	caddr_t		kva;
+	uint64_t	iova;
+	size_t		size;
+};
+static struct sf_bwfm_dmamem *sf_bwfm_dmamems;
+static size_t sf_bwfm_dma_bytes, sf_bwfm_dma_allocs, sf_bwfm_dma_failures;
+
+static void *
+sf_bwfm_pool_alloc(size_t size, size_t align, uint64_t *iova)
+{
+	void *kva = sf_dart_pool_alloc(size, align, iova);
+
+	if (kva == NULL) {
+		// say so once in a while, an exhausted pool is otherwise silent
+		if (sf_bwfm_dma_failures++ % 256 == 0)
+			printf(SF_BWFM_NAME ": DMA pool has no %zu bytes (%zu bytes in %zu allocations held)\n",
+			    size, sf_bwfm_dma_bytes, sf_bwfm_dma_allocs);
+		return NULL;
+	}
+	sf_bwfm_dma_bytes += size;
+	sf_bwfm_dma_allocs++;
+	return kva;
+}
+
+static void
+sf_bwfm_pool_free(void *kva, size_t size)
+{
+	sf_dart_pool_free(kva, size);
+	sf_bwfm_dma_bytes -= size;
+	sf_bwfm_dma_allocs--;
+}
+
+static void
+sf_bwfm_dma_report(const char *name)
+{
+	printf("%s: DMA pool: %zu bytes in %zu allocations, %zu failed requests\n", name,
+	    sf_bwfm_dma_bytes, sf_bwfm_dma_allocs, sf_bwfm_dma_failures);
+}
+
+int
+bus_dmamap_create(bus_dma_tag_t t, bus_size_t size, int nsegs, bus_size_t maxsegsz,
+    bus_size_t boundary, int flags, bus_dmamap_t *mapp)
+{
+	bus_dmamap_t map = malloc(sizeof(*map), M_DEVBUF, M_NOWAIT | M_ZERO);
+
+	*mapp = NULL;
+	if (map == NULL)
+		return ENOMEM;
+	map->_dm_size = size;
+	map->_dm_flags = flags;
+	map->_dm_slot = sf_bwfm_pool_alloc(size, 64, &map->_dm_slot_iova);
+	if (map->_dm_slot == NULL) {
+		free(map, M_DEVBUF, sizeof(*map));
+		return ENOMEM;
+	}
+	*mapp = map;
+	return 0;
+}
+
+void
+bus_dmamap_unload(bus_dma_tag_t t, bus_dmamap_t map)
+{
+	if (map == NULL)
+		return;
+	map->_dm_mbuf = NULL;
+	map->dm_nsegs = 0;
+	map->dm_mapsize = 0;
+}
+
+void
+bus_dmamap_destroy(bus_dma_tag_t t, bus_dmamap_t map)
+{
+	if (map == NULL)
+		return;
+	if (map->_dm_slot != NULL)
+		sf_bwfm_pool_free(map->_dm_slot, map->_dm_size);
+	free(map, M_DEVBUF, sizeof(*map));
+}
+
+// only memory from bus_dmamem_alloc is loaded this way: rings, index and scratch buffers.
+// It already lives in the pool, so the map gives its own slot back and points at it
+int
+bus_dmamap_load(bus_dma_tag_t t, bus_dmamap_t map, void *buf, bus_size_t len, void *p, int flags)
+{
+	struct sf_bwfm_dmamem *mem;
+
+	for (mem = sf_bwfm_dmamems; mem != NULL; mem = mem->next) {
+		if ((caddr_t)buf >= mem->kva && (caddr_t)buf + len <= mem->kva + mem->size)
+			break;
+	}
+	if (mem == NULL) {
+		printf(SF_BWFM_NAME ": bus_dmamap_load of memory outside the DMA pool refused\n");
+		return EINVAL;
+	}
+	if (map->_dm_slot != NULL) {
+		sf_bwfm_pool_free(map->_dm_slot, map->_dm_size);
+		map->_dm_slot = NULL;
+	}
+	map->_dm_mbuf = NULL;
+	map->dm_segs[0].ds_addr = mem->iova + (uint64_t)((caddr_t)buf - mem->kva);
+	map->dm_segs[0].ds_len = len;
+	map->dm_nsegs = 1;
+	map->dm_mapsize = len;
+	return 0;
+}
+
+int
+bus_dmamap_load_mbuf(bus_dma_tag_t t, bus_dmamap_t map, struct mbuf *m, int flags)
+{
+	size_t len = (size_t)M_PKTLEN(m);
+
+	if (map == NULL || map->_dm_slot == NULL)
+		return EINVAL;
+	if (len == 0 || len > map->_dm_size)
+		return EFBIG;
+	if (map->_dm_flags & BUS_DMA_READ) {
+		// a receive buffer: the chip writes the slot, the mbuf is filled at POSTREAD
+		map->_dm_mbuf = m;
+	} else {
+		m_copydata(m, 0, (int)len, map->_dm_slot);
+		map->_dm_mbuf = NULL;
+	}
+	map->dm_segs[0].ds_addr = map->_dm_slot_iova;
+	map->dm_segs[0].ds_len = len;
+	map->dm_nsegs = 1;
+	map->dm_mapsize = len;
+	return 0;
+}
+
+void
+bus_dmamap_sync(bus_dma_tag_t t, bus_dmamap_t map, bus_addr_t off, bus_size_t len, int ops)
+{
+	if (map == NULL)
+		return;
+	__sync_synchronize();
+	if ((ops & BUS_DMASYNC_POSTREAD) && map->_dm_mbuf != NULL && map->_dm_slot != NULL) {
+		// once: the driver hands the mbuf up right after this
+		mbuf_copyback(map->_dm_mbuf, 0, map->dm_mapsize, map->_dm_slot, MBUF_DONTWAIT);
+		map->_dm_mbuf = NULL;
+	}
+}
+
+int
+bus_dmamem_alloc(bus_dma_tag_t t, bus_size_t size, bus_size_t align, bus_size_t boundary,
+    bus_dma_segment_t *segs, int nsegs, int *rsegs, int flags)
+{
+	struct sf_bwfm_dmamem *mem = malloc(sizeof(*mem), M_DEVBUF, M_NOWAIT | M_ZERO);
+
+	if (mem == NULL)
+		return ENOMEM;
+	mem->kva = sf_bwfm_pool_alloc(size, align, &mem->iova);
+	if (mem->kva == NULL) {
+		free(mem, M_DEVBUF, sizeof(*mem));
+		return ENOMEM;
+	}
+	mem->size = size;
+	mem->next = sf_bwfm_dmamems;
+	sf_bwfm_dmamems = mem;
+	segs[0].ds_addr = mem->iova;
+	segs[0].ds_len = size;
+	segs[0]._ds_mem = mem->kva;
+	*rsegs = 1;
+	return 0;
+}
+
+void
+bus_dmamem_free(bus_dma_tag_t t, bus_dma_segment_t *segs, int nsegs)
+{
+	struct sf_bwfm_dmamem **prev, *mem;
+
+	for (prev = &sf_bwfm_dmamems; (mem = *prev) != NULL; prev = &mem->next) {
+		if (mem->kva == segs[0]._ds_mem) {
+			*prev = mem->next;
+			sf_bwfm_pool_free(mem->kva, mem->size);
+			free(mem, M_DEVBUF, sizeof(*mem));
+			segs[0]._ds_mem = NULL;
+			return;
+		}
+	}
+}
+
+int
+bus_dmamem_map(bus_dma_tag_t t, bus_dma_segment_t *segs, int nsegs, size_t size, caddr_t *kvap, int flags)
+{
+	if (segs[0]._ds_mem == NULL)
+		return EINVAL;
+	*kvap = segs[0]._ds_mem;
+	return 0;
+}
+
+void
+bus_dmamem_unmap(bus_dma_tag_t t, caddr_t kva, size_t size)
+{
+}
+
+#else /* !SF_BWFM_DMA_BOUNCE */
+
+// bus_dma on the DART mapper (sf_dart_map.h). Everything runs under the stack lock.
+//
+// bus_dmamem memory (rings, index and scratch buffers) is wired kernel memory that stays
+// mapped until bus_dmamem_free. An mbuf is mapped in place: the 16 KiB pages its data lies
+// in get consecutive iovas, adjacent in memory or not, from bus_dmamap_load_mbuf until
+// bus_dmamap_unload, and the device address is the iova plus the offset into the first page.
+// That holds for transmit, command and receive buffers alike, nothing is copied.
+//
+// The DART wants an invalidate before a new mapping is used. It is not done per mapping but
+// in bus_dmamap_sync(PRE*) of a bus_dmamem map: bwfm_pci_ring_write_commit syncs the ring
+// right before it moves the write pointer, and a ring entry is the only way the chip learns
+// a buffer address. That same invalidate retires everything unloaded since the last one.
+//
+// A bounce copy through the map's slot, a mapped buffer of the map's maximum size that is
+// allocated on first use and kept, happens only when an mbuf cannot be mapped in place: it
+// is a chain, the physical address of one of its pages cannot be resolved or is not one the
+// DART takes, or the mapper is out of iovas. With SF_BWFM_DMA_RX_SLOTS defined every receive
+// map (BUS_DMA_READ) is bounced on purpose: the slots then stay mapped for good and the
+// receive path costs a copy per packet instead of a map, an invalidate and an unmap.
+
+#define SF_BWFM_DMA_NONE	0
+#define SF_BWFM_DMA_MEM		1	/* bus_dmamem memory, mapped by its owner */
+#define SF_BWFM_DMA_MBUF	2	/* an mbuf mapped in place, _dm_dva and dm_mapsize */
+#define SF_BWFM_DMA_SLOT	3	/* an mbuf bounced through the slot */
+
+#define SF_BWFM_DMA_MAXPAGES	4	/* 64 KiB, the largest buffer here is 8 KiB */
+
+struct sf_bwfm_dmamem {
+	struct sf_bwfm_dmamem *next;
+	caddr_t		kva;
+	uint64_t	iova;
+	size_t		size;
+};
+static struct sf_bwfm_dmamem *sf_bwfm_dmamems;
+static size_t sf_bwfm_dma_bytes, sf_bwfm_dma_allocs, sf_bwfm_dma_failures, sf_bwfm_dma_slots;
+static uint64_t sf_bwfm_dma_inplace, sf_bwfm_dma_bounced;
+
+static void
+sf_bwfm_dma_report(const char *name)
+{
+	printf("%s: DMA map: %zu bytes in %zu allocations, %llu mbufs mapped in place, "
+	    "%llu bounced, %zu bounce slots, %zu failed requests\n", name,
+	    sf_bwfm_dma_bytes, sf_bwfm_dma_allocs, (unsigned long long)sf_bwfm_dma_inplace,
+	    (unsigned long long)sf_bwfm_dma_bounced, sf_bwfm_dma_slots, sf_bwfm_dma_failures);
+	sf_dart_report(name);
+}
+
+// the physical page behind a page of mbuf storage. The pmap answers for every wired kernel
+// address, cluster or not; the mbuf KPI is asked second because with a system mapper it
+// would answer with that mapper's address
+static uint64_t
+sf_bwfm_dma_page_pa(uintptr_t va)
+{
+	uint64_t pa = sf_dart_kvtophys((const void *)va);
+
+	if (pa == 0)
+		pa = (uint64_t)mbuf_data_to_physical((void *)va);
+	return pa;
+}
+
+static int
+sf_bwfm_dma_map_mbuf(bus_dmamap_t map, struct mbuf *m, size_t len)
+{
+	uintptr_t va = (uintptr_t)mbuf_data(m);
+	uintptr_t first = va & ~(uintptr_t)SF_DART_MAP_PAGE_MASK;
+	size_t n = (va - first + len + SF_DART_MAP_PAGE_MASK) >> SF_DART_MAP_PAGE_SHIFT;
+	uint64_t pa[SF_BWFM_DMA_MAXPAGES], iova = 0;
+
+	if (va == 0 || n > SF_BWFM_DMA_MAXPAGES)
+		return EFBIG;
+	for (size_t i = 0; i < n; i++) {
+		pa[i] = sf_bwfm_dma_page_pa(first + i * SF_DART_MAP_PAGE_SIZE);
+		if (pa[i] == 0 || (pa[i] & SF_DART_MAP_PAGE_MASK) != 0 || (pa[i] >> 36) != 0)
+			return EFAULT;
+	}
+	if (sf_dart_map_pages(pa, (unsigned)n, &iova) != 0)
+		return ENOMEM;
+	map->_dm_kind = SF_BWFM_DMA_MBUF;
+	map->_dm_dva = iova + (va - first);
+	map->_dm_mbuf = NULL;
+	map->dm_segs[0].ds_addr = map->_dm_dva;
+	map->dm_segs[0].ds_len = len;
+	map->dm_nsegs = 1;
+	map->dm_mapsize = len;
+	sf_bwfm_dma_inplace++;
+	return 0;
+}
+
+static int
+sf_bwfm_dma_bounce_mbuf(bus_dmamap_t map, struct mbuf *m, size_t len)
+{
+	if (map->_dm_slot == NULL) {
+		map->_dm_slot = sf_dart_alloc(map->_dm_size, &map->_dm_slot_iova);
+		if (map->_dm_slot == NULL) {
+			if (sf_bwfm_dma_failures++ % 256 == 0)
+				printf(SF_BWFM_NAME ": no bounce slot of %llu bytes\n",
+				    (unsigned long long)map->_dm_size);
+			return ENOMEM;
+		}
+		sf_bwfm_dma_slots++;
+	}
+	if (map->_dm_flags & BUS_DMA_READ) {
+		// a receive buffer: the chip writes the slot, the mbuf is filled at POSTREAD
+		map->_dm_mbuf = m;
+	} else {
+		m_copydata(m, 0, (int)len, map->_dm_slot);
+		map->_dm_mbuf = NULL;
+	}
+	map->_dm_kind = SF_BWFM_DMA_SLOT;
+	map->dm_segs[0].ds_addr = map->_dm_slot_iova;
+	map->dm_segs[0].ds_len = len;
+	map->dm_nsegs = 1;
+	map->dm_mapsize = len;
+	sf_bwfm_dma_bounced++;
+	return 0;
+}
+
+int
+bus_dmamap_create(bus_dma_tag_t t, bus_size_t size, int nsegs, bus_size_t maxsegsz,
+    bus_size_t boundary, int flags, bus_dmamap_t *mapp)
+{
+	bus_dmamap_t map = malloc(sizeof(*map), M_DEVBUF, M_NOWAIT | M_ZERO);
+
+	*mapp = NULL;
+	if (map == NULL)
+		return ENOMEM;
+	map->_dm_size = size;
+	map->_dm_flags = flags;
+	*mapp = map;
+	return 0;
+}
+
+void
+bus_dmamap_unload(bus_dma_tag_t t, bus_dmamap_t map)
+{
+	if (map == NULL)
+		return;
+	// the iova is not handed out again before the next invalidate, see sf_dart_map.h
+	if (map->_dm_kind == SF_BWFM_DMA_MBUF)
+		sf_dart_unmap(map->_dm_dva, map->dm_mapsize);
+	map->_dm_kind = SF_BWFM_DMA_NONE;
+	map->_dm_dva = 0;
+	map->_dm_mbuf = NULL;
+	map->dm_nsegs = 0;
+	map->dm_mapsize = 0;
+}
+
+void
+bus_dmamap_destroy(bus_dma_tag_t t, bus_dmamap_t map)
+{
+	if (map == NULL)
+		return;
+	// bwfm_pci_cleanup destroys the maps of packets that are still posted
+	bus_dmamap_unload(t, map);
+	if (map->_dm_slot != NULL) {
+		sf_dart_free(map->_dm_slot);
+		sf_bwfm_dma_slots--;
+	}
+	free(map, M_DEVBUF, sizeof(*map));
+}
+
+// only memory from bus_dmamem_alloc is loaded this way: rings, index and scratch buffers.
+// It is mapped already, the map points at it
+int
+bus_dmamap_load(bus_dma_tag_t t, bus_dmamap_t map, void *buf, bus_size_t len, void *p, int flags)
+{
+	struct sf_bwfm_dmamem *mem;
+
+	for (mem = sf_bwfm_dmamems; mem != NULL; mem = mem->next) {
+		if ((caddr_t)buf >= mem->kva && (caddr_t)buf + len <= mem->kva + mem->size)
+			break;
+	}
+	if (mem == NULL) {
+		printf(SF_BWFM_NAME ": bus_dmamap_load of memory that is not bus_dmamem refused\n");
+		return EINVAL;
+	}
+	bus_dmamap_unload(t, map);
+	map->_dm_kind = SF_BWFM_DMA_MEM;
+	map->dm_segs[0].ds_addr = mem->iova + (uint64_t)((caddr_t)buf - mem->kva);
+	map->dm_segs[0].ds_len = len;
+	map->dm_nsegs = 1;
+	map->dm_mapsize = len;
+	return 0;
+}
+
+int
+bus_dmamap_load_mbuf(bus_dma_tag_t t, bus_dmamap_t map, struct mbuf *m, int flags)
+{
+	size_t len = (size_t)M_PKTLEN(m);
+	int inplace = 1;
+
+	if (map == NULL)
+		return EINVAL;
+	if (len == 0 || len > map->_dm_size)
+		return EFBIG;
+	bus_dmamap_unload(t, map);
+	// the driver takes one segment. Transmit chains are made one mbuf in bwfm_start and the
+	// buffers the driver allocates are one mbuf, so a chain here is the exception: it is
+	// bounced, which linearises it the way the pool always did
+	if (M_NEXT(m) != NULL || mbuf_len(m) < len)
+		inplace = 0;
+#ifdef SF_BWFM_DMA_RX_SLOTS
+	if (map->_dm_flags & BUS_DMA_READ)
+		inplace = 0;
+#endif
+	if (inplace && sf_bwfm_dma_map_mbuf(map, m, len) == 0)
+		return 0;
+	return sf_bwfm_dma_bounce_mbuf(map, m, len);
+}
+
+void
+bus_dmamap_sync(bus_dma_tag_t t, bus_dmamap_t map, bus_addr_t off, bus_size_t len, int ops)
+{
+	if (map == NULL)
+		return;
+	__sync_synchronize();
+	// a ring or index buffer is about to be shown to the chip: whatever was mapped for it
+	// since the last invalidate has to be live now. Nothing to do when nothing was mapped
+	if ((ops & (BUS_DMASYNC_PREREAD | BUS_DMASYNC_PREWRITE)) && map->_dm_kind == SF_BWFM_DMA_MEM)
+		sf_dart_sync();
+	if ((ops & BUS_DMASYNC_POSTREAD) && map->_dm_kind == SF_BWFM_DMA_SLOT &&
+	    map->_dm_mbuf != NULL && map->_dm_slot != NULL) {
+		// once: the driver hands the mbuf up right after this
+		mbuf_copyback(map->_dm_mbuf, 0, map->dm_mapsize, map->_dm_slot, MBUF_DONTWAIT);
+		map->_dm_mbuf = NULL;
+	}
+}
+
+int
+bus_dmamem_alloc(bus_dma_tag_t t, bus_size_t size, bus_size_t align, bus_size_t boundary,
+    bus_dma_segment_t *segs, int nsegs, int *rsegs, int flags)
+{
+	struct sf_bwfm_dmamem *mem;
+
+	// the memory is page aligned, in the kernel and for the chip
+	if (size == 0 || align > SF_DART_MAP_PAGE_SIZE)
+		return EINVAL;
+	mem = malloc(sizeof(*mem), M_DEVBUF, M_NOWAIT | M_ZERO);
+	if (mem == NULL)
+		return ENOMEM;
+	mem->kva = sf_dart_alloc(size, &mem->iova);
+	if (mem->kva == NULL) {
+		sf_bwfm_dma_failures++;
+		free(mem, M_DEVBUF, sizeof(*mem));
+		return ENOMEM;
+	}
+	mem->size = size;
+	mem->next = sf_bwfm_dmamems;
+	sf_bwfm_dmamems = mem;
+	sf_bwfm_dma_bytes += size;
+	sf_bwfm_dma_allocs++;
+	segs[0].ds_addr = mem->iova;
+	segs[0].ds_len = size;
+	segs[0]._ds_mem = mem->kva;
+	*rsegs = 1;
+	return 0;
+}
+
+void
+bus_dmamem_free(bus_dma_tag_t t, bus_dma_segment_t *segs, int nsegs)
+{
+	struct sf_bwfm_dmamem **prev, *mem;
+
+	for (prev = &sf_bwfm_dmamems; (mem = *prev) != NULL; prev = &mem->next) {
+		if (mem->kva == segs[0]._ds_mem) {
+			*prev = mem->next;
+			sf_dart_free(mem->kva);
+			sf_bwfm_dma_bytes -= mem->size;
+			sf_bwfm_dma_allocs--;
+			free(mem, M_DEVBUF, sizeof(*mem));
+			segs[0]._ds_mem = NULL;
+			return;
+		}
+	}
+}
+
+int
+bus_dmamem_map(bus_dma_tag_t t, bus_dma_segment_t *segs, int nsegs, size_t size, caddr_t *kvap, int flags)
+{
+	if (segs[0]._ds_mem == NULL)
+		return EINVAL;
+	*kvap = segs[0]._ds_mem;
+	return 0;
+}
+
+void
+bus_dmamem_unmap(bus_dma_tag_t t, caddr_t kva, size_t size)
+{
+}
+
+#endif /* SF_BWFM_DMA_BOUNCE */
+
+#undef printf
+extern void IOSleep(unsigned milliseconds);
+int
+sf_bwfm_printf(const char *fmt, ...)
+{
+	char line[320];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("%s", line);
+#ifdef SF_BWFM_SLOW_LOG
+	IOSleep(25);
+#endif
+	return n;
+}
