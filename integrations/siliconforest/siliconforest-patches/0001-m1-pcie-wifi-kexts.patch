+	struct if_rxring	 sc_rxbuf_ring;
+
+	struct bwfm_pci_pkts	 sc_ioctl_pkts;
+	struct bwfm_pci_pkts	 sc_rx_pkts;
+	struct bwfm_pci_pkts	 sc_tx_pkts;
