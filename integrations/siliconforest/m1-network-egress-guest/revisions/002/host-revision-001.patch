+                                 'partial_line': int(match[11]),
+                                 'partial_bits': int(match[12]), 'cleanup_complete': int(match[13]), 'phases': int(match[14]), 'http_bytes': int(match[15]), 'if_error': int(match[16]), 'if_stage': int(match[17])}
