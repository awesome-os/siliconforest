+            GLint tw=0,th=0,tf=0;
+            glGetTexLevelParameteriv(target,0,GL_TEXTURE_WIDTH,&tw);
+            glGetTexLevelParameteriv(target,0,GL_TEXTURE_HEIGHT,&th);
