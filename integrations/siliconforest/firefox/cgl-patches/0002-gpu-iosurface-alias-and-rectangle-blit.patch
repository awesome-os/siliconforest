+    if(t->gpu_image&&sf_present.destroyImage)sf_present.destroyImage(sf_cgl_get_display(),t->gpu_image);
+    t->gpu_texture=0;t->gpu_image=EGL_NO_IMAGE_KHR;
+}
+static int sf_cgl_ensure_gpu(struct sf_cgl_surftex *t) {
+    if(!sf_iosurface.gpuCopyFD||!sf_iosurface.gpuOffset||t->plane||
+       !sf_iosurface.gpuOffset(t->surface)||t->format!=GL_BGRA||
+       t->type!=GL_UNSIGNED_INT_8_8_8_8_REV||t->element_bytes!=4)
+        return 0;
+    pthread_once(&sf_cgl_present_once,sf_cgl_load_present);
+    if(!sf_present.createImage||!sf_present.destroyImage||!sf_present.targetTexture)return 0;
+    if(t->gpu_image)return 1;
+    int fd=sf_iosurface.gpuCopyFD(t->surface);
+    if(fd<0)return 0;
+    size_t offset=sf_iosurface.gpuOffset(t->surface);
+    if(offset>INT32_MAX||t->row_bytes>INT32_MAX){close(fd);return 0;}
+    EGLint attributes[]={EGL_WIDTH,t->width,EGL_HEIGHT,t->height,
+        EGL_LINUX_DRM_FOURCC_EXT,0x34325241, // DRM_FORMAT_ARGB8888: native BGRA bytes
+        EGL_DMA_BUF_PLANE0_FD_EXT,fd,EGL_DMA_BUF_PLANE0_OFFSET_EXT,(EGLint)offset,
+        EGL_DMA_BUF_PLANE0_PITCH_EXT,(EGLint)t->row_bytes,
+        EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT,0,EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT,0,EGL_NONE};
+    t->gpu_image=sf_present.createImage(sf_cgl_get_display(),EGL_NO_CONTEXT,EGL_LINUX_DMA_BUF_EXT,NULL,attributes);
+    close(fd);
+    return t->gpu_image!=EGL_NO_IMAGE_KHR;
+}
+static int sf_cgl_gpu_transfer(struct sf_cgl_surftex *t,int to_surface) {
