+// Optional GPU IOSurface bridge. A 2D texture aliases the imported EGLImage
+// directly. Rectangle targets use GPU blits because EGL image storage cannot
+// bind a rectangle target; neither path reads pixels through the CPU.
+static uint64_t sf_gpu_stats[4]; // CPU upload/readback bytes, GPU blit bytes, direct alias commits
+void CGLSFFXTransferStats(uint64_t values[4]) {
+    pthread_mutex_lock(&sf_cgl_track_lock);
+    memcpy(values,sf_gpu_stats,sizeof(sf_gpu_stats));
+    pthread_mutex_unlock(&sf_cgl_track_lock);
+}
+static void sf_cgl_drop_gpu(struct sf_cgl_surftex *t) {
