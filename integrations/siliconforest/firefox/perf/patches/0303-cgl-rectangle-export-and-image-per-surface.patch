+    sf_cgl_images[sf_cgl_image_count++]=(struct sf_cgl_image){(IOSurfaceRef)sf_cf_retain(surface),sf_cgl_image_id(surface),offset,row,w,h,fourcc,image,1,sf_cgl_image_now()};
