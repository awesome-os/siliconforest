+static void sf_cgl_image_forget(int i){
+    if(sf_present.destroyImage)sf_present.destroyImage(sf_cgl_get_display(),sf_cgl_images[i].image);
+    if(sf_cf_release)sf_cf_release(sf_cgl_images[i].surface);
