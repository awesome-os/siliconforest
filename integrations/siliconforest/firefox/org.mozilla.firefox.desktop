[Desktop Entry]
Type=Application
Name=Firefox
Comment=Firefox web browser
TryExec=/Applications/Firefox.app/Contents/MacOS/firefox
Exec=/usr/bin/chonkstep-darwin-desktop --desktop-request application org.mozilla.firefox
Icon=/Applications/Firefox.app
Categories=Network;WebBrowser;
StartupWMClass=org.mozilla.firefox
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
