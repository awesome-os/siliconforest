+static int frameCreateGPU(struct wsWindow *window,struct wsFrame *frame,int w,int h){
+    if(!ws.dmabuf||!window->gpuPresenter)return 0;
+    frame->gpuOutput=sfGPUFrameCreate(window->gpuPresenter,w,h);
+    if(!frame->gpuOutput)return 0;
+    // Complete the first draw before the compositor imports the storage.
+    if(!sfGPUCompose(window->gpuPresenter,frame->gpuOutput,window->pixels,w,h)){frameDestroy(frame);return 0;}
+    int fd=sfGPU.IOSurfaceSFGPUCopyFD(frame->gpuOutput->surface);
+    size_t offset=sfGPU.IOSurfaceSFGPUGetOffset(frame->gpuOutput->surface);
+    size_t stride=sfGPU.IOSurfaceGetBytesPerRow(frame->gpuOutput->surface);
+    if(fd<0||offset>UINT32_MAX||stride>UINT32_MAX){if(fd>=0)close(fd);frameDestroy(frame);return 0;}
+    struct zwp_linux_buffer_params_v1 *params=zwp_linux_dmabuf_v1_create_params(ws.dmabuf);
+    zwp_linux_buffer_params_v1_add(params,fd,0,(uint32_t)offset,(uint32_t)stride,0,0);
+    frame->buffer=zwp_linux_buffer_params_v1_create_immed(params,w,h,0x34325241,0);
+    zwp_linux_buffer_params_v1_destroy(params);close(fd);
+    if(!frame->buffer){frameDestroy(frame);return 0;}
+    wl_buffer_add_listener(frame->buffer,&frameListener,frame);
+    frame->ownerID=window->windowID;frame->size=(size_t)w*h*4;frame->w=w;frame->h=h;return 1;
+}
