+// Private opt-in native-layer registration. Rectangles are physical top-down
+// pixels, in both the source surface and the window backing store.
+int _windowServerSFFXSetGPULayer(int windowID,uintptr_t key,void *surface,
+    double sx,double sy,double sw,double sh,double dx,double dy,double dw,double dh){
+    const char *enabled=getenv("SFFX_GPU_PRESENT");
+    if(!enabled||strcmp(enabled,"1")||!ensureConnected()||!ws.dmabuf)return 0;
+    pthread_mutex_lock(&ws.pixelsLock);
+    struct wsWindow *window=windowForID(windowID);int good=0;
+    if(window){
+        if(!window->gpuPresenter&&surface)window->gpuPresenter=sfGPUCreate();
+        good=sfGPUSetLayer(window->gpuPresenter,key,surface,sx,sy,sw,sh,dx,dy,dw,dh);
+    }
+    pthread_mutex_unlock(&ws.pixelsLock);return good;
+}
+int _windowServerSFFXGPUStats(int windowID,uint64_t values[4]){
+    pthread_mutex_lock(&ws.pixelsLock);
+    struct wsWindow *window=windowForID(windowID);int good=window&&window->gpuPresenter;
+    if(good){struct sfGPUPresenter *p=window->gpuPresenter;values[0]=p->frames;values[1]=p->baseUploadBytes;values[2]=p->layerBytes;values[3]=p->failures;}
+    pthread_mutex_unlock(&ws.pixelsLock);return good;
+}
