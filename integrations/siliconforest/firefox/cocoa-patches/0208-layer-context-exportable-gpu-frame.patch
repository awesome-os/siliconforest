+// An opt-in GPU frame, never a CPU bitmap disguised as GPU storage.
+-(CFTypeRef)copySFFXRenderedSurface {
+   const char *enabled=getenv("SFFX_GPU_PRESENT");
+   if(!enabled||strcmp(enabled,"1"))return NULL;
+   void *library=dlopen("/System/Library/Frameworks/IOSurface.framework/IOSurface",RTLD_LAZY|RTLD_GLOBAL);
+   CFTypeRef (*create)(CFDictionaryRef)=library?dlsym(library,"IOSurfaceCreate"):NULL;
+   size_t (*width)(CFTypeRef)=library?dlsym(library,"IOSurfaceGetWidth"):NULL;
+   size_t (*height)(CFTypeRef)=library?dlsym(library,"IOSurfaceGetHeight"):NULL;
+   int (*copy)(CFTypeRef,int)=dlsym(RTLD_DEFAULT,"CGLSFFXCopyFramebuffer");
+   if(library)dlclose(library);
+   if(!create||!width||!height||!copy)return NULL;
+   int w=(int)ceil(_frame.size.width*_backingScale),h=(int)ceil(_frame.size.height*_backingScale);
+   if(w<=0||h<=0||w>16384||h>16384)return NULL;
+   unsigned index=_sffxNext++%2;
+   CFTypeRef surface=_sffxFrames[index];
+   if(surface&&(width(surface)!=(size_t)w||height(surface)!=(size_t)h)){
+    CFRelease(surface);surface=NULL;_sffxFrames[index]=NULL;
+   }
+   if(!surface){
+    CFMutableDictionaryRef props=CFDictionaryCreateMutable(NULL,0,&kCFTypeDictionaryKeyCallBacks,&kCFTypeDictionaryValueCallBacks);
+    if(!props)return NULL;
+    CFStringRef keys[]={CFSTR("IOSurfaceWidth"),CFSTR("IOSurfaceHeight"),CFSTR("IOSurfaceBytesPerElement"),CFSTR("IOSurfacePixelFormat")};
+    int values[]={w,h,4,0x42475241};
+    for(int i=0;i<4;i++){CFNumberRef n=CFNumberCreate(NULL,kCFNumberIntType,&values[i]);if(!n){CFRelease(props);return NULL;}CFDictionarySetValue(props,keys[i],n);CFRelease(n);}
+    _sffxFrames[index]=surface=create(props);CFRelease(props);
+   }
+   CGLSetCurrentContext(_glContext);
+   return surface&&copy(surface,1)?CFRetain(surface):NULL;
+}
