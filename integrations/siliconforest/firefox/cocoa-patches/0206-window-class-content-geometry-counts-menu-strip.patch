+// The class conversion API is also used by custom window subclasses when
+// sizing a child view. Account for the same strip the instance places above
+// its content, including a full-size-content view on our server-framed desk.
++ (CGFloat)_sfMenuStripHeightForStyleMask:(NSUInteger)styleMask
+{
+    if (![self _sfMenuStripsEnabled] || [[NSApp mainMenu] numberOfItems] == 0 ||
+        !(styleMask & NSTitledWindowMask) || !NSWindowFrameIsDrawnByServer(styleMask) ||
+        [self isSubclassOfClass:[NSPanel class]])
+        return 0;
+    for (NSWindow *window in [NSApp windows]) {
+        NSView *strip = [window _sfMenuStripView];
+        if (strip != nil)
+            return NSHeight([strip frame]);
+    }
+    // Before the first strip exists, measure with its actual drawing class.
+    SFMenuStripView *strip = [[SFMenuStripView alloc] initWithFrame:NSMakeRect(0,0,100,22)];
+    [strip setHorizontal:YES];
+    [strip _sfSetInWindow:YES];
+    [strip setMenu:[NSApp mainMenu]];
+    [strip sizeToFit];
+    CGFloat height = MAX(22,ceil(NSHeight([strip frame])));
+    [strip release];
+    return height;
+}
