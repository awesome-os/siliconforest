+// Property changes already schedule their context directly. A bare transaction
+// only needs another composite when mutable IOSurface pixels changed. Rendering
+// itself reads transaction defaults, so unconditional broadcasts can redraw forever.
+static CFTypeID (*fingerprintSurfaceType)(void);
+static uint32_t (*fingerprintSurfaceSeed)(CFTypeRef);
+static Class fingerprintCFType;
+static pthread_once_t fingerprintOnce=PTHREAD_ONCE_INIT;
+static void loadFingerprintAPI(void) {
+   void *library=dlopen("/System/Library/Frameworks/IOSurface.framework/IOSurface",RTLD_LAZY|RTLD_GLOBAL);
+   if(library!=NULL){
+    fingerprintSurfaceType=dlsym(library,"IOSurfaceGetTypeID");
+    fingerprintSurfaceSeed=dlsym(library,"IOSurfaceGetSeed");
+   }
+   fingerprintCFType=objc_getClass("__NSCFType");
+}
+static uint64_t mixContents(uint64_t hash,uint64_t value) {
+   return (hash^value)*UINT64_C(1099511628211);
+}
+static uint64_t contentsFingerprint(CALayer *layer,BOOL *uncertain) {
+   if(layer==nil)return 0;
+   pthread_once(&fingerprintOnce,loadFingerprintAPI);
+   id contents=layer.contents;
+   uint64_t hash=mixContents(UINT64_C(14695981039346656037),(uintptr_t)layer);
+   hash=mixContents(hash,(uintptr_t)contents);
+   hash=mixContents(hash,[layer _contentsSeed]);
+   if(contents!=nil && fingerprintCFType!=Nil && [contents isKindOfClass:fingerprintCFType]){
+    if(fingerprintSurfaceType==NULL || fingerprintSurfaceSeed==NULL)
+     *uncertain=YES; // retain the old behavior if mutable-surface inspection is unavailable
+    else if(CFGetTypeID((CFTypeRef)contents)==fingerprintSurfaceType())
+     hash=mixContents(hash,fingerprintSurfaceSeed((CFTypeRef)contents));
+   }
+   for(CALayer *child in layer.sublayers)
+    hash=mixContents(hash,contentsFingerprint(child,uncertain));
+   return hash;
+}
