 CFDictionaryRef CTFontCopyVariation(CTFontRef font) {
-   CFDictionaryRef variation=CTFontCopyAttribute(font,kCTFontVariationAttribute);
-
-   return variation;
+   CTFace *face=[font _ctFace];
+   if(face==NULL || !FT_HAS_MULTIPLE_MASTERS(face->ft))return NULL;
+   pthread_mutex_lock(&face->lock);
+   FT_MM_Var *mm=NULL;
+   if(FT_Get_MM_Var(face->ft,&mm)!=0){pthread_mutex_unlock(&face->lock);return NULL;}
+   FT_Fixed *coordinates=calloc(mm->num_axis,sizeof(*coordinates));
+   CFMutableDictionaryRef result=NULL;
+   if(coordinates && FT_Get_Var_Design_Coordinates(face->ft,mm->num_axis,coordinates)==0){
+    result=CFDictionaryCreateMutable(NULL,mm->num_axis,&kCFTypeDictionaryKeyCallBacks,&kCFTypeDictionaryValueCallBacks);
+    for(FT_UInt i=0;i<mm->num_axis;i++){
+     uint32_t tag=(uint32_t)mm->axis[i].tag;
+     double value=coordinates[i]/65536.0;
+     CFNumberRef key=CFNumberCreate(NULL,kCFNumberSInt32Type,&tag);
+     CFNumberRef number=CFNumberCreate(NULL,kCFNumberDoubleType,&value);
+     CFDictionarySetValue(result,key,number);CFRelease(key);CFRelease(number);
+    }
+   }
+   free(coordinates);FT_Done_MM_Var(CTFreeTypeLibrary(),mm);
+   pthread_mutex_unlock(&face->lock);
+   return result;
 }
 
