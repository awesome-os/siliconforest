+/* A font-server capability maps to SiliconForest's public font database.
+ * It grants read access only; configuration/fonts/cache remain immutable. */
+static void
+emit_font_server_rules(struct compiler *c, int line)
+{
+	static const char *paths[] = {
+		"/etc/fonts", "/private/etc/fonts", "/usr/share/fonts",
+		"/System/Library/Fonts", "/var/cache/fontconfig", "/private/var/cache/fontconfig"
+#ifdef SFFX_FONT_DIRECTORY
+        , SFFX_FONT_DIRECTORY
+#endif
+	};
+	for (size_t i = 0; i < sizeof(paths) / sizeof(paths[0]); i++)
+		emit_rule(c, line, SB_OP_FILE_READ_ALL, SB_ACTION_ALLOW, SB_FILTER_SUBPATH, paths[i]);
+}
+
