+    /// Cancel a key this virtual request held after its target disappeared.
+    /// Update xkb/pressed-key state without forwarding into another client.
+    fn release_targetless_virtual_key(&mut self,evdev:u32)->Result<(),String>{
+        let input=self.input.as_mut().ok_or("no SFHID seat")?;
+        if !input.virt_keys.remove(&evdev){return Err(format!("synthetic key {evdev} released while not held: dropped"));}
+        input.suppressed_keys.remove(&evdev);
+        let keyboard=input.keyboard.clone();
+        keyboard.input_intercept(self,(evdev+8).into(),KeyState::Released,|s,m,_|{
+            s.input.as_mut().unwrap().modifiers=modifiers(m);
+        });
+        let input=self.input.as_mut().unwrap();
+        if input.virt_keys.is_empty() && input.kb_lent.take().is_some(){self.sync_input_focus();}
+        Ok(())
+    }
