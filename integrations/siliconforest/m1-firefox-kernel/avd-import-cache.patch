+extern "C" int
+sf_avd_os_dma_sync(void *cookie, enum sf_avd_dma_phase phase)
+{
+    DmaCookie *c = (DmaCookie *)cookie;
+    if (!c || phase < SF_AVD_DMA_INITIAL || phase > SF_AVD_DMA_PUBLISH_CPU)
+        return -EINVAL;
+    if (!c->kernelMap) return 0; /* legacy private allocations unchanged */
+    if (gDart.poisoned || !c->prepared || !c->md || !c->bytes ||
+        c->bytes > SIZE_MAX - 16383) return -EIO;
+    const size_t length = (c->bytes + 16383) & ~(size_t)16383;
+    const vm_offset_t address = (vm_offset_t)c->kernelMap->getAddress();
+    if (!address || address > (vm_offset_t)-1 - length ||
+        c->md->getLength() < length || c->kernelMap->getLength() < length)
+        return -EIO;
+    /* The retained mapping shares the original device-pager VM object and
+     * cache attributes. It is NOT a new pager over raw physical addresses.
+     * Bound each Force preemption-disabled interval to one 16 KiB page. */
+    for (size_t offset = 0; offset < length; offset += 16384)
+        CleanPoC_DcacheRegion_Force(address + offset, 16384);
+    return 0;
 }
 
